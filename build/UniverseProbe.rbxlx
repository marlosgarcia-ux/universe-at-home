          <string name="Name">Canvas</string>
          <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: Canvas
--
-- A CPU-side RGBA8 image (row-major buffer, EditableImage byte layout) that
-- remembers which tiles changed. flush() uploads only the changed area, merged into
-- as few rectangles as possible, through any writer function, so the same code
-- drives a real EditableImage, a tile of a giant virtual canvas, or a test mock.
--
-- Why: the display side refreshes only one EditableImage per frame (PUBLIC
-- CONTRACT), and every byte written costs engine time. Writing only what changed is
-- axiom A1 (change locality) in docs/DESIGN.md.

local Pixels = require("./Pixels")

local Canvas = {}
Canvas.__index = Canvas

export type Rect = { x: number, y: number, w: number, h: number }
export type Writer = (x: number, y: number, w: number, h: number, pixels: buffer) -> ()

export type Canvas = typeof(setmetatable(
	{} :: {
		width: number,
		height: number,
		buf: buffer,
		tile: number,
		tilesX: number,
		tilesY: number,
		dirty: buffer,
		dirtyCount: number,
		scratch: { [number]: buffer },
	},
	Canvas
))

-- tile: dirty-tracking granularity in pixels (default 32)
function Canvas.new(width: number, height: number, fill: number?, tile: number?): Canvas
	assert(width >= 1 and height >= 1, "canvas size must be positive")
	local t = tile or 32
	local self = setmetatable({
		width = width,
		height = height,
		buf = buffer.create(width * height * 4),
		tile = t,
		tilesX = (width + t - 1) // t,
		tilesY = (height + t - 1) // t,
		dirty = buffer.create(((width + t - 1) // t) * ((height + t - 1) // t)),
		dirtyCount = 0,
		scratch = {},
	}, Canvas)
	if fill and fill ~= 0 then
		Pixels.fill(self.buf, fill)
	end
	self:markAll()
	return self
end

-- Wraps an existing buffer (no copy).
function Canvas.fromBuffer(buf: buffer, width: number, height: number, tile: number?): Canvas
	assert(buffer.len(buf) == width * height * 4, "buffer size does not match width * height * 4")
	local self = Canvas.new(1, 1, nil, tile)
	self.width, self.height = width, height
	self.buf = buf
	local t = self.tile
	self.tilesX = (width + t - 1) // t
	self.tilesY = (height + t - 1) // t
	self.dirty = buffer.create(self.tilesX * self.tilesY)
	self.dirtyCount = 0
	self:markAll()
	return self
end

function Canvas.get(self: Canvas, x: number, y: number): number
	return buffer.readu32(self.buf, (y * self.width + x) * 4)
end

function Canvas.set(self: Canvas, x: number, y: number, color: number)
	buffer.writeu32(self.buf, (y * self.width + x) * 4, color)
	self:markDirty(x, y, 1, 1)
end

-- Marks a pixel rectangle as changed (clipped to the canvas).
function Canvas.markDirty(self: Canvas, x: number, y: number, w: number, h: number)
	local x0 = math.max(0, x)
	local y0 = math.max(0, y)
	local x1 = math.min(self.width, x + w) - 1
	local y1 = math.min(self.height, y + h) - 1
	if x1 < x0 or y1 < y0 then
		return
	end
	local t = self.tile
	local tx0, tx1 = x0 // t, x1 // t
	local ty0, ty1 = y0 // t, y1 // t
	local tilesX = self.tilesX
	local dirty = self.dirty
	for ty = ty0, ty1 do
		for tx = tx0, tx1 do
			local i = ty * tilesX + tx
			if buffer.readu8(dirty, i) == 0 then
				buffer.writeu8(dirty, i, 1)
				self.dirtyCount += 1
			end
		end
	end
end

function Canvas.markAll(self: Canvas)
	buffer.fill(self.dirty, 0, 1)
	self.dirtyCount = self.tilesX * self.tilesY
end

function Canvas.clearDirty(self: Canvas)
	buffer.fill(self.dirty, 0, 0)
	self.dirtyCount = 0
end

function Canvas.isDirty(self: Canvas): boolean
	return self.dirtyCount > 0
end

function Canvas.fill(self: Canvas, color: number)
	Pixels.fill(self.buf, color)
	self:markAll()
end

function Canvas.fillRect(self: Canvas, x: number, y: number, w: number, h: number, color: number)
	local x0, y0 = math.max(0, x), math.max(0, y)
	local x1, y1 = math.min(self.width, x + w), math.min(self.height, y + h)
	if x1 <= x0 or y1 <= y0 then
		return
	end
	Pixels.fillRect(self.buf, self.width, x0, y0, x1 - x0, y1 - y0, color)
	self:markDirty(x0, y0, x1 - x0, y1 - y0)
end

-- Turns dirty tiles into rectangles: horizontal runs per tile row, merged
-- vertically when consecutive rows have identical runs. If that yields more than
-- maxRects rectangles, or the bounding box is at least `densityThreshold` dirty,
-- one bounding rectangle is returned instead (fewer calls beats fewer bytes).
function Canvas.planFlush(self: Canvas, maxRects: number?, densityThreshold: number?): { Rect }
	local rects: { Rect } = {}
	if self.dirtyCount == 0 then
		return rects
	end
	local t = self.tile
	local tilesX, tilesY = self.tilesX, self.tilesY
	local dirty = self.dirty
	local open: { [number]: Rect } = {} -- key: run start * 65536 + run end
	local minTx, minTy, maxTx, maxTy = math.huge, math.huge, -1, -1
	for ty = 0, tilesY - 1 do
		local nextOpen: { [number]: Rect } = {}
		local tx = 0
		while tx < tilesX do
			if buffer.readu8(dirty, ty * tilesX + tx) == 1 then
				local start = tx
				while tx < tilesX and buffer.readu8(dirty, ty * tilesX + tx) == 1 do
					tx += 1
				end
				local stop = tx - 1
				if start < minTx then
					minTx = start
				end
				if stop > maxTx then
					maxTx = stop
				end
				if ty < minTy then
					minTy = ty
				end
				maxTy = ty
				local key = start * 65536 + stop
				local r = open[key]
				if r then
					r.h += t
					nextOpen[key] = r
				else
					r = { x = start * t, y = ty * t, w = (stop - start + 1) * t, h = t }
					table.insert(rects, r)
					nextOpen[key] = r
				end
			else
				tx += 1
			end
		end
		open = nextOpen
	end
	-- clip to canvas
	for _, r in rects do
		r.w = math.min(r.w, self.width - r.x)
		r.h = math.min(r.h, self.height - r.y)
	end
	local bx, by = minTx * t, minTy * t
	local bw = math.min((maxTx + 1) * t, self.width) - bx
	local bh = math.min((maxTy + 1) * t, self.height) - by
	local dirtyArea = 0
	for _, r in rects do
		dirtyArea += r.w * r.h
	end
	if #rects > (maxRects or 8) or dirtyArea >= (densityThreshold or 0.75) * bw * bh then
		return { { x = bx, y = by, w = bw, h = bh } }
	end
	return rects
end

function Canvas.scratchFor(self: Canvas, bytes: number): buffer
	local b = self.scratch[bytes]
	if not b then
		b = buffer.create(bytes)
		self.scratch[bytes] = b
	end
	return b
end

-- Uploads dirty pixels through `write`. Returns the number of pixels written.
-- A full-canvas rectangle passes the canvas buffer itself with no copy.
function Canvas.flush(self: Canvas, write: Writer, maxRects: number?, densityThreshold: number?): number
	local rects = self:planFlush(maxRects, densityThreshold)
	local written = 0
	for _, r in rects do
		if r.x == 0 and r.y == 0 and r.w == self.width and r.h == self.height then
			write(0, 0, r.w, r.h, self.buf)
		else
			local tmp = self:scratchFor(r.w * r.h * 4)
			Pixels.copyRect(tmp, r.w, 0, 0, self.buf, self.width, r.x, r.y, r.w, r.h)
			write(r.x, r.y, r.w, r.h, tmp)
		end
		written += r.w * r.h
	end
	self:clearDirty()
	return written
end

-- Writer for a Roblox EditableImage (or anything with WritePixelsBuffer).
-- vector2 is the Vector2 constructor, injected so this module stays engine-free.
function Canvas.editableImageWriter(image: any, vector2: (number, number) -> any, offsetX: number?, offsetY: number?): Writer
	local ox, oy = offsetX or 0, offsetY or 0
	return function(x: number, y: number, w: number, h: number, pixels: buffer)
		image:WritePixelsBuffer(vector2(x + ox, y + oy), vector2(w, h), pixels)
	end
end

return Canvas
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Liquid</string>
          <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: Liquid (ALLAN, the Alpha Liquid network renderer)
--
-- docs/LIQUID.md is the specification; this header is the single source of truth for the
-- binary layout and for the exact arithmetic every implementation (Luau, the Python and
-- Luau learning builders, future GPU backends) must follow.
--
-- BINARY LAYOUT, version 1. All multi-byte values little-endian.
--
--   offset  field        type             meaning
--   0       magic        3 bytes          "ALN" (0x41 0x4C 0x4E)
--   3       version      u8               1
--   4       N            u8               neurons, 1..32
--   5       I            u8               input bytes per leaf, 1..16
--   6       M            u8               output channels, 1..8
--   7       K            u8               gain exponents, 1..31 (k in [0, K))
--   8       beta[N]      f64              neuron target bias
--           B[N*I]       f64              B[i*I + t] = weight of leaf byte t for neuron i
--           kBase[N]     f64              integer valued, may be negative
--           Cf[M*N]      f64              forward readout, Cf[m*N + i]
--           Cb[M*N]      f64              backward readout, Cb[m*N + i]
--           d[M]         f64              readout bias
--   then the quadtree:
--           width        u16              1..65535 pixels
--           height       u16              1..65535 pixels
--           maxDepth     u8               0..P (P defined below)
--           flags        ceil(F/8) bytes  one bit per visited node of depth < maxDepth, in
--                                         preorder, packed least significant bit first;
--                                         1 = split, 0 = leaf. F is the number of such nodes.
--           leaves       I bytes per leaf leaf bytes in preorder
--
-- Quadtree geometry. The root is the square [0, S) x [0, S), S = 2^P, P the smallest integer
-- with 2^P >= max(width, height). A node of depth t has side S >> t. Every split node has
-- all four children, visited in this order: (x0, y0), (x0 + h, y0), (x0, y0 + h),
-- (x0 + h, y0 + h), h = half the side. Nodes of depth maxDepth are leaves and have no
-- flag bit. The bit stream is self-delimiting; leaf bytes start at the next byte. A node
-- with no pixel inside [0, width) x [0, height) is still stored (builders make it a leaf
-- with zero bytes); the renderer never shows it, except the endless mode (X3) which may.
-- (Same layout as src/LiquidLearn.luau and tools/liquid_train.py.)
--
-- THE MODEL, in exactly this arithmetic (any reference implementation reproduces its bits):
--   u_t      = byte_t / 255                                  (one division)
--   b_i      = beta_i;  for t = 0..I-1: b_i = b_i + B[i*I + t] * u_t
--   k_i      = clamp(kBase_i + log2(leafSide) + r, 0, K - 1), leafSide = S >> depth in
--              stored pixels and r >= 0 the log2 render scale (r = 0: native resolution;
--              r > 0 renders 2^r x larger, every leaf scaled, docs/LIQUID.md X4). This is
--              "depthShift": small leaves are fast. kBase <= -K - r gives an instant
--              neuron (k = 0, g = 1, h = b).
--   g_i      = 2^-k_i (exact),  a_i = 1 - g_i (exact)
--   step     h_i = h_i + (b_i - h_i) * g_i                     (one base pixel)
--   passes   forward over x = 0..W-1 and backward over x = W-1..0 (W = width << r rendered
--            pixels); each pass starts at rest, h = b of its first pixel; hf(x), hb(x) are
--            the states after stepping pixel x
--   output   z_m = d_m; for i: z_m = z_m + Cf[m*N+i] * hf_i; for i: z_m = z_m + Cb[m*N+i] * hb_i
--   byte     clamp(floor(z_m + 0.5), 0, 255)
--   pixel    channel m is byte m of the RGBA8 pixel for m < 4 (missing channels: alpha 255,
--            others 0); channels 4..7 go to a second RGBA8 target with the same rule.
-- Liquid.reference* implement this literally (step by step). The event renderer evaluates the
-- same model in closed form (T1) and differs from it by the bounds proved in docs/LIQUID.md
-- ("Renderer results"): every byte within epsilon + 0.5 of the reference value (T2).
--
-- Deterministic ops only (docs/RUNTIME_AUDIT.md 6.5): + - * / floor, comparisons, integer
-- // and %, bit32 and integer buffer ops. No exp, log, pow, lerp, noise or random. Floor of
-- fractional values uses math.floor, never // (MSVC fast-math caveat).

local MyMath = require("./MyMath")
local Pixels = require("./Pixels")

local Liquid = {}
Liquid.VERSION = 1

local floor = math.floor
local hash32 = MyMath.hash32
local hash2 = MyMath.hash2
local fillSpan = Pixels.fillSpan

local JMAX = 62 -- drop tables cover residual ratios up to 2^62
-- Powers of two built by exact doubling and halving (the ^ operator is libm pow, which the
-- deterministic op set excludes even though it is exact for powers of two on sane libms).
local POW2: { number } = table.create(1024, 1) -- POW2[e + 1] = 2^e, e = 0..1023
local POW2N: { number } = table.create(1075, 1) -- POW2N[e + 1] = 2^-e, e = 0..1074
do
	local p = 1
	for e = 1, 1023 do
		p *= 2
		POW2[e + 1] = p
	end
	p = 1
	for e = 1, 1074 do
		p *= 0.5
		POW2N[e + 1] = p
	end
end
local function pow2(e: number): number
	return if e >= 0 then POW2[e + 1] else POW2N[1 - e]
end

local ETA = 1 / 16777216 -- 2^-24: slack of the quantisation-margin skip, in output units
local SHRINK = 1 - 1 / 1099511627776 -- 1 - 2^-40: absorbs rounding of computed bounds
local NONE = -math.huge -- "no output pixel" (output pixels may be negative in the endless mode)

export type Model = {
	N: number,
	I: number,
	M: number,
	K: number,
	beta: { number },
	B: { number },
	kBase: { number },
	Cf: { number },
	Cb: { number },
	d: { number },
}

export type Tree = {
	width: number,
	height: number,
	maxDepth: number,
	P: number,
	S: number,
	I: number,
	nodeCount: number,
	leafCount: number,
	flagCount: number,
	nodes: buffer, -- u32 per node, preorder: leaf -> leafIndex * 2 + 1, internal -> subtreeSize * 2
	leafBytes: buffer, -- I bytes per leaf in preorder, plus 8 zero bytes of padding
	leafDepth: buffer, -- u8 per leaf
	leafKey: buffer, -- u32 per leaf: content id; equal bytes <=> equal id
	keyCount: number,
	keyLeaf: buffer, -- u32 per key: a leaf carrying that content
	virt: VirtualStats?, -- lazily built statistics for the endless mode (X3)
}

export type VirtualStats = {
	nodesAt: { number }, -- [t + 1] = nodes of depth t with a pixel inside the image
	splitsAt: { number }, -- [t + 1] = split ones among them
	leavesAt: { { number } }, -- [t + 1] = leaf indices of depth t inside the image
	all: { number }, -- every leaf inside the image
}

----------------------------------------------------------------------------------------
-- Model
----------------------------------------------------------------------------------------

local function checkArray(name: string, a: { number }, n: number)
	assert(#a == n, `{name} must have {n} entries, has {#a}`)
	for j = 1, n do
		local v = a[j]
		assert(v == v and v > -math.huge and v < math.huge, `{name}[{j}] is not finite`)
	end
end

-- Validates and copies a model table.
function Liquid.newModel(spec: Model): Model
	local N, I, M, K = spec.N, spec.I, spec.M, spec.K
	assert(N >= 1 and N <= 32 and N % 1 == 0, "N must be an integer in 1..32")
	assert(I >= 1 and I <= 16 and I % 1 == 0, "I must be an integer in 1..16")
	assert(M >= 1 and M <= 8 and M % 1 == 0, "M must be an integer in 1..8")
	assert(K >= 1 and K <= 31 and K % 1 == 0, "K must be an integer in 1..31")
	checkArray("beta", spec.beta, N)
	checkArray("B", spec.B, N * I)
	checkArray("kBase", spec.kBase, N)
	checkArray("Cf", spec.Cf, M * N)
	checkArray("Cb", spec.Cb, M * N)
	checkArray("d", spec.d, M)
	for j = 1, N do
		assert(spec.kBase[j] % 1 == 0, "kBase entries must be integers")
	end
	return {
		N = N,
		I = I,
		M = M,
		K = K,
		beta = table.clone(spec.beta),
		B = table.clone(spec.B),
		kBase = table.clone(spec.kBase),
		Cf = table.clone(spec.Cf),
		Cb = table.clone(spec.Cb),
		d = table.clone(spec.d),
	}
end

----------------------------------------------------------------------------------------
-- Tree: parsing from the flag bit stream, building, encoding
----------------------------------------------------------------------------------------

local function rootLog2(width: number, height: number): number
	local m = if width > height then width else height
	local p, s = 0, 1
	while s < m do
		s *= 2
		p += 1
	end
	return p
end

-- Parses a quadtree whose flag bits start at byte `fo` of `src` and whose leaf bytes follow.
-- Returns the tree and the offset just past the leaf bytes.
local function parseTree(
	src: buffer,
	fo: number,
	width: number,
	height: number,
	maxDepth: number,
	I: number
): (Tree, number)
	assert(width >= 1 and width <= 65535 and height >= 1 and height <= 65535, "bad tree size")
	local P = rootLog2(width, height)
	assert(maxDepth >= 0 and maxDepth <= P, "maxDepth must be in 0..P")
	local S = pow2(P)
	local srcLen = buffer.len(src)

	-- pass 1: count nodes, leaves and flags
	local flagPos = 0
	local nodeCount, leafCount = 0, 0
	local function readFlag(): number
		local byteAt = fo + flagPos // 8
		assert(byteAt < srcLen, "flag stream truncated")
		local bit = bit32.extract(buffer.readu8(src, byteAt), flagPos % 8)
		flagPos += 1
		return bit
	end
	local function count(depth: number)
		nodeCount += 1
		if depth < maxDepth and readFlag() == 1 then
			count(depth + 1)
			count(depth + 1)
			count(depth + 1)
			count(depth + 1)
		else
			leafCount += 1
		end
	end
	count(0)
	local flagCount = flagPos
	local leafAt = fo + (flagCount + 7) // 8
	local leafEnd = leafAt + leafCount * I
	assert(leafEnd <= srcLen, "leaf bytes truncated")

	-- pass 2: node records
	local nodes = buffer.create(nodeCount * 4)
	local leafDepth = buffer.create(leafCount)
	flagPos = 0
	local nextNode, nextLeaf = 0, 0
	local function fill(depth: number): number
		local idx = nextNode
		nextNode += 1
		if depth < maxDepth and readFlag() == 1 then
			local size = 1 + fill(depth + 1)
			size += fill(depth + 1)
			size += fill(depth + 1)
			size += fill(depth + 1)
			buffer.writeu32(nodes, idx * 4, size * 2)
			return size
		end
		buffer.writeu32(nodes, idx * 4, nextLeaf * 2 + 1)
		buffer.writeu8(leafDepth, nextLeaf, depth)
		nextLeaf += 1
		return 1
	end
	fill(0)

	local leafBytes = buffer.create(leafCount * I + 8)
	buffer.copy(leafBytes, 0, src, leafAt, leafCount * I)

	-- content keys: equal bytes <=> equal key (exact integer keys for I <= 6, strings otherwise)
	local leafKey = buffer.create(leafCount * 4)
	local keyOf: { [any]: number } = {}
	local keyLeafList: { number } = {}
	local keyCount = 0
	for l = 0, leafCount - 1 do
		local at = l * I
		local key: any
		if I <= 6 then
			local v = 0
			for t = I - 1, 0, -1 do
				v = v * 256 + buffer.readu8(leafBytes, at + t)
			end
			key = v
		else
			key = buffer.readstring(leafBytes, at, I)
		end
		local id = keyOf[key]
		if id == nil then
			id = keyCount
			keyOf[key] = id
			keyCount += 1
			keyLeafList[keyCount] = l
		end
		buffer.writeu32(leafKey, l * 4, id)
	end
	local keyLeaf = buffer.create(math.max(keyCount, 1) * 4)
	for j = 1, keyCount do
		buffer.writeu32(keyLeaf, (j - 1) * 4, keyLeafList[j])
	end

	local tree: Tree = {
		width = width,
		height = height,
		maxDepth = maxDepth,
		P = P,
		S = S,
		I = I,
		nodeCount = nodeCount,
		leafCount = leafCount,
		flagCount = flagCount,
		nodes = nodes,
		leafBytes = leafBytes,
		leafDepth = leafDepth,
		leafKey = leafKey,
		keyCount = keyCount,
		keyLeaf = keyLeaf,
		virt = nil,
	}
	return tree, leafEnd
end

-- Builds a tree from a preorder bit stream (flags) and leaf bytes, as stored in the binary.
function Liquid.newTree(width: number, height: number, maxDepth: number, I: number, flags: buffer, leaves: buffer): Tree
	local fbytes = buffer.len(flags)
	local tmp = buffer.create(fbytes + buffer.len(leaves))
	buffer.copy(tmp, 0, flags, 0, fbytes)
	-- the flag stream may be longer than needed; parseTree finds the true length, so place
	-- the leaves right after the bytes the flags actually use by parsing twice
	local probe = parseTree(tmp, 0, width, height, maxDepth, I)
	local used = (probe.flagCount + 7) // 8
	local src = buffer.create(used + buffer.len(leaves))
	buffer.copy(src, 0, flags, 0, used)
	buffer.copy(src, used, leaves, 0, buffer.len(leaves))
	local tree = parseTree(src, 0, width, height, maxDepth, I)
	return tree
end

-- Builds a tree by preorder traversal. split(x0, y0, side, depth) decides whether a present
-- node of depth < maxDepth splits; leaf(x0, y0, side, depth, out, at) writes the leaf's I
-- bytes into `out` at byte offset `at`.
function Liquid.buildTree(
	width: number,
	height: number,
	maxDepth: number,
	I: number,
	split: (number, number, number, number) -> boolean,
	leaf: (number, number, number, number, buffer, number) -> ()
): Tree
	local P = rootLog2(width, height)
	assert(maxDepth >= 0 and maxDepth <= P, "maxDepth must be in 0..P")
	local flags: { number } = {}
	local leafCap = 1024
	local leaves = buffer.create(leafCap * I)
	local leafCount = 0
	local function visit(depth: number, x0: number, y0: number, side: number)
		local s = false
		if depth < maxDepth then
			s = split(x0, y0, side, depth)
			table.insert(flags, if s then 1 else 0)
		end
		if s then
			local h = side // 2
			visit(depth + 1, x0, y0, h)
			visit(depth + 1, x0 + h, y0, h)
			visit(depth + 1, x0, y0 + h, h)
			visit(depth + 1, x0 + h, y0 + h, h)
		else
			if leafCount == leafCap then
				local bigger = buffer.create(leafCap * 2 * I)
				buffer.copy(bigger, 0, leaves, 0, leafCap * I)
				leaves = bigger
				leafCap *= 2
			end
			leaf(x0, y0, side, depth, leaves, leafCount * I)
			leafCount += 1
		end
	end
	visit(0, 0, 0, pow2(P))
	local fb = buffer.create((#flags + 7) // 8 + leafCount * I)
	for j = 1, #flags do
		if flags[j] == 1 then
			local p = j - 1
			local at = p // 8
			buffer.writeu8(fb, at, buffer.readu8(fb, at) + bit32.lshift(1, p % 8))
		end
	end
	local fo = (#flags + 7) // 8
	buffer.copy(fb, fo, leaves, 0, leafCount * I)
	local tree = parseTree(fb, 0, width, height, maxDepth, I)
	return tree
end

-- Reconstructs the preorder flag bits of a parsed tree (for encoding).
local function treeFlags(tree: Tree): buffer
	local out = buffer.create((tree.flagCount + 7) // 8)
	local pos = 0
	local nodes, D = tree.nodes, tree.maxDepth
	local function walk(n: number, depth: number): number
		local v = buffer.readu32(nodes, n * 4)
		local isLeaf = v % 2 == 1
		if depth < D then
			if not isLeaf then
				local at = pos // 8
				buffer.writeu8(out, at, buffer.readu8(out, at) + bit32.lshift(1, pos % 8))
			end
			pos += 1
		end
		if isLeaf then
			return 1
		end
		local c = n + 1
		local size = 1
		for _ = 1, 4 do
			local sz = walk(c, depth + 1)
			size += sz
			c += sz
		end
		return size
	end
	walk(0, 0)
	assert(pos == tree.flagCount, "flag count mismatch")
	return out
end

local function writeF64s(b: buffer, at: number, a: { number }): number
	for j = 1, #a do
		buffer.writef64(b, at, a[j])
		at += 8
	end
	return at
end

local function readF64s(b: buffer, at: number, n: number): ({ number }, number)
	local a = table.create(n, 0)
	for j = 1, n do
		a[j] = buffer.readf64(b, at)
		at += 8
	end
	return a, at
end

-- Serialises a model and a tree into one version-1 blob.
function Liquid.encode(model: Model, tree: Tree): buffer
	local N, I, M = model.N, model.I, model.M
	assert(tree.I == I, "tree and model disagree on I")
	local flags = treeFlags(tree)
	local floats = N + N * I + N + 2 * M * N + M
	local size = 8 + floats * 8 + 5 + buffer.len(flags) + tree.leafCount * I
	local b = buffer.create(size)
	buffer.writeu8(b, 0, 0x41)
	buffer.writeu8(b, 1, 0x4C)
	buffer.writeu8(b, 2, 0x4E)
	buffer.writeu8(b, 3, Liquid.VERSION)
	buffer.writeu8(b, 4, N)
	buffer.writeu8(b, 5, I)
	buffer.writeu8(b, 6, M)
	buffer.writeu8(b, 7, model.K)
	local at = 8
	at = writeF64s(b, at, model.beta)
	at = writeF64s(b, at, model.B)
	at = writeF64s(b, at, model.kBase)
	at = writeF64s(b, at, model.Cf)
	at = writeF64s(b, at, model.Cb)
	at = writeF64s(b, at, model.d)
	buffer.writeu16(b, at, tree.width)
	buffer.writeu16(b, at + 2, tree.height)
	buffer.writeu8(b, at + 4, tree.maxDepth)
	at += 5
	buffer.copy(b, at, flags, 0, buffer.len(flags))
	at += buffer.len(flags)
	buffer.copy(b, at, tree.leafBytes, 0, tree.leafCount * I)
	return b
end

-- Parses a version-1 blob. Returns the model, the tree and the offset after the blob.
function Liquid.decode(b: buffer, offset: number?): (Model, Tree, number)
	local at = offset or 0
	assert(buffer.len(b) >= at + 8, "blob too short")
	assert(
		buffer.readu8(b, at) == 0x41 and buffer.readu8(b, at + 1) == 0x4C and buffer.readu8(b, at + 2) == 0x4E,
		"not an ALLAN blob (magic)"
	)
	local version = buffer.readu8(b, at + 3)
	assert(version == 1, `unsupported ALLAN version {version}`)
	local N, I, M, K = buffer.readu8(b, at + 4), buffer.readu8(b, at + 5), buffer.readu8(b, at + 6), buffer.readu8(b, at + 7)
	at += 8
	local floats = N + N * I + N + 2 * M * N + M
	assert(buffer.len(b) >= at + floats * 8 + 5, "blob truncated in the model arrays")
	local beta, B, kBase, Cf, Cb, d
	beta, at = readF64s(b, at, N)
	B, at = readF64s(b, at, N * I)
	kBase, at = readF64s(b, at, N)
	Cf, at = readF64s(b, at, M * N)
	Cb, at = readF64s(b, at, M * N)
	d, at = readF64s(b, at, M)
	local model = Liquid.newModel({ N = N, I = I, M = M, K = K, beta = beta, B = B, kBase = kBase, Cf = Cf, Cb = Cb, d = d })
	local width, height, maxDepth = buffer.readu16(b, at), buffer.readu16(b, at + 2), buffer.readu8(b, at + 4)
	local tree, after = parseTree(b, at + 5, width, height, maxDepth, I)
	return model, tree, after
end

local function sizeOf(nodes: buffer, n: number): number
	local v = buffer.readu32(nodes, n * 4)
	return if v % 2 == 1 then 1 else v // 2
end

-- Leaf containing pixel (x, y) of the stored tree: leaf index and depth. It walks the tree
-- independently of the row traversal used by the event renderer; the reference uses it.
-- Returns -1, -1 outside the image.
function Liquid.leafAt(tree: Tree, x: number, y: number): (number, number)
	if x < 0 or y < 0 or x >= tree.width or y >= tree.height then
		return -1, -1
	end
	local nodes = tree.nodes
	local n, x0, y0, side, depth = 0, 0, 0, tree.S, 0
	while true do
		local v = buffer.readu32(nodes, n * 4)
		if v % 2 == 1 then
			return (v - 1) // 2, depth
		end
		local h = side // 2
		local c = n + 1
		local right = x >= x0 + h
		local bottom = y >= y0 + h
		if bottom then
			c += sizeOf(nodes, c) -- skip child 0
			c += sizeOf(nodes, c) -- skip child 1
		end
		if right then
			c += sizeOf(nodes, c) -- skip the left child of the chosen pair
		end
		n = c
		if right then
			x0 += h
		end
		if bottom then
			y0 += h
		end
		side = h
		depth += 1
	end
end

----------------------------------------------------------------------------------------
-- Plan: everything that depends only on the model and the root size, precomputed once.
-- Every table is filled by a fixed sequence of deterministic operations, so every client
-- holds bit-identical tables (part of the fixed evaluation schedule of T1 and T7).
----------------------------------------------------------------------------------------

export type Plan = {
	model: Model,
	N: number,
	I: number,
	M: number,
	K: number,
	P: number, -- log2 of the stored root side
	S: number, -- stored root side
	R: number, -- log2 render scale r (X4); rendered geometry is the stored one times 2^R
	Wr: number, -- rendered width = width * 2^R
	Hr: number, -- rendered height
	Sr: number, -- rendered root side
	T: number, -- longest segment the power tables cover (= Sr)
	TP1: number, -- T + 1
	U: { number }, -- U[byte + 1] = byte / 255
	gk: { number }, -- gk[k + 1] = 2^-k
	pw: { number }, -- pw[k * TP1 + n + 1] = a_k^n, n = 0..T
	S1: { number }, -- S1[k * TP1 + n + 1] = sum_{t < n} a_k^t
	NT: { number }, -- NT[k * (JMAX + 1) + j + 1] = smallest n <= T with a_k^n <= 2^-j, else T + 1
	Csum: { number }, -- Cf + Cb
	kOf: { number }, -- kOf[t * N + i] = gain exponent of neuron i (1-based) in a leaf of depth t
	pwOff: { number }, -- pwOff[t * N + i] = kOf * TP1 + 1
	nCls: { number }, -- nCls[t + 1] = number of distinct gains k >= 1 at depth t
	clsK: { number }, -- clsK[t * K + c] = gain of class c at depth t, ascending
	clsOf: { number }, -- clsOf[t * N + i] = class of neuron i at depth t, 0 when k = 0
	G: { number }, -- G[L * K + k + 1] = S1[k][2^L] / 2^L (T5 footprint factor)
	-- fast path (M <= 4): tracked neurons are those with k >= 1 at some depth; the others
	-- are instant everywhere (h = b exactly) and never enter a transient
	nt: number,
	trk: { number }, -- trk[j] = neuron index of tracked neuron j
	trkOff: { number }, -- trkOff[t * nt + j] = pw offset of tracked neuron j at depth t
	trkCls: { number }, -- trkCls[t * nt + j] = its class at depth t (0 when k = 0 there)
	CfT4: { number }, -- CfT4[(j - 1) * 4 + m] = Cf[m][trk[j]], zero for m > M
	CbT4: { number },
	-- tracked neurons with equal kBase share k at every depth: a group. The fast path
	-- tracks each group's readout-projected state sum_{i in g} Cf[m][i] h_i (and Cb), which
	-- jumps exactly like one neuron (linearity), so no per-segment projection is needed.
	NG: number,
	grpOf: { number }, -- grpOf[j] = group of tracked neuron j
	grpOff: { number }, -- grpOff[t * G + g] = pw offset of group g at depth t
	grpCls: { number }, -- grpCls[t * G + g] = class of group g at depth t (0 when k = 0)
	maxSeg: number,
	scratch: any,
}

-- renderScale: log2 of the render scale r (default 0). The plan depends on the tree only
-- through its root size, so trees of equal root size can share a plan.
function Liquid.prepare(model: Model, tree: Tree, renderScale: number?): Plan
	local N, I, M, K = model.N, model.I, model.M, model.K
	assert(tree.I == I, "tree and model disagree on I")
	local R = renderScale or 0
	assert(R >= 0 and R <= 8 and R % 1 == 0, "render scale must be an integer in 0..8")
	local P, S = tree.P, tree.S
	local sf = pow2(R)
	local T = S * sf
	assert(T <= 65536, "rendered root side above 65536")
	local TP1 = T + 1
	local U = table.create(256, 0)
	for v = 0, 255 do
		U[v + 1] = v / 255
	end
	local gk = table.create(K, 0)
	for k = 0, K - 1 do
		gk[k + 1] = POW2N[k + 1] -- 2^-k exactly
	end
	local pw = table.create(K * TP1, 0)
	local S1 = table.create(K * TP1, 0)
	local NT = table.create(K * (JMAX + 1), 0)
	for k = 0, K - 1 do
		local a = 1 - gk[k + 1]
		local base = k * TP1
		pw[base + 1] = 1
		if T >= 1 then
			pw[base + 2] = a
		end
		for n = 2, T do
			local h = n // 2
			pw[base + n + 1] = pw[base + h + 1] * pw[base + n - h + 1]
		end
		S1[base + 1] = 0
		for n = 1, T do
			S1[base + n + 1] = S1[base + n] + pw[base + n]
		end
		local j = 0
		local thr = 1
		local nb = k * (JMAX + 1)
		for n = 0, T do
			local p = pw[base + n + 1]
			while j <= JMAX and p <= thr do
				NT[nb + j + 1] = n
				j += 1
				thr *= 0.5
			end
		end
		while j <= JMAX do
			NT[nb + j + 1] = T + 1
			j += 1
		end
	end
	local Csum = table.create(M * N, 0)
	for j = 1, M * N do
		Csum[j] = model.Cf[j] + model.Cb[j]
	end
	local kOf = table.create((P + 1) * N, 0)
	local pwOff = table.create((P + 1) * N, 0)
	local nCls = table.create(P + 1, 0)
	local clsK = table.create((P + 1) * K, 0)
	local clsOf = table.create((P + 1) * N, 0)
	for t = 0, P do
		local present = table.create(K, false)
		for i = 1, N do
			local k = model.kBase[i] + (P - t) + R
			if k < 0 then
				k = 0
			elseif k > K - 1 then
				k = K - 1
			end
			kOf[t * N + i] = k
			pwOff[t * N + i] = k * TP1 + 1
			if k >= 1 then
				present[k + 1] = true
			end
		end
		local nc = 0
		local idx = table.create(K, 0)
		for k = 1, K - 1 do
			if present[k + 1] then
				nc += 1
				clsK[t * K + nc] = k
				idx[k + 1] = nc
			end
		end
		nCls[t + 1] = nc
		for i = 1, N do
			local k = kOf[t * N + i]
			clsOf[t * N + i] = if k >= 1 then idx[k + 1] else 0
		end
	end
	local G = table.create((P + R + 1) * K, 0)
	for L = 0, P + R do
		local F = pow2(L)
		for k = 0, K - 1 do
			G[L * K + k + 1] = S1[k * TP1 + F + 1] / F
		end
	end
	local trk: { number } = {}
	for i = 1, N do
		local tracked = false
		for t = 0, P do
			if kOf[t * N + i] >= 1 then
				tracked = true
			end
		end
		if tracked then
			table.insert(trk, i)
		end
	end
	local nt = #trk
	local trkOff = table.create((P + 1) * math.max(nt, 1), 0)
	local trkCls = table.create((P + 1) * math.max(nt, 1), 0)
	for t = 0, P do
		for j = 1, nt do
			trkOff[t * nt + j] = pwOff[t * N + trk[j]]
			trkCls[t * nt + j] = clsOf[t * N + trk[j]]
		end
	end
	local grpOf = table.create(math.max(nt, 1), 0)
	local grpBase: { number } = {}
	local grpRep: { number } = {}
	for j = 1, nt do
		local kb = model.kBase[trk[j]]
		local g = 0
		for q = 1, #grpBase do
			if grpBase[q] == kb then
				g = q
			end
		end
		if g == 0 then
			table.insert(grpBase, kb)
			table.insert(grpRep, trk[j])
			g = #grpBase
		end
		grpOf[j] = g
	end
	local NG = #grpBase
	local grpOff = table.create((P + 1) * math.max(NG, 1), 0)
	local grpCls = table.create((P + 1) * math.max(NG, 1), 0)
	for t = 0, P do
		for g = 1, NG do
			grpOff[t * NG + g] = pwOff[t * N + grpRep[g]]
			grpCls[t * NG + g] = clsOf[t * N + grpRep[g]]
		end
	end
	local CfT4 = table.create(math.max(nt, 1) * 4, 0)
	local CbT4 = table.create(math.max(nt, 1) * 4, 0)
	for j = 1, nt do
		for m = 1, math.min(M, 4) do
			CfT4[(j - 1) * 4 + m] = model.Cf[(m - 1) * N + trk[j]]
			CbT4[(j - 1) * 4 + m] = model.Cb[(m - 1) * N + trk[j]]
		end
	end
	local plan: Plan = {
		model = model,
		N = N,
		I = I,
		M = M,
		K = K,
		P = P,
		S = S,
		R = R,
		Wr = tree.width * sf,
		Hr = tree.height * sf,
		Sr = T,
		T = T,
		TP1 = TP1,
		U = U,
		gk = gk,
		pw = pw,
		S1 = S1,
		NT = NT,
		Csum = Csum,
		kOf = kOf,
		pwOff = pwOff,
		nCls = nCls,
		clsK = clsK,
		clsOf = clsOf,
		G = G,
		nt = nt,
		trk = trk,
		trkOff = trkOff,
		trkCls = trkCls,
		CfT4 = CfT4,
		CbT4 = CbT4,
		NG = NG,
		grpOf = grpOf,
		grpOff = grpOff,
		grpCls = grpCls,
		maxSeg = T + 2,
		scratch = nil,
	}
	return plan
end

-- Smallest j >= 0 with 2^j >= r, for r > 0, by exact binary exponent search (multiplying
-- by powers of two is exact): at most 10 comparisons, no logarithm. Proof in LIQUID.md T3.
local function ceilLog2(r: number): number
	if r <= 1 then
		return 0
	end
	local e = 0
	if r > POW2[512 + 1] then
		r *= POW2N[512 + 1]
		e += 512
	end
	if r > POW2[256 + 1] then
		r *= POW2N[256 + 1]
		e += 256
	end
	if r > POW2[128 + 1] then
		r *= POW2N[128 + 1]
		e += 128
	end
	if r > POW2[64 + 1] then
		r *= POW2N[64 + 1]
		e += 64
	end
	if r > POW2[32 + 1] then
		r *= POW2N[32 + 1]
		e += 32
	end
	if r > 65536 then
		r *= POW2N[16 + 1]
		e += 16
	end
	if r > 256 then
		r *= POW2N[8 + 1]
		e += 8
	end
	if r > 16 then
		r *= POW2N[4 + 1]
		e += 4
	end
	if r > 4 then
		r *= 0.25
		e += 2
	end
	if r > 2 then
		e += 1
	end
	return e + 1
end
Liquid.ceilLog2 = ceilLog2

-- Distance from z to the nearest point where clamp(floor(z + 0.5), 0, 255) changes.
local function margin(z: number): number
	if z < 0.5 then
		return 0.5 - z
	end
	if z >= 254.5 then
		return z - 254.5
	end
	local f = z + 0.5 - floor(z + 0.5)
	return if f < 0.5 then f else 1 - f
end
Liquid.margin = margin

----------------------------------------------------------------------------------------
-- Scratch space (per plan): segment arrays, traversal stack, per-segment work arrays
----------------------------------------------------------------------------------------

type Scratch = {
	cap: number,
	sx: { number }, -- segment start (base pixels, absolute)
	sl: { number }, -- segment length
	skey: { number }, -- leaf content key (equal key and depth <=> identical dynamics)
	sleaf: { number }, -- a leaf index carrying the content (for its bytes)
	sdep: { number }, -- leaf depth
	sb: { number }, -- targets b, N per segment
	seb: { number }, -- backward entering residuals, N per segment
	h: { number },
	ef: { number },
	stN: { number },
	stX: { number },
	stY: { number },
	stS: { number },
	stD: { number },
	stV: { number }, -- 1 if the stack entry is a virtual node (endless mode)
	zinf: { number },
	tau: { number },
	Qf: { number },
	Qb: { number },
	fOff: { number },
	fQ: { number },
	fDrop: { number },
	bOff: { number },
	bQ: { number },
	bDrop: { number },
	wf: { number },
	wb: { number },
	z: { number },
	pend: { number },
	acc: { number },
	sigv: { number }, -- per-segment signature values of the last segmented row (dedup)
	stats: Stats,
}

export type Stats = {
	rows: number, -- output rows produced
	rendered: number, -- row renders (band rows actually evaluated)
	copied: number, -- output rows produced by buffer.copy of an identical row
	deduped: number, -- band rows reused from an identical earlier band (cross-band dedup)
	multiBand: number, -- output rows needing the vertical box merge
	segments: number, -- segments rendered (events)
	evals: number, -- per-pixel closed-form evaluations (transients)
	pieces: number, -- partial footprint pieces
	fills: number, -- fill spans
	fillPixels: number, -- pixels written by fills
	searchProbes: number, -- bound evaluations made by the n0 search
	seam: number, -- endless mode: largest X3 certificate of the rendered block rows
	terms: number, -- transient pixels: terms looked at after trailing T4 trims (fast path)
}

local function newStats(): Stats
	return {
		rows = 0,
		rendered = 0,
		copied = 0,
		deduped = 0,
		multiBand = 0,
		segments = 0,
		evals = 0,
		pieces = 0,
		fills = 0,
		fillPixels = 0,
		searchProbes = 0,
		seam = 0,
		terms = 0,
	}
end
Liquid.newStats = newStats

local function getScratch(plan: Plan, minCap: number): Scratch
	local sc: Scratch? = plan.scratch
	if sc and sc.cap >= minCap then
		return sc
	end
	local cap = math.max(minCap, plan.maxSeg)
	local N, K = plan.N, plan.K
	local M = math.max(plan.M, 4)
	local depthCap = 4 * (plan.P + 40)
	local new: any = {
		slot = table.create(cap, 0),
		tmpB = table.create(N, 0),
		rowB = table.create(cap * math.max(plan.nt, 1), 0),
		rowPF = table.create(cap * math.max(plan.NG, 1) * 4, 0),
		rowPB = table.create(cap * math.max(plan.NG, 1) * 4, 0),
		hP = table.create(math.max(plan.NG, 1) * 4, 0),
		efP = table.create(math.max(plan.NG, 1) * 4, 0),
		sebP = table.create(cap * math.max(plan.NG, 1) * 4, 0),
		rowZ = table.create(cap * 4, 0),
		rowMg = table.create(cap * 4, 0),
		rowCol = table.create(cap, 0),
		cacheTree = nil,
		cacheOn = false,
		fW = table.create(K, 0),
		fThr = table.create(K, 0),
		bW = table.create(K, 0),
		bThr = table.create(K, 0),
		aOff = table.create(K, 0),
		aQ = table.create(K * 4, 0),
		aThr = table.create(K, 0),
		oOff = table.create(K, 0),
		oQ = table.create(K * 4, 0),
		certF = table.create(math.max(plan.nt, 1), 1),
		certB = table.create(math.max(plan.nt, 1), 1),
		rangeTree = nil,
		ranges = nil,
	}
	local base: Scratch = {
		cap = cap,
		sx = table.create(cap, 0),
		sl = table.create(cap, 0),
		skey = table.create(cap, 0),
		sleaf = table.create(cap, 0),
		sdep = table.create(cap, 0),
		sb = table.create(cap * N, 0),
		seb = table.create(cap * N, 0),
		h = table.create(N, 0),
		ef = table.create(N, 0),
		stN = table.create(depthCap, 0),
		stX = table.create(depthCap, 0),
		stY = table.create(depthCap, 0),
		stS = table.create(depthCap, 0),
		stD = table.create(depthCap, 0),
		stV = table.create(depthCap, 0),
		zinf = table.create(M, 0),
		tau = table.create(M, 0),
		Qf = table.create(K * M, 0),
		Qb = table.create(K * M, 0),
		fOff = table.create(K, 0),
		fQ = table.create(K * M, 0),
		fDrop = table.create(K, 0),
		bOff = table.create(K, 0),
		bQ = table.create(K * M, 0),
		bDrop = table.create(K, 0),
		wf = table.create(K, 0),
		wb = table.create(K, 0),
		z = table.create(M, 0),
		pend = table.create(M, 0),
		acc = {},
		sigv = table.create(cap, 0),
		stats = newStats(),
	}
	for k, v in base :: any do
		new[k] = v
	end
	plan.scratch = new
	return new
end

----------------------------------------------------------------------------------------
-- Row segmentation of the stored tree. Fills the scratch segment arrays with the leaves
-- crossed by row y inside [xa, xb), left to right, merging neighbours with identical
-- content and depth (identical dynamics). Returns the count and the band end: the smallest
-- bottom edge among the crossed leaves, so rows y .. bandEnd - 1 cross the same leaves.
----------------------------------------------------------------------------------------

-- Coordinates are rendered pixels (stored geometry times 2^R).
local function segmentStored(plan: Plan, tree: Tree, sc: Scratch, y: number, xa: number, xb: number, count: number): (number, number)
	local nodes = tree.nodes
	local leafKey, leafDepth = tree.leafKey, tree.leafDepth
	local W, H, T = plan.Wr, plan.Hr, plan.T
	local stN, stX, stY, stS, stD = sc.stN, sc.stX, sc.stY, sc.stS, sc.stD
	local sx, sl, skey, sleaf, sdep = sc.sx, sc.sl, sc.skey, sc.sleaf, sc.sdep
	local bandEnd = math.huge
	if y < 0 or y >= H then
		return count, bandEnd
	end
	if xb > W then
		xb = W
	end
	local sp = 1
	stN[1], stX[1], stY[1], stS[1], stD[1] = 0, 0, 0, plan.Sr, 0
	while sp > 0 do
		local n, x0, y0, side, dep = stN[sp], stX[sp], stY[sp], stS[sp], stD[sp]
		sp -= 1
		if x0 >= xb or x0 + side <= xa then
			continue
		end
		local v = buffer.readu32(nodes, n * 4)
		if v % 2 == 1 then
			local leaf = (v - 1) // 2
			local yEnd = y0 + side
			if yEnd < bandEnd then
				bandEnd = yEnd
			end
			local s0 = if x0 > xa then x0 else xa
			local e0 = x0 + side
			if e0 > xb then
				e0 = xb
			end
			local key = buffer.readu32(leafKey, leaf * 4)
			local ld = buffer.readu8(leafDepth, leaf)
			if count > 0 and skey[count] == key and sdep[count] == ld and e0 - sx[count] <= T then
				sl[count] = e0 - sx[count]
			else
				count += 1
				sx[count] = s0
				sl[count] = e0 - s0
				skey[count] = key
				sleaf[count] = leaf
				sdep[count] = ld
			end
		else
			local h = side // 2
			local c = n + 1
			local d1 = dep + 1
			local yy = y0
			if y >= y0 + h then
				c += sizeOf(nodes, c)
				c += sizeOf(nodes, c)
				yy = y0 + h
			end
			-- push the right child first so the left one is processed first
			sp += 1
			stN[sp], stX[sp], stY[sp], stS[sp], stD[sp] = c + sizeOf(nodes, c), x0 + h, yy, h, d1
			sp += 1
			stN[sp], stX[sp], stY[sp], stS[sp], stD[sp] = c, x0, yy, h, d1
		end
	end
	if bandEnd > H then
		bandEnd = H
	end
	return count, bandEnd
end

-- Targets b (N values) of leaf `leaf` into dst[at + 1 .. at + N], in the header's order.
local function leafTargets(plan: Plan, tree: Tree, leaf: number, dst: { number }, at: number)
	local model = plan.model
	local N, I = plan.N, plan.I
	local beta, B, U = model.beta, model.B, plan.U
	local lb = tree.leafBytes
	local o = leaf * I
	for i = 1, N do
		local b = beta[i]
		local bi = (i - 1) * I
		for t = 0, I - 1 do
			b = b + B[bi + t + 1] * U[buffer.readu8(lb, o + t) + 1]
		end
		dst[at + i] = b
	end
end

----------------------------------------------------------------------------------------
-- X3 endless textures. The plane is tiled by blocks of the rendered root side Sr; block
-- (0, 0) holds the stored tree. Every other block, and every stored node with no pixel
-- inside the image, is a virtual quadtree: a node of depth t at stored-pixel origin
-- (xs, ys) splits iff t < maxDepth and hash2(xs, ys, seedT) mod nodesAt[t] < splitsAt[t]
-- (the stored tree's split ratio at that depth), and a virtual leaf takes the content of
-- the stored leaf leavesAt[t][hash2(xs, ys, seedL) mod #leavesAt[t]] (any inside leaf when
-- the stored tree has none at that depth). Only stored contents ever appear, so the
-- trained readout sees inputs from its own distribution. Integers and bit32 only: every
-- client generates the same leaves.
----------------------------------------------------------------------------------------

local function virtualStats(tree: Tree): VirtualStats
	local v = tree.virt
	if v then
		return v
	end
	local D = tree.maxDepth
	local nodesAt, splitsAt = table.create(D + 1, 0), table.create(D + 1, 0)
	local leavesAt: { { number } } = {}
	for t = 1, D + 1 do
		leavesAt[t] = {}
	end
	local all: { number } = {}
	local nodes, W, H = tree.nodes, tree.width, tree.height
	local function walk(n: number, depth: number, x0: number, y0: number, side: number): number
		local val = buffer.readu32(nodes, n * 4)
		local inside = x0 < W and y0 < H
		if val % 2 == 1 then
			if inside then
				nodesAt[depth + 1] += 1
				table.insert(leavesAt[depth + 1], (val - 1) // 2)
				table.insert(all, (val - 1) // 2)
			end
			return 1
		end
		if inside then
			nodesAt[depth + 1] += 1
			splitsAt[depth + 1] += 1
		end
		local h = side // 2
		local c = n + 1
		c += walk(c, depth + 1, x0, y0, h)
		c += walk(c, depth + 1, x0 + h, y0, h)
		c += walk(c, depth + 1, x0, y0 + h, h)
		c += walk(c, depth + 1, x0 + h, y0 + h, h)
		return c - n
	end
	walk(0, 0, 0, 0, tree.S)
	local stats: VirtualStats = { nodesAt = nodesAt, splitsAt = splitsAt, leavesAt = leavesAt, all = all }
	tree.virt = stats
	return stats
end

export type Endless = {
	seed: number, -- any integer; selects the virtual canvas
	horizon: number?, -- largest warm-up, in blocks on each side of a block (default 2)
	tolerance: number?, -- certificate the warm-up must reach, output units (default 2^-24)
}

-- Leaf of the virtual canvas containing stored pixel (xs, ys): (stored leaf index whose
-- content it carries, depth). Independent of the row traversal; the endless reference uses it.
function Liquid.virtualLeafAt(tree: Tree, xs: number, ys: number, seed: number): (number, number)
	local V = virtualStats(tree)
	local S, D = tree.S, tree.maxDepth
	local W, H = tree.width, tree.height
	local bx, by = xs // S, ys // S
	local x0, y0, side, depth = bx * S, by * S, S, 0
	local n = if bx == 0 and by == 0 then 0 else -1
	local seedL = hash2(0, 0x1EAF, seed)
	while true do
		if n >= 0 and not (x0 < W and y0 < H) then
			n = -1 -- stored node outside the image: virtual from here on
		end
		if n >= 0 then
			local val = buffer.readu32(tree.nodes, n * 4)
			if val % 2 == 1 then
				return (val - 1) // 2, depth
			end
		else
			local cnt = V.nodesAt[depth + 1]
			local split = depth < D and cnt > 0 and hash2(x0, y0, hash2(depth, 0x5B1, seed)) % cnt < V.splitsAt[depth + 1]
			if not split then
				local list = V.leavesAt[depth + 1]
				if #list == 0 then
					list = V.all
				end
				return list[hash2(x0, y0, seedL) % #list + 1], depth
			end
		end
		local h = side // 2
		local right = xs >= x0 + h
		local bottom = ys >= y0 + h
		if n >= 0 then
			local c = n + 1
			if bottom then
				c += sizeOf(tree.nodes, c)
				c += sizeOf(tree.nodes, c)
			end
			if right then
				c += sizeOf(tree.nodes, c)
			end
			n = c
		end
		if right then
			x0 += h
		end
		if bottom then
			y0 += h
		end
		side = h
		depth += 1
	end
end

-- Endless counterpart of segmentStored: segments of rendered row y over [xa, xb) on the
-- virtual canvas (any integers), merged like the stored ones.
local function segmentEndless(plan: Plan, tree: Tree, sc: Scratch, y: number, xa: number, xb: number, seed: number): (number, number)
	local V = virtualStats(tree)
	local nodes = tree.nodes
	local leafKey = tree.leafKey
	local sf = pow2(plan.R)
	local Sr, T, D = plan.Sr, plan.T, tree.maxDepth
	local Wr, Hr = plan.Wr, plan.Hr
	local nodesAt, splitsAt, leavesAt, all = V.nodesAt, V.splitsAt, V.leavesAt, V.all
	local stN, stX, stY, stS, stD = sc.stN, sc.stX, sc.stY, sc.stS, sc.stD
	local sx, sl, skey, sleaf, sdep = sc.sx, sc.sl, sc.skey, sc.sleaf, sc.sdep
	local seedL = hash2(0, 0x1EAF, seed)
	local count = 0
	local bandEnd = math.huge
	local by = y // Sr
	for bx = xa // Sr, (xb - 1) // Sr do
		local sp = 1
		stN[1], stX[1], stY[1], stS[1], stD[1] = if bx == 0 and by == 0 then 0 else -1, bx * Sr, by * Sr, Sr, 0
		while sp > 0 do
			local n, x0, y0, side, dep = stN[sp], stX[sp], stY[sp], stS[sp], stD[sp]
			sp -= 1
			if x0 >= xb or x0 + side <= xa then
				continue
			end
			if n >= 0 and not (x0 < Wr and y0 < Hr) then
				n = -1
			end
			local leaf = -1
			if n >= 0 then
				local val = buffer.readu32(nodes, n * 4)
				if val % 2 == 1 then
					leaf = (val - 1) // 2
				end
			else
				local xs, ys = x0 // sf, y0 // sf
				local cnt = nodesAt[dep + 1]
				local split = dep < D and cnt > 0 and hash2(xs, ys, hash2(dep, 0x5B1, seed)) % cnt < splitsAt[dep + 1]
				if not split then
					local list = leavesAt[dep + 1]
					if #list == 0 then
						list = all
					end
					leaf = list[hash2(xs, ys, seedL) % #list + 1]
				end
			end
			if leaf >= 0 then
				local yEnd = y0 + side
				if yEnd < bandEnd then
					bandEnd = yEnd
				end
				local s0 = if x0 > xa then x0 else xa
				local e0 = x0 + side
				if e0 > xb then
					e0 = xb
				end
				local key = buffer.readu32(leafKey, leaf * 4)
				if count > 0 and skey[count] == key and sdep[count] == dep and e0 - sx[count] <= T then
					sl[count] = e0 - sx[count]
				else
					count += 1
					sx[count] = s0
					sl[count] = e0 - s0
					skey[count] = key
					sleaf[count] = leaf
					sdep[count] = dep
				end
			else
				local h = side // 2
				local yy = y0
				local c0, c1 = -1, -1
				if n >= 0 then
					local c = n + 1
					if y >= y0 + h then
						c += sizeOf(nodes, c)
						c += sizeOf(nodes, c)
					end
					c0, c1 = c, c + sizeOf(nodes, c)
				end
				if y >= y0 + h then
					yy = y0 + h
				end
				sp += 1
				stN[sp], stX[sp], stY[sp], stS[sp], stD[sp] = c1, x0 + h, yy, h, dep + 1
				sp += 1
				stN[sp], stX[sp], stY[sp], stS[sp], stD[sp] = c0, x0, yy, h, dep + 1
			end
		end
	end
	return count, bandEnd
end

-- Seam bound of the endless mode (output units, per channel): two block windows that
-- overlap at a pixel disagree there by at most this much, so neighbouring pixels of two
-- blocks differ from a seamless canvas by at most this. Proof in docs/LIQUID.md (X3).
function Liquid.seamBound(plan: Plan, tree: Tree, horizon: number): number
	local model = plan.model
	local N, M = plan.N, plan.M
	local tmp = table.create(N, 0)
	local lo, hi = table.create(N, math.huge), table.create(N, -math.huge)
	for key = 0, tree.keyCount - 1 do
		leafTargets(plan, tree, buffer.readu32(tree.keyLeaf, key * 4), tmp, 0)
		for i = 1, N do
			if tmp[i] < lo[i] then
				lo[i] = tmp[i]
			end
			if tmp[i] > hi[i] then
				hi[i] = tmp[i]
			end
		end
	end
	local worst = 0
	local dist = horizon * plan.Sr
	for m = 0, M - 1 do
		local sum = 0
		for i = 1, N do
			local kmax = 0
			for t = 0, plan.P do
				local k = plan.kOf[t * N + i]
				if k > kmax then
					kmax = k
				end
			end
			local a = 1 - plan.gk[kmax + 1]
			-- a^dist by squaring (an upper estimate is fine here: rounding is 1e-13 relative)
			local p, base, e = 1, a, dist
			while e > 0 do
				if e % 2 == 1 then
					p *= base
				end
				base *= base
				e //= 2
			end
			sum += (math.abs(model.Cf[m * N + i]) + math.abs(model.Cb[m * N + i])) * (hi[i] - lo[i]) * p
		end
		if sum > worst then
			worst = sum
		end
	end
	return worst * (1 + 1e-9)
end

-- Range (max - min) of each tracked neuron's target over the stored contents: every state
-- of either pass lies in that range, so it bounds any state difference (X3 certificates).
local function trackedRanges(plan: Plan, tree: Tree, sc: any): { number }
	if sc.rangeTree == tree then
		return sc.ranges
	end
	local N, nt, trk = plan.N, plan.nt, plan.trk
	local tmp = table.create(N, 0)
	local lo, hi = table.create(nt, math.huge), table.create(nt, -math.huge)
	for key = 0, tree.keyCount - 1 do
		leafTargets(plan, tree, buffer.readu32(tree.keyLeaf, key * 4), tmp, 0)
		for j = 1, nt do
			local b = tmp[trk[j]]
			if b < lo[j] then
				lo[j] = b
			end
			if b > hi[j] then
				hi[j] = b
			end
		end
	end
	local r = table.create(nt, 0)
	for j = 1, nt do
		r[j] = if hi[j] >= lo[j] then hi[j] - lo[j] else 0
	end
	sc.rangeTree = tree
	sc.ranges = r
	return r
end

-- A-posteriori X3 certificate for the segments 1..n in the scratch, which cover a window
-- [wa, wb) whose passes start at rest: every output of a pixel in [xl, xr) differs from the
-- infinite-row model (any history beyond the window) by at most the returned value, per
-- channel. It is the actual contraction of each neuron from wa to xl and from wb to xr,
-- times its state range and readout weights (proof in docs/LIQUID.md, X3).
local function windowCert(plan: Plan, tree: Tree, sc: any, n: number, xl: number, xr: number): number
	local nt = plan.nt
	if nt == 0 then
		return 0
	end
	local E = trackedRanges(plan, tree, sc)
	local pw, trkOff = plan.pw, plan.trkOff
	local sx, sl, sdep = sc.sx, sc.sl, sc.sdep
	local cf, cb = sc.certF, sc.certB
	for j = 1, nt do
		cf[j], cb[j] = 1, 1
	end
	for s = 1, n do
		local x0 = sx[s]
		local x1 = x0 + sl[s]
		local to = sdep[s] * nt
		local f1 = if x1 < xl then x1 else xl
		if f1 > x0 then
			for j = 1, nt do
				cf[j] *= pw[trkOff[to + j] + f1 - x0]
			end
		end
		local b0 = if x0 > xr then x0 else xr
		if x1 > b0 then
			for j = 1, nt do
				cb[j] *= pw[trkOff[to + j] + x1 - b0]
			end
		end
	end
	local CfT4, CbT4 = plan.CfT4, plan.CbT4
	local worst = 0
	for m = 1, math.min(plan.M, 4) do
		local sum = 0
		for j = 1, nt do
			local co = (j - 1) * 4 + m
			sum += (math.abs(CfT4[co]) * cf[j] + math.abs(CbT4[co]) * cb[j]) * E[j]
		end
		if sum > worst then
			worst = sum
		end
	end
	return worst * (1 + 1e-9) -- covers the rounding of the products (relative 1e-13)
end

-- Certificate of the window [wa, wb) of rendered row y on the endless canvas for pixels in
-- [xl, xr) (see windowCert). Exposed for tests and tools.
function Liquid.windowCertificate(plan: Plan, tree: Tree, y: number, wa: number, wb: number, xl: number, xr: number, seed: number): number
	local sc: any = getScratch(plan, wb - wa + 2)
	local n = segmentEndless(plan, tree, sc, y, wa, wb, seed)
	return windowCert(plan, tree, sc, n, xl, xr)
end

-- Public helper for tests: segments of row y as { {x, len, leaf, depth}, ... } plus band end.
function Liquid.rowSegments(plan: Plan, tree: Tree, y: number): ({ { number } }, number)
	local sc = getScratch(plan, plan.Wr + 2)
	local n, bandEnd = segmentStored(plan, tree, sc, y, 0, plan.Wr, 0)
	local out = {}
	for s = 1, n do
		out[s] = { sc.sx[s], sc.sl[s], sc.sleaf[s], sc.sdep[s] }
	end
	return out, bandEnd
end

----------------------------------------------------------------------------------------
-- Reference renderer: the model stepped pixel by pixel, literally as in the header.
----------------------------------------------------------------------------------------

-- Real-valued outputs of rendered row y over the window [xa, xb), both passes at rest at
-- the window ends: zOut[((x - xa) * M + m) + 1], m in [0, M). leafFn(x, y) -> (leaf,
-- depth) gives the leaf of each rendered pixel.
function Liquid.referenceSpan(plan: Plan, tree: Tree, y: number, xa: number, xb: number, zOut: { number }, leafFn: (number, number) -> (number, number))
	local model = plan.model
	local N, M = plan.N, plan.M
	local W = xb - xa
	local Cf, Cb, d = model.Cf, model.Cb, model.d
	local kOf, gk = plan.kOf, plan.gk
	local lookup = function(x: number, yy: number): (number, number)
		return leafFn(x + xa, yy)
	end
	-- per-pixel b and g
	local bs = table.create(W * N, 0)
	local gs = table.create(W * N, 0)
	local lastLeaf, lastDepth = -2, -2
	local tmp = table.create(N, 0)
	for x = 0, W - 1 do
		local leaf, depth = lookup(x, y)
		if leaf ~= lastLeaf or depth ~= lastDepth then
			leafTargets(plan, tree, leaf, tmp, 0)
			lastLeaf, lastDepth = leaf, depth
		end
		for i = 1, N do
			bs[x * N + i] = tmp[i]
			gs[x * N + i] = gk[kOf[depth * N + i] + 1]
		end
	end
	-- backward pass, at rest at its first pixel (x = W - 1)
	local hb = table.create(W * N, 0)
	local h = table.create(N, 0)
	for i = 1, N do
		h[i] = bs[(W - 1) * N + i]
	end
	for x = W - 1, 0, -1 do
		local o = x * N
		for i = 1, N do
			local hi = h[i]
			hi = hi + (bs[o + i] - hi) * gs[o + i]
			h[i] = hi
			hb[o + i] = hi
		end
	end
	-- forward pass and output
	for i = 1, N do
		h[i] = bs[i]
	end
	for x = 0, W - 1 do
		local o = x * N
		for i = 1, N do
			local hi = h[i]
			h[i] = hi + (bs[o + i] - hi) * gs[o + i]
		end
		for m = 0, M - 1 do
			local z = d[m + 1]
			local cm = m * N
			for i = 1, N do
				z = z + Cf[cm + i] * h[i]
			end
			for i = 1, N do
				z = z + Cb[cm + i] * hb[o + i]
			end
			zOut[x * M + m + 1] = z
		end
	end
end

-- Real-valued outputs of rendered row y: zOut[(x * M + m) + 1] for x in [0, Wr), m in
-- [0, M). leafFn(x, y) -> (leaf, depth) gives the leaf of each rendered pixel (default:
-- Liquid.leafAt on the stored pixel (x >> R, y >> R)).
function Liquid.referenceRow(plan: Plan, tree: Tree, y: number, zOut: { number }, leafFn: ((number, number) -> (number, number))?)
	local sf = pow2(plan.R)
	local lookup = leafFn or function(x: number, yy: number): (number, number)
		return Liquid.leafAt(tree, x // sf, yy // sf)
	end
	Liquid.referenceSpan(plan, tree, y, 0, plan.Wr, zOut, lookup)
end

-- Endless reference (X3): real values of the block column containing rendered pixel x,
-- stepped over that block's canonical window: zOut[((x - wa) * M + m) + 1] for x in the
-- window [wa, wb). Returns wa, wb.
function Liquid.referenceEndless(plan: Plan, tree: Tree, y: number, block: number, horizon: number, seed: number, zOut: { number }): (number, number)
	local Sr = plan.Sr
	local sf = pow2(plan.R)
	local wa, wb = (block - horizon) * Sr, (block + 1 + horizon) * Sr
	Liquid.referenceSpan(plan, tree, y, wa, wb, zOut, function(x: number, yy: number): (number, number)
		return Liquid.virtualLeafAt(tree, x // sf, yy // sf, seed)
	end)
	return wa, wb
end

local function quant(z: number): number
	local q = floor(z + 0.5)
	return if q < 0 then 0 elseif q > 255 then 255 else q
end
Liquid.quantize = quant

local function packZ(z: { number }, M: number, base: number): number
	-- channels base+1 .. base+4 of z (1-based) into RGBA8; missing alpha 255, others 0
	local n = M - base
	local r = if n >= 1 then quant(z[base + 1]) else 0
	local g = if n >= 2 then quant(z[base + 2]) else 0
	local b = if n >= 3 then quant(z[base + 3]) else 0
	local a = if n >= 4 then quant(z[base + 4]) else 255
	return r + g * 256 + b * 65536 + a * 16777216
end

----------------------------------------------------------------------------------------
-- Event renderer: one row.
--
-- Within a segment (constant b and a), with e = (state entering the segment) - b, the
-- state after n steps is b + e a^n (T1). Neurons of equal gain k at a depth form a class;
-- the readout collapses each class to one amplitude per channel, Qf[c][m] =
-- sum_{i in c} Cf[m][i] ef_i (Qb likewise), and k = 0 classes vanish after one step. For
-- an output pixel at level L (footprint F = 2^L rendered pixels, first forward step nf,
-- smallest backward step nb), the exact footprint average is (T5)
--     zinf_m + sum_c G[L][k_c] (Qf[c][m] a_c^nf + Qb[c][m] a_c^nb),
-- with zinf_m = d_m + sum_i (Cf + Cb)[m][i] b_i and G[L][k] = (1 - a^F) / (F g).
-- Fill rule (T2 with the quantisation margin): with tau_m = max(eps, margin(zinf_m) - ETA),
-- once sum_c |Qf'| a^nf <= tau_m / 2 (forward) and sum_c |Qb'| a^nb <= tau_m / 2
-- (backward), the pixel is the quantised zinf; it is within eps + 0.5 of the exact value,
-- and exactly the exact value's byte whenever tau_m exceeds eps. The fill region is found
-- by a galloping search capped by the logarithm-free T3 bound; transient pixels are
-- evaluated in closed form with the T4 decaying active set (dropped classes share eps).
----------------------------------------------------------------------------------------

-- Inserts class j (drop key `key`) keeping keys sorted descending (forward lists) or
-- ascending (backward lists); returns the new count.
local function insertSorted(off: { number }, q: { number }, drop: { number }, n: number, M: number, o: number, src: { number }, srcAt: number, key: number, descending: boolean): number
	local pos = n + 1
	while pos > 1 do
		local prev = drop[pos - 1]
		if (descending and prev >= key) or (not descending and prev <= key) then
			break
		end
		off[pos] = off[pos - 1]
		drop[pos] = prev
		local a, b = (pos - 1) * M, (pos - 2) * M
		for m = 1, M do
			q[a + m] = q[b + m]
		end
		pos -= 1
	end
	off[pos] = o
	drop[pos] = key
	local a = (pos - 1) * M
	for m = 1, M do
		q[a + m] = src[srcAt + m]
	end
	return n + 1
end

-- Renders output pixels X in [X0, X1) of one row at level L from the segments 1..nseg in
-- the scratch. mode 0 quantises and writes RGBA8 pixels at out[rowAt + (X - X0) * 4]
-- (channels 4..7 into out2 at the same offset); mode 1 adds wgt * z_m into
-- sc.acc[(X - X0) * M + m]. xEnd is the right edge (rendered pixels) used to clip the last
-- footprint.
local function eventRow(
	plan: Plan,
	tree: Tree,
	sc: Scratch,
	nseg: number,
	L: number,
	X0: number,
	X1: number,
	eps: number,
	mode: number,
	out: buffer,
	rowAt: number,
	out2: buffer?,
	wgt: number,
	xEnd: number
)
	local N, M, K = plan.N, plan.M, plan.K
	local model = plan.model
	local Cf, Cb, d = model.Cf, model.Cb, model.d
	local Csum, pw, S1, NT, G = plan.Csum, plan.pw, plan.S1, plan.NT, plan.G
	local pwOff, clsOf, clsK, nClsT = plan.pwOff, plan.clsOf, plan.clsK, plan.nCls
	local TP1, T = plan.TP1, plan.T
	local sx, sl, sleaf, sdep, sb, seb = sc.sx, sc.sl, sc.sleaf, sc.sdep, sc.sb, sc.seb
	local h, ef = sc.h, sc.ef
	local zinf, tau, Qf, Qb = sc.zinf, sc.tau, sc.Qf, sc.Qb
	local fOff, fQ, fDrop, bOff, bQ, bDrop = sc.fOff, sc.fQ, sc.fDrop, sc.bOff, sc.bQ, sc.bDrop
	local wfA, wbA = sc.wf, sc.wb
	local z, pend, acc = sc.z, sc.pend, sc.acc
	local stats = sc.stats
	local F = pow2(L)
	local GL = L * K
	local JW = JMAX + 1
	local hasEps = eps > 0
	local invEps = if hasEps then 1 / eps else 0

	-- emits one output pixel from z[1..M]
	local function emit(X: number)
		if mode == 0 then
			local at = rowAt + (X - X0) * 4
			buffer.writeu32(out, at, packZ(z, M, 0))
			if out2 and M > 4 then
				buffer.writeu32(out2, at, packZ(z, M, 4))
			end
		else
			local a = (X - X0) * M
			for m = 1, M do
				acc[a + m] += wgt * z[m]
			end
		end
	end

	-- 1. targets
	for s = 1, nseg do
		leafTargets(plan, tree, sleaf[s], sb, (s - 1) * N)
	end

	-- 2. backward sweep (closed-form jumps), at rest at the right end
	local last = (nseg - 1) * N
	for i = 1, N do
		h[i] = sb[last + i]
	end
	for s = nseg, 1, -1 do
		local base = (s - 1) * N
		local po = sdep[s] * N
		local len = sl[s]
		for i = 1, N do
			local b = sb[base + i]
			local e = h[i] - b
			seb[base + i] = e
			h[i] = b + e * pw[pwOff[po + i] + len]
		end
	end

	-- 3. forward sweep and output
	for i = 1, N do
		h[i] = sb[i]
	end
	local pendX, pendCnt = NONE, 0
	local xFirst, xLast = X0 * F, X1 * F
	for s = 1, nseg do
		local x0 = sx[s]
		if x0 >= xLast then
			break
		end
		local len = sl[s]
		local x1 = x0 + len
		local base = (s - 1) * N
		local dep = sdep[s]
		local po = dep * N
		for i = 1, N do
			ef[i] = h[i] - sb[base + i]
		end
		if x1 > xFirst then
			stats.segments += 1
			-- limit colour and class amplitudes
			for m = 0, M - 1 do
				local zz = d[m + 1]
				local cm = m * N
				for i = 1, N do
					zz = zz + Csum[cm + i] * sb[base + i]
				end
				zinf[m + 1] = zz
			end
			local nc = nClsT[dep + 1]
			local cK = dep * K
			for j = 1, nc * M do
				Qf[j] = 0
				Qb[j] = 0
			end
			for i = 1, N do
				local c = clsOf[po + i]
				if c > 0 then
					local e1, e2 = ef[i], seb[base + i]
					local qo = (c - 1) * M
					for m = 0, M - 1 do
						Qf[qo + m + 1] += Cf[m * N + i] * e1
						Qb[qo + m + 1] += Cb[m * N + i] * e2
					end
				end
			end

			local xe = if x1 < xEnd then x1 else xEnd
			local Xfirst = x0 // F
			local Xlast = (xe - 1) // F
			local Xfa = if x0 % F == 0 then Xfirst else Xfirst + 1
			local Xfb = if (Xlast + 1) * F <= xe then Xlast else Xlast - 1

			-- partial footprints: exact sums, accumulated across segments
			for pass = 1, 2 do
				local X: number, p0: number, p1: number = NONE, 0, 0
				if pass == 1 and Xfirst < Xfa then
					local e1 = (Xfirst + 1) * F
					X, p0, p1 = Xfirst, x0, if xe < e1 then xe else e1
				elseif pass == 2 and Xlast > Xfb and (Xlast ~= Xfirst or Xfirst >= Xfa) then
					local s2 = Xlast * F
					X, p0, p1 = Xlast, if x0 > s2 then x0 else s2, xe
				end
				if X >= X0 and X < X1 then
					stats.pieces += 1
					if pendX ~= X then
						if pendX ~= NONE then
							for m = 1, M do
								z[m] = pend[m] / pendCnt
							end
							emit(pendX)
						end
						pendX, pendCnt = X, 0
						for m = 1, M do
							pend[m] = 0
						end
					end
					local cnt = p1 - p0
					local nf1 = p0 - x0 + 1
					local nb1 = x1 - p1 + 1
					for m = 1, M do
						pend[m] += cnt * zinf[m]
					end
					for c = 1, nc do
						local off = clsK[cK + c] * TP1 + 1
						local sfac = S1[off + cnt]
						local pf = pw[off + nf1] * sfac
						local pb = pw[off + nb1] * sfac
						local qo = (c - 1) * M
						for m = 1, M do
							pend[m] += Qf[qo + m] * pf + Qb[qo + m] * pb
						end
					end
					pendCnt += cnt
					local full = (if (X + 1) * F < xEnd then (X + 1) * F else xEnd) - X * F
					if pendCnt == full then
						for m = 1, M do
							z[m] = pend[m] / pendCnt
						end
						emit(pendX)
						pendX = NONE
					end
				end
			end

			-- full footprints
			if Xfa <= Xfb and Xfb >= X0 and Xfa < X1 then
				local nf0 = Xfa * F - x0 + 1
				local nb0 = x1 - Xfa * F - F + 1
				-- thresholds (the quantisation margin only counts when the value is quantised
				-- right away, mode 0; accumulated values keep the plain eps bound)
				local noFill = false
				for m = 1, M do
					local t = if mode == 0 then margin(zinf[m]) - ETA else eps
					if t < eps then
						t = eps
					end
					if t <= 0 then
						noFill = true
						t = 1
					end
					tau[m] = 1 / t
				end
				-- scaled amplitudes and normalised weights
				local Wf, Wb = 0, 0
				local kmaxF, kmaxB = 0, 0
				for c = 1, nc do
					local k = clsK[cK + c]
					local gfac = G[GL + k + 1]
					local qo = (c - 1) * M
					local wf, wb = 0, 0
					for m = 1, M do
						local qf = Qf[qo + m] * gfac
						local qb = Qb[qo + m] * gfac
						Qf[qo + m] = qf
						Qb[qo + m] = qb
						local af = math.abs(qf) * tau[m]
						local ab = math.abs(qb) * tau[m]
						if af > wf then
							wf = af
						end
						if ab > wb then
							wb = ab
						end
					end
					wfA[c], wbA[c] = wf, wb
					if wf > 0 then
						Wf += wf
						kmaxF = k
					end
					if wb > 0 then
						Wb += wb
						kmaxB = k
					end
				end
				local hF = (if Wb == 0 then 1 else 0.5) * SHRINK
				local hB = (if Wf == 0 then 1 else 0.5) * SHRINK

				-- forward fill start: first X with sum_c wf_c a_c^nf(X) <= hF
				local X1f, X2b
				if noFill then
					X1f, X2b = Xfb + 1, Xfa - 1
				else
					if Wf == 0 then
						X1f = Xfa
					else
						local nHi = NT[kmaxF * JW + ceilLog2(Wf / hF) + 1]
						local hi = Xfb + 1
						if nHi <= T then
							local c = if nHi > nf0 then Xfa + (nHi - nf0 + F - 1) // F else Xfa
							if c < hi then
								hi = c
							end
						end
						local lo = Xfa - 1
						-- galloping: probe lo + 1, lo + 2, lo + 4, ...
						local step = 1
						while lo + step < hi do
							local X = lo + step
							local nfX = nf0 + (X - Xfa) * F
							local r = 0
							for c = 1, nc do
								r += wfA[c] * pw[clsK[cK + c] * TP1 + 1 + nfX]
							end
							stats.searchProbes += 1
							if r <= hF then
								hi = X
								break
							end
							lo = X
							step *= 2
						end
						while hi - lo > 1 do
							local X = (lo + hi) // 2
							local nfX = nf0 + (X - Xfa) * F
							local r = 0
							for c = 1, nc do
								r += wfA[c] * pw[clsK[cK + c] * TP1 + 1 + nfX]
							end
							stats.searchProbes += 1
							if r <= hF then
								hi = X
							else
								lo = X
							end
						end
						X1f = hi
					end
					-- backward fill end: last X with sum_c wb_c a_c^nb(X) <= hB
					if Wb == 0 then
						X2b = Xfb
					else
						local nHi = NT[kmaxB * JW + ceilLog2(Wb / hB) + 1]
						local lo = Xfa - 1
						if nHi <= T then
							if nHi <= nb0 then
								local c = Xfa + (nb0 - nHi) // F
								if c > lo then
									lo = c
								end
							end
						end
						if lo > Xfb then
							lo = Xfb
						end
						local hi = Xfb + 1
						local step = 1
						while hi - step > lo do
							local X = hi - step
							local nbX = nb0 - (X - Xfa) * F
							local r = 0
							for c = 1, nc do
								r += wbA[c] * pw[clsK[cK + c] * TP1 + 1 + nbX]
							end
							stats.searchProbes += 1
							if r <= hB then
								lo = X
								break
							end
							hi = X
							step *= 2
						end
						while hi - lo > 1 do
							local X = (lo + hi) // 2
							local nbX = nb0 - (X - Xfa) * F
							local r = 0
							for c = 1, nc do
								r += wbA[c] * pw[clsK[cK + c] * TP1 + 1 + nbX]
							end
							stats.searchProbes += 1
							if r <= hB then
								lo = X
							else
								hi = X
							end
						end
						X2b = lo
					end
				end

				-- fill
				local tEnd1, tStart2
				if X1f <= X2b then
					local fa = if X1f > X0 then X1f else X0
					local fb = if X2b < X1 - 1 then X2b else X1 - 1
					if fa <= fb then
						stats.fills += 1
						stats.fillPixels += fb - fa + 1
						if mode == 0 then
							for m = 1, M do
								z[m] = zinf[m]
							end
							local col = packZ(z, M, 0)
							fillSpan(out, rowAt + (fa - X0) * 4, fb - fa + 1, col)
							if out2 and M > 4 then
								fillSpan(out2, rowAt + (fa - X0) * 4, fb - fa + 1, packZ(z, M, 4))
							end
						else
							for X = fa, fb do
								local a = (X - X0) * M
								for m = 1, M do
									acc[a + m] += wgt * zinf[m]
								end
							end
						end
					end
					tEnd1, tStart2 = X1f - 1, X2b + 1
				else
					tEnd1, tStart2 = Xfb, Xfb + 1
				end

				-- transients: closed-form evaluation with the decaying active set (T4)
				local ta = if Xfa > X0 then Xfa else X0
				local tb = if Xfb < X1 - 1 then Xfb else X1 - 1
				if ta <= tb and (ta <= tEnd1 or tb >= tStart2) then
					local nF, nB = 0, 0
					local cntF0, cntB0 = 0, 0
					for c = 1, nc do
						if wfA[c] > 0 then
							cntF0 += 1
						end
						if wbA[c] > 0 then
							cntB0 += 1
						end
					end
					local shF = (if cntB0 == 0 then 1 else 0.5) * SHRINK / math.max(cntF0, 1)
					local shB = (if cntF0 == 0 then 1 else 0.5) * SHRINK / math.max(cntB0, 1)
					for c = 1, nc do
						local k = clsK[cK + c]
						local off = k * TP1 + 1
						local qo = (c - 1) * M
						if wfA[c] > 0 then
							local key = math.huge
							if hasEps then
								local om = 0
								for m = 1, M do
									local v = math.abs(Qf[qo + m])
									if v > om then
										om = v
									end
								end
								local nStar = NT[k * JW + ceilLog2(om * invEps / shF) + 1]
								if nStar <= T then
									key = if nStar > nf0 then Xfa + (nStar - nf0 + F - 1) // F else Xfa
								end
							end
							nF = insertSorted(fOff, fQ, fDrop, nF, M, off, Qf, qo, key, true)
						end
						if wbA[c] > 0 then
							local key = -math.huge
							if hasEps then
								local om = 0
								for m = 1, M do
									local v = math.abs(Qb[qo + m])
									if v > om then
										om = v
									end
								end
								local nStar = NT[k * JW + ceilLog2(om * invEps / shB) + 1]
								if nStar <= T then
									-- negligible while nb(X) >= nStar, i.e. X <= Xfa + (nb0 - nStar) // F
									key = if nStar <= nb0 then Xfa + (nb0 - nStar) // F else Xfa - 1
								end
							end
							nB = insertSorted(bOff, bQ, bDrop, nB, M, off, Qb, qo, key, false)
						end
					end
					local cntF, cntB = nF, 0
					local X = ta
					while X <= tb do
						if X > tEnd1 and X < tStart2 then
							X = tStart2
							if X > tb then
								break
							end
						end
						while cntF > 0 and fDrop[cntF] <= X do
							cntF -= 1
						end
						while cntB < nB and bDrop[cntB + 1] < X do
							cntB += 1
						end
						local nfX = nf0 + (X - Xfa) * F
						local nbX = nb0 - (X - Xfa) * F
						for m = 1, M do
							z[m] = zinf[m]
						end
						for j = 1, cntF do
							local p = pw[fOff[j] + nfX]
							local qo = (j - 1) * M
							for m = 1, M do
								z[m] += fQ[qo + m] * p
							end
						end
						for j = 1, cntB do
							local p = pw[bOff[j] + nbX]
							local qo = (j - 1) * M
							for m = 1, M do
								z[m] += bQ[qo + m] * p
							end
						end
						stats.evals += 1
						emit(X)
						X += 1
					end
				end
			end
		end
		for i = 1, N do
			h[i] = sb[base + i] + ef[i] * pw[pwOff[po + i] + len]
		end
	end
	if pendX ~= NONE then
		for m = 1, M do
			z[m] = pend[m] / pendCnt
		end
		emit(pendX)
	end
end

----------------------------------------------------------------------------------------
-- Fast path for M <= 4 (channels padded to four locals). Same mathematics and bounds as
-- eventRow above; differences: always-instant neurons are not tracked (their state is b
-- exactly), per-content constants come from a cache, and the hot loops are inlined.
----------------------------------------------------------------------------------------

local CACHE_MAX_KEYS = 32768
local SHORT_LEN = 4 -- segments up to this length (level 0) skip the class machinery
local RATIO_TOL = 1e-6 -- X2: relative agreement of two consecutive Aitken ratios

-- Per-(plan, tree) cache of what depends only on a leaf's content: tracked targets b,
-- limit colour zinf (4 channels), quantisation margins and the packed fill colour.
local function ensureCache(plan: Plan, tree: Tree, sc: any): boolean
	if sc.cacheTree == tree then
		return sc.cacheOn
	end
	sc.cacheTree = tree
	local on = tree.keyCount <= CACHE_MAX_KEYS
	sc.cacheOn = on
	local nk = if on then tree.keyCount else 0
	sc.keyB = table.create(0, 0)
	sc.keyPF = table.create(nk * math.max(plan.NG, 1) * 4, 0)
	sc.keyPB = table.create(nk * math.max(plan.NG, 1) * 4, 0)
	sc.keyZ = table.create(nk * 4, 0)
	sc.keyMg = table.create(nk * 4, 0)
	sc.keyCol = table.create(nk, 0)
	sc.keyOk = table.create(nk, false)
	return on
end

local function fillSlot(plan: Plan, tree: Tree, sc: any, leaf: number, slot: number, PFt: { number }, PBt: { number }, Zt: { number }, MGt: { number }, COLt: { number })
	local tmp = sc.tmpB
	leafTargets(plan, tree, leaf, tmp, 0)
	local nt, trk, grpOf, NG = plan.nt, plan.trk, plan.grpOf, plan.NG
	local CfT4, CbT4 = plan.CfT4, plan.CbT4
	local base = slot * NG * 4
	for q = 1, NG * 4 do
		PFt[base + q] = 0
		PBt[base + q] = 0
	end
	for j = 1, nt do
		local b = tmp[trk[j]]
		local go = base + (grpOf[j] - 1) * 4
		local co = (j - 1) * 4
		for m = 1, 4 do
			PFt[go + m] += CfT4[co + m] * b
			PBt[go + m] += CbT4[co + m] * b
		end
	end
	local M, N = plan.M, plan.N
	local Csum, d = plan.Csum, plan.model.d
	local q = { 0, 0, 0, 255 }
	for m = 1, 4 do
		if m <= M then
			local z = d[m]
			local cm = (m - 1) * N
			for i = 1, N do
				z = z + Csum[cm + i] * tmp[i]
			end
			Zt[slot * 4 + m] = z
			MGt[slot * 4 + m] = margin(z)
			q[m] = quant(z)
		else
			Zt[slot * 4 + m] = 0
			MGt[slot * 4 + m] = math.huge
		end
	end
	COLt[slot + 1] = q[1] + q[2] * 256 + q[3] * 65536 + q[4] * 16777216
end

local function eventRow4(
	plan: Plan,
	tree: Tree,
	sc: any,
	nseg: number,
	L: number,
	X0: number,
	X1: number,
	eps: number,
	mode: number,
	out: buffer,
	rowAt: number,
	wgt: number,
	xEnd: number
)
	local M, K = plan.M, plan.K
	local pw, S1, NT, G = plan.pw, plan.S1, plan.NT, plan.G
	local NG = plan.NG -- groups of tracked neurons (shared gain at every depth)
	local GW = NG * 4 -- projected state width: 4 channels per group
	local grpOff, grpCls = plan.grpOff, plan.grpCls
	local clsK, nClsT = plan.clsK, plan.nCls
	local TP1, T = plan.TP1, plan.T
	local sx, sl, sleaf, sdep, skey = sc.sx, sc.sl, sc.sleaf, sc.sdep, sc.skey
	local slotOf, h, ef, seb = sc.slot, sc.hP, sc.efP, sc.sebP
	local Qf, Qb = sc.Qf, sc.Qb
	local fOff, fQ, fW, fThr = sc.fOff, sc.fQ, sc.fW, sc.fThr
	local bOff, bQ, bW, bThr = sc.bOff, sc.bQ, sc.bW, sc.bThr
	local aOff, aQ, aThr = sc.aOff, sc.aQ, sc.aThr
	local oOff, oQ = sc.oOff, sc.oQ
	local acc = sc.acc
	local stats = sc.stats
	local hasA = M >= 4
	local F = pow2(L)
	local GL = L * K
	local JW = JMAX + 1
	local nEval, nFill, nFillPx, nProbe, nSeg, nPiece = 0, 0, 0, 0, 0, 0

	-- 0. per-content constants
	local cacheOn = ensureCache(plan, tree, sc)
	local PFt, PBt, Zt, MGt, COLt
	if cacheOn then
		PFt, PBt, Zt, MGt, COLt = sc.keyPF, sc.keyPB, sc.keyZ, sc.keyMg, sc.keyCol
		local ok = sc.keyOk
		for s = 1, nseg do
			local key = skey[s]
			if not ok[key + 1] then
				fillSlot(plan, tree, sc, sleaf[s], key, PFt, PBt, Zt, MGt, COLt)
				ok[key + 1] = true
			end
			slotOf[s] = key
		end
	else
		PFt, PBt, Zt, MGt, COLt = sc.rowPF, sc.rowPB, sc.rowZ, sc.rowMg, sc.rowCol
		for s = 1, nseg do
			fillSlot(plan, tree, sc, sleaf[s], s - 1, PFt, PBt, Zt, MGt, COLt)
			slotOf[s] = s - 1
		end
	end

	-- 1. backward sweep over the projected group states (closed-form jumps), at rest at the
	-- right end: h = projected target PB, e = h - PB, h = PB + e a^len
	do
		local bo = slotOf[nseg] * GW
		for q = 1, GW do
			h[q] = PBt[bo + q]
		end
	end
	for s = nseg, 1, -1 do
		local bo = slotOf[s] * GW
		local go = sdep[s] * NG
		local len = sl[s]
		local eo = (s - 1) * GW
		for g = 1, NG do
			local p = pw[grpOff[go + g] + len]
			local q0 = (g - 1) * 4
			local b1, b2, b3, b4 = PBt[bo + q0 + 1], PBt[bo + q0 + 2], PBt[bo + q0 + 3], PBt[bo + q0 + 4]
			local e1, e2, e3, e4 = h[q0 + 1] - b1, h[q0 + 2] - b2, h[q0 + 3] - b3, h[q0 + 4] - b4
			seb[eo + q0 + 1], seb[eo + q0 + 2], seb[eo + q0 + 3], seb[eo + q0 + 4] = e1, e2, e3, e4
			h[q0 + 1], h[q0 + 2], h[q0 + 3], h[q0 + 4] = b1 + e1 * p, b2 + e2 * p, b3 + e3 * p, b4 + e4 * p
		end
	end

	-- writes or accumulates one output pixel (pieces only; hot loops inline this)
	local function put(X: number, z0: number, z1: number, z2: number, z3: number)
		if mode == 0 then
			local q0 = floor(z0 + 0.5)
			if q0 < 0 then
				q0 = 0
			elseif q0 > 255 then
				q0 = 255
			end
			local q1 = floor(z1 + 0.5)
			if q1 < 0 then
				q1 = 0
			elseif q1 > 255 then
				q1 = 255
			end
			local q2 = floor(z2 + 0.5)
			if q2 < 0 then
				q2 = 0
			elseif q2 > 255 then
				q2 = 255
			end
			local q3 = 255
			if hasA then
				q3 = floor(z3 + 0.5)
				if q3 < 0 then
					q3 = 0
				elseif q3 > 255 then
					q3 = 255
				end
			end
			buffer.writeu32(out, rowAt + (X - X0) * 4, q0 + q1 * 256 + q2 * 65536 + q3 * 16777216)
		else
			local a = (X - X0) * 4
			acc[a + 1] += wgt * z0
			acc[a + 2] += wgt * z1
			acc[a + 3] += wgt * z2
			acc[a + 4] += wgt * z3
		end
	end

	-- one fill span [fa, fb] of the limit colour (mode 0) or the limit value (mode 1)
	local function fillRun(fa: number, fb: number, col: number, zi0: number, zi1: number, zi2: number, zi3: number)
		local cnt = fb - fa + 1
		if mode == 0 then
			local at = rowAt + (fa - X0) * 4
			buffer.writeu32(out, at, col)
			if cnt < 8 then
				for q = 1, cnt - 1 do
					buffer.writeu32(out, at + q * 4, col)
				end
			else
				local bytes = cnt * 4
				local filled = 4
				while filled < bytes do
					local n = if filled < bytes - filled then filled else bytes - filled
					buffer.copy(out, at + filled, out, at, n)
					filled += n
				end
			end
		else
			for X = fa, fb do
				local a = (X - X0) * 4
				acc[a + 1] += wgt * zi0
				acc[a + 2] += wgt * zi1
				acc[a + 3] += wgt * zi2
				acc[a + 4] += wgt * zi3
			end
		end
	end

	-- Walks cnt output pixels from Xs in steps of dX. The lazy list (aOff, aQ, aThr; na
	-- terms, slowest first) holds the direction whose powers shrink along the walk; a term
	-- whose power is at or below its threshold is skipped (T4). The decision depends only on
	-- the pixel, never on where the walk started, and the summation order is fixed, so a
	-- region render equals the same crop of a full render bit for bit. Trailing skipped
	-- terms are trimmed for good (powers only shrink along the walk). The other list (oOff,
	-- oQ; no terms) is fixed. nl and nOther are the two step indices at Xs; nl grows by F
	-- per pixel and nOther shrinks by F.
	local nTerms = 0 -- terms looked at by the walks (T4 statistics)
	local function walk(Xs: number, cnt: number, dX: number, na: number, nl: number, no: number, nOther: number, zi0: number, zi1: number, zi2: number, zi3: number)
		local X = Xs
		for _ = 1, cnt do
			while na > 0 and pw[aOff[na] + nl] <= aThr[na] do
				na -= 1
			end
			nTerms += na + no
			local z0, z1, z2, z3 = zi0, zi1, zi2, zi3
			for j = 1, na do
				local p = pw[aOff[j] + nl]
				if p > aThr[j] then
					local a = (j - 1) * 4
					z0 += aQ[a + 1] * p
					z1 += aQ[a + 2] * p
					z2 += aQ[a + 3] * p
					z3 += aQ[a + 4] * p
				end
			end
			for j2 = 1, no do
				local p = pw[oOff[j2] + nOther]
				local a = (j2 - 1) * 4
				z0 += oQ[a + 1] * p
				z1 += oQ[a + 2] * p
				z2 += oQ[a + 3] * p
				z3 += oQ[a + 4] * p
			end
			if mode == 0 then
				local q0 = floor(z0 + 0.5)
				if q0 < 0 then
					q0 = 0
				elseif q0 > 255 then
					q0 = 255
				end
				local q1 = floor(z1 + 0.5)
				if q1 < 0 then
					q1 = 0
				elseif q1 > 255 then
					q1 = 255
				end
				local q2 = floor(z2 + 0.5)
				if q2 < 0 then
					q2 = 0
				elseif q2 > 255 then
					q2 = 255
				end
				local q3 = 255
				if hasA then
					q3 = floor(z3 + 0.5)
					if q3 < 0 then
						q3 = 0
					elseif q3 > 255 then
						q3 = 255
					end
				end
				buffer.writeu32(out, rowAt + (X - X0) * 4, q0 + q1 * 256 + q2 * 65536 + q3 * 16777216)
			else
				local a = (X - X0) * 4
				acc[a + 1] += wgt * z0
				acc[a + 2] += wgt * z1
				acc[a + 3] += wgt * z2
				acc[a + 4] += wgt * z3
			end
			X += dX
			nl += F
			nOther -= F
		end
	end

	-- 2. forward sweep and output
	do
		local bo = slotOf[1] * GW
		for q = 1, GW do
			h[q] = PFt[bo + q]
		end
	end
	local pendX, pendCnt = NONE, 0
	local p0s, p1s, p2s, p3s = 0, 0, 0, 0
	local xFirst, xLast = X0 * F, X1 * F
	for s = 1, nseg do
		local x0 = sx[s]
		if x0 >= xLast then
			break
		end
		local len = sl[s]
		local x1 = x0 + len
		local slot = slotOf[s]
		local bo = slot * GW
		local dep = sdep[s]
		local go = dep * NG
		local eo = (s - 1) * GW
		for q = 1, GW do
			ef[q] = h[q] - PFt[bo + q]
		end
		if x1 > xFirst then
			nSeg += 1
			local zo = slot * 4
			local zi0, zi1, zi2, zi3 = Zt[zo + 1], Zt[zo + 2], Zt[zo + 3], Zt[zo + 4]
			if F == 1 and nClsT[dep + 1] == 0 then
				-- every neuron is instant in this leaf: the segment is exactly its limit colour
				local fa = if x0 > X0 then x0 else X0
				local fb = if x1 < X1 then x1 - 1 else X1 - 1
				if fa <= fb then
					nFill += 1
					nFillPx += fb - fa + 1
					fillRun(fa, fb, COLt[slot + 1], zi0, zi1, zi2, zi3)
				end
			elseif F == 1 and len <= SHORT_LEN then
				-- short segment at level 0: every pixel straight from the tracked states
				local xa = if x0 > X0 then x0 else X0
				local xb = if x1 < X1 then x1 - 1 else X1 - 1
				for X = xa, xb do
					local nf = X - x0 + 1
					local nb = x1 - X
					local z0, z1, z2, z3 = zi0, zi1, zi2, zi3
					for g = 1, NG do
						if grpCls[go + g] > 0 then
							local off = grpOff[go + g]
							local pf = pw[off + nf]
							local pb = pw[off + nb]
							local q0 = (g - 1) * 4
							z0 += ef[q0 + 1] * pf + seb[eo + q0 + 1] * pb
							z1 += ef[q0 + 2] * pf + seb[eo + q0 + 2] * pb
							z2 += ef[q0 + 3] * pf + seb[eo + q0 + 3] * pb
							z3 += ef[q0 + 4] * pf + seb[eo + q0 + 4] * pb
						end
					end
					if mode == 0 then
						local q0 = floor(z0 + 0.5)
						if q0 < 0 then
							q0 = 0
						elseif q0 > 255 then
							q0 = 255
						end
						local q1 = floor(z1 + 0.5)
						if q1 < 0 then
							q1 = 0
						elseif q1 > 255 then
							q1 = 255
						end
						local q2 = floor(z2 + 0.5)
						if q2 < 0 then
							q2 = 0
						elseif q2 > 255 then
							q2 = 255
						end
						local q3 = 255
						if hasA then
							q3 = floor(z3 + 0.5)
							if q3 < 0 then
								q3 = 0
							elseif q3 > 255 then
								q3 = 255
							end
						end
						buffer.writeu32(out, rowAt + (X - X0) * 4, q0 + q1 * 256 + q2 * 65536 + q3 * 16777216)
					else
						local a = (X - X0) * 4
						acc[a + 1] += wgt * z0
						acc[a + 2] += wgt * z1
						acc[a + 3] += wgt * z2
						acc[a + 4] += wgt * z3
					end
				end
				if xb >= xa then
					nEval += xb - xa + 1
				end
			else
				-- class amplitudes
				local nc = nClsT[dep + 1]
				local cK = dep * K
				for q = 1, nc * 4 do
					Qf[q] = 0
					Qb[q] = 0
				end
				for g = 1, NG do
					local c = grpCls[go + g]
					if c > 0 then
						local qo = (c - 1) * 4
						local q0 = (g - 1) * 4
						Qf[qo + 1] += ef[q0 + 1]
						Qf[qo + 2] += ef[q0 + 2]
						Qf[qo + 3] += ef[q0 + 3]
						Qf[qo + 4] += ef[q0 + 4]
						Qb[qo + 1] += seb[eo + q0 + 1]
						Qb[qo + 2] += seb[eo + q0 + 2]
						Qb[qo + 3] += seb[eo + q0 + 3]
						Qb[qo + 4] += seb[eo + q0 + 4]
					end
				end

				local xe = if x1 < xEnd then x1 else xEnd
				local Xfirst = x0 // F
				local Xlast = (xe - 1) // F
				local Xfa = if x0 % F == 0 then Xfirst else Xfirst + 1
				local Xfb = if (Xlast + 1) * F <= xe then Xlast else Xlast - 1

				-- partial footprints (F > 1): exact sums, accumulated across segments
				if F > 1 then
					for pass = 1, 2 do
						local X: number, pa: number, pb: number = NONE, 0, 0
						if pass == 1 and Xfirst < Xfa then
							local e1 = (Xfirst + 1) * F
							X, pa, pb = Xfirst, x0, if xe < e1 then xe else e1
						elseif pass == 2 and Xlast > Xfb and (Xlast ~= Xfirst or Xfirst >= Xfa) then
							local s2 = Xlast * F
							X, pa, pb = Xlast, if x0 > s2 then x0 else s2, xe
						end
						if X >= X0 and X < X1 then
							nPiece += 1
							if pendX ~= X then
								if pendX ~= NONE then
									put(pendX, p0s / pendCnt, p1s / pendCnt, p2s / pendCnt, p3s / pendCnt)
								end
								pendX, pendCnt = X, 0
								p0s, p1s, p2s, p3s = 0, 0, 0, 0
							end
							local cnt = pb - pa
							local nf1 = pa - x0 + 1
							local nb1 = x1 - pb + 1
							p0s += cnt * zi0
							p1s += cnt * zi1
							p2s += cnt * zi2
							p3s += cnt * zi3
							for c = 1, nc do
								local off = clsK[cK + c] * TP1 + 1
								local sfac = S1[off + cnt]
								local pf = pw[off + nf1] * sfac
								local pbk = pw[off + nb1] * sfac
								local qo = (c - 1) * 4
								p0s += Qf[qo + 1] * pf + Qb[qo + 1] * pbk
								p1s += Qf[qo + 2] * pf + Qb[qo + 2] * pbk
								p2s += Qf[qo + 3] * pf + Qb[qo + 3] * pbk
								p3s += Qf[qo + 4] * pf + Qb[qo + 4] * pbk
							end
							pendCnt += cnt
							local fe = (X + 1) * F
							local full = (if fe < xEnd then fe else xEnd) - X * F
							if pendCnt == full then
								put(pendX, p0s / pendCnt, p1s / pendCnt, p2s / pendCnt, p3s / pendCnt)
								pendX = NONE
							end
						end
					end
				end

				-- full footprints
				if Xfa <= Xfb and Xfb >= X0 and Xfa < X1 then
					local nf0 = Xfa * F - x0 + 1
					local nb0 = x1 - Xfa * F - F + 1
					-- fill thresholds: quantisation margin (mode 0) or eps
					local t0, t1, t2, t3
					if mode == 0 then
						t0, t1, t2, t3 = MGt[zo + 1] - ETA, MGt[zo + 2] - ETA, MGt[zo + 3] - ETA, MGt[zo + 4] - ETA
						if t0 < eps then
							t0 = eps
						end
						if t1 < eps then
							t1 = eps
						end
						if t2 < eps then
							t2 = eps
						end
						if t3 < eps then
							t3 = eps
						end
					else
						t0, t1, t2, t3 = eps, eps, eps, eps
					end
					local noFill = t0 <= 0 or t1 <= 0 or t2 <= 0 or t3 <= 0
					if noFill then
						t0, t1, t2, t3 = 1, 1, 1, 1
					end
					local i0, i1, i2, i3 = 1 / t0, 1 / t1, 1 / t2, 1 / t3
					-- compact term lists: weight normalised by tau (fill), max |Q| (drops)
					local nF, nB = 0, 0
					local Wf, Wb = 0, 0
					local kmaxF, kmaxB = 0, 0
					for c = 1, nc do
						local k = clsK[cK + c]
						local off = k * TP1 + 1
						local qo = (c - 1) * 4
						local q0, q1, q2, q3 = Qf[qo + 1], Qf[qo + 2], Qf[qo + 3], Qf[qo + 4]
						local r0, r1, r2, r3 = Qb[qo + 1], Qb[qo + 2], Qb[qo + 3], Qb[qo + 4]
						if L > 0 then
							local gfac = G[GL + k + 1]
							q0, q1, q2, q3 = q0 * gfac, q1 * gfac, q2 * gfac, q3 * gfac
							r0, r1, r2, r3 = r0 * gfac, r1 * gfac, r2 * gfac, r3 * gfac
						end
						local a0 = if q0 < 0 then -q0 else q0
						local a1 = if q1 < 0 then -q1 else q1
						local a2 = if q2 < 0 then -q2 else q2
						local a3 = if q3 < 0 then -q3 else q3
						local w = a0 * i0
						local v = a1 * i1
						if v > w then
							w = v
						end
						v = a2 * i2
						if v > w then
							w = v
						end
						v = a3 * i3
						if v > w then
							w = v
						end
						if w > 0 then
							nF += 1
							fOff[nF] = off
							fW[nF] = w
							local om = if a0 > a1 then a0 else a1
							if a2 > om then
								om = a2
							end
							if a3 > om then
								om = a3
							end
							fThr[nF] = om
							local a = (nF - 1) * 4
							fQ[a + 1], fQ[a + 2], fQ[a + 3], fQ[a + 4] = q0, q1, q2, q3
							Wf += w
							kmaxF = k
						end
						a0 = if r0 < 0 then -r0 else r0
						a1 = if r1 < 0 then -r1 else r1
						a2 = if r2 < 0 then -r2 else r2
						a3 = if r3 < 0 then -r3 else r3
						w = a0 * i0
						v = a1 * i1
						if v > w then
							w = v
						end
						v = a2 * i2
						if v > w then
							w = v
						end
						v = a3 * i3
						if v > w then
							w = v
						end
						if w > 0 then
							nB += 1
							bOff[nB] = off
							bW[nB] = w
							local om = if a0 > a1 then a0 else a1
							if a2 > om then
								om = a2
							end
							if a3 > om then
								om = a3
							end
							bThr[nB] = om
							local a = (nB - 1) * 4
							bQ[a + 1], bQ[a + 2], bQ[a + 3], bQ[a + 4] = r0, r1, r2, r3
							Wb += w
							kmaxB = k
						end
					end
					local hF = (if nB == 0 then 1 else 0.5) * SHRINK
					local hB = (if nF == 0 then 1 else 0.5) * SHRINK

					local X1f, X2b
					if noFill then
						X1f, X2b = Xfb + 1, Xfa - 1
					else
						-- forward fill start: probe Xfa, else T3 cap, galloping, bisection
						local r = 0
						for j = 1, nF do
							r += fW[j] * pw[fOff[j] + nf0]
						end
						if nF > 0 then
							nProbe += 1
						end
						if r <= hF then
							X1f = Xfa
						else
							local hi = Xfb + 1
							local nHi = NT[kmaxF * JW + ceilLog2(Wf / hF) + 1]
							if nHi <= T then
								local c = if nHi > nf0 then Xfa + (nHi - nf0 + F - 1) // F else Xfa
								if c < hi then
									hi = c
								end
							end
							local lo = Xfa
							local step = 1
							while lo + step < hi do
								local X = lo + step
								local nfX = nf0 + (X - Xfa) * F
								r = 0
								for j = 1, nF do
									r += fW[j] * pw[fOff[j] + nfX]
								end
								nProbe += 1
								if r <= hF then
									hi = X
									break
								end
								lo = X
								step *= 2
							end
							while hi - lo > 1 do
								local X = (lo + hi) // 2
								local nfX = nf0 + (X - Xfa) * F
								r = 0
								for j = 1, nF do
									r += fW[j] * pw[fOff[j] + nfX]
								end
								nProbe += 1
								if r <= hF then
									hi = X
								else
									lo = X
								end
							end
							X1f = hi
						end
						-- backward fill end: probe Xfb, else T3 cap, galloping, bisection
						local nbE = nb0 - (Xfb - Xfa) * F
						r = 0
						for j = 1, nB do
							r += bW[j] * pw[bOff[j] + nbE]
						end
						if nB > 0 then
							nProbe += 1
						end
						if r <= hB then
							X2b = Xfb
						else
							local lo = Xfa - 1
							local nHi = NT[kmaxB * JW + ceilLog2(Wb / hB) + 1]
							if nHi <= T and nHi <= nb0 then
								local c = Xfa + (nb0 - nHi) // F
								if c > lo then
									lo = c
								end
							end
							if lo > Xfb - 1 then
								lo = Xfb - 1
							end
							local hi = Xfb
							local step = 1
							while hi - step > lo do
								local X = hi - step
								local nbX = nb0 - (X - Xfa) * F
								r = 0
								for j = 1, nB do
									r += bW[j] * pw[bOff[j] + nbX]
								end
								nProbe += 1
								if r <= hB then
									lo = X
									break
								end
								hi = X
								step *= 2
							end
							while hi - lo > 1 do
								local X = (lo + hi) // 2
								local nbX = nb0 - (X - Xfa) * F
								r = 0
								for j = 1, nB do
									r += bW[j] * pw[bOff[j] + nbX]
								end
								nProbe += 1
								if r <= hB then
									lo = X
								else
									hi = X
								end
							end
							X2b = lo
						end
					end

					-- fill span (clipped to the output window): one writeu32, then buffer.copy
					-- doubling. Regions are defined on the unclipped footprint range.
					local la, lb, ra, rb
					if X1f <= X2b then
						local fa = if X1f > X0 then X1f else X0
						local fb = if X2b < X1 - 1 then X2b else X1 - 1
						if fa <= fb then
							nFill += 1
							nFillPx += fb - fa + 1
							fillRun(fa, fb, COLt[slot + 1], zi0, zi1, zi2, zi3)
						end
						la, lb, ra, rb = Xfa, X1f - 1, X2b + 1, Xfb
					else
						local mid = (Xfa + Xfb) // 2
						la, lb, ra, rb = Xfa, mid, mid + 1, Xfb
					end
					-- the parts inside the output window
					local wla = if la > X0 then la else X0
					local wlb = if lb < X1 - 1 then lb else X1 - 1
					local wra = if ra > X0 then ra else X0
					local wrb = if rb < X1 - 1 then rb else X1 - 1

					-- transients (T4: each skipped term stays below its share of eps)
					if wlb >= wla or wrb >= wra then
						local shF = eps * (if nB == 0 then 1 else 0.5) * SHRINK / (if nF > 0 then nF else 1)
						local shB = eps * (if nF == 0 then 1 else 0.5) * SHRINK / (if nB > 0 then nB else 1)
						for j = 1, nF do
							fThr[j] = shF / fThr[j] -- skip once a^n <= share / max|Q|
						end
						for j = 1, nB do
							bThr[j] = shB / bThr[j]
						end
						if wlb >= wla then
							-- left region, walked left to right: forward powers shrink
							for j = 1, nF do
								local d = nF + 1 - j -- slowest first, so fast terms trail
								aOff[d] = fOff[j]
								aThr[d] = fThr[j]
								local a, b = (d - 1) * 4, (j - 1) * 4
								aQ[a + 1], aQ[a + 2], aQ[a + 3], aQ[a + 4] = fQ[b + 1], fQ[b + 2], fQ[b + 3], fQ[b + 4]
							end
							local nbEnd = nb0 - (lb - Xfa) * F -- largest backward power in the region
							local no = 0
							for j = 1, nB do
								if pw[bOff[j] + nbEnd] > bThr[j] then
									no += 1
									oOff[no] = bOff[j]
									local a, b = (no - 1) * 4, (j - 1) * 4
									oQ[a + 1], oQ[a + 2], oQ[a + 3], oQ[a + 4] = bQ[b + 1], bQ[b + 2], bQ[b + 3], bQ[b + 4]
								end
							end
							walk(wla, wlb - wla + 1, 1, nF, nf0 + (wla - Xfa) * F, no, nb0 - (wla - Xfa) * F, zi0, zi1, zi2, zi3)
							nEval += wlb - wla + 1
						end
						if wrb >= wra then
							-- right region, walked right to left: backward powers shrink
							for j = 1, nB do
								local d = nB + 1 - j
								aOff[d] = bOff[j]
								aThr[d] = bThr[j]
								local a, b = (d - 1) * 4, (j - 1) * 4
								aQ[a + 1], aQ[a + 2], aQ[a + 3], aQ[a + 4] = bQ[b + 1], bQ[b + 2], bQ[b + 3], bQ[b + 4]
							end
							local nfStart = nf0 + (ra - Xfa) * F -- largest forward power in the region
							local no = 0
							for j = 1, nF do
								if pw[fOff[j] + nfStart] > fThr[j] then
									no += 1
									oOff[no] = fOff[j]
									local a, b = (no - 1) * 4, (j - 1) * 4
									oQ[a + 1], oQ[a + 2], oQ[a + 3], oQ[a + 4] = fQ[b + 1], fQ[b + 2], fQ[b + 3], fQ[b + 4]
								end
							end
							walk(wrb, wrb - wra + 1, -1, nB, nb0 - (wrb - Xfa) * F, no, nf0 + (wrb - Xfa) * F, zi0, zi1, zi2, zi3)
							nEval += wrb - wra + 1
						end
					end
				end
			end
		end
		for g = 1, NG do
			local p = pw[grpOff[go + g] + len]
			local q0 = (g - 1) * 4
			h[q0 + 1] = PFt[bo + q0 + 1] + ef[q0 + 1] * p
			h[q0 + 2] = PFt[bo + q0 + 2] + ef[q0 + 2] * p
			h[q0 + 3] = PFt[bo + q0 + 3] + ef[q0 + 3] * p
			h[q0 + 4] = PFt[bo + q0 + 4] + ef[q0 + 4] * p
		end
	end
	if pendX ~= NONE then
		put(pendX, p0s / pendCnt, p1s / pendCnt, p2s / pendCnt, p3s / pendCnt)
	end
	stats.segments += nSeg
	stats.evals += nEval
	stats.fills += nFill
	stats.fillPixels += nFillPx
	stats.searchProbes += nProbe
	stats.pieces += nPiece
	stats.terms += nTerms
end

----------------------------------------------------------------------------------------
-- Frame driver: bands, row deduplication, vertical strategies, targets
----------------------------------------------------------------------------------------

export type RenderOptions = {
	epsilon: number?, -- error budget per channel in output units (default 0.5); 0 = lossless
	level: number?, -- output level L >= 0: footprint 2^L rendered pixels (T5)
	x: number?, -- region in output pixels at this level (default: everything)
	y: number?,
	w: number?,
	h: number?,
	dx: number?, -- destination of the region's top-left pixel in `out` (default 0, 0)
	dy: number?,
	vertical: string?, -- "box" (default: exact 2D box filter), "point" (centre row), "rows"
	out2: buffer?, -- channels 4..7 when M > 4
	stats: Stats?,
	endless: Endless?, -- X3: render the endless virtual canvas (region may be anywhere)
	dedup: boolean?, -- reuse rows whose segment sequence repeats an earlier one (default true)
}

-- Output size at a level: width ceil(Wr / 2^L); height ceil(Hr / 2^L), or Hr for "rows".
function Liquid.outputSize(plan: Plan, level: number?, vertical: string?): (number, number)
	local F = pow2(level or 0)
	local w = (plan.Wr + F - 1) // F
	local h = if vertical == "rows" then plan.Hr else (plan.Hr + F - 1) // F
	return w, h
end

local function copyRow(out: buffer, out2: buffer?, M: number, dst: number, src: number, bytes: number)
	buffer.copy(out, dst, out, src, bytes)
	if out2 and M > 4 then
		buffer.copy(out2, dst, out2, src, bytes)
	end
end

-- Renders a region of the image at a level into an RGBA8 buffer whose rows are outWidth
-- pixels long. Returns the statistics (accumulated into opts.stats when given).
function Liquid.render(plan: Plan, tree: Tree, out: buffer, outWidth: number, opts: RenderOptions?): Stats
	local o: RenderOptions = opts or {}
	local eps = o.epsilon or 0.5
	assert(eps >= 0, "epsilon must be >= 0")
	local L = o.level or 0
	assert(L >= 0 and L % 1 == 0 and L <= plan.P + plan.R, "level out of range")
	local vertical = o.vertical or "box"
	assert(vertical == "box" or vertical == "point" or vertical == "rows", "vertical must be box, point or rows")
	local endless = o.endless
	local F = pow2(L)
	local Wl, Hl = Liquid.outputSize(plan, L, vertical)
	local rx, ry = o.x or 0, o.y or 0
	local rw, rh = o.w or (Wl - rx), o.h or (Hl - ry)
	if not endless then
		if rx < 0 then
			rw += rx
			rx = 0
		end
		if ry < 0 then
			rh += ry
			ry = 0
		end
		if rx + rw > Wl then
			rw = Wl - rx
		end
		if ry + rh > Hl then
			rh = Hl - ry
		end
	end
	local stats = o.stats or newStats()
	if rw <= 0 or rh <= 0 then
		return stats
	end
	local dx, dy = o.dx or 0, o.dy or 0
	local out2 = o.out2
	local M = plan.M
	local Wr, Hr = plan.Wr, plan.Hr
	local fast = M <= 4
	local AS = if fast then 4 else M -- accumulator stride
	local dedup = o.dedup ~= false
	local horizon = if endless then endless.horizon or 2 else 0
	assert(horizon >= 1 or not endless, "endless horizon must be >= 1")
	local sc = getScratch(plan, if endless then (2 * horizon + 1) * plan.Sr + 2 else Wr + 2)
	-- (the endless window is at most 2 * horizon + 1 blocks wide)
	sc.stats = stats
	assert(buffer.len(out) >= ((dy + rh - 1) * outWidth + dx + rw) * 4, "output buffer too small")

	-- Exact cross-band deduplication: rows whose segment sequences (length, content key,
	-- depth) are equal render identically. A rolling hash over exact integers finds
	-- candidates and the stored sequence is compared before a row is reused, so a hash
	-- collision can only cost a render, never change a pixel.
	local sigv = sc.sigv
	local function rowSignature(n: number): number
		local sl, skey, sdep = sc.sl, sc.skey, sc.sdep
		local hsh = n
		for s = 1, n do
			local v = (skey[s] * 32 + sdep[s]) * 131072 + sl[s] -- < 2^42, exact
			sigv[s] = v
			hsh = (hsh * 1000003 + v) % 2147483647 -- < 2^53 before the modulo: exact
		end
		return hsh
	end
	local function sameRow(entry: { number }, n: number): boolean
		if #entry ~= n then
			return false
		end
		for s = 1, n do
			if entry[s] ~= sigv[s] then
				return false
			end
		end
		return true
	end

	-- Renders output columns [cx0, cx1) of output rows [ry, ry + rh). seg(y) segments
	-- rendered row y and returns (count, band end); xEnd clips the last footprint; rows at
	-- or beyond yLimit do not exist.
	local function column(cx0: number, cx1: number, seg: (number) -> (number, number), xEnd: number, yLimit: number)
		local colBytes = (cx1 - cx0) * 4
		local cw = cx1 - cx0
		local function rowAt(Y: number): number
			return ((dy + Y - ry) * outWidth + dx + cx0 - rx) * 4
		end
		local seen: { [number]: { { number } } } = {} -- signature -> list of {Y, seq...}
		local seenRow: { [{ number }]: number } = {}
		-- returns the output row already holding this row's pixels, or nil (and records Y)
		local function lookup(n: number, Y: number): number?
			if not dedup then
				return nil
			end
			local sig = rowSignature(n)
			local bucket = seen[sig]
			if bucket then
				for _, entry in bucket do
					if sameRow(entry, n) then
						return seenRow[entry]
					end
				end
			else
				bucket = {}
				seen[sig] = bucket
			end
			local entry = table.create(n, 0)
			for s2 = 1, n do
				entry[s2] = sigv[s2]
			end
			table.insert(bucket, entry)
			seenRow[entry] = Y
			return nil
		end
		local function row(n: number, mode: number, at: number, wgt: number)
			if fast then
				eventRow4(plan, tree, sc, n, L, cx0, cx1, eps, mode, out, at, wgt, xEnd)
			else
				eventRow(plan, tree, sc, n, L, cx0, cx1, eps, mode, out, at, out2, wgt, xEnd)
			end
		end
		if vertical == "rows" or L == 0 then
			local y = ry
			local yEndAll = ry + rh
			while y < yEndAll do
				local n, bandEnd = seg(y)
				local yEnd = if bandEnd < yEndAll then bandEnd else yEndAll
				local prev = lookup(n, y)
				if prev then
					copyRow(out, out2, M, rowAt(y), rowAt(prev), colBytes)
					stats.deduped += 1
				else
					row(n, 0, rowAt(y), 1)
					stats.rendered += 1
				end
				stats.rows += 1
				local src = rowAt(y)
				for yy = y + 1, yEnd - 1 do
					copyRow(out, out2, M, rowAt(yy), src, colBytes)
					stats.copied += 1
					stats.rows += 1
				end
				y = yEnd
			end
		elseif vertical == "point" then
			local bandLo, bandHi = 0, -1
			for Y = ry, ry + rh - 1 do
				local ys = Y * F + F // 2
				if ys >= yLimit then
					ys = yLimit - 1
				end
				if Y > ry and ys >= bandLo and ys < bandHi then
					copyRow(out, out2, M, rowAt(Y), rowAt(Y - 1), colBytes)
					stats.copied += 1
				else
					local n, bandEnd = seg(ys)
					local prev = lookup(n, Y)
					if prev then
						copyRow(out, out2, M, rowAt(Y), rowAt(prev), colBytes)
						stats.deduped += 1
					else
						row(n, 0, rowAt(Y), 1)
						stats.rendered += 1
					end
					bandLo, bandHi = ys, bandEnd
				end
				stats.rows += 1
			end
		else
			local acc = sc.acc
			local z = sc.z
			local prevEnd = -math.huge
			for Y = ry, ry + rh - 1 do
				local ya = Y * F
				local yb = if ya + F < yLimit then ya + F else yLimit
				stats.rows += 1
				if Y > ry and prevEnd >= yb then
					copyRow(out, out2, M, rowAt(Y), rowAt(Y - 1), colBytes)
					stats.copied += 1
					continue
				end
				local n, bandEnd = seg(ya)
				if bandEnd >= yb then
					local prev = lookup(n, Y)
					if prev then
						copyRow(out, out2, M, rowAt(Y), rowAt(prev), colBytes)
						stats.deduped += 1
					else
						row(n, 0, rowAt(Y), 1)
						stats.rendered += 1
					end
					prevEnd = bandEnd
				else
					-- the footprint crosses band boundaries: exact weighted sum of the band rows
					prevEnd = -math.huge
					stats.multiBand += 1
					for j = 1, cw * AS do
						acc[j] = 0
					end
					local y = ya
					local inv = 1 / (yb - ya)
					while true do
						local e = if bandEnd < yb then bandEnd else yb
						row(n, 1, 0, (e - y) * inv)
						stats.rendered += 1
						y = e
						if y >= yb then
							break
						end
						n, bandEnd = seg(y)
					end
					local at = rowAt(Y)
					for X = 0, cw - 1 do
						local a = X * AS
						for m = 1, M do
							z[m] = acc[a + m]
						end
						buffer.writeu32(out, at + X * 4, packZ(z, M, 0))
						local o2 = out2
						if o2 and M > 4 then
							buffer.writeu32(o2, at + X * 4, packZ(z, M, 4))
						end
					end
				end
			end
		end
	end

	if endless then
		-- One column per block. Its passes start at rest at the ends of a canonical window:
		-- the block plus the first warm-up width w of the ladder Sr/16, Sr/4, Sr, 4 Sr, ...
		-- (capped at `horizon` blocks) whose a-posteriori certificate is <= tolerance. The
		-- choice depends only on the virtual content of the row, so a pixel never depends on
		-- the requested region, and the seam between blocks is <= twice the tolerance (X3).
		local seed = endless.seed
		local tol = endless.tolerance or pow2(-24)
		local Sr = plan.Sr
		local colW = Sr // F
		local rungs: { number } = {}
		local maxW = horizon * Sr
		local w = if Sr >= 16 then Sr // 16 else 1
		while w < maxW do
			table.insert(rungs, w)
			w *= 4
		end
		table.insert(rungs, maxW)
		for beta = rx // colW, (rx + rw - 1) // colW do
			local cx0 = if beta * colW > rx then beta * colW else rx
			local cx1 = if (beta + 1) * colW < rx + rw then (beta + 1) * colW else rx + rw
			local b0, b1 = beta * Sr, (beta + 1) * Sr
			column(cx0, cx1, function(y: number): (number, number)
				local n, bandEnd = 0, 0
				for ri = 1, #rungs do
					n, bandEnd = segmentEndless(plan, tree, sc, y, b0 - rungs[ri], b1 + rungs[ri], seed)
					local cert = if fast then windowCert(plan, tree, sc, n, b0, b1) else 0
					if cert <= tol or ri == #rungs or not fast then
						if cert > stats.seam then
							stats.seam = cert
						end
						break
					end
				end
				return n, bandEnd
			end, math.huge, math.huge)
		end
	else
		column(rx, rx + rw, function(y: number): (number, number)
			return segmentStored(plan, tree, sc, y, 0, Wr, 0)
		end, Wr, Hr)
	end
	return stats
end

-- Real values (no quantisation) of rendered row y at level L, horizontal footprints only:
-- dst[X * M + m + 1] for X in [0, ceil(Wr / 2^L)). Every value is within epsilon of the
-- exact model's footprint average (T2 and T4 without the rounding term).
function Liquid.renderRowValues(plan: Plan, tree: Tree, y: number, level: number, epsilon: number, dst: { number }, stats: Stats?): number
	local F = pow2(level)
	local Wl = (plan.Wr + F - 1) // F
	local sc = getScratch(plan, plan.Wr + 2)
	sc.stats = stats or newStats()
	local n = segmentStored(plan, tree, sc, y, 0, plan.Wr, 0)
	local acc = sc.acc
	local M = plan.M
	local AS = if M <= 4 then 4 else M
	for j = 1, Wl * AS do
		acc[j] = 0
	end
	if M <= 4 then
		eventRow4(plan, tree, sc, n, level, 0, Wl, epsilon, 1, buffer.create(0), 0, 1, plan.Wr)
	else
		eventRow(plan, tree, sc, n, level, 0, Wl, epsilon, 1, buffer.create(0), 0, nil, 1, plan.Wr)
	end
	for X = 0, Wl - 1 do
		for m = 1, M do
			dst[X * M + m] = acc[X * AS + m]
		end
	end
	return Wl
end

----------------------------------------------------------------------------------------
-- X2 Richardson LOD (horizontal, per row). The finer level L-1 is predicted from levels L
-- and L+1 as  z_{L-1} = z_L + c (z_L - z_{L+1}).  On a single exponential with ratio rho
-- per level-(L-1) pixel (T5: footprint averages of a geometric sequence are geometric),
-- the four children of a level-(L+1) pixel need c = +mu_a, -mu_a, -mu_b, +mu_b with
-- mu_a = 2 / (1 + rho)^2 and mu_b = 2 rho^2 / (1 + rho)^2 (forward decay; swapped for a
-- backward one), and rho^2 is Aitken's ratio of consecutive level-L differences. rho = 1
-- gives the affine coefficients c = +-1/2. Every child pair averages back to z_L exactly
-- (c sums to 0 over a pair), so swapping the prediction for the exact level later never
-- shifts the mean. Proofs and bounds in docs/LIQUID.md (X2).
----------------------------------------------------------------------------------------

-- One level-L pixel X of richardsonRow: writes its two predicted children at out[oa + m]
-- and out[oa + M + m] (1-based m) and returns its discrepancy max_m |zL - zU|.
local function richardsonPixel(zL: { number }, zU: { number }, nL: number, M: number, X: number, out: { number }, oa: number, geometric: boolean): number
	local tau = X % 2
	local up = (X // 2) * M
	local dmax = 0
	for m = 1, M do
		local a = zL[X * M + m]
		local e = a - zU[up + m]
		local muA, muB, forward = 0.5, 0.5, true
		if geometric and X > 0 and X < nL - 2 then
			local dm = a - zL[(X - 1) * M + m]
			local dp = zL[(X + 1) * M + m] - a
			local dq = zL[(X + 2) * M + m] - zL[(X + 1) * M + m]
			if dm ~= 0 and dp ~= 0 then
				local q = dp / dm
				local q2 = dq / dp
				-- a single exponential has equal consecutive ratios; anything else (a
				-- segment boundary, two classes of different speed) keeps the affine c
				local dq2 = q - q2
				if dq2 < 0 then
					dq2 = -dq2
				end
				if q >= 0 and q < math.huge and dq2 <= RATIO_TOL * (if q > q2 then q else q2) then
					local rho
					if q <= 1 then
						rho = math.sqrt(q)
					else
						rho = math.sqrt(1 / q)
						forward = false
					end
					local s1 = 1 + rho
					muA = 2 / (s1 * s1)
					muB = muA * rho * rho
				end
			end
		end
		local c0
		if tau == 0 then
			c0 = if forward then muA else muB
		else
			c0 = -(if forward then muB else muA)
		end
		out[oa + m] = a + c0 * e
		out[oa + M + m] = a - c0 * e
		local ae = if e < 0 then -e else e
		if ae > dmax then
			dmax = ae
		end
	end
	return dmax
end

-- zL: level-L values of one row (nL pixels times M channels, flat, 1-based); zU: the level
-- L+1 values of the same row. Writes the predicted level-(L-1) values (2 nL pixels) into
-- out and the discrepancy max_m |zL - zU| of each level-L pixel into disc[X + 1].
-- geometric = false uses the affine coefficients.
function Liquid.richardsonRow(zL: { number }, zU: { number }, nL: number, M: number, out: { number }, disc: { number }, geometric: boolean)
	for X = 0, nL - 1 do
		disc[X + 1] = richardsonPixel(zL, zU, nL, M, X, out, 2 * X * M, geometric)
	end
end

-- X2 for a whole frame in "rows" layout: renders levels L and L+1 (real values, eps) and
-- writes the predicted level L-1 into out (RGBA8, stride outWidth). Returns the rows
-- ordered by decreasing discrepancy (the refinement order) and each row's largest
-- discrepancy. Event-aware: where the discrepancy is 0 the children equal the coarse value
-- exactly (any c), so runs of such pixels with equal values become fill spans; rows of a
-- band are predicted once and copied.
function Liquid.predictFiner(plan: Plan, tree: Tree, level: number, eps: number, out: buffer, outWidth: number, geometric: boolean?): ({ number }, { number })
	assert(level >= 1 and level + 1 <= plan.P + plan.R, "predictFiner needs 1 <= level < P + R")
	local M = plan.M
	local geo = geometric ~= false
	local Fm = pow2(level - 1)
	local nFine = (plan.Wr + Fm - 1) // Fm
	local zL, zU = {}, {}
	local two = table.create(2 * M, 0)
	local rowDisc = table.create(plan.Hr, 0)
	local z = table.create(M, 0)
	local sc = getScratch(plan, plan.Wr + 2)
	local y = 0
	while y < plan.Hr do
		local _, bandEnd = segmentStored(plan, tree, sc, y, 0, plan.Wr, 0)
		local nL = Liquid.renderRowValues(plan, tree, y, level, eps, zL)
		Liquid.renderRowValues(plan, tree, y, level + 1, eps, zU)
		local at = y * outWidth * 4
		local dmax = 0
		local X = 0
		while X < nL do
			-- run of zero discrepancy and equal values
			local flat = true
			local up = (X // 2) * M
			for m = 1, M do
				if zL[X * M + m] ~= zU[up + m] then
					flat = false
					break
				end
			end
			if flat then
				local X2 = X + 1
				while X2 < nL do
					local same = true
					local u2 = (X2 // 2) * M
					for m = 1, M do
						local v = zL[X2 * M + m]
						if v ~= zL[X * M + m] or v ~= zU[u2 + m] then
							same = false
							break
						end
					end
					if not same then
						break
					end
					X2 += 1
				end
				for m = 1, M do
					z[m] = zL[X * M + m]
				end
				local lo = 2 * X
				local hi = 2 * X2
				if hi > nFine then
					hi = nFine
				end
				if hi > lo then
					fillSpan(out, at + lo * 4, hi - lo, packZ(z, M, 0))
				end
				X = X2
			else
				local d = richardsonPixel(zL, zU, nL, M, X, two, 0, geo)
				if d > dmax then
					dmax = d
				end
				for c = 0, 1 do
					local Xf = 2 * X + c
					if Xf < nFine then
						for m = 1, M do
							z[m] = two[c * M + m]
						end
						buffer.writeu32(out, at + Xf * 4, packZ(z, M, 0))
					end
				end
				X += 1
			end
		end
		for yy = y, bandEnd - 1 do
			rowDisc[yy + 1] = dmax
			if yy > y then
				buffer.copy(out, yy * outWidth * 4, out, at, nFine * 4)
			end
		end
		y = bandEnd
	end
	local order = table.create(plan.Hr, 0)
	for j = 1, plan.Hr do
		order[j] = j - 1
	end
	table.sort(order, function(a: number, b: number): boolean
		local da, db = rowDisc[a + 1], rowDisc[b + 1]
		if da ~= db then
			return da > db
		end
		return a < b
	end)
	return order, rowDisc
end

-- Renders rendered rows `rows` (a list) exactly at a level in "rows" layout: the refinement
-- step of X2 (and any partial re-render). Returns the statistics.
function Liquid.renderRows(plan: Plan, tree: Tree, rows: { number }, level: number, eps: number, out: buffer, outWidth: number, stats: Stats?): Stats
	local st = stats or newStats()
	for _, y in rows do
		Liquid.render(plan, tree, out, outWidth, { epsilon = eps, level = level, vertical = "rows", y = y, h = 1, dy = y, stats = st })
	end
	return st
end

-- T7 lockstep checksum: MyMath.hash32 folded over the buffer's u32 words (length must be a
-- multiple of 4). Equal model bytes, tree bytes and options give equal hashes on every
-- device and in both runtimes, so instances can compare frames by exchanging 4 bytes.
function Liquid.hashBuffer(b: buffer): number
	local h = 0x811C9DC5
	for i = 0, buffer.len(b) // 4 - 1 do
		h = hash32(bit32.bxor(h, buffer.readu32(b, i * 4)))
	end
	return h
end

-- Renders into a Canvas (src/Canvas.luau) and marks exactly the written rows dirty.
-- `canvas` needs fields buf and width and a markDirty(x, y, w, h) method.
function Liquid.renderCanvas(plan: Plan, tree: Tree, canvas: any, opts: RenderOptions?): Stats
	local o: RenderOptions = opts or {}
	local L = o.level or 0
	local vertical = o.vertical or "box"
	local Wl, Hl = Liquid.outputSize(plan, L, vertical)
	local rx, ry = o.x or 0, o.y or 0
	local rw, rh = o.w or (Wl - rx), o.h or (Hl - ry)
	local stats = Liquid.render(plan, tree, canvas.buf, canvas.width, o)
	local dx, dy = o.dx or 0, o.dy or 0
	if rx < 0 then
		dx -= rx
		rw += rx
		rx = 0
	end
	if ry < 0 then
		dy -= ry
		rh += ry
		ry = 0
	end
	rw = math.min(rw, Wl - rx)
	rh = math.min(rh, Hl - ry)
	if rw > 0 and rh > 0 then
		canvas:markDirty(dx, dy, rw, rh)
	end
	return stats
end

-- Reference frame at level 0: every pixel stepped (O(W * H * N)). Writes RGBA8 into `out`
-- (row stride outWidth pixels); channels 4..7 into out2 when M > 4. With fast = true the
-- leaf of each pixel comes from the row segments instead of a per-pixel tree walk (same
-- arithmetic, used by the benchmark as the honest per-pixel baseline).
-- With bands = true only the first row of every band is stepped and the others are copied
-- (rows of a band cross the same leaves, so they are identical): the per-pixel baseline
-- with the renderer's row deduplication, used to separate the two sources of speedup.
function Liquid.reference(plan: Plan, tree: Tree, out: buffer, outWidth: number, fast: boolean?, out2: buffer?, bands: boolean?)
	local W, H, M = plan.Wr, plan.Hr, plan.M
	local z = table.create(W * M, 0)
	local zp = table.create(M, 0)
	local leafFn: ((number, number) -> (number, number))? = nil
	local segLeaf = table.create(W, 0)
	local segDep = table.create(W, 0)
	if fast then
		leafFn = function(x: number, _y: number): (number, number)
			return segLeaf[x + 1], segDep[x + 1]
		end
	end
	local sc = getScratch(plan, W + 2)
	local y = 0
	while y < H do
		local bandEnd = y + 1
		if fast or bands then
			local n, be = segmentStored(plan, tree, sc, y, 0, W, 0)
			if bands then
				bandEnd = be
			end
			for s = 1, n do
				for x = sc.sx[s], sc.sx[s] + sc.sl[s] - 1 do
					segLeaf[x + 1] = sc.sleaf[s]
					segDep[x + 1] = sc.sdep[s]
				end
			end
		end
		Liquid.referenceRow(plan, tree, y, z, leafFn)
		local rowAt = y * outWidth * 4
		for x = 0, W - 1 do
			for m = 1, M do
				zp[m] = z[x * M + m]
			end
			buffer.writeu32(out, rowAt + x * 4, packZ(zp, M, 0))
			if out2 and M > 4 then
				buffer.writeu32(out2, rowAt + x * 4, packZ(zp, M, 4))
			end
		end
		for yy = y + 1, bandEnd - 1 do
			copyRow(out, out2, M, yy * outWidth * 4, rowAt, W * 4)
		end
		y = bandEnd
	end
end

return Liquid
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">LiquidLearn</string>
          <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: LiquidLearn
--
-- ALLAN's learning on the server (docs/LIQUID.md section 6; results and proofs in
-- docs/LIQUID_TRAINING.md). Pure Luau, deterministic ops only, no engine globals.
--
--   * shell-byte quadtree builder (exact integer means and deviations)
--   * the ALN binary codec (layout: header of src/Liquid.luau)
--   * exact row simulation in the Luau step order, bidirectional
--   * S1/S3 exact sufficient statistics: states quantised to 15-bit fixed point,
--     integer sums held in two limbs; plain mode (every pixel or every k-th) or
--     event mode (runs of identical state vectors, rows grouped by quadtree band),
--     which produces the same integers as plain mode with stride 1
--   * deterministic Cholesky ridge solve -> readout bytes
--   * S4 federated merge: messages of at most 1000 characters, a per-server
--     G-Counter ledger whose total does not depend on merge order, duplication or
--     delivery order
--   * S5 gain search: one superset accumulation, then coordinate descent over
--     kBase on exact sub-Gram matrices, scored on validation rows from statistics
--   * S6 online updates: add or subtract statistics, exact halving, re-solve
--   * a time-sliced trainer for Heartbeat
--   * renderExact: the reference renderer (every pixel stepped; epsilon = 0)
--
-- The ALN binary layout (version 1) and the model arithmetic are defined once, in the
-- header of src/Liquid.luau (the single source of truth). This module implements the
-- same layout and the same operation order (encode, decode, buildTree, renderExact)
-- without depending on the renderer; tests/liquid_learn.test.luau checks every byte
-- against tools/liquid_train.py and against Liquid.reference. Defaults used here:
-- Walsh reservoirs (b in [0, 1]) and INSTANT = -64 for neurons with k = 0 everywhere.
--
-- Training statistics (S3): q = floor(h * 32767 + 0.5), features s = (qf, qb, 32767),
-- D = 2N + 1. Entries in order: G upper triangle (row-major, i <= j), P (D x M,
-- row-major), YY (M), count; E = D(D+1)/2 + D*M + M + 1. Each entry is the exact
-- integer hi * 2^32 + lo, canonical when 0 <= lo < 2^32.

local MyMath = require("./MyMath")

local LiquidLearn = {}

local QSCALE = 32767
local TWO32 = 4294967296
local PENDING_LIMIT = 4194304 -- 2^22: max sample weight between limb normalisations
local MAX_RAW_CHUNK = 750 -- raw bytes per message (base64: 1000 characters <= 1 kB)
local HEADER = 22
local MAX_M = 8 -- output channels supported by the band accumulators

LiquidLearn.QSCALE = QSCALE
LiquidLearn.VERSION = 1
-- Maximum sample weight per accumulation pass and between limb normalisations. Any
-- value in [1, 2^22] keeps every partial sum below 2^53 (docs/LIQUID_TRAINING.md 7.1);
-- tests lower it to exercise band splitting.
LiquidLearn.pendingLimit = PENDING_LIMIT
LiquidLearn.INSTANT = -64
LiquidLearn.DEFAULT_SCALES = { -64, 0, -2, 2, -4, 4, 1, -1 }
LiquidLearn.DEFAULT_LAMBDA = 1e-7
LiquidLearn.MAX_MESSAGE_CHARS = 1000

export type Reservoir = {
	N: number,
	I: number,
	K: number,
	beta: { number },
	B: { number },
	kBase: { number },
}

export type Readout = {
	M: number,
	N: number,
	Cf: { number },
	Cb: { number },
	d: { number },
}

export type Tree = {
	width: number,
	height: number,
	maxDepth: number,
	rootLog2: number,
	I: number,
	bitCount: number,
	bits: buffer,
	leafCount: number,
	lx: { number },
	ly: { number },
	lsl: { number },
	bytes: buffer,
	nodeX: { number },
	nodeY: { number },
	nodeL: { number },
	nodeLeaf: { number }, -- 0-based leaf index, or -1 for an internal node
	nodeChild: { number }, -- 4 per node: 1-based child node ids (0 for leaves)
}

export type Stats = {
	D: number,
	M: number,
	E: number,
	hi: { number },
	lo: { number },
	pending: number,
}

local floor = math.floor
local sqrt = math.sqrt

----------------------------------------------------------------------------------
-- helpers
----------------------------------------------------------------------------------

local function rootLog2For(w: number, h: number): number
	local s, l = 1, 0
	local m = if w > h then w else h
	while s < m do
		s *= 2
		l += 1
	end
	return l
end
LiquidLearn.rootLog2For = rootLog2For

local function gainTable(K: number): { number }
	local t = table.create(K, 1)
	for k = 2, K do
		t[k] = t[k - 1] * 0.5
	end
	return t
end

local function clampK(v: number, K: number): number
	if v < 0 then
		return 0
	elseif v > K - 1 then
		return K - 1
	end
	return v
end

-- Sylvester Hadamard entry (-1)^popcount(p & t).
local function walshSign(p: number, t: number): number
	local x = bit32.band(p, t)
	local par = 0
	while x ~= 0 do
		par = bit32.bxor(par, bit32.band(x, 1))
		x = bit32.rshift(x, 1)
	end
	return if par == 0 then 1 else -1
end

----------------------------------------------------------------------------------
-- structured reservoir: Walsh projections at a multi-scale spread of kBase
----------------------------------------------------------------------------------

-- Neuron i reads Walsh projection p(i) of the leaf bytes,
--   b = 1/2 + (1/I) * sum_t H[p][t] * (u_t - 1/2), in [0, 1] for u in [0, 1]^I,
-- stored as B[t] = H[p][t] / I and beta = 1/2 - s / (2 I) with s = sum_t H[p][t].
-- p(i) = proj[i] or (i - 1) % I; kBase[i] or scales[((i - 1) // I) % #scales + 1].
-- Same formulas and order as walsh_reservoir in tools/liquid_train.py.
function LiquidLearn.walshReservoir(
	N: number,
	I: number,
	K: number?,
	kBase: { number }?,
	scales: { number }?,
	proj: { number }?
): Reservoir
	local sc = scales or LiquidLearn.DEFAULT_SCALES
	local beta, B, kb = table.create(N, 0), table.create(N * I, 0), table.create(N, 0)
	for i = 1, N do
		local p = if proj then proj[i] else (i - 1) % I
		local s = 0
		for t = 0, I - 1 do
			local v = walshSign(p, t)
			s += v
			B[(i - 1) * I + t + 1] = v / I
		end
		beta[i] = 0.5 - s / (2 * I)
		kb[i] = if kBase then kBase[i] else sc[((i - 1) // I) % #sc + 1]
	end
	return { N = N, I = I, K = K or 16, beta = beta, B = B, kBase = kb }
end

-- Projection index of each neuron of a Walsh reservoir (matched against B rows).
function LiquidLearn.walshProjections(res: Reservoir): { number }
	local N, I = res.N, res.I
	local hn = 1
	while hn < I do
		hn *= 2
	end
	local out = table.create(N, 0)
	for i = 1, N do
		local found = -1
		for p = 0, hn - 1 do
			local ok = true
			for t = 0, I - 1 do
				if res.B[(i - 1) * I + t + 1] ~= walshSign(p, t) / I then
					ok = false
					break
				end
			end
			if ok then
				found = p
				break
			end
		end
		assert(found >= 0, "not a Walsh reservoir")
		out[i] = found
	end
	return out
end

----------------------------------------------------------------------------------
-- codec
----------------------------------------------------------------------------------

local function writeF64s(b: buffer, o: number, t: { number }): number
	for i = 1, #t do
		buffer.writef64(b, o, t[i])
		o += 8
	end
	return o
end

local function readF64s(b: buffer, o: number, n: number): ({ number }, number)
	local t = table.create(n, 0)
	for i = 1, n do
		t[i] = buffer.readf64(b, o)
		o += 8
	end
	return t, o
end

function LiquidLearn.encodeReservoir(res: Reservoir): buffer
	local b = buffer.create(8 * (2 * res.N + res.N * res.I))
	local o = writeF64s(b, 0, res.beta)
	o = writeF64s(b, o, res.B)
	writeF64s(b, o, res.kBase)
	return b
end

function LiquidLearn.encodeReadout(ro: Readout): buffer
	local b = buffer.create(8 * (2 * ro.M * ro.N + ro.M))
	local o = writeF64s(b, 0, ro.Cf)
	o = writeF64s(b, o, ro.Cb)
	writeF64s(b, o, ro.d)
	return b
end

function LiquidLearn.encodeTree(tree: Tree): buffer
	local nb = (tree.bitCount + 7) // 8
	local lb = tree.leafCount * tree.I
	local b = buffer.create(5 + nb + lb)
	buffer.writeu16(b, 0, tree.width)
	buffer.writeu16(b, 2, tree.height)
	buffer.writeu8(b, 4, tree.maxDepth)
	if nb > 0 then
		buffer.copy(b, 5, tree.bits, 0, nb)
	end
	if lb > 0 then
		buffer.copy(b, 5 + nb, tree.bytes, 0, lb)
	end
	return b
end

function LiquidLearn.encode(res: Reservoir, ro: Readout, tree: Tree): buffer
	assert(ro.N == res.N and tree.I == res.I, "model and tree disagree")
	local rb = LiquidLearn.encodeReservoir(res)
	local cb = LiquidLearn.encodeReadout(ro)
	local tb = LiquidLearn.encodeTree(tree)
	local b = buffer.create(8 + buffer.len(rb) + buffer.len(cb) + buffer.len(tb))
	buffer.writeu8(b, 0, 0x41)
	buffer.writeu8(b, 1, 0x4C)
	buffer.writeu8(b, 2, 0x4E)
	buffer.writeu8(b, 3, 1)
	buffer.writeu8(b, 4, res.N)
	buffer.writeu8(b, 5, res.I)
	buffer.writeu8(b, 6, ro.M)
	buffer.writeu8(b, 7, res.K)
	local o = 8
	buffer.copy(b, o, rb)
	o += buffer.len(rb)
	buffer.copy(b, o, cb)
	o += buffer.len(cb)
	buffer.copy(b, o, tb)
	return b
end

-- Walks the preorder split bits (bits buffer, starting at bit 0) and fills the node
-- arrays and leaf geometry. Returns the number of bits read.
local function attachNodes(tree: Tree): number
	local nodeX, nodeY, nodeL, nodeLeaf, nodeChild = {}, {}, {}, {}, {}
	local lx, ly, lsl = {}, {}, {}
	local bits = tree.bits
	local nbytes = buffer.len(bits)
	local bitPos = 0
	local leaf = 0
	local maxDepth = tree.maxDepth
	local function walk(x: number, y: number, l: number, depth: number): number
		local id = #nodeX + 1
		nodeX[id], nodeY[id], nodeL[id], nodeLeaf[id] = x, y, l, -1
		local base = (id - 1) * 4
		nodeChild[base + 1], nodeChild[base + 2], nodeChild[base + 3], nodeChild[base + 4] = 0, 0, 0, 0
		local split = false
		if depth < maxDepth then
			assert(bitPos // 8 < nbytes, "truncated split bits")
			split = bit32.extract(buffer.readu8(bits, bitPos // 8), bitPos % 8, 1) == 1
			bitPos += 1
		end
		if split then
			local h = bit32.lshift(1, l - 1)
			nodeChild[base + 1] = walk(x, y, l - 1, depth + 1)
			nodeChild[base + 2] = walk(x + h, y, l - 1, depth + 1)
			nodeChild[base + 3] = walk(x, y + h, l - 1, depth + 1)
			nodeChild[base + 4] = walk(x + h, y + h, l - 1, depth + 1)
		else
			nodeLeaf[id] = leaf
			leaf += 1
			lx[leaf], ly[leaf], lsl[leaf] = x, y, l
		end
		return id
	end
	walk(0, 0, tree.rootLog2, 0)
	tree.nodeX, tree.nodeY, tree.nodeL, tree.nodeLeaf, tree.nodeChild = nodeX, nodeY, nodeL, nodeLeaf, nodeChild
	tree.lx, tree.ly, tree.lsl = lx, ly, lsl
	tree.leafCount = leaf
	return bitPos
end

local function newTree(width: number, height: number, maxDepth: number, I: number, bits: buffer): Tree
	return {
		width = width,
		height = height,
		maxDepth = maxDepth,
		rootLog2 = rootLog2For(width, height),
		I = I,
		bitCount = 0,
		bits = bits,
		leafCount = 0,
		lx = {},
		ly = {},
		lsl = {},
		bytes = buffer.create(1),
		nodeX = {},
		nodeY = {},
		nodeL = {},
		nodeLeaf = {},
		nodeChild = {},
	}
end

-- Parses a quadtree section starting at byte offset o. Returns the tree and the end offset.
function LiquidLearn.decodeTree(b: buffer, o: number, I: number): (Tree, number)
	local width = buffer.readu16(b, o)
	local height = buffer.readu16(b, o + 2)
	local maxDepth = buffer.readu8(b, o + 4)
	local bitStart = o + 5
	local rest = buffer.len(b) - bitStart
	local view = buffer.create(math.max(rest, 1))
	if rest > 0 then
		buffer.copy(view, 0, b, bitStart, rest)
	end
	local tree = newTree(width, height, maxDepth, I, view)
	local nbits = attachNodes(tree)
	tree.bitCount = nbits
	local nb = (nbits + 7) // 8
	local bits = buffer.create(math.max(nb, 1))
	if nb > 0 then
		buffer.copy(bits, 0, b, bitStart, nb)
	end
	tree.bits = bits
	local lb = tree.leafCount * I
	local leafStart = bitStart + nb
	assert(leafStart + lb <= buffer.len(b), "truncated leaf bytes")
	tree.bytes = buffer.create(math.max(lb, 1))
	if lb > 0 then
		buffer.copy(tree.bytes, 0, b, leafStart, lb)
	end
	return tree, leafStart + lb
end

function LiquidLearn.decode(b: buffer): (Reservoir, Readout, Tree)
	assert(buffer.len(b) >= 8, "too short")
	assert(buffer.readu8(b, 0) == 0x41 and buffer.readu8(b, 1) == 0x4C and buffer.readu8(b, 2) == 0x4E, "bad magic")
	assert(buffer.readu8(b, 3) == 1, "unsupported ALN version")
	local N, I, M, K = buffer.readu8(b, 4), buffer.readu8(b, 5), buffer.readu8(b, 6), buffer.readu8(b, 7)
	local o = 8
	local beta, B, kBase, Cf, Cb, d
	beta, o = readF64s(b, o, N)
	B, o = readF64s(b, o, N * I)
	kBase, o = readF64s(b, o, N)
	Cf, o = readF64s(b, o, M * N)
	Cb, o = readF64s(b, o, M * N)
	d, o = readF64s(b, o, M)
	local tree = LiquidLearn.decodeTree(b, o, I)
	return { N = N, I = I, K = K, beta = beta, B = B, kBase = kBase }, { M = M, N = N, Cf = Cf, Cb = Cb, d = d }, tree
end

----------------------------------------------------------------------------------
-- shell-byte quadtree builder (exact integer arithmetic)
----------------------------------------------------------------------------------

-- pixels: `stride` bytes per pixel, channels at byte offsets 0 .. C-1, row-major
-- width x height. A node splits iff depth < maxDepth, it covers at least one pixel,
-- and max over channels of max(max_c - mean_c, mean_c - min_c) > theta, with the
-- integer mean (2 sum + count) // (2 count). Leaf bytes are the means (I = C).
-- Same rule as build_tree in tools/liquid_train.py: identical bytes.
function LiquidLearn.buildTree(pixels: buffer, width: number, height: number, stride: number, C: number, theta: number, minLeaf: number?): Tree
	local rl = rootLog2For(width, height)
	local S = bit32.lshift(1, rl)
	local ml = 0
	local mlv = minLeaf or 1
	while bit32.lshift(1, ml) < mlv do
		ml += 1
	end
	assert(bit32.lshift(1, ml) == mlv, "minLeaf must be a power of two")
	local maxDepth = rl - ml
	-- pyramid levels 1..rl: node (nx, ny) of side 2^l at index ny * (S >> l) + nx
	local sums: { { number } } = {}
	local mins: { buffer } = {}
	local maxs: { buffer } = {}
	local cnts: { { number } } = {}
	for l = 1, rl do
		local n = bit32.rshift(S, l)
		sums[l] = table.create(n * n * C, 0)
		mins[l] = buffer.create(n * n * C)
		maxs[l] = buffer.create(n * n * C)
		buffer.fill(mins[l], 0, 255)
		cnts[l] = table.create(n * n, 0)
	end
	if rl >= 1 then
		local n = bit32.rshift(S, 1)
		local s1, mn1, mx1, c1 = sums[1], mins[1], maxs[1], cnts[1]
		for y = 0, height - 1 do
			local nrow = (y // 2) * n
			for x = 0, width - 1 do
				local node = nrow + x // 2
				c1[node + 1] += 1
				local o = (y * width + x) * stride
				local base = node * C
				for c = 0, C - 1 do
					local v = buffer.readu8(pixels, o + c)
					s1[base + c + 1] += v
					if v < buffer.readu8(mn1, base + c) then
						buffer.writeu8(mn1, base + c, v)
					end
					if v > buffer.readu8(mx1, base + c) then
						buffer.writeu8(mx1, base + c, v)
					end
				end
			end
		end
		for l = 2, rl do
			local nf = bit32.rshift(S, l - 1)
			local nc = bit32.rshift(nf, 1)
			local sf, mnf, mxf, cf = sums[l - 1], mins[l - 1], maxs[l - 1], cnts[l - 1]
			local sc, mnc, mxc, cc = sums[l], mins[l], maxs[l], cnts[l]
			for y = 0, nc - 1 do
				for x = 0, nc - 1 do
					local node = y * nc + x
					local a = (2 * y) * nf + 2 * x
					local k1, k2, k3, k4 = a, a + 1, a + nf, a + nf + 1
					cc[node + 1] = cf[k1 + 1] + cf[k2 + 1] + cf[k3 + 1] + cf[k4 + 1]
					for c = 0, C - 1 do
						local s, lo, hi = 0, 255, 0
						for q = 1, 4 do
							local kid = if q == 1 then k1 elseif q == 2 then k2 elseif q == 3 then k3 else k4
							if cf[kid + 1] > 0 then
								local kc = kid * C + c
								s += sf[kc + 1]
								local a1 = buffer.readu8(mnf, kc)
								local b1 = buffer.readu8(mxf, kc)
								if a1 < lo then
									lo = a1
								end
								if b1 > hi then
									hi = b1
								end
							end
						end
						sc[node * C + c + 1] = s
						buffer.writeu8(mnc, node * C + c, lo)
						buffer.writeu8(mxc, node * C + c, hi)
					end
				end
			end
		end
	end
	local bitBuf = buffer.create(math.max(1, S * S // 4 + 1))
	local bitCount = 0
	local leafBytes = buffer.create(math.max(1, S * S * C))
	local leafCount = 0
	local means = table.create(C, 0)
	local function nodeStats(x: number, y: number, l: number): (number, number)
		if l == 0 then
			if x >= width or y >= height then
				for c = 1, C do
					means[c] = 0
				end
				return 0, 0
			end
			local o = (y * width + x) * stride
			for c = 1, C do
				means[c] = buffer.readu8(pixels, o + c - 1)
			end
			return 1, 0
		end
		local n = bit32.rshift(S, l)
		local node = bit32.rshift(y, l) * n + bit32.rshift(x, l)
		local cnt = cnts[l][node + 1]
		if cnt == 0 then
			for c = 1, C do
				means[c] = 0
			end
			return 0, 0
		end
		local dev = 0
		local s, mn, mx = sums[l], mins[l], maxs[l]
		for c = 1, C do
			local k = node * C + c - 1
			local mean = (2 * s[k + 1] + cnt) // (2 * cnt)
			means[c] = mean
			local d1 = buffer.readu8(mx, k) - mean
			local d2 = mean - buffer.readu8(mn, k)
			if d1 > dev then
				dev = d1
			end
			if d2 > dev then
				dev = d2
			end
		end
		return cnt, dev
	end
	local function walk(x: number, y: number, l: number, depth: number)
		local cnt, dev = nodeStats(x, y, l)
		local split = false
		if depth < maxDepth then
			split = cnt > 0 and dev > theta
			if split then
				local byte = bitCount // 8
				buffer.writeu8(bitBuf, byte, bit32.bor(buffer.readu8(bitBuf, byte), bit32.lshift(1, bitCount % 8)))
			end
			bitCount += 1
		end
		if split then
			local h = bit32.lshift(1, l - 1)
			walk(x, y, l - 1, depth + 1)
			walk(x + h, y, l - 1, depth + 1)
			walk(x, y + h, l - 1, depth + 1)
			walk(x + h, y + h, l - 1, depth + 1)
		else
			local o = leafCount * C
			for c = 1, C do
				buffer.writeu8(leafBytes, o + c - 1, means[c])
			end
			leafCount += 1
		end
	end
	walk(0, 0, rl, 0)
	local nb = (bitCount + 7) // 8
	local bits = buffer.create(math.max(nb, 1))
	if nb > 0 then
		buffer.copy(bits, 0, bitBuf, 0, nb)
	end
	local tree = newTree(width, height, maxDepth, C, bits)
	tree.bitCount = attachNodes(tree)
	assert(tree.leafCount == leafCount and tree.bitCount == bitCount, "tree walk mismatch")
	tree.bytes = buffer.create(math.max(leafCount * C, 1))
	buffer.copy(tree.bytes, 0, leafBytes, 0, leafCount * C)
	return tree
end

----------------------------------------------------------------------------------
-- rows: segments and exact bidirectional states
----------------------------------------------------------------------------------

export type Rows = {
	tree: Tree,
	res: Reservoir,
	r: number,
	W: number, -- row length at render scale
	N: number,
	D: number,
	leafB: { number }, -- index leaf * N + i (leaf 0-based, i 1-based)
	leafG: { number },
	segX0: { number },
	segX1: { number },
	segLeaf: { number },
	segCount: number,
	groupEnd: number, -- tree rows y .. groupEnd-1 cross the same leaves
	stack: { number },
	-- quantised features of the current band, feature-major: (j - 1) * W + x + 1
	feat: { number },
	-- band accumulators: sample weight per column, target sums per column
	-- ((m - 1) * W + x + 1), and the compacted terms of the band
	w: { number },
	colY: { number },
	termF: { number },
	termW: { number },
	termY: { number },
	termK: number,
	gF: { number }, -- active term source for bandGram: the term arrays or the band itself
	gW: { number },
	gY: { number },
	wf: { number },
	wf2: { number },
	uniq: { number },
	alias: { number },
	gu: { number },
	su: { number },
	pu: { number },
}

-- Per-leaf targets b and gains g in the exact order. r = log2(render scale).
function LiquidLearn.newRows(res: Reservoir, tree: Tree, r: number?): Rows
	local rr = r or 0
	local N, I, K = res.N, res.I, res.K
	local gt = gainTable(K)
	local L = tree.leafCount
	local leafB = table.create(L * N, 0)
	local leafG = table.create(L * N, 0)
	local bytes = tree.bytes
	local beta, B, kBase = res.beta, res.B, res.kBase
	local u = table.create(I, 0)
	for leaf = 0, L - 1 do
		for t = 1, I do
			u[t] = buffer.readu8(bytes, leaf * I + t - 1) / 255
		end
		local sl = tree.lsl[leaf + 1]
		for i = 1, N do
			local b = beta[i]
			for t = 1, I do
				b = b + B[(i - 1) * I + t] * u[t]
			end
			leafB[leaf * N + i] = b
			leafG[leaf * N + i] = gt[clampK(kBase[i] + sl + rr, K) + 1]
		end
	end
	local W = bit32.lshift(tree.width, rr)
	return {
		tree = tree,
		res = res,
		r = rr,
		W = W,
		N = N,
		D = 2 * N + 1,
		leafB = leafB,
		leafG = leafG,
		segX0 = {},
		segX1 = {},
		segLeaf = {},
		segCount = 0,
		groupEnd = 0,
		stack = {},
		feat = table.create(W * (2 * N + 1), 0),
		w = table.create(W, 0),
		colY = table.create(MAX_M * W, 0),
		termF = table.create(W * (2 * N + 1), 0),
		termW = table.create(W, 0),
		termY = table.create(MAX_M * W, 0),
		termK = 0,
		gF = {},
		gW = {},
		gY = {},
		wf = table.create(W, 0),
		wf2 = table.create(W, 0),
		uniq = table.create(2 * N, 0),
		alias = table.create(2 * N, 0),
		gu = table.create(4 * N * N, 0),
		su = table.create(2 * N, 0),
		pu = table.create(2 * N * MAX_M, 0),
	}
end

-- Leaves crossed by tree row y, in increasing x, at render scale. Also sets groupEnd.
function LiquidLearn.rowSegments(rows: Rows, y: number): number
	local tree = rows.tree
	local nodeX, nodeY, nodeL, nodeLeaf, nodeChild = tree.nodeX, tree.nodeY, tree.nodeL, tree.nodeLeaf, tree.nodeChild
	local width = tree.width
	local r = rows.r
	local segX0, segX1, segLeaf = rows.segX0, rows.segX1, rows.segLeaf
	local stack = rows.stack
	local sp = 1
	stack[1] = 1
	local n = 0
	local groupEnd = tree.height
	while sp > 0 do
		local id = stack[sp]
		sp -= 1
		local x0 = nodeX[id]
		if x0 < width then
			local leaf = nodeLeaf[id]
			if leaf >= 0 then
				local side = bit32.lshift(1, nodeL[id])
				local x1 = x0 + side
				if x1 > width then
					x1 = width
				end
				n += 1
				segX0[n] = bit32.lshift(x0, r)
				segX1[n] = bit32.lshift(x1, r)
				segLeaf[n] = leaf
				local bottom = nodeY[id] + side
				if bottom < groupEnd then
					groupEnd = bottom
				end
			else
				local base = (id - 1) * 4
				local h = bit32.lshift(1, nodeL[id] - 1)
				if y < nodeY[id] + h then
					stack[sp + 1] = nodeChild[base + 2]
					stack[sp + 2] = nodeChild[base + 1]
				else
					stack[sp + 1] = nodeChild[base + 4]
					stack[sp + 2] = nodeChild[base + 3]
				end
				sp += 2
			end
		end
	end
	rows.segCount = n
	rows.groupEnd = groupEnd
	return n
end

-- Exact float states of the current segments: hf, hb at index x * N + i.
function LiquidLearn.simulate(rows: Rows, hf: { number }, hb: { number })
	local N = rows.N
	local leafB, leafG = rows.leafB, rows.leafG
	local segX0, segX1, segLeaf = rows.segX0, rows.segX1, rows.segLeaf
	local n = rows.segCount
	for i = 1, N do
		local h = leafB[segLeaf[1] * N + i]
		for s = 1, n do
			local k = segLeaf[s] * N + i
			local b, g = leafB[k], leafG[k]
			for x = segX0[s], segX1[s] - 1 do
				h = h + (b - h) * g
				hf[x * N + i] = h
			end
		end
		h = leafB[segLeaf[n] * N + i]
		for s = n, 1, -1 do
			local k = segLeaf[s] * N + i
			local b, g = leafB[k], leafG[k]
			for x = segX1[s] - 1, segX0[s], -1 do
				h = h + (b - h) * g
				hb[x * N + i] = h
			end
		end
	end
end

-- Quantised features of the current segments into rows.feat, feature-major:
-- feat[(j - 1) * W + x + 1], j = 1..N forward, N+1..2N backward, D the constant.
-- Neurons are uncoupled, so a band's states can be computed in neuron ranges
-- [i0, i1] (the time-sliced trainer does this); the constant column is written
-- with the last neuron.
function LiquidLearn.simulateQ(rows: Rows, i0: number?, i1: number?)
	local N, D, W = rows.N, rows.D, rows.W
	local feat = rows.feat
	local leafB, leafG = rows.leafB, rows.leafG
	local segX0, segX1, segLeaf = rows.segX0, rows.segX1, rows.segLeaf
	local n = rows.segCount
	local last = i1 or N
	local i = i0 or 1
	-- four neurons per pass: four independent recurrences hide the latency of the
	-- step (each neuron's own operation sequence, and therefore its bits, is unchanged)
	while i + 3 <= last do
		local i2, i3, i4 = i + 1, i + 2, i + 3
		local k0 = segLeaf[1] * N
		local h1, h2, h3, h4 = leafB[k0 + i], leafB[k0 + i2], leafB[k0 + i3], leafB[k0 + i4]
		local o1, o2, o3, o4 = (i - 1) * W + 1, i * W + 1, (i + 1) * W + 1, (i + 2) * W + 1
		for sg = 1, n do
			local k = segLeaf[sg] * N
			local b1, b2, b3, b4 = leafB[k + i], leafB[k + i2], leafB[k + i3], leafB[k + i4]
			local g1, g2, g3, g4 = leafG[k + i], leafG[k + i2], leafG[k + i3], leafG[k + i4]
			for x = segX0[sg], segX1[sg] - 1 do
				h1 = h1 + (b1 - h1) * g1
				h2 = h2 + (b2 - h2) * g2
				h3 = h3 + (b3 - h3) * g3
				h4 = h4 + (b4 - h4) * g4
				feat[o1 + x] = floor(h1 * 32767 + 0.5)
				feat[o2 + x] = floor(h2 * 32767 + 0.5)
				feat[o3 + x] = floor(h3 * 32767 + 0.5)
				feat[o4 + x] = floor(h4 * 32767 + 0.5)
			end
		end
		local kn = segLeaf[n] * N
		h1, h2, h3, h4 = leafB[kn + i], leafB[kn + i2], leafB[kn + i3], leafB[kn + i4]
		o1, o2, o3, o4 = (N + i - 1) * W + 1, (N + i) * W + 1, (N + i + 1) * W + 1, (N + i + 2) * W + 1
		for sg = n, 1, -1 do
			local k = segLeaf[sg] * N
			local b1, b2, b3, b4 = leafB[k + i], leafB[k + i2], leafB[k + i3], leafB[k + i4]
			local g1, g2, g3, g4 = leafG[k + i], leafG[k + i2], leafG[k + i3], leafG[k + i4]
			for x = segX1[sg] - 1, segX0[sg], -1 do
				h1 = h1 + (b1 - h1) * g1
				h2 = h2 + (b2 - h2) * g2
				h3 = h3 + (b3 - h3) * g3
				h4 = h4 + (b4 - h4) * g4
				feat[o1 + x] = floor(h1 * 32767 + 0.5)
				feat[o2 + x] = floor(h2 * 32767 + 0.5)
				feat[o3 + x] = floor(h3 * 32767 + 0.5)
				feat[o4 + x] = floor(h4 * 32767 + 0.5)
			end
		end
		i += 4
	end
	while i <= last do
		local h = leafB[segLeaf[1] * N + i]
		local of = (i - 1) * W + 1
		for sg = 1, n do
			local k = segLeaf[sg] * N + i
			local b, g = leafB[k], leafG[k]
			for x = segX0[sg], segX1[sg] - 1 do
				h = h + (b - h) * g
				feat[of + x] = floor(h * 32767 + 0.5)
			end
		end
		h = leafB[segLeaf[n] * N + i]
		local ob = (N + i - 1) * W + 1
		for sg = n, 1, -1 do
			local k = segLeaf[sg] * N + i
			local b, g = leafB[k], leafG[k]
			for x = segX1[sg] - 1, segX0[sg], -1 do
				h = h + (b - h) * g
				feat[ob + x] = floor(h * 32767 + 0.5)
			end
		end
		i += 1
	end
	if last == N then
		local oc = (D - 1) * W + 1
		for x = 0, W - 1 do
			feat[oc + x] = QSCALE
		end
	end
end

----------------------------------------------------------------------------------
-- reference renderer (epsilon = 0: every pixel stepped and evaluated)
----------------------------------------------------------------------------------

-- M bytes per pixel, row-major, at render scale 2^r. Rows of one quadtree band are
-- identical and copied.
function LiquidLearn.renderExact(res: Reservoir, ro: Readout, tree: Tree, r: number?): buffer
	local rows = LiquidLearn.newRows(res, tree, r)
	local N, M = res.N, ro.M
	local W = rows.W
	local rep = bit32.lshift(1, rows.r)
	local out = buffer.create(W * tree.height * rep * M)
	local hf = table.create(W * N, 0)
	local hb = table.create(W * N, 0)
	local Cf, Cb, d = ro.Cf, ro.Cb, ro.d
	local rowBytes = W * M
	local y = 0
	while y < tree.height do
		LiquidLearn.rowSegments(rows, y)
		LiquidLearn.simulate(rows, hf, hb)
		local first = y * rep * rowBytes
		for x = 0, W - 1 do
			local hx = x * N
			for m = 1, M do
				local cm = (m - 1) * N
				local z = d[m]
				for i = 1, N do
					z = z + Cf[cm + i] * hf[hx + i]
				end
				for i = 1, N do
					z = z + Cb[cm + i] * hb[hx + i]
				end
				local v = floor(z + 0.5)
				buffer.writeu8(out, first + x * M + m - 1, if v < 0 then 0 elseif v > 255 then 255 else v)
			end
		end
		for k = y * rep + 1, rows.groupEnd * rep - 1 do
			buffer.copy(out, k * rowBytes, out, first, rowBytes)
		end
		y = rows.groupEnd
	end
	return out
end

----------------------------------------------------------------------------------
-- exact statistics (S1, S3)
----------------------------------------------------------------------------------

function LiquidLearn.newStats(D: number, M: number): Stats
	local E = D * (D + 1) // 2 + D * M + M + 1
	return { D = D, M = M, E = E, hi = table.create(E, 0), lo = table.create(E, 0), pending = 0 }
end

-- Canonical form: 0 <= lo < 2^32 for every entry. Exact while |lo| < 2^53.
local function normalise(st: Stats)
	local hi, lo = st.hi, st.lo
	for e = 1, st.E do
		local v = lo[e]
		if v >= TWO32 or v < 0 then
			local c = floor(v / TWO32)
			lo[e] = v - c * TWO32
			hi[e] += c
		end
	end
	st.pending = 0
end
LiquidLearn.normalise = normalise

local function weightLimit(): number
	local lim = LiquidLearn.pendingLimit
	assert(lim >= 1 and lim <= PENDING_LIMIT and lim % 1 == 0, "pendingLimit must be an integer in [1, 2^22]")
	return lim
end

function LiquidLearn.copyStats(st: Stats): Stats
	local o = LiquidLearn.newStats(st.D, st.M)
	table.move(st.hi, 1, st.E, 1, o.hi)
	table.move(st.lo, 1, st.E, 1, o.lo)
	o.pending = st.pending
	return o
end

local function canonical(st: Stats): Stats
	if st.pending == 0 then
		local ok = true
		local lo = st.lo
		for e = 1, st.E do
			local v = lo[e]
			if v >= TWO32 or v < 0 then
				ok = false
				break
			end
		end
		if ok then
			return st
		end
	end
	local c = LiquidLearn.copyStats(st)
	normalise(c)
	return c
end

-- a = a + b, exact; both stay canonical.
function LiquidLearn.addStats(a: Stats, b: Stats)
	assert(a.E == b.E and a.D == b.D and a.M == b.M, "stats shape mismatch")
	normalise(a)
	local bb = canonical(b)
	local ahi, alo, bhi, blo = a.hi, a.lo, bb.hi, bb.lo
	for e = 1, a.E do
		ahi[e] += bhi[e]
		alo[e] += blo[e]
	end
	normalise(a)
end

-- a = a - b, exact (sliding windows).
function LiquidLearn.subStats(a: Stats, b: Stats)
	assert(a.E == b.E, "stats shape mismatch")
	normalise(a)
	local bb = canonical(b)
	for e = 1, a.E do
		a.hi[e] -= bb.hi[e]
		a.lo[e] -= bb.lo[e]
	end
	normalise(a)
end

-- Every entry v becomes floor(v / 2), exactly: deterministic forgetting.
function LiquidLearn.halveStats(a: Stats)
	normalise(a)
	for e = 1, a.E do
		local h = a.hi[e]
		local hh = floor(h / 2)
		local carry = h - hh * 2
		a.hi[e] = hh
		a.lo[e] = floor((carry * TWO32 + a.lo[e]) / 2)
	end
	normalise(a)
end

function LiquidLearn.statsEqual(a: Stats, b: Stats): boolean
	if a.E ~= b.E then
		return false
	end
	local ca, cb = canonical(a), canonical(b)
	for e = 1, a.E do
		if ca.hi[e] ~= cb.hi[e] or ca.lo[e] ~= cb.lo[e] then
			return false
		end
	end
	return true
end

local function entryFloat(st: Stats, e: number): number
	return st.hi[e] * TWO32 + st.lo[e]
end
LiquidLearn.entryFloat = entryFloat

local function triOffsets(D: number): { number }
	local off = table.create(D, 0)
	local acc = 0
	for i = 1, D do
		off[i] = acc
		acc += D - i + 1
	end
	return off
end
LiquidLearn.triOffsets = triOffsets

export type AccumOptions = {
	stride: number?, -- sample render pixel (x, y) iff (x + y) % stride == 0 (default 1)
	event: boolean?, -- merge runs of identical feature vectors into weighted terms
	targetStride: number?, -- bytes per target pixel (default M); channels 0 .. M-1
	naive: boolean?, -- per-sample outer products (the S2 cost model; benchmark only)
}

local offCache: { [number]: { number } } = {}
local function offsetsFor(D: number): { number }
	local o = offCache[D]
	if o == nil then
		o = triOffsets(D)
		offCache[D] = o
	end
	return o
end

-- Band accumulation. The rows of one quadtree band share their features, so with
-- w(x) = number of sampled pixels in column x of the band and Y_m(x) their target
-- sum, the band contributes
--   G[i][j] += sum_x w(x) f_i(x) f_j(x),  P[i][m] += sum_x f_i(x) Y_m(x),
--   count += sum_x w(x),  YY_m += sum of y_m^2 over the sampled pixels.
-- These are the same integers as visiting every sampled pixel (exact arithmetic,
-- every partial sum below 2^53), at the cost of one row of products per band.
-- Event mode merges consecutive columns with identical features into one term.

-- Clears the band accumulators (call after simulateQ for a new band).
function LiquidLearn.bandReset(rows: Rows, M: number)
	local W = rows.W
	local w, colY = rows.w, rows.colY
	for x = 1, W do
		w[x] = 0
	end
	for i = 1, W * M do
		colY[i] = 0
	end
	rows.termK = 0
end

-- Adds the sampled targets of render rows [yr0, yr1), columns [x0, x1).
function LiquidLearn.bandTargets(st: Stats, rows: Rows, target: buffer, yr0: number, yr1: number, x0: number, x1: number, o: AccumOptions)
	local M = st.M
	local W = rows.W
	local w, colY = rows.w, rows.colY
	local tstride = o.targetStride or M
	local stride = o.stride or 1
	local lo = st.lo
	local D = rows.D
	local yb = D * (D + 1) // 2 + D * M
	local rowBytes = W * tstride
	for yr = yr0, yr1 - 1 do
		local rowOff = yr * rowBytes
		local first = x0 + (stride - ((x0 + yr) % stride)) % stride
		for x = first, x1 - 1, stride do
			w[x + 1] += 1
			local to = rowOff + x * tstride
			for m = 1, M do
				local v = buffer.readu8(target, to + m - 1)
				colY[(m - 1) * W + x + 1] += v
				lo[yb + m] += v * v
			end
		end
	end
end

-- True when every column of the band has at least one sampled pixel.
function LiquidLearn.bandAllSampled(rows: Rows): boolean
	local w = rows.w
	for x = 1, rows.W do
		if w[x] == 0 then
			return false
		end
	end
	return true
end

-- Plain mode with every column sampled: the band's columns are the terms, read in
-- place (no copy).
function LiquidLearn.bandTermsIdentity(rows: Rows): number
	rows.gF, rows.gW, rows.gY = rows.feat, rows.w, rows.colY
	rows.termK = rows.W
	return rows.W
end

-- Appends the terms of columns [x0, x1) with w > 0: one term per column, or per run
-- of identical features in event mode (runs never cross x1). x0 = 0 starts a new
-- list. Returns the number of terms so far.
function LiquidLearn.bandTerms(rows: Rows, M: number, o: AccumOptions, x0: number?, x1: number?): number
	local W, D = rows.W, rows.D
	local feat, w, colY = rows.feat, rows.w, rows.colY
	local tF, tW, tY = rows.termF, rows.termW, rows.termY
	rows.gF, rows.gW, rows.gY = tF, tW, tY
	local event = o.event == true
	local xa, xb = x0 or 0, x1 or W
	local K = if xa == 0 then 0 else rows.termK
	local x = xa
	while x < xb do
		if w[x + 1] == 0 then
			x += 1
			continue
		end
		local xe = x + 1
		if event then
			while xe < xb do
				local same = true
				for j = 1, D - 1 do
					local oj = (j - 1) * W + 1
					if feat[oj + xe] ~= feat[oj + x] then
						same = false
						break
					end
				end
				if not same then
					break
				end
				xe += 1
			end
		end
		local ws = 0
		for xx = x, xe - 1 do
			ws += w[xx + 1]
		end
		if ws > 0 then
			K += 1
			tW[K] = ws
			for j = 1, D do
				tF[(j - 1) * W + K] = feat[(j - 1) * W + x + 1]
			end
			for m = 1, M do
				local om = (m - 1) * W + 1
				local sy = 0
				for xx = x, xe - 1 do
					sy += colY[om + xx]
				end
				tY[(m - 1) * W + K] = sy
			end
		end
		x = xe
	end
	rows.termK = K
	return K
end

-- Adds terms [k0, k1) (1-based, inclusive k0) of the band to G, P and count.
--  * Exact column dedupe: varying feature columns that are bit-identical over these
--    terms (an instant neuron's forward and backward features almost always are) are
--    multiplied once and their products scattered to every aliased entry.
--  * Inner products with 2 x 4 register blocking: two unique columns against four
--    share each load.
--  * The constant feature's row and column are scaled sums.
-- Every partial sum is an integer below 2^53, so the result equals any other order.
function LiquidLearn.bandGram(st: Stats, rows: Rows, k0: number, k1: number)
	local D, M, W = rows.D, st.M, rows.W
	assert(st.D == D and M <= MAX_M, "statistics do not match the reservoir")
	local tF, tW, tY, wf, wf2 = rows.gF, rows.gW, rows.gY, rows.wf, rows.wf2
	local lo = st.lo
	local off = offsetsFor(D)
	local T = D * (D + 1) // 2
	local wsum = 0
	for k = k0, k1 - 1 do
		wsum += tW[k]
	end
	-- S3 invariant: one call adds at most 2^22 of sample weight, so every inner product
	-- (at most 2^22 * 2^30) and every accumulator stays below 2^53
	local lim = weightLimit()
	assert(wsum <= lim, "too much sample weight in one Gram call; split the band rows")
	if st.pending + wsum > lim then
		normalise(st)
	end
	local Dv = D - 1 -- varying features; feature D is the constant QSCALE
	-- 1. unique varying columns over these terms
	local uniq, alias = rows.uniq, rows.alias
	local U = 0
	for j = 1, Dv do
		local oj = (j - 1) * W
		local found = 0
		for u = 1, U do
			local ou = (uniq[u] - 1) * W
			local same = true
			for k = k0, k1 - 1 do
				if tF[oj + k] ~= tF[ou + k] then
					same = false
					break
				end
			end
			if same then
				found = u
				break
			end
		end
		if found == 0 then
			U += 1
			uniq[U] = j
			alias[j] = U
		else
			alias[j] = found
		end
	end
	-- 2. Gram of the unique columns: gu[(a - 1) * U + b] for a <= b, su[a] = sum w f_a
	local gu, su, pu = rows.gu, rows.su, rows.pu
	local a = 1
	while a <= U do
		local two = a + 1 <= U
		local ca = (uniq[a] - 1) * W
		local ca2 = if two then (uniq[a + 1] - 1) * W else 0
		local s1, s2 = 0, 0
		for k = k0, k1 - 1 do
			local w = tW[k]
			local x = w * tF[ca + k]
			wf[k] = x
			s1 += x
			if two then
				local y = w * tF[ca2 + k]
				wf2[k] = y
				s2 += y
			end
		end
		su[a] = s1
		local ra = (a - 1) * U
		local ra2 = a * U
		do
			local g11 = 0
			for k = k0, k1 - 1 do
				g11 += wf[k] * tF[ca + k]
			end
			gu[ra + a] = g11
			if two then
				su[a + 1] = s2
				local g12, g22 = 0, 0
				for k = k0, k1 - 1 do
					local f = tF[ca2 + k]
					g12 += wf[k] * f
					g22 += wf2[k] * f
				end
				gu[ra + a + 1] = g12
				gu[ra2 + a + 1] = g22
			end
		end
		local b = if two then a + 2 else a + 1
		while b + 3 <= U do
			local o1, o2, o3, o4 = (uniq[b] - 1) * W, (uniq[b + 1] - 1) * W, (uniq[b + 2] - 1) * W, (uniq[b + 3] - 1) * W
			local a1, a2, a3, a4, b1, b2, b3, b4 = 0, 0, 0, 0, 0, 0, 0, 0
			if two then
				for k = k0, k1 - 1 do
					local w, v = wf[k], wf2[k]
					local f1, f2, f3, f4 = tF[o1 + k], tF[o2 + k], tF[o3 + k], tF[o4 + k]
					a1 += w * f1
					a2 += w * f2
					a3 += w * f3
					a4 += w * f4
					b1 += v * f1
					b2 += v * f2
					b3 += v * f3
					b4 += v * f4
				end
				gu[ra2 + b] = b1
				gu[ra2 + b + 1] = b2
				gu[ra2 + b + 2] = b3
				gu[ra2 + b + 3] = b4
			else
				for k = k0, k1 - 1 do
					local w = wf[k]
					a1 += w * tF[o1 + k]
					a2 += w * tF[o2 + k]
					a3 += w * tF[o3 + k]
					a4 += w * tF[o4 + k]
				end
			end
			gu[ra + b] = a1
			gu[ra + b + 1] = a2
			gu[ra + b + 2] = a3
			gu[ra + b + 3] = a4
			b += 4
		end
		while b <= U do
			local o1 = (uniq[b] - 1) * W
			local a1, b1 = 0, 0
			for k = k0, k1 - 1 do
				local f = tF[o1 + k]
				a1 += wf[k] * f
				if two then
					b1 += wf2[k] * f
				end
			end
			gu[ra + b] = a1
			if two then
				gu[ra2 + b] = b1
			end
			b += 1
		end
		a += 2
	end
	-- 3. P of the unique columns: pu[(a - 1) * M + m], three channels per pass
	for u = 1, U do
		local cu = (uniq[u] - 1) * W
		local pb = (u - 1) * M
		local m = 1
		while m <= M do
			local om1 = (m - 1) * W
			if m + 2 <= M then
				local om2, om3 = m * W, (m + 1) * W
				local x1, x2, x3 = 0, 0, 0
				for k = k0, k1 - 1 do
					local f = tF[cu + k]
					x1 += f * tY[om1 + k]
					x2 += f * tY[om2 + k]
					x3 += f * tY[om3 + k]
				end
				pu[pb + m] = x1
				pu[pb + m + 1] = x2
				pu[pb + m + 2] = x3
				m += 3
			else
				local x1 = 0
				for k = k0, k1 - 1 do
					x1 += tF[cu + k] * tY[om1 + k]
				end
				pu[pb + m] = x1
				m += 1
			end
		end
	end
	-- 4. scatter to the statistics
	for i = 1, Dv do
		local ai = alias[i]
		local base = off[i] - i + 1
		for j = i, Dv do
			local aj = alias[j]
			if ai <= aj then
				lo[base + j] += gu[(ai - 1) * U + aj]
			else
				lo[base + j] += gu[(aj - 1) * U + ai]
			end
		end
		lo[base + D] += QSCALE * su[ai]
		local pb = T + (i - 1) * M
		local qb = (ai - 1) * M
		for m = 1, M do
			lo[pb + m] += pu[qb + m]
		end
	end
	lo[off[D] + 1] += QSCALE * QSCALE * wsum
	local pD = T + (D - 1) * M
	for m = 1, M do
		local om = (m - 1) * W
		local x1 = 0
		for k = k0, k1 - 1 do
			x1 += tY[om + k]
		end
		lo[pD + m] += QSCALE * x1
	end
	lo[T + D * M + M + 1] += wsum
	st.pending += wsum
end

-- The S2 cost model as written in docs/LIQUID.md: one outer product per sampled
-- pixel (benchmark reference; same integers as the band path).
local function naiveRange(st: Stats, rows: Rows, target: buffer, yr0: number, yr1: number, o: AccumOptions)
	local D, M, W = rows.D, st.M, rows.W
	local feat = rows.feat
	local lo = st.lo
	local off = offsetsFor(D)
	local T = D * (D + 1) // 2
	local yb = T + D * M
	local tstride = o.targetStride or M
	local stride = o.stride or 1
	local s = table.create(D, 0)
	local y = table.create(M, 0)
	for yr = yr0, yr1 - 1 do
		if st.pending + W > PENDING_LIMIT then
			normalise(st)
		end
		local rowOff = yr * W * tstride
		local n = 0
		for x = (stride - (yr % stride)) % stride, W - 1, stride do
			for j = 1, D do
				s[j] = feat[(j - 1) * W + x + 1]
			end
			for m = 1, M do
				local v = buffer.readu8(target, rowOff + x * tstride + m - 1)
				y[m] = v
				lo[yb + m] += v * v
			end
			for i = 1, D do
				local si = s[i]
				local base = off[i] - i + 1
				for j = i, D do
					lo[base + j] += si * s[j]
				end
				local pb = T + (i - 1) * M
				for m = 1, M do
					lo[pb + m] += si * y[m]
				end
			end
			n += 1
		end
		lo[T + D * M + M + 1] += n
		st.pending += n
	end
end

-- Accumulates render rows [yr0, yr1) and columns [x0, x1) of the current band (after
-- rowSegments and simulateQ). The result does not depend on how bands are cut.
function LiquidLearn.accumulateRange(st: Stats, rows: Rows, target: buffer, yr0: number, yr1: number, x0: number, x1: number, o: AccumOptions)
	if o.naive then
		assert(x0 == 0 and x1 == rows.W, "naive mode works on whole rows")
		naiveRange(st, rows, target, yr0, yr1, o)
		return
	end
	-- at most pendingLimit (<= 2^22) samples per pass (S3 invariant); large bands go in
	-- row chunks
	local maxRows = math.max(1, weightLimit() // rows.W)
	local ya = yr0
	while ya < yr1 do
		local yb = math.min(yr1, ya + maxRows)
		LiquidLearn.bandReset(rows, st.M)
		LiquidLearn.bandTargets(st, rows, target, ya, yb, x0, x1, o)
		local K
		if not o.event and LiquidLearn.bandAllSampled(rows) then
			K = LiquidLearn.bandTermsIdentity(rows)
		else
			K = LiquidLearn.bandTerms(rows, st.M, o)
		end
		LiquidLearn.bandGram(st, rows, 1, K + 1)
		ya = yb
	end
end

-- Accumulates every row of the tree (rendered at the scale of `rows`) against the
-- target (render-scale size). Every mode produces the same integers as visiting each
-- sampled pixel once.
function LiquidLearn.accumulate(st: Stats, rows: Rows, target: buffer, opts: AccumOptions?)
	local o: AccumOptions = opts or {}
	local tree = rows.tree
	local rep = bit32.lshift(1, rows.r)
	local y = 0
	while y < tree.height do
		LiquidLearn.rowSegments(rows, y)
		LiquidLearn.simulateQ(rows)
		LiquidLearn.accumulateRange(st, rows, target, y * rep, rows.groupEnd * rep, 0, rows.W, o)
		y = rows.groupEnd
	end
end

----------------------------------------------------------------------------------
-- deterministic ridge solve (S1): (G + lambda I') w = P by Cholesky
----------------------------------------------------------------------------------

-- A: dense D x D rows (overwritten), Pm: D x M. lambda = lamRel * mean diagonal of the
-- non-constant features, added to every diagonal entry but the constant's. Same
-- operations in the same order as cholesky_solve_exact in tools/liquid_train.py.
local function choleskySolve(A: { { number } }, Pm: { { number } }, D: number, M: number, lamRel: number, mult: { number }?): { { number } }?
	local tr = 0
	for i = 1, D - 1 do
		tr = tr + A[i][i]
	end
	local lam = lamRel * (tr / (D - 1))
	for i = 1, D - 1 do
		A[i][i] = A[i][i] + (if mult then lam * mult[i] else lam)
	end
	local L: { { number } } = {}
	for i = 1, D do
		L[i] = table.create(D, 0)
	end
	for j = 1, D do
		local Lj = L[j]
		local s = A[j][j]
		for k = 1, j - 1 do
			s = s - Lj[k] * Lj[k]
		end
		if not (s > 0) then
			return nil
		end
		local dj = sqrt(s)
		Lj[j] = dj
		for i = j + 1, D do
			local Li = L[i]
			local t = A[i][j]
			for k = 1, j - 1 do
				t = t - Li[k] * Lj[k]
			end
			Li[j] = t / dj
		end
	end
	local Wm: { { number } } = {}
	for i = 1, D do
		Wm[i] = table.create(M, 0)
	end
	local yv = table.create(D, 0)
	for m = 1, M do
		for i = 1, D do
			local Li = L[i]
			local s = Pm[i][m]
			for k = 1, i - 1 do
				s = s - Li[k] * yv[k]
			end
			yv[i] = s / Li[i]
		end
		for i = D, 1, -1 do
			local s = yv[i]
			for k = i + 1, D do
				s = s - L[k][i] * Wm[k][m]
			end
			Wm[i][m] = s / L[i][i]
		end
	end
	return Wm
end
LiquidLearn.choleskySolve = choleskySolve

-- Dense float matrices of the statistics.
function LiquidLearn.statsMatrices(st: Stats): ({ { number } }, { { number } })
	local D, M = st.D, st.M
	local c = canonical(st)
	local off = triOffsets(D)
	local A: { { number } } = {}
	for i = 1, D do
		A[i] = table.create(D, 0)
	end
	for i = 1, D do
		for j = i, D do
			local v = entryFloat(c, off[i] + (j - i) + 1)
			A[i][j] = v
			A[j][i] = v
		end
	end
	local T = D * (D + 1) // 2
	local Pm: { { number } } = {}
	for i = 1, D do
		local row = table.create(M, 0)
		for m = 1, M do
			row[m] = entryFloat(c, T + (i - 1) * M + m)
		end
		Pm[i] = row
	end
	return A, Pm
end

function LiquidLearn.statsYY(st: Stats): ({ number }, number)
	local c = canonical(st)
	local D, M = st.D, st.M
	local T = D * (D + 1) // 2
	local yy = table.create(M, 0)
	for m = 1, M do
		yy[m] = entryFloat(c, T + D * M + m)
	end
	return yy, entryFloat(c, T + D * M + M + 1)
end

local function readoutFromW(Wm: { { number } }, N: number, M: number): Readout
	local Cf, Cb, d = table.create(M * N, 0), table.create(M * N, 0), table.create(M, 0)
	for m = 1, M do
		for i = 1, N do
			Cf[(m - 1) * N + i] = Wm[i][m] * QSCALE
			Cb[(m - 1) * N + i] = Wm[N + i][m] * QSCALE
		end
		d[m] = Wm[2 * N + 1][m] * QSCALE
	end
	return { M = M, N = N, Cf = Cf, Cb = Cb, d = d }
end

-- Ridge readout from exact statistics: identical bytes in the interpreter, in native
-- code and in tools/liquid_train.py (cholesky_solve_exact). `mult` (length D - 1)
-- scales the ridge per feature; slowRidge builds the event-aware one.
function LiquidLearn.solve(st: Stats, N: number, lamRel: number?, mult: { number }?): Readout
	assert(st.D == 2 * N + 1, "statistics do not match N")
	local A, Pm = LiquidLearn.statsMatrices(st)
	local Wm = choleskySolve(A, Pm, st.D, st.M, lamRel or LiquidLearn.DEFAULT_LAMBDA, mult)
	assert(Wm, "ridge system not positive definite")
	return readoutFromW(Wm :: { { number } }, N, st.M)
end

-- Event-aware ridge: slowMult on the forward and backward features of every slow
-- neuron (kBase > -K), 1 on instant neurons. Large slowMult shrinks the weights that
-- keep pixels active under the T2 skip rule: 1 is the plain ridge, about 1e6 gives the
-- plain quadtree (events = segments); docs/LIQUID_TRAINING.md 3.3 measures the dial.
function LiquidLearn.slowRidge(res: Reservoir, slowMult: number): { number }
	local N = res.N
	local m = table.create(2 * N, 1)
	for i = 1, N do
		if res.kBase[i] > -res.K then
			m[i] = slowMult
			m[N + i] = slowMult
		end
	end
	return m
end

-- SSE of weights Wm on statistics: YY_m - 2 w.P_m + w^T G w, summed over channels.
local function sseFrom(A: { { number } }, Pm: { { number } }, yy: { number }, Wm: { { number } }, D: number, M: number): number
	local total = 0
	for m = 1, M do
		local cross = 0
		for i = 1, D do
			cross = cross + Wm[i][m] * Pm[i][m]
		end
		local quad = 0
		for i = 1, D do
			local gi = A[i]
			local acc = 0
			for j = 1, D do
				acc = acc + gi[j] * Wm[j][m]
			end
			quad = quad + Wm[i][m] * acc
		end
		total = total + (yy[m] - 2 * cross + quad)
	end
	return total
end

-- Mean squared error (per channel value, before quantisation) of a readout measured
-- on statistics alone: validation without rendering.
function LiquidLearn.mseOf(st: Stats, ro: Readout): number
	local D, M, N = st.D, st.M, ro.N
	local A, Pm = LiquidLearn.statsMatrices(st)
	local yy, count = LiquidLearn.statsYY(st)
	local Wm: { { number } } = {}
	for i = 1, D do
		Wm[i] = table.create(M, 0)
	end
	for m = 1, M do
		for i = 1, N do
			Wm[i][m] = ro.Cf[(m - 1) * N + i] / QSCALE
			Wm[N + i][m] = ro.Cb[(m - 1) * N + i] / QSCALE
		end
		Wm[D][m] = ro.d[m] / QSCALE
	end
	return sseFrom(A, Pm, yy, Wm, D, M) / (count * M)
end

----------------------------------------------------------------------------------
-- S4: federated messages and the merge ledger
----------------------------------------------------------------------------------

-- Everything that must agree before statistics can be merged: reservoir bytes, M,
-- the quantisation scale and the layout version.
function LiquidLearn.fingerprint(res: Reservoir, M: number): number
	local b = LiquidLearn.encodeReservoir(res)
	local h = 0x414C4E31
	for _, v in { 1, res.N, res.I, res.K, M, QSCALE } do
		h = MyMath.hash32(bit32.bxor(h, v))
	end
	for i = 0, buffer.len(b) - 1 do
		h = MyMath.hash32(bit32.bxor(h, buffer.readu8(b, i)))
	end
	return h
end

local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local B64CH: { string } = {}
local B64DEC: { [number]: number } = {}
for i = 1, 64 do
	B64CH[i] = string.sub(B64, i, i)
	B64DEC[string.byte(B64, i)] = i - 1
end

function LiquidLearn.base64(b: buffer, n: number?): string
	local len = n or buffer.len(b)
	local out = table.create((len + 2) // 3 * 4, "")
	local k = 0
	for i = 0, len - 1, 3 do
		local a0 = buffer.readu8(b, i)
		local a1 = if i + 1 < len then buffer.readu8(b, i + 1) else 0
		local a2 = if i + 2 < len then buffer.readu8(b, i + 2) else 0
		local v = a0 * 65536 + a1 * 256 + a2
		out[k + 1] = B64CH[v // 262144 + 1]
		out[k + 2] = B64CH[(v // 4096) % 64 + 1]
		out[k + 3] = if i + 1 < len then B64CH[(v // 64) % 64 + 1] else "="
		out[k + 4] = if i + 2 < len then B64CH[v % 64 + 1] else "="
		k += 4
	end
	return table.concat(out)
end

function LiquidLearn.unbase64(s: string): buffer
	local n = #s
	assert(n % 4 == 0, "bad base64 length")
	local pad = 0
	if n >= 1 and string.byte(s, n) == 61 then
		pad += 1
	end
	if n >= 2 and string.byte(s, n - 1) == 61 then
		pad += 1
	end
	local len = n // 4 * 3 - pad
	local out = buffer.create(math.max(len, 0))
	local o = 0
	for i = 1, n, 4 do
		local v = 0
		for j = 0, 3 do
			local c = string.byte(s, i + j)
			local d = if c == 61 then 0 else B64DEC[c]
			assert(d ~= nil, "bad base64 character")
			v = v * 64 + d
		end
		if o < len then
			buffer.writeu8(out, o, v // 65536)
		end
		if o + 1 < len then
			buffer.writeu8(out, o + 1, (v // 256) % 256)
		end
		if o + 2 < len then
			buffer.writeu8(out, o + 2, v % 256)
		end
		o += 3
	end
	return out
end

local function putVarint(b: buffer, o: number, v: number): number
	assert(v >= 0 and v == floor(v), "varint needs a non-negative integer")
	while v >= 128 do
		buffer.writeu8(b, o, v % 128 + 128)
		v = floor(v / 128)
		o += 1
	end
	buffer.writeu8(b, o, v)
	return o + 1
end

local function getVarint(b: buffer, o: number): (number, number)
	local v, mul = 0, 1
	for _ = 1, 8 do
		local c = buffer.readu8(b, o)
		o += 1
		v += (c % 128) * mul
		if c < 128 then
			return v, o
		end
		mul *= 128
	end
	error("varint too long")
end

local function varintLen(v: number): number
	local n = 1
	while v >= 128 do
		v = floor(v / 128)
		n += 1
	end
	return n
end

-- Packs cumulative statistics into base64 strings of at most 1000 characters (750 raw
-- bytes): "ALS", version u8, fingerprint u32, sender u32, sequence u32, chunk index
-- u8, chunk count u8, first entry u16, entry count u16, then varint(hi) varint(lo)
-- per entry. Entries are non-negative for Walsh reservoirs (q >= 0, targets >= 0).
function LiquidLearn.packMessages(st: Stats, fingerprint: number, sender: number, sequence: number): { string }
	local c = canonical(st)
	local starts, counts = {}, {}
	local e = 1
	while e <= c.E do
		local size = HEADER
		local first = e
		while e <= c.E do
			assert(c.hi[e] >= 0, "negative statistics cannot be packed")
			local add = varintLen(c.hi[e]) + varintLen(c.lo[e])
			if size + add > MAX_RAW_CHUNK then
				break
			end
			size += add
			e += 1
		end
		table.insert(starts, first)
		table.insert(counts, e - first)
	end
	local nchunks = #starts
	assert(nchunks <= 255, "too many chunks")
	local msgs = table.create(nchunks, "")
	local raw = buffer.create(MAX_RAW_CHUNK)
	for k = 1, nchunks do
		buffer.writeu8(raw, 0, 0x41)
		buffer.writeu8(raw, 1, 0x4C)
		buffer.writeu8(raw, 2, 0x53)
		buffer.writeu8(raw, 3, 1)
		buffer.writeu32(raw, 4, fingerprint)
		buffer.writeu32(raw, 8, sender)
		buffer.writeu32(raw, 12, sequence)
		buffer.writeu8(raw, 16, k - 1)
		buffer.writeu8(raw, 17, nchunks)
		buffer.writeu16(raw, 18, starts[k] - 1)
		buffer.writeu16(raw, 20, counts[k])
		local o = HEADER
		for j = starts[k], starts[k] + counts[k] - 1 do
			o = putVarint(raw, o, c.hi[j])
			o = putVarint(raw, o, c.lo[j])
		end
		msgs[k] = LiquidLearn.base64(raw, o)
	end
	return msgs
end

export type Chunk = {
	fingerprint: number,
	sender: number,
	sequence: number,
	index: number,
	count: number,
	first: number,
	n: number,
	hi: { number },
	lo: { number },
}

function LiquidLearn.unpackMessage(s: string): Chunk
	local raw = LiquidLearn.unbase64(s)
	assert(buffer.len(raw) >= HEADER, "short message")
	assert(buffer.readu8(raw, 0) == 0x41 and buffer.readu8(raw, 1) == 0x4C and buffer.readu8(raw, 2) == 0x53, "not an ALS message")
	assert(buffer.readu8(raw, 3) == 1, "unsupported ALS version")
	local ch: Chunk = {
		fingerprint = buffer.readu32(raw, 4),
		sender = buffer.readu32(raw, 8),
		sequence = buffer.readu32(raw, 12),
		index = buffer.readu8(raw, 16),
		count = buffer.readu8(raw, 17),
		first = buffer.readu16(raw, 18),
		n = buffer.readu16(raw, 20),
		hi = {},
		lo = {},
	}
	local o = HEADER
	for j = 1, ch.n do
		local h, l
		h, o = getVarint(raw, o)
		l, o = getVarint(raw, o)
		assert(l < TWO32, "non-canonical entry")
		ch.hi[j] = h
		ch.lo[j] = l
	end
	assert(o == buffer.len(raw), "trailing bytes")
	return ch
end

-- Ledger: a state-based CRDT (a G-Counter whose slots hold statistics). Each sender
-- owns one slot with its latest cumulative statistics, ordered by sequence number.
-- Merging keeps the higher sequence per sender: idempotent, commutative and
-- associative. The total is the exact integer sum of the slots, so servers that have
-- seen the same latest sequences solve the same readout bytes.
export type Slot = { sequence: number, stats: Stats }
export type Ledger = {
	fingerprint: number,
	D: number,
	M: number,
	slots: { [number]: Slot },
	pendingChunks: { [number]: { sequence: number, parts: { [number]: Chunk } } },
	base: Stats,
	folded: { [number]: number },
}

function LiquidLearn.newLedger(fingerprint: number, D: number, M: number): Ledger
	return {
		fingerprint = fingerprint,
		D = D,
		M = M,
		slots = {},
		pendingChunks = {},
		base = LiquidLearn.newStats(D, M),
		folded = {},
	}
end

-- Records a sender's cumulative statistics. Returns true if the ledger changed.
function LiquidLearn.observe(led: Ledger, sender: number, sequence: number, st: Stats): boolean
	if led.folded[sender] ~= nil then
		return false
	end
	local cur = led.slots[sender]
	if cur ~= nil and cur.sequence >= sequence then
		return false
	end
	local c = LiquidLearn.copyStats(st)
	normalise(c)
	led.slots[sender] = { sequence = sequence, stats = c }
	return true
end

-- Feeds one message. Chunks are buffered per sender until the newest sequence is
-- complete; duplicates and reordering are harmless, older sequences are dropped.
-- Returns true when a complete contribution changed the ledger.
function LiquidLearn.receive(led: Ledger, msg: string): boolean
	local ok, res = pcall(LiquidLearn.unpackMessage, msg)
	if not ok then
		return false
	end
	local ch = res :: Chunk
	if ch.fingerprint ~= led.fingerprint or led.folded[ch.sender] ~= nil then
		return false
	end
	local cur = led.slots[ch.sender]
	if cur ~= nil and cur.sequence >= ch.sequence then
		return false
	end
	local pend = led.pendingChunks[ch.sender]
	if pend == nil or pend.sequence < ch.sequence then
		pend = { sequence = ch.sequence, parts = {} }
		led.pendingChunks[ch.sender] = pend
	elseif pend.sequence > ch.sequence then
		return false
	end
	local p = pend :: { sequence: number, parts: { [number]: Chunk } }
	p.parts[ch.index] = ch
	local filled = 0
	for k = 0, ch.count - 1 do
		local part = p.parts[k]
		if part == nil then
			return false
		end
		filled += part.n
	end
	local st = LiquidLearn.newStats(led.D, led.M)
	if filled ~= st.E then
		return false
	end
	for k = 0, ch.count - 1 do
		local part = p.parts[k]
		for j = 1, part.n do
			st.hi[part.first + j] = part.hi[j]
			st.lo[part.first + j] = part.lo[j]
		end
	end
	led.pendingChunks[ch.sender] = nil
	return LiquidLearn.observe(led, ch.sender, ch.sequence, st)
end

-- Exact total of the ledger (base plus every slot), independent of iteration order.
function LiquidLearn.total(led: Ledger): Stats
	local t = LiquidLearn.copyStats(led.base)
	for _, slot in led.slots do
		LiquidLearn.addStats(t, slot.stats)
	end
	normalise(t)
	return t
end

-- Folds a finished sender into the base, keeping only its final sequence number.
function LiquidLearn.fold(led: Ledger, sender: number)
	local slot = led.slots[sender]
	if slot == nil then
		return
	end
	LiquidLearn.addStats(led.base, slot.stats)
	led.folded[sender] = slot.sequence
	led.slots[sender] = nil
end

-- DataStore value for statistics: newline-separated messages (sender 0, sequence 0).
function LiquidLearn.serializeStats(st: Stats, fingerprint: number): string
	return table.concat(LiquidLearn.packMessages(st, fingerprint, 0, 0), "\n")
end

function LiquidLearn.deserializeStats(s: string, D: number, M: number): (Stats, number)
	local st = LiquidLearn.newStats(D, M)
	local fp = 0
	local filled = 0
	for line in string.gmatch(s, "[^\n]+") do
		local ch = LiquidLearn.unpackMessage(line)
		fp = ch.fingerprint
		for j = 1, ch.n do
			st.hi[ch.first + j] = ch.hi[j]
			st.lo[ch.first + j] = ch.lo[j]
		end
		filled += ch.n
	end
	assert(filled == st.E, "incomplete statistics")
	return st, fp
end

----------------------------------------------------------------------------------
-- S5: gain search on exact sub-Grams of one superset accumulation
----------------------------------------------------------------------------------

export type GainSearchOptions = {
	candidates: { number }?, -- kBase values tried for every neuron
	validationEvery: number?, -- tree rows y with y % v == v - 1 validate; others train
	sweeps: number?,
	lambda: number?,
	event: boolean?, -- event-mode accumulation (default true)
	targetStride: number?,
}

export type GainSearchResult = {
	kBase: { number },
	trainMSE: number,
	validationMSE: number,
	startValidationMSE: number,
	trials: number,
	superD: number,
	accumulateSeconds: number,
	searchSeconds: number,
}

local function subMatrices(A: { { number } }, Pm: { { number } }, map: { number }, M: number): ({ { number } }, { { number } })
	local D = #map
	local As: { { number } } = {}
	local Ps: { { number } } = {}
	for a = 1, D do
		local ra = A[map[a]]
		local row = table.create(D, 0)
		for b = 1, D do
			row[b] = ra[map[b]]
		end
		As[a] = row
		Ps[a] = table.clone(Pm[map[a]])
	end
	return As, Ps
end

-- Train and validation statistics of a reservoir: tree rows with y % every ==
-- every - 1 go to validation.
function LiquidLearn.accumulateSplit(res: Reservoir, tree: Tree, target: buffer, M: number, every: number, o: AccumOptions): (Stats, Stats)
	local D = 2 * res.N + 1
	local tr, va = LiquidLearn.newStats(D, M), LiquidLearn.newStats(D, M)
	local rows = LiquidLearn.newRows(res, tree, 0)
	local y = 0
	while y < tree.height do
		LiquidLearn.rowSegments(rows, y)
		LiquidLearn.simulateQ(rows)
		local band = rows.groupEnd
		-- rows of the band share features; split them by the validation rule
		local yy = y
		while yy < band do
			local isVal = yy % every == every - 1
			local ye = yy + 1
			while ye < band and ((ye % every == every - 1) == isVal) do
				ye += 1
			end
			LiquidLearn.accumulateRange(if isVal then va else tr, rows, target, yy, ye, 0, rows.W, o)
			yy = ye
		end
		y = band
	end
	return tr, va
end

-- Exact sub-statistics: features map[1..d] of a superset (map[d] must be the constant
-- feature). The integers are copied, so solving them gives the bytes a direct
-- accumulation of that configuration gives.
function LiquidLearn.extractStats(st: Stats, map: { number }): Stats
	local d, M, D = #map, st.M, st.D
	local c = canonical(st)
	local out = LiquidLearn.newStats(d, M)
	local offS, offD = triOffsets(D), triOffsets(d)
	for a = 1, d do
		for b = a, d do
			local i, j = map[a], map[b]
			if i > j then
				i, j = j, i
			end
			local src = offS[i] + (j - i) + 1
			local dst = offD[a] + (b - a) + 1
			out.hi[dst], out.lo[dst] = c.hi[src], c.lo[src]
		end
	end
	local TS, TD = D * (D + 1) // 2, d * (d + 1) // 2
	for a = 1, d do
		for m = 1, M do
			local src = TS + (map[a] - 1) * M + m
			local dst = TD + (a - 1) * M + m
			out.hi[dst], out.lo[dst] = c.hi[src], c.lo[src]
		end
	end
	for m = 1, M + 1 do
		out.hi[TD + d * M + m], out.lo[TD + d * M + m] = c.hi[TS + D * M + m], c.lo[TS + D * M + m]
	end
	return out
end

-- Feature map of a configuration inside a superset reservoir: for neuron i of the
-- configuration, superIndex[i] is its neuron in the superset (S neurons).
function LiquidLearn.superMap(superIndex: { number }, S: number): { number }
	local N = #superIndex
	local map = table.create(2 * N + 1, 0)
	for i = 1, N do
		map[i] = superIndex[i]
		map[N + i] = S + superIndex[i]
	end
	map[2 * N + 1] = 2 * S + 1
	return map
end

-- Coordinate descent over kBase (S5) on one superset accumulation. The superset
-- reservoir holds every (projection, candidate kBase) pair; neurons are uncoupled,
-- so the sub-Gram of a configuration is exactly the Gram a direct accumulation of
-- that configuration would produce, and each trial is a sub-matrix copy, a D x D
-- Cholesky solve on training rows and a validation score from statistics.
function LiquidLearn.gainSearch(base: Reservoir, tree: Tree, target: buffer, M: number, opts: GainSearchOptions?): GainSearchResult
	local o: GainSearchOptions = opts or {}
	local cands = o.candidates or { -64, -4, -3, -2, -1, 0, 1, 2, 3, 4 }
	local every = o.validationEvery or 4
	local lam = o.lambda or LiquidLearn.DEFAULT_LAMBDA
	local N, I = base.N, base.I
	local proj = LiquidLearn.walshProjections(base)
	local sp, sk = {}, {}
	local index: { [string]: number } = {}
	local function want(p: number, k: number)
		local key = p .. ":" .. k
		if index[key] == nil then
			table.insert(sp, p)
			table.insert(sk, k)
			index[key] = #sp
		end
	end
	for i = 1, N do
		want(proj[i], base.kBase[i])
		for _, k in cands do
			want(proj[i], k)
		end
	end
	local S = #sp
	local sup = LiquidLearn.walshReservoir(S, I, base.K, sk, nil, sp)
	local t0 = os.clock()
	local acc: AccumOptions = { event = o.event ~= false, targetStride = o.targetStride }
	local trS, vaS = LiquidLearn.accumulateSplit(sup, tree, target, M, every, acc)
	local t1 = os.clock()
	local DS = 2 * S + 1
	local At, Pt = LiquidLearn.statsMatrices(trS)
	local Av, Pv = LiquidLearn.statsMatrices(vaS)
	local yyv, cntv = LiquidLearn.statsYY(vaS)
	local yyt, cntt = LiquidLearn.statsYY(trS)
	local cur = table.clone(base.kBase)
	local trials = 0
	local function score(kb: { number }): (number, number)
		trials += 1
		local map = table.create(2 * N + 1, 0)
		for i = 1, N do
			local s = index[proj[i] .. ":" .. kb[i]]
			map[i] = s
			map[N + i] = S + s
		end
		map[2 * N + 1] = DS
		local As, Ps = subMatrices(At, Pt, map, M)
		local work: { { number } } = {}
		for a = 1, #map do
			work[a] = table.clone(As[a])
		end
		local Wm = choleskySolve(work, Ps, #map, M, lam)
		if Wm == nil then
			return math.huge, math.huge
		end
		local Av2, Pv2 = subMatrices(Av, Pv, map, M)
		local w = Wm :: { { number } }
		return sseFrom(Av2, Pv2, yyv, w, #map, M) / (cntv * M), sseFrom(As, Ps, yyt, w, #map, M) / (cntt * M)
	end
	local bestV, bestT = score(cur)
	local startV = bestV
	for _ = 1, o.sweeps or 3 do
		local improved = false
		for i = 1, N do
			for _, k in cands do
				if k ~= cur[i] then
					local clash = false
					for j = 1, N do
						if j ~= i and proj[j] == proj[i] and cur[j] == k then
							clash = true
							break
						end
					end
					if not clash then
						local old = cur[i]
						cur[i] = k
						local v, t = score(cur)
						if v < bestV then
							bestV, bestT = v, t
							improved = true
						else
							cur[i] = old
						end
					end
				end
			end
		end
		if not improved then
			break
		end
	end
	return {
		kBase = cur,
		trainMSE = bestT,
		validationMSE = bestV,
		startValidationMSE = startV,
		trials = trials,
		superD = DS,
		accumulateSeconds = t1 - t0,
		searchSeconds = os.clock() - t1,
	}
end

----------------------------------------------------------------------------------
-- time-sliced trainer (S2 on Heartbeat)
----------------------------------------------------------------------------------

export type Trainer = {
	stats: Stats,
	rows: Rows,
	target: buffer,
	opts: AccumOptions,
	y: number, -- tree row of the current band
	phase: number, -- 0 segments, 1 states, 2 reset, 3 targets, 4 terms, 5 Gram
	neuron: number, -- next neuron (states phase)
	subStart: number, -- first render row of the current sub-band
	bandEndR: number, -- render row after the band
	yr: number, -- next render row of the sub-band (targets phase)
	yrEnd: number, -- render row after the sub-band (at most 2^22 samples per sub-band)
	x: number, -- next column (terms phase)
	k: number, -- next term (Gram phase)
	neuronChunk: number, -- neurons per states unit
	rowChunk: number, -- render rows per targets unit
	xChunk: number, -- columns per terms unit
	kChunk: number, -- terms per Gram unit
	done: boolean,
	clock: () -> number,
	slices: number,
	units: number,
}

function LiquidLearn.newTrainer(res: Reservoir, tree: Tree, target: buffer, M: number, opts: AccumOptions?, r: number?, clock: (() -> number)?): Trainer
	return {
		stats = LiquidLearn.newStats(2 * res.N + 1, M),
		rows = LiquidLearn.newRows(res, tree, r),
		target = target,
		opts = opts or {},
		y = 0,
		phase = 0,
		neuron = 1,
		subStart = 0,
		bandEndR = 0,
		yr = 0,
		yrEnd = 0,
		x = 0,
		k = 1,
		neuronChunk = 2,
		rowChunk = 4,
		xChunk = 256,
		kChunk = 32,
		done = false,
		clock = clock or os.clock,
		slices = 0,
		units = 0,
	}
end

-- Runs bounded units of work until `budget` seconds have elapsed: a band's segments,
-- the states of neuronChunk neurons, clearing the band accumulators, rowChunk render
-- rows of targets, xChunk columns of the term list, or kChunk terms of Gram products. A slice
-- overshoots the budget by at most one unit. The final statistics equal
-- accumulate() bit for bit (integer sums do not depend on how work is cut).
function LiquidLearn.step(tr: Trainer, budget: number): boolean
	if tr.done then
		return true
	end
	tr.slices += 1
	local t0 = tr.clock()
	local rows = tr.rows
	local tree = rows.tree
	local st = tr.stats
	local rep = bit32.lshift(1, rows.r)
	while true do
		local phase = tr.phase
		if phase == 0 then
			if tr.y >= tree.height then
				tr.done = true
				return true
			end
			LiquidLearn.rowSegments(rows, tr.y)
			tr.neuron = 1
			tr.phase = 1
		elseif phase == 1 then
			local i1 = math.min(tr.neuron + tr.neuronChunk - 1, rows.N)
			LiquidLearn.simulateQ(rows, tr.neuron, i1)
			tr.neuron = i1 + 1
			if i1 >= rows.N then
				tr.subStart = tr.y * rep
				tr.bandEndR = rows.groupEnd * rep
				tr.phase = 2
			end
		elseif phase == 2 then
			LiquidLearn.bandReset(rows, st.M)
			tr.yr = tr.subStart
			tr.yrEnd = math.min(tr.bandEndR, tr.subStart + math.max(1, weightLimit() // rows.W))
			tr.phase = 3
		elseif phase == 3 then
			local ye = math.min(tr.yr + tr.rowChunk, tr.yrEnd)
			LiquidLearn.bandTargets(st, rows, tr.target, tr.yr, ye, 0, rows.W, tr.opts)
			tr.yr = ye
			if ye >= tr.yrEnd then
				tr.phase = 4
			end
		elseif phase == 4 then
			if tr.x == 0 and not tr.opts.event and LiquidLearn.bandAllSampled(rows) then
				LiquidLearn.bandTermsIdentity(rows)
				tr.x = rows.W
			else
				local xe = math.min(tr.x + tr.xChunk, rows.W)
				LiquidLearn.bandTerms(rows, st.M, tr.opts, tr.x, xe)
				tr.x = xe
			end
			if tr.x >= rows.W then
				tr.x = 0
				tr.k = 1
				tr.phase = 5
			end
		else
			local K = rows.termK
			local ke = math.min(tr.k + tr.kChunk, K + 1)
			LiquidLearn.bandGram(st, rows, tr.k, ke)
			tr.k = ke
			if ke > K then
				if tr.yrEnd < tr.bandEndR then
					tr.subStart = tr.yrEnd -- next sub-band of the same band (states reused)
					tr.phase = 2
				else
					tr.y = rows.groupEnd
					tr.phase = 0
				end
			end
		end
		tr.units += 1
		if tr.clock() - t0 >= budget then
			return false
		end
	end
end

return LiquidLearn
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">LiquidMatte</string>
          <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: LiquidMatte (ALLAN application: liquid background removal)
--
-- docs/LIQUID.md section 8 ("Liquid matte") and "Applications results" hold the proofs and
-- measurements. This header is the single source of truth for the arithmetic: the
-- event-driven path and LiquidMatte.refineReference (the per-pixel definition) produce the
-- same bits, and so must any port.
--
-- IMAGES are row-major straight-alpha RGBA8 (the EditableImage layout): a pixel read with
-- readu32 is r + g*256 + b*65536 + a*16777216.
--
-- 1. COLOUR METRIC (integers, exact). For a pixel minus the key, dr, dg, db in [-255, 255]:
--      dy  =  77 dr + 150 dg +  29 db           luma x 256       (77 + 150 + 29 = 256)
--      dcb = -43 dr -  85 dg + 128 db           chroma x 256     (row sums 0: greys have no
--      dcr = 128 dr - 107 dg -  21 db           chroma x 256      chroma)
--      d2  = 4 (dcb^2 + dcr^2) + wy dy^2        integer below 2^39 (wy in 0..64, default 1)
--      Dq  = floor(sqrt(d2) / 64)               u16, 8 units per byte of chroma distance
--    wy = 1 weighs luma half as much as chroma (in distance), so shading of the screen moves
--    Dq less than a change of hue; white, grey and black keys still work through luma.
--    sqrt is IEEE correctly rounded and /64 is exact, so Dq is the same on every device.
--
-- 2. KEY (detectKey). The border is walked as a closed loop (top row left to right, right
--    column down, bottom row right to left, left column up). Its colours go into a 4096-bin
--    histogram (4 bits per channel); the mode bin (lowest index on ties) seeds a mean shift:
--    key = round(mean of loop pixels within Dq <= 192 of the key), four times. Loop pixels
--    within Dq <= 384 are background samples; noiseD and noiseStep are the 99.9 % quantiles
--    of their Dq and of |Dq step| between consecutive samples.
--
-- 3. PARAMETERS (params, all in Dq units, each overridable):
--      t0  = max(16, ceil(5 noiseD / 4) + 8)    background ceiling
--      tau = max(24, noiseStep + 8, 3 t0 / 2)   edge step: a neighbour step >= tau is hard
--      t1  = max(4 t0, t0 + 64)                 ratio floor (mode "ratio"), ramp top ("ramp")
--      radius 2, kMax 3, clip 3.
--
-- 4. RAW MATTE u (bytes). Mode "ratio" (default), with W(p) the (2 radius + 1)^2 window:
--      Dq(p) <= t0                          -> 0                (background)
--      no q in W(p) with Dq(q) <= t0        -> 255              (interior)
--      otherwise (edge band)                -> floor(255 * (Dq / F) * min(1, (Dq - t0) / t0) + 0.5)
--                                              F = max(t1, max of Dq over W(p))
--    For an anti-aliased pixel C = c F + (1 - c) K the metric is a norm, so Dq(C) = c Dq(F)
--    and the ratio recovers the coverage c whatever the foreground colour (local unmixing).
--    Mode "ramp": u = clamp(floor(255 (Dq - t0) / (t1 - t0) + 0.5), 0, 255).
--    Then clip: u <= clip -> 0, u >= 255 - clip -> 255.
--
-- 5. FLOOD (optional). Passable pixels have u < 255. Passable pixels not 4-connected to the
--    border through passable pixels are protected: u := 255, and despill skips them.
--
-- 6. LIQUID REFINEMENT (refine). Gain of a neighbour pair with step s = |Dq(p) - Dq(q)|:
--      g(s) = 1 if s >= tau, else 2^-k, k = ceil(kMax (tau - s) / tau)   (exact powers of 2)
--    One pass over a line with input v_x (bytes) and pair steps s_x between x and the pixel
--    before it in the pass direction:
--      h_0 = v_0;   h_x = v_x if s_x >= tau, else h_{x-1} + (v_x - h_{x-1}) * g(s_x),
--      then if |v_x - h_x| < 1/64: h_x = v_x                            (snap)
--    Horizontal stage: passes left to right (hL) and right to left (hR) on u,
--      H = clip(floor((hL + hR) * 0.5 + 0.5)).
--    Vertical stage: passes top to bottom (hU) and bottom to top (hD) on H,
--      A = clip(floor((hU + hD) * 0.5 + 0.5)).
--    The event-driven path skips pixels whose state already equals their input (the step is
--    then the identity), four bytes at a time, so its cost follows the transients only.
--
-- 7. COMPOSE. a = A (times the source alpha, rounded, if the source is not opaque).
--      a = 255: the source pixel; a = 0: transparent, colour from step 8;
--      0 < a < 255: unmixed colour F = clamp(round((255 C - (255 - a) K) / a)), the exact
--      inverse of C = (a F + (255 - a) K) / 255 (despill), or C itself with despill off.
--    Optional spill limiter of strength s in [0, 1] on unprotected visible pixels: with
--    p = (cb kcb + cr kcr) / (kcb^2 + kcr^2) the key-ward share of the pixel's chroma,
--    C' = C - s max(p, 0) (K - Y_K), which keeps luma and removes s of the key hue.
-- 8. BLEED. Every transparent pixel takes the RGB of the nearest visible pixel in its row
--    (ties to the left), alpha 0; rows without a visible pixel copy the nearest such row
--    (ties upward). Bilinear filtering and mips then never pull in the key colour.
--
-- Deterministic ops only (docs/RUNTIME_AUDIT.md 6.5): + - * / sqrt, math.floor on
-- fractions, integer // and %, comparisons, integer buffer ops and f64 buffer storage.

local MyMath = require("./MyMath")
local Pixels = require("./Pixels")

local LiquidMatte = {}

local floor = math.floor
local sqrt = math.sqrt
local fillSpan = Pixels.fillSpan
local hash32 = MyMath.hash32

local SNAP = 1 / 64
local WORD1 = 0x01010101

export type Key = {
	color: number, -- packed RGB with alpha 255
	r: number,
	g: number,
	b: number,
	wy: number,
	noiseD: number, -- Dq units
	noiseStep: number, -- Dq units
	samples: number, -- background samples on the border loop
	share: number, -- samples / loop length
}

export type Options = {
	key: number?, -- packed colour; default: detected from the border
	wy: number?, -- luma weight 0..64 (default 1)
	t0: number?,
	t1: number?,
	tau: number?,
	kMax: number?,
	radius: number?,
	clip: number?,
	mode: string?, -- "ratio" (default) or "ramp"
	flood: boolean?, -- protect key-coloured regions not connected to the border
	refine: boolean?, -- liquid refinement (default true)
	despill: boolean?, -- unmix partial pixels (default true)
	spill: number?, -- spill limiter strength 0..1 (default 0)
	bleed: boolean?, -- alpha bleeding (default true)
}

export type Params = {
	key: Key,
	t0: number,
	t1: number,
	tau: number,
	kMax: number,
	radius: number,
	clip: number,
	mode: string,
	flood: boolean,
	refine: boolean,
	despill: boolean,
	spill: number,
	bleed: boolean,
}

export type Field = {
	dq: buffer, -- u16 per pixel
	runA: { number }, -- background runs (Dq <= t0), flat, row by row
	runB: { number },
	rowRun: { number }, -- [y + 1] = first run index of row y; [h + 1] = runs + 1
	opaque: boolean, -- every source alpha is 255
	distinct: number, -- pixels whose colour differed from the previous pixel (Dq computed)
}

export type Info = {
	key: Key,
	params: Params,
	edgeBand: number, -- pixels evaluated by the ratio rule
	protected: number, -- pixels protected by the flood
	transients: number, -- refinement steps that left the state off its input
	partial: number, -- output pixels with 0 < alpha < 255
	distinct: number,
}

----------------------------------------------------------------------------------------
-- 1. metric
----------------------------------------------------------------------------------------

-- Dq of a packed colour against a key (integers in, integer out).
local function dqOf(p: number, kr: number, kg: number, kb: number, wy: number): number
	local dr = p % 256 - kr
	local dg = (p // 256) % 256 - kg
	local db = (p // 65536) % 256 - kb
	local dy = 77 * dr + 150 * dg + 29 * db
	local dcb = 128 * db - 43 * dr - 85 * dg
	local dcr = 128 * dr - 107 * dg - 21 * db
	return floor(sqrt(4 * (dcb * dcb + dcr * dcr) + wy * dy * dy) * 0.015625)
end
LiquidMatte.dqOf = dqOf

----------------------------------------------------------------------------------------
-- 2. key detection
----------------------------------------------------------------------------------------

local function quantile(list: { number }, num: number, den: number): number
	local n = #list
	if n == 0 then
		return 0
	end
	table.sort(list)
	local i = (n * num) // den + 1
	if i > n then
		i = n
	end
	return list[i]
end

local function borderLoop(img: buffer, w: number, h: number): { number }
	local loop = {}
	local function push(x: number, y: number)
		table.insert(loop, buffer.readu32(img, (y * w + x) * 4))
	end
	if h == 1 then
		for x = 0, w - 1 do
			push(x, 0)
		end
		return loop
	end
	if w == 1 then
		for y = 0, h - 1 do
			push(0, y)
		end
		return loop
	end
	for x = 0, w - 1 do
		push(x, 0)
	end
	for y = 1, h - 2 do
		push(w - 1, y)
	end
	for x = w - 1, 0, -1 do
		push(x, h - 1)
	end
	for y = h - 2, 1, -1 do
		push(0, y)
	end
	return loop
end

function LiquidMatte.detectKey(img: buffer, w: number, h: number, wy: number?, given: number?): Key
	local wyv = wy or 1
	assert(wyv >= 0 and wyv <= 64 and wyv == floor(wyv), "wy must be an integer in 0..64")
	local loop = borderLoop(img, w, h)
	local n = #loop
	local kr, kg, kb
	if given then
		kr, kg, kb = given % 256, (given // 256) % 256, (given // 65536) % 256
	else
		local hist = buffer.create(4096 * 4)
		for i = 1, n do
			local p = loop[i]
			local bin = ((p % 256) // 16) * 256 + (((p // 256) % 256) // 16) * 16 + ((p // 65536) % 256) // 16
			buffer.writeu32(hist, bin * 4, buffer.readu32(hist, bin * 4) + 1)
		end
		local best, bestCount = 0, -1
		for bin = 0, 4095 do
			local c = buffer.readu32(hist, bin * 4)
			if c > bestCount then
				best, bestCount = bin, c
			end
		end
		local sr, sg, sb = 0, 0, 0
		for i = 1, n do
			local p = loop[i]
			local bin = ((p % 256) // 16) * 256 + (((p // 256) % 256) // 16) * 16 + ((p // 65536) % 256) // 16
			if bin == best then
				sr += p % 256
				sg += (p // 256) % 256
				sb += (p // 65536) % 256
			end
		end
		kr = floor(sr / bestCount + 0.5)
		kg = floor(sg / bestCount + 0.5)
		kb = floor(sb / bestCount + 0.5)
		for _ = 1, 4 do
			local cr, cg, cb, c = 0, 0, 0, 0
			for i = 1, n do
				local p = loop[i]
				if dqOf(p, kr, kg, kb, wyv) <= 192 then
					cr += p % 256
					cg += (p // 256) % 256
					cb += (p // 65536) % 256
					c += 1
				end
			end
			if c == 0 then
				break
			end
			local nr, ng, nb = floor(cr / c + 0.5), floor(cg / c + 0.5), floor(cb / c + 0.5)
			if nr == kr and ng == kg and nb == kb then
				break
			end
			kr, kg, kb = nr, ng, nb
		end
	end
	local ds: { number } = {}
	local steps: { number } = {}
	local samples = 0
	local prevD = -1
	local firstD = -1
	for i = 1, n do
		local d = dqOf(loop[i], kr, kg, kb, wyv)
		if d <= 384 then
			samples += 1
			table.insert(ds, d)
			if prevD >= 0 then
				table.insert(steps, math.abs(d - prevD))
			end
			if i == 1 then
				firstD = d
			end
			prevD = d
		else
			prevD = -1
		end
	end
	if prevD >= 0 and firstD >= 0 and n > 2 then
		table.insert(steps, math.abs(firstD - prevD)) -- the loop closes
	end
	return {
		color = kr + kg * 256 + kb * 65536 + 255 * 16777216,
		r = kr,
		g = kg,
		b = kb,
		wy = wyv,
		noiseD = quantile(ds, 999, 1000),
		noiseStep = quantile(steps, 999, 1000),
		samples = samples,
		share = if n > 0 then samples / n else 0,
	}
end

----------------------------------------------------------------------------------------
-- 3. parameters
----------------------------------------------------------------------------------------

function LiquidMatte.params(key: Key, opts: Options?): Params
	local o: Options = opts or {}
	local t0 = o.t0 or math.max(16, (5 * key.noiseD + 3) // 4 + 8)
	local tau = o.tau or math.max(24, key.noiseStep + 8, (3 * t0) // 2)
	local t1 = o.t1 or math.max(4 * t0, t0 + 64)
	local mode = o.mode or "ratio"
	assert(mode == "ratio" or mode == "ramp", "mode must be ratio or ramp")
	assert(t1 > t0 and tau >= 1, "need t1 > t0 and tau >= 1")
	local kMax = o.kMax or 3
	assert(kMax >= 0 and kMax <= 30, "kMax in 0..30")
	return {
		key = key,
		t0 = t0,
		t1 = t1,
		tau = tau,
		kMax = kMax,
		radius = o.radius or 2,
		clip = o.clip or 3,
		mode = mode,
		flood = o.flood == true,
		refine = o.refine ~= false,
		despill = o.despill ~= false,
		spill = o.spill or 0,
		bleed = o.bleed ~= false,
	}
end

----------------------------------------------------------------------------------------
-- 4. distance field (fused with the background runs)
----------------------------------------------------------------------------------------

function LiquidMatte.distanceField(img: buffer, w: number, h: number, key: Key, t0: number, dqBuf: buffer?): Field
	local dq = dqBuf or buffer.create(w * h * 2)
	local kr, kg, kb, wy = key.r, key.g, key.b, key.wy
	local readu32 = buffer.readu32
	local writeu16 = buffer.writeu16
	local runA: { number } = {}
	local runB: { number } = {}
	local rowRun: { number } = table.create(h + 1, 0)
	local nRuns = 0
	local opaque = true
	local distinct = 0
	for y = 0, h - 1 do
		rowRun[y + 1] = nRuns + 1
		local inRun = false
		local prev = -1
		local d = 0
		local o = y * w * 4
		local o2 = y * w * 2
		for x = 0, w - 1 do
			local p = readu32(img, o)
			if p ~= prev then
				prev = p
				distinct += 1
				if p < 4278190080 then
					opaque = false
				end
				local dr = p % 256 - kr
				local dg = (p // 256) % 256 - kg
				local db = (p // 65536) % 256 - kb
				local dy = 77 * dr + 150 * dg + 29 * db
				local dcb = 128 * db - 43 * dr - 85 * dg
				local dcr = 128 * dr - 107 * dg - 21 * db
				d = floor(sqrt(4 * (dcb * dcb + dcr * dcr) + wy * dy * dy) * 0.015625)
			end
			writeu16(dq, o2, d)
			if d <= t0 then
				if not inRun then
					nRuns += 1
					runA[nRuns] = x
					inRun = true
				end
			elseif inRun then
				runB[nRuns] = x - 1
				inRun = false
			end
			o += 4
			o2 += 2
		end
		if inRun then
			runB[nRuns] = w - 1
		end
	end
	rowRun[h + 1] = nRuns + 1
	return { dq = dq, runA = runA, runB = runB, rowRun = rowRun, opaque = opaque, distinct = distinct }
end

----------------------------------------------------------------------------------------
-- 5. raw matte
----------------------------------------------------------------------------------------

local function clipByte(v: number, clip: number): number
	if v <= clip then
		return 0
	elseif v >= 255 - clip then
		return 255
	end
	return v
end

-- Ratio value of one edge-band pixel (header rule 4), before clipping.
local function ratioValue(dq: buffer, w: number, h: number, x: number, y: number, radius: number, t0: number, t1: number): number
	local d = buffer.readu16(dq, (y * w + x) * 2)
	local x0, x1 = math.max(0, x - radius), math.min(w - 1, x + radius)
	local y0, y1 = math.max(0, y - radius), math.min(h - 1, y + radius)
	local mx = t1
	for yy = y0, y1 do
		local base = yy * w
		for xx = x0, x1 do
			local q = buffer.readu16(dq, (base + xx) * 2)
			if q > mx then
				mx = q
			end
		end
	end
	local ramp = (d - t0) / t0
	if ramp > 1 then
		ramp = 1
	end
	return floor(255 * (d / mx) * ramp + 0.5)
end

-- Merges sorted, possibly overlapping closed intervals (flat pairs) into `out`.
local function mergeIntervals(src: { number }, n: number, out: { number }): number
	-- insertion sort by start (lists are short: a few runs per row)
	for i = 3, n * 2 - 1, 2 do
		local a, b = src[i], src[i + 1]
		local j = i - 2
		while j >= 1 and src[j] > a do
			src[j + 2], src[j + 3] = src[j], src[j + 1]
			j -= 2
		end
		src[j + 2], src[j + 3] = a, b
	end
	local m = 0
	for i = 1, n * 2 - 1, 2 do
		local a, b = src[i], src[i + 1]
		if m > 0 and a <= out[m * 2] + 1 then
			if b > out[m * 2] then
				out[m * 2] = b
			end
		else
			m += 1
			out[m * 2 - 1] = a
			out[m * 2] = b
		end
	end
	return m
end

-- Raw matte u (bytes) from the distance field; returns u and the edge-band pixel count.
function LiquidMatte.rawMatte(field: Field, w: number, h: number, P: Params, uBuf: buffer?): (buffer, number)
	local u = uBuf or buffer.create(w * h)
	local dq = field.dq
	local t0, t1, clip = P.t0, P.t1, P.clip
	local band = 0
	if P.mode == "ramp" then
		local span = t1 - t0
		for i = 0, w * h - 1 do
			local d = buffer.readu16(dq, i * 2)
			local v
			if d <= t0 then
				v = 0
			elseif d >= t1 then
				v = 255
			else
				v = clipByte(floor(255 * (d - t0) / span + 0.5), clip)
			end
			buffer.writeu8(u, i, v)
		end
		return u, 0
	end
	local r = P.radius
	local runA, runB, rowRun = field.runA, field.runB, field.rowRun
	local scratch: { number } = {}
	local merged: { number } = {}
	for y = 0, h - 1 do
		local base = y * w
		buffer.fill(u, base, 255, w)
		-- background runs of this row -> 0
		for k = rowRun[y + 1], rowRun[y + 2] - 1 do
			buffer.fill(u, base + runA[k], 0, runB[k] - runA[k] + 1)
		end
		-- union of the background runs of rows y - r .. y + r, dilated by r
		local n = 0
		for yy = math.max(0, y - r), math.min(h - 1, y + r) do
			for k = rowRun[yy + 1], rowRun[yy + 2] - 1 do
				n += 1
				scratch[n * 2 - 1] = math.max(0, runA[k] - r)
				scratch[n * 2] = math.min(w - 1, runB[k] + r)
			end
		end
		if n > 0 then
			local m = mergeIntervals(scratch, n, merged)
			for j = 1, m do
				for x = merged[j * 2 - 1], merged[j * 2] do
					if buffer.readu16(dq, (base + x) * 2) > t0 then
						band += 1
						buffer.writeu8(u, base + x, clipByte(ratioValue(dq, w, h, x, y, r, t0, t1), clip))
					end
				end
			end
		end
	end
	return u, band
end

----------------------------------------------------------------------------------------
-- 6. flood from the border (4-connected, run based)
----------------------------------------------------------------------------------------

-- Sets u := 255 on passable pixels (u < 255) that the border cannot reach through
-- passable pixels, and marks them in the returned mask (1 = protected). Cost follows the
-- number of passable runs, not pixels.
function LiquidMatte.floodProtect(u: buffer, w: number, h: number): (buffer, number)
	local readu8 = buffer.readu8
	local readu32 = buffer.readu32
	local RA: { number } = {}
	local RB: { number } = {}
	local rowStart: { number } = table.create(h + 1, 0)
	local n = 0
	for y = 0, h - 1 do
		rowStart[y + 1] = n + 1
		local base = y * w
		local x = 0
		while x < w do
			-- skip opaque pixels, four at a time
			while x + 3 < w and readu32(u, base + x) == 0xFFFFFFFF do
				x += 4
			end
			while x < w and readu8(u, base + x) == 255 do
				x += 1
			end
			if x >= w then
				break
			end
			local a = x
			while true do
				while x + 3 < w and readu32(u, base + x) == 0 do
					x += 4
				end
				if x < w and readu8(u, base + x) < 255 then
					x += 1
				else
					break
				end
			end
			n += 1
			RA[n] = a
			RB[n] = x - 1
		end
	end
	rowStart[h + 1] = n + 1
	local seen = buffer.create(n + 1)
	local stack: { number } = {}
	local top = 0
	local function visit(k: number)
		if buffer.readu8(seen, k) == 0 then
			buffer.writeu8(seen, k, 1)
			top += 1
			stack[top] = k
		end
	end
	for y = 0, h - 1 do
		for k = rowStart[y + 1], rowStart[y + 2] - 1 do
			if y == 0 or y == h - 1 or RA[k] == 0 or RB[k] == w - 1 then
				visit(k)
			end
		end
	end
	-- row of each run (runs are stored row by row)
	local rowOf = table.create(n, 0)
	for y = 0, h - 1 do
		for k = rowStart[y + 1], rowStart[y + 2] - 1 do
			rowOf[k] = y
		end
	end
	while top > 0 do
		local k = stack[top]
		top -= 1
		local y = rowOf[k]
		local a, b = RA[k], RB[k]
		for dy = -1, 1, 2 do
			local yy = y + dy
			if yy >= 0 and yy < h then
				local lo, hi = rowStart[yy + 1], rowStart[yy + 2] - 1
				-- first run whose end >= a (binary search)
				while lo <= hi do
					local mid = (lo + hi) // 2
					if RB[mid] < a then
						lo = mid + 1
					else
						hi = mid - 1
					end
				end
				local j = lo
				local last = rowStart[yy + 2] - 1
				while j <= last and RA[j] <= b do
					visit(j)
					j += 1
				end
			end
		end
	end
	local mask = buffer.create(w * h)
	local count = 0
	for y = 0, h - 1 do
		for k = rowStart[y + 1], rowStart[y + 2] - 1 do
			if buffer.readu8(seen, k) == 0 then
				local len = RB[k] - RA[k] + 1
				buffer.fill(u, y * w + RA[k], 255, len)
				buffer.fill(mask, y * w + RA[k], 1, len)
				count += len
			end
		end
	end
	return mask, count
end

----------------------------------------------------------------------------------------
-- 7. liquid refinement
----------------------------------------------------------------------------------------

-- GT[s + 1] = g(s) for s = 0 .. tau - 1 (header rule 6).
function LiquidMatte.gainTable(tau: number, kMax: number): { number }
	local GT = table.create(tau, 0)
	for s = 0, tau - 1 do
		local k = (kMax * (tau - s) + tau - 1) // tau
		local g = 1
		for _ = 1, k do
			g *= 0.5
		end
		GT[s + 1] = g
	end
	return GT
end

-- The definition, one pixel at a time (no skipping). Used by the tests as the reference.
function LiquidMatte.refineReference(u: buffer, dq: buffer, w: number, h: number, tau: number, kMax: number, clip: number): buffer
	local GT = LiquidMatte.gainTable(tau, kMax)
	local function step(hs: number, v: number, s: number): number
		if s >= tau then
			return v
		end
		hs = hs + (v - hs) * GT[s + 1]
		local e = v - hs
		if e < SNAP and e > -SNAP then
			hs = v
		end
		return hs
	end
	local n = w * h
	local Hb = buffer.create(n)
	local hl = table.create(w, 0)
	for y = 0, h - 1 do
		local base = y * w
		local hs = buffer.readu8(u, base)
		hl[1] = hs
		for x = 1, w - 1 do
			local s = math.abs(buffer.readu16(dq, (base + x) * 2) - buffer.readu16(dq, (base + x - 1) * 2))
			hs = step(hs, buffer.readu8(u, base + x), s)
			hl[x + 1] = hs
		end
		hs = buffer.readu8(u, base + w - 1)
		buffer.writeu8(Hb, base + w - 1, clipByte(floor((hl[w] + hs) * 0.5 + 0.5), clip))
		for x = w - 2, 0, -1 do
			local s = math.abs(buffer.readu16(dq, (base + x) * 2) - buffer.readu16(dq, (base + x + 1) * 2))
			hs = step(hs, buffer.readu8(u, base + x), s)
			buffer.writeu8(Hb, base + x, clipByte(floor((hl[x + 1] + hs) * 0.5 + 0.5), clip))
		end
	end
	local A = buffer.create(n)
	local hu = table.create(h, 0)
	for x = 0, w - 1 do
		local hs = buffer.readu8(Hb, x)
		hu[1] = hs
		for y = 1, h - 1 do
			local i = y * w + x
			local s = math.abs(buffer.readu16(dq, i * 2) - buffer.readu16(dq, (i - w) * 2))
			hs = step(hs, buffer.readu8(Hb, i), s)
			hu[y + 1] = hs
		end
		hs = buffer.readu8(Hb, (h - 1) * w + x)
		buffer.writeu8(A, (h - 1) * w + x, clipByte(floor((hu[h] + hs) * 0.5 + 0.5), clip))
		for y = h - 2, 0, -1 do
			local i = y * w + x
			local s = math.abs(buffer.readu16(dq, i * 2) - buffer.readu16(dq, (i + w) * 2))
			hs = step(hs, buffer.readu8(Hb, i), s)
			buffer.writeu8(A, i, clipByte(floor((hu[y + 1] + hs) * 0.5 + 0.5), clip))
		end
	end
	return A
end

local STRIP = 64

-- Makes a byte plane clip-closed in place (every value 0, 255 or inside (clip, 255 - clip)).
-- rawMatte output already is; refine and refineReference agree bit for bit on such inputs.
function LiquidMatte.clipPlane(u: buffer, n: number, clip: number)
	for i = 0, n - 1 do
		local v = buffer.readu8(u, i)
		if v > 0 and v <= clip then
			buffer.writeu8(u, i, 0)
		elseif v < 255 and v >= 255 - clip then
			buffer.writeu8(u, i, 255)
		end
	end
end

-- Event-driven refinement: the same bits as refineReference for a clip-closed u. Returns A
-- and the number of transient steps (states left off their input after the step).
function LiquidMatte.refine(u: buffer, dq: buffer, w: number, h: number, tau: number, kMax: number, clip: number, out: buffer?): (buffer, number)
	local GT = LiquidMatte.gainTable(tau, kMax)
	local readu8, readu16, readu32 = buffer.readu8, buffer.readu16, buffer.readu32
	local writeu8 = buffer.writeu8
	local n = w * h
	local transients = 0
	local cl, ch = clip, 255 - clip
	-- horizontal stage: Hb = clip(round((hL + hR) / 2))
	local Hb = buffer.create(n + 4)
	buffer.copy(Hb, 0, u, 0, n)
	local rowL = table.create(w, 0)
	local markL = buffer.create(w + 8)
	for y = 0, h - 1 do
		local base = y * w
		local touched = false
		local hs = readu8(u, base)
		local x = 1
		while x < w do
			local v = readu8(u, base + x)
			if hs == v then
				x += 1
				local word = v * WORD1
				while x + 3 < w and readu32(u, base + x) == word do
					x += 4
				end
			else
				local s = readu16(dq, (base + x) * 2) - readu16(dq, (base + x - 1) * 2)
				if s < 0 then
					s = -s
				end
				if s >= tau then
					hs = v
				else
					hs = hs + (v - hs) * GT[s + 1]
					local e = v - hs
					if e < SNAP and e > -SNAP then
						hs = v
					end
				end
				if hs ~= v then
					if not touched then
						buffer.fill(markL, 0, 0, w + 8)
						touched = true
					end
					rowL[x + 1] = hs
					writeu8(markL, x, 1)
					transients += 1
				end
				x += 1
			end
		end
		-- right to left, combined with the left pass
		hs = readu8(u, base + w - 1)
		x = w - 1
		while x >= 0 do
			local v = readu8(u, base + x)
			local ml = if touched then readu8(markL, x) else 0
			if hs == v and ml == 0 then
				x -= 1
				local word = v * WORD1
				if touched then
					while x >= 3 and readu32(u, base + x - 3) == word and readu32(markL, x - 3) == 0 do
						x -= 4
					end
				else
					while x >= 3 and readu32(u, base + x - 3) == word do
						x -= 4
					end
				end
			else
				if hs ~= v then
					local s = readu16(dq, (base + x) * 2) - readu16(dq, (base + x + 1) * 2)
					if s < 0 then
						s = -s
					end
					if s >= tau then
						hs = v
					else
						hs = hs + (v - hs) * GT[s + 1]
						local e = v - hs
						if e < SNAP and e > -SNAP then
							hs = v
						end
					end
					if hs ~= v then
						transients += 1
					end
				end
				local hlv = if ml == 1 then rowL[x + 1] else v
				if hlv ~= v or hs ~= v then
					local o = floor((hlv + hs) * 0.5 + 0.5)
					if o <= cl then
						o = 0
					elseif o >= ch then
						o = 255
					end
					writeu8(Hb, base + x, o)
				end
				x -= 1
			end
		end
	end
	-- vertical stage in strips of STRIP columns
	local A = out or buffer.create(n)
	buffer.copy(A, 0, Hb, 0, n)
	local store = buffer.create(STRIP * h * 8)
	local markU = buffer.create(STRIP * h + 8)
	local hU = table.create(STRIP, 0)
	local conv = buffer.create(STRIP + 8)
	for x0 = 0, w - 1, STRIP do
		local x1 = math.min(x0 + STRIP, w)
		buffer.fill(markU, 0, 0)
		for x = x0, x1 - 1 do
			hU[x - x0 + 1] = readu8(Hb, x)
			writeu8(conv, x - x0, 1)
		end
		-- top to bottom
		for y = 1, h - 1 do
			local rb = y * w
			local rp = rb - w
			local mrow = y * STRIP
			local x = x0
			while x < x1 do
				local j = x - x0
				if x + 3 < x1 and readu32(conv, j) == WORD1 and readu32(Hb, rb + x) == readu32(Hb, rp + x) then
					x += 4
				else
					local v = readu8(Hb, rb + x)
					local hs = hU[j + 1]
					if hs ~= v then
						local s = readu16(dq, (rb + x) * 2) - readu16(dq, (rp + x) * 2)
						if s < 0 then
							s = -s
						end
						if s >= tau then
							hs = v
						else
							hs = hs + (v - hs) * GT[s + 1]
							local e = v - hs
							if e < SNAP and e > -SNAP then
								hs = v
							end
						end
						hU[j + 1] = hs
					end
					if hs == v then
						writeu8(conv, j, 1)
					else
						writeu8(conv, j, 0)
						buffer.writef64(store, (mrow + j) * 8, hs)
						writeu8(markU, mrow + j, 1)
						transients += 1
					end
					x += 1
				end
			end
		end
		-- bottom to top, combined with the downward pass
		do
			local rb = (h - 1) * w
			local mrow = (h - 1) * STRIP
			for x = x0, x1 - 1 do
				local j = x - x0
				local v = readu8(Hb, rb + x)
				hU[j + 1] = v
				writeu8(conv, j, 1)
				if readu8(markU, mrow + j) == 1 then
					local o = floor((buffer.readf64(store, (mrow + j) * 8) + v) * 0.5 + 0.5)
					if o <= cl then
						o = 0
					elseif o >= ch then
						o = 255
					end
					writeu8(A, rb + x, o)
				end
			end
		end
		for y = h - 2, 0, -1 do
			local rb = y * w
			local rn = rb + w
			local mrow = y * STRIP
			local x = x0
			while x < x1 do
				local j = x - x0
				if
					x + 3 < x1
					and readu32(conv, j) == WORD1
					and readu32(Hb, rb + x) == readu32(Hb, rn + x)
					and readu32(markU, mrow + j) == 0
				then
					x += 4
				else
					local v = readu8(Hb, rb + x)
					local hs = hU[j + 1]
					if hs ~= v then
						local s = readu16(dq, (rb + x) * 2) - readu16(dq, (rn + x) * 2)
						if s < 0 then
							s = -s
						end
						if s >= tau then
							hs = v
						else
							hs = hs + (v - hs) * GT[s + 1]
							local e = v - hs
							if e < SNAP and e > -SNAP then
								hs = v
							end
						end
						hU[j + 1] = hs
						if hs ~= v then
							transients += 1
						end
					end
					writeu8(conv, j, if hs == v then 1 else 0)
					local mu = readu8(markU, mrow + j)
					if mu == 1 or hs ~= v then
						local hu = if mu == 1 then buffer.readf64(store, (mrow + j) * 8) else v
						local o = floor((hu + hs) * 0.5 + 0.5)
						if o <= cl then
							o = 0
						elseif o >= ch then
							o = 255
						end
						writeu8(A, rb + x, o)
					end
					x += 1
				end
			end
		end
	end
	return A, transients
end

----------------------------------------------------------------------------------------
-- 8. compose (despill) and bleed
----------------------------------------------------------------------------------------

-- Key chroma and the luma-free direction K - Y_K used by the spill limiter.
local function spillBasis(key: Key): (number, number, number, number, number, number)
	local kr, kg, kb = key.r, key.g, key.b
	local kcb = 128 * kb - 43 * kr - 85 * kg
	local kcr = 128 * kr - 107 * kg - 21 * kb
	local yk = (77 * kr + 150 * kg + 29 * kb) / 256
	return kcb, kcr, kcb * kcb + kcr * kcr, kr - yk, kg - yk, kb - yk
end

-- Key-ward share of a colour's chroma: p = (cb kcb + cr kcr) / |kc|^2 (0 for grey keys).
function LiquidMatte.keyShare(c: number, key: Key): number
	local kcb, kcr, kk = spillBasis(key)
	if kk == 0 then
		return 0
	end
	local r, g, b = c % 256, (c // 256) % 256, (c // 65536) % 256
	local cb = 128 * b - 43 * r - 85 * g
	local cr = 128 * r - 107 * g - 21 * b
	return (cb * kcb + cr * kcr) / kk
end

local function round255(v: number): number
	local q = floor(v + 0.5)
	if q < 0 then
		return 0
	elseif q > 255 then
		return 255
	end
	return q
end

-- Writes the output image from the source, the final alpha plane A and the key.
-- Returns the number of partial pixels.
function LiquidMatte.compose(img: buffer, w: number, h: number, A: buffer, P: Params, opaque: boolean, protect: buffer?, out: buffer?): (buffer, number)
	local dst = out or buffer.create(w * h * 4)
	local readu8, readu32 = buffer.readu8, buffer.readu32
	local writeu32 = buffer.writeu32
	local key = P.key
	local kr, kg, kb = key.r, key.g, key.b
	local despill = P.despill
	local s = P.spill
	local kcb, kcr, kk, vr, vg, vb = spillBasis(key)
	local limiter = s > 0 and kk > 0
	local partial = 0
	for y = 0, h - 1 do
		local base = y * w
		local x = 0
		while x < w do
			local i = base + x
			local a = readu8(A, i)
			if a == 0 and x + 3 < w and readu32(A, i) == 0 then
				-- transparent words: zero now, bled later
				local x2 = x + 4
				while x2 + 3 < w and readu32(A, base + x2) == 0 do
					x2 += 4
				end
				buffer.fill(dst, i * 4, 0, (x2 - x) * 4)
				x = x2
				continue
			end
			if a == 255 and opaque and not limiter and x + 3 < w and readu32(A, i) == 0xFFFFFFFF then
				local x2 = x + 4
				while x2 + 3 < w and readu32(A, base + x2) == 0xFFFFFFFF do
					x2 += 4
				end
				buffer.copy(dst, i * 4, img, i * 4, (x2 - x) * 4)
				x = x2
				continue
			end
			local p = readu32(img, i * 4)
			local sa = p // 16777216
			local r, g, b = p % 256, (p // 256) % 256, (p // 65536) % 256
			local prot = protect ~= nil and readu8(protect, i) == 1
			if a > 0 and a < 255 then
				partial += 1
				if despill and not prot then
					local inv = 255 - a
					r = round255((255 * r - inv * kr) / a)
					g = round255((255 * g - inv * kg) / a)
					b = round255((255 * b - inv * kb) / a)
				end
			end
			if limiter and a > 0 and not prot then
				local cb = 128 * b - 43 * r - 85 * g
				local cr = 128 * r - 107 * g - 21 * b
				local pk = (cb * kcb + cr * kcr) / kk
				if pk > 0 then
					local t = s * pk
					r = round255(r - t * vr)
					g = round255(g - t * vg)
					b = round255(b - t * vb)
				end
			end
			local oa = a
			if sa < 255 then
				oa = MyMath.div255(sa * a)
			end
			if oa == 0 then
				writeu32(dst, i * 4, 0)
			else
				writeu32(dst, i * 4, r + g * 256 + b * 65536 + oa * 16777216)
			end
			x += 1
		end
	end
	return dst, partial
end

-- Alpha bleeding (header rule 8), in place on an RGBA8 image whose alpha plane is A
-- (A is read; transparency is A == 0). Span fills only: cost follows runs.
function LiquidMatte.bleed(img: buffer, A: buffer, w: number, h: number)
	local readu8, readu32 = buffer.readu8, buffer.readu32
	local empty = buffer.create(h)
	local any = false
	for y = 0, h - 1 do
		local base = y * w
		local x = 0
		local visible = false
		while x < w do
			-- skip visible pixels (opaque words four at a time)
			while x < w do
				if x + 3 < w and readu32(A, base + x) == 0xFFFFFFFF then
					x += 4
				elseif readu8(A, base + x) ~= 0 then
					x += 1
				else
					break
				end
				visible = true
			end
			if x >= w then
				break
			end
			local a = x
			while x + 3 < w and readu32(A, base + x) == 0 do
				x += 4
			end
			while x < w and readu8(A, base + x) == 0 do
				x += 1
			end
			local b = x - 1
			local hasL = a > 0
			local hasR = x < w
			if hasL or hasR then
				local cl = if hasL then readu32(img, (base + a - 1) * 4) % 16777216 else 0
				local cr = if hasR then readu32(img, (base + x) * 4) % 16777216 else 0
				if hasL and hasR then
					local mid = (a + b) // 2
					fillSpan(img, (base + a) * 4, mid - a + 1, cl)
					fillSpan(img, (base + mid + 1) * 4, b - mid, cr)
				elseif hasL then
					fillSpan(img, (base + a) * 4, b - a + 1, cl)
				else
					fillSpan(img, (base + a) * 4, b - a + 1, cr)
				end
			end
		end
		if visible then
			any = true
		else
			buffer.writeu8(empty, y, 1)
		end
	end
	if not any then
		return
	end
	local rowBytes = w * 4
	local row = buffer.create(rowBytes)
	local function zeroAlphaCopy(src: number)
		buffer.copy(row, 0, img, src * rowBytes, rowBytes)
		for x = 0, w - 1 do
			buffer.writeu8(row, x * 4 + 3, 0)
		end
	end
	local y = 0
	while y < h do
		if buffer.readu8(empty, y) == 0 then
			y += 1
			continue
		end
		local ya = y
		while y < h and buffer.readu8(empty, y) == 1 do
			y += 1
		end
		local yb = y - 1
		local up = if ya > 0 then ya - 1 else -1
		local down = if yb < h - 1 then yb + 1 else -1
		local split = if up >= 0 and down >= 0 then (up + down) // 2 else (if up >= 0 then yb else ya - 1)
		if up >= 0 then
			zeroAlphaCopy(up)
			for yy = ya, math.min(split, yb) do
				buffer.copy(img, yy * rowBytes, row, 0, rowBytes)
			end
		end
		if down >= 0 then
			zeroAlphaCopy(down)
			for yy = math.max(split + 1, ya), yb do
				buffer.copy(img, yy * rowBytes, row, 0, rowBytes)
			end
		end
	end
end

----------------------------------------------------------------------------------------
-- 9. the pipeline and the baseline
----------------------------------------------------------------------------------------

-- Full liquid matte. Returns the RGBA8 output, the final alpha plane (before the source
-- alpha is applied) and statistics.
function LiquidMatte.matte(img: buffer, w: number, h: number, opts: Options?, out: buffer?): (buffer, buffer, Info)
	local o: Options = opts or {}
	local key = LiquidMatte.detectKey(img, w, h, o.wy, o.key)
	local P = LiquidMatte.params(key, o)
	local field = LiquidMatte.distanceField(img, w, h, key, P.t0)
	local u, band = LiquidMatte.rawMatte(field, w, h, P)
	local protect: buffer? = nil
	local protectedCount = 0
	if P.flood then
		protect, protectedCount = LiquidMatte.floodProtect(u, w, h)
	end
	local A = u
	local transients = 0
	if P.refine then
		A, transients = LiquidMatte.refine(u, field.dq, w, h, P.tau, P.kMax, P.clip)
	end
	local dst, partial = LiquidMatte.compose(img, w, h, A, P, field.opaque, protect, out)
	if P.bleed then
		LiquidMatte.bleed(dst, A, w, h)
	end
	return dst,
		A,
		{
			key = key,
			params = P,
			edgeBand = band,
			protected = protectedCount,
			transients = transients,
			partial = partial,
			distinct = field.distinct,
		}
end

-- Baseline: a plain per-pixel chroma key with the same metric and a linear ramp from t0 to
-- t1 (Dq units). No refinement, no despill, no bleed.
function LiquidMatte.plainKey(img: buffer, w: number, h: number, key: Key, t0: number, t1: number, out: buffer?): buffer
	local dst = out or buffer.create(w * h * 4)
	local kr, kg, kb, wy = key.r, key.g, key.b, key.wy
	local readu32, writeu32 = buffer.readu32, buffer.writeu32
	local scale = 255 / (t1 - t0)
	for i = 0, w * h - 1 do
		local p = readu32(img, i * 4)
		local dr = p % 256 - kr
		local dg = (p // 256) % 256 - kg
		local db = (p // 65536) % 256 - kb
		local dy = 77 * dr + 150 * dg + 29 * db
		local dcb = 128 * db - 43 * dr - 85 * dg
		local dcr = 128 * dr - 107 * dg - 21 * db
		local d = floor(sqrt(4 * (dcb * dcb + dcr * dcr) + wy * dy * dy) * 0.015625)
		local a
		if d <= t0 then
			a = 0
		elseif d >= t1 then
			a = 255
		else
			a = floor((d - t0) * scale + 0.5)
		end
		writeu32(dst, i * 4, p % 16777216 + a * 16777216)
	end
	return dst
end

-- Lockstep checksum (as Liquid.hashBuffer): hash32 folded over the u32 words.
function LiquidMatte.hash(b: buffer): number
	local h = 0x811C9DC5
	local n = buffer.len(b) // 4
	for i = 0, n - 1 do
		h = hash32(bit32.bxor(h, buffer.readu32(b, i * 4)))
	end
	for i = n * 4, buffer.len(b) - 1 do
		h = hash32(bit32.bxor(h, buffer.readu8(b, i)))
	end
	return h
end

return LiquidMatte
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">MyMath</string>
          <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: MyMath
--
-- The project's numeric axioms, written as code. Every function here uses only
-- operations that round identically on every platform and in both Luau runtimes
-- (interpreter and native): + - * / and sqrt (IEEE 754 correctly rounded), floor,
-- abs, min, max, // and % on integers, and bit32. No libm transcendental functions,
-- no math.lerp (native code fuses it into an FMA), no math.noise or math.random.
-- See docs/RUNTIME_AUDIT.md section 6.5 and docs/DESIGN.md axioms M1 to M9.
--
-- Pixel axioms (docs/COMPUTE.md sections 1, 3.3 and "Flawless pipeline"):
--
--   F1  A pixel is a box filter. The coverage of a shape at a pixel is the EXACT
--       area of the pixel square inside the shape; a byte is flawless when
--       |byte - 255 A| <= 0.5 + 0.01 (the correctly rounded exact area). Exact
--       area, never supersampling, is the reference (n x n point samples err by up
--       to about 1/(2n) per edge crossing).
--   F2  A scene is a box filter of its source-over composite: each pixel is the sum
--       over visible regions of colour times area. Coverage used as alpha is exact
--       only where at most one shape's edge enters the pixel; elsewhere visibility
--       must be computed exactly (compute/Visibility.luau).
--   F3  Content bytes depend only on the deterministic ops listed above (plus the
--       deterministic arcsine Coverage.dasin); interpreter and native code agree.
--
--   C3  Linear ramp error. coverage(d, w) = clamp(1/2 - d/w) is exact only for
--       axis-aligned edges. On a straight 45 degree edge its worst error is
--       (sqrt(2)/2 - 1/2)^2 = 0.04289, i.e. 10.94/255 (closed form). Measured on
--       shapes: 11/255 on circles of any radius, 38/255 at sharp box corners, 26 to
--       57/255 at polygon corners. It is the PREVIEW ramp (Raster MODE_LINEAR).
--   C4  Half-plane exactness. For a straight edge with unit normal (nx, ny) and
--       signed distance d from the pixel centre, coverageHalfPlane is the exact
--       area: the pixel's projection on n has a trapezoid density with ramps of
--       width b = min(|nx|, |ny|) and a plateau of width a - b, a = max(|nx|, |ny|).
--       It is exactly 0 for d >= (a + b)/2 and exactly 1 for d <= -(a + b)/2.
--   C5  Curvature. A boundary of curvature k tangent to the half-plane line lies
--       k t^2 / 2 inside it at tangential offset t, so the half-plane overestimates
--       by at most k (sqrt(2)/2)^3 / 3 = 0.1179 k (30/R in 1/255 units).
--       coverageCurved subtracts the exact first-order term k (t1^3 - t0^3) / 6
--       over the chord [t0, t1] the tangent line cuts from the pixel. Where the
--       line leaves the pixel at a shallow angle, the pixel side cuts the sliver
--       between line and curve obliquely, so the residual is O(k), not O(k^2):
--       measured worst 0.36/255 at R = 8, 0.09 at R = 16, 0.036 at R = 48, 0.004
--       at R = 128, 0.002 at R = 300 (1/255 units, random placements). That is
--       far better than the ramp but NOT flawless (F1 needs < 0.01) below about
--       R = 300, so flawless rendering uses exact disc areas instead
--       (Coverage.discBoxArea, Coverage.discPolyArea).
--   Reach. The reach R_cov of a coverage function is the largest |d| at which it
--       can be strictly between 0 and 1: w/2 for the ramp, COVERAGE_REACH * w =
--       w sqrt(2)/2 for any exact area coverage (every point of a w x w pixel lies
--       within w sqrt(2)/2 of its centre). Culling must drop a shape only when
--       d - L rho >= R_cov (L the Lipschitz constant, rho the node radius) and
--       bounding boxes must grow by R_cov; culling at w/2 silently cuts real
--       coverage on diagonal edges.

local MyMath = {}

local TWO16 = 65536
local TWO32 = 4294967296

MyMath.TWO32 = TWO32

----------------------------------------------------------------------------------
-- M1. Exact 32-bit integer arithmetic inside doubles
----------------------------------------------------------------------------------

-- Low 32 bits of a * b for integers a, b in [0, 2^32).
-- Splitting b into 16-bit halves keeps every partial product below 2^48, so all
-- intermediate values are exact doubles and the result is bit-identical everywhere.
local function mul32(a: number, b: number): number
	local bl = b % TWO16
	local bh = (b - bl) / TWO16
	return (a * bl + (a * bh) % TWO16 * TWO16) % TWO32
end
MyMath.mul32 = mul32

-- Folds any integer-valued number (negative too) into [0, 2^32).
function MyMath.u32(x: number): number
	return (x // 1) % TWO32
end

----------------------------------------------------------------------------------
-- M2. Deterministic hashing and noise
----------------------------------------------------------------------------------

-- lowbias32 (Chris Wellons, public domain): a full-avalanche 32-bit integer hash.
local function hash32(x: number): number
	x = bit32.bxor(x, bit32.rshift(x, 16))
	x = mul32(x, 0x7FEB352D)
	x = bit32.bxor(x, bit32.rshift(x, 15))
	x = mul32(x, 0x846CA68B)
	return bit32.bxor(x, bit32.rshift(x, 16))
end
MyMath.hash32 = hash32

-- Hash of an integer lattice point and a seed. Inputs may be negative.
local function hash2(ix: number, iy: number, seed: number): number
	local h = hash32(bit32.bxor(seed % TWO32, mul32(ix % TWO32, 0x9E3779B1)))
	return hash32(bit32.bxor(h, mul32(iy % TWO32, 0x85EBCA77)))
end
MyMath.hash2 = hash2

-- Uniform number in [0, 1) from a lattice point.
function MyMath.rand2(ix: number, iy: number, seed: number): number
	return hash2(ix, iy, seed) / TWO32
end

-- Quintic fade 6t^5 - 15t^4 + 10t^3. Its derivative peaks at 1.875 (t = 0.5).
local function fade(t: number): number
	return t * t * t * (t * (t * 6 - 15) + 10)
end
MyMath.fade = fade

-- Value noise in [0, 1). Lipschitz constant <= 1.875 * sqrt(2) per unit of input.
MyMath.VALUE_NOISE_LIPSCHITZ = 2.6517

function MyMath.valueNoise2(x: number, y: number, seed: number): number
	local ix = x // 1
	local iy = y // 1
	local ux = fade(x - ix)
	local uy = fade(y - iy)
	local a = hash2(ix, iy, seed) / TWO32
	local b = hash2(ix + 1, iy, seed) / TWO32
	local c = hash2(ix, iy + 1, seed) / TWO32
	local d = hash2(ix + 1, iy + 1, seed) / TWO32
	local ab = a + (b - a) * ux
	local cd = c + (d - c) * ux
	return ab + (cd - ab) * uy
end

-- Fractal sum of value noise. Returns value in [0, 1) and its Lipschitz bound.
function MyMath.fbm2(x: number, y: number, seed: number, octaves: number): (number, number)
	local sum, amp, freq, norm, lip = 0, 1, 1, 0, 0
	for o = 1, octaves do
		sum += amp * MyMath.valueNoise2(x * freq, y * freq, seed + o * 1013)
		norm += amp
		lip += amp * freq * 2.6517
		amp *= 0.5
		freq *= 2
	end
	return sum / norm, lip / norm
end

----------------------------------------------------------------------------------
-- M3. Deterministic trigonometry (angles in turns: 1 turn = 360 degrees)
----------------------------------------------------------------------------------

local TAU = 6.283185307179586

-- sin(2 pi t) from an odd Taylor polynomial up to x^15 on [-pi/2, pi/2].
-- Truncation error is below 1e-10; only + and * are used, so it is bit-identical
-- on every platform (unlike math.sin).
local function dsinTurns(t: number): number
	t = t - t // 1 -- [0, 1)
	local s
	if t < 0.25 then
		s = t
	elseif t < 0.75 then
		s = 0.5 - t
	else
		s = t - 1
	end
	local x = s * TAU
	local x2 = x * x
	return x
		* (1 + x2 * (-1 / 6 + x2 * (1 / 120 + x2 * (-1 / 5040 + x2 * (1 / 362880 + x2 * (-1 / 39916800 + x2 * (1 / 6227020800 + x2 * (-1 / 1307674368000))))))))
end
MyMath.dsinTurns = dsinTurns

function MyMath.dcosTurns(t: number): number
	return dsinTurns(t + 0.25)
end

----------------------------------------------------------------------------------
-- M4. Shaping functions
----------------------------------------------------------------------------------

function MyMath.clamp01(x: number): number
	return if x < 0 then 0 elseif x > 1 then 1 else x
end

function MyMath.smoothstep(e0: number, e1: number, x: number): number
	local t = (x - e0) / (e1 - e0)
	t = if t < 0 then 0 elseif t > 1 then 1 else t
	return t * t * (3 - 2 * t)
end

-- Linear interpolation written out so native code never fuses it into an FMA.
function MyMath.mix(a: number, b: number, t: number): number
	return a + (b - a) * t
end

----------------------------------------------------------------------------------
-- M5. Signed distance primitives (negative inside). All are exact or bounded
-- distances with Lipschitz constant 1, which the rasterizer relies on.
----------------------------------------------------------------------------------

function MyMath.sdCircle(px: number, py: number, cx: number, cy: number, r: number): number
	local dx, dy = px - cx, py - cy
	return math.sqrt(dx * dx + dy * dy) - r
end

-- Box centred at (cx, cy) with half extents (hx, hy) and corner radius rad.
function MyMath.sdRoundBox(px: number, py: number, cx: number, cy: number, hx: number, hy: number, rad: number): number
	local qx = math.abs(px - cx) - hx + rad
	local qy = math.abs(py - cy) - hy + rad
	local ox = if qx > 0 then qx else 0
	local oy = if qy > 0 then qy else 0
	local inside = if qx > qy then qx else qy
	if inside > 0 then
		inside = 0
	end
	return math.sqrt(ox * ox + oy * oy) + inside - rad
end

-- Capsule: segment a-b thickened by radius r.
function MyMath.sdSegment(px: number, py: number, ax: number, ay: number, bx: number, by: number, r: number): number
	local pax, pay = px - ax, py - ay
	local bax, bay = bx - ax, by - ay
	local len2 = bax * bax + bay * bay
	local h = if len2 > 0 then (pax * bax + pay * bay) / len2 else 0
	h = if h < 0 then 0 elseif h > 1 then 1 else h
	local dx, dy = pax - bax * h, pay - bay * h
	return math.sqrt(dx * dx + dy * dy) - r
end

-- Polygon given as flat {x1, y1, x2, y2, ...}; exact signed distance with the
-- even-odd winding sign (Inigo Quilez's sdPolygon).
function MyMath.sdPolygon(px: number, py: number, pts: { number }): number
	local n = #pts // 2
	local d = math.huge
	local s = 1
	local jx, jy = pts[2 * n - 1], pts[2 * n]
	for i = 1, n do
		local vx, vy = pts[2 * i - 1], pts[2 * i]
		local ex, ey = jx - vx, jy - vy
		local wx, wy = px - vx, py - vy
		local ee = ex * ex + ey * ey
		local h = if ee > 0 then (wx * ex + wy * ey) / ee else 0
		h = if h < 0 then 0 elseif h > 1 then 1 else h
		local bx, by = wx - ex * h, wy - ey * h
		local dd = bx * bx + by * by
		if dd < d then
			d = dd
		end
		local c1 = py >= vy
		local c2 = py < jy
		local c3 = ex * wy > ey * wx
		if (c1 and c2 and c3) or (not c1 and not c2 and not c3) then
			s = -s
		end
		jx, jy = vx, vy
	end
	return s * math.sqrt(d)
end

-- Polynomial smooth minimum. Its partial derivatives are h and 1 - h, so it keeps
-- the Lipschitz bound of its inputs (proof in docs/DESIGN.md).
function MyMath.smin(a: number, b: number, k: number): number
	if k <= 0 then
		return if a < b then a else b
	end
	local h = 0.5 + 0.5 * (b - a) / k
	h = if h < 0 then 0 elseif h > 1 then 1 else h
	return b + (a - b) * h - k * h * (1 - h)
end

-- The LINEAR PREVIEW RAMP: clamp(0.5 - d / w, 0, 1) from the signed distance d in
-- pixels and an anti-aliasing width w (1 = one pixel). Exactly 0 when d >= w/2 and
-- exactly 1 when d <= -w/2 (its reach is w/2), which ramp-based culling relies on.
-- As an estimate of pixel area it is exact only for axis-aligned edges: up to
-- 10.94/255 on a straight 45 degree edge (C3, closed form), 11/255 on circles of
-- any radius, 38/255 at sharp box corners and 26 to 57/255 at polygon corners
-- (measured, docs/COMPUTE.md 3.3). Use it for previews (Raster MODE_LINEAR); use
-- coverageHalfPlane, coverageCurved or exact areas for content (F1).
function MyMath.coverage(d: number, w: number): number
	local a = 0.5 - d / w
	return if a < 0 then 0 elseif a > 1 then 1 else a
end

----------------------------------------------------------------------------------
-- M8. Exact-area coverage axioms (C4, C5; header). Moved verbatim from
-- compute/Coverage.luau (halfPlane, halfPlaneCurved), so results are bit-identical;
-- the optional w scales the box filter (a w x w pixel, default 1): d is divided by
-- w and the curvature k multiplied by w, which is exact when w is 1 or omitted.
----------------------------------------------------------------------------------

local abs = math.abs

-- sqrt(2)/2: the reach of every exact-area coverage function in pixel widths.
MyMath.COVERAGE_REACH = 0.70710678118654757

-- C4. Exact area of {q in pixel : d + n . (q - centre) <= 0} for |n| = 1, i.e. the
-- part of the pixel on the inner side of a straight edge at signed distance d
-- (negative inside) with unit normal (nx, ny). Only |nx| and |ny| matter.
local function coverageHalfPlane(d: number, nx: number, ny: number, w: number?): number
	if w then
		d = d / w
	end
	local a, b = abs(nx), abs(ny)
	if a < b then
		a, b = b, a
	end
	local u = (a + b) * 0.5 - d
	if u <= 0 then
		return 0
	end
	if u >= a + b then
		return 1
	end
	if u < b then
		return u * u / (2 * a * b)
	end
	if u <= a then
		return (2 * u - b) / (2 * a)
	end
	local v = a + b - u
	return 1 - v * v / (2 * a * b)
end
MyMath.coverageHalfPlane = coverageHalfPlane

-- C5. Half-plane area minus the first-order curvature term k (t1^3 - t0^3) / 6
-- over the chord the tangent line cuts from the pixel. k > 0 where the shape is
-- convex (1 / R for a disc of radius R), k < 0 where it is concave. Error O(k) at
-- shallow chord exits (header), so it is an estimator, not an exact area.
local function coverageCurved(d: number, nx: number, ny: number, k: number, w: number?): number
	if w then
		d = d / w
		k = k * w
	end
	local base = coverageHalfPlane(d, nx, ny)
	if k == 0 then
		return base
	end
	-- the line is {q : n . (q - c) = -d}; parametrise q = c - d n + t (-ny, nx)
	-- and clip t to the unit square |qx - cx| <= 1/2, |qy - cy| <= 1/2
	local t0, t1 = -1e300, 1e300
	local tx, ty = -ny, nx
	local ox, oy = -d * nx, -d * ny
	if tx ~= 0 then
		local a0 = (-0.5 - ox) / tx
		local a1 = (0.5 - ox) / tx
		if a0 > a1 then
			a0, a1 = a1, a0
		end
		if a0 > t0 then
			t0 = a0
		end
		if a1 < t1 then
			t1 = a1
		end
	elseif ox < -0.5 or ox > 0.5 then
		t1 = t0
	end
	if ty ~= 0 then
		local a0 = (-0.5 - oy) / ty
		local a1 = (0.5 - oy) / ty
		if a0 > a1 then
			a0, a1 = a1, a0
		end
		if a0 > t0 then
			t0 = a0
		end
		if a1 < t1 then
			t1 = a1
		end
	elseif oy < -0.5 or oy > 0.5 then
		t1 = t0
	end
	local c = base
	if t1 > t0 then
		c = base - k * (t1 * t1 * t1 - t0 * t0 * t0) / 6
	end
	return if c < 0 then 0 elseif c > 1 then 1 else c
end
MyMath.coverageCurved = coverageCurved

----------------------------------------------------------------------------------
-- M6. Exact 8-bit colour arithmetic
----------------------------------------------------------------------------------

-- round(t / 255) for integer t in [0, 65025], with no division. Verified for every
-- input by brute force. Each 16-bit lane of a SWAR word stays below 2^16.
function MyMath.div255(t: number): number
	local x = t + 128
	return (x + x // 256) // 256
end

function MyMath.pack(r: number, g: number, b: number, a: number): number
	return r + g * 256 + b * 65536 + a * 16777216
end

function MyMath.unpack(c: number): (number, number, number, number)
	return c % 256, (c // 256) % 256, (c // 65536) % 256, c // 16777216
end

-- Parses "#RRGGBB" or "#RRGGBBAA" into a packed straight-alpha RGBA8 value.
function MyMath.hex(s: string): number
	local h = string.gsub(s, "^#", "")
	local r = tonumber(string.sub(h, 1, 2), 16) or 0
	local g = tonumber(string.sub(h, 3, 4), 16) or 0
	local b = tonumber(string.sub(h, 5, 6), 16) or 0
	local a = if #h >= 8 then tonumber(string.sub(h, 7, 8), 16) or 255 else 255
	return r + g * 256 + b * 65536 + a * 16777216
end

-- sRGB to linear light in 16-bit fixed point, generated offline (tools/gen_vectors.py)
-- so every client uses the same integers. Strictly increasing.
local SRGB_TO_LINEAR16 = {
	0, 20, 40, 60, 80, 99, 119, 139, 159, 179, 199, 219, 241, 264, 288, 313,
	340, 367, 396, 427, 458, 491, 526, 562, 599, 637, 677, 718, 761, 805, 851, 898,
	947, 997, 1048, 1101, 1156, 1212, 1270, 1330, 1391, 1453, 1517, 1583, 1651, 1720, 1790, 1863,
	1937, 2013, 2090, 2170, 2250, 2333, 2418, 2504, 2592, 2681, 2773, 2866, 2961, 3058, 3157, 3258,
	3360, 3464, 3570, 3678, 3788, 3900, 4014, 4129, 4247, 4366, 4488, 4611, 4736, 4864, 4993, 5124,
	5257, 5392, 5530, 5669, 5810, 5953, 6099, 6246, 6395, 6547, 6700, 6856, 7014, 7174, 7335, 7500,
	7666, 7834, 8004, 8177, 8352, 8528, 8708, 8889, 9072, 9258, 9445, 9635, 9828, 10022, 10219, 10417,
	10619, 10822, 11028, 11235, 11446, 11658, 11873, 12090, 12309, 12530, 12754, 12980, 13209, 13440, 13673, 13909,
	14146, 14387, 14629, 14874, 15122, 15371, 15623, 15878, 16135, 16394, 16656, 16920, 17187, 17456, 17727, 18001,
	18277, 18556, 18837, 19121, 19407, 19696, 19987, 20281, 20577, 20876, 21177, 21481, 21787, 22096, 22407, 22721,
	23038, 23357, 23678, 24002, 24329, 24658, 24990, 25325, 25662, 26001, 26344, 26688, 27036, 27386, 27739, 28094,
	28452, 28813, 29176, 29542, 29911, 30282, 30656, 31033, 31412, 31794, 32179, 32567, 32957, 33350, 33745, 34143,
	34544, 34948, 35355, 35764, 36176, 36591, 37008, 37429, 37852, 38278, 38706, 39138, 39572, 40009, 40449, 40891,
	41337, 41785, 42236, 42690, 43147, 43606, 44069, 44534, 45002, 45473, 45947, 46423, 46903, 47385, 47871, 48359,
	48850, 49344, 49841, 50341, 50844, 51349, 51858, 52369, 52884, 53401, 53921, 54445, 54971, 55500, 56032, 56567,
	57105, 57646, 58190, 58737, 59287, 59840, 60396, 60955, 61517, 62082, 62650, 63221, 63795, 64372, 64952, 65535,
}
MyMath.SRGB_TO_LINEAR16 = SRGB_TO_LINEAR16

function MyMath.srgbToLinear16(c8: number): number
	return SRGB_TO_LINEAR16[c8 + 1]
end

-- Inverse by binary search: the sRGB byte whose linear value is nearest to v.
function MyMath.linear16ToSrgb(v: number): number
	local lo, hi = 0, 255
	while lo < hi do
		local mid = (lo + hi) // 2
		if SRGB_TO_LINEAR16[mid + 1] < v then
			lo = mid + 1
		else
			hi = mid
		end
	end
	if lo > 0 and v - SRGB_TO_LINEAR16[lo] <= SRGB_TO_LINEAR16[lo + 1] - v then
		return lo - 1
	end
	return lo
end

----------------------------------------------------------------------------------
-- M7. Resolution allocation under a pixel-area budget ("water filling")
----------------------------------------------------------------------------------

-- Chooses a square texture size for each surface so the total pixel area fits the
-- budget. A surface gains detail only up to the pixels it covers on screen, so the
-- benefit of each size step is min(area, demand) * weight and has diminishing
-- returns. Greedy by benefit per added pixel is optimal for the continuous
-- relaxation and within one size step of optimal here.
--
-- demands[i]: on-screen pixel area of surface i (its useful texel count)
-- weights[i]: importance multiplier, default 1
-- budget:     total texel area allowed
-- sizes:      ascending allowed edge lengths, e.g. {64, 128, 256, 512, 1024}
-- returns { edge length or 0 } per surface (0 = no editable image)
function MyMath.allocate(demands: { number }, weights: { number }?, budget: number, sizes: { number }): { number }
	local n = #demands
	local level = table.create(n, 0) -- index into sizes; 0 = none
	local result = table.create(n, 0)
	local remaining = budget
	local function area(l: number): number
		if l == 0 then
			return 0
		end
		local s = sizes[l]
		return s * s
	end
	while true do
		local best, bestRatio = 0, 0
		for i = 1, n do
			local l = level[i]
			if l < #sizes then
				local cur, nxt = area(l), area(l + 1)
				local cost = nxt - cur
				if cost <= remaining then
					local d = demands[i]
					local w = if weights then weights[i] or 1 else 1
					local gain = ((if nxt < d then nxt else d) - (if cur < d then cur else d)) * w
					local ratio = gain / cost
					if ratio > bestRatio then
						best, bestRatio = i, ratio
					end
				end
			end
		end
		if best == 0 then
			break
		end
		remaining -= area(level[best] + 1) - area(level[best])
		level[best] += 1
	end
	for i = 1, n do
		result[i] = if level[i] == 0 then 0 else sizes[level[i]]
	end
	return result
end

return MyMath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Pixels</string>
          <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: Pixels
--
-- Buffer-level pixel ops on row-major RGBA8 (the EditableImage layout: bytes R, G,
-- B, A, so a pixel read with readu32 is r + g*256 + b*65536 + a*16777216).
-- Every op here follows the measured economics in docs/RUNTIME_AUDIT.md 6.7:
-- spans go through buffer.copy, per-pixel loops pack with arithmetic, and no
-- non-builtin call happens per pixel.

local MyMath = require("./MyMath")

local Pixels = {}

local pack = MyMath.pack

-- Fills count pixels starting at byte offset `at` with one colour.
-- One writeu32, then buffer.copy doubling: log2(count) C calls instead of count
-- interpreted writes (about 50x faster for a 1024 px row).
local function fillSpan(buf: buffer, at: number, count: number, color: number)
	if count <= 0 then
		return
	end
	buffer.writeu32(buf, at, color)
	if count < 8 then
		for i = 1, count - 1 do
			buffer.writeu32(buf, at + i * 4, color)
		end
		return
	end
	local bytes = count * 4
	local filled = 4
	while filled < bytes do
		local n = if filled < bytes - filled then filled else bytes - filled
		buffer.copy(buf, at + filled, buf, at, n)
		filled += n
	end
end
Pixels.fillSpan = fillSpan

-- Fills a w x h rectangle at (x, y) of an image `width` pixels wide.
function Pixels.fillRect(buf: buffer, width: number, x: number, y: number, w: number, h: number, color: number)
	if w <= 0 or h <= 0 then
		return
	end
	local row = width * 4
	local first = (y * width + x) * 4
	fillSpan(buf, first, w, color)
	local bytes = w * 4
	for r = 1, h - 1 do
		buffer.copy(buf, first + r * row, buf, first, bytes)
	end
end

-- Fills the whole buffer with one colour.
function Pixels.fill(buf: buffer, color: number)
	fillSpan(buf, 0, buffer.len(buf) // 4, color)
end

-- Copies a w x h block between two row-major images (row blits; memmove semantics).
function Pixels.copyRect(
	dst: buffer,
	dstWidth: number,
	dx: number,
	dy: number,
	src: buffer,
	srcWidth: number,
	sx: number,
	sy: number,
	w: number,
	h: number
)
	local bytes = w * 4
	for r = 0, h - 1 do
		buffer.copy(dst, ((dy + r) * dstWidth + dx) * 4, src, ((sy + r) * srcWidth + sx) * 4, bytes)
	end
end

-- Extracts a rectangle into a new tightly packed buffer (the shape WritePixelsBuffer wants).
function Pixels.extract(src: buffer, srcWidth: number, x: number, y: number, w: number, h: number, into: buffer?): buffer
	local out = into or buffer.create(w * h * 4)
	Pixels.copyRect(out, w, 0, 0, src, srcWidth, x, y, w, h)
	return out
end

-- 2 x 2 box filter: (w, h) -> (w // 2, h // 2). Channels are averaged in pairs
-- inside 16-bit lanes (mask 0x00FF00FF): four bytes sum to at most 1020, so lanes
-- never carry into each other. Rounds half up. Measured 20 percent faster than a
-- per-channel version in the interpreter.
function Pixels.downsample2x(src: buffer, w: number, h: number, dst: buffer?): (buffer, number, number)
	local hw, hh = w // 2, h // 2
	local out = dst or buffer.create(math.max(hw * hh * 4, 4))
	local srcRow = w * 4
	local o = 0
	for y = 0, hh - 1 do
		local r0 = y * 2 * srcRow
		local r1 = r0 + srcRow
		for x = 0, hw - 1 do
			local a0 = r0 + x * 8
			local b0 = r1 + x * 8
			local p = buffer.readu32(src, a0)
			local q = buffer.readu32(src, a0 + 4)
			local s = buffer.readu32(src, b0)
			local t = buffer.readu32(src, b0 + 4)
			local rb = bit32.band(p, 0x00FF00FF)
				+ bit32.band(q, 0x00FF00FF)
				+ bit32.band(s, 0x00FF00FF)
				+ bit32.band(t, 0x00FF00FF)
				+ 0x00020002
			local ga = bit32.band(bit32.rshift(p, 8), 0x00FF00FF)
				+ bit32.band(bit32.rshift(q, 8), 0x00FF00FF)
				+ bit32.band(bit32.rshift(s, 8), 0x00FF00FF)
				+ bit32.band(bit32.rshift(t, 8), 0x00FF00FF)
				+ 0x00020002
			buffer.writeu32(
				out,
				o,
				bit32.band(bit32.rshift(rb, 2), 0x00FF00FF) + bit32.band(bit32.rshift(ga, 2), 0x00FF00FF) * 256
			)
			o += 4
		end
	end
	return out, hw, hh
end

-- Premultiplied-correct 2 x 2 box filter: averages colour weighted by alpha, so a
-- transparent neighbour never darkens or tints an edge. Slower than the SWAR one
-- (about 2x); use it for content with soft alpha edges.
function Pixels.downsample2xAlphaWeighted(src: buffer, w: number, h: number, dst: buffer?): (buffer, number, number)
	local hw, hh = w // 2, h // 2
	local out = dst or buffer.create(math.max(hw * hh * 4, 4))
	local srcRow = w * 4
	local o = 0
	for y = 0, hh - 1 do
		local r0 = y * 2 * srcRow
		local r1 = r0 + srcRow
		for x = 0, hw - 1 do
			local a0 = r0 + x * 8
			local b0 = r1 + x * 8
			local sr, sg, sb, sa = 0, 0, 0, 0
			for k = 1, 4 do
				local at = if k == 1 then a0 elseif k == 2 then a0 + 4 elseif k == 3 then b0 else b0 + 4
				local px = buffer.readu32(src, at)
				local a = px // 16777216
				sr += (px % 256) * a
				sg += ((px // 256) % 256) * a
				sb += ((px // 65536) % 256) * a
				sa += a
			end
			if sa > 0 then
				buffer.writeu32(out, o, pack((sr / sa + 0.5) // 1, (sg / sa + 0.5) // 1, (sb / sa + 0.5) // 1, (sa + 2) // 4))
			else
				-- fully transparent: keep the plain average colour so later mips still bleed
				local p = buffer.readu32(src, a0)
				buffer.writeu32(out, o, p % 16777216)
			end
			o += 4
		end
	end
	return out, hw, hh
end

-- Source-over for straight alpha, in place: dst = src over dst, `count` pixels.
-- The float form measured fastest in the interpreter (fewer builtin calls than SWAR).
function Pixels.blendOver(dst: buffer, dstAt: number, src: buffer, srcAt: number, count: number)
	for i = 0, count - 1 do
		local s = buffer.readu32(src, srcAt + i * 4)
		local sa = s // 16777216
		if sa == 0 then
			continue
		end
		local o = dstAt + i * 4
		if sa == 255 then
			buffer.writeu32(dst, o, s)
			continue
		end
		local d = buffer.readu32(dst, o)
		local da = d // 16777216
		local fs = sa / 255
		local fd = (da / 255) * (1 - fs)
		local oa = fs + fd
		local ws, wd = fs / oa, fd / oa
		local r = (s % 256) * ws + (d % 256) * wd
		local g = ((s // 256) % 256) * ws + ((d // 256) % 256) * wd
		local b = ((s // 65536) % 256) * ws + ((d // 65536) % 256) * wd
		buffer.writeu32(dst, o, pack((r + 0.5) // 1, (g + 0.5) // 1, (b + 0.5) // 1, (oa * 255 + 0.5) // 1))
	end
end

-- Alpha bleeding (colour dilation): every fully transparent pixel next to a visible
-- one takes that neighbour's RGB while keeping alpha 0, repeated `passes` times.
-- Bilinear filtering of straight-alpha textures then never pulls in a foreign
-- colour at the edge: if RGB is constant across an alpha edge, filtering straight
-- alpha equals filtering premultiplied alpha (docs/DESIGN.md, axiom A8).
function Pixels.bleed(buf: buffer, w: number, h: number, passes: number?)
	local n = w * h
	local known = buffer.create(n) -- 1 = pixel has a trusted colour
	for i = 0, n - 1 do
		if buffer.readu8(buf, i * 4 + 3) > 0 then
			buffer.writeu8(known, i, 1)
		end
	end
	local frontier = {}
	for _ = 1, passes or 4 do
		table.clear(frontier)
		for y = 0, h - 1 do
			for x = 0, w - 1 do
				local i = y * w + x
				if buffer.readu8(known, i) == 0 then
					local sr, sg, sb, c = 0, 0, 0, 0
					if x > 0 and buffer.readu8(known, i - 1) == 1 then
						local p = buffer.readu32(buf, (i - 1) * 4)
						sr += p % 256
						sg += (p // 256) % 256
						sb += (p // 65536) % 256
						c += 1
					end
					if x < w - 1 and buffer.readu8(known, i + 1) == 1 then
						local p = buffer.readu32(buf, (i + 1) * 4)
						sr += p % 256
						sg += (p // 256) % 256
						sb += (p // 65536) % 256
						c += 1
					end
					if y > 0 and buffer.readu8(known, i - w) == 1 then
						local p = buffer.readu32(buf, (i - w) * 4)
						sr += p % 256
						sg += (p // 256) % 256
						sb += (p // 65536) % 256
						c += 1
					end
					if y < h - 1 and buffer.readu8(known, i + w) == 1 then
						local p = buffer.readu32(buf, (i + w) * 4)
						sr += p % 256
						sg += (p // 256) % 256
						sb += (p // 65536) % 256
						c += 1
					end
					if c > 0 then
						table.insert(frontier, i)
						table.insert(frontier, pack((sr / c + 0.5) // 1, (sg / c + 0.5) // 1, (sb / c + 0.5) // 1, 0))
					end
				end
			end
		end
		if #frontier == 0 then
			break
		end
		for k = 1, #frontier, 2 do
			local i = frontier[k]
			buffer.writeu32(buf, i * 4, frontier[k + 1])
			buffer.writeu8(known, i, 1)
		end
	end
end

-- Expands an 8-bit indexed image through a 256-entry palette buffer of u32 colours.
function Pixels.expandIndexed(indices: buffer, palette: buffer, dst: buffer, count: number)
	local o = 0
	for i = 0, count - 1 do
		buffer.writeu32(dst, o, buffer.readu32(palette, buffer.readu8(indices, i) * 4))
		o += 4
	end
end

-- Counts pixels that differ between two equal-sized images; optional channel mask
-- (default all four bytes).
function Pixels.diff(a: buffer, b: buffer, count: number, ignoreRgbUnderZeroAlpha: boolean?): number
	local n = 0
	for i = 0, count - 1 do
		local p = buffer.readu32(a, i * 4)
		local q = buffer.readu32(b, i * 4)
		if p ~= q then
			if ignoreRgbUnderZeroAlpha and p // 16777216 == 0 and q // 16777216 == 0 then
				continue
			end
			n += 1
		end
	end
	return n
end

return Pixels
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="8">
        <Properties>
          <string name="Name">compute</string>
        </Properties>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Coverage</string>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: compute/Coverage
--
-- Pixel coverage: the fraction of a unit pixel square inside a shape (a box
-- filter, which is what "anti-aliased" means here). docs/COMPUTE.md 3.3.
--
-- Estimators (deterministic: + - * / sqrt abs and comparisons only):
--   linear(d, w)            clamp(0.5 - d / w, 0, 1): the distance ramp used by
--                           MyMath.coverage. Exact only for axis-aligned edges;
--                           up to 10.94/255 on a 45 degree edge (C3).
--   halfPlane(d, nx, ny)    exact area of the pixel inside the tangent half-plane
--                           (SDF value d at the centre, unit gradient (nx, ny)).
--                           Exact for straight edges (C4); on a curve of radius R
--                           it overestimates by at most (sqrt(2)/2)^3 / (3 R),
--                           i.e. 30/R in 1/255 units (C5). = MyMath.coverageHalfPlane
--   halfPlaneCurved(...)    half-plane minus the first-order curvature term over
--                           the chord. The residual is O(1/R) where the chord
--                           leaves the pixel at a shallow angle (measured 0.36/255
--                           at R = 8, 0.036 at R = 48, 0.002 at R = 300): an
--                           estimator, not flawless. = MyMath.coverageCurved
--   corner, edgePair        exact areas where two edges enter the pixel (C6).
--   discRectArea, roundCorner, dasin   exact disc pieces with a deterministic
--                           arcsine: usable for texture content.
--   supersample(...)        n x n point samples (NOT a reference: 1/(2n) error).
--
-- Exact areas used by the flawless pipeline (F1, F2; deterministic, allocation-free):
--   datan2(s, c)            deterministic atan2 from dasin (arguments <= sqrt(2)/2)
--   discBoxArea(...)        disc and axis-aligned rectangle, by quadrant integration
--   discPolyArea(...)       disc and convex polygon, by signed disc-triangle areas
--   polygonBoxCoverage(...) simple polygon and pixel box, by per-edge integrals
--   clipInto, polyArea      Sutherland-Hodgman half-plane clip and shoelace on
--                           caller-owned scratch arrays
--
-- References for tests and benchmarks:
--   circleArea(...)         exact area of circle and pixel (closed form; uses
--                           math.asin, so REFERENCE ONLY, never texture content)
--   polygonArea(...)        exact area of polygon and pixel (clip + shoelace)

local MyMath = require("../MyMath")

local Coverage = {}

local abs = math.abs
local sqrt = math.sqrt

function Coverage.linear(d: number, w: number): number
	local a = 0.5 - d / w
	return if a < 0 then 0 elseif a > 1 then 1 else a
end

-- Exact area of {q in pixel : d + n . (q - centre) <= 0} for |n| = 1 (C4).
-- The projection of the unit square on n has a trapezoid density: ramps of width
-- b = min(|nx|, |ny|) and a plateau of width a - b, a = max(|nx|, |ny|).
-- The axiom lives in MyMath; this is the same function (bit-identical).
local halfPlane = MyMath.coverageHalfPlane
Coverage.halfPlane = halfPlane

-- The largest |d| at which halfPlane can be strictly between 0 and 1: (a + b) / 2
-- <= sqrt(2) / 2. Tile culling for exact coverage uses this instead of w / 2.
Coverage.HALF_PLANE_REACH = MyMath.COVERAGE_REACH

-- Curvature-corrected coverage (docs/COMPUTE.md C5): half-plane area minus the
-- first-order term k (t1^3 - t0^3) / 6 over the chord the tangent line cuts from
-- the pixel. The axiom lives in MyMath; this is the same function (bit-identical).
local halfPlaneCurved = MyMath.coverageCurved
Coverage.halfPlaneCurved = halfPlaneCurved

-- Exact area of the unit pixel square centred at the origin intersected with up to
-- two half-planes {q : n1 . q <= c1} and {q : n2 . q <= c2} (normals need not be
-- unit length). Sutherland-Hodgman with preallocated scratch arrays, then the
-- shoelace formula: no allocation, deterministic ops only. Used for polygon
-- vertices, where the boundary is a wedge (two edges) and no single half-plane
-- describes it. Pass n2x = n2y = 0, c2 = 1 for one half-plane.
local SX: { number } = table.create(16, 0)
local SY: { number } = table.create(16, 0)
local TX: { number } = table.create(16, 0)
local TY: { number } = table.create(16, 0)

-- Sutherland-Hodgman: clips polygon (ax, ay)[1..n] to {q : nx qx + ny qy <= c},
-- writing the result into (bx, by) and returning its vertex count. For a convex
-- input the output is the convex intersection; for any input its signed area is
-- the area of the clipped region (bridges along the clip line cancel).
local function clipInto(ax: { number }, ay: { number }, n: number, bx: { number }, by: { number }, nx: number, ny: number, c: number): number
	local m = 0
	if n == 0 then
		return 0
	end
	local px, py = ax[n], ay[n]
	local pv = nx * px + ny * py - c
	for i = 1, n do
		local qx, qy = ax[i], ay[i]
		local qv = nx * qx + ny * qy - c
		if qv <= 0 then
			if pv > 0 then
				local t = pv / (pv - qv)
				m += 1
				bx[m] = px + (qx - px) * t
				by[m] = py + (qy - py) * t
			end
			m += 1
			bx[m] = qx
			by[m] = qy
		elseif pv <= 0 then
			local t = pv / (pv - qv)
			m += 1
			bx[m] = px + (qx - px) * t
			by[m] = py + (qy - py) * t
		end
		px, py, pv = qx, qy, qv
	end
	return m
end
Coverage.clipInto = clipInto

-- Signed shoelace area of (x, y)[1..n] (positive for counter-clockwise order in a
-- right-handed frame, i.e. when every edge has the interior on its left).
local function polyArea(x: { number }, y: { number }, n: number): number
	if n < 3 then
		return 0
	end
	local s = 0
	local px, py = x[n], y[n]
	for i = 1, n do
		local qx, qy = x[i], y[i]
		s += px * qy - qx * py
		px, py = qx, qy
	end
	return s * 0.5
end
Coverage.polyArea = polyArea

local function squareClip2(n1x: number, n1y: number, c1: number, n2x: number, n2y: number, c2: number): number
	SX[1], SY[1] = -0.5, -0.5
	SX[2], SY[2] = 0.5, -0.5
	SX[3], SY[3] = 0.5, 0.5
	SX[4], SY[4] = -0.5, 0.5
	local m = clipInto(SX, SY, 4, TX, TY, n1x, n1y, c1)
	m = clipInto(TX, TY, m, SX, SY, n2x, n2y, c2)
	if m < 3 then
		return 0
	end
	local s = 0
	local px, py = SX[m], SY[m]
	for i = 1, m do
		local qx, qy = SX[i], SY[i]
		s += px * qy - qx * py
		px, py = qx, qy
	end
	s = abs(s) * 0.5
	return if s > 1 then 1 else s
end
Coverage.squareClip2 = squareClip2

-- Exact coverage of the pixel centred at (px, py) by the polygon corner at vertex
-- v = (vx, vy) between the incoming edge (from u) and the outgoing edge (to w),
-- for a polygon of orientation sigma (+1 or -1, the sign of its shoelace area).
-- Exact whenever no other edge of the polygon enters the pixel.
function Coverage.corner(px: number, py: number, ux: number, uy: number, vx: number, vy: number, wx: number, wy: number, sigma: number): number
	-- inner side of edge a->b: sigma * cross(b - a, q - a) >= 0, i.e. n . q <= c
	-- with n = sigma * (by - ay, -(bx - ax)); shift q to pixel-local coordinates
	local e1x, e1y = vx - ux, vy - uy
	local e2x, e2y = wx - vx, wy - vy
	local n1x, n1y = sigma * e1y, -sigma * e1x
	local n2x, n2y = sigma * e2y, -sigma * e2x
	local c1 = n1x * (vx - px) + n1y * (vy - py)
	local c2 = n2x * (vx - px) + n2y * (vy - py)
	local convex = sigma * (e1x * e2y - e1y * e2x) >= 0
	if convex then
		return squareClip2(n1x, n1y, c1, n2x, n2y, c2)
	end
	-- reflex: the polygon is locally the union of the two half-planes
	local a1 = squareClip2(n1x, n1y, c1, 0, 0, 1)
	local a2 = squareClip2(n2x, n2y, c2, 0, 0, 1)
	local a12 = squareClip2(n1x, n1y, c1, n2x, n2y, c2)
	local a = a1 + a2 - a12
	return if a < 0 then 0 elseif a > 1 then 1 else a
end

-- Deterministic arcsine: Taylor series on |x| <= 1/2 (28 terms: the first omitted
-- term is below 2e-20 at |x| = 1/2, so the result is within a few double rounding
-- units), and asin(x) = pi/2 - 2 asin(sqrt((1 - x) / 2)) above. Only + - * / sqrt,
-- so it is bit-identical on every platform, unlike math.asin. (An 18-term version
-- truncated at 7e-14, which became visible in sector areas of discs with radii
-- in the thousands; docs/COMPUTE.md "Flawless pipeline".)
local ASIN_TERMS = 28
local ASIN_C: { number } = {}
do
	-- c_n = (2n)! / (4^n (n!)^2 (2n + 1))
	local c = 1
	for n = 0, ASIN_TERMS - 1 do
		ASIN_C[n + 1] = c / (2 * n + 1)
		c = c * (2 * n + 1) / (2 * n + 2)
	end
end
local HALF_PI = 1.5707963267948966

local function asinSmall(x: number): number
	local x2 = x * x
	local s = ASIN_C[ASIN_TERMS]
	for i = ASIN_TERMS - 1, 1, -1 do
		s = s * x2 + ASIN_C[i]
	end
	return x * s
end

local function dasin(x: number): number
	local ax = abs(x)
	local r
	if ax <= 0.5 then
		return asinSmall(x)
	elseif ax >= 1 then
		r = HALF_PI
	else
		r = HALF_PI - 2 * asinSmall(sqrt((1 - ax) * 0.5))
	end
	return if x < 0 then -r else r
end
Coverage.dasin = dasin

-- Integral of sqrt(r^2 - t^2) from 0 to t (|t| <= r), deterministic.
local QUARTER_PI = 0.78539816339744831
local function chordIntegralDet(t: number, r: number): number
	if t >= r then
		return QUARTER_PI * r * r
	elseif t <= -r then
		return -QUARTER_PI * r * r
	end
	return 0.5 * (t * sqrt(r * r - t * t) + r * r * dasin(t / r))
end

-- Exact area of the disc (cx, cy, r) inside the rectangle [x0, x1] x [y0, y1],
-- deterministic and allocation-free (cuts kept in a fixed scratch array and
-- insertion-sorted). Same method as circleArea: split x where min/max switch.
local CUT: { number } = table.create(8, 0)

-- Inserts x into CUT[1..n] (sorted) when x0 < x < x1; returns the new count.
local function insertCut(n: number, x: number, x0: number, x1: number): number
	if x > x0 and x < x1 then
		n += 1
		local i = n
		while i > 1 and CUT[i - 1] > x do
			CUT[i] = CUT[i - 1]
			i -= 1
		end
		CUT[i] = x
	end
	return n
end

local function discRectArea(cx: number, cy: number, r: number, x0: number, y0: number, x1: number, y1: number): number
	if x1 <= x0 or y1 <= y0 or r <= 0 then
		return 0
	end
	local n = insertCut(0, cx - r, x0, x1)
	n = insertCut(n, cx + r, x0, x1)
	local dy0 = y0 - cy
	if abs(dy0) < r then
		local hw = sqrt(r * r - dy0 * dy0)
		n = insertCut(n, cx - hw, x0, x1)
		n = insertCut(n, cx + hw, x0, x1)
	end
	local dy1 = y1 - cy
	if abs(dy1) < r then
		local hw = sqrt(r * r - dy1 * dy1)
		n = insertCut(n, cx - hw, x0, x1)
		n = insertCut(n, cx + hw, x0, x1)
	end
	local area = 0
	local a = x0
	for i = 1, n + 1 do
		local b = if i <= n then CUT[i] else x1
		if b > a then
			local m = (a + b) * 0.5 - cx
			if abs(m) < r then
				local hm = sqrt(r * r - m * m)
				local upperIsCircle = cy + hm < y1
				local lowerIsCircle = cy - hm > y0
				local top = if upperIsCircle then cy + hm else y1
				local bot = if lowerIsCircle then cy - hm else y0
				if top > bot then
					local len = b - a
					local hInt = if upperIsCircle or lowerIsCircle then chordIntegralDet(b - cx, r) - chordIntegralDet(a - cx, r) else 0
					local upper = if upperIsCircle then cy * len + hInt else y1 * len
					local lower = if lowerIsCircle then cy * len - hInt else y0 * len
					area += upper - lower
				end
			end
		end
		a = b
	end
	return area
end
Coverage.discRectArea = discRectArea

----------------------------------------------------------------------------------
-- Exact areas for the flawless pipeline (docs/COMPUTE.md "Flawless pipeline")
----------------------------------------------------------------------------------

local PI = 3.141592653589793

-- Deterministic atan2: the angle of the vector (c, s) in (-pi, pi]. Each branch
-- calls dasin with an argument of magnitude at most sqrt(2)/2, where the arcsine
-- is well conditioned (derivative <= sqrt(2)), so the absolute error stays near
-- the double rounding unit for every angle, including angles near 0 and pi.
local function datan2(s: number, c: number): number
	local m = sqrt(s * s + c * c)
	if m == 0 then
		return 0
	end
	local as = abs(s) / m
	local ac = c / m
	local t
	if ac >= as then
		t = dasin(as) -- |angle| <= 45 degrees
	elseif ac >= -as then
		t = HALF_PI - dasin(ac) -- 45 to 135 degrees
	else
		t = PI - dasin(as) -- 135 to 180 degrees
	end
	return if s < 0 then -t else t
end
Coverage.datan2 = datan2

-- Area of disc(0, r) inside [a, b] x [c, d] with 0 <= a < b and 0 <= c < d (the
-- first quadrant, where the upper circle y = sqrt(r^2 - x^2) decreases). For x <=
-- xd the circle is at height >= d (full column), for x >= xc it is below c (empty
-- column), in between the column height is sqrt(r^2 - x^2) - c, integrated in
-- closed form with one arcsine: asin(q/r) - asin(p/r) = asin((q sp - p sq) / r^2)
-- for 0 <= p <= q <= r, where sp, sq are the circle heights at p and q. The caller
-- orients the piece so the integration runs along the axis on which the circle is
-- flatter (heights stay large, no cancellation in r^2 - x^2).
local function quadrantArea(a: number, b: number, c: number, d: number, r: number, r2: number): number
	if a * a + c * c >= r2 then
		return 0
	end
	if b * b + d * d <= r2 then
		return (b - a) * (d - c)
	end
	-- (single assignments: a call in the last position of a multiple assignment
	-- types as optional in strict mode)
	local p, sp = 0, r
	if d < r then
		p = sqrt(r2 - d * d)
		sp = d
	end
	if p < a then
		p = a
		sp = sqrt(r2 - a * a)
	elseif p > b then
		p = b
		sp = sqrt(r2 - b * b)
	end
	local q = sqrt(r2 - c * c)
	local sq = c
	if q > b then
		q = b
		sq = sqrt(r2 - b * b)
	elseif q < a then
		q = a
		sq = sqrt(r2 - a * a)
	end
	local area = (d - c) * (p - a)
	if q > p then
		area += 0.5 * (q * sq - p * sp) + 0.5 * r2 * dasin((q * sp - p * sq) / r2) - c * (q - p)
	end
	return area
end

-- One quadrant piece [a, b] x [c, d] (already reflected into the first quadrant),
-- integrated along the axis where the piece lies closer to the circle's centre line.
local function quadrantPiece(a: number, b: number, c: number, d: number, r: number, r2: number): number
	if b <= a or d <= c then
		return 0
	end
	if a + b > c + d then
		return quadrantArea(c, d, a, b, r, r2)
	end
	return quadrantArea(a, b, c, d, r, r2)
end

-- Exact area of the disc (cx, cy, r) inside the rectangle [x0, x1] x [y0, y1].
-- The rectangle is split by the disc's centre lines into at most four pieces, each
-- reflected into the first quadrant and integrated in closed form (quadrantArea).
-- No topology (no walking of intersection points), so tangencies and corners on
-- the circle cannot flip a branch: the result is continuous in every input.
-- Deterministic (+ - * / sqrt and dasin), allocation-free.
local function discBoxArea(cx: number, cy: number, r: number, x0: number, y0: number, x1: number, y1: number): number
	if r <= 0 or x1 <= x0 or y1 <= y0 then
		return 0
	end
	local X0, X1, Y0, Y1 = x0 - cx, x1 - cx, y0 - cy, y1 - cy
	if X0 >= r or X1 <= -r or Y0 >= r or Y1 <= -r then
		return 0
	end
	local r2 = r * r
	-- x pieces: right [ra, rb] (x >= 0) and left mirrored [la, lb] (x <= 0)
	local ra = if X0 > 0 then X0 else 0
	local rb = X1
	local la = if X1 < 0 then -X1 else 0
	local lb = -X0
	local ta = if Y0 > 0 then Y0 else 0
	local tb = Y1
	local ba = if Y1 < 0 then -Y1 else 0
	local bb = -Y0
	local area = 0
	if rb > ra then
		area += quadrantPiece(ra, rb, ta, tb, r, r2) + quadrantPiece(ra, rb, ba, bb, r, r2)
	end
	if lb > la then
		area += quadrantPiece(la, lb, ta, tb, r, r2) + quadrantPiece(la, lb, ba, bb, r, r2)
	end
	return area
end
Coverage.discBoxArea = discBoxArea

-- Signed area of disc(0, r) intersected with the triangle (0, A, B): the part of
-- the segment A-B inside the circle contributes its triangle with the centre, the
-- parts outside contribute circular sectors r^2/2 * angle. Each edge's term is
-- computed independently (no pairing of intersection points), so the sum over a
-- polygon's edges is robust to tangencies and vertices on the circle.
local function triDisc(ax: number, ay: number, bx: number, by: number, r2: number): number
	local aa = ax * ax + ay * ay
	local bb = bx * bx + by * by
	if aa <= r2 and bb <= r2 then
		return 0.5 * (ax * by - ay * bx)
	end
	local half = 0.5 * r2
	local dx, dy = bx - ax, by - ay
	local A = dx * dx + dy * dy
	if A == 0 then
		return 0
	end
	local B = ax * dx + ay * dy
	local C = aa - r2
	local disc = B * B - A * C
	if disc <= 0 then
		return half * datan2(ax * by - ay * bx, ax * bx + ay * by)
	end
	local sd = sqrt(disc)
	-- roots of A t^2 + 2 B t + C = 0, the stable way (no cancellation)
	local t1, t2
	if B >= 0 then
		local q = -(B + sd)
		t1, t2 = q / A, C / q
	else
		local q = sd - B
		t1, t2 = C / q, q / A
	end
	local u1 = if t1 > 0 then t1 else 0
	local u2 = if t2 < 1 then t2 else 1
	if u1 >= u2 then
		return half * datan2(ax * by - ay * bx, ax * bx + ay * by)
	end
	local p1x, p1y = ax + u1 * dx, ay + u1 * dy
	local p2x, p2y = ax + u2 * dx, ay + u2 * dy
	local area = 0.5 * (p1x * p2y - p1y * p2x)
	if u1 > 0 then
		area += half * datan2(ax * p1y - ay * p1x, ax * p1x + ay * p1y)
	end
	if u2 < 1 then
		area += half * datan2(p2x * by - p2y * bx, p2x * bx + p2y * by)
	end
	return area
end

-- Exact signed area of the disc (cx, cy, r) intersected with the polygon
-- (px, py)[1..n] (positive for counter-clockwise polygons). Exact for any simple
-- polygon (the disc-triangle terms add up by Green's theorem); the flawless
-- pipeline calls it with small convex polygons in pixel-local coordinates.
local function discPolyArea(px: { number }, py: { number }, n: number, cx: number, cy: number, r: number): number
	if n < 3 or r <= 0 then
		return 0
	end
	local r2 = r * r
	local s = 0
	local ax, ay = px[n] - cx, py[n] - cy
	for i = 1, n do
		local bx, by = px[i] - cx, py[i] - cy
		s += triDisc(ax, ay, bx, by, r2)
		ax, ay = bx, by
	end
	return s
end
Coverage.discPolyArea = discPolyArea

-- Mean of clamp(t, 0, 1) for t running linearly from a to b.
local function avgClamp01(a: number, b: number): number
	if a > b then
		a, b = b, a
	end
	if b <= 0 then
		return 0
	end
	if a >= 1 then
		return 1
	end
	if a >= 0 and b <= 1 then
		return (a + b) * 0.5
	end
	-- G(t) = integral of clamp(s, 0, 1) ds from 0 to t
	local ga = if a <= 0 then 0 else a * a * 0.5
	local gb = if b >= 1 then b - 0.5 else b * b * 0.5
	return (gb - ga) / (b - a)
end

-- Signed coverage of the w x w box with lower corner (x0, y0) by the polygon
-- v[first], v[first + 1], ... (count vertices, flat x, y pairs), in units of the
-- box area. By Green's theorem the area of polygon and box is the sum over edges
-- of dir * integral over the edge's y-span inside the box of (x1 - clamp(x, x0,
-- x1)) dy: the part of the box row to the right of the edge, signed by the edge's
-- vertical direction. Each edge is a linear x(y), so the clamped integral has a
-- closed form (avgClamp01). Exact for simple polygons of either orientation (the
-- sign of the result is the orientation); edges whose y-span misses the box cost
-- two comparisons. Deterministic, allocation-free.
local function polygonBoxCoverage(v: { number }, first: number, count: number, x0: number, y0: number, w: number): number
	local iw = 1 / w
	local y1 = y0 + w
	local s = 0
	local last = first + 2 * count - 2
	local ax, ay = v[last], v[last + 1]
	for i = first, last, 2 do
		local bx, by = v[i], v[i + 1]
		if ay ~= by then
			local lx, ly, hx, hy, dir = ax, ay, bx, by, 1
			if ay > by then
				lx, ly, hx, hy, dir = bx, by, ax, ay, -1
			end
			if hy > y0 and ly < y1 then
				local lo = if ly > y0 then ly else y0
				local hi = if hy < y1 then hy else y1
				local slope = (hx - lx) / (hy - ly)
				local ul = (lx + (lo - ly) * slope - x0) * iw
				local uh = (lx + (hi - ly) * slope - x0) * iw
				s += dir * (hi - lo) * iw * (1 - avgClamp01(ul, uh))
			end
		end
		ax, ay = bx, by
	end
	return s
end
Coverage.polygonBoxCoverage = polygonBoxCoverage

-- Nearest point of the segment a + t e (0 <= t <= 1) to (px, py), relative to (px, py).
local function nearestLocal(px: number, py: number, ax: number, ay: number, ex: number, ey: number): (number, number)
	local ee = ex * ex + ey * ey
	local t = if ee > 0 then ((px - ax) * ex + (py - ay) * ey) / ee else 0
	t = if t < 0 then 0 elseif t > 1 then 1 else t
	return ax + ex * t - px, ay + ey * t - py
end

-- Exact coverage of the pixel centred at (px, py) by a polygon locally bounded by
-- two non-adjacent edges a1->b1 and a2->b2 (polygon order, orientation sigma).
-- The edges cut the pixel into an outer part, a between part and another outer
-- part, and inside/outside alternates across each edge. If the inner sides face
-- each other the polygon is locally H1 and H2 (a sliver); if they face away it is
-- H1 or H2 (a gap). Otherwise (a third edge must be involved) it falls back to the
-- nearer edge alone. Exact whenever only these two edges enter the pixel.
function Coverage.edgePair(
	px: number,
	py: number,
	a1x: number,
	a1y: number,
	b1x: number,
	b1y: number,
	a2x: number,
	a2y: number,
	b2x: number,
	b2y: number,
	sigma: number
): number
	local e1x, e1y = b1x - a1x, b1y - a1y
	local e2x, e2y = b2x - a2x, b2y - a2y
	local n1x, n1y = sigma * e1y, -sigma * e1x
	local n2x, n2y = sigma * e2y, -sigma * e2x
	local c1 = n1x * (a1x - px) + n1y * (a1y - py)
	local c2 = n2x * (a2x - px) + n2y * (a2y - py)
	local q1x, q1y = nearestLocal(px, py, a1x, a1y, e1x, e1y)
	local q2x, q2y = nearestLocal(px, py, a2x, a2y, e2x, e2y)
	local twoInOne = n1x * q2x + n1y * q2y <= c1
	local oneInTwo = n2x * q1x + n2y * q1y <= c2
	if twoInOne and oneInTwo then
		return squareClip2(n1x, n1y, c1, n2x, n2y, c2)
	elseif not twoInOne and not oneInTwo then
		local a = squareClip2(n1x, n1y, c1, 0, 0, 1) + squareClip2(n2x, n2y, c2, 0, 0, 1) - squareClip2(n1x, n1y, c1, n2x, n2y, c2)
		return if a < 0 then 0 elseif a > 1 then 1 else a
	end
	if q1x * q1x + q1y * q1y <= q2x * q2x + q2y * q2y then
		return squareClip2(n1x, n1y, c1, 0, 0, 1)
	end
	return squareClip2(n2x, n2y, c2, 0, 0, 1)
end

-- Exact coverage of a w x w pixel box centred at (X, Y) by a rounded-box corner in
-- corner-local coordinates (arc centre at the origin, the box extends towards
-- negative X and Y): {X <= 0, Y <= rad} or {Y <= 0, X <= rad} or the disc of
-- radius rad. Split into two rectangles and a disc-rectangle piece. Returns area
-- divided by w^2.
function Coverage.roundCorner(X: number, Y: number, rad: number, w: number): number
	local h = w * 0.5
	local a0, a1, b0, b1 = X - h, X + h, Y - h, Y + h
	local area = 0
	-- part 1: X' <= 0 and Y' <= rad
	local ux = (if a1 < 0 then a1 else 0) - a0
	local uy = (if b1 < rad then b1 else rad) - b0
	if ux > 0 and uy > 0 then
		area += ux * uy
	end
	-- part 2: 0 < X' <= rad and Y' <= 0
	local vx = (if a1 < rad then a1 else rad) - (if a0 > 0 then a0 else 0)
	local vy = (if b1 < 0 then b1 else 0) - b0
	if vx > 0 and vy > 0 then
		area += vx * vy
	end
	-- part 3: X' > 0, Y' > 0 inside the disc
	if a1 > 0 and b1 > 0 then
		area += discRectArea(0, 0, rad, if a0 > 0 then a0 else 0, if b0 > 0 then b0 else 0, a1, b1)
	end
	local c = area / (w * w)
	return if c > 1 then 1 else c
end

-- Curvature-corrected circle coverage (k = 1 / r).
function Coverage.circleCurved(px: number, py: number, cx: number, cy: number, r: number): number
	local dx, dy = px - cx, py - cy
	local len = sqrt(dx * dx + dy * dy)
	if len == 0 then
		return if r > 0.70710678118654757 then 1 else halfPlane(-r, 1, 0)
	end
	return halfPlaneCurved(len - r, dx / len, dy / len, 1 / r)
end

-- Exact coverage estimate for a circle from its SDF (centre distance minus r).
function Coverage.circleHalfPlane(px: number, py: number, cx: number, cy: number, r: number): number
	local dx, dy = px - cx, py - cy
	local len = sqrt(dx * dx + dy * dy)
	if len == 0 then
		return if r > 0.70710678118654757 then 1 else halfPlane(-r, 1, 0)
	end
	return halfPlane(len - r, dx / len, dy / len)
end

----------------------------------------------------------------------------------
-- Exact references
----------------------------------------------------------------------------------

-- Integral of sqrt(r^2 - t^2) dt from 0 to t, |t| <= r. Reference only (asin).
local function chordIntegral(t: number, r: number): number
	if t >= r then
		return math.pi * r * r * 0.25
	elseif t <= -r then
		return -math.pi * r * r * 0.25
	end
	return 0.5 * (t * sqrt(r * r - t * t) + r * r * math.asin(t / r))
end

-- Exact area of the disc (cx, cy, r) inside the square [x0, x0 + 1] x [y0, y0 + 1].
-- Integrates max(0, min(y1, cy + h) - max(y0, cy - h)) over x, splitting at every
-- x where one of the min/max switches, so each piece is a constant or +-h + const.
function Coverage.circleArea(cx: number, cy: number, r: number, x0: number, y0: number): number
	local x1, y1 = x0 + 1, y0 + 1
	local cuts = { x0, x1 }
	local function cut(x: number)
		if x > x0 and x < x1 then
			table.insert(cuts, x)
		end
	end
	cut(cx - r)
	cut(cx + r)
	for _, yb in { y0, y1 } do
		local dy = yb - cy
		if abs(dy) < r then
			local hw = sqrt(r * r - dy * dy)
			cut(cx - hw)
			cut(cx + hw)
		end
	end
	table.sort(cuts)
	local area = 0
	for i = 1, #cuts - 1 do
		local a, b = cuts[i], cuts[i + 1]
		if b - a <= 0 then
			continue
		end
		local m = (a + b) * 0.5 - cx
		if abs(m) >= r then
			continue
		end
		local hm = sqrt(r * r - m * m)
		local upperIsCircle = cy + hm < y1
		local lowerIsCircle = cy - hm > y0
		local top = if upperIsCircle then cy + hm else y1
		local bot = if lowerIsCircle then cy - hm else y0
		if top <= bot then
			continue
		end
		local len = b - a
		local hInt = chordIntegral(b - cx, r) - chordIntegral(a - cx, r)
		local upper = if upperIsCircle then cy * len + hInt else y1 * len
		local lower = if lowerIsCircle then cy * len - hInt else y0 * len
		area += upper - lower
	end
	return area
end

-- Sutherland-Hodgman clip of a polygon (flat list) against x >= k (sx = 1),
-- x <= k (sx = -1), y >= k (sy = 1) or y <= k (sy = -1).
local function clipAxis(pts: { number }, axis: number, k: number, sgn: number): { number }
	local out = {}
	local n = #pts // 2
	if n == 0 then
		return out
	end
	local px, py = pts[2 * n - 1], pts[2 * n]
	local pv = (if axis == 0 then px else py) * sgn - k * sgn
	for i = 1, n do
		local qx, qy = pts[2 * i - 1], pts[2 * i]
		local qv = (if axis == 0 then qx else qy) * sgn - k * sgn
		if qv >= 0 then
			if pv < 0 then
				local t = pv / (pv - qv)
				table.insert(out, px + (qx - px) * t)
				table.insert(out, py + (qy - py) * t)
			end
			table.insert(out, qx)
			table.insert(out, qy)
		elseif pv >= 0 then
			local t = pv / (pv - qv)
			table.insert(out, px + (qx - px) * t)
			table.insert(out, py + (qy - py) * t)
		end
		px, py, pv = qx, qy, qv
	end
	return out
end

local function shoelace(pts: { number }): number
	local n = #pts // 2
	local s = 0
	for i = 1, n do
		local j = if i == n then 1 else i + 1
		s += pts[2 * i - 1] * pts[2 * j] - pts[2 * j - 1] * pts[2 * i]
	end
	return s * 0.5
end
Coverage.shoelace = shoelace

-- Exact area of a simple polygon inside the square [x0, x0 + 1] x [y0, y0 + 1].
function Coverage.polygonArea(pts: { number }, x0: number, y0: number): number
	local p = clipAxis(pts, 0, x0, 1)
	p = clipAxis(p, 0, x0 + 1, -1)
	p = clipAxis(p, 1, y0, 1)
	p = clipAxis(p, 1, y0 + 1, -1)
	return abs(shoelace(p))
end

-- Fraction of n x n sample points (cell centres) for which inside(x, y) is true.
function Coverage.supersample(inside: (number, number) -> boolean, x0: number, y0: number, n: number): number
	local hits = 0
	local step = 1 / n
	for j = 0, n - 1 do
		local y = y0 + (j + 0.5) * step
		for i = 0, n - 1 do
			if inside(x0 + (i + 0.5) * step, y) then
				hits += 1
			end
		end
	end
	return hits / (n * n)
end

----------------------------------------------------------------------------------
-- Error study helpers (used by tests and bench; report in 1/255 units)
----------------------------------------------------------------------------------

export type ErrorStats = { max: number, mean: number, count: number, over1: number }

-- Compares estimator(px, py) with reference(px, py) over the pixels of a box,
-- counting only pixels where either value is strictly between 0 and 1 or they differ.
function Coverage.compare(
	x0: number,
	y0: number,
	x1: number,
	y1: number,
	estimator: (number, number) -> number,
	reference: (number, number) -> number
): ErrorStats
	local maxE, sum, count, over = 0, 0, 0, 0
	for y = y0, y1 do
		for x = x0, x1 do
			local r = reference(x, y)
			local e = estimator(x, y)
			if (r > 0 and r < 1) or (e > 0 and e < 1) or r ~= e then
				local err = abs(e - r) * 255
				if err > maxE then
					maxE = err
				end
				if err > 1 then
					over += 1
				end
				sum += err
				count += 1
			end
		end
	end
	return { max = maxE, mean = if count > 0 then sum / count else 0, count = count, over1 = over }
end

return Coverage
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Distance</string>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: compute/Distance
--
-- Distance transforms: turn a binary mask (buffer of u8, nonzero = feature) into a
-- field of squared Euclidean distances to the nearest feature pixel centre (buffer
-- of u32), and from there into signed distance fields, soft mattes, outlines and
-- glows. Three algorithms, measured against brute force in docs/COMPUTE.md 3.6:
--
--   edt     Felzenszwalb and Huttenlocher (2004) separable lower envelope of
--           parabolas. EXACT, O(pixels), two passes. The division that locates
--           parabola intersections is correctly rounded and can only misorder a
--           tie, where both parabolas give the same integer, so the output is the
--           exact integer squared distance (COMPUTE.md C8).
--   jfa     Jump flooding (Rong and Tan 2006): log2(n) passes of 9 probes. A GPU
--           algorithm; approximate and 5 to 10x slower than edt on a CPU.
--   ssedt8  8-point sequential signed EDT (Danielsson style, two raster sweeps
--           propagating offset vectors). Approximate, O(pixels).
--
-- Deterministic: integer arithmetic in doubles, comparisons, one correctly
-- rounded division per parabola test, sqrt only in the signed/matte helpers.

local Distance = {}

local INF = 2 ^ 40 -- larger than any squared distance on a 2^16 x 2^16 image

-- Squared distance from every pixel to the nearest feature pixel (exact).
function Distance.edt(mask: buffer, w: number, h: number, out: buffer?): buffer
	local res = out or buffer.create(w * h * 4)
	local g = buffer.create(w * h * 8) -- f64 squared vertical distances
	-- pass 1: columns, two sweeps, walked row by row (row-major memory order) with
	-- one "last feature row" per column
	local last = table.create(w, -1)
	for y = 0, h - 1 do
		local row = y * w
		for x = 0, w - 1 do
			local i = row + x
			if buffer.readu8(mask, i) ~= 0 then
				last[x + 1] = y
				buffer.writef64(g, i * 8, 0)
			else
				local l = last[x + 1]
				if l >= 0 then
					local d = y - l
					buffer.writef64(g, i * 8, d * d)
				else
					buffer.writef64(g, i * 8, INF)
				end
			end
		end
	end
	table.clear(last)
	for x = 1, w do
		last[x] = -1
	end
	for y = h - 1, 0, -1 do
		local row = y * w
		for x = 0, w - 1 do
			local i = row + x
			local cur = buffer.readf64(g, i * 8)
			if cur == 0 then
				last[x + 1] = y
			else
				local l = last[x + 1]
				if l >= 0 then
					local d = l - y
					local dd = d * d
					if dd < cur then
						buffer.writef64(g, i * 8, dd)
					end
				end
			end
		end
	end
	-- pass 2: rows, lower envelope of parabolas (x - q)^2 + f(q)
	local v = table.create(w + 1, 0) -- parabola apexes
	local z = table.create(w + 2, 0) -- envelope boundaries
	for y = 0, h - 1 do
		local row = y * w
		local k = 0 -- number of parabolas in the envelope
		for q = 0, w - 1 do
			local fq = buffer.readf64(g, (row + q) * 8)
			if fq >= INF then
				continue -- infinite parabola never reaches the envelope
			end
			local hq = fq + q * q
			if k == 0 then
				k = 1
				v[1] = q
				z[1] = -math.huge
				z[2] = math.huge
				continue
			end
			-- pop parabolas hidden by the new one; z[1] = -inf stops the loop
			local s
			while true do
				local p = v[k]
				local fp = buffer.readf64(g, (row + p) * 8)
				s = (hq - (fp + p * p)) / (2 * q - 2 * p)
				if s <= z[k] then
					k -= 1
				else
					break
				end
			end
			k += 1
			v[k] = q
			z[k] = s
			z[k + 1] = math.huge
		end
		if k == 0 then
			for x = 0, w - 1 do
				buffer.writeu32(res, (row + x) * 4, 0xFFFFFFFF)
			end
			continue
		end
		local j = 1
		for x = 0, w - 1 do
			while z[j + 1] < x do
				j += 1
			end
			local p = v[j]
			local dx = x - p
			buffer.writeu32(res, (row + x) * 4, dx * dx + buffer.readf64(g, (row + p) * 8))
		end
	end
	return res
end

-- Exact reference: every pixel against every feature pixel. O(pixels * features).
function Distance.brute(mask: buffer, w: number, h: number): buffer
	local res = buffer.create(w * h * 4)
	local fx, fy = {}, {}
	for y = 0, h - 1 do
		for x = 0, w - 1 do
			if buffer.readu8(mask, y * w + x) ~= 0 then
				table.insert(fx, x)
				table.insert(fy, y)
			end
		end
	end
	local n = #fx
	for y = 0, h - 1 do
		for x = 0, w - 1 do
			local best = 0xFFFFFFFF
			for i = 1, n do
				local dx, dy = x - fx[i], y - fy[i]
				local d = dx * dx + dy * dy
				if d < best then
					best = d
				end
			end
			buffer.writeu32(res, (y * w + x) * 4, best)
		end
	end
	return res
end

-- Jump flooding. Stores the nearest seed as an index + 1 (0 = none) in a u32
-- buffer, then converts to squared distances.
function Distance.jfa(mask: buffer, w: number, h: number, out: buffer?): buffer
	local res = out or buffer.create(w * h * 4)
	local a = buffer.create(w * h * 4)
	local b = buffer.create(w * h * 4)
	for i = 0, w * h - 1 do
		if buffer.readu8(mask, i) ~= 0 then
			buffer.writeu32(a, i * 4, i + 1)
		end
	end
	local step = 1
	while step * 2 < math.max(w, h) do
		step *= 2
	end
	local src, dst = a, b
	while step >= 1 do
		for y = 0, h - 1 do
			for x = 0, w - 1 do
				local i = y * w + x
				local best = buffer.readu32(src, i * 4)
				local bd = INF
				if best > 0 then
					local s = best - 1
					local dx, dy = x - s % w, y - s // w
					bd = dx * dx + dy * dy
				end
				for oy = -step, step, step do
					local yy = y + oy
					if yy < 0 or yy >= h then
						continue
					end
					for ox = -step, step, step do
						local xx = x + ox
						if xx < 0 or xx >= w or (ox == 0 and oy == 0) then
							continue
						end
						local c = buffer.readu32(src, (yy * w + xx) * 4)
						if c > 0 then
							local s = c - 1
							local dx, dy = x - s % w, y - s // w
							local d = dx * dx + dy * dy
							if d < bd then
								bd = d
								best = c
							end
						end
					end
				end
				buffer.writeu32(dst, i * 4, best)
			end
		end
		src, dst = dst, src
		step //= 2
	end
	for i = 0, w * h - 1 do
		local c = buffer.readu32(src, i * 4)
		if c == 0 then
			buffer.writeu32(res, i * 4, 0xFFFFFFFF)
		else
			local s = c - 1
			local x, y = i % w, i // w
			local dx, dy = x - s % w, y - s // w
			buffer.writeu32(res, i * 4, dx * dx + dy * dy)
		end
	end
	return res
end

-- 8-point sequential EDT: offset vectors (dx, dy) to the nearest feature found so
-- far, propagated by a forward and a backward raster sweep. Offsets stored as i16.
function Distance.ssedt8(mask: buffer, w: number, h: number, out: buffer?): buffer
	local res = out or buffer.create(w * h * 4)
	local FAR = 16000
	local ox = buffer.create(w * h * 2)
	local oy = buffer.create(w * h * 2)
	for i = 0, w * h - 1 do
		if buffer.readu8(mask, i) == 0 then
			buffer.writei16(ox, i * 2, FAR)
			buffer.writei16(oy, i * 2, FAR)
		end
	end
	local function relax(i: number, j: number, ddx: number, ddy: number)
		-- candidate: neighbour j's offset plus the step from j to i
		local cx = buffer.readi16(ox, j * 2) + ddx
		local cy = buffer.readi16(oy, j * 2) + ddy
		local px = buffer.readi16(ox, i * 2)
		local py = buffer.readi16(oy, i * 2)
		if cx * cx + cy * cy < px * px + py * py then
			buffer.writei16(ox, i * 2, cx)
			buffer.writei16(oy, i * 2, cy)
		end
	end
	for y = 0, h - 1 do
		for x = 0, w - 1 do
			local i = y * w + x
			if x > 0 then
				relax(i, i - 1, 1, 0)
			end
			if y > 0 then
				relax(i, i - w, 0, 1)
				if x > 0 then
					relax(i, i - w - 1, 1, 1)
				end
				if x < w - 1 then
					relax(i, i - w + 1, -1, 1)
				end
			end
		end
		for x = w - 2, 0, -1 do
			local i = y * w + x
			relax(i, i + 1, -1, 0)
		end
	end
	for y = h - 1, 0, -1 do
		for x = w - 1, 0, -1 do
			local i = y * w + x
			if x < w - 1 then
				relax(i, i + 1, -1, 0)
			end
			if y < h - 1 then
				relax(i, i + w, 0, -1)
				if x < w - 1 then
					relax(i, i + w + 1, -1, -1)
				end
				if x > 0 then
					relax(i, i + w - 1, 1, -1)
				end
			end
		end
		for x = 1, w - 1 do
			local i = y * w + x
			relax(i, i - 1, 1, 0)
		end
	end
	for i = 0, w * h - 1 do
		local dx, dy = buffer.readi16(ox, i * 2), buffer.readi16(oy, i * 2)
		if dx >= FAR then
			buffer.writeu32(res, i * 4, 0xFFFFFFFF)
		else
			buffer.writeu32(res, i * 4, dx * dx + dy * dy)
		end
	end
	return res
end

-- Signed distance (f32, pixels, positive outside) to the boundary between the
-- mask's pixel centres: d = dOut - 1/2 outside and -(dIn - 1/2) inside, where dOut
-- is the distance to the nearest inside centre and dIn to the nearest outside
-- centre. Exact for boundaries along pixel edges.
function Distance.signed(mask: buffer, w: number, h: number): buffer
	local inv = buffer.create(w * h)
	for i = 0, w * h - 1 do
		if buffer.readu8(mask, i) == 0 then
			buffer.writeu8(inv, i, 1)
		end
	end
	local dOut = Distance.edt(mask, w, h)
	local dIn = Distance.edt(inv, w, h)
	local sd = buffer.create(w * h * 4)
	local sqrt = math.sqrt
	for i = 0, w * h - 1 do
		local a = buffer.readu32(dOut, i * 4)
		if a > 0 then
			buffer.writef32(sd, i * 4, if a == 0xFFFFFFFF then 1e9 else sqrt(a) - 0.5)
		else
			local b = buffer.readu32(dIn, i * 4)
			buffer.writef32(sd, i * 4, if b == 0xFFFFFFFF then -1e9 else 0.5 - sqrt(b))
		end
	end
	return sd
end

-- Writes alpha from a signed distance field into an RGBA8 image (RGB kept):
-- alpha = 255 * clamp(1/2 - d / feather). feather = 1 gives a one-pixel
-- anti-aliased edge; larger values feather a background-removal matte.
-- Spans whose alpha is 0 or 255 still cost one pixel write each here; a shell
-- (band) version only touches |d| < feather.
function Distance.applyMatte(img: buffer, sd: buffer, count: number, feather: number)
	local inv = 1 / feather
	for i = 0, count - 1 do
		local d = buffer.readf32(sd, i * 4)
		local a = 0.5 - d * inv
		a = if a < 0 then 0 elseif a > 1 then 1 else a
		buffer.writeu8(img, i * 4 + 3, (a * 255 + 0.5) // 1)
	end
end

-- Onion shell: alpha of an outline band |d - centre| <= half (soft by 1/2 pixel on
-- each side), for outlines (centre 0) and glows (a ramp outside the shape).
function Distance.shellAlpha(d: number, centre: number, half: number): number
	local a = half + 0.5 - math.abs(d - centre)
	return if a < 0 then 0 elseif a > 1 then 1 else a
end

-- Glow: alpha falls off linearly from 1 at the shape edge to 0 at `radius` px.
function Distance.glowAlpha(d: number, radius: number): number
	if d <= 0 then
		return 1
	end
	local a = 1 - d / radius
	return if a < 0 then 0 else a
end

return Distance
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Expr</string>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: compute/Expr
--
-- One 2D signed-distance expression, evaluated four ways, to measure what the
-- evaluation strategy costs in Luau (docs/COMPUTE.md 4.1):
--
--   closure     a tree of closures, one call per node per pixel
--   ops         a flat op array (numbers in a table) run by a register machine,
--               one dispatch per node per pixel
--   opsRow      the same op array run column-at-a-time over a whole row: one
--               dispatch per node per ROW, the inner loop is pure arithmetic
--   source      Luau source text for a per-pixel function or a row kernel,
--               loaded with loadstring (server only in Roblox, LoadStringEnabled)
--               or emitted at build time as a ModuleScript
--
-- All four perform the same operations in the same order, so they return
-- bit-identical values (tests/compute.test.luau). The module also evaluates the
-- expression over a box in interval arithmetic (exact ranges for every node
-- here, because each op is monotone in each argument or handled piecewise), and
-- renders it through a quadtree classified by either intervals or a Lipschitz
-- bound (docs/COMPUTE.md 2.1 and 3.1).
--
-- Deterministic ops only: + - * / sqrt abs min max comparisons.

local MyMath = require("../MyMath")
local Pixels = require("../Pixels")

local Expr = {}

export type Node = {
	op: number,
	a: Node?,
	b: Node?,
	p1: number,
	p2: number,
	p3: number,
	p4: number,
}

local CIRCLE, BOX, MIN, MAX, SMIN, NEG, OFFSET, SHELL = 1, 2, 3, 4, 5, 6, 7, 8

local function leaf(op: number, p1: number, p2: number, p3: number, p4: number): Node
	return { op = op, p1 = p1, p2 = p2, p3 = p3, p4 = p4 }
end

local function node(op: number, a: Node, b: Node?, k: number?): Node
	return { op = op, a = a, b = b, p1 = k or 0, p2 = 0, p3 = 0, p4 = 0 }
end

function Expr.circle(cx: number, cy: number, r: number): Node
	return leaf(CIRCLE, cx, cy, r, 0)
end
-- Sharp axis-aligned box: centre (cx, cy), half extents (hx, hy).
function Expr.box(cx: number, cy: number, hx: number, hy: number): Node
	return leaf(BOX, cx, cy, hx, hy)
end
function Expr.union(a: Node, b: Node): Node
	return node(MIN, a, b)
end
function Expr.intersect(a: Node, b: Node): Node
	return node(MAX, a, b)
end
-- Polynomial smooth union (MyMath.smin, k > 0).
function Expr.smoothUnion(a: Node, b: Node, k: number): Node
	return node(SMIN, a, b, k)
end
function Expr.subtract(a: Node, b: Node): Node
	return node(MAX, a, node(NEG, b))
end
-- Rounding: a - r.
function Expr.offset(a: Node, r: number): Node
	return node(OFFSET, a, nil, r)
end
-- Onion shell (outline): |a| - t.
function Expr.shell(a: Node, t: number): Node
	return node(SHELL, a, nil, t)
end

-- Deterministic demo: n circles and boxes, smooth-unioned in pairs, unioned, with
-- one subtracted hole and an outline ring. About 3 n nodes.
function Expr.demo(n: number, size: number, seed: number): Node
	local hash = MyMath.hash32
	local h = hash(seed)
	local function rnd(): number
		h = hash((h + 0x9E3779B9) % 4294967296)
		return h / 4294967296
	end
	local acc: Node? = nil
	for i = 1, n do
		local cx, cy = ((rnd() * size * 16) // 1) / 16, ((rnd() * size * 16) // 1) / 16
		local r = ((4 + rnd() * size * 0.06) * 16 // 1) / 16
		local s: Node
		if i % 2 == 0 then
			s = Expr.circle(cx, cy, r)
		else
			s = Expr.offset(Expr.box(cx, cy, r, r * 0.6), r * 0.2)
		end
		if acc == nil then
			acc = s
		elseif i % 3 == 0 then
			acc = Expr.smoothUnion(acc :: Node, s, 6)
		else
			acc = Expr.union(acc :: Node, s)
		end
	end
	local root = acc :: Node
	root = Expr.subtract(root, Expr.circle(size * 0.5, size * 0.5, size * 0.08))
	return Expr.union(root, Expr.shell(Expr.circle(size * 0.5, size * 0.5, size * 0.3), 2))
end

----------------------------------------------------------------------------------
-- Shared scalar ops (also the reference semantics)
----------------------------------------------------------------------------------

local sqrt, abs = math.sqrt, math.abs

local function sdBox(px: number, py: number, cx: number, cy: number, hx: number, hy: number): number
	local qx = abs(px - cx) - hx
	local qy = abs(py - cy) - hy
	local ox = if qx > 0 then qx else 0
	local oy = if qy > 0 then qy else 0
	local inside = if qx > qy then qx else qy
	if inside > 0 then
		inside = 0
	end
	return sqrt(ox * ox + oy * oy) + inside
end

local function smin(a: number, b: number, k: number): number
	local hh = 0.5 + 0.5 * (b - a) / k
	hh = if hh < 0 then 0 elseif hh > 1 then 1 else hh
	return b + (a - b) * hh - k * hh * (1 - hh)
end

----------------------------------------------------------------------------------
-- 1. Closures
----------------------------------------------------------------------------------

function Expr.closure(n: Node): (number, number) -> number
	local op = n.op
	if op == CIRCLE then
		local cx, cy, r = n.p1, n.p2, n.p3
		return function(px: number, py: number): number
			local dx, dy = px - cx, py - cy
			return sqrt(dx * dx + dy * dy) - r
		end
	elseif op == BOX then
		local cx, cy, hx, hy = n.p1, n.p2, n.p3, n.p4
		return function(px: number, py: number): number
			return sdBox(px, py, cx, cy, hx, hy)
		end
	end
	local fa = Expr.closure(n.a :: Node)
	if op == NEG then
		return function(px: number, py: number): number
			return -fa(px, py)
		end
	elseif op == OFFSET then
		local k = n.p1
		return function(px: number, py: number): number
			return fa(px, py) - k
		end
	elseif op == SHELL then
		local k = n.p1
		return function(px: number, py: number): number
			return abs(fa(px, py)) - k
		end
	end
	local fb = Expr.closure(n.b :: Node)
	if op == MIN then
		return function(px: number, py: number): number
			local a, b = fa(px, py), fb(px, py)
			return if a < b then a else b
		end
	elseif op == MAX then
		return function(px: number, py: number): number
			local a, b = fa(px, py), fb(px, py)
			return if a > b then a else b
		end
	end
	local k = n.p1
	return function(px: number, py: number): number
		return smin(fa(px, py), fb(px, py), k)
	end
end

----------------------------------------------------------------------------------
-- 2. Flat op array: {op, dst, a, b, k, ...} with constants inline
----------------------------------------------------------------------------------

export type Program = { code: { number }, len: number, nregs: number, out: number }

-- Instruction layouts (all fields are numbers):
--   CIRCLE dst cx cy r        BOX dst cx cy hx hy       MIN/MAX dst a b
--   SMIN dst a b k            NEG dst a                 OFFSET/SHELL dst a k
function Expr.compile(root: Node): Program
	local code: { number } = {}
	local nregs = 0
	local function emit(n: Node): number
		local op = n.op
		local dst
		if op == CIRCLE then
			nregs += 1
			dst = nregs
			table.move({ CIRCLE, dst, n.p1, n.p2, n.p3 }, 1, 5, #code + 1, code)
		elseif op == BOX then
			nregs += 1
			dst = nregs
			table.move({ BOX, dst, n.p1, n.p2, n.p3, n.p4 }, 1, 6, #code + 1, code)
		elseif op == NEG or op == OFFSET or op == SHELL then
			local a = emit(n.a :: Node)
			nregs += 1
			dst = nregs
			if op == NEG then
				table.move({ NEG, dst, a }, 1, 3, #code + 1, code)
			else
				table.move({ op, dst, a, n.p1 }, 1, 4, #code + 1, code)
			end
		else
			local a = emit(n.a :: Node)
			local b = emit(n.b :: Node)
			nregs += 1
			dst = nregs
			if op == SMIN then
				table.move({ SMIN, dst, a, b, n.p1 }, 1, 5, #code + 1, code)
			else
				table.move({ op, dst, a, b }, 1, 4, #code + 1, code)
			end
		end
		return dst
	end
	local out = emit(root)
	return { code = code, len = #code, nregs = nregs, out = out }
end

-- Per-pixel register machine. regs: table with at least prog.nregs slots.
function Expr.run(prog: Program, regs: { number }, px: number, py: number): number
	local code, len = prog.code, prog.len
	local pc = 1
	while pc <= len do
		local op = code[pc]
		if op == CIRCLE then
			local dx, dy = px - code[pc + 2], py - code[pc + 3]
			regs[code[pc + 1]] = sqrt(dx * dx + dy * dy) - code[pc + 4]
			pc += 5
		elseif op == MIN then
			local a, b = regs[code[pc + 2]], regs[code[pc + 3]]
			regs[code[pc + 1]] = if a < b then a else b
			pc += 4
		elseif op == BOX then
			local qx = abs(px - code[pc + 2]) - code[pc + 4]
			local qy = abs(py - code[pc + 3]) - code[pc + 5]
			local ox = if qx > 0 then qx else 0
			local oy = if qy > 0 then qy else 0
			local inside = if qx > qy then qx else qy
			if inside > 0 then
				inside = 0
			end
			regs[code[pc + 1]] = sqrt(ox * ox + oy * oy) + inside
			pc += 6
		elseif op == SMIN then
			local a, b, k = regs[code[pc + 2]], regs[code[pc + 3]], code[pc + 4]
			local hh = 0.5 + 0.5 * (b - a) / k
			hh = if hh < 0 then 0 elseif hh > 1 then 1 else hh
			regs[code[pc + 1]] = b + (a - b) * hh - k * hh * (1 - hh)
			pc += 5
		elseif op == MAX then
			local a, b = regs[code[pc + 2]], regs[code[pc + 3]]
			regs[code[pc + 1]] = if a > b then a else b
			pc += 4
		elseif op == OFFSET then
			regs[code[pc + 1]] = regs[code[pc + 2]] - code[pc + 3]
			pc += 4
		elseif op == SHELL then
			regs[code[pc + 1]] = abs(regs[code[pc + 2]]) - code[pc + 3]
			pc += 4
		else -- NEG
			regs[code[pc + 1]] = -regs[code[pc + 2]]
			pc += 3
		end
	end
	return regs[prog.out]
end

-- Column-at-a-time: evaluates pixels x0 .. x0 + n - 1 of row y; each register is
-- an array of n values (rows: table of prog.nregs arrays). Returns the output array.
function Expr.runRow(prog: Program, rows: { { number } }, y: number, x0: number, n: number): { number }
	local code, len = prog.code, prog.len
	local py = y + 0.5
	local pc = 1
	while pc <= len do
		local op = code[pc]
		local D = rows[code[pc + 1]]
		if op == CIRCLE then
			local cx, cy, r = code[pc + 2], code[pc + 3], code[pc + 4]
			local dy = py - cy
			local dy2 = dy * dy
			for i = 1, n do
				local dx = x0 + i - 0.5 - cx
				D[i] = sqrt(dx * dx + dy2) - r
			end
			pc += 5
		elseif op == MIN or op == MAX then
			local A, B = rows[code[pc + 2]], rows[code[pc + 3]]
			if op == MIN then
				for i = 1, n do
					local a, b = A[i], B[i]
					D[i] = if a < b then a else b
				end
			else
				for i = 1, n do
					local a, b = A[i], B[i]
					D[i] = if a > b then a else b
				end
			end
			pc += 4
		elseif op == BOX then
			local cx, cy, hx, hy = code[pc + 2], code[pc + 3], code[pc + 4], code[pc + 5]
			local qy = abs(py - cy) - hy
			local oy = if qy > 0 then qy else 0
			local oy2 = oy * oy
			for i = 1, n do
				local qx = abs(x0 + i - 0.5 - cx) - hx
				local ox = if qx > 0 then qx else 0
				local inside = if qx > qy then qx else qy
				if inside > 0 then
					inside = 0
				end
				D[i] = sqrt(ox * ox + oy2) + inside
			end
			pc += 6
		elseif op == SMIN then
			local A, B, k = rows[code[pc + 2]], rows[code[pc + 3]], code[pc + 4]
			for i = 1, n do
				local a, b = A[i], B[i]
				local hh = 0.5 + 0.5 * (b - a) / k
				hh = if hh < 0 then 0 elseif hh > 1 then 1 else hh
				D[i] = b + (a - b) * hh - k * hh * (1 - hh)
			end
			pc += 5
		elseif op == OFFSET or op == SHELL then
			local A, k = rows[code[pc + 2]], code[pc + 3]
			if op == OFFSET then
				for i = 1, n do
					D[i] = A[i] - k
				end
			else
				for i = 1, n do
					D[i] = abs(A[i]) - k
				end
			end
			pc += 4
		else
			local A = rows[code[pc + 2]]
			for i = 1, n do
				D[i] = -A[i]
			end
			pc += 3
		end
	end
	return rows[prog.out]
end

function Expr.newRows(prog: Program, n: number): { { number } }
	local rows: { { number } } = {}
	for i = 1, prog.nregs do
		rows[i] = table.create(n, 0)
	end
	return rows
end

----------------------------------------------------------------------------------
-- 3. Generated source
----------------------------------------------------------------------------------

local function num(x: number): string
	return string.format("%.17g", x)
end

-- Statements computing every register r<i> from px, py (same op order as run).
local function emitBody(prog: Program, lines: { string })
	local code = prog.code
	local pc = 1
	while pc <= prog.len do
		local op = code[pc]
		local d = "r" .. code[pc + 1]
		if op == CIRCLE then
			table.insert(lines, string.format("local dx_%s, dy_%s = px - %s, py - %s", d, d, num(code[pc + 2]), num(code[pc + 3])))
			table.insert(lines, string.format("local %s = sqrt(dx_%s * dx_%s + dy_%s * dy_%s) - %s", d, d, d, d, d, num(code[pc + 4])))
			pc += 5
		elseif op == BOX then
			table.insert(lines, string.format("local qx_%s = abs(px - %s) - %s", d, num(code[pc + 2]), num(code[pc + 4])))
			table.insert(lines, string.format("local qy_%s = abs(py - %s) - %s", d, num(code[pc + 3]), num(code[pc + 5])))
			table.insert(lines, string.format("local ox_%s = if qx_%s > 0 then qx_%s else 0", d, d, d))
			table.insert(lines, string.format("local oy_%s = if qy_%s > 0 then qy_%s else 0", d, d, d))
			table.insert(lines, string.format("local in_%s = if qx_%s > qy_%s then qx_%s else qy_%s", d, d, d, d, d))
			table.insert(lines, string.format("if in_%s > 0 then in_%s = 0 end", d, d))
			table.insert(lines, string.format("local %s = sqrt(ox_%s * ox_%s + oy_%s * oy_%s) + in_%s", d, d, d, d, d, d))
			pc += 6
		elseif op == MIN or op == MAX then
			local a, b = "r" .. code[pc + 2], "r" .. code[pc + 3]
			table.insert(lines, string.format("local %s = if %s %s %s then %s else %s", d, a, if op == MIN then "<" else ">", b, a, b))
			pc += 4
		elseif op == SMIN then
			local a, b, k = "r" .. code[pc + 2], "r" .. code[pc + 3], num(code[pc + 4])
			table.insert(lines, string.format("local h_%s = 0.5 + 0.5 * (%s - %s) / %s", d, b, a, k))
			table.insert(lines, string.format("h_%s = if h_%s < 0 then 0 elseif h_%s > 1 then 1 else h_%s", d, d, d, d))
			table.insert(lines, string.format("local %s = %s + (%s - %s) * h_%s - %s * h_%s * (1 - h_%s)", d, b, a, b, d, k, d, d))
			pc += 5
		elseif op == OFFSET then
			table.insert(lines, string.format("local %s = r%d - %s", d, code[pc + 2], num(code[pc + 3])))
			pc += 4
		elseif op == SHELL then
			table.insert(lines, string.format("local %s = abs(r%d) - %s", d, code[pc + 2], num(code[pc + 3])))
			pc += 4
		else
			table.insert(lines, string.format("local %s = -r%d", d, code[pc + 2]))
			pc += 3
		end
	end
end

-- Source of `function(px, py) -> number`. Luau limits a function to 200 locals,
-- so large programs should use sourceRow's register-reuse-free form in chunks.
function Expr.source(prog: Program): string
	local lines = { "local sqrt, abs = math.sqrt, math.abs", "return function(px: number, py: number): number" }
	emitBody(prog, lines)
	table.insert(lines, "return r" .. prog.out)
	table.insert(lines, "end")
	return table.concat(lines, "\n")
end

-- Source of a row kernel `function(out: {number}, y, x0, n)` writing n values.
function Expr.sourceRow(prog: Program): string
	local lines = {
		"local sqrt, abs = math.sqrt, math.abs",
		"return function(out: {number}, y: number, x0: number, n: number)",
		"local py = y + 0.5",
		"for i = 1, n do",
		"local px = x0 + i - 0.5",
	}
	emitBody(prog, lines)
	table.insert(lines, "out[i] = r" .. prog.out)
	table.insert(lines, "end")
	table.insert(lines, "end")
	return table.concat(lines, "\n")
end

----------------------------------------------------------------------------------
-- 4. Interval arithmetic: range of the expression over [x0, x1] x [y0, y1]
----------------------------------------------------------------------------------

-- Range of t^2 for t in [a, b].
local function sqRange(a: number, b: number): (number, number)
	if a >= 0 then
		return a * a, b * b
	elseif b <= 0 then
		return b * b, a * a
	end
	local m = if -a > b then -a else b
	return 0, m * m
end

-- Range of |t| for t in [a, b].
local function absRange(a: number, b: number): (number, number)
	if a >= 0 then
		return a, b
	elseif b <= 0 then
		return -b, -a
	end
	return 0, if -a > b then -a else b
end

function Expr.interval(n: Node, x0: number, x1: number, y0: number, y1: number): (number, number)
	local op = n.op
	if op == CIRCLE then
		local ax, bx = sqRange(x0 - n.p1, x1 - n.p1)
		local ay, by = sqRange(y0 - n.p2, y1 - n.p2)
		return sqrt(ax + ay) - n.p3, sqrt(bx + by) - n.p3
	elseif op == BOX then
		-- the box SDF is non-decreasing in |px - cx| and |py - cy|, so its range is
		-- spanned by the nearest and farthest |offsets| per axis
		local qxa, qxb = absRange(x0 - n.p1, x1 - n.p1)
		local qya, qyb = absRange(y0 - n.p2, y1 - n.p2)
		return sdBox(qxa, qya, 0, 0, n.p3, n.p4), sdBox(qxb, qyb, 0, 0, n.p3, n.p4)
	end
	local alo, ahi = Expr.interval(n.a :: Node, x0, x1, y0, y1)
	if op == NEG then
		return -ahi, -alo
	elseif op == OFFSET then
		return alo - n.p1, ahi - n.p1
	elseif op == SHELL then
		local lo, hi = absRange(alo, ahi)
		return lo - n.p1, hi - n.p1
	end
	local blo, bhi = Expr.interval(n.b :: Node, x0, x1, y0, y1)
	if op == MIN then
		return (if alo < blo then alo else blo), (if ahi < bhi then ahi else bhi)
	elseif op == MAX then
		return (if alo > blo then alo else blo), (if ahi > bhi then ahi else bhi)
	end
	-- smin is non-decreasing in both arguments (partial derivatives h and 1 - h)
	return smin(alo, blo, n.p1), smin(ahi, bhi, n.p1)
end

----------------------------------------------------------------------------------
-- Quadtree rendering of the field's coverage (linear ramp, AA width 1)
----------------------------------------------------------------------------------

export type QuadStats = { nodes: number, shaded: number, filled: number }

-- Renders coverage alpha of field f into an RGBA8 buffer (colour rgb, alpha from
-- coverage) through a quadtree. classify = "interval" uses Expr.interval on the
-- node's pixel-centre box; "lipschitz" evaluates the centre and assumes |grad| <= L.
-- A node whose range lies entirely beyond +-1/2 gets one span fill. Leaves of
-- `leaf` pixels are shaded per pixel by `f` (any backend).
function Expr.renderQuad(
	root: Node,
	f: (number, number) -> number,
	classify: string,
	L: number,
	out: buffer,
	size: number,
	rgb: number,
	leaf: number
): QuadStats
	local st: QuadStats = { nodes = 0, shaded = 0, filled = 0 }
	local useInterval = classify == "interval"
	local function visit(x: number, y: number, s: number)
		st.nodes += 1
		local lo, hi
		if useInterval then
			lo, hi = Expr.interval(root, x + 0.5, x + s - 0.5, y + 0.5, y + s - 0.5)
		else
			local d = f(x + s * 0.5, y + s * 0.5)
			local reach = L * (s - 1) * 0.70710678118654757
			lo, hi = d - reach, d + reach
		end
		if lo >= 0.5 then
			Pixels.fillRect(out, size, x, y, s, s, rgb)
			st.filled += s * s
			return
		elseif hi <= -0.5 then
			Pixels.fillRect(out, size, x, y, s, s, rgb + 0xFF000000)
			st.filled += s * s
			return
		end
		if s <= leaf then
			st.shaded += s * s
			for yy = y, y + s - 1 do
				local o = (yy * size + x) * 4
				for xx = x, x + s - 1 do
					local c = 0.5 - f(xx + 0.5, yy + 0.5)
					c = if c < 0 then 0 elseif c > 1 then 1 else c
					buffer.writeu32(out, o, rgb + ((c * 255 + 0.5) // 1) * 16777216)
					o += 4
				end
			end
			return
		end
		local h = s // 2
		visit(x, y, h)
		visit(x + h, y, h)
		visit(x, y + h, h)
		visit(x + h, y + h, h)
	end
	visit(0, 0, size)
	return st
end

return Expr
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Filter</string>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: compute/Filter
--
-- Filters whose cost does not depend on their size, all exact in integer
-- arithmetic (docs/COMPUTE.md 3.5):
--
--   boxBlur        separable box blur of radius r by running sums: per pixel and
--                  pass, add the pixel entering the window and subtract the one
--                  leaving it. Sums of 8-bit channels are kept two to a number in
--                  16-bit lanes (SWAR, 0x00FF00FF masks), r <= 127. The result is
--                  round(sum / (2r + 1)) by integer floor division: identical to
--                  the brute-force average (tests/compute.test.luau).
--   satBuild       summed-area table, one u32 plane per channel (exact: totals stay
--                  below 2^32 for 1024 x 1024 x 255).
--   satResample    area-average resampling to ANY size through the table: the
--                  integral of a piecewise-constant image over a rectangle with
--                  fractional corners is the bilinear interpolation of the
--                  summed-area table. Any footprint in O(1) (variable blur, LOD).
--   areaResample   the reference resampler: exact area average at any ratio with
--                  integer weights and exact rational rounding, separable, about
--                  4x faster than satResample. Artifact-free downscaling for LOD.
--   normalMap      height field to tangent-space normal map by central differences.
--
-- Edges clamp to the border pixel. Deterministic ops only.

local Filter = {}

local band, rshift = bit32.band, bit32.rshift

-- One horizontal running-sum pass of radius r from src (w x h) into dst.
local function boxPassH(src: buffer, dst: buffer, w: number, h: number, r: number)
	local n = 2 * r + 1
	local half = r -- (sum + r) // n rounds half down; n is odd so ties never occur
	for y = 0, h - 1 do
		local row = y * w * 4
		local first = buffer.readu32(src, row)
		local lastPx = buffer.readu32(src, row + (w - 1) * 4)
		-- window for x = 0 covers [-r, r], clamped: (r + 1) copies of pixel 0 ...
		local rb = band(first, 0x00FF00FF) * (r + 1)
		local ga = band(rshift(first, 8), 0x00FF00FF) * (r + 1)
		for k = 1, r do
			local p = buffer.readu32(src, row + (if k < w then k else w - 1) * 4)
			rb += band(p, 0x00FF00FF)
			ga += band(rshift(p, 8), 0x00FF00FF)
		end
		for x = 0, w - 1 do
			local rr = rb % 65536
			local bb = rb // 65536
			local gg = ga % 65536
			local aa = ga // 65536
			buffer.writeu32(
				dst,
				row + x * 4,
				(rr + half) // n + ((gg + half) // n) * 256 + ((bb + half) // n) * 65536 + ((aa + half) // n) * 16777216
			)
			-- slide: add pixel x + r + 1, remove pixel x - r (both clamped)
			local inX = x + r + 1
			local outX = x - r
			local pin = if inX < w then buffer.readu32(src, row + inX * 4) else lastPx
			local pout = if outX > 0 then buffer.readu32(src, row + outX * 4) else first
			rb += band(pin, 0x00FF00FF) - band(pout, 0x00FF00FF)
			ga += band(rshift(pin, 8), 0x00FF00FF) - band(rshift(pout, 8), 0x00FF00FF)
		end
	end
end

-- Vertical pass, walked row by row with per-column lane sums (row-major access).
local function boxPassV(src: buffer, dst: buffer, w: number, h: number, r: number)
	local n = 2 * r + 1
	local half = r
	local RB = table.create(w, 0)
	local GA = table.create(w, 0)
	local stride = w * 4
	for x = 0, w - 1 do
		local p = buffer.readu32(src, x * 4)
		RB[x + 1] = band(p, 0x00FF00FF) * (r + 1)
		GA[x + 1] = band(rshift(p, 8), 0x00FF00FF) * (r + 1)
	end
	for k = 1, r do
		local yy = if k < h then k else h - 1
		for x = 0, w - 1 do
			local p = buffer.readu32(src, yy * stride + x * 4)
			RB[x + 1] += band(p, 0x00FF00FF)
			GA[x + 1] += band(rshift(p, 8), 0x00FF00FF)
		end
	end
	for y = 0, h - 1 do
		local inY = y + r + 1
		local outY = y - r
		local inRow = (if inY < h then inY else h - 1) * stride
		local outRow = (if outY > 0 then outY else 0) * stride
		local row = y * stride
		for x = 0, w - 1 do
			local rb, ga = RB[x + 1], GA[x + 1]
			local rr = rb % 65536
			local bb = rb // 65536
			local gg = ga % 65536
			local aa = ga // 65536
			buffer.writeu32(
				dst,
				row + x * 4,
				(rr + half) // n + ((gg + half) // n) * 256 + ((bb + half) // n) * 65536 + ((aa + half) // n) * 16777216
			)
			local pin = buffer.readu32(src, inRow + x * 4)
			local pout = buffer.readu32(src, outRow + x * 4)
			RB[x + 1] = rb + band(pin, 0x00FF00FF) - band(pout, 0x00FF00FF)
			GA[x + 1] = ga + band(rshift(pin, 8), 0x00FF00FF) - band(rshift(pout, 8), 0x00FF00FF)
		end
	end
end

-- Box blur of radius r (1 <= r <= 127), horizontal then vertical, rounding after
-- each pass (so it equals two rounded 1D box filters, not one 2D mean).
function Filter.boxBlur(src: buffer, w: number, h: number, r: number, dst: buffer?): buffer
	assert(r >= 1 and r <= 127, "radius must be 1..127 (16-bit lanes)")
	local tmp = buffer.create(w * h * 4)
	local out = dst or buffer.create(w * h * 4)
	boxPassH(src, tmp, w, h, r)
	boxPassV(tmp, out, w, h, r)
	return out
end

-- Brute-force reference with the same per-pass rounding (tests only).
function Filter.boxBlurBrute(src: buffer, w: number, h: number, r: number): buffer
	local n = 2 * r + 1
	local tmp = buffer.create(w * h * 4)
	local out = buffer.create(w * h * 4)
	for pass = 1, 2 do
		local a = if pass == 1 then src else tmp
		local b = if pass == 1 then tmp else out
		for y = 0, h - 1 do
			for x = 0, w - 1 do
				local s0, s1, s2, s3 = 0, 0, 0, 0
				for k = -r, r do
					local xx, yy = x, y
					if pass == 1 then
						xx = math.clamp(x + k, 0, w - 1)
					else
						yy = math.clamp(y + k, 0, h - 1)
					end
					local p = buffer.readu32(a, (yy * w + xx) * 4)
					s0 += p % 256
					s1 += (p // 256) % 256
					s2 += (p // 65536) % 256
					s3 += p // 16777216
				end
				buffer.writeu32(
					b,
					(y * w + x) * 4,
					(s0 + r) // n + ((s1 + r) // n) * 256 + ((s2 + r) // n) * 65536 + ((s3 + r) // n) * 16777216
				)
			end
		end
	end
	return out
end

export type SAT = { w: number, h: number, planes: { buffer } }

-- Summed-area table with a zero row and column: S(x, y) = sum of pixels [0, x) x [0, y).
-- One u32 plane per channel, (w + 1) x (h + 1).
function Filter.satBuild(src: buffer, w: number, h: number): SAT
	local W1 = w + 1
	local planes = {}
	for c = 1, 4 do
		planes[c] = buffer.create(W1 * (h + 1) * 4)
	end
	local P0, P1, P2, P3 = planes[1], planes[2], planes[3], planes[4]
	for y = 1, h do
		local s0, s1, s2, s3 = 0, 0, 0, 0
		local srow = (y - 1) * w * 4
		local o = y * W1 * 4 + 4
		local up = o - W1 * 4
		for x = 1, w do
			local p = buffer.readu32(src, srow + (x - 1) * 4)
			s0 += p % 256
			s1 += (p // 256) % 256
			s2 += (p // 65536) % 256
			s3 += p // 16777216
			buffer.writeu32(P0, o, s0 + buffer.readu32(P0, up))
			buffer.writeu32(P1, o, s1 + buffer.readu32(P1, up))
			buffer.writeu32(P2, o, s2 + buffer.readu32(P2, up))
			buffer.writeu32(P3, o, s3 + buffer.readu32(P3, up))
			o += 4
			up += 4
		end
	end
	return { w = w, h = h, planes = planes }
end

-- Integral of one channel over [0, x] x [0, y] for real x, y (bilinear in S).
local function integral(P: buffer, W1: number, x: number, y: number): number
	local ix, iy = x // 1, y // 1
	local fx, fy = x - ix, y - iy
	local o = (iy * W1 + ix) * 4
	local s00 = buffer.readu32(P, o)
	if fx == 0 and fy == 0 then
		return s00
	end
	local s10 = if fx > 0 then buffer.readu32(P, o + 4) else s00
	local s01 = if fy > 0 then buffer.readu32(P, o + W1 * 4) else s00
	local s11 = if fx > 0 and fy > 0 then buffer.readu32(P, o + W1 * 4 + 4) else (if fx > 0 then s10 else s01)
	local top = s00 + (s10 - s00) * fx
	local bot = s01 + (s11 - s01) * fx
	return top + (bot - top) * fy
end
Filter.integral = integral

-- Exact area-average resample of the SAT's image to dw x dh: output pixel (i, j)
-- is the mean over the source rectangle [i * sx, (i + 1) * sx) x [j * sy, (j + 1) * sy).
function Filter.satResample(sat: SAT, dw: number, dh: number, dst: buffer?): buffer
	local w, h = sat.w, sat.h
	local W1 = w + 1
	local out = dst or buffer.create(dw * dh * 4)
	local sx, sy = w / dw, h / dh
	local inv = 1 / (sx * sy)
	local P = sat.planes
	local o = 0
	for j = 0, dh - 1 do
		local y0, y1 = j * sy, (j + 1) * sy
		if y1 > h then
			y1 = h
		end
		for i = 0, dw - 1 do
			local x0, x1 = i * sx, (i + 1) * sx
			if x1 > w then
				x1 = w
			end
			local px = 0
			local mul = 1
			for c = 1, 4 do
				local pl = P[c]
				local s = integral(pl, W1, x1, y1) - integral(pl, W1, x0, y1) - integral(pl, W1, x1, y0) + integral(pl, W1, x0, y0)
				local v = (s * inv + 0.5) // 1
				v = if v < 0 then 0 elseif v > 255 then 255 else v
				px += v * mul
				mul *= 256
			end
			buffer.writeu32(out, o, px)
			o += 4
		end
	end
	return out
end

-- Overlap weights of output cells with source pixels, in units of 1/dn pixel so
-- they are integers: output cell i covers [i n, (i + 1) n) and source pixel k
-- covers [k dn, (k + 1) dn). Flat lists: first[i] = first source index, count[i],
-- weights in wts (each cell's weights sum to n).
local function areaWeights(n: number, dn: number): ({ number }, { number }, { number })
	local first, count, wts = table.create(dn, 0), table.create(dn, 0), {}
	for i = 0, dn - 1 do
		local a, b = i * n, (i + 1) * n
		local k0 = a // dn
		local k1 = (b - 1) // dn
		first[i + 1] = k0
		count[i + 1] = k1 - k0 + 1
		for k = k0, k1 do
			local lo = if a > k * dn then a else k * dn
			local hi = if b < (k + 1) * dn then b else (k + 1) * dn
			table.insert(wts, hi - lo)
		end
	end
	return first, count, wts
end

-- Exact area-average resample to dw x dh by two separable passes (the box
-- footprint is a product of an x and a y interval). Weights are integers (see
-- areaWeights), so every sum is an exact integer below 255 w h and the output is
-- round-half-up of the exact rational mean, (2 S + w h) // (2 w h): one fixed
-- answer on every platform and in every implementation (docs/COMPUTE.md C9).
-- Each pass only touches the ceil(scale) + 1 source pixels a footprint overlaps.
function Filter.areaResample(src: buffer, w: number, h: number, dw: number, dh: number, dst: buffer?): buffer
	local out = dst or buffer.create(dw * dh * 4)
	local fx, cx, wx = areaWeights(w, dw)
	local fy, cy, wy = areaWeights(h, dh)
	local mid = buffer.create(dw * h * 16) -- u32 x 4 channels, sums below 255 w
	for y = 0, h - 1 do
		local srow = y * w * 4
		local o = y * dw * 16
		local wi = 1
		for i = 1, dw do
			local s0, s1, s2, s3 = 0, 0, 0, 0
			local k = fx[i]
			for _ = 1, cx[i] do
				local p = buffer.readu32(src, srow + k * 4)
				local wt = wx[wi]
				s0 += (p % 256) * wt
				s1 += ((p // 256) % 256) * wt
				s2 += ((p // 65536) % 256) * wt
				s3 += (p // 16777216) * wt
				k += 1
				wi += 1
			end
			buffer.writeu32(mid, o, s0)
			buffer.writeu32(mid, o + 4, s1)
			buffer.writeu32(mid, o + 8, s2)
			buffer.writeu32(mid, o + 12, s3)
			o += 16
		end
	end
	local T = w * h
	local T2 = 2 * T
	local wj = 1
	for j = 1, dh do
		local orow = (j - 1) * dw * 4
		for i = 0, dw - 1 do
			local s0, s1, s2, s3 = 0, 0, 0, 0
			local k = fy[j]
			local wk = wj
			for _ = 1, cy[j] do
				local o = (k * dw + i) * 16
				local wt = wy[wk]
				s0 += buffer.readu32(mid, o) * wt
				s1 += buffer.readu32(mid, o + 4) * wt
				s2 += buffer.readu32(mid, o + 8) * wt
				s3 += buffer.readu32(mid, o + 12) * wt
				k += 1
				wk += 1
			end
			buffer.writeu32(
				out,
				orow + i * 4,
				(2 * s0 + T) // T2 + ((2 * s1 + T) // T2) * 256 + ((2 * s2 + T) // T2) * 65536 + ((2 * s3 + T) // T2) * 16777216
			)
		end
		wj += cy[j]
	end
	return out
end

-- Tangent-space normal map from a height field (u8 heights in a w x h buffer):
-- n = normalize(-s dh/dx, -s dh/dy, 1) by central differences (clamped at the
-- border), packed as RGB = round(127.5 + 127.5 n), alpha 255.
function Filter.normalMap(height: buffer, w: number, h: number, strength: number, dst: buffer?): buffer
	local out = dst or buffer.create(w * h * 4)
	local sqrt = math.sqrt
	local s = strength * 0.5 / 255
	for y = 0, h - 1 do
		local ym = if y > 0 then y - 1 else 0
		local yp = if y < h - 1 then y + 1 else h - 1
		for x = 0, w - 1 do
			local xm = if x > 0 then x - 1 else 0
			local xp = if x < w - 1 then x + 1 else w - 1
			local dx = (buffer.readu8(height, y * w + xp) - buffer.readu8(height, y * w + xm)) * s
			local dy = (buffer.readu8(height, yp * w + x) - buffer.readu8(height, ym * w + x)) * s
			local inv = 1 / sqrt(dx * dx + dy * dy + 1)
			local nx, ny, nz = -dx * inv, -dy * inv, inv
			buffer.writeu32(
				out,
				(y * w + x) * 4,
				((nx + 1) * 127.5 + 0.5) // 1 + (((ny + 1) * 127.5 + 0.5) // 1) * 256 + (((nz + 1) * 127.5 + 0.5) // 1) * 65536 + 0xFF000000
			)
		end
	end
	return out
end

return Filter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Raster</string>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: compute/Raster
--
-- Scene rasterizer for hundreds of anti-aliased 2D shapes (circles, rounded boxes,
-- capsules, rings, polygons, cut discs: half-discs and pie slices) composited
-- bottom to top with straight-alpha source-over. Three renderers share one
-- per-pixel shading routine:
--
--   renderBrute    every shape at every pixel (the reference)
--   renderPainter  every shape over its own bounding box, 8-bit read-modify-write
--                  (what an engine DrawCircle loop does; not bit-identical)
--   render         shape bins per 64 x 64 tile, then a Lipschitz quadtree per tile:
--                  shapes that cannot touch a node are dropped, the topmost opaque
--                  shape that covers a node entirely becomes its base and hides
--                  everything below, nodes whose remaining shapes all cover them
--                  entirely are filled with buffer.copy, and only leaves that an
--                  edge crosses are shaded per pixel.
--
-- render is pixel-identical to renderBrute by construction (docs/COMPUTE.md, C2):
-- a dropped shape has coverage exactly 0 at every pixel of the node, a base shape
-- has coverage exactly 1 and alpha 255, and the per-pixel arithmetic is the same
-- function with the same operand order (including the exact-visibility path below,
-- whose inputs are the same per-pixel stack in both renderers).
--
-- Coverage modes (docs/COMPUTE.md 3.3 and "Flawless pipeline"):
--   MODE_EXACT   (the DEFAULT) flawless. F1: every coverage is the exact area of
--                the pixel inside the shape: disc areas by quadrant integration
--                (circles, ring edges, rounded-box corners), products of 1D
--                overlaps (boxes), the exact capsule decomposition (body = pixel
--                clipped by the end lines and the strip sides; caps = disc and
--                pixel clipped by the end line), disc and clipped pixel (cut discs),
--                per-edge Green integrals (polygons, any number of edges per pixel).
--                F2: where two or more shapes' edges enter a pixel ("conflict
--                pixels") the composite is computed with exact visibility
--                (compute/Visibility.luau) instead of chaining coverage as alpha,
--                so abutting shapes leave no seam (C11). Elsewhere coverage as alpha
--                is exact. Culling reach is sqrt(2)/2 AA widths (C4).
--   MODE_LAYERED exact coverage (F1) composited as alpha everywhere: shows the
--                conflation seam at shared edges (kept for comparison and cost).
--   MODE_LINEAR  clamp(0.5 - d / aa, 0, 1), MyMath.coverage: the PREVIEW ramp.
--                Exact only on axis-aligned edges: up to 10.94/255 on a 45 degree
--                edge (C3), 38/255 at sharp box corners, 26 to 83/255 at star tips.
--
-- Deterministic ops only: + - * / sqrt abs floor, comparisons and the
-- deterministic arcsine Coverage.dasin (RUNTIME_AUDIT 6.5).

local Pixels = require("../Pixels")
local MyMath = require("../MyMath")
local Coverage = require("./Coverage")
local Visibility = require("./Visibility")

local Raster = {}

local CIRCLE, BOX, SEGMENT, RING, POLYGON, CUTDISC = 1, 2, 3, 4, 5, 6
Raster.CIRCLE, Raster.BOX, Raster.SEGMENT, Raster.RING, Raster.POLYGON = CIRCLE, BOX, SEGMENT, RING, POLYGON
Raster.CUTDISC = CUTDISC
local MODE_LINEAR, MODE_EXACT, MODE_LAYERED = 0, 1, 2
Raster.MODE_LINEAR, Raster.MODE_EXACT, Raster.MODE_LAYERED = MODE_LINEAR, MODE_EXACT, MODE_LAYERED

export type Scene = {
	n: number,
	kind: { number },
	p1: { number },
	p2: { number },
	p3: { number },
	p4: { number },
	p5: { number },
	p6: { number },
	cr: { number },
	cg: { number },
	cb: { number },
	ca: { number },
	bx0: { number },
	by0: { number },
	bx1: { number },
	by1: { number },
	verts: { number }, -- polygon vertices; cut-disc half-planes (n1x, n1y, o1, n2x, n2y, o2)
	aa: number, -- anti-aliasing (box filter) width in pixels
	mode: number, -- MODE_EXACT (default), MODE_LAYERED or MODE_LINEAR
	bgR: number,
	bgG: number,
	bgB: number,
	bgA: number, -- 0..1
}

export type Bins = {
	tile: number,
	tilesX: number,
	tilesY: number,
	lists: { { number } },
}

export type Stats = { nodes: number, uniform: number, leaves: number, shaded: number, evals: number, conflicts: number }

local stats: Stats = { nodes = 0, uniform = 0, leaves = 0, shaded = 0, evals = 0, conflicts = 0 }
Raster.stats = stats

function Raster.resetStats()
	stats.nodes, stats.uniform, stats.leaves, stats.shaded, stats.evals, stats.conflicts = 0, 0, 0, 0, 0, 0
end

----------------------------------------------------------------------------------
-- Scene construction
----------------------------------------------------------------------------------

function Raster.newScene(background: number, aa: number?, mode: number?): Scene
	local r, g, b, a = MyMath.unpack(background)
	return {
		n = 0,
		kind = {},
		p1 = {},
		p2 = {},
		p3 = {},
		p4 = {},
		p5 = {},
		p6 = {},
		cr = {},
		cg = {},
		cb = {},
		ca = {},
		bx0 = {},
		by0 = {},
		bx1 = {},
		by1 = {},
		verts = {},
		aa = aa or 1,
		mode = mode or MODE_EXACT,
		bgR = r,
		bgG = g,
		bgB = b,
		bgA = a / 255,
	}
end

local function push(sc: Scene, kind: number, color: number, a: number, b: number, c: number, d: number, e: number, f: number): number
	local n = sc.n + 1
	sc.n = n
	sc.kind[n] = kind
	sc.p1[n], sc.p2[n], sc.p3[n], sc.p4[n], sc.p5[n], sc.p6[n] = a, b, c, d, e, f
	local r, g, bl, al = MyMath.unpack(color)
	sc.cr[n], sc.cg[n], sc.cb[n], sc.ca[n] = r, g, bl, al
	return n
end

-- Recomputes the conservative pixel bounding box of shape s (pixels whose centre
-- can have nonzero coverage).
local function updateBounds(sc: Scene, s: number)
	local k = sc.kind[s]
	-- coverage can be nonzero up to half an AA width (linear) or sqrt(2)/2 (exact)
	local h = sc.aa * (if sc.mode ~= MODE_LINEAR then 0.70710678118654757 else 0.5)
	local x0, y0, x1, y1 = 0, 0, 0, 0
	if k == CIRCLE or k == CUTDISC then
		local r = sc.p3[s] + h
		x0, y0, x1, y1 = sc.p1[s] - r, sc.p2[s] - r, sc.p1[s] + r, sc.p2[s] + r
	elseif k == BOX then
		x0, y0 = sc.p1[s] - sc.p3[s] - h, sc.p2[s] - sc.p4[s] - h
		x1, y1 = sc.p1[s] + sc.p3[s] + h, sc.p2[s] + sc.p4[s] + h
	elseif k == SEGMENT then
		local r = sc.p5[s] + h
		local ax, ay = sc.p1[s], sc.p2[s]
		local bx, by = ax + sc.p3[s], ay + sc.p4[s]
		x0, x1 = math.min(ax, bx) - r, math.max(ax, bx) + r
		y0, y1 = math.min(ay, by) - r, math.max(ay, by) + r
	elseif k == RING then
		local r = sc.p3[s] + sc.p4[s] + h
		x0, y0, x1, y1 = sc.p1[s] - r, sc.p2[s] - r, sc.p1[s] + r, sc.p2[s] + r
	else
		local v = sc.verts
		local first, count = sc.p1[s], sc.p2[s]
		x0, y0, x1, y1 = math.huge, math.huge, -math.huge, -math.huge
		for i = first, first + 2 * count - 2, 2 do
			local vx: number, vy: number = v[i], v[i + 1]
			if vx < x0 then
				x0 = vx
			end
			if vx > x1 then
				x1 = vx
			end
			if vy < y0 then
				y0 = vy
			end
			if vy > y1 then
				y1 = vy
			end
		end
		x0, y0, x1, y1 = x0 - h, y0 - h, x1 + h, y1 + h
	end
	-- pixel x has centre x + 0.5; keep every pixel whose centre lies in [x0, x1]
	sc.bx0[s] = math.floor(x0 - 0.5)
	sc.by0[s] = math.floor(y0 - 0.5)
	sc.bx1[s] = math.ceil(x1 - 0.5)
	sc.by1[s] = math.ceil(y1 - 0.5)
end
Raster.updateBounds = updateBounds

function Raster.circle(sc: Scene, color: number, cx: number, cy: number, r: number): number
	local s = push(sc, CIRCLE, color, cx, cy, r, 0, 0, 0)
	updateBounds(sc, s)
	return s
end

-- Axis-aligned box centred at (cx, cy), half extents (hx, hy), corner radius rad
-- (clamped to [0, min(hx, hy)], where the rounded-box SDF is exact).
function Raster.box(sc: Scene, color: number, cx: number, cy: number, hx: number, hy: number, rad: number): number
	local m = if hx < hy then hx else hy
	if rad > m then
		rad = m
	elseif rad < 0 then
		rad = 0
	end
	local s = push(sc, BOX, color, cx, cy, hx, hy, rad, 0)
	updateBounds(sc, s)
	return s
end

-- Capsule from (ax, ay) to (bx, by) with radius r.
function Raster.segment(sc: Scene, color: number, ax: number, ay: number, bx: number, by: number, r: number): number
	local dx, dy = bx - ax, by - ay
	local len2 = dx * dx + dy * dy
	local s = push(sc, SEGMENT, color, ax, ay, dx, dy, r, if len2 > 0 then 1 / len2 else 0)
	updateBounds(sc, s)
	return s
end

-- Annulus: |distance to centre - r| <= t.
function Raster.ring(sc: Scene, color: number, cx: number, cy: number, r: number, t: number): number
	local s = push(sc, RING, color, cx, cy, r, t, 0, 0)
	updateBounds(sc, s)
	return s
end

-- Polygon from flat {x1, y1, x2, y2, ...}; exact distance with the even-odd sign.
-- p3 holds the orientation (sign of the shoelace area). Exact coverage (F1, F2)
-- assumes a simple (non-self-intersecting) polygon.
function Raster.polygon(sc: Scene, color: number, pts: { number }): number
	local v = sc.verts
	local first = #v + 1
	for i = 1, #pts do
		v[first + i - 1] = pts[i]
	end
	local area = 0
	local n = #pts // 2
	local jx, jy = pts[2 * n - 1], pts[2 * n]
	for i = 1, n do
		local ix, iy = pts[2 * i - 1], pts[2 * i]
		area += jx * iy - ix * jy
		jx, jy = ix, iy
	end
	local s = push(sc, POLYGON, color, first, n, if area >= 0 then 1 else -1, 0, 0, 0)
	updateBounds(sc, s)
	return s
end

-- Cut disc: the disc (cx, cy, r) intersected with up to two half-planes
-- {q : n . (q - c) <= o}, normals (n1x, n1y) and (n2x, n2y) of unit length. With
-- one half-plane it is a circular segment (o = 0: a half-disc); with two through
-- the centre it is a pie slice. A convex primitive whose pieces abut exactly when
-- neighbours pass bit-identical normals with opposite signs (negation is exact).
function Raster.cutDisc(
	sc: Scene,
	color: number,
	cx: number,
	cy: number,
	r: number,
	n1x: number,
	n1y: number,
	o1: number,
	n2x: number?,
	n2y: number?,
	o2: number?
): number
	local v = sc.verts
	local first = #v + 1
	v[first], v[first + 1], v[first + 2] = n1x, n1y, o1
	if n2x and n2y then
		v[first + 3], v[first + 4], v[first + 5] = n2x, n2y, o2 or 0
	else
		-- no second half-plane: zero normal, always satisfied (its distance is -1e300)
		v[first + 3], v[first + 4], v[first + 5] = 0, 0, 1e300
	end
	local s = push(sc, CUTDISC, color, cx, cy, r, first, if n2x and n2y then 2 else 1, 0)
	updateBounds(sc, s)
	return s
end

-- Half-disc: the half of the disc on the side opposite to the unit vector (nx, ny),
-- {q : n . (q - c) <= 0}. Its partner is halfDisc with (-nx, -ny).
function Raster.halfDisc(sc: Scene, color: number, cx: number, cy: number, r: number, nx: number, ny: number): number
	return Raster.cutDisc(sc, color, cx, cy, r, nx, ny, 0)
end

-- Pie slice from the unit direction (ax, ay) to the unit direction (bx, by), turning
-- the way that takes x towards y (counter-clockwise in a y-up frame), at most half
-- a turn: {cross(a, q - c) >= 0} and {cross(q - c, b) >= 0}. Slices that share a
-- boundary direction (the same numbers) abut exactly.
function Raster.pie(sc: Scene, color: number, cx: number, cy: number, r: number, ax: number, ay: number, bx: number, by: number): number
	return Raster.cutDisc(sc, color, cx, cy, r, ay, -ax, 0, -by, bx, 0)
end

-- Moves shape s by (dx, dy) pixels.
function Raster.move(sc: Scene, s: number, dx: number, dy: number)
	local k = sc.kind[s]
	if k == POLYGON then
		local v = sc.verts
		for i = sc.p1[s], sc.p1[s] + 2 * sc.p2[s] - 2, 2 do
			v[i] += dx
			v[i + 1] += dy
		end
	else
		sc.p1[s] += dx
		sc.p2[s] += dy
	end
	updateBounds(sc, s)
end

-- A copy of the scene with every length multiplied by f, for rendering a level of
-- detail directly at its own resolution: the AA width stays one output pixel, so
-- every level is the exact box filter of the vector source at that level (F1/F2
-- hold per level; docs/COMPUTE.md "Flawless pipeline", LOD).
function Raster.scaled(sc: Scene, f: number): Scene
	local out = Raster.newScene(0, sc.aa, sc.mode)
	out.bgR, out.bgG, out.bgB, out.bgA = sc.bgR, sc.bgG, sc.bgB, sc.bgA
	for i = 1, #sc.verts do
		out.verts[i] = sc.verts[i]
	end
	for s = 1, sc.n do
		local k = sc.kind[s]
		out.n = s
		out.kind[s] = k
		out.cr[s], out.cg[s], out.cb[s], out.ca[s] = sc.cr[s], sc.cg[s], sc.cb[s], sc.ca[s]
		if k == POLYGON then
			out.p1[s], out.p2[s], out.p3[s], out.p4[s], out.p5[s], out.p6[s] = sc.p1[s], sc.p2[s], sc.p3[s], 0, 0, 0
			local first = sc.p1[s]
			for i = first, first + 2 * sc.p2[s] - 1 do
				out.verts[i] = sc.verts[i] * f
			end
		elseif k == CUTDISC then
			out.p1[s], out.p2[s], out.p3[s], out.p4[s], out.p5[s], out.p6[s] = sc.p1[s] * f, sc.p2[s] * f, sc.p3[s] * f, sc.p4[s], sc.p5[s], 0
			local i = sc.p4[s]
			-- normals stay, offsets scale (the always-true second plane stays 1)
			out.verts[i + 2] = sc.verts[i + 2] * f
			if sc.p5[s] == 2 then
				out.verts[i + 5] = sc.verts[i + 5] * f
			end
		elseif k == SEGMENT then
			out.p1[s], out.p2[s], out.p3[s], out.p4[s], out.p5[s] = sc.p1[s] * f, sc.p2[s] * f, sc.p3[s] * f, sc.p4[s] * f, sc.p5[s] * f
			local len2 = out.p3[s] * out.p3[s] + out.p4[s] * out.p4[s]
			out.p6[s] = if len2 > 0 then 1 / len2 else 0
		else
			out.p1[s], out.p2[s], out.p3[s], out.p4[s], out.p5[s], out.p6[s] =
				sc.p1[s] * f, sc.p2[s] * f, sc.p3[s] * f, sc.p4[s] * f, sc.p5[s] * f, 0
		end
		updateBounds(out, s)
	end
	return out
end

-- Deterministic demo scene: n shapes on a size x size canvas. Mixes every kind,
-- radii from 2 to 60 px at 1024 (scaled with size), one in four translucent.
function Raster.demoScene(n: number, size: number, seed: number, background: number?, mode: number?): Scene
	local sc = Raster.newScene(background or 0xFF201810, 1, mode)
	local f = size / 1024
	local hash = MyMath.hash32
	local h = hash(seed)
	local function rnd(): number
		h = hash((h + 0x9E3779B9) % 4294967296)
		return h / 4294967296
	end
	for i = 1, n do
		local kind = 1 + (rnd() * 5) // 1
		-- quantise positions to 1/16 px so a scaled scene stays exact at power-of-two sizes
		local cx = ((rnd() * 1024 * 16) // 1) / 16 * f
		local cy = ((rnd() * 1024 * 16) // 1) / 16 * f
		local big = if i <= n // 16 then 4 else 1 -- a few large shapes give occlusion
		local r = (2 + rnd() * 58) * big * f
		local alpha = if rnd() < 0.25 then 96 + (rnd() * 150) // 1 else 255
		local color = ((rnd() * 0xFFFFFF) // 1) + alpha * 16777216
		if kind == CIRCLE then
			Raster.circle(sc, color, cx, cy, r)
		elseif kind == BOX then
			Raster.box(sc, color, cx, cy, r, r * (0.3 + rnd()), r * 0.25)
		elseif kind == SEGMENT then
			local ang = rnd()
			local len = r * 2
			Raster.segment(sc, color, cx, cy, cx + MyMath.dcosTurns(ang) * len, cy + MyMath.dsinTurns(ang) * len, 1 + r * 0.15)
		elseif kind == RING then
			Raster.ring(sc, color, cx, cy, r, 1 + r * 0.1)
		else
			-- five-point star
			local pts = table.create(20, 0)
			local rot = rnd()
			for k = 0, 9 do
				local rr = if k % 2 == 0 then r else r * 0.45
				local t = rot + k / 10
				pts[2 * k + 1] = cx + MyMath.dcosTurns(t) * rr
				pts[2 * k + 2] = cy + MyMath.dsinTurns(t) * rr
			end
			Raster.polygon(sc, color, pts)
		end
	end
	return sc
end

----------------------------------------------------------------------------------
-- Signed distance of shape s at (px, py); used for node classification.
-- The per-pixel paths in shadeRect and shadeExact inline the same formulas.
-- Every distance here is exact or a 1-Lipschitz bound that is exact inside (the
-- cut disc uses the max of its constraints), which classification relies on.
----------------------------------------------------------------------------------

local sqrt = math.sqrt
local abs = math.abs

local function sdf(sc: Scene, s: number, px: number, py: number): number
	local k = sc.kind[s]
	if k == CIRCLE then
		local dx, dy = px - sc.p1[s], py - sc.p2[s]
		return sqrt(dx * dx + dy * dy) - sc.p3[s]
	elseif k == BOX then
		local rad = sc.p5[s]
		local qx = abs(px - sc.p1[s]) - sc.p3[s] + rad
		local qy = abs(py - sc.p2[s]) - sc.p4[s] + rad
		local ox = if qx > 0 then qx else 0
		local oy = if qy > 0 then qy else 0
		local inside = if qx > qy then qx else qy
		if inside > 0 then
			inside = 0
		end
		return sqrt(ox * ox + oy * oy) + inside - rad
	elseif k == SEGMENT then
		local pax, pay = px - sc.p1[s], py - sc.p2[s]
		local bax, bay = sc.p3[s], sc.p4[s]
		local hh = (pax * bax + pay * bay) * sc.p6[s]
		hh = if hh < 0 then 0 elseif hh > 1 then 1 else hh
		local dx, dy = pax - bax * hh, pay - bay * hh
		return sqrt(dx * dx + dy * dy) - sc.p5[s]
	elseif k == RING then
		local dx, dy = px - sc.p1[s], py - sc.p2[s]
		return abs(sqrt(dx * dx + dy * dy) - sc.p3[s]) - sc.p4[s]
	elseif k == CUTDISC then
		local v = sc.verts
		local i = sc.p4[s]
		local dx, dy = px - sc.p1[s], py - sc.p2[s]
		local d = sqrt(dx * dx + dy * dy) - sc.p3[s]
		local h1 = v[i] * dx + v[i + 1] * dy - v[i + 2]
		local h2 = v[i + 3] * dx + v[i + 4] * dy - v[i + 5]
		if h1 > d then
			d = h1
		end
		if h2 > d then
			d = h2
		end
		return d
	else
		local v = sc.verts
		local first, count = sc.p1[s], sc.p2[s]
		local last = first + 2 * count - 2
		local dmin = math.huge
		local sign = 1
		local jx, jy = v[last], v[last + 1]
		for i = first, last, 2 do
			local vx, vy = v[i], v[i + 1]
			local ex, ey = jx - vx, jy - vy
			local wx, wy = px - vx, py - vy
			local ee = ex * ex + ey * ey
			local t = if ee > 0 then (wx * ex + wy * ey) / ee else 0
			t = if t < 0 then 0 elseif t > 1 then 1 else t
			local bx, by = wx - ex * t, wy - ey * t
			local dd = bx * bx + by * by
			if dd < dmin then
				dmin = dd
			end
			local c1 = py >= vy
			local c2 = py < jy
			local c3 = ex * wy > ey * wx
			if (c1 and c2 and c3) or (not c1 and not c2 and not c3) then
				sign = -sign
			end
			jx, jy = vx, vy
		end
		return sign * sqrt(dmin)
	end
end
Raster.sdf = sdf

----------------------------------------------------------------------------------
-- The shared per-pixel shading routine (MODE_LINEAR).
-- Shades pixels [x0, x1] x [y0, y1] with shapes list[lo..hi] (bottom to top),
-- starting from shape `base` (fully covering and opaque) or the background.
----------------------------------------------------------------------------------

local function shadeRect(
	sc: Scene,
	out: buffer,
	width: number,
	x0: number,
	y0: number,
	x1: number,
	y1: number,
	base: number,
	list: { number },
	lo: number,
	hi: number
)
	local K, P1, P2, P3, P4, P5, P6 = sc.kind, sc.p1, sc.p2, sc.p3, sc.p4, sc.p5, sc.p6
	local CR, CG, CB, CA = sc.cr, sc.cg, sc.cb, sc.ca
	local V = sc.verts
	local w = sc.aa
	local r0, g0, b0, a0
	if base > 0 then
		r0, g0, b0, a0 = CR[base], CG[base], CB[base], 1
	else
		r0, g0, b0, a0 = sc.bgR, sc.bgG, sc.bgB, sc.bgA
	end
	for y = y0, y1 do
		local py = y + 0.5
		local o = (y * width + x0) * 4
		for x = x0, x1 do
			local px = x + 0.5
			local ar, ag, ab, aa = r0, g0, b0, a0
			for j = lo, hi do
				local s = list[j]
				local k = K[s]
				local d
				if k == CIRCLE then
					local dx, dy = px - P1[s], py - P2[s]
					d = sqrt(dx * dx + dy * dy) - P3[s]
				elseif k == BOX then
					local rad = P5[s]
					local qx = abs(px - P1[s]) - P3[s] + rad
					local qy = abs(py - P2[s]) - P4[s] + rad
					local ox = if qx > 0 then qx else 0
					local oy = if qy > 0 then qy else 0
					local inside = if qx > qy then qx else qy
					if inside > 0 then
						inside = 0
					end
					d = sqrt(ox * ox + oy * oy) + inside - rad
				elseif k == SEGMENT then
					local pax, pay = px - P1[s], py - P2[s]
					local bax, bay = P3[s], P4[s]
					local hh = (pax * bax + pay * bay) * P6[s]
					hh = if hh < 0 then 0 elseif hh > 1 then 1 else hh
					local dx, dy = pax - bax * hh, pay - bay * hh
					d = sqrt(dx * dx + dy * dy) - P5[s]
				elseif k == RING then
					local dx, dy = px - P1[s], py - P2[s]
					d = abs(sqrt(dx * dx + dy * dy) - P3[s]) - P4[s]
				elseif k == CUTDISC then
					local i = P4[s]
					local dx, dy = px - P1[s], py - P2[s]
					d = sqrt(dx * dx + dy * dy) - P3[s]
					local h1 = V[i] * dx + V[i + 1] * dy - V[i + 2]
					local h2 = V[i + 3] * dx + V[i + 4] * dy - V[i + 5]
					if h1 > d then
						d = h1
					end
					if h2 > d then
						d = h2
					end
				else
					local first = P1[s]
					local last = first + 2 * P2[s] - 2
					local dmin = math.huge
					local sign = 1
					local jx, jy = V[last], V[last + 1]
					for i = first, last, 2 do
						local vx, vy = V[i], V[i + 1]
						local ex, ey = jx - vx, jy - vy
						local wx, wy = px - vx, py - vy
						local ee = ex * ex + ey * ey
						local t = if ee > 0 then (wx * ex + wy * ey) / ee else 0
						t = if t < 0 then 0 elseif t > 1 then 1 else t
						local bx, by = wx - ex * t, wy - ey * t
						local dd = bx * bx + by * by
						if dd < dmin then
							dmin = dd
						end
						local c1 = py >= vy
						local c2 = py < jy
						local c3 = ex * wy > ey * wx
						if (c1 and c2 and c3) or (not c1 and not c2 and not c3) then
							sign = -sign
						end
						jx, jy = vx, vy
					end
					d = sign * sqrt(dmin)
				end
				local cov = 0.5 - d / w
				if cov > 0 then
					local sa = (if cov < 1 then cov else 1) * CA[s] / 255
					if sa >= 1 then
						ar, ag, ab, aa = CR[s], CG[s], CB[s], 1
					else
						local da = aa * (1 - sa)
						local oa = sa + da
						ar = (CR[s] * sa + ar * da) / oa
						ag = (CG[s] * sa + ag * da) / oa
						ab = (CB[s] * sa + ab * da) / oa
						aa = oa
					end
				end
			end
			buffer.writeu32(
				out,
				o,
				(ar + 0.5) // 1 + ((ag + 0.5) // 1) * 256 + ((ab + 0.5) // 1) * 65536 + ((aa * 255 + 0.5) // 1) * 16777216
			)
			o += 4
		end
	end
end

----------------------------------------------------------------------------------
-- Exact-area coverage (MODE_EXACT, MODE_LAYERED): F1 for every primitive.
-- Coverage is exactly 0 for d >= REACH and exactly 1 for d <= -REACH (REACH =
-- sqrt(2) / 2 AA widths), which classify uses; in between it is the exact area of
-- the w x w pixel inside the shape, divided by w^2.
----------------------------------------------------------------------------------

local REACH = MyMath.COVERAGE_REACH

-- The curvature-corrected estimator (C5) is MyMath's axiom; kept as Raster.covCurved
-- for compute/Rows.luau. MODE_EXACT does not use it (its residual is O(1/R)).
local covCurved = MyMath.coverageCurved
Raster.covCurved = covCurved

local halfPlane = MyMath.coverageHalfPlane
local discBoxArea = Coverage.discBoxArea
local discPolyArea = Coverage.discPolyArea
local polyArea = Coverage.polyArea
local clipInto = Coverage.clipInto
local polygonBoxCoverage = Coverage.polygonBoxCoverage

-- scratch polygons (pixel-local coordinates, pixel = [-1/2, 1/2]^2)
local QX: { number } = table.create(64, 0)
local QY: { number } = table.create(64, 0)
local RX: { number } = table.create(64, 0)
local RY: { number } = table.create(64, 0)

local function squareQ()
	QX[1], QY[1] = -0.5, -0.5
	QX[2], QY[2] = 0.5, -0.5
	QX[3], QY[3] = 0.5, 0.5
	QX[4], QY[4] = -0.5, 0.5
end

-- Length of [a0, a1] intersected with [b0, b1].
local function overlap(a0: number, a1: number, b0: number, b1: number): number
	local lo = if a0 > b0 then a0 else b0
	local hi = if a1 < b1 then a1 else b1
	return if hi > lo then hi - lo else 0
end

-- Exact area of the pixel box [X0, X1] x [Y0, Y1] (relative to the box centre)
-- inside the rounded box with half extents (hx, hy) and corner radius rad. The
-- rounded box is the disjoint union of the vertical band |x| <= hx - rad, the two
-- side rectangles hx - rad <= |x| <= hx, |y| <= hy - rad, and four corner pieces
-- (corner disc and corner quadrant), each measured exactly.
local function boxArea(X0: number, X1: number, Y0: number, Y1: number, hx: number, hy: number, rad: number): number
	if rad <= 0 then
		return overlap(X0, X1, -hx, hx) * overlap(Y0, Y1, -hy, hy)
	end
	local ix, iy = hx - rad, hy - rad
	if Y0 >= -iy and Y1 <= iy then
		return overlap(X0, X1, -hx, hx) * (Y1 - Y0)
	end
	if X0 >= -ix and X1 <= ix then
		return (X1 - X0) * overlap(Y0, Y1, -hy, hy)
	end
	local area = overlap(X0, X1, -ix, ix) * overlap(Y0, Y1, -hy, hy)
		+ (overlap(X0, X1, ix, hx) + overlap(X0, X1, -hx, -ix)) * overlap(Y0, Y1, -iy, iy)
	local xr0 = if X0 > ix then X0 else ix
	local xr1 = if X1 < hx then X1 else hx
	local xl0 = if X0 > -hx then X0 else -hx
	local xl1 = if X1 < -ix then X1 else -ix
	local yp0 = if Y0 > iy then Y0 else iy
	local yp1 = if Y1 < hy then Y1 else hy
	local yn0 = if Y0 > -hy then Y0 else -hy
	local yn1 = if Y1 < -iy then Y1 else -iy
	if xr1 > xr0 then
		if yp1 > yp0 then
			area += discBoxArea(ix, iy, rad, xr0, yp0, xr1, yp1)
		end
		if yn1 > yn0 then
			area += discBoxArea(ix, -iy, rad, xr0, yn0, xr1, yn1)
		end
	end
	if xl1 > xl0 then
		if yp1 > yp0 then
			area += discBoxArea(-ix, iy, rad, xl0, yp0, xl1, yp1)
		end
		if yn1 > yn0 then
			area += discBoxArea(-ix, -iy, rad, xl0, yn0, xl1, yn1)
		end
	end
	return area
end

-- Exact coverage of the w x w pixel centred at (px, py) by the capsule from A to
-- A + D with radius r. The capsule is the disjoint union of the body (points whose
-- projection on the axis lies in [0, L], within r of the axis) and the two caps
-- (points beyond an end line, within r of that end point), so its area in the
-- pixel is |pixel ^ body| + |pixel ^ {h <= 0} ^ disc(A)| + |pixel ^ {h >= L} ^
-- disc(B)|: a clipped square, and two discs with a clipped square. A pixel whose
-- projection lies inside [0, L] sees only the two straight sides (C4, exact).
local function capsuleCoverage(px: number, py: number, w: number, ax: number, ay: number, ddx: number, ddy: number, r: number): number
	local iw = 1 / w
	local Ax, Ay = (ax - px) * iw, (ay - py) * iw
	local rw = r * iw
	local L2 = ddx * ddx + ddy * ddy
	if L2 == 0 then
		return discBoxArea(Ax, Ay, rw, -0.5, -0.5, 0.5, 0.5)
	end
	local L = sqrt(L2)
	local ex, ey = ddx / L, ddy / L
	local nx, ny = -ey, ex
	local Lw = L * iw
	local eA = Ax * ex + Ay * ey
	local nA = Ax * nx + Ay * ny
	local h = -eA -- pixel centre along the axis, from A
	local sN = -nA -- pixel centre across the axis
	local hr = 0.5 * (abs(ex) + abs(ey)) -- half extent of the pixel along the axis
	if h - hr >= 0 and h + hr <= Lw then
		local c = halfPlane(sN - rw, nx, ny) + halfPlane(-sN - rw, nx, ny) - 1
		return if c < 0 then 0 else c
	end
	local area = 0
	if h + hr > 0 and h - hr < Lw then
		squareQ()
		local m = clipInto(QX, QY, 4, RX, RY, -ex, -ey, -eA)
		m = clipInto(RX, RY, m, QX, QY, ex, ey, eA + Lw)
		m = clipInto(QX, QY, m, RX, RY, nx, ny, nA + rw)
		m = clipInto(RX, RY, m, QX, QY, -nx, -ny, rw - nA)
		area += polyArea(QX, QY, m)
	end
	if h - hr < 0 then
		if h + hr <= 0 then
			area += discBoxArea(Ax, Ay, rw, -0.5, -0.5, 0.5, 0.5)
		else
			squareQ()
			local m = clipInto(QX, QY, 4, RX, RY, ex, ey, eA)
			area += discPolyArea(RX, RY, m, Ax, Ay, rw)
		end
	end
	if h + hr > Lw then
		local Bx, By = Ax + ddx * iw, Ay + ddy * iw
		if h - hr >= Lw then
			area += discBoxArea(Bx, By, rw, -0.5, -0.5, 0.5, 0.5)
		else
			squareQ()
			local m = clipInto(QX, QY, 4, RX, RY, -ex, -ey, -(eA + Lw))
			area += discPolyArea(RX, RY, m, Bx, By, rw)
		end
	end
	return if area < 0 then 0 elseif area > 1 then 1 else area
end

-- Exact coverage of the pixel by a cut disc: the square clipped by the half-planes
-- that cross it, intersected with the disc (or the plain clipped square / the plain
-- disc where the other part covers the pixel). d1, d2, dd are the pixel centre's
-- signed distances (AA widths) to the two lines and the circle.
local function cutDiscCoverage(
	px: number,
	py: number,
	w: number,
	cx: number,
	cy: number,
	r: number,
	n1x: number,
	n1y: number,
	o1: number,
	n2x: number,
	n2y: number,
	o2: number,
	d1: number,
	d2: number,
	dd: number
): number
	local iw = 1 / w
	local Cx, Cy, rw = (cx - px) * iw, (cy - py) * iw, r * iw
	local need1 = d1 > -REACH
	local need2 = d2 > -REACH and (n2x ~= 0 or n2y ~= 0)
	local c
	if not need1 and not need2 then
		c = discBoxArea(Cx, Cy, rw, -0.5, -0.5, 0.5, 0.5)
	else
		squareQ()
		local X, Y, m = QX, QY, 4
		if need1 then
			m = clipInto(X, Y, m, RX, RY, n1x, n1y, o1 * iw + n1x * Cx + n1y * Cy)
			X, Y = RX, RY
		end
		if need2 then
			if X == QX then
				m = clipInto(QX, QY, m, RX, RY, n2x, n2y, o2 * iw + n2x * Cx + n2y * Cy)
				X, Y = RX, RY
			else
				m = clipInto(RX, RY, m, QX, QY, n2x, n2y, o2 * iw + n2x * Cx + n2y * Cy)
				X, Y = QX, QY
			end
		end
		if dd <= -REACH then
			c = polyArea(X, Y, m)
		else
			c = discPolyArea(X, Y, m, Cx, Cy, rw)
		end
	end
	return if c < 0 then 0 elseif c > 1 then 1 else c
end

----------------------------------------------------------------------------------
-- Pieces for exact visibility (F2): each shape's indicator inside the pixel as a
-- signed sum of convex pieces (pixel-local coordinates, pixel = [-1/2, 1/2]^2).
----------------------------------------------------------------------------------

local GX: { number } = table.create(64, 0)
local GY: { number } = table.create(64, 0)
local HX: { number } = table.create(64, 0)
local HY: { number } = table.create(64, 0)
local TRX: { number } = table.create(3, 0)
local TRY: { number } = table.create(3, 0)

local function addPieces(sc: Scene, s: number, px: number, py: number, w: number)
	local k = sc.kind[s]
	local iw = 1 / w
	local P1, P2, P3, P4, P5 = sc.p1, sc.p2, sc.p3, sc.p4, sc.p5
	if k == CIRCLE then
		Visibility.square(1)
		Visibility.disc((P1[s] - px) * iw, (P2[s] - py) * iw, P3[s] * iw)
		Visibility.piece()
	elseif k == RING then
		local Cx, Cy = (P1[s] - px) * iw, (P2[s] - py) * iw
		local r, t = P3[s], P4[s]
		Visibility.square(1)
		Visibility.disc(Cx, Cy, (r + t) * iw)
		Visibility.piece()
		if r - t > 0 then
			Visibility.square(-1)
			Visibility.disc(Cx, Cy, (r - t) * iw)
			Visibility.piece()
		end
	elseif k == BOX then
		local bx, by = (P1[s] - px) * iw, (P2[s] - py) * iw
		local hx, hy, rad = P3[s] * iw, P4[s] * iw, P5[s] * iw
		if rad <= 0 then
			Visibility.rect(1, bx - hx, by - hy, bx + hx, by + hy)
			Visibility.piece()
		else
			local ix, iy = hx - rad, hy - rad
			if ix > 0 then
				Visibility.rect(1, bx - ix, by - hy, bx + ix, by + hy)
				Visibility.piece()
			end
			if iy > 0 then
				Visibility.rect(1, bx - hx, by - iy, bx - ix, by + iy)
				Visibility.piece()
				Visibility.rect(1, bx + ix, by - iy, bx + hx, by + iy)
				Visibility.piece()
			end
			Visibility.rect(1, bx + ix, by + iy, bx + hx, by + hy)
			Visibility.disc(bx + ix, by + iy, rad)
			Visibility.piece()
			Visibility.rect(1, bx - hx, by + iy, bx - ix, by + hy)
			Visibility.disc(bx - ix, by + iy, rad)
			Visibility.piece()
			Visibility.rect(1, bx + ix, by - hy, bx + hx, by - iy)
			Visibility.disc(bx + ix, by - iy, rad)
			Visibility.piece()
			Visibility.rect(1, bx - hx, by - hy, bx - ix, by - iy)
			Visibility.disc(bx - ix, by - iy, rad)
			Visibility.piece()
		end
	elseif k == SEGMENT then
		local Ax, Ay = (P1[s] - px) * iw, (P2[s] - py) * iw
		local ddx, ddy, rw = P3[s] * iw, P4[s] * iw, P5[s] * iw
		local L2 = ddx * ddx + ddy * ddy
		if L2 == 0 then
			Visibility.square(1)
			Visibility.disc(Ax, Ay, rw)
			Visibility.piece()
		else
			local L = sqrt(L2)
			local ex, ey = ddx / L, ddy / L
			local nx, ny = -ey, ex
			local eA = Ax * ex + Ay * ey
			local nA = Ax * nx + Ay * ny
			Visibility.square(1)
			Visibility.clip(-ex, -ey, -eA)
			Visibility.clip(ex, ey, eA + L)
			Visibility.clip(nx, ny, nA + rw)
			Visibility.clip(-nx, -ny, rw - nA)
			Visibility.piece()
			Visibility.square(1)
			Visibility.clip(ex, ey, eA)
			Visibility.disc(Ax, Ay, rw)
			Visibility.piece()
			Visibility.square(1)
			Visibility.clip(-ex, -ey, -(eA + L))
			Visibility.disc(Ax + ddx, Ay + ddy, rw)
			Visibility.piece()
		end
	elseif k == CUTDISC then
		local V = sc.verts
		local i = P4[s]
		local Cx, Cy = (P1[s] - px) * iw, (P2[s] - py) * iw
		Visibility.square(1)
		Visibility.clip(V[i], V[i + 1], V[i + 2] * iw + V[i] * Cx + V[i + 1] * Cy)
		if P5[s] == 2 then
			Visibility.clip(V[i + 3], V[i + 4], V[i + 5] * iw + V[i + 3] * Cx + V[i + 4] * Cy)
		end
		Visibility.disc(Cx, Cy, P3[s] * iw)
		Visibility.piece()
	else
		-- polygon: clip to the pixel, then one convex piece or a signed fan
		local V = sc.verts
		local first, count = P1[s], P2[s]
		for i = 1, count do
			GX[i] = (V[first + 2 * i - 2] - px) * iw
			GY[i] = (V[first + 2 * i - 1] - py) * iw
		end
		local m = clipInto(GX, GY, count, HX, HY, 1, 0, 0.5)
		m = clipInto(HX, HY, m, GX, GY, -1, 0, 0.5)
		m = clipInto(GX, GY, m, HX, HY, 0, 1, 0.5)
		m = clipInto(HX, HY, m, GX, GY, 0, -1, 0.5)
		if m < 3 then
			return
		end
		local A = polyArea(GX, GY, m)
		if A == 0 then
			return
		end
		if A < 0 then
			-- make the orientation positive (interior on the left of every edge)
			local i, j = 1, m
			while i < j do
				GX[i], GX[j] = GX[j], GX[i]
				GY[i], GY[j] = GY[j], GY[i]
				i += 1
				j -= 1
			end
		end
		local convex = true
		local ax, ay = GX[m - 1], GY[m - 1]
		local bx, by = GX[m], GY[m]
		for i = 1, m do
			local cx, cy = GX[i], GY[i]
			if (bx - ax) * (cy - by) - (by - ay) * (cx - bx) < -1e-12 then
				convex = false
				break
			end
			ax, ay, bx, by = bx, by, cx, cy
		end
		if convex then
			Visibility.poly(1, GX, GY, m)
			Visibility.piece()
		else
			-- winding number of the closed clip = sum of signed fan triangles
			local x0, y0 = GX[1], GY[1]
			for i = 2, m - 1 do
				local x1, y1, x2, y2 = GX[i], GY[i], GX[i + 1], GY[i + 1]
				local t = (x1 - x0) * (y2 - y0) - (y1 - y0) * (x2 - x0)
				if t > 0 then
					TRX[1], TRY[1], TRX[2], TRY[2], TRX[3], TRY[3] = x0, y0, x1, y1, x2, y2
					Visibility.poly(1, TRX, TRY, 3)
					Visibility.piece()
				elseif t < 0 then
					TRX[1], TRY[1], TRX[2], TRY[2], TRX[3], TRY[3] = x0, y0, x2, y2, x1, y1
					Visibility.poly(-1, TRX, TRY, 3)
					Visibility.piece()
				end
			end
		end
	end
end
Raster.addPieces = addPieces

-- Per-pixel coverage of list[lo..hi], kept for the exact-visibility path.
local COV: { number } = table.create(512, 0)

-- Exact composite of the pixel (F2): shapes list[from..hi] above the base colour
-- (straight r, g, b, alpha a), with coverages COV[j - lo + 1]. Top-down.
local function resolve(
	sc: Scene,
	list: { number },
	lo: number,
	from: number,
	hi: number,
	px: number,
	py: number,
	w: number,
	br: number,
	bg: number,
	bb: number,
	ba: number
): (number, number, number, number)
	Visibility.reset()
	local CR, CG, CB, CA = sc.cr, sc.cg, sc.cb, sc.ca
	for j = hi, from, -1 do
		local cov = COV[j - lo + 1]
		if cov > 0 then
			local s = list[j]
			local a = CA[s] / 255
			if cov >= 1 then
				Visibility.full(CR[s], CG[s], CB[s], a)
			else
				Visibility.begin(CR[s], CG[s], CB[s], a)
				addPieces(sc, s, px, py, w)
				Visibility.commit()
			end
		end
	end
	return Visibility.finish(br, bg, bb, ba)
end

local function shadeExact(
	sc: Scene,
	out: buffer,
	width: number,
	x0: number,
	y0: number,
	x1: number,
	y1: number,
	base: number,
	list: { number },
	lo: number,
	hi: number
)
	local K, P1, P2, P3, P4, P5, P6 = sc.kind, sc.p1, sc.p2, sc.p3, sc.p4, sc.p5, sc.p6
	local CR, CG, CB, CA = sc.cr, sc.cg, sc.cb, sc.ca
	local V = sc.verts
	local w = sc.aa
	local iw = 1 / w
	local iw2 = iw * iw
	local hw = w * 0.5
	local exactComposite = sc.mode == MODE_EXACT
	local r0, g0, b0, a0
	if base > 0 then
		r0, g0, b0, a0 = CR[base], CG[base], CB[base], 1
	else
		r0, g0, b0, a0 = sc.bgR, sc.bgG, sc.bgB, sc.bgA
	end
	for y = y0, y1 do
		local py = y + 0.5
		local o = (y * width + x0) * 4
		for x = x0, x1 do
			local px = x + 0.5
			local ar, ag, ab, aa = r0, g0, b0, a0
			local nf = 0 -- shapes with fractional coverage above the last opaque full one
			local reset = lo - 1 -- list index of the last opaque full shape (lo - 1: the base)
			for j = lo, hi do
				local s = list[j]
				local k = K[s]
				local cov
				if k == CIRCLE then
					local cx, cy = P1[s], P2[s]
					local dx, dy = px - cx, py - cy
					local r = P3[s]
					local d = (sqrt(dx * dx + dy * dy) - r) * iw
					if d >= REACH then
						cov = 0
					elseif d <= -REACH then
						cov = 1
					else
						cov = discBoxArea(cx, cy, r, px - hw, py - hw, px + hw, py + hw) * iw2
						cov = if cov > 1 then 1 else cov
					end
				elseif k == BOX then
					local rad = P5[s]
					local cx, cy, hx, hy = P1[s], P2[s], P3[s], P4[s]
					local qx = abs(px - cx) - hx + rad
					local qy = abs(py - cy) - hy + rad
					local ox = if qx > 0 then qx else 0
					local oy = if qy > 0 then qy else 0
					local inside = if qx > qy then qx else qy
					if inside > 0 then
						inside = 0
					end
					local d = (sqrt(ox * ox + oy * oy) + inside - rad) * iw
					if d >= REACH then
						cov = 0
					elseif d <= -REACH then
						cov = 1
					else
						cov = boxArea(px - hw - cx, px + hw - cx, py - hw - cy, py + hw - cy, hx, hy, rad) * iw2
						cov = if cov > 1 then 1 else cov
					end
				elseif k == SEGMENT then
					local ax, ay = P1[s], P2[s]
					local pax, pay = px - ax, py - ay
					local bax, bay = P3[s], P4[s]
					local hh = (pax * bax + pay * bay) * P6[s]
					hh = if hh < 0 then 0 elseif hh > 1 then 1 else hh
					local dx, dy = pax - bax * hh, pay - bay * hh
					local d = (sqrt(dx * dx + dy * dy) - P5[s]) * iw
					if d >= REACH then
						cov = 0
					elseif d <= -REACH then
						cov = 1
					else
						cov = capsuleCoverage(px, py, w, ax, ay, bax, bay, P5[s])
					end
				elseif k == RING then
					local cx, cy = P1[s], P2[s]
					local dx, dy = px - cx, py - cy
					local len = sqrt(dx * dx + dy * dy)
					local r, t = P3[s], P4[s]
					local d = (abs(len - r) - t) * iw
					if d >= REACH then
						cov = 0
					elseif d <= -REACH then
						cov = 1
					else
						-- annulus = outer disc minus inner disc, each exact
						local ro = r + t
						local dOut = (len - ro) * iw
						local cOut
						if dOut >= REACH then
							cOut = 0
						elseif dOut <= -REACH then
							cOut = 1
						else
							cOut = discBoxArea(cx, cy, ro, px - hw, py - hw, px + hw, py + hw) * iw2
						end
						local ri = r - t
						local cIn = 0
						if ri > 0 then
							local dIn = (len - ri) * iw
							if dIn >= REACH then
								cIn = 0
							elseif dIn <= -REACH then
								cIn = 1
							else
								cIn = discBoxArea(cx, cy, ri, px - hw, py - hw, px + hw, py + hw) * iw2
							end
						end
						cov = cOut - cIn
						cov = if cov < 0 then 0 elseif cov > 1 then 1 else cov
					end
				elseif k == CUTDISC then
					local i = P4[s]
					local cx, cy, r = P1[s], P2[s], P3[s]
					local dx, dy = px - cx, py - cy
					local dd = (sqrt(dx * dx + dy * dy) - r) * iw
					local n1x, n1y, o1 = V[i], V[i + 1], V[i + 2]
					local n2x, n2y, o2 = V[i + 3], V[i + 4], V[i + 5]
					local d1 = (n1x * dx + n1y * dy - o1) * iw
					local d2 = (n2x * dx + n2y * dy - o2) * iw
					local d = dd
					if d1 > d then
						d = d1
					end
					if d2 > d then
						d = d2
					end
					if d >= REACH then
						cov = 0
					elseif d <= -REACH then
						cov = 1
					else
						cov = cutDiscCoverage(px, py, w, cx, cy, r, n1x, n1y, o1, n2x, n2y, o2, d1, d2, dd)
					end
				else
					local first = P1[s]
					local count = P2[s]
					local last = first + 2 * count - 2
					local dmin = math.huge
					local sign = 1
					local jx, jy = V[last], V[last + 1]
					for i = first, last, 2 do
						local vx, vy = V[i], V[i + 1]
						local ex, ey = jx - vx, jy - vy
						local wx, wy = px - vx, py - vy
						local ee = ex * ex + ey * ey
						local t = if ee > 0 then (wx * ex + wy * ey) / ee else 0
						t = if t < 0 then 0 elseif t > 1 then 1 else t
						local bx, by = wx - ex * t, wy - ey * t
						local dd = bx * bx + by * by
						if dd < dmin then
							dmin = dd
						end
						local c1 = py >= vy
						local c2 = py < jy
						local c3 = ex * wy > ey * wx
						if (c1 and c2 and c3) or (not c1 and not c2 and not c3) then
							sign = -sign
						end
						jx, jy = vx, vy
					end
					local d = sign * sqrt(dmin) * iw
					if d >= REACH then
						cov = 0
					elseif d <= -REACH then
						cov = 1
					else
						-- exact area by per-edge Green integrals (any number of edges)
						cov = -P3[s] * polygonBoxCoverage(V, first, count, px - hw, py - hw, w)
						cov = if cov < 0 then 0 elseif cov > 1 then 1 else cov
					end
				end
				COV[j - lo + 1] = cov
				if cov > 0 then
					local sa = cov * CA[s] / 255
					if sa >= 1 then
						ar, ag, ab, aa = CR[s], CG[s], CB[s], 1
						nf = 0
						reset = j
					else
						local da = aa * (1 - sa)
						local oa = sa + da
						ar = (CR[s] * sa + ar * da) / oa
						ag = (CG[s] * sa + ag * da) / oa
						ab = (CB[s] * sa + ab * da) / oa
						aa = oa
						if cov < 1 then
							nf += 1
						end
					end
				end
			end
			if nf >= 2 and exactComposite then
				-- two or more edges in this pixel: exact visibility (F2)
				stats.conflicts += 1
				local br, bgc, bb, ba
				if reset >= lo then
					local s = list[reset]
					br, bgc, bb, ba = CR[s], CG[s], CB[s], 1
				else
					br, bgc, bb, ba = r0, g0, b0, a0
				end
				ar, ag, ab, aa = resolve(sc, list, lo, reset + 1, hi, px, py, w, br, bgc, bb, ba)
			end
			buffer.writeu32(
				out,
				o,
				(ar + 0.5) // 1 + ((ag + 0.5) // 1) * 256 + ((ab + 0.5) // 1) * 65536 + ((aa * 255 + 0.5) // 1) * 16777216
			)
			o += 4
		end
	end
end

local function shade(
	sc: Scene,
	out: buffer,
	width: number,
	x0: number,
	y0: number,
	x1: number,
	y1: number,
	base: number,
	list: { number },
	lo: number,
	hi: number
)
	if sc.mode == MODE_LINEAR then
		shadeRect(sc, out, width, x0, y0, x1, y1, base, list, lo, hi)
	else
		shadeExact(sc, out, width, x0, y0, x1, y1, base, list, lo, hi)
	end
end

----------------------------------------------------------------------------------
-- Reference renderers
----------------------------------------------------------------------------------

-- Every shape at every pixel. rows: optional list of row indices to render (the
-- benchmark samples rows because the full frame takes seconds in the interpreter).
function Raster.renderBrute(sc: Scene, out: buffer, width: number, height: number, rows: { number }?)
	local list = table.create(sc.n, 0)
	for s = 1, sc.n do
		list[s] = s
	end
	if rows then
		for _, y in rows do
			shade(sc, out, width, 0, y, width - 1, y, 0, list, 1, sc.n)
		end
	else
		shade(sc, out, width, 0, 0, width - 1, height - 1, 0, list, 1, sc.n)
	end
end

-- Painter's algorithm over each shape's bounding box with an 8-bit framebuffer
-- (read, unpack, blend, pack, write per covered pixel). Fast to write, but it
-- rounds to 8 bits after every shape, so it is not identical to renderBrute.
-- Linear coverage only (it is the baseline an engine DrawCircle loop gives).
function Raster.renderPainter(sc: Scene, out: buffer, width: number, height: number)
	local bg = (sc.bgR // 1) + (sc.bgG // 1) * 256 + (sc.bgB // 1) * 65536 + ((sc.bgA * 255 + 0.5) // 1) * 16777216
	Pixels.fill(out, bg)
	for s = 1, sc.n do
		local x0, y0 = math.max(0, sc.bx0[s]), math.max(0, sc.by0[s])
		local x1, y1 = math.min(width - 1, sc.bx1[s]), math.min(height - 1, sc.by1[s])
		local cr, cg, cb, ca = sc.cr[s], sc.cg[s], sc.cb[s], sc.ca[s]
		local w = sc.aa
		for y = y0, y1 do
			local py = y + 0.5
			local o = (y * width + x0) * 4
			for x = x0, x1 do
				local d = sdf(sc, s, x + 0.5, py)
				local cov = 0.5 - d / w
				if cov > 0 then
					local sa = (if cov < 1 then cov else 1) * ca / 255
					local p = buffer.readu32(out, o)
					local ia = 1 - sa
					local r = cr * sa + (p % 256) * ia
					local g = cg * sa + ((p // 256) % 256) * ia
					local b = cb * sa + ((p // 65536) % 256) * ia
					local a = sa * 255 + (p // 16777216) * ia
					buffer.writeu32(out, o, (r + 0.5) // 1 + ((g + 0.5) // 1) * 256 + ((b + 0.5) // 1) * 65536 + ((a + 0.5) // 1) * 16777216)
				end
				o += 4
			end
		end
	end
end

----------------------------------------------------------------------------------
-- Shape binning
----------------------------------------------------------------------------------

function Raster.bin(sc: Scene, width: number, height: number, tile: number?): Bins
	local t = tile or 64
	local tilesX, tilesY = (width + t - 1) // t, (height + t - 1) // t
	local lists: { { number } } = {}
	for i = 1, tilesX * tilesY do
		lists[i] = {}
	end
	for s = 1, sc.n do
		local tx0 = math.max(0, sc.bx0[s] // t)
		local ty0 = math.max(0, sc.by0[s] // t)
		local tx1 = math.min(tilesX - 1, sc.bx1[s] // t)
		local ty1 = math.min(tilesY - 1, sc.by1[s] // t)
		for ty = ty0, ty1 do
			for tx = tx0, tx1 do
				table.insert(lists[ty * tilesX + tx + 1], s)
			end
		end
	end
	return { tile = t, tilesX = tilesX, tilesY = tilesY, lists = lists }
end

----------------------------------------------------------------------------------
-- Lipschitz quadtree over one tile
----------------------------------------------------------------------------------

local SQRT_HALF = 0.70710678118654757
local EPS = 1e-7 -- covers rounding in sdf evaluation (|error| < 1e-12 at 1024 px)

local stack: { number } = table.create(4096, 0)

-- Classifies list stack[lo..hi] against the node [x, x+size) x [y, y+size).
-- Pushes the surviving shapes above the topmost covering opaque shape onto the
-- stack and returns (newLo, newHi, base, uniform).
local function classify(sc: Scene, x: number, y: number, size: number, lo: number, hi: number, base: number): (number, number, number, boolean)
	local cx, cy = x + size * 0.5, y + size * 0.5
	local reach = (size - 1) * SQRT_HALF * (1 + 1e-12) -- half-diagonal to the farthest pixel centre
	-- coverage is exactly 0 / 1 beyond half an AA width (linear) or sqrt(2)/2 (exact)
	local half = sc.aa * (if sc.mode ~= MODE_LINEAR then SQRT_HALF else 0.5)
	local CA = sc.ca
	local top = hi
	local allFull = true
	local nb = base
	local n = 0
	for j = hi, lo, -1 do
		local s = stack[j]
		local d = sdf(sc, s, cx, cy)
		stats.evals += 1
		if d - reach > half + EPS then
			continue -- coverage exactly 0 at every pixel centre of the node
		end
		local full = d + reach < -half - EPS -- coverage exactly 1 at every pixel centre
		if full and CA[s] == 255 then
			nb = s -- hides every shape below it
			break
		end
		if not full then
			allFull = false
		end
		n += 1
		stack[top + n] = s
	end
	-- surviving shapes were pushed top-down; reverse into bottom-up order
	local newLo, newHi = top + 1, top + n
	local i, k = newLo, newHi
	while i < k do
		stack[i], stack[k] = stack[k], stack[i]
		i += 1
		k -= 1
	end
	return newLo, newHi, nb, allFull
end

local function fillNode(sc: Scene, out: buffer, width: number, x: number, y: number, w: number, h: number, base: number, lo: number, hi: number)
	-- every remaining shape covers the node fully: shade one pixel, copy it everywhere
	local c
	if lo > hi then
		-- nothing above the base: the colour is known without shading (the same value
		-- shadeRect produces, since channels are integers and alpha is exactly 1 or bgA)
		if base > 0 then
			c = sc.cr[base] + sc.cg[base] * 256 + sc.cb[base] * 65536 + 0xFF000000
		else
			c = (sc.bgR + 0.5) // 1 + ((sc.bgG + 0.5) // 1) * 256 + ((sc.bgB + 0.5) // 1) * 65536 + ((sc.bgA * 255 + 0.5) // 1) * 16777216
		end
	else
		shade(sc, out, width, x, y, x, y, base, stack, lo, hi)
		c = buffer.readu32(out, (y * width + x) * 4)
	end
	Pixels.fillRect(out, width, x, y, w, h, c)
end

local function node(
	sc: Scene,
	out: buffer,
	width: number,
	height: number,
	x: number,
	y: number,
	size: number,
	lo: number,
	hi: number,
	base: number,
	leaf: number
)
	stats.nodes += 1
	local nlo, nhi, nb, uniform = classify(sc, x, y, size, lo, hi, base)
	local w = math.min(size, width - x)
	local h = math.min(size, height - y)
	if uniform then
		stats.uniform += 1
		fillNode(sc, out, width, x, y, w, h, nb, nlo, nhi)
	elseif size <= leaf then
		stats.leaves += 1
		stats.shaded += w * h
		shade(sc, out, width, x, y, x + w - 1, y + h - 1, nb, stack, nlo, nhi)
	else
		local half = size // 2
		node(sc, out, width, height, x, y, half, nlo, nhi, nb, leaf)
		if x + half < width then
			node(sc, out, width, height, x + half, y, half, nlo, nhi, nb, leaf)
		end
		if y + half < height then
			node(sc, out, width, height, x, y + half, half, nlo, nhi, nb, leaf)
			if x + half < width then
				node(sc, out, width, height, x + half, y + half, half, nlo, nhi, nb, leaf)
			end
		end
	end
end

-- Renders tiles [tx0, tx1] x [ty0, ty1] of the bins (all tiles by default).
-- leaf: smallest node edge that is shaded per pixel (default 8; power of two).
function Raster.render(
	sc: Scene,
	bins: Bins,
	out: buffer,
	width: number,
	height: number,
	leaf: number?,
	tx0: number?,
	ty0: number?,
	tx1: number?,
	ty1: number?
)
	local lf = leaf or 8
	local t = bins.tile
	for ty = ty0 or 0, ty1 or bins.tilesY - 1 do
		for tx = tx0 or 0, tx1 or bins.tilesX - 1 do
			local list = bins.lists[ty * bins.tilesX + tx + 1]
			local n = #list
			for i = 1, n do
				stack[i] = list[i]
			end
			node(sc, out, width, height, tx * t, ty * t, t, 1, n, 0, lf)
		end
	end
end

-- Re-renders after shapes changed: every tile touched by any of the pixel
-- rectangles {x0, y0, x1, y1} (old and new bounds of moved shapes). Returns the
-- number of tiles rendered.
function Raster.renderDirty(sc: Scene, bins: Bins, out: buffer, width: number, height: number, rects: { { number } }, leaf: number?): number
	local t = bins.tile
	local seen: { [number]: boolean } = {}
	local count = 0
	for _, r in rects do
		local tx0 = math.max(0, r[1] // t)
		local ty0 = math.max(0, r[2] // t)
		local tx1 = math.min(bins.tilesX - 1, r[3] // t)
		local ty1 = math.min(bins.tilesY - 1, r[4] // t)
		for ty = ty0, ty1 do
			for tx = tx0, tx1 do
				local key = ty * bins.tilesX + tx
				if not seen[key] then
					seen[key] = true
					count += 1
					Raster.render(sc, bins, out, width, height, leaf, tx, ty, tx, ty)
				end
			end
		end
	end
	return count
end

-- Time-sliced rendering: renders tiles in the given order until os.clock() passes
-- the deadline. Returns the index of the next tile to render (order length + 1
-- when finished). order holds 0-based tile indices (ty * tilesX + tx).
function Raster.renderUntil(sc: Scene, bins: Bins, out: buffer, width: number, height: number, order: { number }, from: number, deadline: number, leaf: number?): number
	local i = from
	local clock = os.clock
	while i <= #order do
		local k = order[i]
		local tx, ty = k % bins.tilesX, k // bins.tilesX
		Raster.render(sc, bins, out, width, height, leaf, tx, ty, tx, ty)
		i += 1
		if clock() >= deadline then
			break
		end
	end
	return i
end

return Raster
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Rows</string>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: compute/Rows
--
-- Batch row kernels (docs/COMPUTE.md 3.4 and 4.2): one exact-coverage disc, one
-- row at a time, three ways that write identical bytes:
--
--   direct   per pixel: e = dx^2 + dy^2, d = sqrt(e) - r, exact coverage
--   fd       forward differencing: e(x + 1) = e(x) + (2 dx + 1), so the square is
--            replaced by two additions. With the centre on a 1/16 grid every
--            value is a multiple of 1/256 below 2^45, so the additions are exact
--            and e is bit-identical to the direct square (C7).
--   spans    analytic spans: per row, the x-interval where the pixel can be
--            partly covered is solved from e = (r +- reach)^2; pixels well
--            inside are one span fill (buffer.copy doubling), pixels well
--            outside another, and only the band in between is shaded with the
--            same per-pixel formula. Cost per row: O(band), not O(width).
--
-- Output: straight-alpha RGBA8, colour rgb, alpha = round(255 * coverage).

local Pixels = require("../Pixels")
local Raster = require("./Raster")

local Rows = {}

local covCurved = Raster.covCurved
local sqrt = math.sqrt
local REACH = 0.70710678118654757

local function shadePixel(dx: number, dy: number, e: number, r: number, k: number): number
	local len = sqrt(e)
	if len > 0 then
		return covCurved(len - r, dx / len, dy / len, k)
	end
	return covCurved(-r, 1, 0, 0)
end

function Rows.circleDirect(out: buffer, width: number, y: number, cx: number, cy: number, r: number, rgb: number)
	local dy = y + 0.5 - cy
	local k = 1 / r
	local o = y * width * 4
	for x = 0, width - 1 do
		local dx = x + 0.5 - cx
		local e = dx * dx + dy * dy
		local c = shadePixel(dx, dy, e, r, k)
		buffer.writeu32(out, o, rgb + ((c * 255 + 0.5) // 1) * 16777216)
		o += 4
	end
end

function Rows.circleFD(out: buffer, width: number, y: number, cx: number, cy: number, r: number, rgb: number)
	local dy = y + 0.5 - cy
	local k = 1 / r
	local o = y * width * 4
	local dx = 0.5 - cx
	local e = dx * dx + dy * dy
	for _ = 0, width - 1 do
		local c = shadePixel(dx, dy, e, r, k)
		buffer.writeu32(out, o, rgb + ((c * 255 + 0.5) // 1) * 16777216)
		o += 4
		e += 2 * dx + 1 -- (dx + 1)^2 - dx^2
		dx += 1
	end
end

-- Returns the number of pixels shaded one by one.
function Rows.circleSpans(out: buffer, width: number, y: number, cx: number, cy: number, r: number, rgb: number): number
	local dy = y + 0.5 - cy
	local k = 1 / r
	local row = y * width * 4
	local ro = r + REACH
	local ro2 = ro * ro - dy * dy
	if ro2 <= 0 then
		Pixels.fillSpan(out, row, width, rgb) -- whole row outside the band
		return 0
	end
	-- pixel centres x + 0.5 with |x + 0.5 - cx| < hwOuter can be partly covered;
	-- widen by one pixel so the per-pixel formula, not the solve, decides edges
	local hwOuter = sqrt(ro2)
	local xa = math.max(0, math.floor(cx - hwOuter - 0.5) - 1)
	local xb = math.min(width - 1, math.ceil(cx + hwOuter - 0.5) + 1)
	local ri = r - REACH
	local ia, ib = xb + 1, xb -- empty interior unless the row crosses the inner disc
	if ri > 0 and ri * ri - dy * dy > 0 then
		local hwInner = sqrt(ri * ri - dy * dy)
		ia = math.ceil(cx - hwInner - 0.5) + 1
		ib = math.floor(cx + hwInner - 0.5) - 1
		if ia < xa then
			ia = xa
		end
		if ib > xb then
			ib = xb
		end
	end
	Pixels.fillSpan(out, row, xa, rgb)
	Pixels.fillSpan(out, row + (xb + 1) * 4, width - 1 - xb, rgb)
	local shaded = 0
	local function band(x0: number, x1: number)
		local o = row + x0 * 4
		for x = x0, x1 do
			local dx = x + 0.5 - cx
			local c = shadePixel(dx, dy, dx * dx + dy * dy, r, k)
			buffer.writeu32(out, o, rgb + ((c * 255 + 0.5) // 1) * 16777216)
			o += 4
		end
		shaded += x1 - x0 + 1
	end
	if ia <= ib then
		band(xa, ia - 1)
		Pixels.fillSpan(out, row + ia * 4, ib - ia + 1, rgb + 0xFF000000)
		band(ib + 1, xb)
	else
		band(xa, xb)
	end
	return shaded
end

return Rows
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Scanline</string>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: compute/Scanline
--
-- Exact-area polygon rasterizer by signed-area accumulation (the method of
-- R. Levien's font-rs). Every edge deposits, into the cells it crosses, the signed
-- area between itself and the right edge of the row; a running sum along the row
-- then gives the exact box-filtered coverage of every pixel. Cost is proportional
-- to the perimeter (cells crossed), not the area: between touched cells the running
-- sum is constant, so those spans are filled with buffer.copy (RUNTIME_AUDIT 6.7.3).
--
-- Fill rule: non-zero, coverage = min(1, |winding area|), which is the exact area
-- for paths whose winding number is 0 or +-1 everywhere (simple, non-overlapping
-- contours; holes wound the other way). Curves are flattened to line segments with
-- a sagitta tolerance (flattenEllipse), whose area error per pixel is at most about
-- 1.5 times the tolerance (that is the polygon's distance from the curve; the
-- polygon itself is rendered exactly).
--
-- Single path versus scenes (docs/COMPUTE.md F2, C11):
--   resolve, composite   one path. Exact (F1): the byte is the correctly rounded
--                        coverage, composited once over the destination.
--                        Painting a multi-path scene by calling composite per path
--                        is NOT exact: shared edges conflate (a 64/255 seam) and
--                        translucent layers round to 8 bits after every path.
--   renderScene          many paths, exact (F2): rows are processed top to bottom;
--                        each path's coverage comes from a one-row accumulator, is
--                        composited in floating point where the byte would be
--                        inexact (edges, translucent paths) and with span fills
--                        where it is exact (opaque interiors), and every pixel
--                        where two or more paths' edges enter is recomputed with
--                        exact visibility (compute/Visibility.luau) from the
--                        paths' geometry. Each output byte is rounded once.
--
-- Deterministic: + - * / floor ceil min max abs only (plus Coverage.dasin inside
-- Visibility's disc areas, unused for polygons).

local Pixels = require("../Pixels")
local MyMath = require("../MyMath")
local Coverage = require("./Coverage")
local Visibility = require("./Visibility")

local Scanline = {}

export type Accumulator = {
	width: number,
	height: number,
	stride: number, -- cells per row (width + 2)
	cells: buffer, -- f64 per cell
	ranges: { { number } }, -- per row: flat list of touched cell ranges (lo, hi, lo, hi, ...)
}

function Scanline.new(width: number, height: number): Accumulator
	local ranges: { { number } } = {}
	for y = 1, height do
		ranges[y] = {}
	end
	return {
		width = width,
		height = height,
		stride = width + 2,
		cells = buffer.create((width + 2) * height * 8),
		ranges = ranges,
	}
end

local floor, ceil = math.floor, math.ceil

-- Adds one edge with x already inside [0, width].
local function addLineInside(acc: Accumulator, x0: number, y0: number, x1: number, y1: number)
	if y0 == y1 then
		return
	end
	local dir = 1
	if y0 > y1 then
		dir = -1
		x0, y0, x1, y1 = x1, y1, x0, y0
	end
	local H = acc.height
	local stride = acc.stride
	local cells = acc.cells
	local ranges = acc.ranges
	local dxdy = (x1 - x0) / (y1 - y0)
	local x = x0
	if y0 < 0 then
		x -= y0 * dxdy
	end
	local yStart = if y0 > 0 then floor(y0) else 0
	local yEnd = if y1 < H then ceil(y1) else H
	for y = yStart, yEnd - 1 do
		local base = y * stride * 8
		local top = if y > y0 then y else y0
		local bot = if y + 1 < y1 then y + 1 else y1
		local dy = bot - top
		local xnext = x + dxdy * dy
		local d = dy * dir
		local xa, xb = x, xnext
		if xa > xb then
			xa, xb = xb, xa
		end
		local x0floor = floor(xa)
		local x1ceil = ceil(xb)
		local x0i, x1i = x0floor, x1ceil
		if x1i <= x0i + 1 then
			local xmf = 0.5 * (x + xnext) - x0floor
			local o = base + x0i * 8
			buffer.writef64(cells, o, buffer.readf64(cells, o) + d - d * xmf)
			buffer.writef64(cells, o + 8, buffer.readf64(cells, o + 8) + d * xmf)
			x1i = x0i + 1
		else
			local s = 1 / (xb - xa)
			local x0f = xa - x0floor
			local a0 = 0.5 * s * (1 - x0f) * (1 - x0f)
			local x1f = xb - x1ceil + 1
			local am = 0.5 * s * x1f * x1f
			local o = base + x0i * 8
			buffer.writef64(cells, o, buffer.readf64(cells, o) + d * a0)
			if x1i == x0i + 2 then
				buffer.writef64(cells, o + 8, buffer.readf64(cells, o + 8) + d * (1 - a0 - am))
			else
				local a1 = s * (1.5 - x0f)
				buffer.writef64(cells, o + 8, buffer.readf64(cells, o + 8) + d * (a1 - a0))
				local ds = d * s
				for xi = x0i + 2, x1i - 2 do
					local oi = base + xi * 8
					buffer.writef64(cells, oi, buffer.readf64(cells, oi) + ds)
				end
				local a2 = a1 + (x1i - x0i - 3) * s
				local ol = base + (x1i - 1) * 8
				buffer.writef64(cells, ol, buffer.readf64(cells, ol) + d * (1 - a2 - am))
			end
			local oe = base + x1i * 8
			buffer.writef64(cells, oe, buffer.readf64(cells, oe) + d * am)
		end
		local r = ranges[y + 1]
		r[#r + 1] = x0i
		r[#r + 1] = x1i
		x = xnext
	end
end

-- Adds one edge, clipping x to [0, width]: parts left of 0 become a vertical edge
-- on x = 0 (they cover every pixel to their right), parts right of width a
-- vertical edge on x = width (they cover nothing visible).
local function addLine(acc: Accumulator, x0: number, y0: number, x1: number, y1: number)
	local W = acc.width
	for _, k in { 0, W } do
		if (x0 < k) ~= (x1 < k) and x0 ~= k and x1 ~= k then
			local t = (k - x0) / (x1 - x0)
			local ym = y0 + (y1 - y0) * t
			addLine(acc, x0, y0, k, ym)
			addLine(acc, k, ym, x1, y1)
			return
		end
	end
	local cx0 = if x0 < 0 then 0 elseif x0 > W then W else x0
	local cx1 = if x1 < 0 then 0 elseif x1 > W then W else x1
	addLineInside(acc, cx0, y0, cx1, y1)
end
Scanline.addLine = addLine

-- Adds a closed polygon (flat {x1, y1, x2, y2, ...}).
function Scanline.addPolygon(acc: Accumulator, pts: { number })
	local n = #pts // 2
	local px, py = pts[2 * n - 1], pts[2 * n]
	for i = 1, n do
		local qx, qy = pts[2 * i - 1], pts[2 * i]
		addLine(acc, px, py, qx, qy)
		px, py = qx, qy
	end
end

-- Resolves the accumulated coverage into a straight-alpha layer: every pixel gets
-- colour rgb (0..0xFFFFFF) and alpha round(coverage * alpha). Spans between touched
-- cells are constant and are filled with buffer.copy. Clears the accumulator.
-- Returns the number of pixels computed one by one.
function Scanline.resolve(acc: Accumulator, out: buffer, rgb: number, alpha: number): number
	local W, H, stride = acc.width, acc.height, acc.stride
	local cells = acc.cells
	local perPixel = 0
	for y = 0, H - 1 do
		local r = acc.ranges[y + 1]
		local rowOut = y * W * 4
		local base = y * stride * 8
		local n = #r
		if n == 0 then
			Pixels.fillSpan(out, rowOut, W, rgb)
			continue
		end
		-- sort ranges by start (insertion sort on pairs; rows hold few ranges)
		for i = 3, n, 2 do
			local lo, hi = r[i], r[i + 1]
			local j = i - 2
			while j >= 1 and r[j] > lo do
				r[j + 2], r[j + 3] = r[j], r[j + 1]
				j -= 2
			end
			r[j + 2], r[j + 3] = lo, hi
		end
		local sum = 0
		local pos = 0 -- next pixel to write
		local i = 1
		while i <= n do
			local lo, hi = r[i], r[i + 1]
			i += 2
			-- merge overlapping or touching ranges
			while i <= n and r[i] <= hi + 1 do
				if r[i + 1] > hi then
					hi = r[i + 1]
				end
				i += 2
			end
			if lo > pos and pos < W then
				local a = math.min(1, math.abs(sum))
				local stop = if lo < W then lo else W
				Pixels.fillSpan(out, rowOut + pos * 4, stop - pos, rgb + ((a * alpha + 0.5) // 1) * 16777216)
				pos = stop
			end
			for x = lo, hi do
				local o = base + x * 8
				sum += buffer.readf64(cells, o)
				buffer.writef64(cells, o, 0)
				if x < W then
					local a = sum
					if a < 0 then
						a = -a
					end
					if a > 1 then
						a = 1
					end
					buffer.writeu32(out, rowOut + x * 4, rgb + ((a * alpha + 0.5) // 1) * 16777216)
					perPixel += 1
				end
			end
			if hi + 1 > pos then
				pos = hi + 1
			end
		end
		if pos < W then
			local a = math.min(1, math.abs(sum))
			Pixels.fillSpan(out, rowOut + pos * 4, W - pos, rgb + ((a * alpha + 0.5) // 1) * 16777216)
		end
		table.clear(r)
	end
	return perPixel
end

-- Composites the accumulated coverage onto an RGBA8 destination with straight-alpha
-- source-over, in colour `color` (packed RGBA8): the exact-area vector painter.
-- Rows without touched cells are not visited at all. Between touched ranges the
-- running sum is constant: 0 (span skipped), 1 (fully covered: one span fill for
-- an opaque colour) or a fraction, in rows that a horizontal edge or a vertex
-- crosses (blended pixel by pixel with that constant coverage). Clears the
-- accumulator. Returns the number of touched cells blended one by one.
function Scanline.composite(acc: Accumulator, dst: buffer, color: number): number
	local W, H, stride = acc.width, acc.height, acc.stride
	local cells = acc.cells
	local cr, cg, cb = color % 256, (color // 256) % 256, (color // 65536) % 256
	local ca = (color // 16777216) / 255
	local opaque = ca >= 1
	local perPixel = 0
	local function blend(o: number, cov: number)
		local sa = cov * ca
		if sa <= 0 then
			return
		end
		if sa >= 1 then
			buffer.writeu32(dst, o, color)
			return
		end
		local p = buffer.readu32(dst, o)
		local da = (p // 16777216) / 255 * (1 - sa)
		local oa = sa + da
		local r = (cr * sa + (p % 256) * da) / oa
		local g = (cg * sa + ((p // 256) % 256) * da) / oa
		local b = (cb * sa + ((p // 65536) % 256) * da) / oa
		buffer.writeu32(dst, o, (r + 0.5) // 1 + ((g + 0.5) // 1) * 256 + ((b + 0.5) // 1) * 65536 + ((oa * 255 + 0.5) // 1) * 16777216)
	end
	-- span [x0, x1) with constant winding sum s
	local function spanFill(rowOut: number, x0: number, x1: number, s: number)
		local a = if s < 0 then -s else s
		if a < 1e-9 then
			return
		end
		if a >= 1 - 1e-9 and opaque then
			Pixels.fillSpan(dst, rowOut + x0 * 4, x1 - x0, color)
			return
		end
		if a > 1 then
			a = 1
		end
		for x = x0, x1 - 1 do
			blend(rowOut + x * 4, a)
		end
	end
	for y = 0, H - 1 do
		local r = acc.ranges[y + 1]
		local n = #r
		if n == 0 then
			continue
		end
		local rowOut = y * W * 4
		local base = y * stride * 8
		for i = 3, n, 2 do
			local lo, hi = r[i], r[i + 1]
			local j = i - 2
			while j >= 1 and r[j] > lo do
				r[j + 2], r[j + 3] = r[j], r[j + 1]
				j -= 2
			end
			r[j + 2], r[j + 3] = lo, hi
		end
		local sum = 0
		local pos = 0
		local i = 1
		while i <= n do
			local lo, hi = r[i], r[i + 1]
			i += 2
			while i <= n and r[i] <= hi + 1 do
				if r[i + 1] > hi then
					hi = r[i + 1]
				end
				i += 2
			end
			if lo > pos and pos < W then
				spanFill(rowOut, pos, if lo < W then lo else W, sum)
			end
			for x = lo, hi do
				local o = base + x * 8
				sum += buffer.readf64(cells, o)
				buffer.writef64(cells, o, 0)
				if x < W then
					local a = sum
					if a < 0 then
						a = -a
					end
					if a > 1 then
						a = 1
					end
					blend(rowOut + x * 4, a)
					perPixel += 1
				end
			end
			if hi + 1 > pos then
				pos = hi + 1
			end
		end
		if pos < W then
			spanFill(rowOut, pos, W, sum)
		end
		table.clear(r)
	end
	return perPixel
end

-- Points of an ellipse (cx, cy, rx, ry) as a polygon whose chords deviate from the
-- curve by at most tol pixels (sagitta r (1 - cos(pi / n)) <= tol), so the
-- coverage error of any pixel is at most about 1.5 * tol (chord length inside a
-- pixel is at most sqrt(2)). Vertices come from MyMath's polynomial sine, so they
-- are bit-identical on every platform.
function Scanline.flattenEllipse(cx: number, cy: number, rx: number, ry: number, tol: number): { number }
	local r = math.max(rx, ry)
	-- 1 - cos(x) <= x^2 / 2, so n >= pi * sqrt(r / (2 tol)) guarantees the bound
	local n = math.max(8, ceil(3.14159265358979 * math.sqrt(r / (2 * tol))))
	local pts = table.create(2 * n, 0)
	for i = 0, n - 1 do
		local t = i / n
		pts[2 * i + 1] = cx + rx * MyMath.dcosTurns(t)
		pts[2 * i + 2] = cy + ry * MyMath.dsinTurns(t)
	end
	return pts
end

return Scanline
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Tiles</string>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: compute/Tiles
--
-- Tile-level structure for images of any size (docs/COMPUTE.md 2.2 and 2.6):
--
--   morton / unmorton   Z-order codes from bit32 "part1by1" (5 ops per axis) or a
--                       256-entry lookup table; tile orders (Morton, focus-first
--                       rings for Saturn's progressive refinement).
--   Store               content-addressed tiles. The key of a tile is its own pixel
--                       bytes as a Luau string: string interning hashes every byte
--                       and compares the full content on a hash match
--                       (VM/src/lstring.cpp), so equal keys mean equal pixels with
--                       no false positives and the work runs in C (C10).
--   Grid                a tiles-wide by tiles-high array of tile ids into a Store,
--                       copy-on-write: writing into a shared tile clones it first;
--                       commit() re-interns edited tiles so duplicates merge again.
--
-- Everything is integer and bit32 work; the bytes stored are the bytes given.

local Tiles = {}

local band, bor, lshift, rshift = bit32.band, bit32.bor, bit32.lshift, bit32.rshift

-- Spreads the low 16 bits of v to the even bit positions.
local function part1by1(v: number): number
	v = band(bor(v, lshift(v, 8)), 0x00FF00FF)
	v = band(bor(v, lshift(v, 4)), 0x0F0F0F0F)
	v = band(bor(v, lshift(v, 2)), 0x33333333)
	return band(bor(v, lshift(v, 1)), 0x55555555)
end

local function compact1by1(v: number): number
	v = band(v, 0x55555555)
	v = band(bor(v, rshift(v, 1)), 0x33333333)
	v = band(bor(v, rshift(v, 2)), 0x0F0F0F0F)
	v = band(bor(v, rshift(v, 4)), 0x00FF00FF)
	return band(bor(v, rshift(v, 8)), 0x0000FFFF)
end

-- Morton code of (x, y), 0 <= x, y < 65536: bits of x at even positions.
function Tiles.morton(x: number, y: number): number
	return part1by1(x) + 2 * part1by1(y)
end

function Tiles.unmorton(code: number): (number, number)
	return compact1by1(code), compact1by1(rshift(code, 1))
end

-- Lookup-table variant: 256 spread bytes, two lookups per axis.
local SPREAD: { number } = table.create(256, 0)
for i = 0, 255 do
	SPREAD[i + 1] = part1by1(i)
end
Tiles.SPREAD = SPREAD

function Tiles.mortonLUT(x: number, y: number): number
	return SPREAD[x % 256 + 1] + SPREAD[x // 256 + 1] * 65536 + 2 * (SPREAD[y % 256 + 1] + SPREAD[y // 256 + 1] * 65536)
end

-- Tile indices (ty * tilesX + tx) in Morton order, skipping codes outside the grid.
function Tiles.mortonOrder(tilesX: number, tilesY: number): { number }
	local side = 1
	while side < tilesX or side < tilesY do
		side *= 2
	end
	local order = table.create(tilesX * tilesY, 0)
	local n = 0
	for code = 0, side * side - 1 do
		local tx, ty = compact1by1(code), compact1by1(rshift(code, 1))
		if tx < tilesX and ty < tilesY then
			n += 1
			order[n] = ty * tilesX + tx
		end
	end
	return order
end

-- Tile indices ordered by Chebyshev ring around the focus tile (fx, fy), Morton
-- order inside a ring: Saturn's rings, rendered nearest first.
function Tiles.ringOrder(tilesX: number, tilesY: number, fx: number, fy: number): { number }
	local order = Tiles.mortonOrder(tilesX, tilesY)
	local ring = table.create(tilesX * tilesY, 0)
	local rank = table.create(tilesX * tilesY, 0)
	for i, t in order do
		local tx, ty = t % tilesX, t // tilesX
		ring[t + 1] = math.max(math.abs(tx - fx), math.abs(ty - fy))
		rank[t + 1] = i
	end
	table.sort(order, function(a: number, b: number): boolean
		local ra, rb = ring[a + 1], ring[b + 1]
		if ra ~= rb then
			return ra < rb
		end
		return rank[a + 1] < rank[b + 1]
	end)
	return order
end

----------------------------------------------------------------------------------
-- Content-addressed tile store
----------------------------------------------------------------------------------

export type Store = {
	size: number, -- tile edge in pixels
	byKey: { [string]: number }, -- content -> tile id
	keys: { string }, -- id -> content key ("" when the tile is private / being edited)
	tiles: { buffer }, -- id -> pixels (size * size * 4 bytes, row-major)
	refs: { number }, -- id -> number of grid cells using it
	free: { number }, -- recycled ids
	unique: number,
}

function Tiles.newStore(size: number): Store
	return { size = size, byKey = {}, keys = {}, tiles = {}, refs = {}, free = {}, unique = 0 }
end

local scratch: buffer? = nil

local function newId(store: Store): number
	local n = #store.free
	if n > 0 then
		local id = store.free[n]
		store.free[n] = nil
		return id
	end
	return #store.tiles + 1
end

-- Interns a packed tile buffer; returns its id and adds one reference.
local function internBuffer(store: Store, tile: buffer): number
	local key = buffer.tostring(tile)
	local id = store.byKey[key]
	if id then
		store.refs[id] += 1
		return id
	end
	id = newId(store)
	store.byKey[key] = id
	store.keys[id] = key
	store.tiles[id] = tile
	store.refs[id] = 1
	store.unique += 1
	return id
end
Tiles.internBuffer = internBuffer

-- Interns the size x size tile at pixel (x, y) of an image `width` pixels wide
-- (the tile must lie inside the image).
function Tiles.intern(store: Store, img: buffer, width: number, x: number, y: number): number
	local s = store.size
	local bytes = s * s * 4
	local t = scratch
	if t == nil or buffer.len(t) ~= bytes then
		t = buffer.create(bytes)
		scratch = t
	end
	local tb = t :: buffer
	local rowBytes = s * 4
	for r = 0, s - 1 do
		buffer.copy(tb, r * rowBytes, img, ((y + r) * width + x) * 4, rowBytes)
	end
	local key = buffer.tostring(tb)
	local id = store.byKey[key]
	if id then
		store.refs[id] += 1
		return id
	end
	-- new content: keep a private copy of the pixels
	local own = buffer.create(bytes)
	buffer.copy(own, 0, tb, 0, bytes)
	id = newId(store)
	store.byKey[key] = id
	store.keys[id] = key
	store.tiles[id] = own
	store.refs[id] = 1
	store.unique += 1
	return id
end

-- Drops one reference; frees the tile when none remain.
function Tiles.release(store: Store, id: number)
	local r = store.refs[id] - 1
	store.refs[id] = r
	if r == 0 then
		local key = store.keys[id]
		if key ~= "" and store.byKey[key] == id then
			store.byKey[key] = nil
		end
		store.keys[id] = ""
		store.tiles[id] = buffer.create(0)
		table.insert(store.free, id)
		store.unique -= 1
	end
end

----------------------------------------------------------------------------------
-- Copy-on-write grid
----------------------------------------------------------------------------------

export type Grid = {
	store: Store,
	tilesX: number,
	tilesY: number,
	ids: { number },
	dirty: { [number]: boolean }, -- cells holding a private, edited tile
}

-- Builds a grid from a full image (width and height multiples of the tile size).
function Tiles.fromImage(store: Store, img: buffer, width: number, height: number): Grid
	local s = store.size
	local tx, ty = width // s, height // s
	local ids = table.create(tx * ty, 0)
	for j = 0, ty - 1 do
		for i = 0, tx - 1 do
			ids[j * tx + i + 1] = Tiles.intern(store, img, width, i * s, j * s)
		end
	end
	return { store = store, tilesX = tx, tilesY = ty, ids = ids, dirty = {} }
end

-- Writes the grid into a full image (row blits).
function Tiles.compose(grid: Grid, out: buffer)
	local store = grid.store
	local s = store.size
	local width = grid.tilesX * s
	local rowBytes = s * 4
	for j = 0, grid.tilesY - 1 do
		for i = 0, grid.tilesX - 1 do
			local tile = store.tiles[grid.ids[j * grid.tilesX + i + 1]]
			local base = (j * s * width + i * s) * 4
			for r = 0, s - 1 do
				buffer.copy(out, base + r * width * 4, tile, r * rowBytes, rowBytes)
			end
		end
	end
end

-- Returns a buffer for cell (i, j) that may be written: if the cell's tile is
-- shared or interned, it is cloned into a private tile first (copy on write).
function Tiles.edit(grid: Grid, i: number, j: number): buffer
	local cell = j * grid.tilesX + i + 1
	local store = grid.store
	local id = grid.ids[cell]
	if grid.dirty[cell] then
		return store.tiles[id]
	end
	local src = store.tiles[id]
	local copy = buffer.create(buffer.len(src))
	buffer.copy(copy, 0, src, 0, buffer.len(src))
	Tiles.release(store, id)
	local nid = newId(store)
	store.keys[nid] = ""
	store.tiles[nid] = copy
	store.refs[nid] = 1
	store.unique += 1
	grid.ids[cell] = nid
	grid.dirty[cell] = true
	return copy
end

-- Re-interns every edited tile so equal content is shared again. Returns the
-- number of edited tiles that turned out to duplicate an existing tile.
function Tiles.commit(grid: Grid): number
	local store = grid.store
	local merged = 0
	for cell in grid.dirty do
		local id = grid.ids[cell]
		local tile = store.tiles[id]
		-- detach the private tile, then intern its content
		store.refs[id] = 0
		store.keys[id] = ""
		store.tiles[id] = buffer.create(0)
		table.insert(store.free, id)
		store.unique -= 1
		local before = store.unique
		local nid = internBuffer(store, tile)
		if store.unique == before then
			merged += 1
		end
		grid.ids[cell] = nid
	end
	table.clear(grid.dirty)
	return merged
end

-- Bytes held by unique tiles (pixels plus their string keys).
function Tiles.bytes(store: Store): number
	local s = store.size
	return store.unique * s * s * 4 * 2
end

return Tiles
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Trace</string>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: compute/Trace
--
-- Sphere tracing a 3D signed distance field into 2D maps (docs/COMPUTE.md 3.10):
-- an orthographic view down -z gives, per pixel, the first hit, its normal (from
-- a 4-tap tetrahedral gradient) and its height. Outputs a tangent-space normal
-- map (RGB = 127.5 + 127.5 n, alpha 255 on hit, 0 on miss) and a u8 height map.
-- Impostors, bevels, embossed UI and procedural relief come from this; the
-- height map also feeds Filter.normalMap.
--
-- Determinism: + - * / sqrt abs only, a fixed step limit and epsilon, so every
-- client reproduces the same bytes. Cost: steps x SDF cost per pixel, so pixels
-- whose ray misses the object's bounding sphere are skipped in screen space
-- (one span fill per row), and the step loop stops at the bound's far side.

local Pixels = require("../Pixels")

local Trace = {}

export type Scene = {
	sdf: (number, number, number) -> number, -- Lipschitz <= 1
	cx: number, -- bounding sphere (pixels)
	cy: number,
	cz: number,
	br: number,
}

local sqrt, abs = math.sqrt, math.abs

local function smin(a: number, b: number, k: number): number
	local h = 0.5 + 0.5 * (b - a) / k
	h = if h < 0 then 0 elseif h > 1 then 1 else h
	return b + (a - b) * h - k * h * (1 - h)
end

-- Demo scene scaled to a size x size image: a sphere smoothly merged with a torus
-- lying in the image plane and a rounded slab. Units are pixels.
function Trace.demo(size: number): Scene
	local s = size / 256
	local cx, cy = size * 0.5, size * 0.5
	local R, tr, tt = 70 * s, 85 * s, 14 * s
	local function sdf(x: number, y: number, z: number): number
		local dx, dy, dz = x - cx, y - cy, z
		local sphere = sqrt(dx * dx + dy * dy + dz * dz) - R
		local q = sqrt(dx * dx + dy * dy) - tr
		local torus = sqrt(q * q + dz * dz) - tt
		-- rounded slab |x|, |y| <= 110 s, |z| <= 6 s, edge radius 4 s
		local bx = abs(dx) - 106 * s
		local by = abs(dy) - 106 * s
		local bz = abs(dz) - 2 * s
		local ox = if bx > 0 then bx else 0
		local oy = if by > 0 then by else 0
		local oz = if bz > 0 then bz else 0
		local m = if bx > by then bx else by
		if bz > m then
			m = bz
		end
		if m > 0 then
			m = 0
		end
		local slab = sqrt(ox * ox + oy * oy + oz * oz) + m - 4 * s
		return smin(smin(sphere, torus, 12 * s), slab, 8 * s)
	end
	return { sdf = sdf, cx = cx, cy = cy, cz = 0, br = 152 * s }
end

export type TraceStats = { rays: number, steps: number, hits: number }

-- Traces every pixel; writes the normal map into `normals` (RGBA8) and heights
-- (z of the hit, 0 at the bound's far side .. 255 at its near side) into `heights`
-- (u8). maxSteps bounds the work per ray; eps is the hit threshold in pixels.
function Trace.render(sc: Scene, size: number, normals: buffer, heights: buffer, maxSteps: number, eps: number): TraceStats
	local st: TraceStats = { rays = 0, steps = 0, hits = 0 }
	local f = sc.sdf
	local cx, cy, cz, br = sc.cx, sc.cy, sc.cz, sc.br
	local zBot = cz - br
	local hScale = 255 / (2 * br)
	local e = 0.5 -- gradient tap distance
	for y = 0, size - 1 do
		local py = y + 0.5
		local row = y * size
		local dy = py - cy
		local hw2 = br * br - dy * dy
		if hw2 <= 0 then
			Pixels.fillSpan(normals, row * 4, size, 0x00FF8080)
			buffer.fill(heights, row, 0, size)
			continue
		end
		local hw = sqrt(hw2)
		local xa = math.max(0, math.floor(cx - hw - 0.5))
		local xb = math.min(size - 1, math.ceil(cx + hw - 0.5))
		Pixels.fillSpan(normals, row * 4, xa, 0x00FF8080)
		Pixels.fillSpan(normals, (row + xb + 1) * 4, size - 1 - xb, 0x00FF8080)
		buffer.fill(heights, row, 0, size)
		for x = xa, xb do
			local px = x + 0.5
			st.rays += 1
			-- enter the bounding sphere at its near surface
			local dx = px - cx
			local inside = br * br - dx * dx - dy * dy
			local o = (row + x) * 4
			if inside <= 0 then
				buffer.writeu32(normals, o, 0x00FF8080)
				continue
			end
			local z = cz + sqrt(inside)
			local zEnd = cz - sqrt(inside)
			local hit = false
			for _ = 1, maxSteps do
				local d = f(px, py, z)
				st.steps += 1
				if d < eps then
					hit = true
					break
				end
				z -= d
				if z < zEnd then
					break
				end
			end
			if not hit then
				buffer.writeu32(normals, o, 0x00FF8080)
				continue
			end
			st.hits += 1
			-- tetrahedral gradient: k1 = (1,-1,-1), k2 = (-1,-1,1), k3 = (-1,1,-1), k4 = (1,1,1)
			local f1 = f(px + e, py - e, z - e)
			local f2 = f(px - e, py - e, z + e)
			local f3 = f(px - e, py + e, z - e)
			local f4 = f(px + e, py + e, z + e)
			local gx = f1 - f2 - f3 + f4
			local gy = -f1 - f2 + f3 + f4
			local gz = -f1 + f2 - f3 + f4
			local inv = 1 / sqrt(gx * gx + gy * gy + gz * gz)
			local nx, ny, nz = gx * inv, gy * inv, gz * inv
			buffer.writeu32(
				normals,
				o,
				((nx + 1) * 127.5 + 0.5) // 1 + (((ny + 1) * 127.5 + 0.5) // 1) * 256 + (((nz + 1) * 127.5 + 0.5) // 1) * 65536 + 0xFF000000
			)
			local hv = (z - zBot) * hScale
			hv = if hv < 0 then 0 elseif hv > 255 then 255 else hv
			buffer.writeu8(heights, row + x, (hv + 0.5) // 1)
		end
	end
	return st
end

-- Simple Lambert shading of a normal map (light direction l normalised by the
-- caller), for previews: rgb = albedo * max(0, n . l), alpha kept.
function Trace.shade(normals: buffer, count: number, lx: number, ly: number, lz: number, albedo: number, out: buffer)
	local ar, ag, ab = albedo % 256, (albedo // 256) % 256, (albedo // 65536) % 256
	for i = 0, count - 1 do
		local p = buffer.readu32(normals, i * 4)
		local a = p // 16777216
		if a == 0 then
			buffer.writeu32(out, i * 4, 0)
			continue
		end
		local nx = (p % 256) / 127.5 - 1
		local ny = ((p // 256) % 256) / 127.5 - 1
		local nz = ((p // 65536) % 256) / 127.5 - 1
		local l = nx * lx + ny * ly + nz * lz
		if l < 0 then
			l = 0
		end
		buffer.writeu32(out, i * 4, ((ar * l + 0.5) // 1) + ((ag * l + 0.5) // 1) * 256 + ((ab * l + 0.5) // 1) * 65536 + a * 16777216)
	end
end

return Trace
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Visibility</string>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: compute/Visibility
--
-- Exact visibility for "conflict pixels": pixels where the edges of two or more
-- shapes enter (docs/COMPUTE.md F2 and C11). Elsewhere coverage-as-alpha is exact
-- (proof in the "Flawless pipeline" section of docs/COMPUTE.md); here it is not,
-- because the shapes' coverage regions inside the pixel are correlated (abutting
-- shapes are perfectly anti-correlated: two exact halves composite to 3/4, a
-- 64/255 seam). This module computes the exact box filter of the source-over
-- composite of a pixel's shape stack instead.
--
-- Method (signed convex terms). In pixel-local coordinates (pixel = the square
-- [-1/2, 1/2]^2), every shape's indicator inside the pixel is written as a signed
-- sum of CONVEX PIECES, sum_j sigma_j 1[K_j], each piece = (convex polygon inside
-- the square) intersected with at most one disc. Disc complements and non-convex
-- polygons are expressed through the signs (ring = outer disc - inner disc,
-- polygon = signed fan of triangles of its clip to the pixel). The stack is
-- processed top-down while maintaining the transmittance
--     nu(q) = prod over shapes t above (1 - alpha_t I_t(q))
-- as a signed weighted sum of terms, sum_k w_k 1[R_k], with every region R_k an
-- intersection of pieces (convex polygon and a set of discs). Shape s contributes
--     alpha_s c_s * integral(I_s nu) = alpha_s c_s * sum_k sum_j w_k sigma_j |R_k ^ K_j|
-- and updates nu <- nu - alpha_s I_s nu, which appends the terms (R_k ^ K_j,
-- -alpha_s sigma_j w_k). A shape that covers the whole pixel (I_s = 1) contributes
-- alpha_s c_s integral(nu) and scales every weight by (1 - alpha_s). The base below
-- the stack contributes alpha_0 c_0 integral(nu). The result is the premultiplied
-- integral of the exact composite over the pixel; dividing by the alpha integral
-- gives straight alpha.
--
-- Exact areas: |R| for R = (convex polygon) ^ D_1 ^ ... ^ D_k. The polygon part is
-- a Sutherland-Hodgman clip (exact up to rounding). With k = 1 the area is
-- Coverage.discPolyArea; with k >= 2 the POWER-CELL LEMMA reduces it to k single
-- disc areas: with power functions p_i(q) = |q - c_i|^2 - r_i^2, on the cell where
-- p_i is the largest the intersection of all discs is {p_i <= 0} = D_i, and every
-- cell {p_i >= p_j for all j} is convex (p_i - p_j is affine), so
--     |P ^ D_1 ^ ... ^ D_k| = sum_i |P ^ cell_i ^ D_i|.
-- Identical discs (zero normal, zero offset) are tie-broken by index.
--
-- Abutting shapes: complementary pieces (a shared edge with opposite inner sides)
-- intersect in a zero-area sliver, so they never double count; no tolerance or
-- snapping is involved. Terms with zero area are pruned, so k mutually disjoint
-- shapes cost O(k^2) clips, while k mutually overlapping fractional shapes can
-- need up to 2^k terms: the term list is capped at MAX_TERMS (stats.capped counts
-- pixels where the cap bound; none in any measured scene).
--
-- Usage per pixel (allocation-free after warm-up; module-level scratch):
--   Visibility.reset()
--   for each shape from the TOP of the stack down to just above the base:
--     Visibility.full(r, g, b, a)                  -- covers the whole pixel
--     or Visibility.begin(r, g, b, a)               -- partly covers it, then pieces:
--          Visibility.square(sign) / rect(sign, x0, y0, x1, y1) / poly(sign, xs, ys, n)
--          Visibility.clip(nx, ny, c)               -- keep {nx x + ny y <= c}
--          Visibility.disc(cx, cy, r)               -- intersect with a disc
--          Visibility.piece()                       -- store the piece
--        Visibility.commit()
--   r, g, b, a = Visibility.finish(baseR, baseG, baseB, baseA)   -- straight alpha
-- Colours are 0..255 floats, alphas 0..1. Deterministic ops only (+ - * / sqrt,
-- comparisons, and Coverage.dasin through the disc areas).

local Coverage = require("./Coverage")

local Visibility = {}

local clipInto = Coverage.clipInto
local polyArea = Coverage.polyArea
local discPolyArea = Coverage.discPolyArea

local MAX_TERMS = 1024
Visibility.MAX_TERMS = MAX_TERMS

export type Stats = { pixels: number, terms: number, areas: number, capped: number }
local stats: Stats = { pixels = 0, terms = 0, areas = 0, capped = 0 }
Visibility.stats = stats

function Visibility.resetStats()
	stats.pixels, stats.terms, stats.areas, stats.capped = 0, 0, 0, 0
end

-- pieces of the current entry
local PS: { number } = table.create(32, 0) -- sign
local PV0: { number } = table.create(32, 0) -- first vertex in PX, PY
local PN: { number } = table.create(32, 0) -- vertex count
local PD: { number } = table.create(32, 0) -- 1: has a disc
local PDX: { number } = table.create(32, 0)
local PDY: { number } = table.create(32, 0)
local PDR: { number } = table.create(32, 0)
local PX: { number } = table.create(512, 0)
local PY: { number } = table.create(512, 0)
local nP, nPV = 0, 0

-- terms of nu
local TW: { number } = table.create(256, 0) -- weight
local TA: { number } = table.create(256, 0) -- area
local TV0: { number } = table.create(256, 0)
local TN: { number } = table.create(256, 0)
local TD0: { number } = table.create(256, 0)
local TND: { number } = table.create(256, 0)
local TX: { number } = table.create(2048, 0)
local TY: { number } = table.create(2048, 0)
local TDX: { number } = table.create(512, 0)
local TDY: { number } = table.create(512, 0)
local TDR: { number } = table.create(512, 0)
local nT, nTV, nTD = 0, 0, 0

local accR, accG, accB, accA = 0, 0, 0, 0
local eR, eG, eB, eA = 0, 0, 0, 0

-- piece under construction (ping-pong clip buffers)
local AX: { number } = table.create(64, 0)
local AY: { number } = table.create(64, 0)
local BX: { number } = table.create(64, 0)
local BY: { number } = table.create(64, 0)
local cur = 0 -- 0: current polygon in A, 1: in B
local wn = 0
local wSign, wDisc, wDX, wDY, wDR = 0, 0, 0, 0, 0

-- region measurement scratch
local VX: { number } = table.create(64, 0)
local VY: { number } = table.create(64, 0)
local UX: { number } = table.create(64, 0)
local UY: { number } = table.create(64, 0)
local CX: { number } = table.create(64, 0)
local CY: { number } = table.create(64, 0)
local DX2: { number } = table.create(64, 0)
local DY2: { number } = table.create(64, 0)
local KX: { number } = table.create(16, 0)
local KY: { number } = table.create(16, 0)
local KR: { number } = table.create(16, 0)

function Visibility.reset()
	stats.pixels += 1
	-- one term: the whole pixel, weight 1, area 1, no discs
	TX[1], TY[1] = -0.5, -0.5
	TX[2], TY[2] = 0.5, -0.5
	TX[3], TY[3] = 0.5, 0.5
	TX[4], TY[4] = -0.5, 0.5
	TW[1], TA[1], TV0[1], TN[1], TD0[1], TND[1] = 1, 1, 1, 4, 1, 0
	nT, nTV, nTD = 1, 4, 0
	accR, accG, accB, accA = 0, 0, 0, 0
end

-- A shape that covers the whole pixel with straight colour (r, g, b), alpha a < 1.
function Visibility.full(r: number, g: number, b: number, a: number)
	local W = 0
	for t = 1, nT do
		W += TW[t] * TA[t]
	end
	local k = a * W
	accR += r * k
	accG += g * k
	accB += b * k
	accA += k
	local f = 1 - a
	for t = 1, nT do
		TW[t] *= f
	end
end

-- Starts a shape that covers the pixel partly; its pieces follow.
function Visibility.begin(r: number, g: number, b: number, a: number)
	eR, eG, eB, eA = r, g, b, a
	nP, nPV = 0, 0
end

-- Piece construction ---------------------------------------------------------------

-- Starts a piece equal to the whole pixel square.
function Visibility.square(sign: number)
	AX[1], AY[1] = -0.5, -0.5
	AX[2], AY[2] = 0.5, -0.5
	AX[3], AY[3] = 0.5, 0.5
	AX[4], AY[4] = -0.5, 0.5
	cur, wn = 0, 4
	wSign, wDisc = sign, 0
end

-- Starts a piece equal to the rectangle [x0, x1] x [y0, y1] clipped to the pixel.
function Visibility.rect(sign: number, x0: number, y0: number, x1: number, y1: number)
	if x0 < -0.5 then
		x0 = -0.5
	end
	if y0 < -0.5 then
		y0 = -0.5
	end
	if x1 > 0.5 then
		x1 = 0.5
	end
	if y1 > 0.5 then
		y1 = 0.5
	end
	wSign, wDisc, cur = sign, 0, 0
	if x1 <= x0 or y1 <= y0 then
		wn = 0
		return
	end
	AX[1], AY[1] = x0, y0
	AX[2], AY[2] = x1, y0
	AX[3], AY[3] = x1, y1
	AX[4], AY[4] = x0, y1
	wn = 4
end

-- Starts a piece equal to the convex polygon xs, ys [1..n] (positive orientation:
-- every edge has the interior on its left), which must lie inside the pixel.
function Visibility.poly(sign: number, xs: { number }, ys: { number }, n: number)
	for i = 1, n do
		AX[i], AY[i] = xs[i], ys[i]
	end
	cur, wn = 0, n
	wSign, wDisc = sign, 0
end

-- Clips the piece under construction to {nx x + ny y <= c}.
function Visibility.clip(nx: number, ny: number, c: number)
	if wn < 3 then
		wn = 0
		return
	end
	if cur == 0 then
		wn = clipInto(AX, AY, wn, BX, BY, nx, ny, c)
		cur = 1
	else
		wn = clipInto(BX, BY, wn, AX, AY, nx, ny, c)
		cur = 0
	end
end

-- Intersects the piece under construction with the disc (cx, cy, r).
function Visibility.disc(cx: number, cy: number, r: number)
	wDisc, wDX, wDY, wDR = 1, cx, cy, r
end

-- Stores the piece under construction (dropped when its polygon is empty).
function Visibility.piece()
	if wn < 3 then
		return
	end
	local X, Y = AX, AY
	if cur == 1 then
		X, Y = BX, BY
	end
	if polyArea(X, Y, wn) <= 0 then
		return
	end
	nP += 1
	PS[nP] = wSign
	PV0[nP] = nPV + 1
	PN[nP] = wn
	for i = 1, wn do
		PX[nPV + i], PY[nPV + i] = X[i], Y[i]
	end
	nPV += wn
	PD[nP] = wDisc
	PDX[nP], PDY[nP], PDR[nP] = wDX, wDY, wDR
end

-- Region areas ---------------------------------------------------------------------

-- Area of polygon (px, py)[1..m] intersected with discs K[1..k] (power cells).
local function regionArea(px: { number }, py: { number }, m: number, k: number): number
	stats.areas += 1
	if k == 0 then
		return polyArea(px, py, m)
	elseif k == 1 then
		return discPolyArea(px, py, m, KX[1], KY[1], KR[1])
	end
	local total = 0
	for i = 1, k do
		local xi, yi, ri = KX[i], KY[i], KR[i]
		local powi = xi * xi + yi * yi - ri * ri
		for v = 1, m do
			CX[v], CY[v] = px[v], py[v]
		end
		local n = m
		local inC = true -- current cell polygon is in CX/CY (else DX2/DY2)
		local empty = false
		for j = 1, k do
			if j ~= i then
				local xj, yj, rj = KX[j], KY[j], KR[j]
				-- p_i >= p_j  <=>  2 (c_i - c_j) . q <= (|c_i|^2 - r_i^2) - (|c_j|^2 - r_j^2)
				local nx, ny = 2 * (xi - xj), 2 * (yi - yj)
				local c = powi - (xj * xj + yj * yj - rj * rj)
				if nx == 0 and ny == 0 then
					if not (c > 0 or (c == 0 and j > i)) then
						empty = true
						break
					end
				else
					if inC then
						n = clipInto(CX, CY, n, DX2, DY2, nx, ny, c)
					else
						n = clipInto(DX2, DY2, n, CX, CY, nx, ny, c)
					end
					inC = not inC
					if n < 3 then
						empty = true
						break
					end
				end
			end
		end
		if not empty then
			if inC then
				total += discPolyArea(CX, CY, n, xi, yi, ri)
			else
				total += discPolyArea(DX2, DY2, n, xi, yi, ri)
			end
		end
	end
	return total
end

-- Processes the shape begun with Visibility.begin against every current term.
function Visibility.commit()
	local nOld = nT
	local contrib = 0
	for t = 1, nOld do
		local wt = TW[t]
		if wt == 0 then
			continue
		end
		for p = 1, nP do
			-- polygon of term t intersected with piece p (both convex)
			local X, Y = VX, VY
			local m
			local p0, pn = PV0[p], PN[p]
			if t == 1 then
				-- term 1 is the whole pixel; pieces already lie inside it
				for v = 1, pn do
					VX[v], VY[v] = PX[p0 + v - 1], PY[p0 + v - 1]
				end
				m = pn
			else
				local t0 = TV0[t]
				m = TN[t]
				for v = 1, m do
					VX[v], VY[v] = TX[t0 + v - 1], TY[t0 + v - 1]
				end
				local qx, qy = PX[p0 + pn - 1], PY[p0 + pn - 1]
				for v = 0, pn - 1 do
					local rx, ry = PX[p0 + v], PY[p0 + v]
					local ex, ey = rx - qx, ry - qy
					-- interior on the left: cross(e, q - P) >= 0  <=>  ey x - ex y <= ey Px - ex Py
					local c = ey * qx - ex * qy
					if X == VX then
						m = clipInto(VX, VY, m, UX, UY, ey, -ex, c)
						X, Y = UX, UY
					else
						m = clipInto(UX, UY, m, VX, VY, ey, -ex, c)
						X, Y = VX, VY
					end
					if m < 3 then
						break
					end
					qx, qy = rx, ry
				end
			end
			if m < 3 then
				continue
			end
			-- discs of the region: the term's and the piece's
			local k = 0
			local d0 = TD0[t]
			for i = d0, d0 + TND[t] - 1 do
				k += 1
				KX[k], KY[k], KR[k] = TDX[i], TDY[i], TDR[i]
			end
			if PD[p] == 1 then
				k += 1
				KX[k], KY[k], KR[k] = PDX[p], PDY[p], PDR[p]
			end
			local a = regionArea(X, Y, m, k)
			if a <= 0 then
				continue
			end
			local sw = PS[p] * wt
			contrib += sw * a
			if nT >= MAX_TERMS then
				stats.capped += 1
				continue
			end
			nT += 1
			stats.terms += 1
			TW[nT] = -eA * sw
			TA[nT] = a
			TV0[nT] = nTV + 1
			TN[nT] = m
			for v = 1, m do
				TX[nTV + v], TY[nTV + v] = X[v], Y[v]
			end
			nTV += m
			TD0[nT] = nTD + 1
			TND[nT] = k
			for i = 1, k do
				TDX[nTD + i], TDY[nTD + i], TDR[nTD + i] = KX[i], KY[i], KR[i]
			end
			nTD += k
		end
	end
	local f = eA * contrib
	accR += eR * f
	accG += eG * f
	accB += eB * f
	accA += f
end

-- Adds the base below the stack (straight colour, alpha) and returns the exact
-- composite in straight alpha: r, g, b in 0..255, a in 0..1.
function Visibility.finish(r: number, g: number, b: number, a: number): (number, number, number, number)
	local W = 0
	for t = 1, nT do
		W += TW[t] * TA[t]
	end
	local k = a * W
	local R, G, B, A = accR + r * k, accG + g * k, accB + b * k, accA + k
	if A <= 0 then
		return r, g, b, 0
	end
	return R / A, G / A, B / A, if A > 1 then 1 else A
end

-- The premultiplied integrals accumulated so far (for tests): r, g, b, a.
function Visibility.accumulated(): (number, number, number, number)
	return accR, accG, accB, accA
end

return Visibility
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="19">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="ModuleScript" referent="20">
      <Properties>
        <string name="Name">EditableImageProbe</string>
        <string name="Source"><![CDATA[--!optimize 2
-- universe-at-home :: studio/EditableImageProbe.luau  (ModuleScript)
--
-- Measures what cannot be measured outside the Roblox engine:
--   1. limits      size bounds, default size, buffer-length rules, client memory budget
--   2. timings     run time of every public EditableImage method and the AssetService
--                  calls around it, as median and best of several runs
--   3. ops         an empirical truth table for every Enum.ImageCombineType, plus
--                  write/read round-trips that reveal the stored alpha convention and
--                  how DrawImageTransformed actually filters
--
-- Usage: require this module from studio/RunProbe.client.luau (client budget, the
-- interesting case) or studio/RunProbe.server.luau. Everything is wrapped in pcall, so a
-- missing API or a changed contract shows up as a reported error instead of a crash.
-- Paste the printed report back into docs/RUNTIME_AUDIT.md section "Measured in engine".
--
-- Run it in a published place on a real device for budget numbers. Roblox documents
-- that Studio, servers and plugins have no editable memory budget.

local AssetService = game:GetService("AssetService")
local RunService = game:GetService("RunService")

local Probe = {}

local lines: { string } = {}
local function out(fmt: string, ...: any)
	local s = string.format(fmt, ...)
	table.insert(lines, s)
	print(s)
end

local function context(): string
	local where = if RunService:IsServer() then "server" else "client"
	if RunService:IsStudio() then
		where ..= " (Studio)"
	end
	return where
end

local function newImage(w: number, h: number): EditableImage?
	local ok, img = pcall(function()
		return AssetService:CreateEditableImage({ Size = Vector2.new(w, h) })
	end)
	if ok then
		return img
	end
	out("  CreateEditableImage(%dx%d) error: %s", w, h, tostring(img))
	return nil
end

local function median(samples: { number }): (number, number)
	table.sort(samples)
	return samples[(#samples + 1) // 2], samples[1]
end

-- Times fn n times. Yields between runs so long probes never trip the script timeout.
local function timeit(n: number, fn: () -> ()): (number, number)
	local samples = table.create(n, 0)
	for i = 1, n do
		local t0 = os.clock()
		fn()
		samples[i] = os.clock() - t0
		if i % 4 == 0 then
			task.wait()
		end
	end
	return median(samples)
end

local function report(name: string, n: number, pixels: number?, fn: () -> ())
	local ok, err = pcall(function()
		local med, best = timeit(n, fn)
		if pixels then
			out("  %-58s median %9.3f ms  best %9.3f ms  %8.2f Mpix/s", name, med * 1e3, best * 1e3, pixels / med / 1e6)
		else
			out("  %-58s median %9.3f ms  best %9.3f ms", name, med * 1e3, best * 1e3)
		end
	end)
	if not ok then
		out("  %-58s ERROR %s", name, tostring(err))
	end
end

local function fillPattern(img: EditableImage, w: number, h: number, seed: number)
	local b = buffer.create(w * h * 4)
	for i = 0, w * h - 1 do
		local v = (i * 2654435761 + seed) % 4294967296
		buffer.writeu32(b, i * 4, v)
	end
	img:WritePixelsBuffer(Vector2.zero, Vector2.new(w, h), b)
end

----------------------------------------------------------------------------------
-- 1. Limits
----------------------------------------------------------------------------------

local function probeLimits()
	out("## limits [%s]", context())

	local ok, img = pcall(function()
		return AssetService:CreateEditableImage()
	end)
	if ok and img then
		out("  default size: %s", tostring(img.Size))
		img:Destroy()
	else
		out("  default CreateEditableImage(): %s", tostring(img))
	end

	for _, s in { { 1, 1 }, { 1024, 1024 }, { 1025, 1 }, { 1, 1025 }, { 2048, 2048 }, { 4096, 4096 }, { 0, 0 }, { 100.5, 100.5 } } do
		local ok2, res = pcall(function()
			return AssetService:CreateEditableImage({ Size = Vector2.new(s[1], s[2]) })
		end)
		if ok2 and res then
			out("  create %gx%g -> ok, Size=%s", s[1], s[2], tostring(res.Size))
			-- can we write the whole thing in one call?
			local w, h = res.Size.X, res.Size.Y
			local okW, errW = pcall(function()
				res:WritePixelsBuffer(Vector2.zero, res.Size, buffer.create(w * h * 4))
			end)
			out("    full-size WritePixelsBuffer: %s", if okW then "ok" else tostring(errW))
			res:Destroy()
		elseif ok2 then
			out("  create %gx%g -> nil (budget)", s[1], s[2])
		else
			out("  create %gx%g -> error: %s", s[1], s[2], tostring(res))
		end
	end

	local img2 = newImage(16, 16)
	if img2 then
		local cases = {
			{ "buffer 1 byte short", function()
				img2:WritePixelsBuffer(Vector2.zero, Vector2.new(16, 16), buffer.create(16 * 16 * 4 - 1))
			end },
			{ "buffer 1 byte long", function()
				img2:WritePixelsBuffer(Vector2.zero, Vector2.new(16, 16), buffer.create(16 * 16 * 4 + 1))
			end },
			{ "write rect past right edge", function()
				img2:WritePixelsBuffer(Vector2.new(8, 0), Vector2.new(16, 1), buffer.create(16 * 4))
			end },
			{ "write at negative position", function()
				img2:WritePixelsBuffer(Vector2.new(-1, 0), Vector2.new(1, 1), buffer.create(4))
			end },
			{ "write at fractional position 0.5", function()
				img2:WritePixelsBuffer(Vector2.new(0.5, 0), Vector2.new(1, 1), buffer.create(4))
			end },
			{ "read rect past bottom edge", function()
				img2:ReadPixelsBuffer(Vector2.new(0, 8), Vector2.new(1, 16))
			end },
			{ "DrawRectangle partly outside", function()
				img2:DrawRectangle(Vector2.new(10, 10), Vector2.new(10, 10), Color3.new(1, 0, 0), 0, Enum.ImageCombineType.Overwrite)
			end },
			{ "DrawImage partly outside", function()
				local s = newImage(8, 8)
				if s then
					img2:DrawImage(Vector2.new(12, 12), s, Enum.ImageCombineType.Overwrite)
					s:Destroy()
				end
			end },
			{ "use after Destroy (ReadPixelsBuffer)", function()
				local s = newImage(4, 4)
				if s then
					s:Destroy()
					s:ReadPixelsBuffer(Vector2.zero, Vector2.new(4, 4))
				end
			end },
		}
		for _, c in cases do
			local okc, errc = pcall(c[2])
			out("  %-40s %s", c[1], if okc then "accepted" else "error: " .. tostring(errc))
		end
		img2:Destroy()
	end
end

local function probeBudget()
	out("## budget [%s]", context())
	-- Allocate 256x256 images (256 KiB of RGBA each) until creation returns nil.
	-- Capped at 4096 images (1 GiB) because servers and Studio have no budget.
	local made: { EditableImage } = {}
	local cap = 4096
	local t0 = os.clock()
	while #made < cap do
		local ok, img = pcall(function()
			return AssetService:CreateEditableImage({ Size = Vector2.new(256, 256) })
		end)
		if not ok or img == nil then
			break
		end
		table.insert(made, img)
		if #made % 64 == 0 then
			task.wait()
		end
	end
	local count = #made
	out("  256x256 images before nil: %d%s  (%.1f MiB of RGBA8, %.2f s)", count, if count == cap then " (cap hit, no budget here)" else "", count * 0.25, os.clock() - t0)

	-- Accounting check: does one 512x512 cost the same as four 256x256?
	if count < cap and count >= 8 then
		for _ = 1, 4 do
			local img = table.remove(made)
			if img then
				img:Destroy()
			end
		end
		local big = newImage(512, 512)
		out("  after freeing 4x 256x256, a 512x512 create: %s", if big then "ok (pixel-count accounting)" else "nil")
		if big then
			big:Destroy()
		end
		local again = newImage(256, 256)
		out("  Destroy() returns budget immediately: %s", if again then "yes" else "no")
		if again then
			again:Destroy()
		end
	end
	for _, img in made do
		img:Destroy()
	end
end

----------------------------------------------------------------------------------
-- 2. Timings
----------------------------------------------------------------------------------

local function probeTimings()
	out("## timings [%s]  (median of runs; Mpix/s counts destination pixels)", context())

	report("CreateEditableImage 256x256 + Destroy", 16, nil, function()
		local i = AssetService:CreateEditableImage({ Size = Vector2.new(256, 256) })
		i:Destroy()
	end)
	report("CreateEditableImage 1024x1024 + Destroy", 8, nil, function()
		local i = AssetService:CreateEditableImage({ Size = Vector2.new(1024, 1024) })
		i:Destroy()
	end)

	local img = newImage(1024, 1024)
	local src = newImage(1024, 1024)
	local half = newImage(512, 512)
	local quarter = newImage(256, 256)
	if not (img and src and half and quarter) then
		out("  could not allocate probe images; skipping timings")
		return
	end
	fillPattern(src, 1024, 1024, 17)
	fillPattern(img, 1024, 1024, 99)

	local full = buffer.create(1024 * 1024 * 4)
	local tile = buffer.create(64 * 64 * 4)
	local one = buffer.create(4)
	local SZ = Vector2.new(1024, 1024)

	report("WritePixelsBuffer 1024x1024", 12, 1024 * 1024, function()
		img:WritePixelsBuffer(Vector2.zero, SZ, full)
	end)
	report("WritePixelsBuffer 64x64 tile", 32, 64 * 64, function()
		img:WritePixelsBuffer(Vector2.new(128, 128), Vector2.new(64, 64), tile)
	end)
	report("WritePixelsBuffer 1x1 (call overhead)", 64, 1, function()
		img:WritePixelsBuffer(Vector2.new(3, 3), Vector2.one, one)
	end)
	report("ReadPixelsBuffer 1024x1024", 12, 1024 * 1024, function()
		img:ReadPixelsBuffer(Vector2.zero, SZ)
	end)
	report("ReadPixelsBuffer 64x64 tile", 32, 64 * 64, function()
		img:ReadPixelsBuffer(Vector2.new(128, 128), Vector2.new(64, 64))
	end)
	report("ReadPixelsBuffer 1x1 (call overhead)", 64, 1, function()
		img:ReadPixelsBuffer(Vector2.new(3, 3), Vector2.one)
	end)

	for _, ct in { Enum.ImageCombineType.Overwrite, Enum.ImageCombineType.AlphaBlend, Enum.ImageCombineType.BlendSourceOver } do
		report("DrawRectangle full canvas " .. ct.Name, 12, 1024 * 1024, function()
			img:DrawRectangle(Vector2.zero, SZ, Color3.new(0.2, 0.4, 0.6), 0.25, ct)
		end)
	end
	for _, ct in Enum.ImageCombineType:GetEnumItems() do
		report("DrawImage 1024->1024 " .. ct.Name, 12, 1024 * 1024, function()
			img:DrawImage(Vector2.zero, src, ct)
		end)
	end
	for _, mode in { Enum.ResamplerMode.Default, Enum.ResamplerMode.Pixelated } do
		report("DrawImageTransformed 1024->512 scale 0.5 " .. mode.Name, 12, 512 * 512, function()
			half:DrawImageTransformed(Vector2.zero, Vector2.new(0.5, 0.5), 0, src, {
				CombineType = Enum.ImageCombineType.Overwrite,
				SamplingMode = mode,
				PivotPoint = Vector2.zero,
			})
		end)
	end
	report("DrawImageTransformed 1024->1024 rotate 30deg Default", 8, 1024 * 1024, function()
		img:DrawImageTransformed(Vector2.new(512, 512), Vector2.one, 30, src, {
			CombineType = Enum.ImageCombineType.Overwrite,
			SamplingMode = Enum.ResamplerMode.Default,
		})
	end)
	report("DrawImageTransformed 512->256 scale 0.5 (mip step)", 16, 256 * 256, function()
		quarter:DrawImageTransformed(Vector2.zero, Vector2.new(0.5, 0.5), 0, half, {
			CombineType = Enum.ImageCombineType.Overwrite,
			PivotPoint = Vector2.zero,
		})
	end)
	report("DrawCircle r=300 AA on", 16, nil, function()
		img:DrawCircle(Vector2.new(512, 512), 300, Color3.new(1, 0.6, 0.2), 0, Enum.ImageCombineType.BlendSourceOver)
	end)
	report("DrawCircle r=300 AA off", 16, nil, function()
		img:DrawCircle(Vector2.new(512, 512), 300, Color3.new(1, 0.6, 0.2), 0, Enum.ImageCombineType.BlendSourceOver, Enum.AntiAliasing.Disabled)
	end)
	report("DrawLine 1024 px diagonal AA on", 32, nil, function()
		img:DrawLine(Vector2.zero, Vector2.new(1023, 1023), Color3.new(1, 1, 1), 0, Enum.ImageCombineType.BlendSourceOver)
	end)
	report("Content.fromObject", 64, nil, function()
		Content.fromObject(img)
	end)

	local label = Instance.new("ImageLabel")
	report("ImageLabel.ImageContent = Content.fromObject(img)", 32, nil, function()
		label.ImageContent = Content.fromObject(img)
		label.ImageContent = Content.none
	end)
	label:Destroy()

	-- Baking: yields, so this is latency including frame waits, not CPU time.
	local okB, errB = pcall(function()
		local samples = {}
		for _ = 1, 3 do
			local t0 = os.clock()
			local result, content = AssetService:CreateDataModelContentAsync(Content.fromObject(src))
			table.insert(samples, os.clock() - t0)
			if result ~= Enum.CreateContentResult.Success then
				out("  CreateDataModelContentAsync result: %s", tostring(result))
			end
			local _ = content
		end
		local med, best = median(samples)
		out("  %-58s median %9.3f ms  best %9.3f ms  (latency, yields)", "CreateDataModelContentAsync 1024x1024", med * 1e3, best * 1e3)
	end)
	if not okB then
		out("  CreateDataModelContentAsync error: %s", tostring(errB))
	end

	img:Destroy()
	src:Destroy()
	half:Destroy()
	quarter:Destroy()
end

----------------------------------------------------------------------------------
-- 3. Ops: truth tables
----------------------------------------------------------------------------------

type RGBA = { number }

local DST_CASES: { RGBA } = {
	{ 200, 100, 50, 255 },
	{ 200, 100, 50, 128 },
	{ 200, 100, 50, 0 },
	{ 0, 0, 0, 0 },
	{ 255, 255, 255, 255 },
}
local SRC_CASES: { RGBA } = {
	{ 10, 220, 90, 255 },
	{ 10, 220, 90, 128 },
	{ 10, 220, 90, 1 },
	{ 10, 220, 90, 0 },
	{ 255, 0, 0, 64 },
}

local function writeRow(img: EditableImage, row: { RGBA })
	local b = buffer.create(#row * 4)
	for i, p in row do
		local o = (i - 1) * 4
		buffer.writeu8(b, o, p[1])
		buffer.writeu8(b, o + 1, p[2])
		buffer.writeu8(b, o + 2, p[3])
		buffer.writeu8(b, o + 3, p[4])
	end
	img:WritePixelsBuffer(Vector2.zero, Vector2.new(#row, 1), b)
end

local function readRow(img: EditableImage, n: number): { RGBA }
	local b = img:ReadPixelsBuffer(Vector2.zero, Vector2.new(n, 1))
	local res = table.create(n)
	for i = 1, n do
		local o = (i - 1) * 4
		res[i] = { buffer.readu8(b, o), buffer.readu8(b, o + 1), buffer.readu8(b, o + 2), buffer.readu8(b, o + 3) }
	end
	return res
end

-- Candidate formulas in straight alpha, 0..1 floats. Each returns r, g, b, a.
type Model = (s: RGBA, d: RGBA) -> (number, number, number, number)
local function f(v: number): number
	return v / 255
end
local function clamp01(v: number): number
	return math.clamp(v, 0, 1)
end

local MODELS: { [string]: Model } = {
	["overwrite"] = function(s, d)
		return f(s[1]), f(s[2]), f(s[3]), f(s[4])
	end,
	["srcover straight"] = function(s, d)
		local sa, da = f(s[4]), f(d[4])
		local oa = sa + da * (1 - sa)
		if oa <= 0 then
			return 0, 0, 0, 0
		end
		local function c(i)
			return (f(s[i]) * sa + f(d[i]) * da * (1 - sa)) / oa
		end
		return c(1), c(2), c(3), oa
	end,
	["lerp by src alpha, a = srcover"] = function(s, d)
		local sa, da = f(s[4]), f(d[4])
		local function c(i)
			return f(s[i]) * sa + f(d[i]) * (1 - sa)
		end
		return c(1), c(2), c(3), sa + da * (1 - sa)
	end,
	["lerp by src alpha, a = lerp"] = function(s, d)
		local sa, da = f(s[4]), f(d[4])
		local function c(i)
			return f(s[i]) * sa + f(d[i]) * (1 - sa)
		end
		return c(1), c(2), c(3), sa * sa + da * (1 - sa)
	end,
	["lerp by src alpha, a = max"] = function(s, d)
		local sa, da = f(s[4]), f(d[4])
		local function c(i)
			return f(s[i]) * sa + f(d[i]) * (1 - sa)
		end
		return c(1), c(2), c(3), math.max(sa, da)
	end,
	["add (rgb*sa), a+a"] = function(s, d)
		local sa = f(s[4])
		local function c(i)
			return clamp01(f(d[i]) + f(s[i]) * sa)
		end
		return c(1), c(2), c(3), clamp01(f(d[4]) + sa)
	end,
	["subtract (rgb*sa), a-a"] = function(s, d)
		local sa = f(s[4])
		local function c(i)
			return clamp01(f(d[i]) - f(s[i]) * sa)
		end
		return c(1), c(2), c(3), clamp01(f(d[4]) - sa)
	end,
	["multiply all channels"] = function(s, d)
		return f(s[1]) * f(d[1]), f(s[2]) * f(d[2]), f(s[3]) * f(d[3]), f(s[4]) * f(d[4])
	end,
	["srcover premultiplied storage"] = function(s, d)
		local sa = f(s[4])
		local function c(i)
			return f(s[i]) + f(d[i]) * (1 - sa)
		end
		return c(1), c(2), c(3), sa + f(d[4]) * (1 - sa)
	end,
}

local function scoreModel(model: Model, srcs: { RGBA }, dsts: { RGBA }, got: { RGBA }): (number, number)
	local maxColor, maxAlpha = 0, 0
	for i = 1, #got do
		local r, g, b, a = model(srcs[i], dsts[i])
		local o = got[i]
		local da = math.abs(a * 255 - o[4])
		maxAlpha = math.max(maxAlpha, da)
		-- colour only matters where the result is visible
		if o[4] > 0 then
			maxColor = math.max(maxColor, math.abs(r * 255 - o[1]), math.abs(g * 255 - o[2]), math.abs(b * 255 - o[3]))
		end
	end
	return maxColor, maxAlpha
end

local function fmt(p: RGBA): string
	return string.format("(%3d,%3d,%3d,%3d)", p[1], p[2], p[3], p[4])
end

local function probeCombineOps()
	out("## ops: ImageCombineType truth tables via DrawImage [%s]", context())
	-- Every (src, dst) pair becomes one pixel of a 1-row image, so one DrawImage call
	-- evaluates all 25 cases of an op at once.
	local srcs, dsts = {}, {}
	for _, d in DST_CASES do
		for _, s in SRC_CASES do
			table.insert(srcs, s)
			table.insert(dsts, d)
		end
	end
	local n = #srcs
	local srcImg = newImage(n, 1)
	local dstImg = newImage(n, 1)
	if not (srcImg and dstImg) then
		return
	end
	writeRow(srcImg, srcs)
	-- 1. Round-trip: does the stored image keep straight alpha and colour under alpha 0?
	local rt = readRow(srcImg, n)
	local changed = 0
	for i = 1, n do
		for c = 1, 4 do
			if rt[i][c] ~= srcs[i][c] then
				changed += 1
			end
		end
	end
	out("  WritePixelsBuffer->ReadPixelsBuffer round-trip: %s", if changed == 0 then "exact (straight alpha stored, rgb kept under alpha 0)" else ("%d channel values changed"):format(changed))
	for i = 1, #SRC_CASES do
		out("    wrote %s read %s", fmt(srcs[i]), fmt(rt[i]))
	end

	for _, ct in Enum.ImageCombineType:GetEnumItems() do
		writeRow(dstImg, dsts)
		local okD, errD = pcall(function()
			dstImg:DrawImage(Vector2.zero, srcImg, ct)
		end)
		if not okD then
			out("### %s: DrawImage error %s", ct.Name, tostring(errD))
			continue
		end
		local got = readRow(dstImg, n)
		out("### %s", ct.Name)
		for i = 1, n do
			out("    src %s over dst %s -> %s", fmt(srcs[i]), fmt(dsts[i]), fmt(got[i]))
		end
		-- rank candidate formulas by worst-case error
		local ranked = {}
		for name, model in MODELS do
			local mc, ma = scoreModel(model, srcs, dsts, got)
			table.insert(ranked, { name = name, mc = mc, ma = ma })
		end
		table.sort(ranked, function(a, b)
			return math.max(a.mc, a.ma) < math.max(b.mc, b.ma)
		end)
		for k = 1, math.min(3, #ranked) do
			local r = ranked[k]
			out("    fit #%d %-34s max colour err %6.2f  max alpha err %6.2f", k, r.name, r.mc, r.ma)
		end
	end
	srcImg:Destroy()
	dstImg:Destroy()
end

local function probePrimitiveOps()
	out("## ops: DrawRectangle colour + transparency per combine type [%s]", context())
	local dst = newImage(#DST_CASES, 1)
	if not dst then
		return
	end
	for _, ct in Enum.ImageCombineType:GetEnumItems() do
		for _, transparency in { 0, 0.5, 1 } do
			writeRow(dst, DST_CASES)
			local ok, err = pcall(function()
				for i = 1, #DST_CASES do
					dst:DrawRectangle(Vector2.new(i - 1, 0), Vector2.one, Color3.fromRGB(10, 220, 90), transparency, ct)
				end
			end)
			if not ok then
				out("  %-16s t=%.1f error %s", ct.Name, transparency, tostring(err))
				continue
			end
			local got = readRow(dst, #DST_CASES)
			local parts = {}
			for i = 1, #got do
				table.insert(parts, fmt(DST_CASES[i]) .. "->" .. fmt(got[i]))
			end
			out("  %-16s t=%.1f  %s", ct.Name, transparency, table.concat(parts, "  "))
		end
	end
	dst:Destroy()
end

local function probeSampling()
	out("## ops: DrawImageTransformed filtering [%s]", context())
	-- (a) magnify a black|white pair 4x: the read-back ramp shows the filter kernel
	local pair = newImage(2, 1)
	local wide = newImage(8, 1)
	if pair and wide then
		writeRow(pair, { { 0, 0, 0, 255 }, { 255, 255, 255, 255 } })
		for _, mode in { Enum.ResamplerMode.Default, Enum.ResamplerMode.Pixelated } do
			writeRow(wide, table.create(8, { 0, 0, 0, 0 }))
			local ok, err = pcall(function()
				wide:DrawImageTransformed(Vector2.zero, Vector2.new(4, 1), 0, pair, {
					CombineType = Enum.ImageCombineType.Overwrite,
					SamplingMode = mode,
					PivotPoint = Vector2.zero,
				})
			end)
			if ok then
				local got = readRow(wide, 8)
				local ramp = {}
				for i = 1, 8 do
					table.insert(ramp, tostring(got[i][1]))
				end
				out("  magnify 2px->8px %-10s red ramp: %s", mode.Name, table.concat(ramp, " "))
			else
				out("  magnify %s error %s", mode.Name, tostring(err))
			end
		end
	end
	-- (b) colour bleed: a transparent red pixel next to an opaque green one. With straight
	-- alpha a naive bilinear filter drags red into the green edge (the "fringe").
	local bleed = newImage(2, 1)
	local bleedOut = newImage(8, 1)
	if bleed and bleedOut then
		writeRow(bleed, { { 255, 0, 0, 0 }, { 0, 255, 0, 255 } })
		writeRow(bleedOut, table.create(8, { 0, 0, 0, 0 }))
		local ok, err = pcall(function()
			bleedOut:DrawImageTransformed(Vector2.zero, Vector2.new(4, 1), 0, bleed, {
				CombineType = Enum.ImageCombineType.Overwrite,
				SamplingMode = Enum.ResamplerMode.Default,
				PivotPoint = Vector2.zero,
			})
		end)
		if ok then
			local got = readRow(bleedOut, 8)
			local parts = {}
			for i = 1, 8 do
				table.insert(parts, fmt(got[i]))
			end
			out("  premultiplied-aware filter test (red under alpha 0 | green): %s", table.concat(parts, " "))
			out("    red > 0 in a visible pixel means the filter is NOT premultiplied-aware")
		else
			out("  bleed test error %s", tostring(err))
		end
	end
	-- (c) minification quality: 1px checkerboard 256x256 to 64x64 in one 0.25 step vs two
	-- 0.5 steps. A true area filter gives mid grey (127.5) everywhere. Bilinear sampling at
	-- 0.25 only touches 4 of 16 source pixels, so its error reveals aliasing.
	local checker = newImage(256, 256)
	local mid = newImage(128, 128)
	local small1 = newImage(64, 64)
	local small2 = newImage(64, 64)
	if checker and mid and small1 and small2 then
		local b = buffer.create(256 * 256 * 4)
		for y = 0, 255 do
			for x = 0, 255 do
				local v = if (x + y) % 2 == 0 then 0xFFFFFFFF else 0xFF000000
				buffer.writeu32(b, (y * 256 + x) * 4, v)
			end
		end
		checker:WritePixelsBuffer(Vector2.zero, Vector2.new(256, 256), b)
		local opts = { CombineType = Enum.ImageCombineType.Overwrite, SamplingMode = Enum.ResamplerMode.Default, PivotPoint = Vector2.zero }
		local ok, err = pcall(function()
			small1:DrawImageTransformed(Vector2.zero, Vector2.new(0.25, 0.25), 0, checker, opts)
			mid:DrawImageTransformed(Vector2.zero, Vector2.new(0.5, 0.5), 0, checker, opts)
			small2:DrawImageTransformed(Vector2.zero, Vector2.new(0.5, 0.5), 0, mid, opts)
		end)
		if ok then
			local function err255(img: EditableImage): (number, number)
				local rb = img:ReadPixelsBuffer(Vector2.zero, Vector2.new(64, 64))
				local sum, worst = 0, 0
				for i = 0, 64 * 64 - 1 do
					local e = math.abs(buffer.readu8(rb, i * 4) - 127.5)
					sum += e
					worst = math.max(worst, e)
				end
				return sum / (64 * 64), worst
			end
			local m1, w1 = err255(small1)
			local m2, w2 = err255(small2)
			out("  checkerboard 256->64 one step x0.25 : mean |err| %.1f  worst %.1f", m1, w1)
			out("  checkerboard 256->64 two steps x0.5: mean |err| %.1f  worst %.1f", m2, w2)
		else
			out("  minification test error %s", tostring(err))
		end
	end
	for _, i in { pair, wide, bleed, bleedOut, checker, mid, small1, small2 } do
		if i then
			i:Destroy()
		end
	end
end

----------------------------------------------------------------------------------

function Probe.run(options: { budget: boolean?, timings: boolean?, ops: boolean?, limits: boolean? }?)
	local o = options or {}
	table.clear(lines)
	out("# EditableImageProbe  context=%s  version=%s", context(), version())
	if o.limits ~= false then
		probeLimits()
	end
	if o.ops ~= false then
		probeCombineOps()
		probePrimitiveOps()
		probeSampling()
	end
	if o.timings ~= false then
		probeTimings()
	end
	if o.budget ~= false then
		probeBudget()
	end
	out("# done")
	return table.concat(lines, "\n")
end

return Probe
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="21">
      <Properties>
        <string name="Name">OpsBench</string>
        <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: bench/ops.luau
--
-- Portable micro-benchmark for every Luau op a CPU pixel pipeline depends on.
-- It runs unchanged in two places:
--
--   * the open-source Luau CLI
--       luau bench/ops.luau              (interpreter)
--       luau --codegen bench/ops.luau    (native code generation)
--   * Roblox (paste into a Script or LocalScript, or require it as a ModuleScript).
--     Server Scripts honour --!native. Client LocalScripts currently run in the
--     interpreter (Roblox documents native code generation for server scripts only).
--
-- The `--!optimize 2` line pins the live-game optimization level. Studio playtests
-- default to level 1, so without it Studio numbers understate live performance.
--
-- Output: one machine-readable line per measurement
--   RESULT <TAB> group <TAB> name <TAB> value <TAB> unit
-- tools/merge_bench.py turns several runs into a markdown table.

local clock = os.clock
local IS_ROBLOX = typeof(game) == "Instance"

local function yieldNow()
	if IS_ROBLOX then
		task.wait()
	end
end

local function emit(group: string, name: string, value: number, unit: string)
	print(string.format("RESULT\t%s\t%s\t%.3f\t%s", group, name, value, unit))
end

----------------------------------------------------------------------------------
-- Shared fixtures
----------------------------------------------------------------------------------

local N = 65536 -- iterations per pass for op benchmarks
local B = buffer.create(N * 8) -- 512 KiB, fits in L2 so we time ops not DRAM
for i = 0, N * 8 - 1 do
	buffer.writeu8(B, i, (i * 37 + 11) % 256)
end

local T = table.create(N, 0)
for i = 1, N do
	T[i] = i
end

local PAL = table.create(16, 0)
for i = 1, 16 do
	PAL[i] = 0xFF000000 + i * 0x00010203
end

local V1 = vector.create(1.25, 2.5, 3.75)
local V2 = vector.create(-4, 8, 0.5)
local VMIN = vector.create(0, 0, 0)
local VMAX = vector.create(1000, 1000, 1000)

----------------------------------------------------------------------------------
-- Op benchmarks. Every function runs P passes of a 65536-iteration inner loop and
-- returns a value derived from its work so nothing can be optimized away.
----------------------------------------------------------------------------------

type OpBench = { group: string, name: string, fn: (number, ...any) -> number, args: { any }? }

local ops: { OpBench } = {}
local function op(group: string, name: string, fn: (number, ...any) -> number, args: { any }?)
	table.insert(ops, { group = group, name = name, fn = fn, args = args })
end

-- Baselines ---------------------------------------------------------------------

op("base", "loop+add (step 1)", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += o
		end
	end
	return acc
end)

-- buffer reads -------------------------------------------------------------------

op("buffer", "readu8", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += buffer.readu8(B, o)
		end
	end
	return acc
end)

op("buffer", "readu16", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, (N - 1) * 2, 2 do
			acc += buffer.readu16(B, o)
		end
	end
	return acc
end)

op("buffer", "readu32", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, (N - 1) * 4, 4 do
			acc += buffer.readu32(B, o)
		end
	end
	return acc
end)

op("buffer", "readu32 (buffer cached in a local)", function(P)
	local b = B
	local acc = 0
	for _ = 1, P do
		for o = 0, (N - 1) * 4, 4 do
			acc += buffer.readu32(b, o)
		end
	end
	return acc
end)

op("buffer", "readi32", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, (N - 1) * 4, 4 do
			acc += buffer.readi32(B, o)
		end
	end
	return acc
end)

op("buffer", "readf32", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, (N - 1) * 4, 4 do
			acc += buffer.readf32(B, o)
		end
	end
	return acc
end)

op("buffer", "readf64", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, (N - 1) * 8, 8 do
			acc += buffer.readf64(B, o)
		end
	end
	return acc
end)

op("buffer", "readbits (8, byte aligned)", function(P)
	local acc = 0
	for _ = 1, P do
		for bo = 0, (N - 1) * 8, 8 do
			acc += buffer.readbits(B, bo, 8)
		end
	end
	return acc
end)

op("buffer", "readbits (12, unaligned)", function(P)
	local acc = 0
	for _ = 1, P do
		for bo = 0, (N - 1) * 12, 12 do
			acc += buffer.readbits(B, bo, 12)
		end
	end
	return acc
end)

op("buffer", "readstring (4 bytes)", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, (N - 1) * 4, 4 do
			acc += #buffer.readstring(B, o, 4)
		end
	end
	return acc
end)

-- buffer writes ------------------------------------------------------------------

op("buffer", "writeu8", function(P)
	for _ = 1, P do
		for o = 0, N - 1 do
			buffer.writeu8(B, o, o)
		end
	end
	return buffer.readu8(B, 7)
end)

op("buffer", "writeu16", function(P)
	for _ = 1, P do
		for o = 0, (N - 1) * 2, 2 do
			buffer.writeu16(B, o, o)
		end
	end
	return buffer.readu16(B, 8)
end)

op("buffer", "writeu32", function(P)
	for _ = 1, P do
		for o = 0, (N - 1) * 4, 4 do
			buffer.writeu32(B, o, o)
		end
	end
	return buffer.readu32(B, 8)
end)

op("buffer", "writef32", function(P)
	for _ = 1, P do
		for o = 0, (N - 1) * 4, 4 do
			buffer.writef32(B, o, o)
		end
	end
	return buffer.readf32(B, 8)
end)

op("buffer", "writef64", function(P)
	for _ = 1, P do
		for o = 0, (N - 1) * 8, 8 do
			buffer.writef64(B, o, o)
		end
	end
	return buffer.readf64(B, 8)
end)

op("buffer", "writebits (8, byte aligned)", function(P)
	for _ = 1, P do
		for bo = 0, (N - 1) * 8, 8 do
			buffer.writebits(B, bo, 8, bo)
		end
	end
	return buffer.readu8(B, 3)
end)

op("buffer", "copy (4 bytes, C call)", function(P)
	local src = buffer.create(4)
	for _ = 1, P do
		for o = 0, (N - 1) * 4, 4 do
			buffer.copy(B, o, src, 0, 4)
		end
	end
	return buffer.readu8(B, 3)
end)

op("buffer", "len", function(P)
	local acc = 0
	for _ = 1, P do
		for _ = 0, N - 1 do
			acc += buffer.len(B)
		end
	end
	return acc
end)

-- tables (comparison point for buffer storage) --------------------------------------

op("table", "array read t[i]", function(P)
	local acc = 0
	for _ = 1, P do
		for i = 1, N do
			acc += T[i]
		end
	end
	return acc
end)

op("table", "array write t[i]=v", function(P)
	for _ = 1, P do
		for i = 1, N do
			T[i] = i
		end
	end
	return T[5]
end)

-- bit32 ----------------------------------------------------------------------------

op("bit32", "band(x, k)", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += bit32.band(o, 255)
		end
	end
	return acc
end)

op("bit32", "bor(x, k)", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += bit32.bor(o, 0x10000)
		end
	end
	return acc
end)

op("bit32", "bor(a, b, c, d)", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += bit32.bor(o, 0x100, 0x20000, 0x4000000)
		end
	end
	return acc
end)

op("bit32", "bxor(x, k)", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += bit32.bxor(o, 0x5555)
		end
	end
	return acc
end)

op("bit32", "lshift(x, 8)", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += bit32.lshift(o, 8)
		end
	end
	return acc
end)

op("bit32", "rshift(x, 3)", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += bit32.rshift(o, 3)
		end
	end
	return acc
end)

op("bit32", "arshift(x, 3)", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += bit32.arshift(o, 3)
		end
	end
	return acc
end)

op("bit32", "extract(x, 4, 8) const field", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += bit32.extract(o, 4, 8)
		end
	end
	return acc
end)

op("bit32", "extract(x, f, w) dynamic", function(P, f, w)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += bit32.extract(o, f, w)
		end
	end
	return acc
end, { 4, 8 })

op("bit32", "replace(x, v, 8, 8)", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += bit32.replace(o, 7, 8, 8)
		end
	end
	return acc
end)

op("bit32", "byteswap(x)", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += bit32.byteswap(o)
		end
	end
	return acc
end)

op("bit32", "countlz(x)", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += bit32.countlz(o)
		end
	end
	return acc
end)

op("bit32", "lrotate(x, 7)", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += bit32.lrotate(o, 7)
		end
	end
	return acc
end)

-- arithmetic and math ------------------------------------------------------------

op("math", "x * k", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += o * 1.5
		end
	end
	return acc
end)

op("math", "x / k", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += o / 7
		end
	end
	return acc
end)

op("math", "x // k", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += o // 7
		end
	end
	return acc
end)

op("math", "x % k", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += o % 7
		end
	end
	return acc
end)

op("math", "x ^ 2.2 (gamma via pow)", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += (o * 1.5e-5) ^ 2.2
		end
	end
	return acc
end)

op("math", "math.floor", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += math.floor(o * 0.5)
		end
	end
	return acc
end)

op("math", "math.floor via local alias", function(P)
	local floor = math.floor
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += floor(o * 0.5)
		end
	end
	return acc
end)

op("math", "math.round", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += math.round(o * 0.3)
		end
	end
	return acc
end)

op("math", "math.clamp", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += math.clamp(o, 1000, 60000)
		end
	end
	return acc
end)

op("math", "math.min(a, b)", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += math.min(o, 30000)
		end
	end
	return acc
end)

op("math", "math.max(a, b)", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += math.max(o, 30000)
		end
	end
	return acc
end)

op("math", "math.abs", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += math.abs(o - 30000)
		end
	end
	return acc
end)

op("math", "math.sqrt", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += math.sqrt(o)
		end
	end
	return acc
end)

op("math", "math.lerp", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += math.lerp(0, 255, o * 1.5e-5)
		end
	end
	return acc
end)

op("math", "math.sign", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += math.sign(o - 30000)
		end
	end
	return acc
end)

op("math", "math.sin (libm)", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += math.sin(o)
		end
	end
	return acc
end)

op("math", "math.exp (libm)", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += math.exp(o * 1e-5)
		end
	end
	return acc
end)

op("math", "if-expression select", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += if o > 30000 then o else 30000
		end
	end
	return acc
end)

-- vector ------------------------------------------------------------------------

op("vector", "vector.create + .X", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			local v = vector.create(o, o, o)
			acc += v.X
		end
	end
	return acc
end)

op("vector", "v * s", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			local v = V1 * o
			acc += v.X
		end
	end
	return acc
end)

op("vector", "v + v", function(P)
	local acc = 0
	local v = V1
	for _ = 1, P do
		for _ = 0, N - 1 do
			v = v + V2
		end
	end
	return acc + v.X
end)

op("vector", "vector.dot", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += vector.dot(V1, vector.create(o, 1, 2))
		end
	end
	return acc
end)

op("vector", "vector.magnitude", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += vector.magnitude(vector.create(o, 1, 2))
		end
	end
	return acc
end)

op("vector", "vector.floor", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += vector.floor(V1 * o).X
		end
	end
	return acc
end)

op("vector", "vector.lerp", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += vector.lerp(V1, V2, o * 1e-5).X
		end
	end
	return acc
end)

op("vector", "vector.clamp", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, N - 1 do
			acc += vector.clamp(V1 * o, VMIN, VMAX).X
		end
	end
	return acc
end)

-- pixel packing: one RGBA8 pixel written per iteration ----------------------------

op("pack", "4x writeu8", function(P, r, g, b, a)
	for _ = 1, P do
		for o = 0, (N - 1) * 4, 4 do
			buffer.writeu8(B, o, r)
			buffer.writeu8(B, o + 1, g)
			buffer.writeu8(B, o + 2, b)
			buffer.writeu8(B, o + 3, a)
		end
	end
	return buffer.readu32(B, 4)
end, { 12, 34, 56, 255 })

op("pack", "writeu32(r + g*256 + b*65536 + a*16777216)", function(P, r, g, b, a)
	for _ = 1, P do
		for o = 0, (N - 1) * 4, 4 do
			buffer.writeu32(B, o, r + g * 256 + b * 65536 + a * 16777216)
		end
	end
	return buffer.readu32(B, 4)
end, { 12, 34, 56, 255 })

op("pack", "writeu32(bor(r, lshift(g,8), lshift(b,16), lshift(a,24)))", function(P, r, g, b, a)
	for _ = 1, P do
		for o = 0, (N - 1) * 4, 4 do
			buffer.writeu32(B, o, bit32.bor(r, bit32.lshift(g, 8), bit32.lshift(b, 16), bit32.lshift(a, 24)))
		end
	end
	return buffer.readu32(B, 4)
end, { 12, 34, 56, 255 })

op("pack", "writeu32(prepacked)", function(P, packed)
	for _ = 1, P do
		for o = 0, (N - 1) * 4, 4 do
			buffer.writeu32(B, o, packed)
		end
	end
	return buffer.readu32(B, 4)
end, { 0xFF382210 })

op("pack", "writeu32(PAL[band(i,15)+1])", function(P)
	for _ = 1, P do
		for o = 0, (N - 1) * 4, 4 do
			buffer.writeu32(B, o, PAL[bit32.band(o, 15) + 1])
		end
	end
	return buffer.readu32(B, 4)
end)

local function packHelper(r: number, g: number, b: number, a: number): number
	return r + g * 256 + b * 65536 + a * 16777216
end

op("pack", "writeu32(packHelper(r,g,b,a)) local fn", function(P, r, g, b, a)
	for _ = 1, P do
		for o = 0, (N - 1) * 4, 4 do
			buffer.writeu32(B, o, packHelper(r, g, b, a))
		end
	end
	return buffer.readu32(B, 4)
end, { 12, 34, 56, 255 })

-- pixel unpacking: one RGBA8 pixel read and split per iteration ------------------------

op("unpack", "4x readu8", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, (N - 1) * 4, 4 do
			acc += buffer.readu8(B, o) + buffer.readu8(B, o + 1) + buffer.readu8(B, o + 2) + buffer.readu8(B, o + 3)
		end
	end
	return acc
end)

op("unpack", "readu32 + 4x extract", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, (N - 1) * 4, 4 do
			local p = buffer.readu32(B, o)
			acc += bit32.extract(p, 0, 8) + bit32.extract(p, 8, 8) + bit32.extract(p, 16, 8) + bit32.extract(p, 24, 8)
		end
	end
	return acc
end)

op("unpack", "readu32 + band/rshift", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, (N - 1) * 4, 4 do
			local p = buffer.readu32(B, o)
			acc += bit32.band(p, 255)
				+ bit32.band(bit32.rshift(p, 8), 255)
				+ bit32.band(bit32.rshift(p, 16), 255)
				+ bit32.rshift(p, 24)
		end
	end
	return acc
end)

op("unpack", "readu32 + // and %", function(P)
	local acc = 0
	for _ = 1, P do
		for o = 0, (N - 1) * 4, 4 do
			local p = buffer.readu32(B, o)
			acc += p % 256 + (p // 256) % 256 + (p // 65536) % 256 + p // 16777216
		end
	end
	return acc
end)

----------------------------------------------------------------------------------
-- Full-frame kernels at 1024 x 1024 RGBA8 (4 MiB per frame)
----------------------------------------------------------------------------------

local W, H = 1024, 1024
local PIX = W * H
local BYTES = PIX * 4
local FB = buffer.create(BYTES)
local SRC = buffer.create(BYTES)
local DST2 = buffer.create(BYTES)
local HALF = buffer.create(BYTES // 4)
local IDX = buffer.create(PIX)
local PALB = buffer.create(256 * 4)

for i = 0, 255 do
	buffer.writeu32(PALB, i * 4, 0xFF000000 + i * 0x00010101)
end
for i = 0, PIX - 1 do
	buffer.writeu8(IDX, i, (i * 7) % 256)
	-- source image with a gradient alpha so blend kernels hit every path
	buffer.writeu32(SRC, i * 4, ((i % 256) * 0x01000000) + (i % 251) * 0x10000 + (i % 241) * 0x100 + (i % 239))
	buffer.writeu32(DST2, i * 4, 0xFF000000 + (i % 233) * 0x10000 + (i % 227) * 0x100 + (i % 223))
end

type Kernel = { name: string, fn: () -> number }
local kernels: { Kernel } = {}
local function kernel(name: string, fn: () -> number)
	table.insert(kernels, { name = name, fn = fn })
end

kernel("fill: buffer.fill (memset)", function()
	buffer.fill(FB, 0, 0x7F)
	return buffer.readu8(FB, 100)
end)

kernel("fill: u32 seed + buffer.copy doubling", function()
	buffer.writeu32(FB, 0, 0xFF336699)
	local filled = 4
	while filled < BYTES do
		local n = math.min(filled, BYTES - filled)
		buffer.copy(FB, filled, FB, 0, n)
		filled += n
	end
	return buffer.readu32(FB, BYTES - 4)
end)

kernel("fill: writeu32 per pixel", function()
	local c = 0xFF336699
	for o = 0, BYTES - 4, 4 do
		buffer.writeu32(FB, o, c)
	end
	return buffer.readu32(FB, BYTES - 4)
end)

kernel("blit: 1024 row buffer.copy", function()
	local row = W * 4
	for y = 0, H - 1 do
		local o = y * row
		buffer.copy(FB, o, SRC, o, row)
	end
	return buffer.readu32(FB, 4096)
end)

kernel("gradient: per pixel arithmetic pack", function()
	local o = 0
	for y = 0, H - 1 do
		local gy = (y // 4) * 256 + 0xFF000000
		for x = 0, W - 1 do
			buffer.writeu32(FB, o, gy + x // 4)
			o += 4
		end
	end
	return buffer.readu32(FB, 4096)
end)

kernel("sdf circle: sqrt + clamp per pixel", function()
	local cx, cy, R = 512, 512, 300
	local rgb = 0x00FFAA33
	local o = 0
	for y = 0, H - 1 do
		local dy = y + 0.5 - cy
		local dy2 = dy * dy
		for x = 0, W - 1 do
			local dx = x + 0.5 - cx
			local d = math.sqrt(dx * dx + dy2) - R
			local a = math.clamp(0.5 - d, 0, 1)
			buffer.writeu32(FB, o, rgb + (a * 255 // 1) * 16777216)
			o += 4
		end
	end
	return buffer.readu32(FB, BYTES // 2)
end)

kernel("sdf circle: vector.magnitude per pixel", function()
	local C = vector.create(512, 512, 0)
	local R = 300
	local rgb = 0x00FFAA33
	local o = 0
	for y = 0, H - 1 do
		for x = 0, W - 1 do
			local d = vector.magnitude(vector.create(x + 0.5, y + 0.5, 0) - C) - R
			local a = math.clamp(0.5 - d, 0, 1)
			buffer.writeu32(FB, o, rgb + (a * 255 // 1) * 16777216)
			o += 4
		end
	end
	return buffer.readu32(FB, BYTES // 2)
end)

kernel("sdf circle: span skip (only the AA ring)", function()
	-- Axiom: an SDF tells you where nothing changes. Interior and exterior spans are
	-- solid runs and go through buffer.fill/copy; only the 1-px edge ring runs math.
	local cx, cy, R = 512, 512, 300
	local inside = 0xFFFFAA33
	local outside = 0x00FFAA33 -- transparent pixels keep the edge colour (no dark fringe)
	local row = W * 4
	-- clear the whole frame with one seed write + buffer.copy doubling (memcpy speed)
	buffer.writeu32(FB, 0, outside)
	local filled = 4
	while filled < BYTES do
		local m = math.min(filled, BYTES - filled)
		buffer.copy(FB, filled, FB, 0, m)
		filled += m
	end
	local outerR = R + 1
	local innerR = R - 1
	for y = 0, H - 1 do
		local dy = y + 0.5 - cy
		local dy2 = dy * dy
		if dy2 < outerR * outerR then
			local halfOuter = math.sqrt(outerR * outerR - dy2)
			local halfInner = if dy2 < innerR * innerR then math.sqrt(innerR * innerR - dy2) else -1
			local x0 = math.max(0, math.floor(cx - halfOuter))
			local x1 = math.min(W - 1, math.ceil(cx + halfOuter))
			-- interior pixels are those whose centre lies within innerR, so alpha is exactly 1
			local i0 = if halfInner >= 0 then math.ceil(cx - halfInner - 0.5) else x1 + 1
			local i1 = if halfInner >= 0 then math.floor(cx + halfInner - 0.5) else x1
			local base = y * row
			local leftEnd = math.min(i0 - 1, x1)
			for x = x0, leftEnd do
				local dx = x + 0.5 - cx
				local d = math.sqrt(dx * dx + dy2) - R
				local a = math.clamp(0.5 - d, 0, 1)
				buffer.writeu32(FB, base + x * 4, outside + (a * 255 // 1) * 16777216)
			end
			if i1 >= i0 then
				-- solid interior span: seed one pixel then double with buffer.copy
				local s = base + i0 * 4
				local n = (i1 - i0 + 1) * 4
				buffer.writeu32(FB, s, inside)
				local done = 4
				while done < n do
					local m = math.min(done, n - done)
					buffer.copy(FB, s + done, FB, s, m)
					done += m
				end
			end
			for x = math.max(i1 + 1, leftEnd + 1), x1 do
				local dx = x + 0.5 - cx
				local d = math.sqrt(dx * dx + dy2) - R
				local a = math.clamp(0.5 - d, 0, 1)
				buffer.writeu32(FB, base + x * 4, outside + (a * 255 // 1) * 16777216)
			end
		end
	end
	return buffer.readu32(FB, BYTES // 2)
end)

kernel("mip 2x2 box: per channel extract", function()
	local srcRow = W * 4
	local o = 0
	for y = 0, H - 2, 2 do
		local r0 = y * srcRow
		local r1 = r0 + srcRow
		for x = 0, W - 2, 2 do
			local a0 = r0 + x * 4
			local b0 = r1 + x * 4
			local p, q, s, t = buffer.readu32(SRC, a0), buffer.readu32(SRC, a0 + 4), buffer.readu32(SRC, b0), buffer.readu32(SRC, b0 + 4)
			local cr = (bit32.extract(p, 0, 8) + bit32.extract(q, 0, 8) + bit32.extract(s, 0, 8) + bit32.extract(t, 0, 8) + 2) // 4
			local cg = (bit32.extract(p, 8, 8) + bit32.extract(q, 8, 8) + bit32.extract(s, 8, 8) + bit32.extract(t, 8, 8) + 2) // 4
			local cb = (bit32.extract(p, 16, 8) + bit32.extract(q, 16, 8) + bit32.extract(s, 16, 8) + bit32.extract(t, 16, 8) + 2) // 4
			local ca = (bit32.extract(p, 24, 8) + bit32.extract(q, 24, 8) + bit32.extract(s, 24, 8) + bit32.extract(t, 24, 8) + 2) // 4
			buffer.writeu32(HALF, o, cr + cg * 256 + cb * 65536 + ca * 16777216)
			o += 4
		end
	end
	return buffer.readu32(HALF, 1024)
end)

kernel("mip 2x2 box: SWAR (2 channels per op)", function()
	-- Pairs of channels live in 16-bit lanes (mask 0x00FF00FF). Four 8-bit values
	-- sum to at most 1020, so lanes never carry into each other.
	local srcRow = W * 4
	local o = 0
	for y = 0, H - 2, 2 do
		local r0 = y * srcRow
		local r1 = r0 + srcRow
		for x = 0, W - 2, 2 do
			local a0 = r0 + x * 4
			local b0 = r1 + x * 4
			local p, q, s, t = buffer.readu32(SRC, a0), buffer.readu32(SRC, a0 + 4), buffer.readu32(SRC, b0), buffer.readu32(SRC, b0 + 4)
			local rb = bit32.band(p, 0x00FF00FF) + bit32.band(q, 0x00FF00FF) + bit32.band(s, 0x00FF00FF) + bit32.band(t, 0x00FF00FF) + 0x00020002
			local ga = bit32.band(bit32.rshift(p, 8), 0x00FF00FF)
				+ bit32.band(bit32.rshift(q, 8), 0x00FF00FF)
				+ bit32.band(bit32.rshift(s, 8), 0x00FF00FF)
				+ bit32.band(bit32.rshift(t, 8), 0x00FF00FF)
				+ 0x00020002
			buffer.writeu32(HALF, o, bit32.bor(bit32.band(bit32.rshift(rb, 2), 0x00FF00FF), bit32.lshift(bit32.band(bit32.rshift(ga, 2), 0x00FF00FF), 8)))
			o += 4
		end
	end
	return buffer.readu32(HALF, 1024)
end)

kernel("blend over opaque dst: float per channel", function()
	for o = 0, BYTES - 4, 4 do
		local s = buffer.readu32(SRC, o)
		local d = buffer.readu32(DST2, o)
		local a = bit32.rshift(s, 24) / 255
		local ia = 1 - a
		local r = bit32.band(s, 255) * a + bit32.band(d, 255) * ia
		local g = bit32.extract(s, 8, 8) * a + bit32.extract(d, 8, 8) * ia
		local b = bit32.extract(s, 16, 8) * a + bit32.extract(d, 16, 8) * ia
		buffer.writeu32(FB, o, (r + 0.5) // 1 + ((g + 0.5) // 1) * 256 + ((b + 0.5) // 1) * 65536 + 0xFF000000)
	end
	return buffer.readu32(FB, 4096)
end)

kernel("blend over opaque dst: SWAR exact /255", function()
	-- out = (s*a + d*(255-a)) / 255 with exact rounding, two channels per multiply.
	-- Lane identity used: for 0 <= t <= 65025, round(t/255) = (x + (x >> 8)) >> 8, x = t + 128.
	for o = 0, BYTES - 4, 4 do
		local s = buffer.readu32(SRC, o)
		local d = buffer.readu32(DST2, o)
		local a = bit32.rshift(s, 24)
		local ia = 255 - a
		local rb = bit32.band(s, 0x00FF00FF) * a + bit32.band(d, 0x00FF00FF) * ia + 0x00800080
		rb = bit32.band(bit32.rshift(rb + bit32.band(bit32.rshift(rb, 8), 0x00FF00FF), 8), 0x00FF00FF)
		local g = bit32.band(bit32.rshift(s, 8), 0xFF) * a + bit32.band(bit32.rshift(d, 8), 0xFF) * ia + 128
		g = bit32.rshift(g + bit32.rshift(g, 8), 8)
		buffer.writeu32(FB, o, rb + g * 256 + 0xFF000000)
	end
	return buffer.readu32(FB, 4096)
end)

kernel("lod crossfade t=0.37: SWAR lerp (CPU path)", function()
	local t = 94 -- 0.37 * 255
	local it = 255 - t
	for o = 0, BYTES - 4, 4 do
		local s = buffer.readu32(SRC, o)
		local d = buffer.readu32(DST2, o)
		local rb = bit32.band(s, 0x00FF00FF) * t + bit32.band(d, 0x00FF00FF) * it + 0x00800080
		rb = bit32.band(bit32.rshift(rb + bit32.band(bit32.rshift(rb, 8), 0x00FF00FF), 8), 0x00FF00FF)
		local ga = bit32.band(bit32.rshift(s, 8), 0x00FF00FF) * t + bit32.band(bit32.rshift(d, 8), 0x00FF00FF) * it + 0x00800080
		ga = bit32.band(bit32.rshift(ga + bit32.band(bit32.rshift(ga, 8), 0x00FF00FF), 8), 0x00FF00FF)
		buffer.writeu32(FB, o, rb + ga * 256)
	end
	return buffer.readu32(FB, 4096)
end)

kernel("palette expand: u8 index -> u32 via readu32(PALB)", function()
	local o = 0
	for i = 0, PIX - 1 do
		buffer.writeu32(FB, o, buffer.readu32(PALB, buffer.readu8(IDX, i) * 4))
		o += 4
	end
	return buffer.readu32(FB, 4096)
end)

kernel("chroma key: squared distance + smooth alpha", function()
	local kr, kg, kb = 0, 200, 0
	local lo, hi = 40 * 40, 90 * 90
	local span = 255 / (hi - lo)
	for o = 0, BYTES - 4, 4 do
		local p = buffer.readu32(DST2, o)
		local dr = bit32.band(p, 255) - kr
		local dg = bit32.extract(p, 8, 8) - kg
		local db = bit32.extract(p, 16, 8) - kb
		local d2 = dr * dr + dg * dg + db * db
		local a = math.clamp((d2 - lo) * span, 0, 255) // 1
		buffer.writeu32(FB, o, bit32.band(p, 0x00FFFFFF) + a * 16777216)
	end
	return buffer.readu32(FB, 4096)
end)

kernel("bilinear resample 1024->512 at scale 0.73", function()
	local scale = 1 / 0.73
	local o = 0
	for y = 0, 511 do
		local sy = math.min((y + 0.5) * scale - 0.5, H - 2)
		local y0 = sy // 1
		local fy = sy - y0
		local row0 = y0 * W * 4
		local row1 = row0 + W * 4
		for x = 0, 511 do
			local sx = math.min((x + 0.5) * scale - 0.5, W - 2)
			local x0 = sx // 1
			local fx = sx - x0
			local p00 = buffer.readu32(SRC, row0 + x0 * 4)
			local p10 = buffer.readu32(SRC, row0 + x0 * 4 + 4)
			local p01 = buffer.readu32(SRC, row1 + x0 * 4)
			local p11 = buffer.readu32(SRC, row1 + x0 * 4 + 4)
			local w00 = (1 - fx) * (1 - fy)
			local w10 = fx * (1 - fy)
			local w01 = (1 - fx) * fy
			local w11 = fx * fy
			local r = bit32.band(p00, 255) * w00 + bit32.band(p10, 255) * w10 + bit32.band(p01, 255) * w01 + bit32.band(p11, 255) * w11
			local g = bit32.extract(p00, 8, 8) * w00 + bit32.extract(p10, 8, 8) * w10 + bit32.extract(p01, 8, 8) * w01 + bit32.extract(p11, 8, 8) * w11
			local b = bit32.extract(p00, 16, 8) * w00 + bit32.extract(p10, 16, 8) * w10 + bit32.extract(p01, 16, 8) * w01 + bit32.extract(p11, 16, 8) * w11
			local a = bit32.rshift(p00, 24) * w00 + bit32.rshift(p10, 24) * w10 + bit32.rshift(p01, 24) * w01 + bit32.rshift(p11, 24) * w11
			buffer.writeu32(HALF, o, (r + 0.5) // 1 + ((g + 0.5) // 1) * 256 + ((b + 0.5) // 1) * 65536 + ((a + 0.5) // 1) * 16777216)
			o += 4
		end
	end
	return buffer.readu32(HALF, 1024)
end)

kernel("dirty tiles: 16 tiles of 64x64 rewritten", function()
	local row = W * 4
	local c = 0xFF00FF00
	for t = 0, 15 do
		local tx = (t % 4) * 256
		local ty = (t // 4) * 256
		for y = ty, ty + 63 do
			local base = y * row + tx * 4
			for o = base, base + 63 * 4, 4 do
				buffer.writeu32(FB, o, c)
			end
		end
	end
	return buffer.readu32(FB, 0)
end)

----------------------------------------------------------------------------------
-- Driver
----------------------------------------------------------------------------------

local REPS = 5

local function timeOp(entry: OpBench, passes: number): number
	local best = math.huge
	local args = entry.args or {}
	for _ = 1, REPS do
		local t0 = clock()
		entry.fn(passes, table.unpack(args))
		local dt = clock() - t0
		if dt < best then
			best = dt
		end
		yieldNow()
	end
	return best
end

local function run()
	-- Calibrate pass count so the baseline loop takes roughly 20 ms.
	local passes = 8
	while true do
		local dt = timeOp(ops[1], passes)
		if dt >= 0.02 or passes >= 4096 then
			break
		end
		passes *= 2
	end
	local iters = passes * N
	local baseline = timeOp(ops[1], passes)
	emit("meta", "passes", passes, "count")
	emit("meta", "baseline loop", baseline / iters * 1e9, "ns/iter")
	for i = 2, #ops do
		local entry = ops[i]
		local dt = timeOp(entry, passes)
		-- ns/op subtracts the loop+add baseline: meaningful in the interpreter, where
		-- dispatch dominates. Native loops are bound by the latency of the add chain, so
		-- cheap native ops hide under it; ns/iter (raw) is the honest native number.
		emit(entry.group, entry.name, (dt - baseline) / iters * 1e9, "ns/op")
		emit(entry.group, entry.name, dt / iters * 1e9, "ns/iter")
	end
	for _, k in kernels do
		local best = math.huge
		for _ = 1, 3 do
			local t0 = clock()
			k.fn()
			local dt = clock() - t0
			if dt < best then
				best = dt
			end
			yieldNow()
		end
		emit("kernel", k.name, best * 1000, "ms/frame")
	end
end

run()
return nil
