        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Coverage</string>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: compute/Coverage
--
-- Pixel coverage: the fraction of a unit pixel square inside a shape (a box
-- filter, which is what "anti-aliased" means here). docs/COMPUTE.md 3.3.
--
-- Estimators (deterministic: + - * / sqrt abs and comparisons only):
--   linear(d, w)            clamp(0.5 - d / w, 0, 1): the distance ramp used by
--                           MyMath.coverage. Exact only for axis-aligned edges;
--                           up to 10.94/255 on a 45 degree edge (C3).
--   halfPlane(d, nx, ny)    exact area of the pixel inside the tangent half-plane
--                           (SDF value d at the centre, unit gradient (nx, ny)).
--                           Exact for straight edges (C4); on a curve of radius R
--                           it overestimates by at most (sqrt(2)/2)^3 / (3 R),
--                           i.e. 30/R in 1/255 units (C5). = MyMath.coverageHalfPlane
--   halfPlaneCurved(...)    half-plane minus the first-order curvature term over
--                           the chord. The residual is O(1/R) where the chord
--                           leaves the pixel at a shallow angle (measured 0.36/255
--                           at R = 8, 0.036 at R = 48, 0.002 at R = 300): an
--                           estimator, not flawless. = MyMath.coverageCurved
--   corner, edgePair        exact areas where two edges enter the pixel (C6).
--   discRectArea, roundCorner, dasin   exact disc pieces with a deterministic
--                           arcsine: usable for texture content.
--   supersample(...)        n x n point samples (NOT a reference: 1/(2n) error).
--
-- Exact areas used by the flawless pipeline (F1, F2; deterministic, allocation-free):
--   datan2(s, c)            deterministic atan2 from dasin (arguments <= sqrt(2)/2)
--   discBoxArea(...)        disc and axis-aligned rectangle, by quadrant integration
--   discPolyArea(...)       disc and convex polygon, by signed disc-triangle areas
--   polygonBoxCoverage(...) simple polygon and pixel box, by per-edge integrals
--   clipInto, polyArea      Sutherland-Hodgman half-plane clip and shoelace on
--                           caller-owned scratch arrays
--
-- References for tests and benchmarks:
--   circleArea(...)         exact area of circle and pixel (closed form; uses
--                           math.asin, so REFERENCE ONLY, never texture content)
--   polygonArea(...)        exact area of polygon and pixel (clip + shoelace)

local MyMath = require("../MyMath")

local Coverage = {}

local abs = math.abs
local sqrt = math.sqrt

function Coverage.linear(d: number, w: number): number
	local a = 0.5 - d / w
	return if a < 0 then 0 elseif a > 1 then 1 else a
end

-- Exact area of {q in pixel : d + n . (q - centre) <= 0} for |n| = 1 (C4).
-- The projection of the unit square on n has a trapezoid density: ramps of width
-- b = min(|nx|, |ny|) and a plateau of width a - b, a = max(|nx|, |ny|).
-- The axiom lives in MyMath; this is the same function (bit-identical).
local halfPlane = MyMath.coverageHalfPlane
Coverage.halfPlane = halfPlane

-- The largest |d| at which halfPlane can be strictly between 0 and 1: (a + b) / 2
-- <= sqrt(2) / 2. Tile culling for exact coverage uses this instead of w / 2.
Coverage.HALF_PLANE_REACH = MyMath.COVERAGE_REACH

-- Curvature-corrected coverage (docs/COMPUTE.md C5): half-plane area minus the
-- first-order term k (t1^3 - t0^3) / 6 over the chord the tangent line cuts from
-- the pixel. The axiom lives in MyMath; this is the same function (bit-identical).
local halfPlaneCurved = MyMath.coverageCurved
Coverage.halfPlaneCurved = halfPlaneCurved

-- Exact area of the unit pixel square centred at the origin intersected with up to
-- two half-planes {q : n1 . q <= c1} and {q : n2 . q <= c2} (normals need not be
-- unit length). Sutherland-Hodgman with preallocated scratch arrays, then the
-- shoelace formula: no allocation, deterministic ops only. Used for polygon
-- vertices, where the boundary is a wedge (two edges) and no single half-plane
-- describes it. Pass n2x = n2y = 0, c2 = 1 for one half-plane.
local SX: { number } = table.create(16, 0)
local SY: { number } = table.create(16, 0)
local TX: { number } = table.create(16, 0)
local TY: { number } = table.create(16, 0)

-- Sutherland-Hodgman: clips polygon (ax, ay)[1..n] to {q : nx qx + ny qy <= c},
-- writing the result into (bx, by) and returning its vertex count. For a convex
-- input the output is the convex intersection; for any input its signed area is
-- the area of the clipped region (bridges along the clip line cancel).
local function clipInto(ax: { number }, ay: { number }, n: number, bx: { number }, by: { number }, nx: number, ny: number, c: number): number
	local m = 0
	if n == 0 then
		return 0
	end
	local px, py = ax[n], ay[n]
	local pv = nx * px + ny * py - c
	for i = 1, n do
		local qx, qy = ax[i], ay[i]
		local qv = nx * qx + ny * qy - c
		if qv <= 0 then
			if pv > 0 then
				local t = pv / (pv - qv)
				m += 1
				bx[m] = px + (qx - px) * t
				by[m] = py + (qy - py) * t
			end
			m += 1
			bx[m] = qx
			by[m] = qy
		elseif pv <= 0 then
			local t = pv / (pv - qv)
			m += 1
			bx[m] = px + (qx - px) * t
			by[m] = py + (qy - py) * t
		end
		px, py, pv = qx, qy, qv
	end
	return m
end
Coverage.clipInto = clipInto

-- Signed shoelace area of (x, y)[1..n] (positive for counter-clockwise order in a
-- right-handed frame, i.e. when every edge has the interior on its left).
local function polyArea(x: { number }, y: { number }, n: number): number
	if n < 3 then
		return 0
	end
	local s = 0
	local px, py = x[n], y[n]
	for i = 1, n do
		local qx, qy = x[i], y[i]
		s += px * qy - qx * py
		px, py = qx, qy
	end
	return s * 0.5
end
Coverage.polyArea = polyArea

local function squareClip2(n1x: number, n1y: number, c1: number, n2x: number, n2y: number, c2: number): number
	SX[1], SY[1] = -0.5, -0.5
	SX[2], SY[2] = 0.5, -0.5
	SX[3], SY[3] = 0.5, 0.5
	SX[4], SY[4] = -0.5, 0.5
	local m = clipInto(SX, SY, 4, TX, TY, n1x, n1y, c1)
	m = clipInto(TX, TY, m, SX, SY, n2x, n2y, c2)
	if m < 3 then
		return 0
	end
	local s = 0
	local px, py = SX[m], SY[m]
	for i = 1, m do
		local qx, qy = SX[i], SY[i]
		s += px * qy - qx * py
		px, py = qx, qy
	end
	s = abs(s) * 0.5
	return if s > 1 then 1 else s
end
Coverage.squareClip2 = squareClip2

-- Exact coverage of the pixel centred at (px, py) by the polygon corner at vertex
-- v = (vx, vy) between the incoming edge (from u) and the outgoing edge (to w),
-- for a polygon of orientation sigma (+1 or -1, the sign of its shoelace area).
-- Exact whenever no other edge of the polygon enters the pixel.
function Coverage.corner(px: number, py: number, ux: number, uy: number, vx: number, vy: number, wx: number, wy: number, sigma: number): number
	-- inner side of edge a->b: sigma * cross(b - a, q - a) >= 0, i.e. n . q <= c
	-- with n = sigma * (by - ay, -(bx - ax)); shift q to pixel-local coordinates
	local e1x, e1y = vx - ux, vy - uy
	local e2x, e2y = wx - vx, wy - vy
	local n1x, n1y = sigma * e1y, -sigma * e1x
	local n2x, n2y = sigma * e2y, -sigma * e2x
	local c1 = n1x * (vx - px) + n1y * (vy - py)
	local c2 = n2x * (vx - px) + n2y * (vy - py)
	local convex = sigma * (e1x * e2y - e1y * e2x) >= 0
	if convex then
		return squareClip2(n1x, n1y, c1, n2x, n2y, c2)
	end
	-- reflex: the polygon is locally the union of the two half-planes
	local a1 = squareClip2(n1x, n1y, c1, 0, 0, 1)
	local a2 = squareClip2(n2x, n2y, c2, 0, 0, 1)
	local a12 = squareClip2(n1x, n1y, c1, n2x, n2y, c2)
	local a = a1 + a2 - a12
	return if a < 0 then 0 elseif a > 1 then 1 else a
end

-- Deterministic arcsine: Taylor series on |x| <= 1/2 (28 terms: the first omitted
-- term is below 2e-20 at |x| = 1/2, so the result is within a few double rounding
-- units), and asin(x) = pi/2 - 2 asin(sqrt((1 - x) / 2)) above. Only + - * / sqrt,
-- so it is bit-identical on every platform, unlike math.asin. (An 18-term version
-- truncated at 7e-14, which became visible in sector areas of discs with radii
-- in the thousands; docs/COMPUTE.md "Flawless pipeline".)
local ASIN_TERMS = 28
local ASIN_C: { number } = {}
do
	-- c_n = (2n)! / (4^n (n!)^2 (2n + 1))
	local c = 1
	for n = 0, ASIN_TERMS - 1 do
		ASIN_C[n + 1] = c / (2 * n + 1)
		c = c * (2 * n + 1) / (2 * n + 2)
	end
end
local HALF_PI = 1.5707963267948966

-- The series as nested Horner expressions over upvalue constants: the same
-- operations in the same order as a loop over ASIN_C (so the same bits), without
-- the loop and table reads (4x faster in the interpreter).
local C1, C2, C3, C4, C5, C6, C7, C8, C9, C10, C11, C12, C13, C14, C15, C16, C17, C18, C19, C20, C21, C22, C23, C24, C25, C26, C27 =
	ASIN_C[2], ASIN_C[3], ASIN_C[4], ASIN_C[5], ASIN_C[6], ASIN_C[7], ASIN_C[8], ASIN_C[9], ASIN_C[10], ASIN_C[11], ASIN_C[12], ASIN_C[13], ASIN_C[14], ASIN_C[15], ASIN_C[16], ASIN_C[17], ASIN_C[18], ASIN_C[19], ASIN_C[20], ASIN_C[21], ASIN_C[22], ASIN_C[23], ASIN_C[24], ASIN_C[25], ASIN_C[26], ASIN_C[27], ASIN_C[28]

-- asin(x) for |x| <= 1/2.
local function asinSmall(x: number): number
	local x2 = x * x
	if x2 <= 0.015625 then
		-- |x| <= 1/8 (arcs a pixel subtends): nine terms; the first omitted one is
		-- below 1e-19 relative
		return x * (1 + x2 * (C1 + x2 * (C2 + x2 * (C3 + x2 * (C4 + x2 * (C5 + x2 * (C6 + x2 * (C7 + x2 * (C8)))))))))
	end
	return x * (1 + x2 * (C1 + x2 * (C2 + x2 * (C3 + x2 * (C4 + x2 * (C5 + x2 * (C6 + x2 * (C7 + x2 * (C8 + x2 * (C9 + x2 * (C10 + x2 * (C11 + x2 * (C12 + x2 * (C13 + x2 * (C14 + x2 * (C15 + x2 * (C16 + x2 * (C17 + x2 * (C18 + x2 * (C19 + x2 * (C20 + x2 * (C21 + x2 * (C22 + x2 * (C23 + x2 * (C24 + x2 * (C25 + x2 * (C26 + x2 * (C27))))))))))))))))))))))))))))
end

local function dasin(x: number): number
	local ax = abs(x)
	if ax <= 0.125 then
		local x2 = x * x
		return x * (1 + x2 * (C1 + x2 * (C2 + x2 * (C3 + x2 * (C4 + x2 * (C5 + x2 * (C6 + x2 * (C7 + x2 * (C8)))))))))
	end
	local r
	if ax <= 0.5 then
		return asinSmall(x)
	elseif ax >= 1 then
		r = HALF_PI
	else
		r = HALF_PI - 2 * asinSmall(sqrt((1 - ax) * 0.5))
	end
	return if x < 0 then -r else r
end
Coverage.dasin = dasin

-- Integral of sqrt(r^2 - t^2) from 0 to t (|t| <= r), deterministic. Written to
-- stay well conditioned as |t| -> r (a vertical tangent of the circle): r^2 - t^2
-- as (r - t)(r + t) (r - t is exact there), and asin(t / r) as pi/2 - 2 asin(sqrt((r
-- - t) / 2r)) above r/2, so the two sqrt(r - t) terms cancel analytically instead
-- of losing sqrt(epsilon) r^2 (about 1e-8 r^2) to rounding.
local QUARTER_PI = 0.78539816339744831
local function chordIntegralDet(t: number, r: number): number
	if t >= r then
		return QUARTER_PI * r * r
	elseif t <= -r then
		return -QUARTER_PI * r * r
	end
	local a
	if t > 0.5 * r then
		a = HALF_PI - 2 * dasin(sqrt((r - t) / (2 * r)))
	elseif t < -0.5 * r then
		a = 2 * dasin(sqrt((r + t) / (2 * r))) - HALF_PI
	else
		a = dasin(t / r)
	end
	return 0.5 * (t * sqrt((r - t) * (r + t)) + r * r * a)
end

-- Exact area of the disc (cx, cy, r) inside the rectangle [x0, x1] x [y0, y1],
-- deterministic and allocation-free (cuts kept in a fixed scratch array and
-- insertion-sorted). Same method as circleArea: split x where min/max switch.
local CUT: { number } = table.create(8, 0)

-- Inserts x into CUT[1..n] (sorted) when x0 < x < x1; returns the new count.
local function insertCut(n: number, x: number, x0: number, x1: number): number
	if x > x0 and x < x1 then
		n += 1
		local i = n
		while i > 1 and CUT[i - 1] > x do
			CUT[i] = CUT[i - 1]
			i -= 1
		end
		CUT[i] = x
	end
	return n
end

local function discRectArea(cx: number, cy: number, r: number, x0: number, y0: number, x1: number, y1: number): number
	if x1 <= x0 or y1 <= y0 or r <= 0 then
		return 0
	end
	local n = insertCut(0, cx - r, x0, x1)
	n = insertCut(n, cx + r, x0, x1)
	local dy0 = y0 - cy
	if abs(dy0) < r then
		local hw = sqrt(r * r - dy0 * dy0)
		n = insertCut(n, cx - hw, x0, x1)
		n = insertCut(n, cx + hw, x0, x1)
	end
	local dy1 = y1 - cy
	if abs(dy1) < r then
		local hw = sqrt(r * r - dy1 * dy1)
		n = insertCut(n, cx - hw, x0, x1)
		n = insertCut(n, cx + hw, x0, x1)
	end
	local area = 0
	local a = x0
	for i = 1, n + 1 do
		local b = if i <= n then CUT[i] else x1
		if b > a then
			local m = (a + b) * 0.5 - cx
			if abs(m) < r then
				local hm = sqrt(r * r - m * m)
				local upperIsCircle = cy + hm < y1
				local lowerIsCircle = cy - hm > y0
				local top = if upperIsCircle then cy + hm else y1
				local bot = if lowerIsCircle then cy - hm else y0
				if top > bot then
					local len = b - a
					local hInt = if upperIsCircle or lowerIsCircle then chordIntegralDet(b - cx, r) - chordIntegralDet(a - cx, r) else 0
					local upper = if upperIsCircle then cy * len + hInt else y1 * len
					local lower = if lowerIsCircle then cy * len - hInt else y0 * len
					area += upper - lower
				end
			end
		end
		a = b
	end
	return area
end
Coverage.discRectArea = discRectArea

----------------------------------------------------------------------------------
-- Exact areas for the flawless pipeline (docs/COMPUTE.md "Flawless pipeline")
----------------------------------------------------------------------------------

local PI = 3.141592653589793

-- Deterministic atan2: the angle of the vector (c, s) in (-pi, pi]. Each branch
-- calls dasin with an argument of magnitude at most sqrt(2)/2, where the arcsine
-- is well conditioned (derivative <= sqrt(2)), so the absolute error stays near
-- the double rounding unit for every angle, including angles near 0 and pi.
local function datan2(s: number, c: number): number
	local m = sqrt(s * s + c * c)
	if m == 0 then
		return 0
	end
	local as = abs(s) / m
	local ac = c / m
	local t
	if ac >= as then
		t = dasin(as) -- |angle| <= 45 degrees
	elseif ac >= -as then
		t = HALF_PI - dasin(ac) -- 45 to 135 degrees
	else
		t = PI - dasin(as) -- 135 to 180 degrees
	end
	return if s < 0 then -t else t
end
Coverage.datan2 = datan2

-- Area of disc(0, r) inside [a, b] x [c, d] with 0 <= a < b and 0 <= c < d (the
-- first quadrant, where the upper circle y = sqrt(r^2 - x^2) decreases). For x <=
-- xd the circle is at height >= d (full column), for x >= xc it is below c (empty
-- column), in between the column height is sqrt(r^2 - x^2) - c, integrated in
-- closed form with one arcsine: asin(q/r) - asin(p/r) = asin((q sp - p sq) / r^2)
-- for 0 <= p <= q <= r, where sp, sq are the circle heights at p and q. The caller
-- orients the piece so the integration runs along the axis on which the circle is
-- flatter (heights stay large, no cancellation in r^2 - x^2).
local function quadrantArea(a: number, b: number, c: number, d: number, r: number, r2: number): number
	if a * a + c * c >= r2 then
		return 0
	end
	if b * b + d * d <= r2 then
		return (b - a) * (d - c)
	end
	-- (single assignments: a call in the last position of a multiple assignment
	-- types as optional in strict mode)
	local p, sp = 0, r
	if d < r then
		p = sqrt(r2 - d * d)
		sp = d
	end
	if p < a then
		p = a
		sp = sqrt(r2 - a * a)
	elseif p > b then
		p = b
		sp = sqrt(r2 - b * b)
	end
	local q = sqrt(r2 - c * c)
	local sq = c
	if q > b then
		q = b
		sq = sqrt(r2 - b * b)
	elseif q < a then
		q = a
		sq = sqrt(r2 - a * a)
	end
	local area = (d - c) * (p - a)
	if q > p then
		area += 0.5 * (q * sq - p * sp) + 0.5 * r2 * dasin((q * sp - p * sq) / r2) - c * (q - p)
	end
	return area
end

-- One quadrant piece [a, b] x [c, d] (already reflected into the first quadrant),
-- integrated along the axis where the piece lies closer to the circle's centre line.
local function quadrantPiece(a: number, b: number, c: number, d: number, r: number, r2: number): number
	if b <= a or d <= c then
		return 0
	end
	if a + b > c + d then
		return quadrantArea(c, d, a, b, r, r2)
	end
	return quadrantArea(a, b, c, d, r, r2)
end

-- Exact area of the disc (cx, cy, r) inside the rectangle [x0, x1] x [y0, y1].
-- The rectangle is split by the disc's centre lines into at most four pieces, each
-- reflected into the first quadrant and integrated in closed form (quadrantArea).
-- No topology (no walking of intersection points), so tangencies and corners on
-- the circle cannot flip a branch: the result is continuous in every input.
-- Deterministic (+ - * / sqrt and dasin), allocation-free.
local function discBoxArea(cx: number, cy: number, r: number, x0: number, y0: number, x1: number, y1: number): number
	if r <= 0 or x1 <= x0 or y1 <= y0 then
		return 0
	end
	local X0, X1, Y0, Y1 = x0 - cx, x1 - cx, y0 - cy, y1 - cy
	if X0 >= r or X1 <= -r or Y0 >= r or Y1 <= -r then
		return 0
	end
	local r2 = r * r
	if (X0 >= 0 or X1 <= 0) and (Y0 >= 0 or Y1 <= 0) then
		-- the rectangle lies in one quadrant (every edge pixel of a disc larger than
		-- the pixel, away from its centre lines): one piece
		local a, b, c, d = X0, X1, Y0, Y1
		if X1 <= 0 then
			a, b = -X1, -X0
		end
		if Y1 <= 0 then
			c, d = -Y1, -Y0
		end
		if a + b > c + d then
			return quadrantArea(c, d, a, b, r, r2)
		end
		return quadrantArea(a, b, c, d, r, r2)
	end
	-- x pieces: right [ra, rb] (x >= 0) and left mirrored [la, lb] (x <= 0)
	local ra = if X0 > 0 then X0 else 0
	local rb = X1
	local la = if X1 < 0 then -X1 else 0
	local lb = -X0
	local ta = if Y0 > 0 then Y0 else 0
	local tb = Y1
	local ba = if Y1 < 0 then -Y1 else 0
	local bb = -Y0
	local area = 0
	if rb > ra then
		area += quadrantPiece(ra, rb, ta, tb, r, r2) + quadrantPiece(ra, rb, ba, bb, r, r2)
	end
	if lb > la then
		area += quadrantPiece(la, lb, ta, tb, r, r2) + quadrantPiece(la, lb, ba, bb, r, r2)
	end
	return area
end
Coverage.discBoxArea = discBoxArea

-- Signed area of disc(0, r) intersected with the triangle (0, A, B): the part of
-- the segment A-B inside the circle contributes its triangle with the centre, the
-- parts outside contribute circular sectors r^2/2 * angle. Each edge's term is
-- computed independently (no pairing of intersection points), so the sum over a
-- polygon's edges is robust to tangencies and vertices on the circle.
local function triDisc(ax: number, ay: number, bx: number, by: number, r2: number): number
	local aa = ax * ax + ay * ay
	local bb = bx * bx + by * by
	if aa <= r2 and bb <= r2 then
		return 0.5 * (ax * by - ay * bx)
	end
	local half = 0.5 * r2
	local dx, dy = bx - ax, by - ay
	local A = dx * dx + dy * dy
	if A == 0 then
		return 0
	end
	local B = ax * dx + ay * dy
	local C = aa - r2
	local disc = B * B - A * C
	if disc <= 0 then
		return half * datan2(ax * by - ay * bx, ax * bx + ay * by)
	end
	local sd = sqrt(disc)
	-- roots of A t^2 + 2 B t + C = 0, the stable way (no cancellation)
	local t1, t2
	if B >= 0 then
		local q = -(B + sd)
		t1, t2 = q / A, C / q
	else
		local q = sd - B
		t1, t2 = C / q, q / A
	end
	local u1 = if t1 > 0 then t1 else 0
	local u2 = if t2 < 1 then t2 else 1
	if u1 >= u2 then
		return half * datan2(ax * by - ay * bx, ax * bx + ay * by)
	end
	local p1x, p1y = ax + u1 * dx, ay + u1 * dy
	local p2x, p2y = ax + u2 * dx, ay + u2 * dy
	local area = 0.5 * (p1x * p2y - p1y * p2x)
	if u1 > 0 then
		area += half * datan2(ax * p1y - ay * p1x, ax * p1x + ay * p1y)
	end
	if u2 < 1 then
		area += half * datan2(p2x * by - p2y * bx, p2x * bx + p2y * by)
	end
	return area
end

-- Exact signed area of the disc (cx, cy, r) intersected with the polygon
-- (px, py)[1..n] (positive for counter-clockwise polygons). Exact for any simple
-- polygon (the disc-triangle terms add up by Green's theorem); the flawless
-- pipeline calls it with small convex polygons in pixel-local coordinates.
local function discPolyArea(px: { number }, py: { number }, n: number, cx: number, cy: number, r: number): number
	if n < 3 or r <= 0 then
		return 0
	end
	local r2 = r * r
	local s = 0
	local ax, ay = px[n] - cx, py[n] - cy
	for i = 1, n do
		local bx, by = px[i] - cx, py[i] - cy
		s += triDisc(ax, ay, bx, by, r2)
		ax, ay = bx, by
	end
	return s
end
Coverage.discPolyArea = discPolyArea

-- Mean of clamp(t, 0, 1) for t running linearly from a to b.
local function avgClamp01(a: number, b: number): number
	if a > b then
		a, b = b, a
	end
	if b <= 0 then
		return 0
	end
	if a >= 1 then
		return 1
	end
	if a >= 0 and b <= 1 then
		return (a + b) * 0.5
	end
	-- G(t) = integral of clamp(s, 0, 1) ds from 0 to t
	local ga = if a <= 0 then 0 else a * a * 0.5
	local gb = if b >= 1 then b - 0.5 else b * b * 0.5
	return (gb - ga) / (b - a)
end

-- Signed coverage of the w x w box with lower corner (x0, y0) by the polygon
-- v[first], v[first + 1], ... (count vertices, flat x, y pairs), in units of the
-- box area. By Green's theorem the area of polygon and box is the sum over edges
-- of dir * integral over the edge's y-span inside the box of (x1 - clamp(x, x0,
-- x1)) dy: the part of the box row to the right of the edge, signed by the edge's
-- vertical direction. Each edge is a linear x(y), so the clamped integral has a
-- closed form (avgClamp01). Exact for simple polygons of either orientation (the
-- sign of the result is the orientation); edges whose y-span misses the box cost
-- two comparisons. Deterministic, allocation-free.
local function polygonBoxCoverage(v: { number }, first: number, count: number, x0: number, y0: number, w: number): number
	local iw = 1 / w
	local y1 = y0 + w
	local s = 0
	local last = first + 2 * count - 2
	local ax, ay = v[last], v[last + 1]
	for i = first, last, 2 do
		local bx, by = v[i], v[i + 1]
		if ay ~= by then
			local lx, ly, hx, hy, dir = ax, ay, bx, by, 1
			if ay > by then
				lx, ly, hx, hy, dir = bx, by, ax, ay, -1
			end
			if hy > y0 and ly < y1 then
				local lo = if ly > y0 then ly else y0
				local hi = if hy < y1 then hy else y1
				local slope = (hx - lx) / (hy - ly)
				local ul = (lx + (lo - ly) * slope - x0) * iw
				local uh = (lx + (hi - ly) * slope - x0) * iw
				s += dir * (hi - lo) * iw * (1 - avgClamp01(ul, uh))
			end
		end
		ax, ay = bx, by
	end
	return s
end
Coverage.polygonBoxCoverage = polygonBoxCoverage

-- Nearest point of the segment a + t e (0 <= t <= 1) to (px, py), relative to (px, py).
local function nearestLocal(px: number, py: number, ax: number, ay: number, ex: number, ey: number): (number, number)
	local ee = ex * ex + ey * ey
	local t = if ee > 0 then ((px - ax) * ex + (py - ay) * ey) / ee else 0
	t = if t < 0 then 0 elseif t > 1 then 1 else t
	return ax + ex * t - px, ay + ey * t - py
end

-- Exact coverage of the pixel centred at (px, py) by a polygon locally bounded by
-- two non-adjacent edges a1->b1 and a2->b2 (polygon order, orientation sigma).
-- The edges cut the pixel into an outer part, a between part and another outer
-- part, and inside/outside alternates across each edge. If the inner sides face
-- each other the polygon is locally H1 and H2 (a sliver); if they face away it is
-- H1 or H2 (a gap). Otherwise (a third edge must be involved) it falls back to the
-- nearer edge alone. Exact whenever only these two edges enter the pixel.
function Coverage.edgePair(
	px: number,
	py: number,
	a1x: number,
	a1y: number,
	b1x: number,
	b1y: number,
	a2x: number,
	a2y: number,
	b2x: number,
	b2y: number,
	sigma: number
): number
	local e1x, e1y = b1x - a1x, b1y - a1y
	local e2x, e2y = b2x - a2x, b2y - a2y
	local n1x, n1y = sigma * e1y, -sigma * e1x
	local n2x, n2y = sigma * e2y, -sigma * e2x
	local c1 = n1x * (a1x - px) + n1y * (a1y - py)
	local c2 = n2x * (a2x - px) + n2y * (a2y - py)
	local q1x, q1y = nearestLocal(px, py, a1x, a1y, e1x, e1y)
	local q2x, q2y = nearestLocal(px, py, a2x, a2y, e2x, e2y)
	local twoInOne = n1x * q2x + n1y * q2y <= c1
	local oneInTwo = n2x * q1x + n2y * q1y <= c2
	if twoInOne and oneInTwo then
		return squareClip2(n1x, n1y, c1, n2x, n2y, c2)
	elseif not twoInOne and not oneInTwo then
		local a = squareClip2(n1x, n1y, c1, 0, 0, 1) + squareClip2(n2x, n2y, c2, 0, 0, 1) - squareClip2(n1x, n1y, c1, n2x, n2y, c2)
		return if a < 0 then 0 elseif a > 1 then 1 else a
	end
	if q1x * q1x + q1y * q1y <= q2x * q2x + q2y * q2y then
		return squareClip2(n1x, n1y, c1, 0, 0, 1)
	end
	return squareClip2(n2x, n2y, c2, 0, 0, 1)
end

-- Exact coverage of a w x w pixel box centred at (X, Y) by a rounded-box corner in
-- corner-local coordinates (arc centre at the origin, the box extends towards
-- negative X and Y): {X <= 0, Y <= rad} or {Y <= 0, X <= rad} or the disc of
-- radius rad. Split into two rectangles and a disc-rectangle piece. Returns area
-- divided by w^2.
function Coverage.roundCorner(X: number, Y: number, rad: number, w: number): number
	local h = w * 0.5
	local a0, a1, b0, b1 = X - h, X + h, Y - h, Y + h
	local area = 0
	-- part 1: X' <= 0 and Y' <= rad
	local ux = (if a1 < 0 then a1 else 0) - a0
	local uy = (if b1 < rad then b1 else rad) - b0
	if ux > 0 and uy > 0 then
		area += ux * uy
	end
	-- part 2: 0 < X' <= rad and Y' <= 0
	local vx = (if a1 < rad then a1 else rad) - (if a0 > 0 then a0 else 0)
	local vy = (if b1 < 0 then b1 else 0) - b0
	if vx > 0 and vy > 0 then
		area += vx * vy
	end
	-- part 3: X' > 0, Y' > 0 inside the disc
	if a1 > 0 and b1 > 0 then
		area += discRectArea(0, 0, rad, if a0 > 0 then a0 else 0, if b0 > 0 then b0 else 0, a1, b1)
	end
	local c = area / (w * w)
	return if c > 1 then 1 else c
end

-- Curvature-corrected circle coverage (k = 1 / r).
function Coverage.circleCurved(px: number, py: number, cx: number, cy: number, r: number): number
	local dx, dy = px - cx, py - cy
	local len = sqrt(dx * dx + dy * dy)
	if len == 0 then
		return if r > 0.70710678118654757 then 1 else halfPlane(-r, 1, 0)
	end
	return halfPlaneCurved(len - r, dx / len, dy / len, 1 / r)
end

-- Exact coverage estimate for a circle from its SDF (centre distance minus r).
function Coverage.circleHalfPlane(px: number, py: number, cx: number, cy: number, r: number): number
	local dx, dy = px - cx, py - cy
	local len = sqrt(dx * dx + dy * dy)
	if len == 0 then
		return if r > 0.70710678118654757 then 1 else halfPlane(-r, 1, 0)
	end
	return halfPlane(len - r, dx / len, dy / len)
end

----------------------------------------------------------------------------------
-- Exact references
----------------------------------------------------------------------------------

-- Integral of sqrt(r^2 - t^2) dt from 0 to t, |t| <= r. Reference only (asin).
-- Well conditioned at |t| -> r like chordIntegralDet (the plain form loses about
-- 1e-8 r^2 there: 6.5e-7 measured for r = 30.6 at a vertical tangent).
local function chordIntegral(t: number, r: number): number
	if t >= r then
		return math.pi * r * r * 0.25
	elseif t <= -r then
		return -math.pi * r * r * 0.25
	end
	local a
	if t > 0.5 * r then
		a = math.pi * 0.5 - 2 * math.asin(sqrt((r - t) / (2 * r)))
	elseif t < -0.5 * r then
		a = 2 * math.asin(sqrt((r + t) / (2 * r))) - math.pi * 0.5
	else
		a = math.asin(t / r)
	end
	return 0.5 * (t * sqrt((r - t) * (r + t)) + r * r * a)
end

-- Exact area of the disc (cx, cy, r) inside the square [x0, x0 + 1] x [y0, y0 + 1].
-- Integrates max(0, min(y1, cy + h) - max(y0, cy - h)) over x, splitting at every
-- x where one of the min/max switches, so each piece is a constant or +-h + const.
function Coverage.circleArea(cx: number, cy: number, r: number, x0: number, y0: number): number
	local x1, y1 = x0 + 1, y0 + 1
	local cuts = { x0, x1 }
	local function cut(x: number)
		if x > x0 and x < x1 then
			table.insert(cuts, x)
		end
	end
	cut(cx - r)
	cut(cx + r)
	for _, yb in { y0, y1 } do
		local dy = yb - cy
		if abs(dy) < r then
			local hw = sqrt(r * r - dy * dy)
			cut(cx - hw)
			cut(cx + hw)
		end
	end
	table.sort(cuts)
	local area = 0
	for i = 1, #cuts - 1 do
		local a, b = cuts[i], cuts[i + 1]
		if b - a <= 0 then
			continue
		end
		local m = (a + b) * 0.5 - cx
		if abs(m) >= r then
			continue
		end
		local hm = sqrt(r * r - m * m)
		local upperIsCircle = cy + hm < y1
		local lowerIsCircle = cy - hm > y0
		local top = if upperIsCircle then cy + hm else y1
		local bot = if lowerIsCircle then cy - hm else y0
		if top <= bot then
			continue
		end
		local len = b - a
		local hInt = chordIntegral(b - cx, r) - chordIntegral(a - cx, r)
		local upper = if upperIsCircle then cy * len + hInt else y1 * len
		local lower = if lowerIsCircle then cy * len - hInt else y0 * len
		area += upper - lower
	end
	return area
end

-- Sutherland-Hodgman clip of a polygon (flat list) against x >= k (sx = 1),
-- x <= k (sx = -1), y >= k (sy = 1) or y <= k (sy = -1).
local function clipAxis(pts: { number }, axis: number, k: number, sgn: number): { number }
	local out = {}
	local n = #pts // 2
	if n == 0 then
		return out
	end
	local px, py = pts[2 * n - 1], pts[2 * n]
	local pv = (if axis == 0 then px else py) * sgn - k * sgn
	for i = 1, n do
		local qx, qy = pts[2 * i - 1], pts[2 * i]
		local qv = (if axis == 0 then qx else qy) * sgn - k * sgn
		if qv >= 0 then
			if pv < 0 then
				local t = pv / (pv - qv)
				table.insert(out, px + (qx - px) * t)
				table.insert(out, py + (qy - py) * t)
			end
			table.insert(out, qx)
			table.insert(out, qy)
		elseif pv >= 0 then
			local t = pv / (pv - qv)
			table.insert(out, px + (qx - px) * t)
			table.insert(out, py + (qy - py) * t)
		end
		px, py, pv = qx, qy, qv
	end
	return out
end

local function shoelace(pts: { number }): number
	local n = #pts // 2
	local s = 0
	for i = 1, n do
		local j = if i == n then 1 else i + 1
		s += pts[2 * i - 1] * pts[2 * j] - pts[2 * j - 1] * pts[2 * i]
	end
	return s * 0.5
end
Coverage.shoelace = shoelace

-- Exact area of a simple polygon inside the square [x0, x0 + 1] x [y0, y0 + 1].
function Coverage.polygonArea(pts: { number }, x0: number, y0: number): number
	local p = clipAxis(pts, 0, x0, 1)
	p = clipAxis(p, 0, x0 + 1, -1)
	p = clipAxis(p, 1, y0, 1)
	p = clipAxis(p, 1, y0 + 1, -1)
	return abs(shoelace(p))
end

-- Fraction of n x n sample points (cell centres) for which inside(x, y) is true.
function Coverage.supersample(inside: (number, number) -> boolean, x0: number, y0: number, n: number): number
	local hits = 0
	local step = 1 / n
	for j = 0, n - 1 do
		local y = y0 + (j + 0.5) * step
		for i = 0, n - 1 do
			if inside(x0 + (i + 0.5) * step, y) then
				hits += 1
			end
		end
	end
	return hits / (n * n)
end

----------------------------------------------------------------------------------
-- Error study helpers (used by tests and bench; report in 1/255 units)
----------------------------------------------------------------------------------

export type ErrorStats = { max: number, mean: number, count: number, over1: number }

-- Compares estimator(px, py) with reference(px, py) over the pixels of a box,
-- counting only pixels where either value is strictly between 0 and 1 or they differ.
function Coverage.compare(
	x0: number,
	y0: number,
	x1: number,
	y1: number,
	estimator: (number, number) -> number,
	reference: (number, number) -> number
): ErrorStats
	local maxE, sum, count, over = 0, 0, 0, 0
	for y = y0, y1 do
		for x = x0, x1 do
			local r = reference(x, y)
			local e = estimator(x, y)
			if (r > 0 and r < 1) or (e > 0 and e < 1) or r ~= e then
				local err = abs(e - r) * 255
				if err > maxE then
					maxE = err
				end
				if err > 1 then
					over += 1
				end
				sum += err
				count += 1
			end
		end
	end
	return { max = maxE, mean = if count > 0 then sum / count else 0, count = count, over1 = over }
end

return Coverage
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Distance</string>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: compute/Distance
--
-- Distance transforms: turn a binary mask (buffer of u8, nonzero = feature) into a
-- field of squared Euclidean distances to the nearest feature pixel centre (buffer
-- of u32), and from there into signed distance fields, soft mattes, outlines and
-- glows. Three algorithms, measured against brute force in docs/COMPUTE.md 3.6:
--
--   edt     Felzenszwalb and Huttenlocher (2004) separable lower envelope of
--           parabolas. EXACT, O(pixels), two passes. The division that locates
--           parabola intersections is correctly rounded and can only misorder a
--           tie, where both parabolas give the same integer, so the output is the
--           exact integer squared distance (COMPUTE.md C8).
--   jfa     Jump flooding (Rong and Tan 2006): log2(n) passes of 9 probes. A GPU
--           algorithm; approximate and 5 to 10x slower than edt on a CPU.
--   ssedt8  8-point sequential signed EDT (Danielsson style, two raster sweeps
--           propagating offset vectors). Approximate, O(pixels).
--
-- Deterministic: integer arithmetic in doubles, comparisons, one correctly
-- rounded division per parabola test, sqrt only in the signed/matte helpers.

local Distance = {}

local INF = 2 ^ 40 -- larger than any squared distance on a 2^16 x 2^16 image

-- Squared distance from every pixel to the nearest feature pixel (exact).
function Distance.edt(mask: buffer, w: number, h: number, out: buffer?): buffer
	local res = out or buffer.create(w * h * 4)
	local g = buffer.create(w * h * 8) -- f64 squared vertical distances
	-- pass 1: columns, two sweeps, walked row by row (row-major memory order) with
	-- one "last feature row" per column
	local last = table.create(w, -1)
	for y = 0, h - 1 do
		local row = y * w
		for x = 0, w - 1 do
			local i = row + x
			if buffer.readu8(mask, i) ~= 0 then
				last[x + 1] = y
				buffer.writef64(g, i * 8, 0)
			else
				local l = last[x + 1]
				if l >= 0 then
					local d = y - l
					buffer.writef64(g, i * 8, d * d)
				else
					buffer.writef64(g, i * 8, INF)
				end
			end
		end
	end
	table.clear(last)
	for x = 1, w do
		last[x] = -1
	end
	for y = h - 1, 0, -1 do
		local row = y * w
		for x = 0, w - 1 do
			local i = row + x
			local cur = buffer.readf64(g, i * 8)
			if cur == 0 then
				last[x + 1] = y
			else
				local l = last[x + 1]
				if l >= 0 then
					local d = l - y
					local dd = d * d
					if dd < cur then
						buffer.writef64(g, i * 8, dd)
					end
				end
			end
		end
	end
	-- pass 2: rows, lower envelope of parabolas (x - q)^2 + f(q)
	local v = table.create(w + 1, 0) -- parabola apexes
	local z = table.create(w + 2, 0) -- envelope boundaries
	for y = 0, h - 1 do
		local row = y * w
		local k = 0 -- number of parabolas in the envelope
		for q = 0, w - 1 do
			local fq = buffer.readf64(g, (row + q) * 8)
			if fq >= INF then
				continue -- infinite parabola never reaches the envelope
			end
			local hq = fq + q * q
			if k == 0 then
				k = 1
				v[1] = q
				z[1] = -math.huge
				z[2] = math.huge
				continue
			end
			-- pop parabolas hidden by the new one; z[1] = -inf stops the loop
			local s
			while true do
				local p = v[k]
				local fp = buffer.readf64(g, (row + p) * 8)
				s = (hq - (fp + p * p)) / (2 * q - 2 * p)
				if s <= z[k] then
					k -= 1
				else
					break
				end
			end
			k += 1
			v[k] = q
			z[k] = s
			z[k + 1] = math.huge
		end
		if k == 0 then
			for x = 0, w - 1 do
				buffer.writeu32(res, (row + x) * 4, 0xFFFFFFFF)
			end
			continue
		end
		local j = 1
		for x = 0, w - 1 do
			while z[j + 1] < x do
				j += 1
			end
			local p = v[j]
			local dx = x - p
			buffer.writeu32(res, (row + x) * 4, dx * dx + buffer.readf64(g, (row + p) * 8))
		end
	end
	return res
end

-- Exact reference: every pixel against every feature pixel. O(pixels * features).
function Distance.brute(mask: buffer, w: number, h: number): buffer
	local res = buffer.create(w * h * 4)
	local fx, fy = {}, {}
	for y = 0, h - 1 do
		for x = 0, w - 1 do
			if buffer.readu8(mask, y * w + x) ~= 0 then
				table.insert(fx, x)
				table.insert(fy, y)
			end
		end
	end
	local n = #fx
	for y = 0, h - 1 do
		for x = 0, w - 1 do
			local best = 0xFFFFFFFF
			for i = 1, n do
				local dx, dy = x - fx[i], y - fy[i]
				local d = dx * dx + dy * dy
				if d < best then
					best = d
				end
			end
			buffer.writeu32(res, (y * w + x) * 4, best)
		end
	end
	return res
end

-- Jump flooding. Stores the nearest seed as an index + 1 (0 = none) in a u32
-- buffer, then converts to squared distances.
function Distance.jfa(mask: buffer, w: number, h: number, out: buffer?): buffer
	local res = out or buffer.create(w * h * 4)
	local a = buffer.create(w * h * 4)
	local b = buffer.create(w * h * 4)
	for i = 0, w * h - 1 do
		if buffer.readu8(mask, i) ~= 0 then
			buffer.writeu32(a, i * 4, i + 1)
		end
	end
	local step = 1
	while step * 2 < math.max(w, h) do
		step *= 2
	end
	local src, dst = a, b
	while step >= 1 do
		for y = 0, h - 1 do
			for x = 0, w - 1 do
				local i = y * w + x
				local best = buffer.readu32(src, i * 4)
				local bd = INF
				if best > 0 then
					local s = best - 1
					local dx, dy = x - s % w, y - s // w
					bd = dx * dx + dy * dy
				end
				for oy = -step, step, step do
					local yy = y + oy
					if yy < 0 or yy >= h then
						continue
					end
					for ox = -step, step, step do
						local xx = x + ox
						if xx < 0 or xx >= w or (ox == 0 and oy == 0) then
							continue
						end
						local c = buffer.readu32(src, (yy * w + xx) * 4)
						if c > 0 then
							local s = c - 1
							local dx, dy = x - s % w, y - s // w
							local d = dx * dx + dy * dy
							if d < bd then
								bd = d
								best = c
							end
						end
					end
				end
				buffer.writeu32(dst, i * 4, best)
			end
		end
		src, dst = dst, src
		step //= 2
	end
	for i = 0, w * h - 1 do
		local c = buffer.readu32(src, i * 4)
		if c == 0 then
			buffer.writeu32(res, i * 4, 0xFFFFFFFF)
		else
			local s = c - 1
			local x, y = i % w, i // w
			local dx, dy = x - s % w, y - s // w
			buffer.writeu32(res, i * 4, dx * dx + dy * dy)
		end
	end
	return res
end

-- 8-point sequential EDT: offset vectors (dx, dy) to the nearest feature found so
-- far, propagated by a forward and a backward raster sweep. Offsets stored as i16.
function Distance.ssedt8(mask: buffer, w: number, h: number, out: buffer?): buffer
	local res = out or buffer.create(w * h * 4)
	local FAR = 16000
	local ox = buffer.create(w * h * 2)
	local oy = buffer.create(w * h * 2)
	for i = 0, w * h - 1 do
		if buffer.readu8(mask, i) == 0 then
			buffer.writei16(ox, i * 2, FAR)
			buffer.writei16(oy, i * 2, FAR)
		end
	end
	local function relax(i: number, j: number, ddx: number, ddy: number)
		-- candidate: neighbour j's offset plus the step from j to i
		local cx = buffer.readi16(ox, j * 2) + ddx
		local cy = buffer.readi16(oy, j * 2) + ddy
		local px = buffer.readi16(ox, i * 2)
		local py = buffer.readi16(oy, i * 2)
		if cx * cx + cy * cy < px * px + py * py then
			buffer.writei16(ox, i * 2, cx)
			buffer.writei16(oy, i * 2, cy)
		end
	end
	for y = 0, h - 1 do
		for x = 0, w - 1 do
			local i = y * w + x
			if x > 0 then
				relax(i, i - 1, 1, 0)
			end
			if y > 0 then
				relax(i, i - w, 0, 1)
				if x > 0 then
					relax(i, i - w - 1, 1, 1)
				end
				if x < w - 1 then
					relax(i, i - w + 1, -1, 1)
				end
			end
		end
		for x = w - 2, 0, -1 do
			local i = y * w + x
			relax(i, i + 1, -1, 0)
		end
	end
	for y = h - 1, 0, -1 do
		for x = w - 1, 0, -1 do
			local i = y * w + x
			if x < w - 1 then
				relax(i, i + 1, -1, 0)
			end
			if y < h - 1 then
				relax(i, i + w, 0, -1)
				if x < w - 1 then
					relax(i, i + w + 1, -1, -1)
				end
				if x > 0 then
					relax(i, i + w - 1, 1, -1)
				end
			end
		end
		for x = 1, w - 1 do
			local i = y * w + x
			relax(i, i - 1, 1, 0)
		end
	end
	for i = 0, w * h - 1 do
		local dx, dy = buffer.readi16(ox, i * 2), buffer.readi16(oy, i * 2)
		if dx >= FAR then
			buffer.writeu32(res, i * 4, 0xFFFFFFFF)
		else
			buffer.writeu32(res, i * 4, dx * dx + dy * dy)
		end
	end
	return res
end

-- Signed distance (f32, pixels, positive outside) to the boundary between the
-- mask's pixel centres: d = dOut - 1/2 outside and -(dIn - 1/2) inside, where dOut
-- is the distance to the nearest inside centre and dIn to the nearest outside
-- centre. Exact for boundaries along pixel edges.
function Distance.signed(mask: buffer, w: number, h: number): buffer
	local inv = buffer.create(w * h)
	for i = 0, w * h - 1 do
		if buffer.readu8(mask, i) == 0 then
			buffer.writeu8(inv, i, 1)
		end
	end
	local dOut = Distance.edt(mask, w, h)
	local dIn = Distance.edt(inv, w, h)
	local sd = buffer.create(w * h * 4)
	local sqrt = math.sqrt
	for i = 0, w * h - 1 do
		local a = buffer.readu32(dOut, i * 4)
		if a > 0 then
			buffer.writef32(sd, i * 4, if a == 0xFFFFFFFF then 1e9 else sqrt(a) - 0.5)
		else
			local b = buffer.readu32(dIn, i * 4)
			buffer.writef32(sd, i * 4, if b == 0xFFFFFFFF then -1e9 else 0.5 - sqrt(b))
		end
	end
	return sd
end

-- Writes alpha from a signed distance field into an RGBA8 image (RGB kept):
-- alpha = 255 * clamp(1/2 - d / feather). feather = 1 gives a one-pixel
-- anti-aliased edge; larger values feather a background-removal matte.
-- Spans whose alpha is 0 or 255 still cost one pixel write each here; a shell
-- (band) version only touches |d| < feather.
function Distance.applyMatte(img: buffer, sd: buffer, count: number, feather: number)
	local inv = 1 / feather
	for i = 0, count - 1 do
		local d = buffer.readf32(sd, i * 4)
		local a = 0.5 - d * inv
		a = if a < 0 then 0 elseif a > 1 then 1 else a
		buffer.writeu8(img, i * 4 + 3, (a * 255 + 0.5) // 1)
	end
end

-- Onion shell: alpha of an outline band |d - centre| <= half (soft by 1/2 pixel on
-- each side), for outlines (centre 0) and glows (a ramp outside the shape).
function Distance.shellAlpha(d: number, centre: number, half: number): number
	local a = half + 0.5 - math.abs(d - centre)
	return if a < 0 then 0 elseif a > 1 then 1 else a
end

-- Glow: alpha falls off linearly from 1 at the shape edge to 0 at `radius` px.
function Distance.glowAlpha(d: number, radius: number): number
	if d <= 0 then
		return 1
	end
	local a = 1 - d / radius
	return if a < 0 then 0 else a
end

return Distance
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Expr</string>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: compute/Expr
--
-- One 2D signed-distance expression, evaluated four ways, to measure what the
-- evaluation strategy costs in Luau (docs/COMPUTE.md 4.1):
--
--   closure     a tree of closures, one call per node per pixel
--   ops         a flat op array (numbers in a table) run by a register machine,
--               one dispatch per node per pixel
--   opsRow      the same op array run column-at-a-time over a whole row: one
--               dispatch per node per ROW, the inner loop is pure arithmetic
--   source      Luau source text for a per-pixel function or a row kernel,
--               loaded with loadstring (server only in Roblox, LoadStringEnabled)
--               or emitted at build time as a ModuleScript
--
-- All four perform the same operations in the same order, so they return
-- bit-identical values (tests/compute.test.luau). The module also evaluates the
-- expression over a box in interval arithmetic (exact ranges for every node
-- here, because each op is monotone in each argument or handled piecewise), and
-- renders it through a quadtree classified by either intervals or a Lipschitz
-- bound (docs/COMPUTE.md 2.1 and 3.1).
--
-- Deterministic ops only: + - * / sqrt abs min max comparisons.

local MyMath = require("../MyMath")
local Pixels = require("../Pixels")

local Expr = {}

export type Node = {
	op: number,
	a: Node?,
	b: Node?,
	p1: number,
	p2: number,
	p3: number,
	p4: number,
}

local CIRCLE, BOX, MIN, MAX, SMIN, NEG, OFFSET, SHELL = 1, 2, 3, 4, 5, 6, 7, 8

local function leaf(op: number, p1: number, p2: number, p3: number, p4: number): Node
	return { op = op, p1 = p1, p2 = p2, p3 = p3, p4 = p4 }
end

local function node(op: number, a: Node, b: Node?, k: number?): Node
	return { op = op, a = a, b = b, p1 = k or 0, p2 = 0, p3 = 0, p4 = 0 }
end

function Expr.circle(cx: number, cy: number, r: number): Node
	return leaf(CIRCLE, cx, cy, r, 0)
end
-- Sharp axis-aligned box: centre (cx, cy), half extents (hx, hy).
function Expr.box(cx: number, cy: number, hx: number, hy: number): Node
	return leaf(BOX, cx, cy, hx, hy)
end
function Expr.union(a: Node, b: Node): Node
	return node(MIN, a, b)
end
function Expr.intersect(a: Node, b: Node): Node
	return node(MAX, a, b)
end
-- Polynomial smooth union (MyMath.smin, k > 0).
function Expr.smoothUnion(a: Node, b: Node, k: number): Node
	return node(SMIN, a, b, k)
end
function Expr.subtract(a: Node, b: Node): Node
	return node(MAX, a, node(NEG, b))
end
-- Rounding: a - r.
function Expr.offset(a: Node, r: number): Node
	return node(OFFSET, a, nil, r)
end
-- Onion shell (outline): |a| - t.
function Expr.shell(a: Node, t: number): Node
	return node(SHELL, a, nil, t)
end

-- Deterministic demo: n circles and boxes, smooth-unioned in pairs, unioned, with
-- one subtracted hole and an outline ring. About 3 n nodes.
function Expr.demo(n: number, size: number, seed: number): Node
	local hash = MyMath.hash32
	local h = hash(seed)
	local function rnd(): number
		h = hash((h + 0x9E3779B9) % 4294967296)
		return h / 4294967296
	end
	local acc: Node? = nil
	for i = 1, n do
		local cx, cy = ((rnd() * size * 16) // 1) / 16, ((rnd() * size * 16) // 1) / 16
		local r = ((4 + rnd() * size * 0.06) * 16 // 1) / 16
		local s: Node
		if i % 2 == 0 then
			s = Expr.circle(cx, cy, r)
		else
			s = Expr.offset(Expr.box(cx, cy, r, r * 0.6), r * 0.2)
		end
		if acc == nil then
			acc = s
		elseif i % 3 == 0 then
			acc = Expr.smoothUnion(acc :: Node, s, 6)
		else
			acc = Expr.union(acc :: Node, s)
		end
	end
	local root = acc :: Node
	root = Expr.subtract(root, Expr.circle(size * 0.5, size * 0.5, size * 0.08))
	return Expr.union(root, Expr.shell(Expr.circle(size * 0.5, size * 0.5, size * 0.3), 2))
end

----------------------------------------------------------------------------------
-- Shared scalar ops (also the reference semantics)
----------------------------------------------------------------------------------

local sqrt, abs = math.sqrt, math.abs

local function sdBox(px: number, py: number, cx: number, cy: number, hx: number, hy: number): number
	local qx = abs(px - cx) - hx
	local qy = abs(py - cy) - hy
	local ox = if qx > 0 then qx else 0
	local oy = if qy > 0 then qy else 0
	local inside = if qx > qy then qx else qy
	if inside > 0 then
		inside = 0
	end
	return sqrt(ox * ox + oy * oy) + inside
end

local function smin(a: number, b: number, k: number): number
	local hh = 0.5 + 0.5 * (b - a) / k
	hh = if hh < 0 then 0 elseif hh > 1 then 1 else hh
	return b + (a - b) * hh - k * hh * (1 - hh)
end

----------------------------------------------------------------------------------
-- 1. Closures
----------------------------------------------------------------------------------

function Expr.closure(n: Node): (number, number) -> number
	local op = n.op
	if op == CIRCLE then
		local cx, cy, r = n.p1, n.p2, n.p3
		return function(px: number, py: number): number
			local dx, dy = px - cx, py - cy
			return sqrt(dx * dx + dy * dy) - r
		end
	elseif op == BOX then
		local cx, cy, hx, hy = n.p1, n.p2, n.p3, n.p4
		return function(px: number, py: number): number
			return sdBox(px, py, cx, cy, hx, hy)
		end
	end
	local fa = Expr.closure(n.a :: Node)
	if op == NEG then
		return function(px: number, py: number): number
			return -fa(px, py)
		end
	elseif op == OFFSET then
		local k = n.p1
		return function(px: number, py: number): number
			return fa(px, py) - k
		end
	elseif op == SHELL then
		local k = n.p1
		return function(px: number, py: number): number
			return abs(fa(px, py)) - k
		end
	end
	local fb = Expr.closure(n.b :: Node)
	if op == MIN then
		return function(px: number, py: number): number
			local a, b = fa(px, py), fb(px, py)
			return if a < b then a else b
		end
	elseif op == MAX then
		return function(px: number, py: number): number
			local a, b = fa(px, py), fb(px, py)
			return if a > b then a else b
		end
	end
	local k = n.p1
	return function(px: number, py: number): number
		return smin(fa(px, py), fb(px, py), k)
	end
end

----------------------------------------------------------------------------------
-- 2. Flat op array: {op, dst, a, b, k, ...} with constants inline
----------------------------------------------------------------------------------

export type Program = { code: { number }, len: number, nregs: number, out: number }

-- Instruction layouts (all fields are numbers):
--   CIRCLE dst cx cy r        BOX dst cx cy hx hy       MIN/MAX dst a b
--   SMIN dst a b k            NEG dst a                 OFFSET/SHELL dst a k
function Expr.compile(root: Node): Program
	local code: { number } = {}
	local nregs = 0
	local function emit(n: Node): number
		local op = n.op
		local dst
		if op == CIRCLE then
			nregs += 1
			dst = nregs
			table.move({ CIRCLE, dst, n.p1, n.p2, n.p3 }, 1, 5, #code + 1, code)
		elseif op == BOX then
			nregs += 1
			dst = nregs
			table.move({ BOX, dst, n.p1, n.p2, n.p3, n.p4 }, 1, 6, #code + 1, code)
		elseif op == NEG or op == OFFSET or op == SHELL then
			local a = emit(n.a :: Node)
			nregs += 1
			dst = nregs
			if op == NEG then
				table.move({ NEG, dst, a }, 1, 3, #code + 1, code)
			else
				table.move({ op, dst, a, n.p1 }, 1, 4, #code + 1, code)
			end
		else
			local a = emit(n.a :: Node)
			local b = emit(n.b :: Node)
			nregs += 1
			dst = nregs
			if op == SMIN then
				table.move({ SMIN, dst, a, b, n.p1 }, 1, 5, #code + 1, code)
			else
				table.move({ op, dst, a, b }, 1, 4, #code + 1, code)
			end
		end
		return dst
	end
	local out = emit(root)
	return { code = code, len = #code, nregs = nregs, out = out }
end

-- Per-pixel register machine. regs: table with at least prog.nregs slots.
function Expr.run(prog: Program, regs: { number }, px: number, py: number): number
	local code, len = prog.code, prog.len
	local pc = 1
	while pc <= len do
		local op = code[pc]
		if op == CIRCLE then
			local dx, dy = px - code[pc + 2], py - code[pc + 3]
			regs[code[pc + 1]] = sqrt(dx * dx + dy * dy) - code[pc + 4]
			pc += 5
		elseif op == MIN then
			local a, b = regs[code[pc + 2]], regs[code[pc + 3]]
			regs[code[pc + 1]] = if a < b then a else b
			pc += 4
		elseif op == BOX then
			local qx = abs(px - code[pc + 2]) - code[pc + 4]
			local qy = abs(py - code[pc + 3]) - code[pc + 5]
			local ox = if qx > 0 then qx else 0
			local oy = if qy > 0 then qy else 0
			local inside = if qx > qy then qx else qy
			if inside > 0 then
				inside = 0
			end
			regs[code[pc + 1]] = sqrt(ox * ox + oy * oy) + inside
			pc += 6
		elseif op == SMIN then
			local a, b, k = regs[code[pc + 2]], regs[code[pc + 3]], code[pc + 4]
			local hh = 0.5 + 0.5 * (b - a) / k
			hh = if hh < 0 then 0 elseif hh > 1 then 1 else hh
			regs[code[pc + 1]] = b + (a - b) * hh - k * hh * (1 - hh)
			pc += 5
		elseif op == MAX then
			local a, b = regs[code[pc + 2]], regs[code[pc + 3]]
			regs[code[pc + 1]] = if a > b then a else b
			pc += 4
		elseif op == OFFSET then
			regs[code[pc + 1]] = regs[code[pc + 2]] - code[pc + 3]
			pc += 4
		elseif op == SHELL then
			regs[code[pc + 1]] = abs(regs[code[pc + 2]]) - code[pc + 3]
			pc += 4
		else -- NEG
			regs[code[pc + 1]] = -regs[code[pc + 2]]
			pc += 3
		end
	end
	return regs[prog.out]
end

-- Column-at-a-time: evaluates pixels x0 .. x0 + n - 1 of row y; each register is
-- an array of n values (rows: table of prog.nregs arrays). Returns the output array.
function Expr.runRow(prog: Program, rows: { { number } }, y: number, x0: number, n: number): { number }
	local code, len = prog.code, prog.len
	local py = y + 0.5
	local pc = 1
	while pc <= len do
		local op = code[pc]
		local D = rows[code[pc + 1]]
		if op == CIRCLE then
			local cx, cy, r = code[pc + 2], code[pc + 3], code[pc + 4]
			local dy = py - cy
			local dy2 = dy * dy
			for i = 1, n do
				local dx = x0 + i - 0.5 - cx
				D[i] = sqrt(dx * dx + dy2) - r
			end
			pc += 5
		elseif op == MIN or op == MAX then
			local A, B = rows[code[pc + 2]], rows[code[pc + 3]]
			if op == MIN then
				for i = 1, n do
					local a, b = A[i], B[i]
					D[i] = if a < b then a else b
				end
			else
				for i = 1, n do
					local a, b = A[i], B[i]
					D[i] = if a > b then a else b
				end
			end
			pc += 4
		elseif op == BOX then
			local cx, cy, hx, hy = code[pc + 2], code[pc + 3], code[pc + 4], code[pc + 5]
			local qy = abs(py - cy) - hy
			local oy = if qy > 0 then qy else 0
			local oy2 = oy * oy
			for i = 1, n do
				local qx = abs(x0 + i - 0.5 - cx) - hx
				local ox = if qx > 0 then qx else 0
				local inside = if qx > qy then qx else qy
				if inside > 0 then
					inside = 0
				end
				D[i] = sqrt(ox * ox + oy2) + inside
			end
			pc += 6
		elseif op == SMIN then
			local A, B, k = rows[code[pc + 2]], rows[code[pc + 3]], code[pc + 4]
			for i = 1, n do
				local a, b = A[i], B[i]
				local hh = 0.5 + 0.5 * (b - a) / k
				hh = if hh < 0 then 0 elseif hh > 1 then 1 else hh
				D[i] = b + (a - b) * hh - k * hh * (1 - hh)
			end
			pc += 5
		elseif op == OFFSET or op == SHELL then
			local A, k = rows[code[pc + 2]], code[pc + 3]
			if op == OFFSET then
				for i = 1, n do
					D[i] = A[i] - k
				end
			else
				for i = 1, n do
					D[i] = abs(A[i]) - k
				end
			end
			pc += 4
		else
			local A = rows[code[pc + 2]]
			for i = 1, n do
				D[i] = -A[i]
			end
			pc += 3
		end
	end
	return rows[prog.out]
end

function Expr.newRows(prog: Program, n: number): { { number } }
	local rows: { { number } } = {}
	for i = 1, prog.nregs do
		rows[i] = table.create(n, 0)
	end
	return rows
end

----------------------------------------------------------------------------------
-- 3. Generated source
----------------------------------------------------------------------------------

local function num(x: number): string
	return string.format("%.17g", x)
end

-- Statements computing every register r<i> from px, py (same op order as run).
local function emitBody(prog: Program, lines: { string })
	local code = prog.code
	local pc = 1
	while pc <= prog.len do
		local op = code[pc]
		local d = "r" .. code[pc + 1]
		if op == CIRCLE then
			table.insert(lines, string.format("local dx_%s, dy_%s = px - %s, py - %s", d, d, num(code[pc + 2]), num(code[pc + 3])))
			table.insert(lines, string.format("local %s = sqrt(dx_%s * dx_%s + dy_%s * dy_%s) - %s", d, d, d, d, d, num(code[pc + 4])))
			pc += 5
		elseif op == BOX then
			table.insert(lines, string.format("local qx_%s = abs(px - %s) - %s", d, num(code[pc + 2]), num(code[pc + 4])))
			table.insert(lines, string.format("local qy_%s = abs(py - %s) - %s", d, num(code[pc + 3]), num(code[pc + 5])))
			table.insert(lines, string.format("local ox_%s = if qx_%s > 0 then qx_%s else 0", d, d, d))
			table.insert(lines, string.format("local oy_%s = if qy_%s > 0 then qy_%s else 0", d, d, d))
			table.insert(lines, string.format("local in_%s = if qx_%s > qy_%s then qx_%s else qy_%s", d, d, d, d, d))
			table.insert(lines, string.format("if in_%s > 0 then in_%s = 0 end", d, d))
			table.insert(lines, string.format("local %s = sqrt(ox_%s * ox_%s + oy_%s * oy_%s) + in_%s", d, d, d, d, d, d))
			pc += 6
		elseif op == MIN or op == MAX then
			local a, b = "r" .. code[pc + 2], "r" .. code[pc + 3]
			table.insert(lines, string.format("local %s = if %s %s %s then %s else %s", d, a, if op == MIN then "<" else ">", b, a, b))
			pc += 4
		elseif op == SMIN then
			local a, b, k = "r" .. code[pc + 2], "r" .. code[pc + 3], num(code[pc + 4])
			table.insert(lines, string.format("local h_%s = 0.5 + 0.5 * (%s - %s) / %s", d, b, a, k))
			table.insert(lines, string.format("h_%s = if h_%s < 0 then 0 elseif h_%s > 1 then 1 else h_%s", d, d, d, d))
			table.insert(lines, string.format("local %s = %s + (%s - %s) * h_%s - %s * h_%s * (1 - h_%s)", d, b, a, b, d, k, d, d))
			pc += 5
		elseif op == OFFSET then
			table.insert(lines, string.format("local %s = r%d - %s", d, code[pc + 2], num(code[pc + 3])))
			pc += 4
		elseif op == SHELL then
			table.insert(lines, string.format("local %s = abs(r%d) - %s", d, code[pc + 2], num(code[pc + 3])))
			pc += 4
		else
			table.insert(lines, string.format("local %s = -r%d", d, code[pc + 2]))
			pc += 3
		end
	end
end

-- Source of `function(px, py) -> number`. Luau limits a function to 200 locals,
-- so large programs should use sourceRow's register-reuse-free form in chunks.
function Expr.source(prog: Program): string
	local lines = { "local sqrt, abs = math.sqrt, math.abs", "return function(px: number, py: number): number" }
	emitBody(prog, lines)
	table.insert(lines, "return r" .. prog.out)
	table.insert(lines, "end")
	return table.concat(lines, "\n")
end

-- Source of a row kernel `function(out: {number}, y, x0, n)` writing n values.
function Expr.sourceRow(prog: Program): string
	local lines = {
		"local sqrt, abs = math.sqrt, math.abs",
		"return function(out: {number}, y: number, x0: number, n: number)",
		"local py = y + 0.5",
		"for i = 1, n do",
		"local px = x0 + i - 0.5",
	}
	emitBody(prog, lines)
	table.insert(lines, "out[i] = r" .. prog.out)
	table.insert(lines, "end")
	table.insert(lines, "end")
	return table.concat(lines, "\n")
end

----------------------------------------------------------------------------------
-- 4. Interval arithmetic: range of the expression over [x0, x1] x [y0, y1]
----------------------------------------------------------------------------------

-- Range of t^2 for t in [a, b].
local function sqRange(a: number, b: number): (number, number)
	if a >= 0 then
		return a * a, b * b
	elseif b <= 0 then
		return b * b, a * a
	end
	local m = if -a > b then -a else b
	return 0, m * m
end

-- Range of |t| for t in [a, b].
local function absRange(a: number, b: number): (number, number)
	if a >= 0 then
		return a, b
	elseif b <= 0 then
		return -b, -a
	end
	return 0, if -a > b then -a else b
end

function Expr.interval(n: Node, x0: number, x1: number, y0: number, y1: number): (number, number)
	local op = n.op
	if op == CIRCLE then
		local ax, bx = sqRange(x0 - n.p1, x1 - n.p1)
		local ay, by = sqRange(y0 - n.p2, y1 - n.p2)
		return sqrt(ax + ay) - n.p3, sqrt(bx + by) - n.p3
	elseif op == BOX then
		-- the box SDF is non-decreasing in |px - cx| and |py - cy|, so its range is
		-- spanned by the nearest and farthest |offsets| per axis
		local qxa, qxb = absRange(x0 - n.p1, x1 - n.p1)
		local qya, qyb = absRange(y0 - n.p2, y1 - n.p2)
		return sdBox(qxa, qya, 0, 0, n.p3, n.p4), sdBox(qxb, qyb, 0, 0, n.p3, n.p4)
	end
	local alo, ahi = Expr.interval(n.a :: Node, x0, x1, y0, y1)
	if op == NEG then
		return -ahi, -alo
	elseif op == OFFSET then
		return alo - n.p1, ahi - n.p1
	elseif op == SHELL then
		local lo, hi = absRange(alo, ahi)
		return lo - n.p1, hi - n.p1
	end
	local blo, bhi = Expr.interval(n.b :: Node, x0, x1, y0, y1)
	if op == MIN then
		return (if alo < blo then alo else blo), (if ahi < bhi then ahi else bhi)
	elseif op == MAX then
		return (if alo > blo then alo else blo), (if ahi > bhi then ahi else bhi)
	end
	-- smin is non-decreasing in both arguments (partial derivatives h and 1 - h)
	return smin(alo, blo, n.p1), smin(ahi, bhi, n.p1)
end

----------------------------------------------------------------------------------
-- Quadtree rendering of the field's coverage (linear ramp, AA width 1)
----------------------------------------------------------------------------------

export type QuadStats = { nodes: number, shaded: number, filled: number }

-- Renders coverage alpha of field f into an RGBA8 buffer (colour rgb, alpha from
-- coverage) through a quadtree. classify = "interval" uses Expr.interval on the
-- node's pixel-centre box; "lipschitz" evaluates the centre and assumes |grad| <= L.
-- A node whose range lies entirely beyond +-1/2 gets one span fill. Leaves of
-- `leaf` pixels are shaded per pixel by `f` (any backend).
function Expr.renderQuad(
	root: Node,
	f: (number, number) -> number,
	classify: string,
	L: number,
	out: buffer,
	size: number,
	rgb: number,
	leaf: number
): QuadStats
	local st: QuadStats = { nodes = 0, shaded = 0, filled = 0 }
	local useInterval = classify == "interval"
	local function visit(x: number, y: number, s: number)
		st.nodes += 1
		local lo, hi
		if useInterval then
			lo, hi = Expr.interval(root, x + 0.5, x + s - 0.5, y + 0.5, y + s - 0.5)
		else
			local d = f(x + s * 0.5, y + s * 0.5)
			local reach = L * (s - 1) * 0.70710678118654757
			lo, hi = d - reach, d + reach
		end
		if lo >= 0.5 then
			Pixels.fillRect(out, size, x, y, s, s, rgb)
			st.filled += s * s
			return
		elseif hi <= -0.5 then
			Pixels.fillRect(out, size, x, y, s, s, rgb + 0xFF000000)
			st.filled += s * s
			return
		end
		if s <= leaf then
			st.shaded += s * s
			for yy = y, y + s - 1 do
				local o = (yy * size + x) * 4
				for xx = x, x + s - 1 do
					local c = 0.5 - f(xx + 0.5, yy + 0.5)
					c = if c < 0 then 0 elseif c > 1 then 1 else c
					buffer.writeu32(out, o, rgb + ((c * 255 + 0.5) // 1) * 16777216)
					o += 4
				end
			end
			return
		end
		local h = s // 2
		visit(x, y, h)
		visit(x + h, y, h)
		visit(x, y + h, h)
		visit(x + h, y + h, h)
	end
	visit(0, 0, size)
	return st
end

return Expr
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Filter</string>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: compute/Filter
--
-- Filters whose cost does not depend on their size, all exact in integer
-- arithmetic (docs/COMPUTE.md 3.5):
--
--   boxBlur        separable box blur of radius r by running sums: per pixel and
--                  pass, add the pixel entering the window and subtract the one
--                  leaving it. Sums of 8-bit channels are kept two to a number in
--                  16-bit lanes (SWAR, 0x00FF00FF masks), r <= 127. The result is
--                  round(sum / (2r + 1)) by integer floor division: identical to
--                  the brute-force average (tests/compute.test.luau).
--   satBuild       summed-area table, one u32 plane per channel (exact: totals stay
--                  below 2^32 for 1024 x 1024 x 255).
--   satResample    area-average resampling to ANY size through the table: the
--                  integral of a piecewise-constant image over a rectangle with
--                  fractional corners is the bilinear interpolation of the
--                  summed-area table. Any footprint in O(1) (variable blur, LOD).
--   areaResample   the reference resampler: exact area average at any ratio with
--                  integer weights and exact rational rounding, separable, about
--                  4x faster than satResample. Artifact-free downscaling for LOD:
--                  the exact (C9), flawless path for OPAQUE raster content.
--   areaResampleAlpha  the same for straight-alpha content: alpha-weighted
--                  (premultiplied) exact box filter, correctly rounded; equals
--                  areaResample byte for byte on opaque images.
--   normalMap      height field to tangent-space normal map by central differences.
--
-- Edges clamp to the border pixel. Deterministic ops only.

local Filter = {}

local band, rshift = bit32.band, bit32.rshift

-- One horizontal running-sum pass of radius r from src (w x h) into dst.
local function boxPassH(src: buffer, dst: buffer, w: number, h: number, r: number)
	local n = 2 * r + 1
	local half = r -- (sum + r) // n rounds half down; n is odd so ties never occur
	for y = 0, h - 1 do
		local row = y * w * 4
		local first = buffer.readu32(src, row)
		local lastPx = buffer.readu32(src, row + (w - 1) * 4)
		-- window for x = 0 covers [-r, r], clamped: (r + 1) copies of pixel 0 ...
		local rb = band(first, 0x00FF00FF) * (r + 1)
		local ga = band(rshift(first, 8), 0x00FF00FF) * (r + 1)
		for k = 1, r do
			local p = buffer.readu32(src, row + (if k < w then k else w - 1) * 4)
			rb += band(p, 0x00FF00FF)
			ga += band(rshift(p, 8), 0x00FF00FF)
		end
		for x = 0, w - 1 do
			local rr = rb % 65536
			local bb = rb // 65536
			local gg = ga % 65536
			local aa = ga // 65536
			buffer.writeu32(
				dst,
				row + x * 4,
				(rr + half) // n + ((gg + half) // n) * 256 + ((bb + half) // n) * 65536 + ((aa + half) // n) * 16777216
			)
			-- slide: add pixel x + r + 1, remove pixel x - r (both clamped)
			local inX = x + r + 1
			local outX = x - r
			local pin = if inX < w then buffer.readu32(src, row + inX * 4) else lastPx
			local pout = if outX > 0 then buffer.readu32(src, row + outX * 4) else first
			rb += band(pin, 0x00FF00FF) - band(pout, 0x00FF00FF)
			ga += band(rshift(pin, 8), 0x00FF00FF) - band(rshift(pout, 8), 0x00FF00FF)
		end
	end
end

-- Vertical pass, walked row by row with per-column lane sums (row-major access).
local function boxPassV(src: buffer, dst: buffer, w: number, h: number, r: number)
	local n = 2 * r + 1
	local half = r
	local RB = table.create(w, 0)
	local GA = table.create(w, 0)
	local stride = w * 4
	for x = 0, w - 1 do
		local p = buffer.readu32(src, x * 4)
		RB[x + 1] = band(p, 0x00FF00FF) * (r + 1)
		GA[x + 1] = band(rshift(p, 8), 0x00FF00FF) * (r + 1)
	end
	for k = 1, r do
		local yy = if k < h then k else h - 1
		for x = 0, w - 1 do
			local p = buffer.readu32(src, yy * stride + x * 4)
			RB[x + 1] += band(p, 0x00FF00FF)
			GA[x + 1] += band(rshift(p, 8), 0x00FF00FF)
		end
	end
	for y = 0, h - 1 do
		local inY = y + r + 1
		local outY = y - r
		local inRow = (if inY < h then inY else h - 1) * stride
		local outRow = (if outY > 0 then outY else 0) * stride
		local row = y * stride
		for x = 0, w - 1 do
			local rb, ga = RB[x + 1], GA[x + 1]
			local rr = rb % 65536
			local bb = rb // 65536
			local gg = ga % 65536
			local aa = ga // 65536
			buffer.writeu32(
				dst,
				row + x * 4,
				(rr + half) // n + ((gg + half) // n) * 256 + ((bb + half) // n) * 65536 + ((aa + half) // n) * 16777216
			)
			local pin = buffer.readu32(src, inRow + x * 4)
			local pout = buffer.readu32(src, outRow + x * 4)
			RB[x + 1] = rb + band(pin, 0x00FF00FF) - band(pout, 0x00FF00FF)
			GA[x + 1] = ga + band(rshift(pin, 8), 0x00FF00FF) - band(rshift(pout, 8), 0x00FF00FF)
		end
	end
end

-- Box blur of radius r (1 <= r <= 127), horizontal then vertical, rounding after
-- each pass (so it equals two rounded 1D box filters, not one 2D mean).
function Filter.boxBlur(src: buffer, w: number, h: number, r: number, dst: buffer?): buffer
	assert(r >= 1 and r <= 127, "radius must be 1..127 (16-bit lanes)")
	local tmp = buffer.create(w * h * 4)
	local out = dst or buffer.create(w * h * 4)
	boxPassH(src, tmp, w, h, r)
	boxPassV(tmp, out, w, h, r)
	return out
end

-- Brute-force reference with the same per-pass rounding (tests only).
function Filter.boxBlurBrute(src: buffer, w: number, h: number, r: number): buffer
	local n = 2 * r + 1
	local tmp = buffer.create(w * h * 4)
	local out = buffer.create(w * h * 4)
	for pass = 1, 2 do
		local a = if pass == 1 then src else tmp
		local b = if pass == 1 then tmp else out
		for y = 0, h - 1 do
			for x = 0, w - 1 do
				local s0, s1, s2, s3 = 0, 0, 0, 0
				for k = -r, r do
					local xx, yy = x, y
					if pass == 1 then
						xx = math.clamp(x + k, 0, w - 1)
					else
						yy = math.clamp(y + k, 0, h - 1)
					end
					local p = buffer.readu32(a, (yy * w + xx) * 4)
					s0 += p % 256
					s1 += (p // 256) % 256
					s2 += (p // 65536) % 256
					s3 += p // 16777216
				end
				buffer.writeu32(
					b,
					(y * w + x) * 4,
					(s0 + r) // n + ((s1 + r) // n) * 256 + ((s2 + r) // n) * 65536 + ((s3 + r) // n) * 16777216
				)
			end
		end
	end
	return out
end

export type SAT = { w: number, h: number, planes: { buffer } }

-- Summed-area table with a zero row and column: S(x, y) = sum of pixels [0, x) x [0, y).
-- One u32 plane per channel, (w + 1) x (h + 1).
function Filter.satBuild(src: buffer, w: number, h: number): SAT
	local W1 = w + 1
	local planes = {}
	for c = 1, 4 do
		planes[c] = buffer.create(W1 * (h + 1) * 4)
	end
	local P0, P1, P2, P3 = planes[1], planes[2], planes[3], planes[4]
	for y = 1, h do
		local s0, s1, s2, s3 = 0, 0, 0, 0
		local srow = (y - 1) * w * 4
		local o = y * W1 * 4 + 4
		local up = o - W1 * 4
		for x = 1, w do
			local p = buffer.readu32(src, srow + (x - 1) * 4)
			s0 += p % 256
			s1 += (p // 256) % 256
			s2 += (p // 65536) % 256
			s3 += p // 16777216
			buffer.writeu32(P0, o, s0 + buffer.readu32(P0, up))
			buffer.writeu32(P1, o, s1 + buffer.readu32(P1, up))
			buffer.writeu32(P2, o, s2 + buffer.readu32(P2, up))
			buffer.writeu32(P3, o, s3 + buffer.readu32(P3, up))
			o += 4
			up += 4
		end
	end
	return { w = w, h = h, planes = planes }
end

-- Integral of one channel over [0, x] x [0, y] for real x, y (bilinear in S).
local function integral(P: buffer, W1: number, x: number, y: number): number
	local ix, iy = x // 1, y // 1
	local fx, fy = x - ix, y - iy
	local o = (iy * W1 + ix) * 4
	local s00 = buffer.readu32(P, o)
	if fx == 0 and fy == 0 then
		return s00
	end
	local s10 = if fx > 0 then buffer.readu32(P, o + 4) else s00
	local s01 = if fy > 0 then buffer.readu32(P, o + W1 * 4) else s00
	local s11 = if fx > 0 and fy > 0 then buffer.readu32(P, o + W1 * 4 + 4) else (if fx > 0 then s10 else s01)
	local top = s00 + (s10 - s00) * fx
	local bot = s01 + (s11 - s01) * fx
	return top + (bot - top) * fy
end
Filter.integral = integral

-- Exact area-average resample of the SAT's image to dw x dh: output pixel (i, j)
-- is the mean over the source rectangle [i * sx, (i + 1) * sx) x [j * sy, (j + 1) * sy).
function Filter.satResample(sat: SAT, dw: number, dh: number, dst: buffer?): buffer
	local w, h = sat.w, sat.h
	local W1 = w + 1
	local out = dst or buffer.create(dw * dh * 4)
	local sx, sy = w / dw, h / dh
	local inv = 1 / (sx * sy)
	local P = sat.planes
	local o = 0
	for j = 0, dh - 1 do
		local y0, y1 = j * sy, (j + 1) * sy
		if y1 > h then
			y1 = h
		end
		for i = 0, dw - 1 do
			local x0, x1 = i * sx, (i + 1) * sx
			if x1 > w then
				x1 = w
			end
			local px = 0
			local mul = 1
			for c = 1, 4 do
				local pl = P[c]
				local s = integral(pl, W1, x1, y1) - integral(pl, W1, x0, y1) - integral(pl, W1, x1, y0) + integral(pl, W1, x0, y0)
				local v = (s * inv + 0.5) // 1
				v = if v < 0 then 0 elseif v > 255 then 255 else v
				px += v * mul
				mul *= 256
			end
			buffer.writeu32(out, o, px)
			o += 4
		end
	end
	return out
end

-- Overlap weights of output cells with source pixels, in units of 1/dn pixel so
-- they are integers: output cell i covers [i n, (i + 1) n) and source pixel k
-- covers [k dn, (k + 1) dn). Flat lists: first[i] = first source index, count[i],
-- weights in wts (each cell's weights sum to n).
local function areaWeights(n: number, dn: number): ({ number }, { number }, { number })
	local first, count, wts = table.create(dn, 0), table.create(dn, 0), {}
	for i = 0, dn - 1 do
		local a, b = i * n, (i + 1) * n
		local k0 = a // dn
		local k1 = (b - 1) // dn
		first[i + 1] = k0
		count[i + 1] = k1 - k0 + 1
		for k = k0, k1 do
			local lo = if a > k * dn then a else k * dn
			local hi = if b < (k + 1) * dn then b else (k + 1) * dn
			table.insert(wts, hi - lo)
		end
	end
	return first, count, wts
end

-- Exact area-average resample to dw x dh by two separable passes (the box
-- footprint is a product of an x and a y interval). Weights are integers (see
-- areaWeights), so every sum is an exact integer below 255 w h and the output is
-- round-half-up of the exact rational mean, (2 S + w h) // (2 w h): one fixed
-- answer on every platform and in every implementation (docs/COMPUTE.md C9).
-- Each pass only touches the ceil(scale) + 1 source pixels a footprint overlaps.
function Filter.areaResample(src: buffer, w: number, h: number, dw: number, dh: number, dst: buffer?): buffer
	local out = dst or buffer.create(dw * dh * 4)
	local fx, cx, wx = areaWeights(w, dw)
	local fy, cy, wy = areaWeights(h, dh)
	local mid = buffer.create(dw * h * 16) -- u32 x 4 channels, sums below 255 w
	for y = 0, h - 1 do
		local srow = y * w * 4
		local o = y * dw * 16
		local wi = 1
		for i = 1, dw do
			local s0, s1, s2, s3 = 0, 0, 0, 0
			local k = fx[i]
			for _ = 1, cx[i] do
				local p = buffer.readu32(src, srow + k * 4)
				local wt = wx[wi]
				s0 += (p % 256) * wt
				s1 += ((p // 256) % 256) * wt
				s2 += ((p // 65536) % 256) * wt
				s3 += (p // 16777216) * wt
				k += 1
				wi += 1
			end
			buffer.writeu32(mid, o, s0)
			buffer.writeu32(mid, o + 4, s1)
			buffer.writeu32(mid, o + 8, s2)
			buffer.writeu32(mid, o + 12, s3)
			o += 16
		end
	end
	local T = w * h
	local T2 = 2 * T
	local wj = 1
	for j = 1, dh do
		local orow = (j - 1) * dw * 4
		for i = 0, dw - 1 do
			local s0, s1, s2, s3 = 0, 0, 0, 0
			local k = fy[j]
			local wk = wj
			for _ = 1, cy[j] do
				local o = (k * dw + i) * 16
				local wt = wy[wk]
				s0 += buffer.readu32(mid, o) * wt
				s1 += buffer.readu32(mid, o + 4) * wt
				s2 += buffer.readu32(mid, o + 8) * wt
				s3 += buffer.readu32(mid, o + 12) * wt
				k += 1
				wk += 1
			end
			buffer.writeu32(
				out,
				orow + i * 4,
				(2 * s0 + T) // T2 + ((2 * s1 + T) // T2) * 256 + ((2 * s2 + T) // T2) * 65536 + ((2 * s3 + T) // T2) * 16777216
			)
		end
		wj += cy[j]
	end
	return out
end

-- Exact box filter of STRAIGHT-ALPHA content at any ratio: the area average of the
-- image's appearance, i.e. colours averaged with alpha weights (premultiplied), so
-- a transparent pixel's colour never tints the result. areaResample averages each
-- channel independently, which is the same thing only for opaque images (alpha
-- 255 everywhere: then both give identical bytes). Integer weights as in
-- areaResample: SA = sum of alpha * weight and SC = sum of colour * alpha * weight
-- are exact integers (below 255 * 255 * w * h < 2^53), the output alpha is
-- round-half-up of SA / (w h) and the output colour round-half-up of SC / SA (0
-- where SA = 0): the correctly rounded exact box filter, identical everywhere.
function Filter.areaResampleAlpha(src: buffer, w: number, h: number, dw: number, dh: number, dst: buffer?): buffer
	local out = dst or buffer.create(dw * dh * 4)
	local fx, cx, wx = areaWeights(w, dw)
	local fy, cy, wy = areaWeights(h, dh)
	local mid = buffer.create(dw * h * 16) -- u32 x 4: r*a, g*a, b*a, a sums (below 65025 w)
	for y = 0, h - 1 do
		local srow = y * w * 4
		local o = y * dw * 16
		local wi = 1
		for i = 1, dw do
			local s0, s1, s2, s3 = 0, 0, 0, 0
			local k = fx[i]
			for _ = 1, cx[i] do
				local p = buffer.readu32(src, srow + k * 4)
				local aw = (p // 16777216) * wx[wi]
				s0 += (p % 256) * aw
				s1 += ((p // 256) % 256) * aw
				s2 += ((p // 65536) % 256) * aw
				s3 += aw
				k += 1
				wi += 1
			end
			buffer.writeu32(mid, o, s0)
			buffer.writeu32(mid, o + 4, s1)
			buffer.writeu32(mid, o + 8, s2)
			buffer.writeu32(mid, o + 12, s3)
			o += 16
		end
	end
	local T = w * h
	local T2 = 2 * T
	local wj = 1
	for j = 1, dh do
		local orow = (j - 1) * dw * 4
		for i = 0, dw - 1 do
			local s0, s1, s2, s3 = 0, 0, 0, 0
			local k = fy[j]
			local wk = wj
			for _ = 1, cy[j] do
				local o = (k * dw + i) * 16
				local wt = wy[wk]
				s0 += buffer.readu32(mid, o) * wt
				s1 += buffer.readu32(mid, o + 4) * wt
				s2 += buffer.readu32(mid, o + 8) * wt
				s3 += buffer.readu32(mid, o + 12) * wt
				k += 1
				wk += 1
			end
			local px = 0
			if s3 > 0 then
				local d = 2 * s3
				px = (2 * s0 + s3) // d + ((2 * s1 + s3) // d) * 256 + ((2 * s2 + s3) // d) * 65536 + ((2 * s3 + T) // T2) * 16777216
			end
			buffer.writeu32(out, orow + i * 4, px)
		end
		wj += cy[j]
	end
	return out
end

-- Tangent-space normal map from a height field (u8 heights in a w x h buffer):
-- n = normalize(-s dh/dx, -s dh/dy, 1) by central differences (clamped at the
-- border), packed as RGB = round(127.5 + 127.5 n), alpha 255.
function Filter.normalMap(height: buffer, w: number, h: number, strength: number, dst: buffer?): buffer
	local out = dst or buffer.create(w * h * 4)
	local sqrt = math.sqrt
	local s = strength * 0.5 / 255
	for y = 0, h - 1 do
		local ym = if y > 0 then y - 1 else 0
		local yp = if y < h - 1 then y + 1 else h - 1
		for x = 0, w - 1 do
			local xm = if x > 0 then x - 1 else 0
			local xp = if x < w - 1 then x + 1 else w - 1
			local dx = (buffer.readu8(height, y * w + xp) - buffer.readu8(height, y * w + xm)) * s
			local dy = (buffer.readu8(height, yp * w + x) - buffer.readu8(height, ym * w + x)) * s
			local inv = 1 / sqrt(dx * dx + dy * dy + 1)
			local nx, ny, nz = -dx * inv, -dy * inv, inv
			buffer.writeu32(
				out,
				(y * w + x) * 4,
				((nx + 1) * 127.5 + 0.5) // 1 + (((ny + 1) * 127.5 + 0.5) // 1) * 256 + (((nz + 1) * 127.5 + 0.5) // 1) * 65536 + 0xFF000000
			)
		end
	end
	return out
end

return Filter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Raster</string>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: compute/Raster
--
-- Scene rasterizer for hundreds of anti-aliased 2D shapes (circles, rounded boxes,
-- capsules, rings, polygons, cut discs: half-discs and pie slices) composited
-- bottom to top with straight-alpha source-over. Three renderers share one
-- per-pixel shading routine:
--
--   renderBrute    every shape at every pixel (the reference)
--   renderPainter  every shape over its own bounding box, 8-bit read-modify-write
--                  (what an engine DrawCircle loop does; not bit-identical)
--   render         shape bins per 64 x 64 tile, then a Lipschitz quadtree per tile:
--                  shapes that cannot touch a node are dropped, the topmost opaque
--                  shape that covers a node entirely becomes its base and hides
--                  everything below, nodes whose remaining shapes all cover them
--                  entirely are filled with buffer.copy, and only leaves that an
--                  edge crosses are shaded per pixel.
--
-- render is pixel-identical to renderBrute by construction (docs/COMPUTE.md, C2):
-- a dropped shape has coverage exactly 0 at every pixel of the node, a base shape
-- has coverage exactly 1 and alpha 255, and the per-pixel arithmetic is the same
-- function with the same operand order (including the exact-visibility path below,
-- whose inputs are the same per-pixel stack in both renderers).
--
-- Coverage modes (docs/COMPUTE.md 3.3 and "Flawless pipeline"):
--   MODE_EXACT   (the DEFAULT) flawless. F1: every coverage is the exact area of
--                the pixel inside the shape: disc areas by quadrant integration
--                (circles, ring edges, rounded-box corners), products of 1D
--                overlaps (boxes), the exact capsule decomposition (body = pixel
--                clipped by the end lines and the strip sides; caps = disc and
--                pixel clipped by the end line), disc and clipped pixel (cut discs),
--                per-edge Green integrals (polygons, any number of edges per pixel).
--                F2: where two or more shapes' edges enter a pixel ("conflict
--                pixels") the composite is computed exactly instead of chaining
--                coverage as alpha, so abutting shapes leave no seam (C11): when
--                the partial shapes are pairwise disjoint (shared edges, chords)
--                as sum A_i X_i + (1 - sum A_i) X_0 (C19), otherwise with exact
--                visibility (compute/Visibility.luau, C18). Elsewhere coverage as
--                alpha is exact (C17). Culling reach is sqrt(2)/2 AA widths (C4).
--   MODE_LAYERED exact coverage (F1) composited as alpha everywhere: shows the
--                conflation seam at shared edges (kept for comparison and cost).
--   MODE_LINEAR  clamp(0.5 - d / aa, 0, 1), MyMath.coverage: the PREVIEW ramp.
--                Exact only on axis-aligned edges: up to 10.94/255 on a 45 degree
--                edge (C3), 38/255 at sharp box corners, 26 to 83/255 at star tips.
--
-- Deterministic ops only: + - * / sqrt abs floor, comparisons and the
-- deterministic arcsine Coverage.dasin (RUNTIME_AUDIT 6.5).

local Pixels = require("../Pixels")
local MyMath = require("../MyMath")
local Coverage = require("./Coverage")
local Visibility = require("./Visibility")

local Raster = {}

local CIRCLE, BOX, SEGMENT, RING, POLYGON, CUTDISC = 1, 2, 3, 4, 5, 6
Raster.CIRCLE, Raster.BOX, Raster.SEGMENT, Raster.RING, Raster.POLYGON = CIRCLE, BOX, SEGMENT, RING, POLYGON
Raster.CUTDISC = CUTDISC
local MODE_LINEAR, MODE_EXACT, MODE_LAYERED = 0, 1, 2
Raster.MODE_LINEAR, Raster.MODE_EXACT, Raster.MODE_LAYERED = MODE_LINEAR, MODE_EXACT, MODE_LAYERED

export type Scene = {
	n: number,
	kind: { number },
	p1: { number },
	p2: { number },
	p3: { number },
	p4: { number },
	p5: { number },
	p6: { number },
	cr: { number },
	cg: { number },
	cb: { number },
	ca: { number },
	bx0: { number },
	by0: { number },
	bx1: { number },
	by1: { number },
	verts: { number }, -- polygon vertices; cut-disc half-planes (n1x, n1y, o1, n2x, n2y, o2)
	aa: number, -- anti-aliasing (box filter) width in pixels
	mode: number, -- MODE_EXACT (default), MODE_LAYERED or MODE_LINEAR
	bgR: number,
	bgG: number,
	bgB: number,
	bgA: number, -- 0..1
}

export type Bins = {
	tile: number,
	tilesX: number,
	tilesY: number,
	lists: { { number } },
}

-- conflicts: pixels where two or more shapes' edges enter (exact visibility);
-- disjoint: those resolved by the disjoint fast path
export type Stats = { nodes: number, uniform: number, leaves: number, shaded: number, evals: number, conflicts: number, disjoint: number }

local stats: Stats = { nodes = 0, uniform = 0, leaves = 0, shaded = 0, evals = 0, conflicts = 0, disjoint = 0 }
Raster.stats = stats

function Raster.resetStats()
	stats.nodes, stats.uniform, stats.leaves, stats.shaded, stats.evals, stats.conflicts, stats.disjoint = 0, 0, 0, 0, 0, 0, 0
end

----------------------------------------------------------------------------------
-- Scene construction
----------------------------------------------------------------------------------

function Raster.newScene(background: number, aa: number?, mode: number?): Scene
	local r, g, b, a = MyMath.unpack(background)
	return {
		n = 0,
		kind = {},
		p1 = {},
		p2 = {},
		p3 = {},
		p4 = {},
		p5 = {},
		p6 = {},
		cr = {},
		cg = {},
		cb = {},
		ca = {},
		bx0 = {},
		by0 = {},
		bx1 = {},
		by1 = {},
		verts = {},
		aa = aa or 1,
		mode = mode or MODE_EXACT,
		bgR = r,
		bgG = g,
		bgB = b,
		bgA = a / 255,
	}
end

local function push(sc: Scene, kind: number, color: number, a: number, b: number, c: number, d: number, e: number, f: number): number
	local n = sc.n + 1
	sc.n = n
	sc.kind[n] = kind
	sc.p1[n], sc.p2[n], sc.p3[n], sc.p4[n], sc.p5[n], sc.p6[n] = a, b, c, d, e, f
	local r, g, bl, al = MyMath.unpack(color)
	sc.cr[n], sc.cg[n], sc.cb[n], sc.ca[n] = r, g, bl, al
	return n
end

-- Recomputes the conservative pixel bounding box of shape s (pixels whose centre
-- can have nonzero coverage).
local function updateBounds(sc: Scene, s: number)
	local k = sc.kind[s]
	-- coverage can be nonzero up to half an AA width (linear) or sqrt(2)/2 (exact)
	local h = sc.aa * (if sc.mode ~= MODE_LINEAR then 0.70710678118654757 else 0.5)
	local x0, y0, x1, y1 = 0, 0, 0, 0
	if k == CIRCLE or k == CUTDISC then
		local r = sc.p3[s] + h
		x0, y0, x1, y1 = sc.p1[s] - r, sc.p2[s] - r, sc.p1[s] + r, sc.p2[s] + r
	elseif k == BOX then
		x0, y0 = sc.p1[s] - sc.p3[s] - h, sc.p2[s] - sc.p4[s] - h
		x1, y1 = sc.p1[s] + sc.p3[s] + h, sc.p2[s] + sc.p4[s] + h
	elseif k == SEGMENT then
		local r = sc.p5[s] + h
		local ax, ay = sc.p1[s], sc.p2[s]
		local bx, by = ax + sc.p3[s], ay + sc.p4[s]
		x0, x1 = math.min(ax, bx) - r, math.max(ax, bx) + r
		y0, y1 = math.min(ay, by) - r, math.max(ay, by) + r
	elseif k == RING then
		local r = sc.p3[s] + sc.p4[s] + h
		x0, y0, x1, y1 = sc.p1[s] - r, sc.p2[s] - r, sc.p1[s] + r, sc.p2[s] + r
	else
		local v = sc.verts
		local first, count = sc.p1[s], sc.p2[s]
		x0, y0, x1, y1 = math.huge, math.huge, -math.huge, -math.huge
		for i = first, first + 2 * count - 2, 2 do
			local vx: number, vy: number = v[i], v[i + 1]
			if vx < x0 then
				x0 = vx
			end
			if vx > x1 then
				x1 = vx
			end
			if vy < y0 then
				y0 = vy
			end
			if vy > y1 then
				y1 = vy
			end
		end
		x0, y0, x1, y1 = x0 - h, y0 - h, x1 + h, y1 + h
	end
	-- pixel x has centre x + 0.5; keep every pixel whose centre lies in [x0, x1]
	sc.bx0[s] = math.floor(x0 - 0.5)
	sc.by0[s] = math.floor(y0 - 0.5)
	sc.bx1[s] = math.ceil(x1 - 0.5)
	sc.by1[s] = math.ceil(y1 - 0.5)
end
Raster.updateBounds = updateBounds

function Raster.circle(sc: Scene, color: number, cx: number, cy: number, r: number): number
	local s = push(sc, CIRCLE, color, cx, cy, r, 0, 0, 0)
	updateBounds(sc, s)
	return s
end

-- Axis-aligned box centred at (cx, cy), half extents (hx, hy), corner radius rad
-- (clamped to [0, min(hx, hy)], where the rounded-box SDF is exact).
function Raster.box(sc: Scene, color: number, cx: number, cy: number, hx: number, hy: number, rad: number): number
	local m = if hx < hy then hx else hy
	if rad > m then
		rad = m
	elseif rad < 0 then
		rad = 0
	end
	local s = push(sc, BOX, color, cx, cy, hx, hy, rad, 0)
	updateBounds(sc, s)
	return s
end

-- Capsule from (ax, ay) to (bx, by) with radius r.
function Raster.segment(sc: Scene, color: number, ax: number, ay: number, bx: number, by: number, r: number): number
	local dx, dy = bx - ax, by - ay
	local len2 = dx * dx + dy * dy
	local s = push(sc, SEGMENT, color, ax, ay, dx, dy, r, if len2 > 0 then 1 / len2 else 0)
	updateBounds(sc, s)
	return s
end

-- Annulus: |distance to centre - r| <= t.
function Raster.ring(sc: Scene, color: number, cx: number, cy: number, r: number, t: number): number
	local s = push(sc, RING, color, cx, cy, r, t, 0, 0)
	updateBounds(sc, s)
	return s
end

-- Polygon from flat {x1, y1, x2, y2, ...}; exact distance with the even-odd sign.
-- p3 holds the orientation (sign of the shoelace area). Exact coverage (F1, F2)
-- assumes a simple (non-self-intersecting) polygon.
function Raster.polygon(sc: Scene, color: number, pts: { number }): number
	local v = sc.verts
	local first = #v + 1
	for i = 1, #pts do
		v[first + i - 1] = pts[i]
	end
	local area = 0
	local n = #pts // 2
	local jx, jy = pts[2 * n - 1], pts[2 * n]
	for i = 1, n do
		local ix, iy = pts[2 * i - 1], pts[2 * i]
		area += jx * iy - ix * jy
		jx, jy = ix, iy
	end
	local sigma = if area >= 0 then 1 else -1
	-- p4 = 1 when convex (every turn agrees with the orientation): its edges are then
	-- bounding half-planes, which the exact-visibility fast path uses
	local convex = 1
	local ax, ay = pts[2 * n - 3], pts[2 * n - 2]
	local bx, by = pts[2 * n - 1], pts[2 * n]
	for i = 1, n do
		local cx, cy = pts[2 * i - 1], pts[2 * i]
		if sigma * ((bx - ax) * (cy - by) - (by - ay) * (cx - bx)) < 0 then
			convex = 0
			break
		end
		ax, ay, bx, by = bx, by, cx, cy
	end
	local s = push(sc, POLYGON, color, first, n, sigma, if n >= 3 then convex else 0, 0, 0)
	updateBounds(sc, s)
	return s
end

-- Cut disc: the disc (cx, cy, r) intersected with up to two half-planes
-- {q : n . (q - c) <= o}, normals (n1x, n1y) and (n2x, n2y) of unit length. With
-- one half-plane it is a circular segment (o = 0: a half-disc); with two through
-- the centre it is a pie slice. A convex primitive whose pieces abut exactly when
-- neighbours pass bit-identical normals with opposite signs (negation is exact).
function Raster.cutDisc(
	sc: Scene,
	color: number,
	cx: number,
	cy: number,
	r: number,
	n1x: number,
	n1y: number,
	o1: number,
	n2x: number?,
	n2y: number?,
	o2: number?
): number
	local v = sc.verts
	local first = #v + 1
	v[first], v[first + 1], v[first + 2] = n1x, n1y, o1
	if n2x and n2y then
		v[first + 3], v[first + 4], v[first + 5] = n2x, n2y, o2 or 0
	else
		-- no second half-plane: zero normal, always satisfied (its distance is -1e300)
		v[first + 3], v[first + 4], v[first + 5] = 0, 0, 1e300
	end
	local s = push(sc, CUTDISC, color, cx, cy, r, first, if n2x and n2y then 2 else 1, 0)
	updateBounds(sc, s)
	return s
end

-- Half-disc: the half of the disc on the side opposite to the unit vector (nx, ny),
-- {q : n . (q - c) <= 0}. Its partner is halfDisc with (-nx, -ny).
function Raster.halfDisc(sc: Scene, color: number, cx: number, cy: number, r: number, nx: number, ny: number): number
	return Raster.cutDisc(sc, color, cx, cy, r, nx, ny, 0)
end

-- Pie slice from the unit direction (ax, ay) to the unit direction (bx, by), turning
-- the way that takes x towards y (counter-clockwise in a y-up frame), at most half
-- a turn: {cross(a, q - c) >= 0} and {cross(q - c, b) >= 0}. Slices that share a
-- boundary direction (the same numbers) abut exactly.
function Raster.pie(sc: Scene, color: number, cx: number, cy: number, r: number, ax: number, ay: number, bx: number, by: number): number
	return Raster.cutDisc(sc, color, cx, cy, r, ay, -ax, 0, -by, bx, 0)
end

-- Moves shape s by (dx, dy) pixels.
function Raster.move(sc: Scene, s: number, dx: number, dy: number)
	local k = sc.kind[s]
	if k == POLYGON then
		local v = sc.verts
		for i = sc.p1[s], sc.p1[s] + 2 * sc.p2[s] - 2, 2 do
			v[i] += dx
			v[i + 1] += dy
		end
	else
		sc.p1[s] += dx
		sc.p2[s] += dy
	end
	updateBounds(sc, s)
end

-- A copy of the scene with every length multiplied by f, for rendering a level of
-- detail directly at its own resolution: the AA width stays one output pixel, so
-- every level is the exact box filter of the vector source at that level (F1/F2
-- hold per level; docs/COMPUTE.md "Flawless pipeline", LOD).
function Raster.scaled(sc: Scene, f: number): Scene
	local out = Raster.newScene(0, sc.aa, sc.mode)
	out.bgR, out.bgG, out.bgB, out.bgA = sc.bgR, sc.bgG, sc.bgB, sc.bgA
	for i = 1, #sc.verts do
		out.verts[i] = sc.verts[i]
	end
	for s = 1, sc.n do
		local k = sc.kind[s]
		out.n = s
		out.kind[s] = k
		out.cr[s], out.cg[s], out.cb[s], out.ca[s] = sc.cr[s], sc.cg[s], sc.cb[s], sc.ca[s]
		if k == POLYGON then
			out.p1[s], out.p2[s], out.p3[s], out.p4[s], out.p5[s], out.p6[s] = sc.p1[s], sc.p2[s], sc.p3[s], sc.p4[s], 0, 0
			local first = sc.p1[s]
			for i = first, first + 2 * sc.p2[s] - 1 do
				out.verts[i] = sc.verts[i] * f
			end
		elseif k == CUTDISC then
			out.p1[s], out.p2[s], out.p3[s], out.p4[s], out.p5[s], out.p6[s] = sc.p1[s] * f, sc.p2[s] * f, sc.p3[s] * f, sc.p4[s], sc.p5[s], 0
			local i = sc.p4[s]
			-- normals stay, offsets scale (the always-true second plane stays 1)
			out.verts[i + 2] = sc.verts[i + 2] * f
			if sc.p5[s] == 2 then
				out.verts[i + 5] = sc.verts[i + 5] * f
			end
		elseif k == SEGMENT then
			out.p1[s], out.p2[s], out.p3[s], out.p4[s], out.p5[s] = sc.p1[s] * f, sc.p2[s] * f, sc.p3[s] * f, sc.p4[s] * f, sc.p5[s] * f
			local len2 = out.p3[s] * out.p3[s] + out.p4[s] * out.p4[s]
			out.p6[s] = if len2 > 0 then 1 / len2 else 0
		else
			out.p1[s], out.p2[s], out.p3[s], out.p4[s], out.p5[s], out.p6[s] =
				sc.p1[s] * f, sc.p2[s] * f, sc.p3[s] * f, sc.p4[s] * f, sc.p5[s] * f, 0
		end
		updateBounds(out, s)
	end
	return out
end

-- Deterministic demo scene: n shapes on a size x size canvas. Mixes every kind,
-- radii from 2 to 60 px at 1024 (scaled with size), one in four translucent.
function Raster.demoScene(n: number, size: number, seed: number, background: number?, mode: number?): Scene
	local sc = Raster.newScene(background or 0xFF201810, 1, mode)
	local f = size / 1024
	local hash = MyMath.hash32
	local h = hash(seed)
	local function rnd(): number
		h = hash((h + 0x9E3779B9) % 4294967296)
		return h / 4294967296
	end
	for i = 1, n do
		local kind = 1 + (rnd() * 5) // 1
		-- quantise positions to 1/16 px so a scaled scene stays exact at power-of-two sizes
		local cx = ((rnd() * 1024 * 16) // 1) / 16 * f
		local cy = ((rnd() * 1024 * 16) // 1) / 16 * f
		local big = if i <= n // 16 then 4 else 1 -- a few large shapes give occlusion
		local r = (2 + rnd() * 58) * big * f
		local alpha = if rnd() < 0.25 then 96 + (rnd() * 150) // 1 else 255
		local color = ((rnd() * 0xFFFFFF) // 1) + alpha * 16777216
		if kind == CIRCLE then
			Raster.circle(sc, color, cx, cy, r)
		elseif kind == BOX then
			Raster.box(sc, color, cx, cy, r, r * (0.3 + rnd()), r * 0.25)
		elseif kind == SEGMENT then
			local ang = rnd()
			local len = r * 2
			Raster.segment(sc, color, cx, cy, cx + MyMath.dcosTurns(ang) * len, cy + MyMath.dsinTurns(ang) * len, 1 + r * 0.15)
		elseif kind == RING then
			Raster.ring(sc, color, cx, cy, r, 1 + r * 0.1)
		else
			-- five-point star
			local pts = table.create(20, 0)
			local rot = rnd()
			for k = 0, 9 do
				local rr = if k % 2 == 0 then r else r * 0.45
				local t = rot + k / 10
				pts[2 * k + 1] = cx + MyMath.dcosTurns(t) * rr
				pts[2 * k + 2] = cy + MyMath.dsinTurns(t) * rr
			end
			Raster.polygon(sc, color, pts)
		end
	end
	return sc
end

----------------------------------------------------------------------------------
-- Signed distance of shape s at (px, py); used for node classification.
-- The per-pixel paths in shadeRect and shadeExact inline the same formulas.
-- Every distance here is exact or a 1-Lipschitz bound that is exact inside (the
-- cut disc uses the max of its constraints), which classification relies on.
----------------------------------------------------------------------------------

local sqrt = math.sqrt
local abs = math.abs

local function sdf(sc: Scene, s: number, px: number, py: number): number
	local k = sc.kind[s]
	if k == CIRCLE then
		local dx, dy = px - sc.p1[s], py - sc.p2[s]
		return sqrt(dx * dx + dy * dy) - sc.p3[s]
	elseif k == BOX then
		local rad = sc.p5[s]
		local qx = abs(px - sc.p1[s]) - sc.p3[s] + rad
		local qy = abs(py - sc.p2[s]) - sc.p4[s] + rad
		local ox = if qx > 0 then qx else 0
		local oy = if qy > 0 then qy else 0
		local inside = if qx > qy then qx else qy
		if inside > 0 then
			inside = 0
		end
		return sqrt(ox * ox + oy * oy) + inside - rad
	elseif k == SEGMENT then
		local pax, pay = px - sc.p1[s], py - sc.p2[s]
		local bax, bay = sc.p3[s], sc.p4[s]
		local hh = (pax * bax + pay * bay) * sc.p6[s]
		hh = if hh < 0 then 0 elseif hh > 1 then 1 else hh
		local dx, dy = pax - bax * hh, pay - bay * hh
		return sqrt(dx * dx + dy * dy) - sc.p5[s]
	elseif k == RING then
		local dx, dy = px - sc.p1[s], py - sc.p2[s]
		return abs(sqrt(dx * dx + dy * dy) - sc.p3[s]) - sc.p4[s]
	elseif k == CUTDISC then
		local v = sc.verts
		local i = sc.p4[s]
		local dx, dy = px - sc.p1[s], py - sc.p2[s]
		local d = sqrt(dx * dx + dy * dy) - sc.p3[s]
		local h1 = v[i] * dx + v[i + 1] * dy - v[i + 2]
		local h2 = v[i + 3] * dx + v[i + 4] * dy - v[i + 5]
		if h1 > d then
			d = h1
		end
		if h2 > d then
			d = h2
		end
		return d
	else
		local v = sc.verts
		local first, count = sc.p1[s], sc.p2[s]
		local last = first + 2 * count - 2
		local dmin = math.huge
		local sign = 1
		local jx, jy = v[last], v[last + 1]
		for i = first, last, 2 do
			local vx, vy = v[i], v[i + 1]
			local ex, ey = jx - vx, jy - vy
			local wx, wy = px - vx, py - vy
			local ee = ex * ex + ey * ey
			local t = if ee > 0 then (wx * ex + wy * ey) / ee else 0
			t = if t < 0 then 0 elseif t > 1 then 1 else t
			local bx, by = wx - ex * t, wy - ey * t
			local dd = bx * bx + by * by
			if dd < dmin then
				dmin = dd
			end
			local c1 = py >= vy
			local c2 = py < jy
			local c3 = ex * wy > ey * wx
			if (c1 and c2 and c3) or (not c1 and not c2 and not c3) then
				sign = -sign
			end
			jx, jy = vx, vy
		end
		return sign * sqrt(dmin)
	end
end
Raster.sdf = sdf

----------------------------------------------------------------------------------
-- The shared per-pixel shading routine (MODE_LINEAR).
-- Shades pixels [x0, x1] x [y0, y1] with shapes list[lo..hi] (bottom to top),
-- starting from shape `base` (fully covering and opaque) or the background.
----------------------------------------------------------------------------------

local function shadeRect(
	sc: Scene,
	out: buffer,
	width: number,
	x0: number,
	y0: number,
	x1: number,
	y1: number,
	base: number,
	list: { number },
	lo: number,
	hi: number
)
	local K, P1, P2, P3, P4, P5, P6 = sc.kind, sc.p1, sc.p2, sc.p3, sc.p4, sc.p5, sc.p6
	local CR, CG, CB, CA = sc.cr, sc.cg, sc.cb, sc.ca
	local V = sc.verts
	local w = sc.aa
	local r0, g0, b0, a0
	if base > 0 then
		r0, g0, b0, a0 = CR[base], CG[base], CB[base], 1
	else
		r0, g0, b0, a0 = sc.bgR, sc.bgG, sc.bgB, sc.bgA
	end
	for y = y0, y1 do
		local py = y + 0.5
		local o = (y * width + x0) * 4
		for x = x0, x1 do
			local px = x + 0.5
			local ar, ag, ab, aa = r0, g0, b0, a0
			for j = lo, hi do
				local s = list[j]
				local k = K[s]
				local d
				if k == CIRCLE then
					local dx, dy = px - P1[s], py - P2[s]
					d = sqrt(dx * dx + dy * dy) - P3[s]
				elseif k == BOX then
					local rad = P5[s]
					local qx = abs(px - P1[s]) - P3[s] + rad
					local qy = abs(py - P2[s]) - P4[s] + rad
					local ox = if qx > 0 then qx else 0
					local oy = if qy > 0 then qy else 0
					local inside = if qx > qy then qx else qy
					if inside > 0 then
						inside = 0
					end
					d = sqrt(ox * ox + oy * oy) + inside - rad
				elseif k == SEGMENT then
					local pax, pay = px - P1[s], py - P2[s]
					local bax, bay = P3[s], P4[s]
					local hh = (pax * bax + pay * bay) * P6[s]
					hh = if hh < 0 then 0 elseif hh > 1 then 1 else hh
					local dx, dy = pax - bax * hh, pay - bay * hh
					d = sqrt(dx * dx + dy * dy) - P5[s]
				elseif k == RING then
					local dx, dy = px - P1[s], py - P2[s]
					d = abs(sqrt(dx * dx + dy * dy) - P3[s]) - P4[s]
				elseif k == CUTDISC then
					local i = P4[s]
					local dx, dy = px - P1[s], py - P2[s]
					d = sqrt(dx * dx + dy * dy) - P3[s]
					local h1 = V[i] * dx + V[i + 1] * dy - V[i + 2]
					local h2 = V[i + 3] * dx + V[i + 4] * dy - V[i + 5]
					if h1 > d then
						d = h1
					end
					if h2 > d then
						d = h2
					end
				else
					local first = P1[s]
					local last = first + 2 * P2[s] - 2
					local dmin = math.huge
					local sign = 1
					local jx, jy = V[last], V[last + 1]
					for i = first, last, 2 do
						local vx, vy = V[i], V[i + 1]
						local ex, ey = jx - vx, jy - vy
						local wx, wy = px - vx, py - vy
						local ee = ex * ex + ey * ey
						local t = if ee > 0 then (wx * ex + wy * ey) / ee else 0
						t = if t < 0 then 0 elseif t > 1 then 1 else t
						local bx, by = wx - ex * t, wy - ey * t
						local dd = bx * bx + by * by
						if dd < dmin then
							dmin = dd
						end
						local c1 = py >= vy
						local c2 = py < jy
						local c3 = ex * wy > ey * wx
						if (c1 and c2 and c3) or (not c1 and not c2 and not c3) then
							sign = -sign
						end
						jx, jy = vx, vy
					end
					d = sign * sqrt(dmin)
				end
				local cov = 0.5 - d / w
				if cov > 0 then
					local sa = (if cov < 1 then cov else 1) * CA[s] / 255
					if sa >= 1 then
						ar, ag, ab, aa = CR[s], CG[s], CB[s], 1
					else
						local da = aa * (1 - sa)
						local oa = sa + da
						ar = (CR[s] * sa + ar * da) / oa
						ag = (CG[s] * sa + ag * da) / oa
						ab = (CB[s] * sa + ab * da) / oa
						aa = oa
					end
				end
			end
			buffer.writeu32(
				out,
				o,
				(ar + 0.5) // 1 + ((ag + 0.5) // 1) * 256 + ((ab + 0.5) // 1) * 65536 + ((aa * 255 + 0.5) // 1) * 16777216
			)
			o += 4
		end
	end
end

----------------------------------------------------------------------------------
-- Exact-area coverage (MODE_EXACT, MODE_LAYERED): F1 for every primitive.
-- Coverage is exactly 0 for d >= REACH and exactly 1 for d <= -REACH (REACH =
-- sqrt(2) / 2 AA widths), which classify uses; in between it is the exact area of
-- the w x w pixel inside the shape, divided by w^2.
----------------------------------------------------------------------------------

local REACH = MyMath.COVERAGE_REACH

-- The curvature-corrected estimator (C5) is MyMath's axiom; kept as Raster.covCurved
-- for compute/Rows.luau. MODE_EXACT does not use it (its residual is O(1/R)).
local covCurved = MyMath.coverageCurved
Raster.covCurved = covCurved

local halfPlane = MyMath.coverageHalfPlane
local discBoxArea = Coverage.discBoxArea
local discPolyArea = Coverage.discPolyArea
local polyArea = Coverage.polyArea
local clipInto = Coverage.clipInto
local polygonBoxCoverage = Coverage.polygonBoxCoverage

-- scratch polygons (pixel-local coordinates, pixel = [-1/2, 1/2]^2)
local QX: { number } = table.create(64, 0)
local QY: { number } = table.create(64, 0)
local RX: { number } = table.create(64, 0)
local RY: { number } = table.create(64, 0)

local function squareQ()
	QX[1], QY[1] = -0.5, -0.5
	QX[2], QY[2] = 0.5, -0.5
	QX[3], QY[3] = 0.5, 0.5
	QX[4], QY[4] = -0.5, 0.5
end

-- Length of [a0, a1] intersected with [b0, b1].
local function overlap(a0: number, a1: number, b0: number, b1: number): number
	local lo = if a0 > b0 then a0 else b0
	local hi = if a1 < b1 then a1 else b1
	return if hi > lo then hi - lo else 0
end

-- Exact area of the pixel box [X0, X1] x [Y0, Y1] (relative to the box centre)
-- inside the rounded box with half extents (hx, hy) and corner radius rad. The
-- rounded box is the disjoint union of the vertical band |x| <= hx - rad, the two
-- side rectangles hx - rad <= |x| <= hx, |y| <= hy - rad, and four corner pieces
-- (corner disc and corner quadrant), each measured exactly.
local function boxArea(X0: number, X1: number, Y0: number, Y1: number, hx: number, hy: number, rad: number): number
	if rad <= 0 then
		return overlap(X0, X1, -hx, hx) * overlap(Y0, Y1, -hy, hy)
	end
	local ix, iy = hx - rad, hy - rad
	if Y0 >= -iy and Y1 <= iy then
		return overlap(X0, X1, -hx, hx) * (Y1 - Y0)
	end
	if X0 >= -ix and X1 <= ix then
		return (X1 - X0) * overlap(Y0, Y1, -hy, hy)
	end
	local area = overlap(X0, X1, -ix, ix) * overlap(Y0, Y1, -hy, hy)
		+ (overlap(X0, X1, ix, hx) + overlap(X0, X1, -hx, -ix)) * overlap(Y0, Y1, -iy, iy)
	local xr0 = if X0 > ix then X0 else ix
	local xr1 = if X1 < hx then X1 else hx
	local xl0 = if X0 > -hx then X0 else -hx
	local xl1 = if X1 < -ix then X1 else -ix
	local yp0 = if Y0 > iy then Y0 else iy
	local yp1 = if Y1 < hy then Y1 else hy
	local yn0 = if Y0 > -hy then Y0 else -hy
	local yn1 = if Y1 < -iy then Y1 else -iy
	if xr1 > xr0 then
		if yp1 > yp0 then
			area += discBoxArea(ix, iy, rad, xr0, yp0, xr1, yp1)
		end
		if yn1 > yn0 then
			area += discBoxArea(ix, -iy, rad, xr0, yn0, xr1, yn1)
		end
	end
	if xl1 > xl0 then
		if yp1 > yp0 then
			area += discBoxArea(-ix, iy, rad, xl0, yp0, xl1, yp1)
		end
		if yn1 > yn0 then
			area += discBoxArea(-ix, -iy, rad, xl0, yn0, xl1, yn1)
		end
	end
	return area
end

-- Exact coverage of the w x w pixel centred at (px, py) by the capsule from A to
-- A + D with radius r. The capsule is the disjoint union of the body (points whose
-- projection on the axis lies in [0, L], within r of the axis) and the two caps
-- (points beyond an end line, within r of that end point), so its area in the
-- pixel is |pixel ^ body| + |pixel ^ {h <= 0} ^ disc(A)| + |pixel ^ {h >= L} ^
-- disc(B)|: a clipped square, and two discs with a clipped square. A pixel whose
-- projection lies inside [0, L] sees only the two straight sides (C4, exact).
local function capsuleCoverage(px: number, py: number, w: number, ax: number, ay: number, ddx: number, ddy: number, r: number): number
	local iw = 1 / w
	local Ax, Ay = (ax - px) * iw, (ay - py) * iw
	local rw = r * iw
	local L2 = ddx * ddx + ddy * ddy
	if L2 == 0 then
		return discBoxArea(Ax, Ay, rw, -0.5, -0.5, 0.5, 0.5)
	end
	local L = sqrt(L2)
	local ex, ey = ddx / L, ddy / L
	local nx, ny = -ey, ex
	local Lw = L * iw
	local eA = Ax * ex + Ay * ey
	local nA = Ax * nx + Ay * ny
	local h = -eA -- pixel centre along the axis, from A
	local sN = -nA -- pixel centre across the axis
	local hr = 0.5 * (abs(ex) + abs(ey)) -- half extent of the pixel along the axis
	if h - hr >= 0 and h + hr <= Lw then
		local c = halfPlane(sN - rw, nx, ny) + halfPlane(-sN - rw, nx, ny) - 1
		return if c < 0 then 0 else c
	end
	local area = 0
	if h + hr > 0 and h - hr < Lw then
		squareQ()
		local m = clipInto(QX, QY, 4, RX, RY, -ex, -ey, -eA)
		m = clipInto(RX, RY, m, QX, QY, ex, ey, eA + Lw)
		m = clipInto(QX, QY, m, RX, RY, nx, ny, nA + rw)
		m = clipInto(RX, RY, m, QX, QY, -nx, -ny, rw - nA)
		area += polyArea(QX, QY, m)
	end
	if h - hr < 0 then
		if h + hr <= 0 then
			area += discBoxArea(Ax, Ay, rw, -0.5, -0.5, 0.5, 0.5)
		else
			squareQ()
			local m = clipInto(QX, QY, 4, RX, RY, ex, ey, eA)
			area += discPolyArea(RX, RY, m, Ax, Ay, rw)
		end
	end
	if h + hr > Lw then
		local Bx, By = Ax + ddx * iw, Ay + ddy * iw
		if h - hr >= Lw then
			area += discBoxArea(Bx, By, rw, -0.5, -0.5, 0.5, 0.5)
		else
			squareQ()
			local m = clipInto(QX, QY, 4, RX, RY, -ex, -ey, -(eA + Lw))
			area += discPolyArea(RX, RY, m, Bx, By, rw)
		end
	end
	return if area < 0 then 0 elseif area > 1 then 1 else area
end

-- Exact coverage of the pixel by a cut disc: the square clipped by the half-planes
-- that cross it, intersected with the disc (or the plain clipped square / the plain
-- disc where the other part covers the pixel). d1, d2, dd are the pixel centre's
-- signed distances (AA widths) to the two lines and the circle.
local function cutDiscCoverage(
	px: number,
	py: number,
	w: number,
	cx: number,
	cy: number,
	r: number,
	n1x: number,
	n1y: number,
	o1: number,
	n2x: number,
	n2y: number,
	o2: number,
	d1: number,
	d2: number,
	dd: number
): number
	local iw = 1 / w
	local Cx, Cy, rw = (cx - px) * iw, (cy - py) * iw, r * iw
	local need1 = d1 > -REACH
	local need2 = d2 > -REACH and (n2x ~= 0 or n2y ~= 0)
	local c
	if not need1 and not need2 then
		c = discBoxArea(Cx, Cy, rw, -0.5, -0.5, 0.5, 0.5)
	else
		squareQ()
		local X, Y, m = QX, QY, 4
		if need1 then
			m = clipInto(X, Y, m, RX, RY, n1x, n1y, o1 * iw + n1x * Cx + n1y * Cy)
			X, Y = RX, RY
		end
		if need2 then
			if X == QX then
				m = clipInto(QX, QY, m, RX, RY, n2x, n2y, o2 * iw + n2x * Cx + n2y * Cy)
				X, Y = RX, RY
			else
				m = clipInto(RX, RY, m, QX, QY, n2x, n2y, o2 * iw + n2x * Cx + n2y * Cy)
				X, Y = QX, QY
			end
		end
		if dd <= -REACH then
			c = polyArea(X, Y, m)
		else
			c = discPolyArea(X, Y, m, Cx, Cy, rw)
		end
	end
	return if c < 0 then 0 elseif c > 1 then 1 else c
end

----------------------------------------------------------------------------------
-- Pieces for exact visibility (F2): each shape's indicator inside the pixel as a
-- signed sum of convex pieces (pixel-local coordinates, pixel = [-1/2, 1/2]^2).
----------------------------------------------------------------------------------

local GX: { number } = table.create(64, 0)
local GY: { number } = table.create(64, 0)

local function addPieces(sc: Scene, s: number, px: number, py: number, w: number)
	local k = sc.kind[s]
	local iw = 1 / w
	local P1, P2, P3, P4, P5 = sc.p1, sc.p2, sc.p3, sc.p4, sc.p5
	if k == CIRCLE then
		Visibility.square(1)
		Visibility.disc((P1[s] - px) * iw, (P2[s] - py) * iw, P3[s] * iw)
		Visibility.piece()
	elseif k == RING then
		-- annulus = outer disc - inner disc; a disc that covers the whole pixel is
		-- the plain square, one that cannot reach it is left out
		local Cx, Cy = (P1[s] - px) * iw, (P2[s] - py) * iw
		local len = sqrt(Cx * Cx + Cy * Cy)
		local ro, ri = (P3[s] + P4[s]) * iw, (P3[s] - P4[s]) * iw
		Visibility.square(1)
		if len - ro > -REACH then
			Visibility.disc(Cx, Cy, ro)
		end
		Visibility.piece()
		if ri > 0 and len - ri < REACH then
			Visibility.square(-1)
			if len - ri > -REACH then
				Visibility.disc(Cx, Cy, ri)
			end
			Visibility.piece()
		end
	elseif k == BOX then
		local bx, by = (P1[s] - px) * iw, (P2[s] - py) * iw
		local hx, hy, rad = P3[s] * iw, P4[s] * iw, P5[s] * iw
		if rad <= 0 then
			Visibility.rect(1, bx - hx, by - hy, bx + hx, by + hy)
			Visibility.piece()
		else
			local ix, iy = hx - rad, hy - rad
			if ix > 0 then
				Visibility.rect(1, bx - ix, by - hy, bx + ix, by + hy)
				Visibility.piece()
			end
			if iy > 0 then
				Visibility.rect(1, bx - hx, by - iy, bx - ix, by + iy)
				Visibility.piece()
				Visibility.rect(1, bx + ix, by - iy, bx + hx, by + iy)
				Visibility.piece()
			end
			Visibility.rect(1, bx + ix, by + iy, bx + hx, by + hy)
			Visibility.disc(bx + ix, by + iy, rad)
			Visibility.piece()
			Visibility.rect(1, bx - hx, by + iy, bx - ix, by + hy)
			Visibility.disc(bx - ix, by + iy, rad)
			Visibility.piece()
			Visibility.rect(1, bx + ix, by - hy, bx + hx, by - iy)
			Visibility.disc(bx + ix, by - iy, rad)
			Visibility.piece()
			Visibility.rect(1, bx - hx, by - hy, bx - ix, by - iy)
			Visibility.disc(bx - ix, by - iy, rad)
			Visibility.piece()
		end
	elseif k == SEGMENT then
		local Ax, Ay = (P1[s] - px) * iw, (P2[s] - py) * iw
		local ddx, ddy, rw = P3[s] * iw, P4[s] * iw, P5[s] * iw
		local L2 = ddx * ddx + ddy * ddy
		if L2 == 0 then
			Visibility.square(1)
			Visibility.disc(Ax, Ay, rw)
			Visibility.piece()
		else
			local L = sqrt(L2)
			local ex, ey = ddx / L, ddy / L
			local nx, ny = -ey, ex
			local eA = Ax * ex + Ay * ey
			local nA = Ax * nx + Ay * ny
			Visibility.square(1)
			Visibility.clip(-ex, -ey, -eA)
			Visibility.clip(ex, ey, eA + L)
			Visibility.clip(nx, ny, nA + rw)
			Visibility.clip(-nx, -ny, rw - nA)
			Visibility.piece()
			Visibility.square(1)
			Visibility.clip(ex, ey, eA)
			Visibility.disc(Ax, Ay, rw)
			Visibility.piece()
			Visibility.square(1)
			Visibility.clip(-ex, -ey, -(eA + L))
			Visibility.disc(Ax + ddx, Ay + ddy, rw)
			Visibility.piece()
		end
	elseif k == CUTDISC then
		local V = sc.verts
		local i = P4[s]
		local Cx, Cy = (P1[s] - px) * iw, (P2[s] - py) * iw
		Visibility.square(1)
		Visibility.clip(V[i], V[i + 1], V[i + 2] * iw + V[i] * Cx + V[i + 1] * Cy)
		if P5[s] == 2 then
			Visibility.clip(V[i + 3], V[i + 4], V[i + 5] * iw + V[i + 3] * Cx + V[i + 4] * Cy)
		end
		Visibility.disc(Cx, Cy, P3[s] * iw)
		Visibility.piece()
	else
		-- polygon: clipped to the pixel by Visibility.polygon (one convex piece or a
		-- signed fan); p3 is the orientation, so the interior counts +1
		local V = sc.verts
		local first, count = P1[s], P2[s]
		for i = 1, count do
			GX[i] = (V[first + 2 * i - 2] - px) * iw
			GY[i] = (V[first + 2 * i - 1] - py) * iw
		end
		Visibility.polygon(GX, GY, count, P3[s])
	end
end
Raster.addPieces = addPieces

-- Per-pixel coverage of list[lo..hi], kept for the exact-visibility path.
local COV: { number } = table.create(512, 0)

----------------------------------------------------------------------------------
-- Disjoint fast path (F2). If the shapes whose edges enter a pixel are pairwise
-- disjoint (the usual seam: abutting tiles, mesh triangles, half-discs, pie slices),
-- the pixel splits into the regions R_i = shape_i ^ pixel, of exact areas A_i (the
-- F1 coverages), and the rest. Over R_i the shapes present are i and the shapes
-- covering the whole pixel; over the rest only the latter. So the exact composite
-- is sum_i A_i X_i + (1 - sum_i A_i) X_0, X_i the stack composite with shape i
-- (and every full cover) and X_0 without any partial shape. Disjointness is
-- decided exactly: a shape lies in the closed outer side of a bounding half-plane
-- of the other (sides of boxes and convex polygons, chords of cut discs), by its
-- support function (vertices, or centre minus radius) or by an exactly negated
-- half-plane (two half-discs sharing a diameter, neighbouring pie slices). Shared
-- vertices give exactly zero cross products, so shared edges separate.
----------------------------------------------------------------------------------

-- true if every point q of shape b satisfies n . (q - p) >= off. Differences are
-- taken before the dot product, so a vertex shared with the half-plane's edge
-- (q == p, or q - p == the edge vector) gives exactly 0, never a rounding sign.
local function outerSide(sc: Scene, b: number, nx: number, ny: number, px: number, py: number, off: number): boolean
	local k = sc.kind[b]
	local P1, P2, P3, P4, P5 = sc.p1, sc.p2, sc.p3, sc.p4, sc.p5
	if k == POLYGON then
		local V = sc.verts
		local first = P1[b]
		for i = first, first + 2 * P2[b] - 2, 2 do
			if nx * (V[i] - px) + ny * (V[i + 1] - py) < off then
				return false
			end
		end
		return true
	end
	local nn = sqrt(nx * nx + ny * ny)
	local cx, cy = P1[b] - px, P2[b] - py
	if k == CIRCLE then
		return nx * cx + ny * cy - P3[b] * nn >= off
	elseif k == RING then
		return nx * cx + ny * cy - (P3[b] + P4[b]) * nn >= off
	elseif k == BOX then
		-- the rounded box is its inner rectangle swept by a disc of radius rad
		local ix, iy = P3[b] - P5[b], P4[b] - P5[b]
		return nx * cx + ny * cy - abs(nx) * ix - abs(ny) * iy - P5[b] * nn >= off
	elseif k == SEGMENT then
		local ea = nx * cx + ny * cy
		local eb = nx * (cx + P3[b]) + ny * (cy + P4[b])
		return (if ea < eb then ea else eb) - P5[b] * nn >= off
	end
	-- cut disc: the exactly complementary half-plane of a cut disc with the same
	-- centre (a half-disc's partner, a neighbouring pie slice), or the disc outside
	local V = sc.verts
	local i = P4[b]
	if cx == 0 and cy == 0 then
		for h = 0, P5[b] - 1 do
			if V[i + 3 * h] == -nx and V[i + 3 * h + 1] == -ny and V[i + 3 * h + 2] == -off then
				return true
			end
		end
	end
	return nx * cx + ny * cy - P3[b] * nn >= off
end

-- true if b lies outside a bounding half-plane of a
local function separates(sc: Scene, a: number, b: number): boolean
	local k = sc.kind[a]
	local P1, P2, P3, P4, P5 = sc.p1, sc.p2, sc.p3, sc.p4, sc.p5
	if k == BOX then
		local cx, cy, hx, hy = P1[a], P2[a], P3[a], P4[a]
		return outerSide(sc, b, 1, 0, cx, cy, hx) or outerSide(sc, b, -1, 0, cx, cy, hx) or outerSide(sc, b, 0, 1, cx, cy, hy) or outerSide(sc, b, 0, -1, cx, cy, hy)
	elseif k == POLYGON then
		if P4[a] ~= 1 then
			return false
		end
		-- interior: sigma * cross(e, q - p) >= 0; outside: n . (q - p) >= 0 with
		-- n = sigma (ey, -ex)
		local V = sc.verts
		local sigma = P3[a]
		local first = P1[a]
		local last = first + 2 * P2[a] - 2
		local px, py = V[last], V[last + 1]
		for i = first, last, 2 do
			local qx, qy = V[i], V[i + 1]
			if outerSide(sc, b, sigma * (qy - py), -sigma * (qx - px), px, py, 0) then
				return true
			end
			px, py = qx, qy
		end
		return false
	elseif k == CUTDISC then
		-- half-plane n . (q - c) <= o: outside is n . (q - c) >= o
		local V = sc.verts
		local i = P4[a]
		for h = 0, P5[a] - 1 do
			if outerSide(sc, b, V[i + 3 * h], V[i + 3 * h + 1], P1[a], P2[a], V[i + 3 * h + 2]) then
				return true
			end
		end
		return false
	end
	return false
end

local FR: { number } = table.create(16, 0) -- list indices of the partial shapes
local XR: { number } = table.create(17, 0) -- premultiplied stack composites X_0..X_k
local XG: { number } = table.create(17, 0)
local XB: { number } = table.create(17, 0)
local XA: { number } = table.create(17, 0)
local MAX_DISJOINT = 8

-- The exact composite when the partial shapes of list[from..hi] are pairwise
-- disjoint; returns nil otherwise. Base: straight (br, bg, bb), alpha ba.
local function disjointComposite(
	sc: Scene,
	list: { number },
	lo: number,
	from: number,
	hi: number,
	br: number,
	bg: number,
	bb: number,
	ba: number
): (number?, number, number, number)
	local k = 0
	for j = from, hi do
		local c = COV[j - lo + 1]
		if c > 0 and c < 1 then
			k += 1
			if k > MAX_DISJOINT then
				return nil, 0, 0, 0
			end
			FR[k] = j
		end
	end
	for i = 1, k - 1 do
		local a = list[FR[i]]
		for j = i + 1, k do
			local b = list[FR[j]]
			if not (separates(sc, a, b) or separates(sc, b, a)) then
				return nil, 0, 0, 0
			end
		end
	end
	-- X_0 and X_1..X_k bottom-up: a partial shape starts its own composite (as if it
	-- covered the pixel), every full cover applies to all composites so far
	local CR, CG, CB, CA = sc.cr, sc.cg, sc.cb, sc.ca
	XR[1], XG[1], XB[1], XA[1] = br * ba, bg * ba, bb * ba, ba
	local n = 1
	local area = 0
	for j = from, hi do
		local c = COV[j - lo + 1]
		if c > 0 then
			local s = list[j]
			local a = CA[s] / 255
			local ia = 1 - a
			local r, g, b = CR[s] * a, CG[s] * a, CB[s] * a
			if c >= 1 then
				for m = 1, n do
					XR[m] = r + XR[m] * ia
					XG[m] = g + XG[m] * ia
					XB[m] = b + XB[m] * ia
					XA[m] = a + XA[m] * ia
				end
			else
				n += 1
				XR[n] = r + XR[1] * ia
				XG[n] = g + XG[1] * ia
				XB[n] = b + XB[1] * ia
				XA[n] = a + XA[1] * ia
				area += c
			end
		end
	end
	local rest = 1 - area
	if rest < 0 then
		rest = 0
	end
	local R, G, B, A = XR[1] * rest, XG[1] * rest, XB[1] * rest, XA[1] * rest
	local m = 1
	for j = from, hi do
		local c = COV[j - lo + 1]
		if c > 0 and c < 1 then
			m += 1
			R += XR[m] * c
			G += XG[m] * c
			B += XB[m] * c
			A += XA[m] * c
		end
	end
	if A <= 0 then
		return br, bg, bb, 0
	end
	return R / A, G / A, B / A, if A > 1 then 1 else A
end

-- Exact composite of the pixel (F2): shapes list[from..hi] above the base colour
-- (straight r, g, b, alpha a), with coverages COV[j - lo + 1]. Top-down.
local function resolve(
	sc: Scene,
	list: { number },
	lo: number,
	from: number,
	hi: number,
	px: number,
	py: number,
	w: number,
	br: number,
	bg: number,
	bb: number,
	ba: number
): (number, number, number, number)
	Visibility.reset()
	local CR, CG, CB, CA = sc.cr, sc.cg, sc.cb, sc.ca
	for j = hi, from, -1 do
		local cov = COV[j - lo + 1]
		if cov > 0 then
			local s = list[j]
			local a = CA[s] / 255
			if cov >= 1 then
				Visibility.full(CR[s], CG[s], CB[s], a)
			else
				Visibility.begin(CR[s], CG[s], CB[s], a, cov)
				addPieces(sc, s, px, py, w)
				Visibility.commit()
			end
		end
	end
	return Visibility.finish(br, bg, bb, ba)
end

local function shadeExact(
	sc: Scene,
	out: buffer,
	width: number,
	x0: number,
	y0: number,
	x1: number,
	y1: number,
	base: number,
	list: { number },
	lo: number,
	hi: number
)
	local K, P1, P2, P3, P4, P5, P6 = sc.kind, sc.p1, sc.p2, sc.p3, sc.p4, sc.p5, sc.p6
	local CR, CG, CB, CA = sc.cr, sc.cg, sc.cb, sc.ca
	local V = sc.verts
	local w = sc.aa
	local iw = 1 / w
	local iw2 = iw * iw
	local hw = w * 0.5
	local exactComposite = sc.mode == MODE_EXACT
	local r0, g0, b0, a0
	if base > 0 then
		r0, g0, b0, a0 = CR[base], CG[base], CB[base], 1
	else
		r0, g0, b0, a0 = sc.bgR, sc.bgG, sc.bgB, sc.bgA
	end
	for y = y0, y1 do
		local py = y + 0.5
		local o = (y * width + x0) * 4
		for x = x0, x1 do
			local px = x + 0.5
			local ar, ag, ab, aa = r0, g0, b0, a0
			local nf = 0 -- shapes with fractional coverage above the last opaque full one
			local reset = lo - 1 -- list index of the last opaque full shape (lo - 1: the base)
			for j = lo, hi do
				local s = list[j]
				local k = K[s]
				local cov
				if k == CIRCLE then
					local cx, cy = P1[s], P2[s]
					local dx, dy = px - cx, py - cy
					local r = P3[s]
					local d = (sqrt(dx * dx + dy * dy) - r) * iw
					if d >= REACH then
						cov = 0
					elseif d <= -REACH then
						cov = 1
					else
						cov = discBoxArea(cx, cy, r, px - hw, py - hw, px + hw, py + hw) * iw2
						cov = if cov > 1 then 1 else cov
					end
				elseif k == BOX then
					local rad = P5[s]
					local cx, cy, hx, hy = P1[s], P2[s], P3[s], P4[s]
					local qx = abs(px - cx) - hx + rad
					local qy = abs(py - cy) - hy + rad
					local ox = if qx > 0 then qx else 0
					local oy = if qy > 0 then qy else 0
					local inside = if qx > qy then qx else qy
					if inside > 0 then
						inside = 0
					end
					local d = (sqrt(ox * ox + oy * oy) + inside - rad) * iw
					if d >= REACH then
						cov = 0
					elseif d <= -REACH then
						cov = 1
					else
						local X0, X1, Y0, Y1 = px - hw - cx, px + hw - cx, py - hw - cy, py + hw - cy
						if Y0 >= rad - hy and Y1 <= hy - rad then
							-- inside the horizontal band: the box is locally the slab |x| <= hx
							local u0 = if X0 > -hx then X0 else -hx
							local u1 = if X1 < hx then X1 else hx
							cov = if u1 > u0 then (u1 - u0) * iw else 0
						elseif X0 >= rad - hx and X1 <= hx - rad then
							local u0 = if Y0 > -hy then Y0 else -hy
							local u1 = if Y1 < hy then Y1 else hy
							cov = if u1 > u0 then (u1 - u0) * iw else 0
						else
							cov = boxArea(X0, X1, Y0, Y1, hx, hy, rad) * iw2
						end
						cov = if cov > 1 then 1 else cov
					end
				elseif k == SEGMENT then
					local ax, ay = P1[s], P2[s]
					local pax, pay = px - ax, py - ay
					local bax, bay = P3[s], P4[s]
					local i2 = P6[s]
					local h0 = (pax * bax + pay * bay) * i2
					local hh = if h0 < 0 then 0 elseif h0 > 1 then 1 else h0
					local dx, dy = pax - bax * hh, pay - bay * hh
					local len = sqrt(dx * dx + dy * dy)
					local r = P5[s]
					local d = (len - r) * iw
					if d >= REACH then
						cov = 0
					elseif d <= -REACH then
						cov = 1
					else
						-- half extent of the pixel along the axis, in units of the segment
						local hr = hw * (abs(bax) + abs(bay)) * i2
						if i2 > 0 and h0 - hr >= 0 and h0 + hr <= 1 and len > 0 and r * iw >= REACH then
							-- the pixel sees one straight side only (C4, exact)
							cov = halfPlane(d, dx / len, dy / len)
						else
							cov = capsuleCoverage(px, py, w, ax, ay, bax, bay, r)
						end
					end
				elseif k == RING then
					local cx, cy = P1[s], P2[s]
					local dx, dy = px - cx, py - cy
					local len = sqrt(dx * dx + dy * dy)
					local r, t = P3[s], P4[s]
					local d = (abs(len - r) - t) * iw
					if d >= REACH then
						cov = 0
					elseif d <= -REACH then
						cov = 1
					else
						-- annulus = outer disc minus inner disc, each exact
						local ro = r + t
						local dOut = (len - ro) * iw
						local cOut
						if dOut >= REACH then
							cOut = 0
						elseif dOut <= -REACH then
							cOut = 1
						else
							cOut = discBoxArea(cx, cy, ro, px - hw, py - hw, px + hw, py + hw) * iw2
						end
						local ri = r - t
						local cIn = 0
						if ri > 0 then
							local dIn = (len - ri) * iw
							if dIn >= REACH then
								cIn = 0
							elseif dIn <= -REACH then
								cIn = 1
							else
								cIn = discBoxArea(cx, cy, ri, px - hw, py - hw, px + hw, py + hw) * iw2
							end
						end
						cov = cOut - cIn
						cov = if cov < 0 then 0 elseif cov > 1 then 1 else cov
					end
				elseif k == CUTDISC then
					local i = P4[s]
					local cx, cy, r = P1[s], P2[s], P3[s]
					local dx, dy = px - cx, py - cy
					local dd = (sqrt(dx * dx + dy * dy) - r) * iw
					local n1x, n1y, o1 = V[i], V[i + 1], V[i + 2]
					local n2x, n2y, o2 = V[i + 3], V[i + 4], V[i + 5]
					local d1 = (n1x * dx + n1y * dy - o1) * iw
					local d2 = (n2x * dx + n2y * dy - o2) * iw
					local d = dd
					if d1 > d then
						d = d1
					end
					if d2 > d then
						d = d2
					end
					if d >= REACH then
						cov = 0
					elseif d <= -REACH then
						cov = 1
					else
						cov = cutDiscCoverage(px, py, w, cx, cy, r, n1x, n1y, o1, n2x, n2y, o2, d1, d2, dd)
					end
				else
					local first = P1[s]
					local count = P2[s]
					local last = first + 2 * count - 2
					local dmin = math.huge
					local sign = 1
					local jx, jy = V[last], V[last + 1]
					for i = first, last, 2 do
						local vx, vy = V[i], V[i + 1]
						local ex, ey = jx - vx, jy - vy
						local wx, wy = px - vx, py - vy
						local ee = ex * ex + ey * ey
						local t = if ee > 0 then (wx * ex + wy * ey) / ee else 0
						t = if t < 0 then 0 elseif t > 1 then 1 else t
						local bx, by = wx - ex * t, wy - ey * t
						local dd = bx * bx + by * by
						if dd < dmin then
							dmin = dd
						end
						local c1 = py >= vy
						local c2 = py < jy
						local c3 = ex * wy > ey * wx
						if (c1 and c2 and c3) or (not c1 and not c2 and not c3) then
							sign = -sign
						end
						jx, jy = vx, vy
					end
					local d = sign * sqrt(dmin) * iw
					if d >= REACH then
						cov = 0
					elseif d <= -REACH then
						cov = 1
					else
						-- exact area by per-edge Green integrals (any number of edges)
						cov = -P3[s] * polygonBoxCoverage(V, first, count, px - hw, py - hw, w)
						cov = if cov < 0 then 0 elseif cov > 1 then 1 else cov
					end
				end
				COV[j - lo + 1] = cov
				if cov > 0 then
					local sa = cov * CA[s] / 255
					if sa >= 1 then
						ar, ag, ab, aa = CR[s], CG[s], CB[s], 1
						nf = 0
						reset = j
					else
						local da = aa * (1 - sa)
						local oa = sa + da
						ar = (CR[s] * sa + ar * da) / oa
						ag = (CG[s] * sa + ag * da) / oa
						ab = (CB[s] * sa + ab * da) / oa
						aa = oa
						if cov < 1 then
							nf += 1
						end
					end
				end
			end
			if nf >= 2 and exactComposite then
				-- two or more edges in this pixel: exact visibility (F2)
				stats.conflicts += 1
				local br, bgc, bb, ba
				if reset >= lo then
					local s = list[reset]
					br, bgc, bb, ba = CR[s], CG[s], CB[s], 1
				else
					br, bgc, bb, ba = r0, g0, b0, a0
				end
				local dr, dg, db, da = disjointComposite(sc, list, lo, reset + 1, hi, br, bgc, bb, ba)
				if dr then
					stats.disjoint += 1
					ar, ag, ab, aa = dr, dg, db, da
				else
					ar, ag, ab, aa = resolve(sc, list, lo, reset + 1, hi, px, py, w, br, bgc, bb, ba)
				end
			end
			buffer.writeu32(
				out,
				o,
				(ar + 0.5) // 1 + ((ag + 0.5) // 1) * 256 + ((ab + 0.5) // 1) * 65536 + ((aa * 255 + 0.5) // 1) * 16777216
			)
			o += 4
		end
	end
end

local function shade(
	sc: Scene,
	out: buffer,
	width: number,
	x0: number,
	y0: number,
	x1: number,
	y1: number,
	base: number,
	list: { number },
	lo: number,
	hi: number
)
	if sc.mode == MODE_LINEAR then
		shadeRect(sc, out, width, x0, y0, x1, y1, base, list, lo, hi)
	else
		shadeExact(sc, out, width, x0, y0, x1, y1, base, list, lo, hi)
	end
end

----------------------------------------------------------------------------------
-- Reference renderers
----------------------------------------------------------------------------------

-- Every shape at every pixel. rows: optional list of row indices to render (the
-- benchmark samples rows because the full frame takes seconds in the interpreter).
function Raster.renderBrute(sc: Scene, out: buffer, width: number, height: number, rows: { number }?)
	local list = table.create(sc.n, 0)
	for s = 1, sc.n do
		list[s] = s
	end
	if rows then
		for _, y in rows do
			shade(sc, out, width, 0, y, width - 1, y, 0, list, 1, sc.n)
		end
	else
		shade(sc, out, width, 0, 0, width - 1, height - 1, 0, list, 1, sc.n)
	end
end

-- Painter's algorithm over each shape's bounding box with an 8-bit framebuffer
-- (read, unpack, blend, pack, write per covered pixel). Fast to write, but it
-- rounds to 8 bits after every shape, so it is not identical to renderBrute.
-- Linear coverage only (it is the baseline an engine DrawCircle loop gives).
function Raster.renderPainter(sc: Scene, out: buffer, width: number, height: number)
	local bg = (sc.bgR // 1) + (sc.bgG // 1) * 256 + (sc.bgB // 1) * 65536 + ((sc.bgA * 255 + 0.5) // 1) * 16777216
	Pixels.fill(out, bg)
	for s = 1, sc.n do
		local x0, y0 = math.max(0, sc.bx0[s]), math.max(0, sc.by0[s])
		local x1, y1 = math.min(width - 1, sc.bx1[s]), math.min(height - 1, sc.by1[s])
		local cr, cg, cb, ca = sc.cr[s], sc.cg[s], sc.cb[s], sc.ca[s]
		local w = sc.aa
		for y = y0, y1 do
			local py = y + 0.5
			local o = (y * width + x0) * 4
			for x = x0, x1 do
				local d = sdf(sc, s, x + 0.5, py)
				local cov = 0.5 - d / w
				if cov > 0 then
					local sa = (if cov < 1 then cov else 1) * ca / 255
					local p = buffer.readu32(out, o)
					local ia = 1 - sa
					local r = cr * sa + (p % 256) * ia
					local g = cg * sa + ((p // 256) % 256) * ia
					local b = cb * sa + ((p // 65536) % 256) * ia
					local a = sa * 255 + (p // 16777216) * ia
					buffer.writeu32(out, o, (r + 0.5) // 1 + ((g + 0.5) // 1) * 256 + ((b + 0.5) // 1) * 65536 + ((a + 0.5) // 1) * 16777216)
				end
				o += 4
			end
		end
	end
end

----------------------------------------------------------------------------------
-- Shape binning
----------------------------------------------------------------------------------

function Raster.bin(sc: Scene, width: number, height: number, tile: number?): Bins
	local t = tile or 64
	local tilesX, tilesY = (width + t - 1) // t, (height + t - 1) // t
	local lists: { { number } } = {}
	for i = 1, tilesX * tilesY do
		lists[i] = {}
	end
	for s = 1, sc.n do
		local tx0 = math.max(0, sc.bx0[s] // t)
		local ty0 = math.max(0, sc.by0[s] // t)
		local tx1 = math.min(tilesX - 1, sc.bx1[s] // t)
		local ty1 = math.min(tilesY - 1, sc.by1[s] // t)
		for ty = ty0, ty1 do
			for tx = tx0, tx1 do
				table.insert(lists[ty * tilesX + tx + 1], s)
			end
		end
	end
	return { tile = t, tilesX = tilesX, tilesY = tilesY, lists = lists }
end

----------------------------------------------------------------------------------
-- Lipschitz quadtree over one tile
----------------------------------------------------------------------------------

local SQRT_HALF = 0.70710678118654757
local EPS = 1e-7 -- covers rounding in sdf evaluation (|error| < 1e-12 at 1024 px)

local stack: { number } = table.create(4096, 0)

-- Classifies list stack[lo..hi] against the node [x, x+size) x [y, y+size).
-- Pushes the surviving shapes above the topmost covering opaque shape onto the
-- stack and returns (newLo, newHi, base, uniform).
local function classify(sc: Scene, x: number, y: number, size: number, lo: number, hi: number, base: number): (number, number, number, boolean)
	local cx, cy = x + size * 0.5, y + size * 0.5
	local reach = (size - 1) * SQRT_HALF * (1 + 1e-12) -- half-diagonal to the farthest pixel centre
	-- coverage is exactly 0 / 1 beyond half an AA width (linear) or sqrt(2)/2 (exact)
	local half = sc.aa * (if sc.mode ~= MODE_LINEAR then SQRT_HALF else 0.5)
	local CA = sc.ca
	local top = hi
	local allFull = true
	local nb = base
	local n = 0
	for j = hi, lo, -1 do
		local s = stack[j]
		local d = sdf(sc, s, cx, cy)
		stats.evals += 1
		if d - reach > half + EPS then
			continue -- coverage exactly 0 at every pixel centre of the node
		end
		local full = d + reach < -half - EPS -- coverage exactly 1 at every pixel centre
		if full and CA[s] == 255 then
			nb = s -- hides every shape below it
			break
		end
		if not full then
			allFull = false
		end
		n += 1
		stack[top + n] = s
	end
	-- surviving shapes were pushed top-down; reverse into bottom-up order
	local newLo, newHi = top + 1, top + n
	local i, k = newLo, newHi
	while i < k do
		stack[i], stack[k] = stack[k], stack[i]
		i += 1
		k -= 1
	end
	return newLo, newHi, nb, allFull
end

local function fillNode(sc: Scene, out: buffer, width: number, x: number, y: number, w: number, h: number, base: number, lo: number, hi: number)
	-- every remaining shape covers the node fully: shade one pixel, copy it everywhere
	local c
	if lo > hi then
		-- nothing above the base: the colour is known without shading (the same value
		-- shadeRect produces, since channels are integers and alpha is exactly 1 or bgA)
		if base > 0 then
			c = sc.cr[base] + sc.cg[base] * 256 + sc.cb[base] * 65536 + 0xFF000000
		else
			c = (sc.bgR + 0.5) // 1 + ((sc.bgG + 0.5) // 1) * 256 + ((sc.bgB + 0.5) // 1) * 65536 + ((sc.bgA * 255 + 0.5) // 1) * 16777216
		end
	else
		shade(sc, out, width, x, y, x, y, base, stack, lo, hi)
		c = buffer.readu32(out, (y * width + x) * 4)
	end
	Pixels.fillRect(out, width, x, y, w, h, c)
end

local function node(
	sc: Scene,
	out: buffer,
	width: number,
	height: number,
	x: number,
	y: number,
	size: number,
	lo: number,
	hi: number,
	base: number,
	leaf: number
)
	stats.nodes += 1
	local nlo, nhi, nb, uniform = classify(sc, x, y, size, lo, hi, base)
	local w = math.min(size, width - x)
	local h = math.min(size, height - y)
	if uniform then
		stats.uniform += 1
		fillNode(sc, out, width, x, y, w, h, nb, nlo, nhi)
	elseif size <= leaf then
		stats.leaves += 1
		stats.shaded += w * h
		shade(sc, out, width, x, y, x + w - 1, y + h - 1, nb, stack, nlo, nhi)
	else
		local half = size // 2
		node(sc, out, width, height, x, y, half, nlo, nhi, nb, leaf)
		if x + half < width then
			node(sc, out, width, height, x + half, y, half, nlo, nhi, nb, leaf)
		end
		if y + half < height then
			node(sc, out, width, height, x, y + half, half, nlo, nhi, nb, leaf)
			if x + half < width then
				node(sc, out, width, height, x + half, y + half, half, nlo, nhi, nb, leaf)
			end
		end
	end
end

-- Renders tiles [tx0, tx1] x [ty0, ty1] of the bins (all tiles by default).
-- leaf: smallest node edge that is shaded per pixel (default 8; power of two).
function Raster.render(
	sc: Scene,
	bins: Bins,
	out: buffer,
	width: number,
	height: number,
	leaf: number?,
	tx0: number?,
	ty0: number?,
	tx1: number?,
	ty1: number?
)
	local lf = leaf or 8
	local t = bins.tile
	for ty = ty0 or 0, ty1 or bins.tilesY - 1 do
		for tx = tx0 or 0, tx1 or bins.tilesX - 1 do
			local list = bins.lists[ty * bins.tilesX + tx + 1]
			local n = #list
			for i = 1, n do
				stack[i] = list[i]
			end
			node(sc, out, width, height, tx * t, ty * t, t, 1, n, 0, lf)
		end
	end
end

-- Re-renders after shapes changed: every tile touched by any of the pixel
-- rectangles {x0, y0, x1, y1} (old and new bounds of moved shapes). Returns the
-- number of tiles rendered.
function Raster.renderDirty(sc: Scene, bins: Bins, out: buffer, width: number, height: number, rects: { { number } }, leaf: number?): number
	local t = bins.tile
	local seen: { [number]: boolean } = {}
	local count = 0
	for _, r in rects do
		local tx0 = math.max(0, r[1] // t)
		local ty0 = math.max(0, r[2] // t)
		local tx1 = math.min(bins.tilesX - 1, r[3] // t)
		local ty1 = math.min(bins.tilesY - 1, r[4] // t)
		for ty = ty0, ty1 do
			for tx = tx0, tx1 do
				local key = ty * bins.tilesX + tx
				if not seen[key] then
					seen[key] = true
					count += 1
					Raster.render(sc, bins, out, width, height, leaf, tx, ty, tx, ty)
				end
			end
		end
	end
	return count
end

-- Time-sliced rendering: renders tiles in the given order until os.clock() passes
-- the deadline. Returns the index of the next tile to render (order length + 1
-- when finished). order holds 0-based tile indices (ty * tilesX + tx).
function Raster.renderUntil(sc: Scene, bins: Bins, out: buffer, width: number, height: number, order: { number }, from: number, deadline: number, leaf: number?): number
	local i = from
	local clock = os.clock
	while i <= #order do
		local k = order[i]
		local tx, ty = k % bins.tilesX, k // bins.tilesX
		Raster.render(sc, bins, out, width, height, leaf, tx, ty, tx, ty)
		i += 1
		if clock() >= deadline then
			break
		end
	end
	return i
end

return Raster
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">Rows</string>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: compute/Rows
--
-- Batch row kernels (docs/COMPUTE.md 3.4 and 4.2): one exact-coverage disc, one
-- row at a time, three ways that write identical bytes:
--
--   direct   per pixel: e = dx^2 + dy^2, d = sqrt(e) - r, exact coverage
--   fd       forward differencing: e(x + 1) = e(x) + (2 dx + 1), so the square is
--            replaced by two additions. With the centre on a 1/16 grid every
--            value is a multiple of 1/256 below 2^45, so the additions are exact
--            and e is bit-identical to the direct square (C7).
--   spans    analytic spans: per row, the x-interval where the pixel can be
--            partly covered is solved from e = (r +- reach)^2; pixels well
--            inside are one span fill (buffer.copy doubling), pixels well
--            outside another, and only the band in between is shaded with the
--            same per-pixel formula. Cost per row: O(band), not O(width).
--
-- Output: straight-alpha RGBA8, colour rgb, alpha = round(255 * coverage).

local Pixels = require("../Pixels")
local Raster = require("./Raster")

local Rows = {}

local covCurved = Raster.covCurved
local sqrt = math.sqrt
local REACH = 0.70710678118654757

local function shadePixel(dx: number, dy: number, e: number, r: number, k: number): number
	local len = sqrt(e)
	if len > 0 then
		return covCurved(len - r, dx / len, dy / len, k)
	end
	return covCurved(-r, 1, 0, 0)
end

function Rows.circleDirect(out: buffer, width: number, y: number, cx: number, cy: number, r: number, rgb: number)
	local dy = y + 0.5 - cy
	local k = 1 / r
	local o = y * width * 4
	for x = 0, width - 1 do
		local dx = x + 0.5 - cx
		local e = dx * dx + dy * dy
		local c = shadePixel(dx, dy, e, r, k)
		buffer.writeu32(out, o, rgb + ((c * 255 + 0.5) // 1) * 16777216)
		o += 4
	end
end

function Rows.circleFD(out: buffer, width: number, y: number, cx: number, cy: number, r: number, rgb: number)
	local dy = y + 0.5 - cy
	local k = 1 / r
	local o = y * width * 4
	local dx = 0.5 - cx
	local e = dx * dx + dy * dy
	for _ = 0, width - 1 do
		local c = shadePixel(dx, dy, e, r, k)
		buffer.writeu32(out, o, rgb + ((c * 255 + 0.5) // 1) * 16777216)
		o += 4
		e += 2 * dx + 1 -- (dx + 1)^2 - dx^2
		dx += 1
	end
end

-- Returns the number of pixels shaded one by one.
function Rows.circleSpans(out: buffer, width: number, y: number, cx: number, cy: number, r: number, rgb: number): number
	local dy = y + 0.5 - cy
	local k = 1 / r
	local row = y * width * 4
	local ro = r + REACH
	local ro2 = ro * ro - dy * dy
	if ro2 <= 0 then
		Pixels.fillSpan(out, row, width, rgb) -- whole row outside the band
		return 0
	end
	-- pixel centres x + 0.5 with |x + 0.5 - cx| < hwOuter can be partly covered;
	-- widen by one pixel so the per-pixel formula, not the solve, decides edges
	local hwOuter = sqrt(ro2)
	local xa = math.max(0, math.floor(cx - hwOuter - 0.5) - 1)
	local xb = math.min(width - 1, math.ceil(cx + hwOuter - 0.5) + 1)
	local ri = r - REACH
	local ia, ib = xb + 1, xb -- empty interior unless the row crosses the inner disc
	if ri > 0 and ri * ri - dy * dy > 0 then
		local hwInner = sqrt(ri * ri - dy * dy)
		ia = math.ceil(cx - hwInner - 0.5) + 1
		ib = math.floor(cx + hwInner - 0.5) - 1
		if ia < xa then
			ia = xa
		end
		if ib > xb then
			ib = xb
		end
	end
	Pixels.fillSpan(out, row, xa, rgb)
	Pixels.fillSpan(out, row + (xb + 1) * 4, width - 1 - xb, rgb)
	local shaded = 0
	local function band(x0: number, x1: number)
		local o = row + x0 * 4
		for x = x0, x1 do
			local dx = x + 0.5 - cx
			local c = shadePixel(dx, dy, dx * dx + dy * dy, r, k)
			buffer.writeu32(out, o, rgb + ((c * 255 + 0.5) // 1) * 16777216)
			o += 4
		end
		shaded += x1 - x0 + 1
	end
	if ia <= ib then
		band(xa, ia - 1)
		Pixels.fillSpan(out, row + ia * 4, ib - ia + 1, rgb + 0xFF000000)
		band(ib + 1, xb)
	else
		band(xa, xb)
	end
	return shaded
end

return Rows
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Scanline</string>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: compute/Scanline
--
-- Exact-area polygon rasterizer by signed-area accumulation (the method of
-- R. Levien's font-rs). Every edge deposits, into the cells it crosses, the signed
-- area between itself and the right edge of the row; a running sum along the row
-- then gives the exact box-filtered coverage of every pixel. Cost is proportional
-- to the perimeter (cells crossed), not the area: between touched cells the running
-- sum is constant, so those spans are filled with buffer.copy (RUNTIME_AUDIT 6.7.3).
--
-- Fill rule: non-zero, coverage = min(1, |winding area|), which is the exact area
-- for paths whose winding number is 0 or +-1 everywhere (simple, non-overlapping
-- contours; holes wound the other way). Curves are flattened to line segments with
-- a sagitta tolerance (flattenEllipse), whose area error per pixel is at most about
-- 1.5 times the tolerance (that is the polygon's distance from the curve; the
-- polygon itself is rendered exactly).
--
-- Single path versus scenes (docs/COMPUTE.md F2, C11):
--   resolve, composite   one path. Exact (F1): the byte is the correctly rounded
--                        coverage, composited once over the destination.
--                        Painting a multi-path scene by calling composite per path
--                        is NOT exact: shared edges conflate (a 64/255 seam) and
--                        translucent layers round to 8 bits after every path.
--   renderScene          many paths, exact (F2): rows are processed top to bottom;
--                        each path's coverage comes from a one-row accumulator, is
--                        composited in floating point where the byte would be
--                        inexact (edges, translucent paths) and with span fills
--                        where it is exact (opaque interiors), and every pixel
--                        where two or more paths' edges enter is recomputed with
--                        exact visibility (compute/Visibility.luau) from the
--                        paths' geometry. Each output byte is rounded once.
--
-- Deterministic: + - * / floor ceil min max abs only (plus Coverage.dasin inside
-- Visibility's disc areas, unused for polygons).

local Pixels = require("../Pixels")
local MyMath = require("../MyMath")
local Visibility = require("./Visibility")

local Scanline = {}

export type Accumulator = {
	width: number,
	height: number,
	stride: number, -- cells per row (width + 2)
	cells: buffer, -- f64 per cell
	ranges: { { number } }, -- per row: flat list of touched cell ranges (lo, hi, lo, hi, ...)
}

function Scanline.new(width: number, height: number): Accumulator
	local ranges: { { number } } = {}
	for y = 1, height do
		ranges[y] = {}
	end
	return {
		width = width,
		height = height,
		stride = width + 2,
		cells = buffer.create((width + 2) * height * 8),
		ranges = ranges,
	}
end

local floor, ceil = math.floor, math.ceil

-- Adds one edge with x already inside [0, width].
local function addLineInside(acc: Accumulator, x0: number, y0: number, x1: number, y1: number)
	if y0 == y1 then
		return
	end
	local dir = 1
	if y0 > y1 then
		dir = -1
		x0, y0, x1, y1 = x1, y1, x0, y0
	end
	local H = acc.height
	local stride = acc.stride
	local cells = acc.cells
	local ranges = acc.ranges
	local dxdy = (x1 - x0) / (y1 - y0)
	local x = x0
	if y0 < 0 then
		x -= y0 * dxdy
	end
	local yStart = if y0 > 0 then floor(y0) else 0
	local yEnd = if y1 < H then ceil(y1) else H
	for y = yStart, yEnd - 1 do
		local base = y * stride * 8
		local top = if y > y0 then y else y0
		local bot = if y + 1 < y1 then y + 1 else y1
		local dy = bot - top
		local xnext = x + dxdy * dy
		local d = dy * dir
		local xa, xb = x, xnext
		if xa > xb then
			xa, xb = xb, xa
		end
		local x0floor = floor(xa)
		local x1ceil = ceil(xb)
		local x0i, x1i = x0floor, x1ceil
		if x1i <= x0i + 1 then
			local xmf = 0.5 * (x + xnext) - x0floor
			local o = base + x0i * 8
			buffer.writef64(cells, o, buffer.readf64(cells, o) + d - d * xmf)
			buffer.writef64(cells, o + 8, buffer.readf64(cells, o + 8) + d * xmf)
			x1i = x0i + 1
		else
			local s = 1 / (xb - xa)
			local x0f = xa - x0floor
			local a0 = 0.5 * s * (1 - x0f) * (1 - x0f)
			local x1f = xb - x1ceil + 1
			local am = 0.5 * s * x1f * x1f
			local o = base + x0i * 8
			buffer.writef64(cells, o, buffer.readf64(cells, o) + d * a0)
			if x1i == x0i + 2 then
				buffer.writef64(cells, o + 8, buffer.readf64(cells, o + 8) + d * (1 - a0 - am))
			else
				local a1 = s * (1.5 - x0f)
				buffer.writef64(cells, o + 8, buffer.readf64(cells, o + 8) + d * (a1 - a0))
				local ds = d * s
				for xi = x0i + 2, x1i - 2 do
					local oi = base + xi * 8
					buffer.writef64(cells, oi, buffer.readf64(cells, oi) + ds)
				end
				local a2 = a1 + (x1i - x0i - 3) * s
				local ol = base + (x1i - 1) * 8
				buffer.writef64(cells, ol, buffer.readf64(cells, ol) + d * (1 - a2 - am))
			end
			local oe = base + x1i * 8
			buffer.writef64(cells, oe, buffer.readf64(cells, oe) + d * am)
		end
		local r = ranges[y + 1]
		r[#r + 1] = x0i
		r[#r + 1] = x1i
		x = xnext
	end
end

-- Adds one edge, clipping x to [0, width]: parts left of 0 become a vertical edge
-- on x = 0 (they cover every pixel to their right), parts right of width a
-- vertical edge on x = width (they cover nothing visible).
local function addLine(acc: Accumulator, x0: number, y0: number, x1: number, y1: number)
	local W = acc.width
	for _, k in { 0, W } do
		if (x0 < k) ~= (x1 < k) and x0 ~= k and x1 ~= k then
			local t = (k - x0) / (x1 - x0)
			local ym = y0 + (y1 - y0) * t
			addLine(acc, x0, y0, k, ym)
			addLine(acc, k, ym, x1, y1)
			return
		end
	end
	local cx0 = if x0 < 0 then 0 elseif x0 > W then W else x0
	local cx1 = if x1 < 0 then 0 elseif x1 > W then W else x1
	addLineInside(acc, cx0, y0, cx1, y1)
end
Scanline.addLine = addLine

-- Adds a closed polygon (flat {x1, y1, x2, y2, ...}).
function Scanline.addPolygon(acc: Accumulator, pts: { number })
	local n = #pts // 2
	local px, py = pts[2 * n - 1], pts[2 * n]
	for i = 1, n do
		local qx, qy = pts[2 * i - 1], pts[2 * i]
		addLine(acc, px, py, qx, qy)
		px, py = qx, qy
	end
end

-- Resolves the accumulated coverage into a straight-alpha layer: every pixel gets
-- colour rgb (0..0xFFFFFF) and alpha round(coverage * alpha). Spans between touched
-- cells are constant and are filled with buffer.copy. Clears the accumulator.
-- Returns the number of pixels computed one by one.
function Scanline.resolve(acc: Accumulator, out: buffer, rgb: number, alpha: number): number
	local W, H, stride = acc.width, acc.height, acc.stride
	local cells = acc.cells
	local perPixel = 0
	for y = 0, H - 1 do
		local r = acc.ranges[y + 1]
		local rowOut = y * W * 4
		local base = y * stride * 8
		local n = #r
		if n == 0 then
			Pixels.fillSpan(out, rowOut, W, rgb)
			continue
		end
		-- sort ranges by start (insertion sort on pairs; rows hold few ranges)
		for i = 3, n, 2 do
			local lo, hi = r[i], r[i + 1]
			local j = i - 2
			while j >= 1 and r[j] > lo do
				r[j + 2], r[j + 3] = r[j], r[j + 1]
				j -= 2
			end
			r[j + 2], r[j + 3] = lo, hi
		end
		local sum = 0
		local pos = 0 -- next pixel to write
		local i = 1
		while i <= n do
			local lo, hi = r[i], r[i + 1]
			i += 2
			-- merge overlapping or touching ranges
			while i <= n and r[i] <= hi + 1 do
				if r[i + 1] > hi then
					hi = r[i + 1]
				end
				i += 2
			end
			if lo > pos and pos < W then
				local a = math.min(1, math.abs(sum))
				local stop = if lo < W then lo else W
				Pixels.fillSpan(out, rowOut + pos * 4, stop - pos, rgb + ((a * alpha + 0.5) // 1) * 16777216)
				pos = stop
			end
			for x = lo, hi do
				local o = base + x * 8
				sum += buffer.readf64(cells, o)
				buffer.writef64(cells, o, 0)
				if x < W then
					local a = sum
					if a < 0 then
						a = -a
					end
					if a > 1 then
						a = 1
					end
					buffer.writeu32(out, rowOut + x * 4, rgb + ((a * alpha + 0.5) // 1) * 16777216)
					perPixel += 1
				end
			end
			if hi + 1 > pos then
				pos = hi + 1
			end
		end
		if pos < W then
			local a = math.min(1, math.abs(sum))
			Pixels.fillSpan(out, rowOut + pos * 4, W - pos, rgb + ((a * alpha + 0.5) // 1) * 16777216)
		end
		table.clear(r)
	end
	return perPixel
end

-- Composites the accumulated coverage onto an RGBA8 destination with straight-alpha
-- source-over, in colour `color` (packed RGBA8): the exact-area vector painter.
-- Rows without touched cells are not visited at all. Between touched ranges the
-- running sum is constant: 0 (span skipped), 1 (fully covered: one span fill for
-- an opaque colour) or a fraction, in rows that a horizontal edge or a vertex
-- crosses (blended pixel by pixel with that constant coverage). Clears the
-- accumulator. Returns the number of touched cells blended one by one.
function Scanline.composite(acc: Accumulator, dst: buffer, color: number): number
	local W, H, stride = acc.width, acc.height, acc.stride
	local cells = acc.cells
	local cr, cg, cb = color % 256, (color // 256) % 256, (color // 65536) % 256
	local ca = (color // 16777216) / 255
	local opaque = ca >= 1
	local perPixel = 0
	local function blend(o: number, cov: number)
		local sa = cov * ca
		if sa <= 0 then
			return
		end
		if sa >= 1 then
			buffer.writeu32(dst, o, color)
			return
		end
		local p = buffer.readu32(dst, o)
		local da = (p // 16777216) / 255 * (1 - sa)
		local oa = sa + da
		local r = (cr * sa + (p % 256) * da) / oa
		local g = (cg * sa + ((p // 256) % 256) * da) / oa
		local b = (cb * sa + ((p // 65536) % 256) * da) / oa
		buffer.writeu32(dst, o, (r + 0.5) // 1 + ((g + 0.5) // 1) * 256 + ((b + 0.5) // 1) * 65536 + ((oa * 255 + 0.5) // 1) * 16777216)
	end
	-- span [x0, x1) with constant winding sum s
	local function spanFill(rowOut: number, x0: number, x1: number, s: number)
		local a = if s < 0 then -s else s
		if a < 1e-9 then
			return
		end
		if a >= 1 - 1e-9 and opaque then
			Pixels.fillSpan(dst, rowOut + x0 * 4, x1 - x0, color)
			return
		end
		if a > 1 then
			a = 1
		end
		for x = x0, x1 - 1 do
			blend(rowOut + x * 4, a)
		end
	end
	for y = 0, H - 1 do
		local r = acc.ranges[y + 1]
		local n = #r
		if n == 0 then
			continue
		end
		local rowOut = y * W * 4
		local base = y * stride * 8
		for i = 3, n, 2 do
			local lo, hi = r[i], r[i + 1]
			local j = i - 2
			while j >= 1 and r[j] > lo do
				r[j + 2], r[j + 3] = r[j], r[j + 1]
				j -= 2
			end
			r[j + 2], r[j + 3] = lo, hi
		end
		local sum = 0
		local pos = 0
		local i = 1
		while i <= n do
			local lo, hi = r[i], r[i + 1]
			i += 2
			while i <= n and r[i] <= hi + 1 do
				if r[i + 1] > hi then
					hi = r[i + 1]
				end
				i += 2
			end
			if lo > pos and pos < W then
				spanFill(rowOut, pos, if lo < W then lo else W, sum)
			end
			for x = lo, hi do
				local o = base + x * 8
				sum += buffer.readf64(cells, o)
				buffer.writef64(cells, o, 0)
				if x < W then
					local a = sum
					if a < 0 then
						a = -a
					end
					if a > 1 then
						a = 1
					end
					blend(rowOut + x * 4, a)
					perPixel += 1
				end
			end
			if hi + 1 > pos then
				pos = hi + 1
			end
		end
		if pos < W then
			spanFill(rowOut, pos, W, sum)
		end
		table.clear(r)
	end
	return perPixel
end

----------------------------------------------------------------------------------
-- Exact multi-path scenes (F2)
----------------------------------------------------------------------------------

-- A path: one or more closed contours (flat x, y lists; non-zero winding with
-- values 0 or +-1, e.g. outer contours one way and holes the other) filled with
-- a straight-alpha RGBA8 colour.
export type Path = { contours: { { number } }, color: number }
export type SceneStats = { conflicts: number, disjoint: number, floatPixels: number, spans: number }

type Prepared = {
	edges: { number }, -- x0, y0, x1, y1, dir per edge; y0 < y1; x clamped to [0, W]; sorted by y0
	nf: number, -- number of floats in edges
	act: { number }, -- indices (into edges) of active edges
	nact: number,
	cursor: number, -- next edge to activate
	row0: number,
	row1: number,
	r: number,
	g: number,
	b: number,
	a: number,
	color: number,
	sigma: number, -- orientation of the path (sign of its total signed area)
	convex: boolean, -- one convex contour: its edges bound the path (disjoint fast path)
	contours: { { number } },
}

-- Appends edge (x0, y0)-(x1, y1) to e with x split at 0 and W and clamped to [0, W]
-- (left of 0 it covers every pixel to its right, right of W nothing visible).
local function prepEdge(e: { number }, x0: number, y0: number, x1: number, y1: number, W: number)
	if y0 == y1 then
		return
	end
	for _, k in { 0, W } do
		if (x0 < k) ~= (x1 < k) and x0 ~= k and x1 ~= k then
			local t = (k - x0) / (x1 - x0)
			local ym = y0 + (y1 - y0) * t
			prepEdge(e, x0, y0, k, ym, W)
			prepEdge(e, k, ym, x1, y1, W)
			return
		end
	end
	x0 = if x0 < 0 then 0 elseif x0 > W then W else x0
	x1 = if x1 < 0 then 0 elseif x1 > W then W else x1
	local dir = 1
	if y0 > y1 then
		dir = -1
		x0, y0, x1, y1 = x1, y1, x0, y0
	end
	local n = #e
	e[n + 1], e[n + 2], e[n + 3], e[n + 4], e[n + 5] = x0, y0, x1, y1, dir
end

local function prepare(path: Path, W: number, H: number): Prepared
	local raw: { number } = {}
	local area = 0
	local ymin, ymax = math.huge, -math.huge
	for _, c in path.contours do
		local n = #c // 2
		local px, py = c[2 * n - 1], c[2 * n]
		for i = 1, n do
			local qx, qy = c[2 * i - 1], c[2 * i]
			prepEdge(raw, px, py, qx, qy, W)
			area += px * qy - qx * py
			if qy < ymin then
				ymin = qy
			end
			if qy > ymax then
				ymax = qy
			end
			px, py = qx, qy
		end
	end
	-- sort edges by y0
	local ne = #raw // 5
	local idx = table.create(ne, 0)
	for i = 1, ne do
		idx[i] = i
	end
	table.sort(idx, function(a: number, b: number): boolean
		return raw[5 * a - 3] < raw[5 * b - 3]
	end)
	local edges = table.create(#raw, 0)
	for k, i in idx do
		for j = 1, 5 do
			edges[5 * (k - 1) + j] = raw[5 * (i - 1) + j]
		end
	end
	local color = path.color
	local sigma = if area >= 0 then 1 else -1
	local convex = #path.contours == 1
	if convex then
		local c = path.contours[1]
		local n = #c // 2
		local ax, ay = c[2 * n - 3], c[2 * n - 2]
		local bx, by = c[2 * n - 1], c[2 * n]
		for i = 1, n do
			local cx, cy = c[2 * i - 1], c[2 * i]
			if sigma * ((bx - ax) * (cy - by) - (by - ay) * (cx - bx)) < 0 then
				convex = false
				break
			end
			ax, ay, bx, by = bx, by, cx, cy
		end
	end
	local row0 = if ymin > 0 then floor(ymin) else 0
	local row1 = if ymax < H then ceil(ymax) - 1 else H - 1
	return {
		edges = edges,
		nf = #edges,
		act = table.create(16, 0),
		nact = 0,
		cursor = 1,
		row0 = row0,
		row1 = row1,
		r = color % 256,
		g = (color // 256) % 256,
		b = (color // 65536) % 256,
		a = (color // 16777216) / 255,
		color = color,
		sigma = sigma,
		convex = convex,
		contours = path.contours,
	}
end

-- Deposits the part of edge (x0, y0)-(x1, y1) (y0 < y1, x in [0, W]) inside row y
-- into the row's cells (the per-row body of addLineInside) and records the
-- touched cell range in R. Returns the new range count.
local function rowEdge(cells: buffer, W: number, y: number, x0: number, y0: number, x1: number, y1: number, dir: number, R: { number }, nr: number): number
	local top = if y > y0 then y else y0
	local bot = if y + 1 < y1 then y + 1 else y1
	if bot <= top then
		return nr
	end
	local dxdy = (x1 - x0) / (y1 - y0)
	local xt = x0 + (top - y0) * dxdy
	local xn = x0 + (bot - y0) * dxdy
	-- interpolation can round a hair outside [0, W] at the clipped borders
	xt = if xt < 0 then 0 elseif xt > W then W else xt
	xn = if xn < 0 then 0 elseif xn > W then W else xn
	local d = (bot - top) * dir
	local xa, xb = xt, xn
	if xa > xb then
		xa, xb = xb, xa
	end
	local x0floor = floor(xa)
	local x0i, x1i = x0floor, ceil(xb)
	if x1i <= x0i + 1 then
		local xmf = 0.5 * (xt + xn) - x0floor
		local o = x0i * 8
		buffer.writef64(cells, o, buffer.readf64(cells, o) + d - d * xmf)
		buffer.writef64(cells, o + 8, buffer.readf64(cells, o + 8) + d * xmf)
		x1i = x0i + 1
	else
		local s = 1 / (xb - xa)
		local x0f = xa - x0floor
		local a0 = 0.5 * s * (1 - x0f) * (1 - x0f)
		local x1f = xb - x1i + 1
		local am = 0.5 * s * x1f * x1f
		local o = x0i * 8
		buffer.writef64(cells, o, buffer.readf64(cells, o) + d * a0)
		if x1i == x0i + 2 then
			buffer.writef64(cells, o + 8, buffer.readf64(cells, o + 8) + d * (1 - a0 - am))
		else
			local a1 = s * (1.5 - x0f)
			buffer.writef64(cells, o + 8, buffer.readf64(cells, o + 8) + d * (a1 - a0))
			local ds = d * s
			for xi = x0i + 2, x1i - 2 do
				local oi = xi * 8
				buffer.writef64(cells, oi, buffer.readf64(cells, oi) + ds)
			end
			local a2 = a1 + (x1i - x0i - 3) * s
			local ol = (x1i - 1) * 8
			buffer.writef64(cells, ol, buffer.readf64(cells, ol) + d * (1 - a2 - am))
		end
		local oe = x1i * 8
		buffer.writef64(cells, oe, buffer.readf64(cells, oe) + d * am)
	end
	R[nr + 1] = x0i
	R[nr + 2] = x1i
	return nr + 2
end

local CTX: { number } = table.create(256, 0)
local CTY: { number } = table.create(256, 0)

-- Pieces of path P at pixel (x, y) for exact visibility.
local function pathPieces(P: Prepared, x: number, y: number)
	local px, py = x + 0.5, y + 0.5
	for _, c in P.contours do
		local n = #c // 2
		for i = 1, n do
			CTX[i] = c[2 * i - 1] - px
			CTY[i] = c[2 * i] - py
		end
		Visibility.polygon(CTX, CTY, n, P.sigma)
	end
end

-- true if path B lies outside a bounding edge of the convex path A (exact on
-- shared vertices: differences before products, as in Raster's fast path)
local function pathSeparates(A: Prepared, B: Prepared): boolean
	if not A.convex then
		return false
	end
	local c = A.contours[1]
	local n = #c // 2
	local sigma = A.sigma
	local px, py = c[2 * n - 1], c[2 * n]
	for i = 1, n do
		local qx, qy = c[2 * i - 1], c[2 * i]
		local nx, ny = sigma * (qy - py), -sigma * (qx - px)
		local out = true
		for _, d in B.contours do
			for v = 1, #d, 2 do
				if nx * (d[v] - px) + ny * (d[v + 1] - py) < 0 then
					out = false
					break
				end
			end
			if not out then
				break
			end
		end
		if out then
			return true
		end
		px, py = qx, qy
	end
	return false
end

local EVL: { number } = table.create(64, 0) -- a pixel's events, bottom to top
local XR: { number } = table.create(17, 0)
local XG: { number } = table.create(17, 0)
local XB: { number } = table.create(17, 0)
local XA: { number } = table.create(17, 0)

-- Renders paths (bottom to top) onto dst (width x height RGBA8, straight alpha),
-- over a background colour if given (else over dst's current content), as the
-- exact box filter of the source-over composite (F2): every pixel is computed in
-- floating point from exact coverages and rounded once; pixels where two or more
-- paths' edges enter use exact visibility. Opaque interiors are span fills.
function Scanline.renderScene(dst: buffer, width: number, height: number, paths: { Path }, background: number?): SceneStats
	local W, H = width, height
	if background then
		Pixels.fill(dst, background)
	end
	local np = #paths
	local P: { Prepared } = {}
	for i = 1, np do
		P[i] = prepare(paths[i], W, H)
	end
	local cells = buffer.create((W + 2) * 8)
	local R: { number } = table.create(64, 0)
	local rowF = buffer.create(W * 32) -- premultiplied r, g, b (0..255 * a), a (0..1)
	local snapF = buffer.create(W * 32) -- base below the first edge since the last opaque cover
	local flag = buffer.create(W) -- 1: rowF holds this pixel's (inexact as a byte) value
	local nfB = buffer.create(W) -- paths with fractional coverage since the last opaque cover
	local head = buffer.create(W * 4) -- event list head per pixel (0: none)
	local conf = buffer.create(W) -- 1: pixel is in the conflict list
	local EVp: { number } = table.create(256, 0)
	local EVc: { number } = table.create(256, 0)
	local EVn: { number } = table.create(256, 0)
	local CL: { number } = table.create(64, 0)
	local st: SceneStats = { conflicts = 0, disjoint = 0, floatPixels = 0, spans = 0 }
	for y = 0, H - 1 do
		local rowOut = y * W * 4
		buffer.fill(flag, 0, 0)
		buffer.fill(nfB, 0, 0)
		buffer.fill(head, 0, 0)
		local nev = 0
		local ncl = 0
		local minX, maxX = W, -1
		for pi = 1, np do
			local Q = P[pi]
			if y < Q.row0 or y > Q.row1 then
				continue
			end
			-- activate edges starting above the row's bottom, deposit active ones
			local E, act = Q.edges, Q.act
			local nact = Q.nact
			local cursor = Q.cursor
			while cursor <= Q.nf and E[cursor + 1] < y + 1 do
				nact += 1
				act[nact] = cursor
				cursor += 5
			end
			Q.cursor = cursor
			local nr = 0
			local keep = 0
			for i = 1, nact do
				local e = act[i]
				local ey1 = E[e + 3]
				if ey1 > y then
					nr = rowEdge(cells, W, y, E[e], E[e + 1], E[e + 2], ey1, E[e + 4], R, nr)
				end
				if ey1 > y + 1 then
					keep += 1
					act[keep] = e
				end
			end
			Q.nact = keep
			if nr == 0 then
				continue
			end
			local cr, cg, cb, ca = Q.r, Q.g, Q.b, Q.a
			local color = Q.color
			local opaque = ca >= 1
			-- composite coverage c of this path at pixel x
			local function pixel(x: number, c: number)
				if c < 1e-9 then
					return
				end
				if c > 1 - 1e-9 then
					c = 1
				end
				local sa = c * ca
				if sa >= 1 then
					buffer.writeu32(dst, rowOut + x * 4, color)
					buffer.writeu8(flag, x, 0)
					buffer.writeu8(nfB, x, 0)
					buffer.writeu32(head, x * 4, 0)
					return
				end
				local o = x * 32
				local pr, pg, pb, pa = 0, 0, 0, 0
				if buffer.readu8(flag, x) == 1 then
					pr = buffer.readf64(rowF, o)
					pg = buffer.readf64(rowF, o + 8)
					pb = buffer.readf64(rowF, o + 16)
					pa = buffer.readf64(rowF, o + 24)
				else
					local p = buffer.readu32(dst, rowOut + x * 4)
					pa = (p // 16777216) / 255
					pr = (p % 256) * pa
					pg = ((p // 256) % 256) * pa
					pb = ((p // 65536) % 256) * pa
					buffer.writeu8(flag, x, 1)
					if x < minX then
						minX = x
					end
					if x > maxX then
						maxX = x
					end
				end
				local n = buffer.readu8(nfB, x)
				if c < 1 then
					if n == 0 then
						buffer.writef64(snapF, o, pr)
						buffer.writef64(snapF, o + 8, pg)
						buffer.writef64(snapF, o + 16, pb)
						buffer.writef64(snapF, o + 24, pa)
						buffer.writeu32(head, x * 4, 0)
					end
					n += 1
					buffer.writeu8(nfB, x, if n < 255 then n else 255)
					if n == 2 and buffer.readu8(conf, x) == 0 then
						buffer.writeu8(conf, x, 1)
						ncl += 1
						CL[ncl] = x
					end
				end
				if n >= 1 then
					nev += 1
					EVp[nev] = pi
					EVc[nev] = c
					EVn[nev] = buffer.readu32(head, x * 4)
					buffer.writeu32(head, x * 4, nev)
				end
				local ia = 1 - sa
				buffer.writef64(rowF, o, cr * sa + pr * ia)
				buffer.writef64(rowF, o + 8, cg * sa + pg * ia)
				buffer.writef64(rowF, o + 16, cb * sa + pb * ia)
				buffer.writef64(rowF, o + 24, sa + pa * ia)
			end
			local function span(x0: number, x1: number, s: number)
				local a = if s < 0 then -s else s
				if a < 1e-9 or x1 <= x0 then
					return
				end
				if a > 1 - 1e-9 and opaque then
					local n = x1 - x0
					Pixels.fillSpan(dst, rowOut + x0 * 4, n, color)
					buffer.fill(flag, x0, 0, n)
					buffer.fill(nfB, x0, 0, n)
					buffer.fill(head, x0 * 4, 0, n * 4)
					st.spans += 1
					return
				end
				if a > 1 then
					a = 1
				end
				for x = x0, x1 - 1 do
					pixel(x, a)
				end
			end
			-- sort the touched ranges and sweep the running sum
			for i = 3, nr, 2 do
				local lo, hi = R[i], R[i + 1]
				local j = i - 2
				while j >= 1 and R[j] > lo do
					R[j + 2], R[j + 3] = R[j], R[j + 1]
					j -= 2
				end
				R[j + 2], R[j + 3] = lo, hi
			end
			local sum = 0
			local pos = 0
			local i = 1
			while i <= nr do
				local lo, hi = R[i], R[i + 1]
				i += 2
				while i <= nr and R[i] <= hi + 1 do
					if R[i + 1] > hi then
						hi = R[i + 1]
					end
					i += 2
				end
				if lo > pos and pos < W then
					span(pos, if lo < W then lo else W, sum)
				end
				for x = lo, hi do
					local o = x * 8
					sum += buffer.readf64(cells, o)
					buffer.writef64(cells, o, 0)
					if x < W then
						local a = if sum < 0 then -sum else sum
						pixel(x, if a > 1 then 1 else a)
					end
				end
				if hi + 1 > pos then
					pos = hi + 1
				end
			end
			if pos < W then
				span(pos, W, sum)
			end
		end
		-- exact visibility where two or more edges entered
		for k = 1, ncl do
			local x = CL[k]
			buffer.writeu8(conf, x, 0)
			if buffer.readu8(nfB, x) < 2 then
				continue
			end
			st.conflicts += 1
			local o = x * 32
			-- the pixel's events, bottom to top, and whether its partial paths are
			-- pairwise disjoint (then the exact composite is sum A_i X_i + (1 - sum
			-- A_i) X_0, see Raster's disjoint fast path)
			local ne = 0
			local e = buffer.readu32(head, x * 4)
			while e ~= 0 do
				ne += 1
				EVL[ne] = e
				e = EVn[e]
			end
			local i0, i1 = 1, ne
			while i0 < i1 do
				EVL[i0], EVL[i1] = EVL[i1], EVL[i0]
				i0 += 1
				i1 -= 1
			end
			local disjoint = true
			local nfrac = 0
			for i = 1, ne do
				if EVc[EVL[i]] < 1 then
					nfrac += 1
				end
			end
			if nfrac > 8 then
				disjoint = false
			else
				for i = 1, ne do
					local ei = EVL[i]
					if EVc[ei] < 1 then
						for j = i + 1, ne do
							local ej = EVL[j]
							if EVc[ej] < 1 then
								local A, B = P[EVp[ei]], P[EVp[ej]]
								if not (pathSeparates(A, B) or pathSeparates(B, A)) then
									disjoint = false
									break
								end
							end
						end
						if not disjoint then
							break
						end
					end
				end
			end
			if disjoint then
				st.disjoint += 1
				XR[1] = buffer.readf64(snapF, o)
				XG[1] = buffer.readf64(snapF, o + 8)
				XB[1] = buffer.readf64(snapF, o + 16)
				XA[1] = buffer.readf64(snapF, o + 24)
				local n = 1
				local area = 0
				for i = 1, ne do
					local ev = EVL[i]
					local Q = P[EVp[ev]]
					local c = EVc[ev]
					local a, ia = Q.a, 1 - Q.a
					local r, g, b = Q.r * a, Q.g * a, Q.b * a
					if c >= 1 then
						for m = 1, n do
							XR[m] = r + XR[m] * ia
							XG[m] = g + XG[m] * ia
							XB[m] = b + XB[m] * ia
							XA[m] = a + XA[m] * ia
						end
					else
						n += 1
						XR[n] = r + XR[1] * ia
						XG[n] = g + XG[1] * ia
						XB[n] = b + XB[1] * ia
						XA[n] = a + XA[1] * ia
						area += c
					end
				end
				local rest = if area < 1 then 1 - area else 0
				local sr, sg, sb, sa = XR[1] * rest, XG[1] * rest, XB[1] * rest, XA[1] * rest
				local m = 1
				for i = 1, ne do
					local c = EVc[EVL[i]]
					if c < 1 then
						m += 1
						sr += XR[m] * c
						sg += XG[m] * c
						sb += XB[m] * c
						sa += XA[m] * c
					end
				end
				buffer.writef64(rowF, o, sr)
				buffer.writef64(rowF, o + 8, sg)
				buffer.writef64(rowF, o + 16, sb)
				buffer.writef64(rowF, o + 24, if sa > 1 then 1 else sa)
				continue
			end
			Visibility.reset()
			for i = ne, 1, -1 do
				local ev = EVL[i]
				local Q = P[EVp[ev]]
				local c = EVc[ev]
				if c >= 1 then
					Visibility.full(Q.r, Q.g, Q.b, Q.a)
				else
					Visibility.begin(Q.r, Q.g, Q.b, Q.a, c)
					pathPieces(Q, x, y)
					Visibility.commit()
				end
			end
			local sr = buffer.readf64(snapF, o)
			local sg = buffer.readf64(snapF, o + 8)
			local sb = buffer.readf64(snapF, o + 16)
			local sa = buffer.readf64(snapF, o + 24)
			if sa > 0 then
				sr, sg, sb = sr / sa, sg / sa, sb / sa
			end
			local r, g, b, a = Visibility.finish(sr, sg, sb, sa)
			buffer.writef64(rowF, o, r * a)
			buffer.writef64(rowF, o + 8, g * a)
			buffer.writef64(rowF, o + 16, b * a)
			buffer.writef64(rowF, o + 24, a)
		end
		-- round every float pixel once
		for x = minX, maxX do
			if buffer.readu8(flag, x) == 1 then
				st.floatPixels += 1
				local o = x * 32
				local a = buffer.readf64(rowF, o + 24)
				local px = 0
				if a > 0 then
					px = (buffer.readf64(rowF, o) / a + 0.5) // 1
						+ ((buffer.readf64(rowF, o + 8) / a + 0.5) // 1) * 256
						+ ((buffer.readf64(rowF, o + 16) / a + 0.5) // 1) * 65536
						+ ((a * 255 + 0.5) // 1) * 16777216
				end
				buffer.writeu32(dst, rowOut + x * 4, px)
			end
		end
	end
	return st
end

-- Points of an ellipse (cx, cy, rx, ry) as a polygon whose chords deviate from the
-- curve by at most tol pixels (sagitta r (1 - cos(pi / n)) <= tol), so the
-- coverage error of any pixel is at most about 1.5 * tol (chord length inside a
-- pixel is at most sqrt(2)). Vertices come from MyMath's polynomial sine, so they
-- are bit-identical on every platform.
function Scanline.flattenEllipse(cx: number, cy: number, rx: number, ry: number, tol: number): { number }
	local r = math.max(rx, ry)
	-- 1 - cos(x) <= x^2 / 2, so n >= pi * sqrt(r / (2 tol)) guarantees the bound
	local n = math.max(8, ceil(3.14159265358979 * math.sqrt(r / (2 * tol))))
	local pts = table.create(2 * n, 0)
	for i = 0, n - 1 do
		local t = i / n
		pts[2 * i + 1] = cx + rx * MyMath.dcosTurns(t)
		pts[2 * i + 2] = cy + ry * MyMath.dsinTurns(t)
	end
	return pts
end

return Scanline
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Tiles</string>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: compute/Tiles
--
-- Tile-level structure for images of any size (docs/COMPUTE.md 2.2 and 2.6):
--
--   morton / unmorton   Z-order codes from bit32 "part1by1" (5 ops per axis) or a
--                       256-entry lookup table; tile orders (Morton, focus-first
--                       rings for Saturn's progressive refinement).
--   Store               content-addressed tiles. The key of a tile is its own pixel
--                       bytes as a Luau string: string interning hashes every byte
--                       and compares the full content on a hash match
--                       (VM/src/lstring.cpp), so equal keys mean equal pixels with
--                       no false positives and the work runs in C (C10).
--   Grid                a tiles-wide by tiles-high array of tile ids into a Store,
--                       copy-on-write: writing into a shared tile clones it first;
--                       commit() re-interns edited tiles so duplicates merge again.
--
-- Everything is integer and bit32 work; the bytes stored are the bytes given.

local Tiles = {}

local band, bor, lshift, rshift = bit32.band, bit32.bor, bit32.lshift, bit32.rshift

-- Spreads the low 16 bits of v to the even bit positions.
local function part1by1(v: number): number
	v = band(bor(v, lshift(v, 8)), 0x00FF00FF)
	v = band(bor(v, lshift(v, 4)), 0x0F0F0F0F)
	v = band(bor(v, lshift(v, 2)), 0x33333333)
	return band(bor(v, lshift(v, 1)), 0x55555555)
end

local function compact1by1(v: number): number
	v = band(v, 0x55555555)
	v = band(bor(v, rshift(v, 1)), 0x33333333)
	v = band(bor(v, rshift(v, 2)), 0x0F0F0F0F)
	v = band(bor(v, rshift(v, 4)), 0x00FF00FF)
	return band(bor(v, rshift(v, 8)), 0x0000FFFF)
end

-- Morton code of (x, y), 0 <= x, y < 65536: bits of x at even positions.
function Tiles.morton(x: number, y: number): number
	return part1by1(x) + 2 * part1by1(y)
end

function Tiles.unmorton(code: number): (number, number)
	return compact1by1(code), compact1by1(rshift(code, 1))
end

-- Lookup-table variant: 256 spread bytes, two lookups per axis.
local SPREAD: { number } = table.create(256, 0)
for i = 0, 255 do
	SPREAD[i + 1] = part1by1(i)
end
Tiles.SPREAD = SPREAD

function Tiles.mortonLUT(x: number, y: number): number
	return SPREAD[x % 256 + 1] + SPREAD[x // 256 + 1] * 65536 + 2 * (SPREAD[y % 256 + 1] + SPREAD[y // 256 + 1] * 65536)
end

-- Tile indices (ty * tilesX + tx) in Morton order, skipping codes outside the grid.
function Tiles.mortonOrder(tilesX: number, tilesY: number): { number }
	local side = 1
	while side < tilesX or side < tilesY do
		side *= 2
	end
	local order = table.create(tilesX * tilesY, 0)
	local n = 0
	for code = 0, side * side - 1 do
		local tx, ty = compact1by1(code), compact1by1(rshift(code, 1))
		if tx < tilesX and ty < tilesY then
			n += 1
			order[n] = ty * tilesX + tx
		end
	end
	return order
end

-- Tile indices ordered by Chebyshev ring around the focus tile (fx, fy), Morton
-- order inside a ring: Saturn's rings, rendered nearest first.
function Tiles.ringOrder(tilesX: number, tilesY: number, fx: number, fy: number): { number }
	local order = Tiles.mortonOrder(tilesX, tilesY)
	local ring = table.create(tilesX * tilesY, 0)
	local rank = table.create(tilesX * tilesY, 0)
	for i, t in order do
		local tx, ty = t % tilesX, t // tilesX
		ring[t + 1] = math.max(math.abs(tx - fx), math.abs(ty - fy))
		rank[t + 1] = i
	end
	table.sort(order, function(a: number, b: number): boolean
		local ra, rb = ring[a + 1], ring[b + 1]
		if ra ~= rb then
			return ra < rb
		end
		return rank[a + 1] < rank[b + 1]
	end)
	return order
end

----------------------------------------------------------------------------------
-- Content-addressed tile store
----------------------------------------------------------------------------------

export type Store = {
	size: number, -- tile edge in pixels
	byKey: { [string]: number }, -- content -> tile id
	keys: { string }, -- id -> content key ("" when the tile is private / being edited)
	tiles: { buffer }, -- id -> pixels (size * size * 4 bytes, row-major)
	refs: { number }, -- id -> number of grid cells using it
	free: { number }, -- recycled ids
	unique: number,
}

function Tiles.newStore(size: number): Store
	return { size = size, byKey = {}, keys = {}, tiles = {}, refs = {}, free = {}, unique = 0 }
end

local scratch: buffer? = nil

local function newId(store: Store): number
	local n = #store.free
	if n > 0 then
		local id = store.free[n]
		store.free[n] = nil
		return id
	end
	return #store.tiles + 1
end

-- Interns a packed tile buffer; returns its id and adds one reference.
local function internBuffer(store: Store, tile: buffer): number
	local key = buffer.tostring(tile)
	local id = store.byKey[key]
	if id then
		store.refs[id] += 1
		return id
	end
	id = newId(store)
	store.byKey[key] = id
	store.keys[id] = key
	store.tiles[id] = tile
	store.refs[id] = 1
	store.unique += 1
	return id
end
Tiles.internBuffer = internBuffer

-- Interns the size x size tile at pixel (x, y) of an image `width` pixels wide
-- (the tile must lie inside the image).
function Tiles.intern(store: Store, img: buffer, width: number, x: number, y: number): number
	local s = store.size
	local bytes = s * s * 4
	local t = scratch
	if t == nil or buffer.len(t) ~= bytes then
		t = buffer.create(bytes)
		scratch = t
	end
	local tb = t :: buffer
	local rowBytes = s * 4
	for r = 0, s - 1 do
		buffer.copy(tb, r * rowBytes, img, ((y + r) * width + x) * 4, rowBytes)
	end
	local key = buffer.tostring(tb)
	local id = store.byKey[key]
	if id then
		store.refs[id] += 1
		return id
	end
	-- new content: keep a private copy of the pixels
	local own = buffer.create(bytes)
	buffer.copy(own, 0, tb, 0, bytes)
	id = newId(store)
	store.byKey[key] = id
	store.keys[id] = key
	store.tiles[id] = own
	store.refs[id] = 1
	store.unique += 1
	return id
end

-- Drops one reference; frees the tile when none remain.
function Tiles.release(store: Store, id: number)
	local r = store.refs[id] - 1
	store.refs[id] = r
	if r == 0 then
		local key = store.keys[id]
		if key ~= "" and store.byKey[key] == id then
			store.byKey[key] = nil
		end
		store.keys[id] = ""
		store.tiles[id] = buffer.create(0)
		table.insert(store.free, id)
		store.unique -= 1
	end
end

----------------------------------------------------------------------------------
-- Copy-on-write grid
----------------------------------------------------------------------------------

export type Grid = {
	store: Store,
	tilesX: number,
	tilesY: number,
	ids: { number },
	dirty: { [number]: boolean }, -- cells holding a private, edited tile
}

-- Builds a grid from a full image (width and height multiples of the tile size).
function Tiles.fromImage(store: Store, img: buffer, width: number, height: number): Grid
	local s = store.size
	local tx, ty = width // s, height // s
	local ids = table.create(tx * ty, 0)
	for j = 0, ty - 1 do
		for i = 0, tx - 1 do
			ids[j * tx + i + 1] = Tiles.intern(store, img, width, i * s, j * s)
		end
	end
	return { store = store, tilesX = tx, tilesY = ty, ids = ids, dirty = {} }
end

-- Writes the grid into a full image (row blits).
function Tiles.compose(grid: Grid, out: buffer)
	local store = grid.store
	local s = store.size
	local width = grid.tilesX * s
	local rowBytes = s * 4
	for j = 0, grid.tilesY - 1 do
		for i = 0, grid.tilesX - 1 do
			local tile = store.tiles[grid.ids[j * grid.tilesX + i + 1]]
			local base = (j * s * width + i * s) * 4
			for r = 0, s - 1 do
				buffer.copy(out, base + r * width * 4, tile, r * rowBytes, rowBytes)
			end
		end
	end
end

-- Returns a buffer for cell (i, j) that may be written: if the cell's tile is
-- shared or interned, it is cloned into a private tile first (copy on write).
function Tiles.edit(grid: Grid, i: number, j: number): buffer
	local cell = j * grid.tilesX + i + 1
	local store = grid.store
	local id = grid.ids[cell]
	if grid.dirty[cell] then
		return store.tiles[id]
	end
	local src = store.tiles[id]
	local copy = buffer.create(buffer.len(src))
	buffer.copy(copy, 0, src, 0, buffer.len(src))
	Tiles.release(store, id)
	local nid = newId(store)
	store.keys[nid] = ""
	store.tiles[nid] = copy
	store.refs[nid] = 1
	store.unique += 1
	grid.ids[cell] = nid
	grid.dirty[cell] = true
	return copy
end

-- Re-interns every edited tile so equal content is shared again. Returns the
-- number of edited tiles that turned out to duplicate an existing tile.
function Tiles.commit(grid: Grid): number
	local store = grid.store
	local merged = 0
	for cell in grid.dirty do
		local id = grid.ids[cell]
		local tile = store.tiles[id]
		-- detach the private tile, then intern its content
		store.refs[id] = 0
		store.keys[id] = ""
		store.tiles[id] = buffer.create(0)
		table.insert(store.free, id)
		store.unique -= 1
		local before = store.unique
		local nid = internBuffer(store, tile)
		if store.unique == before then
			merged += 1
		end
		grid.ids[cell] = nid
	end
	table.clear(grid.dirty)
	return merged
end

-- Bytes held by unique tiles (pixels plus their string keys).
function Tiles.bytes(store: Store): number
	local s = store.size
	return store.unique * s * s * 4 * 2
end

return Tiles
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">Trace</string>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: compute/Trace
--
-- Sphere tracing a 3D signed distance field into 2D maps (docs/COMPUTE.md 3.10):
-- an orthographic view down -z gives, per pixel, the first hit, its normal (from
-- a 4-tap tetrahedral gradient) and its height. Outputs a tangent-space normal
-- map (RGB = 127.5 + 127.5 n, alpha 255 on hit, 0 on miss) and a u8 height map.
-- Impostors, bevels, embossed UI and procedural relief come from this; the
-- height map also feeds Filter.normalMap.
--
-- Determinism: + - * / sqrt abs only, a fixed step limit and epsilon, so every
-- client reproduces the same bytes. Cost: steps x SDF cost per pixel, so pixels
-- whose ray misses the object's bounding sphere are skipped in screen space
-- (one span fill per row), and the step loop stops at the bound's far side.

local Pixels = require("../Pixels")

local Trace = {}

export type Scene = {
	sdf: (number, number, number) -> number, -- Lipschitz <= 1
	cx: number, -- bounding sphere (pixels)
	cy: number,
	cz: number,
	br: number,
}

local sqrt, abs = math.sqrt, math.abs

local function smin(a: number, b: number, k: number): number
	local h = 0.5 + 0.5 * (b - a) / k
	h = if h < 0 then 0 elseif h > 1 then 1 else h
	return b + (a - b) * h - k * h * (1 - h)
end

-- Demo scene scaled to a size x size image: a sphere smoothly merged with a torus
-- lying in the image plane and a rounded slab. Units are pixels.
function Trace.demo(size: number): Scene
	local s = size / 256
	local cx, cy = size * 0.5, size * 0.5
	local R, tr, tt = 70 * s, 85 * s, 14 * s
	local function sdf(x: number, y: number, z: number): number
		local dx, dy, dz = x - cx, y - cy, z
		local sphere = sqrt(dx * dx + dy * dy + dz * dz) - R
		local q = sqrt(dx * dx + dy * dy) - tr
		local torus = sqrt(q * q + dz * dz) - tt
		-- rounded slab |x|, |y| <= 110 s, |z| <= 6 s, edge radius 4 s
		local bx = abs(dx) - 106 * s
		local by = abs(dy) - 106 * s
		local bz = abs(dz) - 2 * s
		local ox = if bx > 0 then bx else 0
		local oy = if by > 0 then by else 0
		local oz = if bz > 0 then bz else 0
		local m = if bx > by then bx else by
		if bz > m then
			m = bz
		end
		if m > 0 then
			m = 0
		end
		local slab = sqrt(ox * ox + oy * oy + oz * oz) + m - 4 * s
		return smin(smin(sphere, torus, 12 * s), slab, 8 * s)
	end
	return { sdf = sdf, cx = cx, cy = cy, cz = 0, br = 152 * s }
end

export type TraceStats = { rays: number, steps: number, hits: number }

-- Traces every pixel; writes the normal map into `normals` (RGBA8) and heights
-- (z of the hit, 0 at the bound's far side .. 255 at its near side) into `heights`
-- (u8). maxSteps bounds the work per ray; eps is the hit threshold in pixels.
function Trace.render(sc: Scene, size: number, normals: buffer, heights: buffer, maxSteps: number, eps: number): TraceStats
	local st: TraceStats = { rays = 0, steps = 0, hits = 0 }
	local f = sc.sdf
	local cx, cy, cz, br = sc.cx, sc.cy, sc.cz, sc.br
	local zBot = cz - br
	local hScale = 255 / (2 * br)
	local e = 0.5 -- gradient tap distance
	for y = 0, size - 1 do
		local py = y + 0.5
		local row = y * size
		local dy = py - cy
		local hw2 = br * br - dy * dy
		if hw2 <= 0 then
			Pixels.fillSpan(normals, row * 4, size, 0x00FF8080)
			buffer.fill(heights, row, 0, size)
			continue
		end
		local hw = sqrt(hw2)
		local xa = math.max(0, math.floor(cx - hw - 0.5))
		local xb = math.min(size - 1, math.ceil(cx + hw - 0.5))
		Pixels.fillSpan(normals, row * 4, xa, 0x00FF8080)
		Pixels.fillSpan(normals, (row + xb + 1) * 4, size - 1 - xb, 0x00FF8080)
		buffer.fill(heights, row, 0, size)
		for x = xa, xb do
			local px = x + 0.5
			st.rays += 1
			-- enter the bounding sphere at its near surface
			local dx = px - cx
			local inside = br * br - dx * dx - dy * dy
			local o = (row + x) * 4
			if inside <= 0 then
				buffer.writeu32(normals, o, 0x00FF8080)
				continue
			end
			local z = cz + sqrt(inside)
			local zEnd = cz - sqrt(inside)
			local hit = false
			for _ = 1, maxSteps do
				local d = f(px, py, z)
				st.steps += 1
				if d < eps then
					hit = true
					break
				end
				z -= d
				if z < zEnd then
					break
				end
			end
			if not hit then
				buffer.writeu32(normals, o, 0x00FF8080)
				continue
			end
			st.hits += 1
			-- tetrahedral gradient: k1 = (1,-1,-1), k2 = (-1,-1,1), k3 = (-1,1,-1), k4 = (1,1,1)
			local f1 = f(px + e, py - e, z - e)
			local f2 = f(px - e, py - e, z + e)
			local f3 = f(px - e, py + e, z - e)
			local f4 = f(px + e, py + e, z + e)
			local gx = f1 - f2 - f3 + f4
			local gy = -f1 - f2 + f3 + f4
			local gz = -f1 + f2 - f3 + f4
			local inv = 1 / sqrt(gx * gx + gy * gy + gz * gz)
			local nx, ny, nz = gx * inv, gy * inv, gz * inv
			buffer.writeu32(
				normals,
				o,
				((nx + 1) * 127.5 + 0.5) // 1 + (((ny + 1) * 127.5 + 0.5) // 1) * 256 + (((nz + 1) * 127.5 + 0.5) // 1) * 65536 + 0xFF000000
			)
			local hv = (z - zBot) * hScale
			hv = if hv < 0 then 0 elseif hv > 255 then 255 else hv
			buffer.writeu8(heights, row + x, (hv + 0.5) // 1)
		end
	end
	return st
end

-- Simple Lambert shading of a normal map (light direction l normalised by the
-- caller), for previews: rgb = albedo * max(0, n . l), alpha kept.
function Trace.shade(normals: buffer, count: number, lx: number, ly: number, lz: number, albedo: number, out: buffer)
	local ar, ag, ab = albedo % 256, (albedo // 256) % 256, (albedo // 65536) % 256
	for i = 0, count - 1 do
		local p = buffer.readu32(normals, i * 4)
		local a = p // 16777216
		if a == 0 then
			buffer.writeu32(out, i * 4, 0)
			continue
		end
		local nx = (p % 256) / 127.5 - 1
		local ny = ((p // 256) % 256) / 127.5 - 1
		local nz = ((p // 65536) % 256) / 127.5 - 1
		local l = nx * lx + ny * ly + nz * lz
		if l < 0 then
			l = 0
		end
		buffer.writeu32(out, i * 4, ((ar * l + 0.5) // 1) + ((ag * l + 0.5) // 1) * 256 + ((ab * l + 0.5) // 1) * 65536 + a * 16777216)
	end
end

return Trace
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">Visibility</string>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: compute/Visibility
--
-- Exact visibility for "conflict pixels": pixels where the edges of two or more
-- shapes enter (docs/COMPUTE.md F2 and C11). Elsewhere coverage-as-alpha is exact
-- (proof in the "Flawless pipeline" section of docs/COMPUTE.md); here it is not,
-- because the shapes' coverage regions inside the pixel are correlated (abutting
-- shapes are perfectly anti-correlated: two exact halves composite to 3/4, a
-- 64/255 seam). This module computes the exact box filter of the source-over
-- composite of a pixel's shape stack instead. (Raster and Scanline.renderScene
-- first try the cheaper exact formula for pairwise disjoint partial shapes, C19 in
-- docs/COMPUTE.md 12.2; this module handles everything else.)
--
-- Method (signed convex terms). In pixel-local coordinates (pixel = the square
-- [-1/2, 1/2]^2), every shape's indicator inside the pixel is written as a signed
-- sum of CONVEX PIECES, sum_j sigma_j 1[K_j], each piece = (convex polygon inside
-- the square) intersected with at most one disc. Disc complements and non-convex
-- polygons are expressed through the signs (ring = outer disc - inner disc,
-- polygon = signed fan of triangles of its clip to the pixel). The stack is
-- processed top-down while maintaining the transmittance
--     nu(q) = prod over shapes t above (1 - alpha_t I_t(q))
-- as a signed weighted sum of terms, sum_k w_k 1[R_k], with every region R_k an
-- intersection of pieces (convex polygon and a set of discs). Shape s contributes
--     alpha_s c_s * integral(I_s nu) = alpha_s c_s * sum_k sum_j w_k sigma_j |R_k ^ K_j|
-- and updates nu <- nu - alpha_s I_s nu, which appends the terms (R_k ^ K_j,
-- -alpha_s sigma_j w_k). A shape that covers the whole pixel (I_s = 1) contributes
-- alpha_s c_s integral(nu) and scales every weight by (1 - alpha_s). The base below
-- the stack contributes alpha_0 c_0 integral(nu). The result is the premultiplied
-- integral of the exact composite over the pixel; dividing by the alpha integral
-- gives straight alpha.
--
-- Exact areas: |R| for R = (convex polygon) ^ D_1 ^ ... ^ D_k. The polygon part is
-- a Sutherland-Hodgman clip (exact up to rounding). With k = 1 the area is
-- Coverage.discPolyArea; with k >= 2 the POWER-CELL LEMMA reduces it to k single
-- disc areas: with power functions p_i(q) = |q - c_i|^2 - r_i^2, on the cell where
-- p_i is the largest the intersection of all discs is {p_i <= 0} = D_i, and every
-- cell {p_i >= p_j for all j} is convex (p_i - p_j is affine), so
--     |P ^ D_1 ^ ... ^ D_k| = sum_i |P ^ cell_i ^ D_i|.
-- Identical discs (zero normal, zero offset) are tie-broken by index.
--
-- Abutting shapes: complementary pieces (a shared edge with opposite inner sides)
-- intersect in a zero-area sliver, so they never double count; no tolerance or
-- snapping is involved. Terms with zero area are pruned, so k mutually disjoint
-- shapes cost O(k^2) clips, while k mutually overlapping fractional shapes can
-- need up to 2^k terms: the term list is capped at MAX_TERMS (stats.capped counts
-- pixels where the cap bound; none in any measured scene).
--
-- Usage per pixel (allocation-free after warm-up; module-level scratch):
--   Visibility.reset()
--   for each shape from the TOP of the stack down to just above the base:
--     Visibility.full(r, g, b, a)                  -- covers the whole pixel
--     or Visibility.begin(r, g, b, a)               -- partly covers it, then pieces:
--          Visibility.square(sign) / rect(sign, x0, y0, x1, y1) / poly(sign, xs, ys, n)
--          Visibility.clip(nx, ny, c)               -- keep {nx x + ny y <= c}
--          Visibility.disc(cx, cy, r)               -- intersect with a disc
--          Visibility.piece()                       -- store the piece
--        Visibility.commit()
--   r, g, b, a = Visibility.finish(baseR, baseG, baseB, baseA)   -- straight alpha
-- Colours are 0..255 floats, alphas 0..1. Deterministic ops only (+ - * / sqrt,
-- comparisons, and Coverage.dasin through the disc areas).

local Coverage = require("./Coverage")

local Visibility = {}

local clipInto = Coverage.clipInto
local polyArea = Coverage.polyArea
local discPolyArea = Coverage.discPolyArea

local MAX_TERMS = 1024
Visibility.MAX_TERMS = MAX_TERMS

export type Stats = { pixels: number, terms: number, areas: number, capped: number }
local stats: Stats = { pixels = 0, terms = 0, areas = 0, capped = 0 }
Visibility.stats = stats

function Visibility.resetStats()
	stats.pixels, stats.terms, stats.areas, stats.capped = 0, 0, 0, 0
end

-- pieces of the current entry
local PS: { number } = table.create(32, 0) -- sign
local PV0: { number } = table.create(32, 0) -- first vertex in PX, PY
local PN: { number } = table.create(32, 0) -- vertex count
local PD: { number } = table.create(32, 0) -- 1: has a disc
local PDX: { number } = table.create(32, 0)
local PDY: { number } = table.create(32, 0)
local PDR: { number } = table.create(32, 0)
local PX: { number } = table.create(512, 0)
local PY: { number } = table.create(512, 0)
local nP, nPV = 0, 0

-- terms of nu
local TW: { number } = table.create(256, 0) -- weight
local TA: { number } = table.create(256, 0) -- area
local TV0: { number } = table.create(256, 0)
local TN: { number } = table.create(256, 0)
local TD0: { number } = table.create(256, 0)
local TND: { number } = table.create(256, 0)
local TX: { number } = table.create(2048, 0)
local TY: { number } = table.create(2048, 0)
local TDX: { number } = table.create(512, 0)
local TDY: { number } = table.create(512, 0)
local TDR: { number } = table.create(512, 0)
local nT, nTV, nTD = 0, 0, 0

local accR, accG, accB, accA = 0, 0, 0, 0
local eR, eG, eB, eA = 0, 0, 0, 0

-- piece under construction (ping-pong clip buffers)
local AX: { number } = table.create(64, 0)
local AY: { number } = table.create(64, 0)
local BX: { number } = table.create(64, 0)
local BY: { number } = table.create(64, 0)
local cur = 0 -- 0: current polygon in A, 1: in B
local wn = 0
local wSign, wDisc, wDX, wDY, wDR = 0, 0, 0, 0, 0

-- region measurement scratch
local VX: { number } = table.create(64, 0)
local VY: { number } = table.create(64, 0)
local UX: { number } = table.create(64, 0)
local UY: { number } = table.create(64, 0)
local CX: { number } = table.create(64, 0)
local CY: { number } = table.create(64, 0)
local DX2: { number } = table.create(64, 0)
local DY2: { number } = table.create(64, 0)
local KX: { number } = table.create(16, 0)
local KY: { number } = table.create(16, 0)
local KR: { number } = table.create(16, 0)

function Visibility.reset()
	stats.pixels += 1
	-- one term: the whole pixel, weight 1, area 1, no discs
	TX[1], TY[1] = -0.5, -0.5
	TX[2], TY[2] = 0.5, -0.5
	TX[3], TY[3] = 0.5, 0.5
	TX[4], TY[4] = -0.5, 0.5
	TW[1], TA[1], TV0[1], TN[1], TD0[1], TND[1] = 1, 1, 1, 4, 1, 0
	nT, nTV, nTD = 1, 4, 0
	accR, accG, accB, accA = 0, 0, 0, 0
end

-- A shape that covers the whole pixel with straight colour (r, g, b), alpha a < 1.
function Visibility.full(r: number, g: number, b: number, a: number)
	local W = 0
	for t = 1, nT do
		W += TW[t] * TA[t]
	end
	local k = a * W
	accR += r * k
	accG += g * k
	accB += b * k
	accA += k
	local f = 1 - a
	for t = 1, nT do
		TW[t] *= f
	end
end

-- Starts a shape that covers the pixel partly; its pieces follow. area (optional):
-- the shape's exact area in the pixel, already known to the caller (its F1
-- coverage); when the shape turns out to be one positive piece, that is its
-- intersection with the whole-pixel term and is not recomputed.
local eArea = -1
function Visibility.begin(r: number, g: number, b: number, a: number, area: number?)
	eR, eG, eB, eA = r, g, b, a
	nP, nPV = 0, 0
	eArea = area or -1
end

-- Piece construction ---------------------------------------------------------------

-- Starts a piece equal to the whole pixel square.
function Visibility.square(sign: number)
	AX[1], AY[1] = -0.5, -0.5
	AX[2], AY[2] = 0.5, -0.5
	AX[3], AY[3] = 0.5, 0.5
	AX[4], AY[4] = -0.5, 0.5
	cur, wn = 0, 4
	wSign, wDisc = sign, 0
end

-- Starts a piece equal to the rectangle [x0, x1] x [y0, y1] clipped to the pixel.
function Visibility.rect(sign: number, x0: number, y0: number, x1: number, y1: number)
	if x0 < -0.5 then
		x0 = -0.5
	end
	if y0 < -0.5 then
		y0 = -0.5
	end
	if x1 > 0.5 then
		x1 = 0.5
	end
	if y1 > 0.5 then
		y1 = 0.5
	end
	wSign, wDisc, cur = sign, 0, 0
	if x1 <= x0 or y1 <= y0 then
		wn = 0
		return
	end
	AX[1], AY[1] = x0, y0
	AX[2], AY[2] = x1, y0
	AX[3], AY[3] = x1, y1
	AX[4], AY[4] = x0, y1
	wn = 4
end

-- Starts a piece equal to the convex polygon xs, ys [1..n] (positive orientation:
-- every edge has the interior on its left), which must lie inside the pixel.
function Visibility.poly(sign: number, xs: { number }, ys: { number }, n: number)
	for i = 1, n do
		AX[i], AY[i] = xs[i], ys[i]
	end
	cur, wn = 0, n
	wSign, wDisc = sign, 0
end

-- Clips the piece under construction to {nx x + ny y <= c}.
function Visibility.clip(nx: number, ny: number, c: number)
	if wn < 3 then
		wn = 0
		return
	end
	if cur == 0 then
		wn = clipInto(AX, AY, wn, BX, BY, nx, ny, c)
		cur = 1
	else
		wn = clipInto(BX, BY, wn, AX, AY, nx, ny, c)
		cur = 0
	end
end

-- Intersects the piece under construction with the disc (cx, cy, r).
function Visibility.disc(cx: number, cy: number, r: number)
	wDisc, wDX, wDY, wDR = 1, cx, cy, r
end

-- Stores the piece under construction (dropped when its polygon is empty).
function Visibility.piece()
	if wn < 3 then
		return
	end
	local X, Y = AX, AY
	if cur == 1 then
		X, Y = BX, BY
	end
	if polyArea(X, Y, wn) <= 0 then
		return
	end
	nP += 1
	PS[nP] = wSign
	PV0[nP] = nPV + 1
	PN[nP] = wn
	for i = 1, wn do
		PX[nPV + i], PY[nPV + i] = X[i], Y[i]
	end
	nPV += wn
	PD[nP] = wDisc
	PDX[nP], PDY[nP], PDR[nP] = wDX, wDY, wDR
end

-- Pieces of one closed polygon contour (pixel-local coordinates, any size; it is
-- clipped to the pixel here) whose signed winding number, times sigma, is its
-- contribution to the shape's indicator (sigma = the shape's orientation, so a
-- simple polygon of either orientation, or a path whose holes wind the other way,
-- contributes exactly 1 inside). A convex clip becomes one piece; otherwise the
-- winding number of the clip is the sum of its fan triangles' signed indicators.
local GX: { number } = table.create(64, 0)
local GY: { number } = table.create(64, 0)
local HX: { number } = table.create(64, 0)
local HY: { number } = table.create(64, 0)
local TRX: { number } = table.create(3, 0)
local TRY: { number } = table.create(3, 0)

function Visibility.polygon(xs: { number }, ys: { number }, n: number, sigma: number)
	local m = clipInto(xs, ys, n, HX, HY, 1, 0, 0.5)
	m = clipInto(HX, HY, m, GX, GY, -1, 0, 0.5)
	m = clipInto(GX, GY, m, HX, HY, 0, 1, 0.5)
	m = clipInto(HX, HY, m, GX, GY, 0, -1, 0.5)
	if m < 3 then
		return
	end
	local A = polyArea(GX, GY, m)
	if A == 0 then
		return
	end
	local sg = sigma
	if A < 0 then
		-- reverse to positive orientation; the winding inside the clip is then +1
		sg = -sigma
		local i, j = 1, m
		while i < j do
			GX[i], GX[j] = GX[j], GX[i]
			GY[i], GY[j] = GY[j], GY[i]
			i += 1
			j -= 1
		end
	end
	local convex = true
	local ax, ay = GX[m - 1], GY[m - 1]
	local bx, by = GX[m], GY[m]
	for i = 1, m do
		local cx, cy = GX[i], GY[i]
		if (bx - ax) * (cy - by) - (by - ay) * (cx - bx) < -1e-12 then
			convex = false
			break
		end
		ax, ay, bx, by = bx, by, cx, cy
	end
	if convex then
		Visibility.poly(sg, GX, GY, m)
		Visibility.piece()
		return
	end
	-- winding number of the closed clip = sum of signed fan triangles
	local x0, y0 = GX[1], GY[1]
	for i = 2, m - 1 do
		local x1, y1, x2, y2 = GX[i], GY[i], GX[i + 1], GY[i + 1]
		local t = (x1 - x0) * (y2 - y0) - (y1 - y0) * (x2 - x0)
		if t > 0 then
			TRX[1], TRY[1], TRX[2], TRY[2], TRX[3], TRY[3] = x0, y0, x1, y1, x2, y2
			Visibility.poly(sg, TRX, TRY, 3)
			Visibility.piece()
		elseif t < 0 then
			TRX[1], TRY[1], TRX[2], TRY[2], TRX[3], TRY[3] = x0, y0, x2, y2, x1, y1
			Visibility.poly(-sg, TRX, TRY, 3)
			Visibility.piece()
		end
	end
end

-- Region areas ---------------------------------------------------------------------

-- Area of polygon (px, py)[1..m] intersected with discs K[1..k] (power cells), and
-- the number of discs kept in K[1..]. Discs that contain the (convex) polygon are
-- dropped first (they do not change the region) and a disc that misses its
-- bounding box makes the area 0, so most regions need one disc area or none.
local function regionArea(px: { number }, py: { number }, m: number, k: number): (number, number)
	stats.areas += 1
	if k > 0 then
		local x0, y0, x1, y1 = px[1], py[1], px[1], py[1]
		for v = 2, m do
			local x, y = px[v], py[v]
			if x < x0 then
				x0 = x
			elseif x > x1 then
				x1 = x
			end
			if y < y0 then
				y0 = y
			elseif y > y1 then
				y1 = y
			end
		end
		local k2 = 0
		for i = 1, k do
			local cx, cy, r = KX[i], KY[i], KR[i]
			if cx - r >= x1 or cx + r <= x0 or cy - r >= y1 or cy + r <= y0 then
				return 0, 0
			end
			local r2 = r * r
			local all = true
			for v = 1, m do
				local dx, dy = px[v] - cx, py[v] - cy
				if dx * dx + dy * dy > r2 then
					all = false
					break
				end
			end
			if not all then
				k2 += 1
				KX[k2], KY[k2], KR[k2] = cx, cy, r
			end
		end
		k = k2
	end
	if k == 0 then
		return polyArea(px, py, m), 0
	elseif k == 1 then
		if m == 4 and ((px[1] == px[4] and px[2] == px[3] and py[1] == py[2] and py[3] == py[4]) or (px[1] == px[2] and px[3] == px[4] and py[2] == py[3] and py[4] == py[1])) then
			-- an axis-aligned rectangle (the pixel, a box piece): quadrant integration
			local x0 = if px[1] < px[3] then px[1] else px[3]
			local x1 = if px[1] < px[3] then px[3] else px[1]
			local y0 = if py[1] < py[3] then py[1] else py[3]
			local y1 = if py[1] < py[3] then py[3] else py[1]
			return Coverage.discBoxArea(KX[1], KY[1], KR[1], x0, y0, x1, y1), 1
		end
		return discPolyArea(px, py, m, KX[1], KY[1], KR[1]), 1
	end
	local total = 0
	for i = 1, k do
		local xi, yi, ri = KX[i], KY[i], KR[i]
		local powi = xi * xi + yi * yi - ri * ri
		for v = 1, m do
			CX[v], CY[v] = px[v], py[v]
		end
		local n = m
		local inC = true -- current cell polygon is in CX/CY (else DX2/DY2)
		local empty = false
		for j = 1, k do
			if j ~= i then
				local xj, yj, rj = KX[j], KY[j], KR[j]
				-- p_i >= p_j  <=>  2 (c_i - c_j) . q <= (|c_i|^2 - r_i^2) - (|c_j|^2 - r_j^2)
				local nx, ny = 2 * (xi - xj), 2 * (yi - yj)
				local c = powi - (xj * xj + yj * yj - rj * rj)
				if nx == 0 and ny == 0 then
					if not (c > 0 or (c == 0 and j > i)) then
						empty = true
						break
					end
				else
					if inC then
						n = clipInto(CX, CY, n, DX2, DY2, nx, ny, c)
					else
						n = clipInto(DX2, DY2, n, CX, CY, nx, ny, c)
					end
					inC = not inC
					if n < 3 then
						empty = true
						break
					end
				end
			end
		end
		if not empty then
			if inC then
				total += discPolyArea(CX, CY, n, xi, yi, ri)
			else
				total += discPolyArea(DX2, DY2, n, xi, yi, ri)
			end
		end
	end
	return total, k
end

-- Processes the shape begun with Visibility.begin against every current term.
function Visibility.commit()
	local nOld = nT
	local contrib = 0
	for t = 1, nOld do
		local wt = TW[t]
		if wt == 0 then
			continue
		end
		for p = 1, nP do
			-- polygon of term t intersected with piece p (both convex)
			local X, Y = VX, VY
			local m
			local p0, pn = PV0[p], PN[p]
			if t == 1 then
				-- term 1 is the whole pixel; pieces already lie inside it
				for v = 1, pn do
					VX[v], VY[v] = PX[p0 + v - 1], PY[p0 + v - 1]
				end
				m = pn
			else
				local t0 = TV0[t]
				m = TN[t]
				for v = 1, m do
					VX[v], VY[v] = TX[t0 + v - 1], TY[t0 + v - 1]
				end
				local qx, qy = PX[p0 + pn - 1], PY[p0 + pn - 1]
				for v = 0, pn - 1 do
					local rx, ry = PX[p0 + v], PY[p0 + v]
					local ex, ey = rx - qx, ry - qy
					-- interior on the left: cross(e, q - P) >= 0  <=>  ey x - ex y <= ey Px - ex Py
					local c = ey * qx - ex * qy
					if X == VX then
						m = clipInto(VX, VY, m, UX, UY, ey, -ex, c)
						X, Y = UX, UY
					else
						m = clipInto(UX, UY, m, VX, VY, ey, -ex, c)
						X, Y = VX, VY
					end
					if m < 3 then
						break
					end
					qx, qy = rx, ry
				end
			end
			if m < 3 then
				continue
			end
			-- discs of the region: the term's and the piece's
			local k = 0
			local d0 = TD0[t]
			for i = d0, d0 + TND[t] - 1 do
				k += 1
				KX[k], KY[k], KR[k] = TDX[i], TDY[i], TDR[i]
			end
			if PD[p] == 1 then
				k += 1
				KX[k], KY[k], KR[k] = PDX[p], PDY[p], PDR[p]
			end
			local a
			if t == 1 and nP == 1 and PS[1] == 1 and eArea >= 0 then
				a = eArea
			else
				local kept
				a, kept = regionArea(X, Y, m, k)
				k = kept
			end
			if a <= 0 then
				continue
			end
			local sw = PS[p] * wt
			contrib += sw * a
			if nT >= MAX_TERMS then
				stats.capped += 1
				continue
			end
			nT += 1
			stats.terms += 1
			TW[nT] = -eA * sw
			TA[nT] = a
			TV0[nT] = nTV + 1
			TN[nT] = m
			for v = 1, m do
				TX[nTV + v], TY[nTV + v] = X[v], Y[v]
			end
			nTV += m
			TD0[nT] = nTD + 1
			TND[nT] = k
			for i = 1, k do
				TDX[nTD + i], TDY[nTD + i], TDR[nTD + i] = KX[i], KY[i], KR[i]
			end
			nTD += k
		end
	end
	local f = eA * contrib
	accR += eR * f
	accG += eG * f
	accB += eB * f
	accA += f
end

-- Adds the base below the stack (straight colour, alpha) and returns the exact
-- composite in straight alpha: r, g, b in 0..255, a in 0..1.
function Visibility.finish(r: number, g: number, b: number, a: number): (number, number, number, number)
	local W = 0
	for t = 1, nT do
		W += TW[t] * TA[t]
	end
	local k = a * W
	local R, G, B, A = accR + r * k, accG + g * k, accB + b * k, accA + k
	if A <= 0 then
		return r, g, b, 0
	end
	return R / A, G / A, B / A, if A > 1 then 1 else A
end

-- The premultiplied integrals accumulated so far (for tests): r, g, b, a.
function Visibility.accumulated(): (number, number, number, number)
	return accR, accG, accB, accA
end

return Visibility
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="48">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="49">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">Bake</string>
          <string name="Source"><![CDATA[--!strict
-- Universe at Home: Meadow :: Bake (server)
--
-- AssetService:CreateDataModelContentAsync turns an EditableImage or EditableMesh into
-- DataModel-scoped Opaque content that replicates to clients, gets real mips, and does
-- not count against client editable budgets (docs/RUNTIME_AUDIT.md section 3). It
-- returns (Enum.CreateContentResult, Content). Every caller has a fallback, because
-- an unbaked server EditableImage must never be assigned to a replicating instance
-- (clients would see the placeholder checkerboard).

local AssetService = game:GetService("AssetService")

local Bake = {}

Bake.attempts = 0
Bake.successes = 0
Bake.lastError = nil :: string?

-- Returns (content, nil) on success or (nil, reason).
function Bake.object(object: EditableImage | EditableMesh): (Content?, string?)
	Bake.attempts += 1
	local ok, result, content = pcall(function(): (any, any)
		return AssetService:CreateDataModelContentAsync(Content.fromObject(object))
	end)
	if not ok then
		Bake.lastError = tostring(result)
		return nil, "CreateDataModelContentAsync threw: " .. tostring(result)
	end
	if result ~= Enum.CreateContentResult.Success then
		Bake.lastError = tostring(result)
		return nil, "CreateDataModelContentAsync returned " .. tostring(result)
	end
	if typeof(content) ~= "Content" then
		Bake.lastError = "no Content returned"
		return nil, "no Content returned"
	end
	Bake.successes += 1
	return content :: Content, nil
end

-- Writes an RGBA8 buffer into a new EditableImage and bakes it. The source image is
-- kept alive (returned) because whether it may be destroyed right after baking is
-- NOT PUBLICLY SPECIFIED.
function Bake.pixels(width: number, height: number, pixels: buffer): (Content?, EditableImage?, string?)
	local img = AssetService:CreateEditableImage({ Size = Vector2.new(width, height) })
	if not img then
		return nil, nil, "CreateEditableImage returned nil"
	end
	img:WritePixelsBuffer(Vector2.zero, Vector2.new(width, height), pixels)
	local content, why = Bake.object(img)
	return content, img, why
end

return Bake
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="51">
        <Properties>
          <string name="Name">Environment</string>
          <string name="Source"><![CDATA[--!strict
-- Universe at Home: Meadow :: Environment
--
-- Runtime half of the look. The project file sets what scripts cannot
-- (Lighting.Technology, Terrain.Decoration, Terrain.GrassLength are NotScriptable)
-- and the effect instances; this module sets the scriptable rest, recreates any
-- effect that is missing (so an edited place still looks right) and reports.

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Demo = ReplicatedStorage:WaitForChild("Demo")
local Config = require(Demo:WaitForChild("Config"))

local Environment = {}

local function rgb(t: { number }): Color3
	return Color3.fromRGB(t[1], t[2], t[3])
end

local function ensure(parent: Instance, className: string, name: string, init: (Instance) -> ()): (Instance, boolean)
	local existing = parent:FindFirstChild(name)
	if existing and existing.ClassName == className then
		return existing, false
	end
	local inst = Instance.new(className)
	inst.Name = name
	init(inst)
	inst.Parent = parent
	return inst, true
end

-- Returns a one-line summary; throws only on unexpected engine errors.
function Environment.apply(): string
	local notes: { string } = {}
	Lighting.ClockTime = Config.lighting.clockTime
	Lighting.GeographicLatitude = Config.lighting.geographicLatitude

	local created = 0
	local _, c1 = ensure(Lighting, "Atmosphere", "Atmosphere", function(i: Instance)
		local a = i :: Atmosphere
		a.Density = 0.32
		a.Offset = 0.12
		a.Color = Color3.fromRGB(214, 190, 168)
		a.Decay = Color3.fromRGB(120, 104, 112)
		a.Glare = 0.45
		a.Haze = 1.6
	end)
	local _, c2 = ensure(Lighting, "Sky", "Sky", function(i: Instance)
		local s = i :: Sky
		s.CelestialBodiesShown = true
		s.SunAngularSize = 14
		s.StarCount = 1500
	end)
	local _, c3 = ensure(Lighting, "BloomEffect", "Bloom", function(i: Instance)
		local b = i :: BloomEffect
		b.Intensity = 0.6
		b.Size = 28
		b.Threshold = 1.4
	end)
	local _, c4 = ensure(Lighting, "SunRaysEffect", "SunRays", function(i: Instance)
		local s = i :: SunRaysEffect
		s.Intensity = 0.06
		s.Spread = 0.55
	end)
	local _, c5 = ensure(Lighting, "ColorCorrectionEffect", "ColorCorrection", function(i: Instance)
		local c = i :: ColorCorrectionEffect
		c.Brightness = 0.02
		c.Contrast = 0.12
		c.Saturation = 0.12
		c.TintColor = Color3.fromRGB(255, 244, 230)
	end)
	local _, c6 = ensure(Lighting, "DepthOfFieldEffect", "DepthOfField", function(i: Instance)
		local d = i :: DepthOfFieldEffect
		d.FarIntensity = 0.12
		d.FocusDistance = 40
		d.InFocusRadius = 60
		d.NearIntensity = 0
	end)
	for _, c in { c1, c2, c3, c4, c5, c6 } do
		if c then
			created += 1
		end
	end
	if created > 0 then
		table.insert(notes, string.format("%d effect(s) were missing and were recreated", created))
	end

	local terrain = Workspace.Terrain
	local t = Config.terrain
	terrain.WaterColor = rgb(t.waterColor)
	terrain.WaterTransparency = t.waterTransparency
	terrain.WaterReflectance = t.waterReflectance
	terrain.WaterWaveSize = t.waterWaveSize
	terrain.WaterWaveSpeed = t.waterWaveSpeed
	local colored = 0
	for name, color in (t.materialColors :: { [string]: { number } }) do
		local ok = pcall(function()
			terrain:SetMaterialColor((Enum.Material :: any)[name], rgb(color))
		end)
		if ok then
			colored += 1
		else
			table.insert(notes, "SetMaterialColor failed for " .. name)
		end
	end
	ensure(terrain, "Clouds", "Clouds", function(i: Instance)
		local c = i :: Clouds
		c.Cover = 0.58
		c.Density = 0.72
		c.Color = Color3.fromRGB(255, 238, 222)
	end)
	-- Terrain.Decoration and GrassLength are NotScriptable (API dump): they come from the
	-- project file and cannot even be read here.
	table.insert(notes, string.format("ClockTime %.2f, %d material colours", Lighting.ClockTime, colored))
	return table.concat(notes, "; ")
end

return Environment
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">GrassBaker</string>
          <string name="Source"><![CDATA[--!strict
-- Universe at Home: Meadow :: GrassBaker (server)
--
-- "Static ones are baked" (docs/DEMO.md section 3, Budget): the ring-1 shell masks
-- and the four ring-0 variant meshes never change, so the server generates them
-- (native codegen; masks in the server Actors) and bakes them. Clients then use them
-- with zero editable budget:
--   ReplicatedStorage.DemoBaked.ShellMasks.L01..L12   Decals whose TextureContent is
--                                                     the baked mask
--   ReplicatedStorage.DemoBaked.GrassVariants.A/A2/B/C MeshParts with baked meshes
-- Clients that find nothing here build both themselves.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local AssetService = game:GetService("AssetService")

local Demo = ReplicatedStorage:WaitForChild("Demo")
local Config = require(Demo:WaitForChild("Config"))
local GrassGen = require(Demo:WaitForChild("GrassGen"))
local GrassMesh = require(Demo:WaitForChild("GrassMesh"))
local WorkerPool = require(Demo:WaitForChild("WorkerPool"))
local Status = require(Demo:WaitForChild("Status"))
local Bake = require(script.Parent:WaitForChild("Bake"))

local GrassBaker = {}

GrassBaker.keep = {} :: { any }

local function bakedFolder(name: string): Folder
	local root = ReplicatedStorage:FindFirstChild("DemoBaked")
	if not root then
		local f = Instance.new("Folder")
		f.Name = "DemoBaked"
		f.Parent = ReplicatedStorage
		root = f
	end
	assert(root)
	local existing = root:FindFirstChild(name)
	if existing and existing:IsA("Folder") then
		return existing
	end
	local f = Instance.new("Folder")
	f.Name = name
	-- not parented yet: clients wait for the folder, so it appears complete
	return f
end

function GrassBaker.masks(reg: Status.Registry, pool: WorkerPool.Pool): (Status.State, string)
	local g = Config.grass
	local K = g.shellCount
	local size = g.shellTexture
	local folder = bakedFolder("ShellMasks")
	local pending = K
	local results: { buffer? } = table.create(K)
	local how = "?"
	local t0 = os.clock()
	for k = 1, K do
		WorkerPool.submit(pool, "shellMask", {
			k = k - 1,
			layers = K,
			size = size,
			seed = 3,
			count = g.shellBlades,
			radius = g.shellBladeRadius,
			lean = g.shellLeanPx,
		}, function(ok: boolean, res: any)
			pending -= 1
			if ok and type(res) == "table" then
				results[res.k + 1] = res.pixels
				how = res.how
			end
		end)
	end
	while pending > 0 and os.clock() - t0 < 120 do
		task.wait(0.05)
	end
	local renderSeconds = os.clock() - t0
	for k = 1, K do
		local px = results[k]
		if not px then
			return "fallback", string.format("mask %d not rendered; clients render their own", k)
		end
		local content, img, why = Bake.pixels(size, size, px)
		if not content then
			if img then
				img:Destroy()
			end
			return "fallback", "masks not baked (" .. tostring(why) .. "); clients render their own"
		end
		table.insert(GrassBaker.keep, img)
		local d = Instance.new("Decal")
		d.Name = string.format("L%02d", k)
		d.TextureContent = content
		d.Parent = folder
	end
	folder.Parent = ReplicatedStorage:FindFirstChild("DemoBaked")
	return "ok", string.format("%d masks %dx%d (%s) rendered in %.1f s, baked", K, size, size, how, renderSeconds)
end

function GrassBaker.variants(reg: Status.Registry): (Status.State, string)
	local folder = bakedFolder("GrassVariants")
	local tris = 0
	for v, spec in GrassGen.VARIANTS do
		local patch = GrassGen.patch(GrassGen.variantOptions(Config.grass, v, 1))
		local built, why = GrassMesh.buildPatch(AssetService, patch :: any, GrassGen.PALETTE, GrassGen.NORMALS)
		if not built then
			return "fallback", "variant " .. spec.name .. " not built (" .. tostring(why) .. "); clients build their own"
		end
		local content, bwhy = Bake.object(built.mesh)
		if not content then
			built.mesh:Destroy()
			return "fallback", "variant meshes not baked (" .. tostring(bwhy) .. "); clients build their own"
		end
		table.insert(GrassBaker.keep, built.mesh)
		local part = GrassMesh.makePart(AssetService, content, spec.name, true)
		part.Transparency = 1
		part.Parent = folder
		tris += patch.triangleCount
		task.wait()
	end
	folder.Parent = ReplicatedStorage:FindFirstChild("DemoBaked")
	return "ok", string.format("4 variant meshes baked (%d triangles in total)", tris)
end

return GrassBaker
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="53">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Universe at Home: Meadow :: server entry point (ServerScriptService.Server.Main)
--
-- Starts every server stage inside Status.stage (pcall + Output line + capabilities
-- mirror + fallback), so one broken feature never takes down the rest:
--   environment, remotes, worker pool (8 worldgen Actors), terrain, spawn, sky bake,
--   rocks, determinism referee and server training (stress bench T9, T10).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local Demo = ReplicatedStorage:WaitForChild("Demo")
local Config = require(Demo:WaitForChild("Config"))
local Status = require(Demo:WaitForChild("Status"))
local Net = require(Demo:WaitForChild("Net"))
local WorkerPool = require(Demo:WaitForChild("WorkerPool"))

local Server = script.Parent :: Instance

-- Replicated status mirror (attributes read by every client's HUD).
local mirror = ReplicatedStorage:FindFirstChild("DemoStatus")
if not mirror then
	local f = Instance.new("Folder")
	f.Name = "DemoStatus"
	f.Parent = ReplicatedStorage
	mirror = f
end
assert(mirror, "DemoStatus")
local statusFolder: Instance = mirror
statusFolder:SetAttribute("WorldStage", "starting")
statusFolder:SetAttribute("WorldProgress", 0)
statusFolder:SetAttribute("WorldReady", false)
statusFolder:SetAttribute("ServerVersion", Config.VERSION)
statusFolder:SetAttribute("ServerStudio", RunService:IsStudio())

local reg = Status.registry("server", statusFolder)
Status.set(reg, "server_start", "info", "Universe at Home: Meadow " .. Config.VERSION)

-- Optional modules: a missing or broken one becomes a failed stage, not a crash.
local function optionalRequire(name: string): any
	local m = Server:FindFirstChild(name)
	if not m or not m:IsA("ModuleScript") then
		return nil
	end
	local ok, result = pcall(require, m)
	if ok then
		return result
	end
	Status.set(reg, "module_" .. name, "failed", tostring(result))
	return nil
end

-- Remotes ---------------------------------------------------------------------------
Status.stage(reg, "remotes", function()
	Net.serverInit(ReplicatedStorage, function(className: string): any
		return Instance.new(className :: any)
	end)
	return "ok", "RemoteEvents in ReplicatedStorage." .. Net.FOLDER
end)

-- Players: characters load only once the ground under the spawn exists ---------------
local spawnReady = false
local spawnPosition = Vector3.new(0, 80, 0)

local function loadCharacter(player: Player)
	local ok, err = pcall(function()
		player:LoadCharacterAsync()
	end)
	if not ok then
		local ok2, err2 = pcall(function()
			(player :: any):LoadCharacter()
		end)
		if not ok2 then
			warn(string.format("%s|server|character|failed|%s; %s", Config.TAG, tostring(err), tostring(err2)))
		end
	end
end

local function hookPlayer(player: Player)
	player.CharacterAdded:Connect(function(character: Model)
		local humanoid = character:WaitForChild("Humanoid", 10)
		if humanoid and humanoid:IsA("Humanoid") then
			humanoid.Died:Connect(function()
				task.wait(Players.RespawnTime)
				if player.Parent then
					loadCharacter(player)
				end
			end)
		end
	end)
	if spawnReady and not player.Character then
		task.spawn(loadCharacter, player)
	end
end

Status.stage(reg, "players", function()
	Players.CharacterAutoLoads = false
	Players.PlayerAdded:Connect(hookPlayer)
	for _, p in Players:GetPlayers() do
		hookPlayer(p)
	end
	return "ok", "characters load when the spawn chunks are written"
end)

local function placeSpawn(pos: Vector3)
	spawnPosition = pos
	local old = Workspace:FindFirstChild("MeadowSpawn")
	if old then
		old:Destroy()
	end
	local s = Instance.new("SpawnLocation")
	s.Name = "MeadowSpawn"
	s.Anchored = true
	s.CanCollide = false
	s.CanQuery = false
	s.CanTouch = true
	s.Transparency = 1
	s.Size = Vector3.new(6, 1, 6)
	s.CFrame = CFrame.new(pos + Vector3.new(0, 1.5, 0))
	s.Neutral = true
	s.Duration = 0
	s.Parent = Workspace
end

local function onSpawnReady(pos: Vector3)
	if spawnReady then
		return
	end
	placeSpawn(pos)
	spawnReady = true
	statusFolder:SetAttribute("SpawnReady", true)
	for _, p in Players:GetPlayers() do
		if not p.Character then
			task.spawn(loadCharacter, p)
		end
	end
	Status.set(reg, "spawn", "ok", string.format("spawn at %.0f, %.0f, %.0f", pos.X, pos.Y, pos.Z))
end

-- Environment ------------------------------------------------------------------------
Status.stage(reg, "environment", function()
	local Environment = require(script.Parent:WaitForChild("Environment"))
	return "ok", Environment.apply()
end)

-- Server worker pool -------------------------------------------------------------------
local ServerJobs = optionalRequire("ServerJobs") or {}
local pool = WorkerPool.new("WorldGenPool", ServerJobs, Config.actors.jobTimeout)
Status.stage(reg, "actors_server", function()
	local workers = ServerScriptService:FindFirstChild("Workers")
	local template = workers and workers:FindFirstChild("ServerWorker")
	if not template then
		return "fallback", "no ServerScriptService.Workers.ServerWorker template; serial mode"
	end
	local container = Instance.new("Folder")
	container.Name = "WorkerPools"
	container.Parent = ServerScriptService
	local ready = WorkerPool.spawn(pool, template, container, Config.actors.serverWorldGen, 8)
	if ready == 0 then
		WorkerPool.destroy(pool)
		return "fallback", "no worker said hello within 8 s; generation runs serially"
	end
	return "ok", string.format("%d of %d worldgen Actors ready", ready, Config.actors.serverWorldGen)
end)
statusFolder:SetAttribute("ServerActors", pool.readyCount)

-- Terrain ----------------------------------------------------------------------------
local terrainResult: any = nil
task.spawn(function()
	local TerrainBuilder = require(script.Parent:WaitForChild("TerrainBuilder"))
	local ok = Status.stage(reg, "terrain", function()
		terrainResult = TerrainBuilder.run(reg, pool, statusFolder, onSpawnReady)
		return "ok", string.format("%d chunks in %.1f s (%s)", terrainResult.chunks, terrainResult.seconds, terrainResult.mode)
	end, function(message: string)
		local pos = TerrainBuilder.flatFallback(statusFolder)
		onSpawnReady(pos)
		return "fallback", "flat grass field: " .. message
	end)
	statusFolder:SetAttribute("TerrainOk", ok)
	-- Rocks need the final heights.
	local Rocks = optionalRequire("Rocks")
	if Rocks and terrainResult then
		Status.stage(reg, "rocks", function()
			return Rocks.run(reg, pool, terrainResult)
		end, function(message: string)
			return "fallback", "rocks skipped"
		end)
	elseif not Rocks then
		Status.set(reg, "rocks", "skipped", "Rocks module not present")
	end
end)

-- Watchdog: never leave players without a character.
task.delay(120, function()
	if not spawnReady then
		Status.set(reg, "spawn", "fallback", "terrain too slow; spawning on a platform")
		local p = Instance.new("Part")
		p.Name = "FallbackPlatform"
		p.Anchored = true
		p.Size = Vector3.new(40, 2, 40)
		p.Material = Enum.Material.Grass
		p.CFrame = CFrame.new(spawnPosition)
		p.Parent = Workspace
		onSpawnReady(spawnPosition + Vector3.new(0, 1, 0))
	end
end)

-- Sky ----------------------------------------------------------------------------------
task.spawn(function()
	local SkyBaker = optionalRequire("SkyBaker")
	if not SkyBaker then
		Status.set(reg, "sky", "fallback", "SkyBaker not present; default sky")
		return
	end
	Status.stage(reg, "sky", function()
		return SkyBaker.run(reg)
	end, function(message: string)
		return "fallback", "default sky"
	end)
end)

-- Static grass content baked for every client (ring 0 variants, ring 1 masks) ---------
task.spawn(function()
	local GrassBaker = optionalRequire("GrassBaker")
	if not GrassBaker then
		Status.set(reg, "bake_grass", "skipped", "GrassBaker not present; clients build grass content themselves")
		return
	end
	Status.stage(reg, "bake_variants", function()
		return GrassBaker.variants(reg)
	end, function(message: string)
		return "fallback", "clients build their own variant meshes"
	end)
	Status.stage(reg, "bake_masks", function()
		return GrassBaker.masks(reg, pool)
	end, function(message: string)
		return "fallback", "clients render their own shell masks"
	end)
	local Bake = optionalRequire("Bake")
	if Bake then
		statusFolder:SetAttribute("BakeAvailable", Bake.successes > 0)
		Status.set(
			reg,
			"baking",
			if Bake.successes > 0 then "ok" else "fallback",
			string.format("CreateDataModelContentAsync: %d of %d bakes succeeded%s", Bake.successes, Bake.attempts, if Bake.lastError then "; last error " .. tostring(Bake.lastError) else "")
		)
	end
end)

-- Clients say hello with a capability summary ------------------------------------------
Status.stage(reg, "hello", function()
	local hello = Net.serverGet(ReplicatedStorage, "Hello") :: RemoteEvent
	local lim = Net.LIMITS.Hello
	local limiter = Net.newLimiter(lim.rate, lim.burst)
	hello.OnServerEvent:Connect(function(player: Player, payload: any)
		if not Net.allow(limiter, player.UserId, os.clock()) then
			return
		end
		local ok, why = Net.validateHello(payload)
		if not ok then
			warn(string.format("%s|server|hello|rejected|%s: %s", Config.TAG, player.Name, tostring(why)))
			return
		end
		print(string.format("%s|server|client|info|%s v%s %s", Config.TAG, player.Name, payload.version, tostring(payload.summary or "")))
	end)
	Players.PlayerRemoving:Connect(function(player: Player)
		Net.forget(limiter, player.UserId)
	end)
	return "ok", "listening"
end)

-- Bench services (T9 referee, T10 training) -------------------------------------------
task.spawn(function()
	local Referee = optionalRequire("Referee")
	if Referee then
		Status.stage(reg, "referee", function()
			return Referee.start(reg)
		end)
	else
		Status.set(reg, "referee", "skipped", "Referee module not present")
	end
	local Training = optionalRequire("Training")
	if Training then
		Status.stage(reg, "training", function()
			return Training.start(reg, pool)
		end)
	else
		Status.set(reg, "training", "skipped", "Training module not present")
	end
end)

-- Periodic pool summary for the HUD.
task.spawn(function()
	while true do
		task.wait(1)
		statusFolder:SetAttribute("ServerPool", WorkerPool.describe(pool))
		statusFolder:SetAttribute("ServerBusyActors", WorkerPool.busyCount(pool))
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="54">
        <Properties>
          <string name="Name">Rocks</string>
          <string name="Source"><![CDATA[--!strict
-- Universe at Home: Meadow :: Rocks (server)
--
-- Boulders on the slopes around the meadow (docs/DEMO.md section 2): positions picked
-- deterministically from the final heightmap, geometry (noise-displaced icospheres,
-- RockGen) built by the server Actors in parallel, EditableMesh assembled serially,
-- baked with CreateDataModelContentAsync so the mesh replicates as static content and
-- costs clients no editable budget. Fallback per rock: a Terrain:FillBall boulder.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local AssetService = game:GetService("AssetService")

local Demo = ReplicatedStorage:WaitForChild("Demo")
local Config = require(Demo:WaitForChild("Config"))
local WorldGen = require(Demo:WaitForChild("WorldGen"))
local WorkerPool = require(Demo:WaitForChild("WorkerPool"))
local Status = require(Demo:WaitForChild("Status"))
local MyMath = require(ReplicatedStorage:WaitForChild("Universe"):WaitForChild("MyMath"))
local Bake = require(script.Parent:WaitForChild("Bake"))

local Rocks = {}

Rocks.keep = {} :: { EditableMesh }

type Spot = { x: number, y: number, z: number, radius: number, seed: number, slope: number }

-- Deterministic rock spots: hashed column order, slope and height rules, spacing.
function Rocks.spots(world: WorldGen.World, heights: buffer, count: number): { Spot }
	local n = world.columns
	local candidates: { { number } } = {}
	local sp = world.cfg.spawn
	for k = 2, n - 3, 2 do
		for i = 2, n - 3, 2 do
			local h = WorldGen.heightAt(world, heights, i, k)
			local s = WorldGen.slopeAt(world, heights, i, k)
			if h > world.waterLevel + 2 and h < world.cfg.snowLine - 20 and s > 0.3 and s < 1.1 then
				local x, z = WorldGen.columnCenter(world, i, k)
				local dx, dz = x - sp.x, z - sp.z
				if dx * dx + dz * dz > 30 * 30 then
					table.insert(candidates, { MyMath.hash2(i, k, 4242), i, k })
				end
			end
		end
	end
	table.sort(candidates, function(a: { number }, b: { number }): boolean
		return a[1] < b[1]
	end)
	local out: { Spot } = {}
	local cfg = Config.rocks
	for _, c in candidates do
		if #out >= count then
			break
		end
		local i, k = c[2], c[3]
		local x, z = WorldGen.columnCenter(world, i, k)
		local far = true
		for _, o in out do
			local dx, dz = o.x - x, o.z - z
			if dx * dx + dz * dz < 26 * 26 then
				far = false
				break
			end
		end
		if far then
			local r = cfg.minRadius + (c[1] % 1000) / 1000 * (cfg.maxRadius - cfg.minRadius)
			table.insert(out, {
				x = x,
				y = WorldGen.heightAt(world, heights, i, k),
				z = z,
				radius = r,
				seed = c[1] % 1000003,
				slope = WorldGen.slopeAt(world, heights, i, k),
			})
		end
	end
	return out
end

-- Builds the rock mesh centred on its bounding box (so the MeshPart placement does
-- not depend on how the engine anchors an EditableMesh) and returns its half height.
local function buildMesh(rock: any): (EditableMesh?, number)
	local mesh = AssetService:CreateEditableMesh()
	if not mesh then
		return nil, 0
	end
	local n = rock.vertexCount
	local pos = table.create(n)
	local p = rock.positions
	local lo, hi = Vector3.new(math.huge, math.huge, math.huge), Vector3.new(-math.huge, -math.huge, -math.huge)
	for v = 1, n do
		local q = Vector3.new(p[3 * v - 2], p[3 * v - 1], p[3 * v])
		lo, hi = lo:Min(q), hi:Max(q)
	end
	local c = (lo + hi) * 0.5
	for v = 1, n do
		pos[v] = Vector3.new(p[3 * v - 2], p[3 * v - 1], p[3 * v]) - c
	end
	local ok = pcall(function()
		local vIds = mesh:BatchAdd(Enum.MeshAttribute.Vertex, pos) :: { number }
		local faces = table.create(rock.triangleCount)
		local tris = rock.triangles
		for t = 1, rock.triangleCount do
			faces[t] = { vIds[tris[3 * t - 2]], vIds[tris[3 * t - 1]], vIds[tris[3 * t]] }
		end
		local fIds = mesh:BatchAdd(Enum.MeshAttribute.Face, faces) :: { number }
		local colorIds = table.create(n)
		local c = rock.colors
		for v = 1, n do
			colorIds[v] = mesh:AddColor(Color3.new(c[3 * v - 2], c[3 * v - 1], c[3 * v]), 1)
		end
		local faceColors = table.create(rock.triangleCount)
		for t = 1, rock.triangleCount do
			faceColors[t] = { colorIds[tris[3 * t - 2]], colorIds[tris[3 * t - 1]], colorIds[tris[3 * t]] }
		end
		mesh:BatchSetFaceAttributes(fIds, faceColors)
		mesh:RemoveUnused()
	end)
	if not ok then
		mesh:Destroy()
		return nil, 0
	end
	return mesh, (hi.Y - lo.Y) * 0.5
end

function Rocks.run(reg: Status.Registry, pool: WorkerPool.Pool, terrain: any): (Status.State, string)
	local cfg = Config.rocks
	local spots = Rocks.spots(terrain.world, terrain.heights, cfg.count)
	local folder = Instance.new("Folder")
	folder.Name = "Rocks"
	folder.Parent = Workspace
	local pending = #spots
	local meshes, filled, failed = 0, 0, 0
	local firstError: string? = nil
	for idx, s in spots do
		WorkerPool.submit(pool, "rock", { seed = s.seed, radius = s.radius, subdivisions = cfg.subdivisions, roughness = cfg.roughness }, function(ok: boolean, rock: any)
			local placed = false
			if ok and type(rock) == "table" then
				local mesh, halfHeight = buildMesh(rock)
				if mesh then
					local content, why = Bake.object(mesh)
					if content then
						local pok, perr = pcall(function()
							local part = AssetService:CreateMeshPartAsync(content, {
								CollisionFidelity = Enum.CollisionFidelity.Hull,
								RenderFidelity = Enum.RenderFidelity.Precise,
							})
							part.Name = string.format("Rock%02d", idx)
							part.Anchored = true
							part.Material = Enum.Material.SmoothPlastic
							part.Color = Color3.new(1, 1, 1)
							part.CastShadow = true
							local yaw = (s.seed % 360) / 360
							-- sink the flat underside a little into the slope
							part.CFrame = CFrame.new(s.x, s.y + halfHeight - 0.25 * halfHeight - 0.4, s.z)
								* CFrame.Angles(0, yaw * 6.283185307179586, 0)
							part.Parent = folder
						end)
						if pok then
							placed = true
							meshes += 1
							table.insert(Rocks.keep, mesh)
						else
							firstError = firstError or tostring(perr)
							mesh:Destroy()
						end
					else
						firstError = firstError or why
						mesh:Destroy()
					end
				else
					firstError = firstError or "CreateEditableMesh or batch build failed"
				end
			else
				firstError = firstError or tostring(rock)
			end
			if not placed then
				local fok = pcall(function()
					Workspace.Terrain:FillBall(Vector3.new(s.x, s.y + s.radius * 0.2, s.z), s.radius * 0.75, Enum.Material.Rock)
				end)
				if fok then
					filled += 1
				else
					failed += 1
				end
			end
			pending -= 1
		end)
	end
	local t0 = os.clock()
	while pending > 0 and os.clock() - t0 < 120 do
		task.wait(0.05)
	end
	local detail = string.format("%d baked mesh rocks, %d terrain boulders (fallback), %d failed", meshes, filled, failed)
	if firstError then
		detail ..= "; first error: " .. firstError
	end
	if meshes == #spots then
		return "ok", detail
	end
	return "fallback", detail
end

return Rocks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="55">
        <Properties>
          <string name="Name">ServerJobs</string>
          <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2
-- Universe at Home: Meadow :: ServerJobs
--
-- Job handlers run by the server worker Actors (and inline by WorkerPool's serial
-- fallback). Pure computation in `parallel`; engine writes in `serial`, after
-- task.synchronize(). Kinds:
--   heights   rows [k0, k1) of base heights and carve targets (WorldGen stage 1)
--   setWorld  stores the eroded heightmap in the worker's state
--   chunk     builds one chunk's voxel arrays in parallel, writes them serially with
--             Terrain:WriteVoxelChannels (solid + liquid occupancy, clean shores) or,
--             if that call fails, Terrain:WriteVoxels (solid or water per voxel)
--   rock      builds a rock's vertex and triangle arrays (see Rocks.luau)
--   train     one slice of ALLAN statistics accumulation (see Training.luau)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Demo = ReplicatedStorage:WaitForChild("Demo")
local WorldGen = require(Demo:WaitForChild("WorldGen"))
local RockGen = require(Demo:WaitForChild("RockGen"))
local GrassGen = require(Demo:WaitForChild("GrassGen"))

local Jobs = {}

-- Enum.Material per WorldGen material index (+1), resolved once in the serial phase.
local MATERIALS: { Enum.Material } = {}
for i, name in WorldGen.MATERIAL_NAMES do
	local ok, m = pcall(function(): Enum.Material
		return (Enum.Material :: any)[name]
	end)
	MATERIALS[i] = if ok then m else Enum.Material.Air
end
local AIR_MAT = Enum.Material.Air

type ChunkBuild = {
	j0: number,
	ny: number,
	x0: number,
	z0: number,
	solid: { { { Enum.Material } } },
	occupancy: { { { number } } },
	liquid: { { { number } } },
	voxels: number,
}

Jobs.heights = {
	parallel = function(p: any, _state: { [string]: any }): any
		local world = WorldGen.new(p.seed)
		local h, t = WorldGen.bandHeights(world, p.k0, p.k1)
		return { k0 = p.k0, k1 = p.k1, heights = h, targets = t }
	end,
}

Jobs.setWorld = {
	parallel = function(p: any, state: { [string]: any }): any
		state.world = WorldGen.new(p.seed)
		state.heights = p.heights
		return true
	end,
}

local function buildChunk(world: WorldGen.World, heights: buffer, cx: number, cz: number): ChunkBuild
	local cc = world.cfg.chunkColumns
	local j0, ny = WorldGen.chunkRange(world, heights, cx, cz)
	local solid: { { { Enum.Material } } } = table.create(cc)
	local occupancy: { { { number } } } = table.create(cc)
	local liquid: { { { number } } } = table.create(cc)
	for x = 1, cc do
		local sx: { { Enum.Material } } = table.create(ny)
		local ox: { { number } } = table.create(ny)
		local lx: { { number } } = table.create(ny)
		for y = 1, ny do
			sx[y] = table.create(cc, AIR_MAT)
			ox[y] = table.create(cc, 0)
			lx[y] = table.create(cc, 0)
		end
		solid[x], occupancy[x], liquid[x] = sx, ox, lx
	end
	local i0, k0 = cx * cc, cz * cc
	for dz = 0, cc - 1 do
		for dx = 0, cc - 1 do
			local i, k = i0 + dx, k0 + dz
			local h = WorldGen.heightAt(world, heights, i, k)
			local f = WorldGen.fillBottom(world, heights, i, k)
			local m = WorldGen.classify(world, heights, i, k)
			local sx, ox, lx = solid[dx + 1], occupancy[dx + 1], liquid[dx + 1]
			for y = 1, ny do
				local mat, occ, liq = WorldGen.voxel(world, h, f, m, j0 + y - 1)
				sx[y][dz + 1] = MATERIALS[mat + 1]
				ox[y][dz + 1] = occ
				lx[y][dz + 1] = liq
			end
		end
	end
	local v = world.voxel
	return {
		j0 = j0,
		ny = ny,
		x0 = world.origin + i0 * v,
		z0 = world.origin + k0 * v,
		solid = solid,
		occupancy = occupancy,
		liquid = liquid,
		voxels = cc * cc * ny,
	}
end
Jobs.buildChunk = buildChunk

-- Converts the channel arrays to the single-channel WriteVoxels form.
local function toLegacy(b: ChunkBuild): ({ { { Enum.Material } } }, { { { number } } })
	local water = MATERIALS[WorldGen.WATER + 1]
	local mats: { { { Enum.Material } } } = {}
	local occs: { { { number } } } = {}
	local indexOf: { [Enum.Material]: number } = {}
	for i, m in MATERIALS do
		indexOf[m] = i - 1
	end
	for x, plane in b.solid do
		local mx: { { Enum.Material } } = {}
		local oxs: { { number } } = {}
		for y, row in plane do
			local mr: { Enum.Material } = {}
			local orow: { number } = {}
			for z, m in row do
				local mi, o = WorldGen.solidOrWater(indexOf[m] or 0, b.occupancy[x][y][z], b.liquid[x][y][z])
				mr[z] = if mi == WorldGen.WATER then water else MATERIALS[mi + 1]
				orow[z] = o
			end
			mx[y], oxs[y] = mr, orow
		end
		mats[x], occs[x] = mx, oxs
	end
	return mats, occs
end

Jobs.chunk = {
	parallel = function(p: any, state: { [string]: any }): any
		local world = state.world :: WorldGen.World?
		local heights = state.heights :: buffer?
		assert(world and heights, "setWorld has not run on this worker")
		return buildChunk(world, heights, p.cx, p.cz)
	end,
	serial = function(p: any, b: any, state: { [string]: any }): any
		local build = b :: ChunkBuild
		local terrain = Workspace.Terrain
		local cc = 16
		local v = 4
		local lo = Vector3.new(build.x0, build.j0 * v, build.z0)
		local hi = Vector3.new(build.x0 + cc * v, (build.j0 + build.ny) * v, build.z0 + cc * v)
		local region = Region3.new(lo, hi)
		local t0 = os.clock()
		local mode = state.writeMode or "channels"
		local channelError: string? = nil
		if mode == "channels" then
			local ok, err = pcall(function()
				terrain:WriteVoxelChannels(region, 4, {
					SolidMaterial = build.solid,
					SolidOccupancy = build.occupancy,
					LiquidOccupancy = build.liquid,
				})
			end)
			if not ok then
				channelError = tostring(err)
				mode = "voxels"
				state.writeMode = "voxels"
				state.channelError = channelError
			end
		end
		if mode == "voxels" then
			local mats, occs = toLegacy(build)
			terrain:WriteVoxels(region, 4, mats, occs)
		end
		return {
			cx = p.cx,
			cz = p.cz,
			voxels = build.voxels,
			writeMs = (os.clock() - t0) * 1000,
			mode = mode,
			channelError = channelError or state.channelError,
		}
	end,
}

Jobs.shellMask = {
	parallel = function(p: any, _state: { [string]: any }): any
		local t0 = os.clock()
		local buf, how = GrassGen.renderMask(p.k, p.layers, p.size, p.seed, p.count, p.radius, p.lean)
		return { k = p.k, pixels = buf, how = how, ms = (os.clock() - t0) * 1000 }
	end,
}

Jobs.rock = {
	parallel = function(p: any, _state: { [string]: any }): any
		return RockGen.build(p.seed, p.radius, p.subdivisions, p.roughness)
	end,
}

return Jobs
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="56">
        <Properties>
          <string name="Name">SkyBaker</string>
          <string name="Source"><![CDATA[--!strict
-- Universe at Home: Meadow :: SkyBaker (server)
--
-- Renders the six SkyGen faces with native codegen, bakes each one and assigns the
-- baked Content to Lighting.Sky.Skybox*Content (replicates to every client). Any
-- failure leaves the Sky's default skybox in place (fallback) and says why.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Demo = ReplicatedStorage:WaitForChild("Demo")
local Config = require(Demo:WaitForChild("Config"))
local SkyGen = require(Demo:WaitForChild("SkyGen"))
local Status = require(Demo:WaitForChild("Status"))
local Bake = require(script.Parent:WaitForChild("Bake"))

local SkyBaker = {}

SkyBaker.keep = {} :: { EditableImage }

function SkyBaker.run(reg: Status.Registry): (Status.State, string)
	local sky = Lighting:FindFirstChildOfClass("Sky")
	if not sky then
		local s = Instance.new("Sky")
		s.Parent = Lighting
		sky = s
	end
	assert(sky)
	local size = Config.sky.faceSize
	local sunE = Lighting:GetSunDirection().Y
	local t0 = os.clock()
	local contents: { [string]: Content } = {}
	local renderMs = 0
	for _, face in SkyGen.FACES do
		local r0 = os.clock()
		local pixels = SkyGen.renderFace(face, size, sunE, Config.sky :: any)
		renderMs += (os.clock() - r0) * 1000
		local content, img, why = Bake.pixels(size, size, pixels)
		if not content then
			if img then
				img:Destroy()
			end
			return "fallback", string.format("default sky: face %s not baked (%s)", face, tostring(why))
		end
		if img then
			table.insert(SkyBaker.keep, img)
		end
		contents[face] = content
		task.wait()
	end
	-- assign all six at once so the sky never shows a mix of faces (explicit property
	-- names so luau-lsp checks them against the API)
	local s = sky :: Sky
	s.SkyboxBackContent = contents.Bk
	s.SkyboxDownContent = contents.Dn
	s.SkyboxFrontContent = contents.Ft
	s.SkyboxLeftContent = contents.Lf
	s.SkyboxRightContent = contents.Rt
	s.SkyboxUpContent = contents.Up
	return "ok",
		string.format(
			"6 faces %dx%d baked; render %.0f ms (server), total %.1f s; sun elevation %.2f",
			size,
			size,
			renderMs,
			os.clock() - t0,
			sunE
		)
end

return SkyBaker
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="57">
        <Properties>
          <string name="Name">TerrainBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- Universe at Home: Meadow :: TerrainBuilder
--
-- Server coordinator of the landscape (docs/DEMO.md section 2):
--   A. heights   32 bands of 8 rows sent to the worldgen Actors (parallel noise)
--   B. erosion   serial thermal erosion over the assembled 256 x 256 map
--   C. voxels    the eroded map is broadcast to every worker; chunks are dispatched in
--                rings around the spawn, a few per frame; each worker builds its
--                chunk's arrays in parallel and writes them after task.synchronize()
-- Progress is replicated to clients through attributes of ReplicatedStorage.DemoStatus.
-- Every stage falls back to inline (serial) work if the Actors do not answer.

local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Demo = ReplicatedStorage:WaitForChild("Demo")
local Config = require(Demo:WaitForChild("Config"))
local WorldGen = require(Demo:WaitForChild("WorldGen"))
local WorkerPool = require(Demo:WaitForChild("WorkerPool"))
local Status = require(Demo:WaitForChild("Status"))

local TerrainBuilder = {}

export type Result = {
	world: WorldGen.World,
	heights: buffer,
	spawn: Vector3,
	chunks: number,
	voxels: number,
	seconds: number,
	mode: string,
}

local function setProgress(mirror: Instance, stage: string, progress: number)
	mirror:SetAttribute("WorldStage", stage)
	mirror:SetAttribute("WorldProgress", progress)
end

-- onSpawnReady(spawn) is called once the chunks around the spawn are written.
function TerrainBuilder.run(
	reg: Status.Registry,
	pool: WorkerPool.Pool,
	mirror: Instance,
	onSpawnReady: (Vector3) -> ()
): Result
	local t0 = os.clock()
	local world = WorldGen.new(Config.seed)
	local n = world.columns
	local rowBytes = n * 4

	-- A. heights
	setProgress(mirror, "heights", 0)
	local heights = buffer.create(n * rowBytes)
	local targets = buffer.create(n * rowBytes)
	local band = 8
	local bands = n // band
	local doneBands = 0
	local failures = 0
	for k0 = 0, n - 1, band do
		WorkerPool.submit(pool, "heights", { seed = world.seed, k0 = k0, k1 = k0 + band }, function(ok: boolean, res: any)
			if ok and type(res) == "table" and typeof(res.heights) == "buffer" and typeof(res.targets) == "buffer" then
				buffer.copy(heights, res.k0 * rowBytes, res.heights, 0, (res.k1 - res.k0) * rowBytes)
				buffer.copy(targets, res.k0 * rowBytes, res.targets, 0, (res.k1 - res.k0) * rowBytes)
			else
				failures += 1
				local h, t = WorldGen.bandHeights(world, k0, k0 + band)
				buffer.copy(heights, k0 * rowBytes, h, 0)
				buffer.copy(targets, k0 * rowBytes, t, 0)
			end
			doneBands += 1
			setProgress(mirror, "heights", doneBands / bands * 0.25)
		end)
	end
	while doneBands < bands do
		task.wait(0.05)
	end
	local tA = os.clock()
	Status.set(
		reg,
		"worldgen_heights",
		if failures == 0 then "ok" else "fallback",
		string.format("%d bands in %.2f s via %s (%d redone inline)", bands, tA - t0, pool.mode, failures)
	)

	-- B. erosion (serial; about 5 ms native, 20 ms interpreted)
	setProgress(mirror, "erosion", 0.26)
	WorldGen.erode(world, heights, targets)
	local hash = WorldGen.hashBuffer(heights)
	mirror:SetAttribute("WorldHash", hash)
	Status.result("server", "worldgen", { heightsHash = hash, seconds = os.clock() - t0, mode = pool.mode })

	-- spawn point
	local sx, sy, sz = WorldGen.findSpawn(world, heights)
	local spawn = Vector3.new(sx, sy, sz)
	mirror:SetAttribute("SpawnPosition", spawn)

	-- C. voxels
	setProgress(mirror, "voxels", 0.3)
	local acks = WorkerPool.broadcast(pool, "setWorld", { seed = world.seed, heights = heights }, 15)
	if pool.available and acks < pool.readyCount then
		Status.set(reg, "worldgen_broadcast", "fallback", string.format("%d of %d workers took the map", acks, pool.readyCount))
	end
	local order = WorldGen.chunkOrder(world)
	local total = #order
	mirror:SetAttribute("WorldChunksTotal", total)
	local nextIndex = 1
	local inflight = 0
	local done = 0
	local voxels = 0
	local writeMs = 0
	local mode = "?"
	local channelError: string? = nil
	local failedChunks = 0
	local spawnReady = false
	-- the first 9 chunks of the ring order are the 3 x 3 around the spawn chunk
	local spawnSet: { [number]: boolean } = {}
	local spawnLeft = math.min(9, total)
	for i = 1, spawnLeft do
		spawnSet[order[i]] = true
	end
	local nc = n // world.cfg.chunkColumns
	-- adaptive dispatch: keep the serial write time per frame near the budget
	local perFrame = 2
	local budgetMs = 14
	local conn: RBXScriptConnection? = nil
	local function dispatch()
		while inflight < perFrame and nextIndex <= total do
			local id = order[nextIndex]
			nextIndex += 1
			inflight += 1
			local cx, cz = id % nc, id // nc
			WorkerPool.submit(pool, "chunk", { cx = cx, cz = cz }, function(ok: boolean, res: any)
				inflight -= 1
				done += 1
				if ok and type(res) == "table" then
					voxels += res.voxels or 0
					writeMs += res.writeMs or 0
					mode = res.mode or mode
					if res.channelError then
						channelError = res.channelError
					end
					local w = res.writeMs or 0
					if w > budgetMs and perFrame > 1 then
						perFrame -= 1
					elseif w < budgetMs * 0.4 and perFrame < 8 then
						perFrame += 1
					end
				else
					failedChunks += 1
					warn(string.format("%s|server|chunk|failed|%d,%d %s", Config.TAG, cx, cz, tostring(res)))
				end
				mirror:SetAttribute("WorldChunks", done)
				setProgress(mirror, "voxels", 0.3 + 0.7 * done / total)
				if spawnSet[id] then
					spawnSet[id] = nil
					spawnLeft -= 1
				end
				if not spawnReady and spawnLeft <= 0 then
					spawnReady = true
					task.spawn(onSpawnReady, spawn)
				end
			end)
		end
	end
	conn = RunService.Heartbeat:Connect(dispatch)
	dispatch()
	while done < total do
		task.wait(0.1)
	end
	if conn then
		conn:Disconnect()
	end
	if not spawnReady then
		spawnReady = true
		task.spawn(onSpawnReady, spawn)
	end
	local seconds = os.clock() - t0
	setProgress(mirror, "done", 1)
	mirror:SetAttribute("WorldReady", true)
	mirror:SetAttribute("WorldSeconds", seconds)
	Status.set(
		reg,
		"terrain_write",
		if failedChunks > 0 then "fallback" elseif mode == "channels" then "ok" else "fallback",
		string.format(
			"%d chunks, %d voxels, %.0f ms of writes, mode %s%s%s",
			total,
			voxels,
			writeMs,
			mode,
			if failedChunks > 0 then string.format(", %d chunks failed", failedChunks) else "",
			if channelError then " (WriteVoxelChannels error: " .. channelError .. ")" else ""
		)
	)
	Status.result("server", "terrain", { chunks = total, voxels = voxels, writeMs = writeMs, seconds = seconds, mode = mode })
	return {
		world = world,
		heights = heights,
		spawn = spawn,
		chunks = total,
		voxels = voxels,
		seconds = seconds,
		mode = pool.mode,
	}
end

-- Last resort if everything above failed: a flat grass field so the place is still
-- walkable and the rest of the demo can run.
function TerrainBuilder.flatFallback(mirror: Instance): Vector3
	local terrain = Workspace.Terrain
	terrain:FillBlock(CFrame.new(0, 28, 0), Vector3.new(512, 56, 512), Enum.Material.Grass)
	mirror:SetAttribute("WorldReady", true)
	mirror:SetAttribute("WorldStage", "flat fallback")
	mirror:SetAttribute("WorldProgress", 1)
	return Vector3.new(0, 56, 0)
end

return TerrainBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="58">
      <Properties>
        <string name="Name">Workers</string>
      </Properties>
      <Item class="Actor" referent="59">
        <Properties>
          <string name="Name">ServerWorker</string>
          <bool name="NeedsPivotMigration">false</bool>
        </Properties>
        <Item class="Script" referent="60">
          <Properties>
            <string name="Name">Worker</string>
            <bool name="Disabled">true</bool>
            <token name="RunContext">1</token>
            <string name="Source"><![CDATA[--!strict
-- Universe at Home: Meadow :: server worker (template)
--
-- Lives disabled in ServerScriptService.Workers.ServerWorker (an Actor). The server
-- coordinator clones the Actor, enables this Script (RunContext Server) and parents
-- the clone under ServerScriptService.WorkerPools, where it runs. Requires happen
-- here, in the serial phase; WorkerMain binds the parallel message handler.

local actor = script:GetActor()
if not actor then
	return
end
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local WorkerMain = require(ReplicatedStorage:WaitForChild("Demo"):WaitForChild("WorkerMain"))
local jobs = require(ServerScriptService:WaitForChild("Server"):WaitForChild("ServerJobs"))
WorkerMain.run(actor, jobs :: any)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="61">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">600</float>
      <float name="CharacterWalkSpeed">20</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="62">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="63">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">ClientActors</string>
            <string name="Source"><![CDATA[--!strict
-- Universe at Home: Meadow :: ClientActors
--
-- Spawns the client worker pools (docs/DEMO.md section 5): 8 render workers (tile
-- jobs: shell masks, raster, ALLAN, matte), 4 grass workers (patch geometry, sheet
-- heights) and 1 wind worker. Templates live disabled in ReplicatedStorage.DemoWorkers:
--   1. ClientWorker (Script, RunContext Client) cloned into a client-side folder in
--      ReplicatedStorage, where RunContext Client scripts run;
--   2. if no worker answers, ClientWorkerLocal (LocalScript) cloned into PlayerScripts;
--   3. if still nothing, serial mode: every job runs inline with the same code.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Demo = ReplicatedStorage:WaitForChild("Demo")
local WorkerPool = require(Demo:WaitForChild("WorkerPool"))
local Status = require(Demo:WaitForChild("Status"))

local ClientActors = {}

local function spawnPool(name: string, count: number, handlers: any, timeout: number): (WorkerPool.Pool, string)
	local templates = ReplicatedStorage:WaitForChild("DemoWorkers", 10)
	local pool = WorkerPool.new(name, handlers, timeout)
	if not templates then
		return pool, "no ReplicatedStorage.DemoWorkers; serial"
	end
	local scriptTemplate = templates:FindFirstChild("ClientWorker")
	if scriptTemplate then
		local folder = ReplicatedStorage:FindFirstChild("ClientWorkerPools")
		if not folder then
			local f = Instance.new("Folder")
			f.Name = "ClientWorkerPools"
			f.Parent = ReplicatedStorage
			folder = f
		end
		assert(folder)
		local ready = WorkerPool.spawn(pool, scriptTemplate, folder, count, 6)
		if ready > 0 then
			return pool, string.format("%d/%d Script(RunContext Client) Actors", ready, count)
		end
		WorkerPool.destroy(pool)
	end
	local localTemplate = templates:FindFirstChild("ClientWorkerLocal")
	local playerScripts = Players.LocalPlayer:FindFirstChildOfClass("PlayerScripts")
	if localTemplate and playerScripts then
		local ready = WorkerPool.spawn(pool, localTemplate, playerScripts, count, 6)
		if ready > 0 then
			return pool, string.format("%d/%d LocalScript Actors (RunContext Client variant did not answer)", ready, count)
		end
		WorkerPool.destroy(pool)
	end
	return pool, "no worker answered; serial mode"
end

function ClientActors.start(ctx: { [string]: any }): (string, string)
	local Config = ctx.config
	local reg = ctx.reg
	local jobs = require(Demo:WaitForChild("ClientJobs")) :: any
	local timeout = Config.actors.jobTimeout
	local render, renderNote = spawnPool("Render", Config.actors.clientRender, jobs, timeout)
	local grass, grassNote = spawnPool("Grass", Config.actors.clientGrass, jobs, timeout)
	local wind, windNote = spawnPool("Wind", Config.actors.clientWind, jobs, timeout)
	ctx.pools = { render = render, grass = grass, wind = wind }
	ctx.clientPool = {
		busyCount = function(): number
			return WorkerPool.busyCount(render) + WorkerPool.busyCount(grass) + WorkerPool.busyCount(wind)
		end,
		size = function(): number
			return render.readyCount + grass.readyCount + wind.readyCount
		end,
		mode = function(): string
			if render.available and grass.available and wind.available then
				return "actors"
			elseif render.available or grass.available then
				return "partial"
			end
			return "serial"
		end,
	}
	Status.set(reg, "actors_render", if render.available then "ok" else "fallback", renderNote)
	Status.set(reg, "actors_grass", if grass.available then "ok" else "fallback", grassNote)
	Status.set(reg, "actors_wind", if wind.available then "ok" else "fallback", windNote)
	local all = render.available and grass.available and wind.available
	return if all then "ok" else "fallback", string.format("render %d, grass %d, wind %d ready", render.readyCount, grass.readyCount, wind.readyCount)
end

return ClientActors
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">Grass</string>
            <string name="Source"><![CDATA[--!strict
-- Universe at Home: Meadow :: Grass (client)
--
-- Three rings around the player (docs/DEMO.md section 3):
--   ring 0  (0 to 24 studs)   blade geometry: 4 x 4 stud patches drawn from four shared
--                             variant meshes (full density A and A2, 60 percent B, 30
--                             percent C), each patch a MeshPart placed on the terrain's
--                             local plane with a random quarter turn. Variant geometry
--                             comes from GrassGen in the grass Actors; meshes are the
--                             server's baked variants when available (zero client
--                             editable budget), else client EditableMeshes. Level per
--                             patch from Saturn's selector with hysteresis, switches by
--                             Saturn's two-phase crossfade; the patch under the player
--                             is swapped for an interactive EditableMesh whose blades bend
--                             away from the player.
--   ring 1  (24 to 96 studs)  shell grass: one terrain-following sheet (an EditableMesh
--                             re-fitted by raycasts in a grass Actor) shown by 12 MeshParts
--                             stacked 0.1 stud apart, each textured with the alpha mask of
--                             its height (blade cross-sections, rendered by the flawless
--                             rasterizer; baked on the server, or rendered by the client
--                             render Actors). Vertex alpha fades the sheet in at 24 and out
--                             at 96 with the same two-phase rule, so no ring edge pops.
--   ring 2  (beyond 96)       engine Terrain decoration grass (set in the place file).
-- Wind: one Actor computes every patch tilt and shell sway in parallel and applies them
-- with Workspace:BulkMoveTo after task.synchronize().

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local AssetService = game:GetService("AssetService")

local Demo = ReplicatedStorage:WaitForChild("Demo")
local GrassGen = require(Demo:WaitForChild("GrassGen"))
local GrassMesh = require(Demo:WaitForChild("GrassMesh"))
local Rings = require(Demo:WaitForChild("Rings"))
local WorkerPool = require(Demo:WaitForChild("WorkerPool"))
local Status = require(Demo:WaitForChild("Status"))
local MyMath = require(ReplicatedStorage:WaitForChild("Universe"):WaitForChild("MyMath"))

local Grass = {}

type Slot = {
	key: number,
	sx: number,
	sz: number,
	ground: CFrame,
	ok: boolean,
	pick: number, -- level-0 variant index (1 = A, 2 = A2)
	lod: Rings.Lod,
	parts: { MeshPart? },
	partVariant: { number },
	d: number,
}

type State = {
	ctx: { [string]: any },
	cfg: any,
	folder: Folder,
	patches: { GrassGen.Patch },
	offsets: { Vector3 },
	templates: { MeshPart },
	free: { { MeshPart } },
	triangles: { number },
	slots: { [number]: Slot },
	interactive: { { part: MeshPart, built: GrassMesh.BuiltPatch }? },
	interactSlot: number?,
	interactPos: Vector3?,
	bendOut: { number },
	shellParts: { MeshPart },
	sheet: GrassGen.Sheet?,
	sheetBuilt: GrassMesh.BuiltSheet?,
	sheetCenter: Vector3?,
	sheetPending: boolean,
	sheetStamp: number,
	windDirty: boolean,
	windLast: number,
	windParams: { [string]: any },
	ring0: boolean,
	ring1: boolean,
	params: RaycastParams,
}

local function key(sx: number, sz: number): number
	return (sx + 32768) * 65536 + (sz + 32768)
end

local function rootPart(): BasePart?
	local character = Players.LocalPlayer.Character
	if not character then
		return nil
	end
	local r = character:FindFirstChild("HumanoidRootPart")
	if r and r:IsA("BasePart") then
		return r
	end
	return nil
end

-- Variant index for a level (0, 1, 2) at a slot.
local function variantFor(level: number, pick: number): number
	if level == 0 then
		return pick
	end
	return level + 2
end

local function acquire(st: State, v: number): MeshPart
	local list = st.free[v]
	local p = table.remove(list)
	if p then
		return p
	end
	local c = st.templates[v]:Clone()
	c.Parent = st.folder
	return c
end

local function release(st: State, v: number, part: MeshPart)
	part.Transparency = 1
	part.CFrame = CFrame.new(0, -2000, 0)
	table.insert(st.free[v], part)
end

-- Terrain plane under a slot: 5 raycasts; grass only on Grass and LeafyGrass.
local function fitSlot(st: State, sx: number, sz: number): (boolean, CFrame)
	local S = st.cfg.patch
	local cx, cz = (sx + 0.5) * S, (sz + 0.5) * S
	local down = Vector3.new(0, -600, 0)
	local function h(x: number, z: number): (number?, Enum.Material?)
		local hit = Workspace:Raycast(Vector3.new(x, 400, z), down, st.params)
		if hit then
			return hit.Position.Y, hit.Material
		end
		return nil, nil
	end
	local hc, mc = h(cx, cz)
	local hx1 = h(cx + 1.6, cz)
	local hx0 = h(cx - 1.6, cz)
	local hz1 = h(cx, cz + 1.6)
	local hz0 = h(cx, cz - 1.6)
	if not hc or not hx1 or not hx0 or not hz1 or not hz0 then
		return false, CFrame.new()
	end
	if mc ~= Enum.Material.Grass and mc ~= Enum.Material.LeafyGrass then
		return false, CFrame.new()
	end
	local up = Vector3.new(-(hx1 - hx0) / 3.2, 1, -(hz1 - hz0) / 3.2).Unit
	if up.Y < 0.8 then
		return false, CFrame.new() -- too steep for a rigid patch
	end
	local turn = (MyMath.hash2(sx, sz, 31) % 4) / 4
	local r = Vector3.new(MyMath.dcosTurns(turn), 0, MyMath.dsinTurns(turn))
	r = (r - up * r:Dot(up)).Unit
	return true, CFrame.fromMatrix(Vector3.new(cx, hc, cz), r, up)
end

local function newSlot(st: State, sx: number, sz: number, d: number): Slot
	local ok, ground = fitSlot(st, sx, sz)
	local g = st.cfg
	return {
		key = key(sx, sz),
		sx = sx,
		sz = sz,
		ground = ground,
		ok = ok,
		pick = (MyMath.hash2(sx, sz, 57) % 2) + 1,
		lod = Rings.lod({ g.lodNear, g.lodFar }, g.hysteresis, g.fadeSeconds, d),
		parts = { nil, nil },
		partVariant = { 0, 0 },
		d = d,
	}
end

local function dropSlot(st: State, s: Slot)
	for i = 1, 2 do
		local p = s.parts[i]
		if p then
			release(st, s.partVariant[i], p)
			s.parts[i] = nil
		end
	end
	st.windDirty = true
end

-- Applies one slot's LOD crossfade and ring-boundary fade.
local function updateSlot(st: State, s: Slot, now: number)
	local l1, t1, l2, t2 = Rings.lodStep(s.lod, s.d, now)
	local ringOpacity = Rings.boundary(s.d, st.cfg.ring0, st.cfg.fadeWidth)
	local levels = { l1, l2 }
	local trans = { t1, t2 }
	for i = 1, 2 do
		local level = levels[i]
		local want = if level >= 0 then variantFor(level, s.pick) else 0
		local part = s.parts[i]
		if part and s.partVariant[i] ~= want then
			release(st, s.partVariant[i], part)
			s.parts[i] = nil
			part = nil
			st.windDirty = true
		end
		if want > 0 and not part then
			local p = acquire(st, want)
			p.CFrame = s.ground * CFrame.new(st.offsets[want])
			s.parts[i] = p
			s.partVariant[i] = want
			part = p
			st.windDirty = true
		end
		if part then
			local opacity = (1 - trans[i]) * ringOpacity
			local t = 1 - opacity
			if st.interactSlot == s.key and want <= 2 then
				t = 1 -- the interactive copy stands in for this patch
			end
			if math.abs(part.Transparency - t) > 0.004 then
				part.Transparency = t
			end
		end
	end
end

local function sendWind(st: State)
	local parts: { BasePart } = {}
	local base: { CFrame } = {}
	local kind: { number } = {}
	local offsets: { Vector3 } = {}
	for _, s in st.slots do
		for i = 1, 2 do
			local p = s.parts[i]
			if p and p.Transparency < 1 then
				table.insert(parts, p)
				table.insert(base, s.ground)
				table.insert(offsets, st.offsets[s.partVariant[i]])
				table.insert(kind, 0)
			end
		end
	end
	if st.interactSlot then
		local s = st.slots[st.interactSlot]
		local it = s and st.interactive[s.pick]
		if s and it then
			table.insert(parts, it.part)
			table.insert(base, s.ground)
			table.insert(offsets, it.built.offset)
			table.insert(kind, 0)
		end
	end
	local center = st.sheetCenter
	if center then
		local K = #st.shellParts
		local g = st.cfg
		for k, p in st.shellParts do
			table.insert(parts, p)
			table.insert(base, CFrame.new(center))
			table.insert(offsets, Vector3.new(0, 0.14 + (k - 1) / math.max(1, K - 1) * g.shellHeight, 0))
			table.insert(kind, k)
		end
	end
	-- the wind job wants final base CFrames; fold the offsets in for shells, keep the
	-- ground pivot for patches by passing ground * offset with the pivot correction
	local finalBase: { CFrame } = table.create(#parts)
	for i = 1, #parts do
		if kind[i] == 0 then
			finalBase[i] = base[i] * CFrame.new(offsets[i])
		else
			finalBase[i] = base[i] + offsets[i]
		end
	end
	local pools = st.ctx.pools
	local wind = pools and pools.wind
	if wind and wind.available then
		WorkerPool.submit(wind, "windSet", { parts = parts, base = finalBase, kind = kind, params = st.windParams })
	else
		st.windParams.serialParts = parts
		st.windParams.serialBase = finalBase
		st.windParams.serialKind = kind
	end
	st.windDirty = false
	st.windLast = os.clock()
end

-- Serial wind for the no-Actor fallback (same formulas as ClientJobs.windSet).
local function serialWind(st: State)
	local w = st.windParams
	local parts = w.serialParts :: { BasePart }?
	if not parts or #parts == 0 then
		return
	end
	local base = w.serialBase :: { CFrame }
	local kind = w.serialKind :: { number }
	local t = os.clock()
	local out = table.create(#parts)
	for i = 1, #parts do
		local cf = base[i]
		local pos = cf.Position
		local phase = (pos.X * w.dirX + pos.Z * w.dirZ) / w.wavelength - t * w.speed
		local g = 0.55 + 0.35 * math.sin(phase * 6.283185307179586) + 0.12 * math.sin(phase * 14.45 + 1.7)
		if kind[i] == 0 then
			local axis = cf:VectorToObjectSpace(Vector3.new(-w.dirZ, 0, w.dirX))
			out[i] = cf * CFrame.fromAxisAngle(axis, w.strength * g)
		else
			local f = kind[i] / w.layers
			local s = w.shellAmp * f * f * g
			out[i] = cf + Vector3.new(w.dirX * s, 0, w.dirZ * s)
		end
	end
	pcall(function()
		Workspace:BulkMoveTo(parts, out, Enum.BulkMoveMode.FireCFrameChanged)
	end)
end

local function requestSheet(st: State, p: Vector3)
	local sheet = st.sheet
	local pools = st.ctx.pools
	if not sheet or st.sheetPending then
		return
	end
	local spacing = sheet.spacing
	local cx = math.floor(p.X / spacing + 0.5) * spacing
	local cz = math.floor(p.Z / spacing + 0.5) * spacing
	local baseY = math.floor(p.Y + 0.5)
	st.sheetPending = true
	st.sheetStamp += 1
	local payload = { cx = cx, cz = cz, baseY = baseY, top = baseY + 200, n = sheet.n, half = sheet.half, spacing = spacing, stamp = st.sheetStamp }
	local pool = pools and pools.grass
	local function apply(ok: boolean, res: any)
		st.sheetPending = false
		local built = st.sheetBuilt
		if not ok or type(res) ~= "table" or not built then
			return
		end
		GrassMesh.setSheetHeights(built, sheet, res.heights)
		st.sheetCenter = Vector3.new(res.cx, res.baseY, res.cz)
		st.windDirty = true
		for _, part in st.shellParts do
			part.CFrame = CFrame.new(st.sheetCenter :: Vector3)
		end
	end
	if pool then
		WorkerPool.submit(pool, "sheetHeights", payload, apply)
	end
end

local function interaction(st: State, root: BasePart, now: number)
	local S = st.cfg.patch
	local p = root.Position
	local sx, sz = math.floor(p.X / S), math.floor(p.Z / S)
	local k = key(sx, sz)
	local s = st.slots[k]
	local current = st.interactSlot
	local eligible = s ~= nil and s.ok and s.lod.t0 < 0 and (s.partVariant[1] == s.pick or s.partVariant[2] == s.pick) and st.interactive[s.pick] ~= nil
	if not eligible then
		if current then
			local old = st.slots[current]
			if old then
				local it = st.interactive[old.pick]
				if it then
					it.part.Transparency = 1
				end
			end
			st.interactSlot = nil
			st.windDirty = true
		end
		return
	end
	assert(s)
	local it = st.interactive[s.pick]
	assert(it)
	if current ~= k then
		if current then
			local old = st.slots[current]
			if old then
				local oit = st.interactive[old.pick]
				if oit and oit ~= it then
					oit.part.Transparency = 1
				end
			end
		end
		st.interactSlot = k
		st.interactPos = nil
		it.part.CFrame = s.ground * CFrame.new(it.built.offset)
		it.part.Transparency = 0
		st.windDirty = true
	end
	-- bend: only when the player moved, at most every other frame (time slice)
	local lp = s.ground:PointToObjectSpace(p)
	local last = st.interactPos
	if last and (last - lp).Magnitude < 0.12 then
		return
	end
	st.interactPos = lp
	local patch = st.patches[s.pick]
	local bent = GrassGen.bend(patch, lp.X, lp.Z, st.cfg.interactRadius, 0.85, st.bendOut)
	GrassMesh.setPositions(it.built, st.bendOut)
	st.ctx.lastBend = bent
end

local function frame(st: State)
	local root = rootPart()
	if not root then
		return
	end
	local now = os.clock()
	local p = root.Position
	local g = st.cfg
	local S = g.patch
	if st.ring0 then
		local reach = g.ring0 + 2
		local sx0, sx1 = math.floor((p.X - reach) / S), math.floor((p.X + reach) / S)
		local sz0, sz1 = math.floor((p.Z - reach) / S), math.floor((p.Z + reach) / S)
		local created = 0
		for sz = sz0, sz1 do
			for sx = sx0, sx1 do
				local cx, cz = (sx + 0.5) * S - p.X, (sz + 0.5) * S - p.Z
				local d = math.sqrt(cx * cx + cz * cz)
				if d < reach then
					local k = key(sx, sz)
					local s = st.slots[k]
					if not s and created < 24 then
						s = newSlot(st, sx, sz, d)
						st.slots[k] = s
						created += 1
					end
					if s then
						s.d = d
					end
				end
			end
		end
		local tris = 0
		for k, s in st.slots do
			local cx, cz = (s.sx + 0.5) * S - p.X, (s.sz + 0.5) * S - p.Z
			s.d = math.sqrt(cx * cx + cz * cz)
			if s.d > reach + 3 then
				dropSlot(st, s)
				st.slots[k] = nil
			elseif s.ok then
				updateSlot(st, s, now)
				for i = 1, 2 do
					if s.parts[i] and (s.parts[i] :: MeshPart).Transparency < 1 then
						tris += st.triangles[s.partVariant[i]]
					end
				end
			end
		end
		interaction(st, root, now)
		st.ctx.counters.grassTriangles = tris + (if st.ring1 then (st.sheet :: GrassGen.Sheet).quadCount * 2 * #st.shellParts else 0)
	end
	if st.ring1 then
		local c = st.sheetCenter
		local dx = if c then p.X - c.X else math.huge
		local dz = if c then p.Z - c.Z else math.huge
		if not c or dx * dx + dz * dz > 64 or math.abs(p.Y - c.Y) > 30 then
			requestSheet(st, p)
		end
	end
	if st.windDirty and now - st.windLast > 0.12 then
		sendWind(st)
	end
	local pools = st.ctx.pools
	if not (pools and pools.wind and pools.wind.available) then
		serialWind(st)
	end
end

----------------------------------------------------------------------------------
-- Setup
----------------------------------------------------------------------------------

local function bakedFolder(name: string, wait: number): Instance?
	local baked = ReplicatedStorage:WaitForChild("DemoBaked", wait)
	if not baked then
		return nil
	end
	return baked:WaitForChild(name, wait)
end

local function buildVariants(st: State, reg: any): (boolean, string)
	local g = st.cfg
	local pools = st.ctx.pools
	local n = #GrassGen.VARIANTS
	local results: { GrassGen.Patch? } = table.create(n)
	local pending = n
	for v = 1, n do
		local opts = GrassGen.variantOptions(g, v, 1)
		local function done(ok: boolean, res: any)
			if ok and type(res) == "table" then
				results[v] = res
			else
				results[v] = GrassGen.patch(opts)
			end
			pending -= 1
		end
		if pools and pools.grass then
			WorkerPool.submit(pools.grass, "grassPatch", opts, done)
		else
			done(false, nil)
		end
	end
	local t0 = os.clock()
	while pending > 0 and os.clock() - t0 < 30 do
		task.wait(0.05)
	end
	for v = 1, n do
		local r = results[v]
		if not r then
			return false, "variant geometry missing"
		end
		st.patches[v] = r
		st.offsets[v] = GrassMesh.bboxCenter(r.positions)
		st.triangles[v] = r.triangleCount
	end
	-- meshes: the server's baked variants (no client editable budget), else client meshes
	local source = "client EditableMesh"
	local baked = bakedFolder("GrassVariants", 10)
	local usedBaked = false
	if baked then
		local all = true
		for v, spec in GrassGen.VARIANTS do
			local m = baked:FindFirstChild(spec.name)
			if m and m:IsA("MeshPart") then
				local c = m:Clone()
				c.Anchored = true
				c.CanCollide = false
				c.CanQuery = false
				c.CanTouch = false
				c.CastShadow = false
				c.Transparency = 1
				st.templates[v] = c
			else
				all = false
			end
		end
		usedBaked = all
		if all then
			source = "server-baked meshes (no client editable budget)"
		end
	end
	if not usedBaked then
		for v = 1, n do
			local built, why = GrassMesh.buildPatch(AssetService, st.patches[v] :: any, GrassGen.PALETTE, GrassGen.NORMALS)
			if not built then
				return false, "variant " .. GrassGen.VARIANTS[v].name .. ": " .. tostring(why)
			end
			st.ctx.counters.editableMeshes += 1
			local part = GrassMesh.makePart(AssetService, Content.fromObject(built.mesh), "Variant" .. GrassGen.VARIANTS[v].name, true)
			part.Transparency = 1
			st.templates[v] = part
		end
	end
	for v = 1, n do
		st.free[v] = {}
	end
	-- interactive copies of the two full-density variants
	local interactNote = "interaction on"
	for v = 1, 2 do
		local ok, err = pcall(function()
			local built, why = GrassMesh.buildPatch(AssetService, st.patches[v] :: any, GrassGen.PALETTE, GrassGen.NORMALS)
			if not built then
				error(why)
			end
			st.ctx.counters.editableMeshes += 1
			local part = GrassMesh.makePart(AssetService, Content.fromObject(built.mesh), "Interactive" .. v, true)
			part.Transparency = 1
			part.Parent = st.folder
			st.interactive[v] = { part = part, built = built }
		end)
		if not ok then
			interactNote = "interaction off: " .. tostring(err)
		end
	end
	Status.set(reg, "grass_interaction", if st.interactive[1] then "ok" else "fallback", interactNote)
	return true, string.format("%s; %d + %d + %d + %d triangles per patch variant", source, st.triangles[1], st.triangles[2], st.triangles[3], st.triangles[4])
end

local function buildShells(st: State, reg: any): (boolean, string)
	local g = st.cfg
	local K = g.shellCount
	local sheet = GrassGen.sheet(g.ring0, g.ring1, g.shellRepeat, g.fadeWidth, g.fadeWidth + 4)
	st.sheet = sheet
	local built, why = GrassMesh.buildSheet(AssetService, sheet :: any, 64)
	if not built then
		return false, tostring(why)
	end
	st.sheetBuilt = built
	st.ctx.counters.editableMeshes += 1
	-- masks: baked by the server, else rendered by the render Actors
	local contents: { Content? } = table.create(K)
	local source = ""
	local baked = bakedFolder("ShellMasks", 12)
	if baked then
		local all = true
		for k = 1, K do
			local d = baked:FindFirstChild(string.format("L%02d", k))
			if d and d:IsA("Decal") then
				contents[k] = d.TextureContent
			else
				all = false
			end
		end
		if all then
			source = "server-baked masks"
		end
	end
	if source == "" then
		local pools = st.ctx.pools
		local pending = K
		local how = "?"
		local size = g.shellTexture
		for k = 1, K do
			local payload = {
				k = k - 1,
				layers = K,
				size = size,
				seed = 3,
				count = g.shellBlades,
				radius = g.shellBladeRadius,
				lean = g.shellLeanPx,
			}
			local function done(ok: boolean, res: any)
				pending -= 1
				if not ok or type(res) ~= "table" then
					return
				end
				how = res.how
				local img = AssetService:CreateEditableImage({ Size = Vector2.new(size, size) })
				if not img then
					return
				end
				img:WritePixelsBuffer(Vector2.zero, Vector2.new(size, size), res.pixels)
				st.ctx.counters.editableImages += 1
				st.ctx.counters.editablePixels += size * size
				st.ctx.counters.uploads += 1
				st.ctx.counters.uploadBytes += size * size * 4
				contents[res.k + 1] = Content.fromObject(img)
			end
			if pools and pools.render then
				WorkerPool.submit(pools.render, "shellMask", payload, done)
			else
				pending -= 1
			end
		end
		local t0 = os.clock()
		while pending > 0 and os.clock() - t0 < 60 do
			task.wait(0.05)
		end
		source = "client-rendered masks (" .. how .. ")"
	end
	local first = GrassMesh.makePart(AssetService, Content.fromObject(built.mesh), "Shell01", false)
	local made = 0
	for k = 1, K do
		local c = contents[k]
		if c then
			local part = if k == 1 then first else first:Clone()
			part.Name = string.format("Shell%02d", k)
			part.TextureContent = c
			part.Transparency = 0.001
			part.CFrame = CFrame.new(0, -2000, 0)
			part.Parent = st.folder
			table.insert(st.shellParts, part)
			made += 1
		end
	end
	if made == 0 then
		first:Destroy()
		return false, "no shell mask available"
	end
	return true, string.format("%d layers, %d quads, %s, sheet %s", made, sheet.quadCount, source, built.mode)
end

local function run(ctx: { [string]: any })
	local reg = ctx.reg
	local cfg = ctx.config.grass
	-- wait for a character standing on the generated ground
	local t0 = os.clock()
	while not rootPart() and os.clock() - t0 < 300 do
		task.wait(0.5)
	end
	if not rootPart() then
		Status.set(reg, "grass", "failed", "no character after 300 s")
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "MeadowGrass"
	folder.Parent = Workspace
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { Workspace.Terrain }
	params.IgnoreWater = true
	local st: State = {
		ctx = ctx,
		cfg = cfg,
		folder = folder,
		patches = {},
		offsets = {},
		templates = {},
		free = {},
		triangles = {},
		slots = {},
		interactive = {},
		interactSlot = nil,
		interactPos = nil,
		bendOut = {},
		shellParts = {},
		sheet = nil,
		sheetBuilt = nil,
		sheetCenter = nil,
		sheetPending = false,
		sheetStamp = 0,
		windDirty = true,
		windLast = 0,
		windParams = {
			dirX = 0.8,
			dirZ = 0.6,
			wavelength = cfg.windWavelength,
			speed = cfg.windSpeed,
			strength = cfg.windStrength * 0.35,
			shellAmp = 0.3,
			layers = cfg.shellCount,
		},
		ring0 = false,
		ring1 = false,
		params = params,
	}
	ctx.grass = st
	Status.set(reg, "grass_crossfade", "info", "LOD and ring fades via " .. Rings.source)
	Status.set(reg, "grass_ring2", "ok", "engine Terrain decoration grass beyond " .. cfg.ring1 .. " studs (place file: Decoration, GrassLength)")
	Status.stage(reg, "grass_ring0", function()
		local ok, detail = buildVariants(st, reg)
		if not ok then
			error(detail)
		end
		st.ring0 = true
		return "ok", detail
	end, function(message: string)
		return "fallback", "ring 0 off, engine grass only"
	end)
	Status.stage(reg, "grass_ring1", function()
		local ok, detail = buildShells(st, reg)
		if not ok then
			error(detail)
		end
		st.ring1 = true
		return "ok", detail
	end, function(message: string)
		return "fallback", "ring 1 off, engine grass only"
	end)
	local pools = ctx.pools
	Status.set(
		reg,
		"grass_wind",
		if pools and pools.wind and pools.wind.available then "ok" else "fallback",
		if pools and pools.wind and pools.wind.available then "wind Actor: parallel CFrames + BulkMoveTo" else "serial wind on the main thread"
	)
	RunService.RenderStepped:Connect(function()
		local res = table.pack(pcall(frame, st))
		if not res[1] then
			st.ctx.grassError = tostring(res[2])
		end
	end)
	Status.set(reg, "grass", "ok", string.format("rings: 0 %s, 1 %s, 2 engine", if st.ring0 then "on" else "off", if st.ring1 then "on" else "off"))
end

function Grass.start(ctx: { [string]: any }): (string, string)
	task.spawn(run, ctx)
	return "pending", "waits for the character, then builds the rings"
end

-- T11: rebuilds the ring-0 variants at a density multiplier with client meshes.
-- Returns triangles per full-density patch.
function Grass.setDensity(ctx: { [string]: any }, mul: number): (boolean, string)
	local st = ctx.grass :: State?
	if not st or not st.ring0 then
		return false, "ring 0 is not running"
	end
	-- release every slot, rebuild templates, let the frame loop repopulate
	for k, s in st.slots do
		dropSlot(st, s)
		st.slots[k] = nil
	end
	for v = 1, #GrassGen.VARIANTS do
		for _, p in st.free[v] do
			p:Destroy()
		end
		st.free[v] = {}
		local patch = GrassGen.patch(GrassGen.variantOptions(st.cfg, v, mul))
		local built, why = GrassMesh.buildPatch(AssetService, patch :: any, GrassGen.PALETTE, GrassGen.NORMALS)
		if not built then
			return false, tostring(why)
		end
		st.ctx.counters.editableMeshes += 1
		local part = GrassMesh.makePart(AssetService, Content.fromObject(built.mesh), "Variant" .. GrassGen.VARIANTS[v].name, true)
		part.Transparency = 1
		st.templates[v] = part
		st.patches[v] = patch
		st.offsets[v] = built.offset
		st.triangles[v] = patch.triangleCount
	end
	return true, string.format("x%d: %d triangles per full-density patch", mul, st.triangles[1])
end

return Grass
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--!strict
-- Universe at Home: Meadow :: Hud
--
-- The always-on heads-up display: metrics (left), world progress (top), capabilities
-- and self-check (right), stress bench buttons and results (bottom left). Plain
-- Instances built in code; nothing here is required for the world to work, and every
-- caller wraps HUD updates in pcall.

local Players = game:GetService("Players")

local Hud = {}

local MONO = Font.fromEnum(Enum.Font.RobotoMono)
local SANS = Font.fromEnum(Enum.Font.BuilderSansMedium)
local SANS_BOLD = Font.fromEnum(Enum.Font.BuilderSansBold)

local PANEL = Color3.fromRGB(14, 18, 24)
local INK = Color3.fromRGB(232, 236, 240)
local DIM = Color3.fromRGB(150, 160, 172)
local ACCENT = Color3.fromRGB(255, 196, 120)

Hud.STATE_COLORS = {
	ok = Color3.fromRGB(110, 214, 120),
	fallback = Color3.fromRGB(255, 190, 80),
	failed = Color3.fromRGB(255, 96, 96),
	pending = Color3.fromRGB(120, 170, 255),
	skipped = Color3.fromRGB(140, 140, 150),
	info = Color3.fromRGB(200, 205, 215),
}

export type Hud = {
	gui: ScreenGui,
	root: Frame,
	metrics: Frame,
	metricRows: { [string]: TextLabel },
	metricCount: number,
	progress: Frame,
	progressFill: Frame,
	progressText: TextLabel,
	caps: ScrollingFrame,
	capsTitle: TextLabel,
	bench: Frame,
	benchGrid: Frame,
	benchLog: TextLabel,
	benchLines: { string },
	benchButtons: { [string]: TextButton },
	toastLabel: TextLabel,
	visible: boolean,
}

local function make(className: string, props: { [string]: any }, parent: Instance?): Instance
	local inst = Instance.new(className)
	for k, v in props do
		(inst :: any)[k] = v
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function panel(name: string, parent: Instance, position: UDim2, size: UDim2, anchor: Vector2?): Frame
	local f = make("Frame", {
		Name = name,
		Position = position,
		Size = size,
		AnchorPoint = anchor or Vector2.new(0, 0),
		BackgroundColor3 = PANEL,
		BackgroundTransparency = 0.22,
		BorderSizePixel = 0,
	}, parent) :: Frame
	make("UICorner", { CornerRadius = UDim.new(0, 10) }, f)
	make("UIStroke", { Color = Color3.fromRGB(255, 255, 255), Transparency = 0.88, Thickness = 1 }, f)
	make("UIPadding", {
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
		PaddingTop = UDim.new(0, 8),
		PaddingBottom = UDim.new(0, 8),
	}, f)
	return f
end

local function label(name: string, parent: Instance, text: string, font: Font, size: number, color: Color3, order: number?): TextLabel
	return make("TextLabel", {
		Name = name,
		Text = text,
		FontFace = font,
		TextSize = size,
		TextColor3 = color,
		BackgroundTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		RichText = true,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, size + 2),
		LayoutOrder = order or 0,
		TextWrapped = true,
	}, parent) :: TextLabel
end

local function list(parent: Instance, padding: number)
	make("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, padding),
		FillDirection = Enum.FillDirection.Vertical,
	}, parent)
end

function Hud.new(): Hud
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")
	local gui = make("ScreenGui", {
		Name = "MeadowHud",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 10,
	}) :: ScreenGui
	local root = make("Frame", { Name = "Root", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, gui) :: Frame

	-- metrics, top left (below the Roblox top bar)
	local metrics = panel("Metrics", root, UDim2.new(0, 12, 0, 64), UDim2.new(0, 330, 0, 0))
	metrics.AutomaticSize = Enum.AutomaticSize.Y
	list(metrics, 1)
	label("Title", metrics, "UNIVERSE AT HOME <font color=\"#FFC478\">MEADOW</font>", SANS_BOLD, 17, INK, -10)
	label("Subtitle", metrics, "procedural world, three-ring grass, Actors, stress bench", SANS, 13, DIM, -9)

	-- world progress, top centre
	local progress = panel("Progress", root, UDim2.new(0.5, 0, 0, 64), UDim2.new(0, 420, 0, 46), Vector2.new(0.5, 0))
	local progressText = label("Text", progress, "Waiting for the server...", SANS, 14, INK)
	progressText.Size = UDim2.new(1, 0, 0, 18)
	local bar = make("Frame", {
		Name = "Bar",
		Position = UDim2.new(0, 0, 0, 22),
		Size = UDim2.new(1, 0, 0, 8),
		BackgroundColor3 = Color3.fromRGB(40, 46, 56),
		BorderSizePixel = 0,
	}, progress) :: Frame
	make("UICorner", { CornerRadius = UDim.new(1, 0) }, bar)
	local fill = make("Frame", {
		Name = "Fill",
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = ACCENT,
		BorderSizePixel = 0,
	}, bar) :: Frame
	make("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)

	-- capabilities, right
	local capsPanel = panel("Capabilities", root, UDim2.new(1, -12, 0, 64), UDim2.new(0, 400, 0.62, 0), Vector2.new(1, 0))
	local capsTitle = label("Title", capsPanel, "SELF-CHECK AND CAPABILITIES", SANS_BOLD, 15, INK)
	capsTitle.Size = UDim2.new(1, 0, 0, 18)
	local caps = make("ScrollingFrame", {
		Name = "List",
		Position = UDim2.new(0, 0, 0, 24),
		Size = UDim2.new(1, 0, 1, -24),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, capsPanel) :: ScrollingFrame
	list(caps, 2)

	-- stress bench, bottom left
	local bench = panel("Bench", root, UDim2.new(0, 12, 1, -12), UDim2.new(0, 560, 0, 236), Vector2.new(0, 1))
	local benchTitle = label("Title", bench, "STRESS BENCH", SANS_BOLD, 15, INK)
	benchTitle.Size = UDim2.new(1, 0, 0, 18)
	local grid = make("Frame", {
		Name = "Buttons",
		Position = UDim2.new(0, 0, 0, 22),
		Size = UDim2.new(1, 0, 0, 62),
		BackgroundTransparency = 1,
	}, bench) :: Frame
	make("UIGridLayout", {
		CellSize = UDim2.new(0, 84, 0, 28),
		CellPadding = UDim2.new(0, 6, 0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, grid)
	local benchLog = label("Log", bench, "Results appear here and as MEADOW|client|result lines in Output.", MONO, 12, DIM)
	benchLog.Position = UDim2.new(0, 0, 0, 90)
	benchLog.Size = UDim2.new(1, 0, 1, -90)
	benchLog.AutomaticSize = Enum.AutomaticSize.None
	benchLog.TextYAlignment = Enum.TextYAlignment.Bottom

	-- toast, bottom centre
	local toastLabel = make("TextLabel", {
		Name = "Toast",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		Size = UDim2.new(0, 520, 0, 26),
		BackgroundColor3 = PANEL,
		BackgroundTransparency = 0.3,
		TextColor3 = INK,
		FontFace = SANS,
		TextSize = 14,
		Text = "H toggles the HUD",
		BorderSizePixel = 0,
	}, root) :: TextLabel
	make("UICorner", { CornerRadius = UDim.new(0, 8) }, toastLabel)

	gui.Parent = playerGui
	return {
		gui = gui,
		root = root,
		metrics = metrics,
		metricRows = {},
		metricCount = 0,
		progress = progress,
		progressFill = fill,
		progressText = progressText,
		caps = caps,
		capsTitle = capsTitle,
		bench = bench,
		benchGrid = grid,
		benchLog = benchLog,
		benchLines = {},
		benchButtons = {},
		toastLabel = toastLabel,
		visible = true,
	}
end

function Hud.setMetric(h: Hud, key: string, value: string)
	local row = h.metricRows[key]
	if not row then
		h.metricCount += 1
		row = label("M_" .. key, h.metrics, "", MONO, 13, INK, h.metricCount)
		h.metricRows[key] = row
	end
	row.Text = string.format("<font color=\"#96A0AC\">%-13s</font> %s", key, value)
end

function Hud.setProgress(h: Hud, fraction: number, text: string)
	h.progress.Visible = true
	h.progressFill.Size = UDim2.new(math.clamp(fraction, 0, 1), 0, 1, 0)
	h.progressText.Text = text
end

function Hud.hideProgress(h: Hud)
	h.progress.Visible = false
end

local function hexOf(c: Color3): string
	return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

-- entries: { { side, feature, state, detail } }
function Hud.setCapabilities(h: Hud, entries: { { side: string, feature: string, state: string, detail: string } })
	local seen: { [string]: boolean } = {}
	for i, e in entries do
		local key = e.side .. ":" .. e.feature
		seen[key] = true
		local row = h.caps:FindFirstChild(key) :: TextLabel?
		if not row then
			row = label(key, h.caps, "", MONO, 12, INK, i)
		end
		assert(row)
		row.LayoutOrder = i
		local color = Hud.STATE_COLORS[e.state] or INK
		local text = string.format(
			"<font color=\"%s\">\u{25CF}</font> <font color=\"#96A0AC\">%s</font> <b>%s</b> <font color=\"%s\">%s</font> %s",
			hexOf(color),
			if e.side == "server" then "S" else "C",
			e.feature,
			hexOf(color),
			e.state,
			e.detail
		)
		if row.Text ~= text then
			row.Text = text
		end
	end
	for _, child in h.caps:GetChildren() do
		if child:IsA("TextLabel") and not seen[child.Name] then
			child:Destroy()
		end
	end
end

function Hud.addBenchButton(h: Hud, id: string, text: string, order: number, onClick: () -> ())
	local b = make("TextButton", {
		Name = id,
		Text = text,
		FontFace = SANS,
		TextSize = 13,
		TextColor3 = INK,
		BackgroundColor3 = Color3.fromRGB(44, 52, 64),
		AutoButtonColor = true,
		LayoutOrder = order,
		BorderSizePixel = 0,
	}, h.benchGrid) :: TextButton
	make("UICorner", { CornerRadius = UDim.new(0, 6) }, b)
	b.Activated:Connect(function()
		onClick()
	end)
	h.benchButtons[id] = b
end

function Hud.setBenchButtonState(h: Hud, id: string, state: string)
	local b = h.benchButtons[id]
	if not b then
		return
	end
	local c = Hud.STATE_COLORS[state]
	b.BackgroundColor3 = if c then c:Lerp(Color3.fromRGB(44, 52, 64), 0.55) else Color3.fromRGB(44, 52, 64)
end

function Hud.benchLog(h: Hud, line: string)
	table.insert(h.benchLines, line)
	while #h.benchLines > 9 do
		table.remove(h.benchLines, 1)
	end
	h.benchLog.Text = table.concat(h.benchLines, "\n")
end

function Hud.toast(h: Hud, text: string)
	h.toastLabel.Text = text
end

function Hud.toggle(h: Hud)
	h.visible = not h.visible
	h.root.Visible = h.visible
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="67">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Universe at Home: Meadow :: client entry point (StarterPlayerScripts.Client.Main)
--
-- Builds the HUD (metrics, world progress, self-check and capabilities, bench), flies
-- the camera over the valley while the server writes the terrain, then hands the
-- camera back when the character spawns. Grass rings, client Actors and the stress
-- bench start as separate stages; each one reports to the self-check panel and to
-- Output, and none can take the others down.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Stats = game:GetService("Stats")

local Demo = ReplicatedStorage:WaitForChild("Demo")
local Config = require(Demo:WaitForChild("Config"))
local Status = require(Demo:WaitForChild("Status"))
local Metrics = require(Demo:WaitForChild("Metrics"))
local Net = require(Demo:WaitForChild("Net"))

local Client = script.Parent :: Instance
local player = Players.LocalPlayer
local reg = Status.registry("client")
Status.set(reg, "client_start", "info", "Universe at Home: Meadow " .. Config.VERSION)

-- Shared client context handed to every client stage module.
local ctx: { [string]: any } = {
	reg = reg,
	config = Config,
	counters = {
		uploads = 0, -- WritePixelsBuffer calls this frame
		uploadBytes = 0,
		editableImages = 0, -- live EditableImages created by the demo
		editablePixels = 0, -- their pixel area
		editableMeshes = 0,
		grassTriangles = 0,
	},
	clientPool = nil,
}

local function optionalRequire(name: string): any
	local m = Client:FindFirstChild(name)
	if not m or not m:IsA("ModuleScript") then
		return nil
	end
	local ok, result = pcall(require, m)
	if ok then
		return result
	end
	Status.set(reg, "module_" .. name, "failed", tostring(result))
	return nil
end

-- HUD ------------------------------------------------------------------------------
local Hud: any = nil
local hud: any = nil
Status.stage(reg, "hud", function()
	Hud = require(script.Parent:WaitForChild("Hud"))
	hud = Hud.new()
	ctx.hud = hud
	ctx.Hud = Hud
	return "ok", "metrics, progress, capabilities, bench"
end)

local function hudCall(fn: (any) -> ())
	if hud then
		pcall(fn, hud)
	end
end

UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.H then
		hudCall(function(h)
			Hud.toggle(h)
		end)
	end
end)

-- Metrics ----------------------------------------------------------------------------
local frames = Metrics.ring(120)
local lastUploads, lastUploadBytes = 0, 0
RunService.RenderStepped:Connect(function(dt: number)
	Metrics.push(frames, dt)
	lastUploads = ctx.counters.uploads
	lastUploadBytes = ctx.counters.uploadBytes
	ctx.counters.uploads = 0
	ctx.counters.uploadBytes = 0
end)

local function mem(tag: Enum.DeveloperMemoryTag): string
	local ok, v = pcall(function(): number
		return Stats:GetMemoryUsageMbForTag(tag)
	end)
	return if ok then Metrics.formatMb(v) else "n/a"
end

local statusFolder = ReplicatedStorage:WaitForChild("DemoStatus", 30)

local function updateMetrics()
	local fps = Metrics.fps(frames)
	local p99 = Metrics.percentile(frames, 0.99) * 1000
	hudCall(function(h)
		Hud.setMetric(h, "FPS", string.format("<b>%.0f</b>  (p99 frame %.1f ms)", fps, p99))
		Hud.setMetric(h, "FrameTime", string.format("%.2f ms", Stats.FrameTime * 1000))
		Hud.setMetric(h, "Heartbeat", string.format("%.2f ms", Stats.HeartbeatTime * 1000))
		Hud.setMetric(h, "RenderCPU", string.format("%.2f ms", Stats.RenderCPUFrameTime * 1000))
		Hud.setMetric(h, "RenderGPU", string.format("%.2f ms", Stats.RenderGPUFrameTime * 1000))
		Hud.setMetric(h, "Triangles", string.format("%s  draws %d", Metrics.formatCount(Stats.SceneTriangleCount), Stats.SceneDrawcallCount))
		Hud.setMetric(h, "Memory", Metrics.formatMb(Stats:GetTotalMemoryUsageMb()))
		Hud.setMetric(h, "LuaHeap", mem(Enum.DeveloperMemoryTag.LuaHeap))
		Hud.setMetric(h, "GfxTexture", mem(Enum.DeveloperMemoryTag.GraphicsTexture))
		Hud.setMetric(h, "GfxMeshParts", mem(Enum.DeveloperMemoryTag.GraphicsMeshParts))
		Hud.setMetric(h, "GfxTerrain", mem(Enum.DeveloperMemoryTag.GraphicsTerrain))
		local c = ctx.counters
		Hud.setMetric(h, "Editables", string.format("%d images, %s px; %d meshes", c.editableImages, Metrics.formatCount(c.editablePixels), c.editableMeshes))
		Hud.setMetric(h, "Uploads", string.format("%d this frame (%s)", lastUploads, Metrics.formatCount(lastUploadBytes) .. " B"))
		local pool = ctx.clientPool
		local busy = if pool then string.format("%d busy of %d (%s)", pool.busyCount(), pool.size(), pool.mode()) else "not started"
		Hud.setMetric(h, "ClientActors", busy)
		if statusFolder then
			local sb = statusFolder:GetAttribute("ServerBusyActors")
			local sa = statusFolder:GetAttribute("ServerActors")
			Hud.setMetric(h, "ServerActors", string.format("%s busy of %s", tostring(sb or "?"), tostring(sa or "?")))
		end
		Hud.setMetric(h, "GrassTris", Metrics.formatCount(c.grassTriangles))
	end)
end

-- Capabilities panel: server mirror + client registry ---------------------------------
local function updateCapabilities()
	local entries: { { side: string, feature: string, state: string, detail: string } } = {}
	if statusFolder then
		for _, e in Status.fromAttributes(statusFolder:GetAttributes()) do
			table.insert(entries, { side = "server", feature = e.feature, state = e.state :: string, detail = e.detail })
		end
	end
	for _, e in Status.list(reg) do
		table.insert(entries, { side = "client", feature = e.feature, state = e.state :: string, detail = e.detail })
	end
	hudCall(function(h)
		Hud.setCapabilities(h, entries)
	end)
end

-- World progress ----------------------------------------------------------------------
local function updateProgress()
	if not statusFolder then
		hudCall(function(h)
			Hud.setProgress(h, 0, "No DemoStatus folder from the server (is the server script running?)")
		end)
		return
	end
	local ready = statusFolder:GetAttribute("WorldReady")
	local stage = statusFolder:GetAttribute("WorldStage") or "starting"
	local p = statusFolder:GetAttribute("WorldProgress") or 0
	local chunks = statusFolder:GetAttribute("WorldChunks") or 0
	local total = statusFolder:GetAttribute("WorldChunksTotal") or 0
	hudCall(function(h)
		if ready == true then
			Hud.hideProgress(h)
		else
			Hud.setProgress(h, tonumber(p) or 0, string.format("Generating the valley: %s  %d%%  (%s / %s chunks)", tostring(stage), math.floor((tonumber(p) or 0) * 100), tostring(chunks), tostring(total)))
		end
	end)
end

task.spawn(function()
	while true do
		pcall(updateMetrics)
		pcall(updateProgress)
		pcall(updateCapabilities)
		task.wait(Config.hud.refreshSeconds)
	end
end)

-- Camera: a slow orbit over the valley until the character exists ------------------------
Status.stage(reg, "camera", function()
	local camera = Workspace.CurrentCamera
	if not camera then
		return "fallback", "no CurrentCamera"
	end
	local t = 0
	local conn: RBXScriptConnection? = nil
	conn = RunService.RenderStepped:Connect(function(dt: number)
		if player.Character then
			if conn then
				conn:Disconnect()
			end
			camera.CameraType = Enum.CameraType.Custom
			local hum = player.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				camera.CameraSubject = hum
			end
			return
		end
		t += dt
		camera.CameraType = Enum.CameraType.Scriptable
		local a = t * 0.05
		local eye = Vector3.new(math.cos(a) * 340, 190, math.sin(a) * 340)
		camera.CFrame = CFrame.lookAt(eye, Vector3.new(0, 60, 0))
	end)
	return "ok", "orbiting until the character spawns"
end)

-- Self-check on start: what the engine offers this client -------------------------------
Status.stage(reg, "editable_image", function()
	local AssetService = game:GetService("AssetService")
	local img = AssetService:CreateEditableImage({ Size = Vector2.new(4, 4) })
	if not img then
		return "fallback", "CreateEditableImage returned nil (budget exhausted or APIs disabled)"
	end
	img:WritePixelsBuffer(Vector2.zero, Vector2.new(4, 4), buffer.create(64))
	img:Destroy()
	return "ok", "create, write and destroy work (max size 1024 documented)"
end, function(message: string)
	return "failed", "EditableImage unavailable; enable Allow Mesh / Image APIs in published places"
end)

Status.stage(reg, "editable_mesh", function()
	local AssetService = game:GetService("AssetService")
	local m = AssetService:CreateEditableMesh()
	if not m then
		return "fallback", "CreateEditableMesh returned nil (budget)"
	end
	local a = m:AddVertex(Vector3.new(0, 0, 0))
	local b = m:AddVertex(Vector3.new(1, 0, 0))
	local c = m:AddVertex(Vector3.new(0, 1, 0))
	m:AddTriangle(a, b, c)
	m:Destroy()
	return "ok", "create, add triangle and destroy work"
end, function(message: string)
	return "failed", "EditableMesh unavailable; enable Allow Mesh / Image APIs in published places"
end)

Status.stage(reg, "luau_speed", function()
	-- calibration kernel of docs/RUNTIME_AUDIT.md 6.6: constant writeu32 over 256 x 256
	local b = buffer.create(256 * 256 * 4)
	local t0 = os.clock()
	for o = 0, 256 * 256 * 4 - 4, 4 do
		buffer.writeu32(b, o, 0xFF336699)
	end
	local ms = (os.clock() - t0) * 1000
	ctx.calibrationMs = ms
	return "info", string.format("constant writeu32: %.2f ms per 64k px (x16 = %.1f ms per 1024^2; audit host 10.3 interp / 2.9 native)", ms, ms * 16)
end)

-- Later stages (grass, client Actors, bench): each module is optional ---------------------
task.spawn(function()
	local ClientActors = optionalRequire("ClientActors")
	if ClientActors then
		Status.stage(reg, "actors_client", function()
			return ClientActors.start(ctx)
		end)
	else
		Status.set(reg, "actors_client", "skipped", "ClientActors module not present")
	end
	local Grass = optionalRequire("Grass")
	if Grass then
		Status.stage(reg, "grass", function()
			return Grass.start(ctx)
		end)
	else
		Status.set(reg, "grass", "skipped", "Grass module not present")
	end
	local Bench = optionalRequire("Bench")
	if Bench then
		Status.stage(reg, "bench", function()
			return Bench.start(ctx)
		end)
	else
		Status.set(reg, "bench", "skipped", "Bench module not present")
	end
	-- Report to the server once the stages settled.
	task.wait(2)
	local hello = Net.clientGet(ReplicatedStorage, "Hello", 20) :: RemoteEvent?
	if hello then
		local okCount, total = 0, 0
		for _, e in Status.list(reg) do
			total += 1
			if e.state == "ok" or e.state == "info" then
				okCount += 1
			end
		end
		hello:FireServer({ version = Config.VERSION, summary = string.format("client features %d of %d ok", okCount, total) })
	end
	-- Self-check summary in Output.
	local lines = { "Self-check (client):" }
	for _, e in Status.list(reg) do
		table.insert(lines, string.format("  %-16s %-8s %s", e.feature, e.state, e.detail))
	end
	print(table.concat(lines, "\n"))
end)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="68">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="FallenPartsDestroyHeight">-500</float>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
    <Item class="Terrain" referent="69">
      <Properties>
        <string name="Name">Terrain</string>
        <bool name="Decoration">true</bool>
        <float name="GrassLength">0.85</float>
        <Color3 name="WaterColor">
          <R>0.149</R>
          <G>0.361</G>
          <B>0.376</B>
        </Color3>
        <float name="WaterReflectance">0.85</float>
        <float name="WaterTransparency">0.55</float>
        <float name="WaterWaveSize">0.12</float>
        <float name="WaterWaveSpeed">9</float>
      </Properties>
      <Item class="Clouds" referent="70">
        <Properties>
          <string name="Name">Clouds</string>
          <Color3 name="Color">
            <R>1</R>
            <G>0.933</G>
            <B>0.871</B>
          </Color3>
          <float name="Cover">0.58</float>
          <float name="Density">0.72</float>
          <bool name="Enabled">true</bool>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>