		"TqerpFJdWGRtaE1ZU15oYlBbVkhUT05aVX2EfpidlllkXmFrZnR9d6+xq1VgWlljXp6inMPEvWNtZ76/uFZhXMDBuuPg2VZh",
		"XJyhm8rKw9va0uTi2+Ph2eXi232EfsnKw4WMhrK1ruPg2U1ZVGJrZnyDfWhybHmAe6aqo4CHgXyDfePh2uTi27O2r5+knXuD",
		"fWlybb2+t8TEvZCWkGpzbQ==",
	},
}

local SCALE: { [string]: number } = {
	sdf_logo_256 = 0,
	ui_flat_256 = 0,
	marble_64 = 1,
}

local BYTES: { [string]: number } = {
	sdf_logo_256 = 15880,
	ui_flat_256 = 44773,
	marble_64 = 2968,
}

local Models = {}

Models.names = { "sdf_logo_256", "ui_flat_256", "marble_64" }

-- Decodes a model to a buffer (a new buffer on every call).
function Models.load(name: string): buffer
	local parts = DATA[name]
	assert(parts, "unknown ALLAN model " .. name)
	return decode(parts)
end

-- The render scale r (log2) the model expects, as in Liquid.prepare(model, tree, r).
function Models.scale(name: string): number
	return SCALE[name] or 0
end

-- Size in bytes of the encoded model.
function Models.bytes(name: string): number
	return assert(BYTES[name], "unknown ALLAN model " .. name)
end

return Models
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Panels</string>
          <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2
-- universe-at-home :: gallery/shared/Panels
--
-- Pixel generators for the EditableImage gallery. Pure Luau: no Roblox globals, buffers in and
-- out, so the same code runs in the Luau CLI (tests, PNG previews) and in a Roblox LocalScript.
-- MyMath is injected:  local Panels = require(path.to.Panels)(MyMath)
--
-- Buffers are row-major RGBA8, the EditableImage layout: a pixel read with readu32 is
-- r + g * 256 + b * 65536 + a * 16777216.
--
-- Every generator takes an optional progress(y0, y1) callback that fires after each batch of
-- finished rows [y0, y1). The gallery uses it to upload those rows to an EditableImage and to
-- yield to its frame-time scheduler, so heavy panels fill in over several frames.

return function(MyMath: any)
	local pack = MyMath.pack
	local hash32 = MyMath.hash32
	local dsinTurns = MyMath.dsinTurns
	local dcosTurns = MyMath.dcosTurns

	local sqrt, abs, floor, min, max = math.sqrt, math.abs, math.floor, math.min, math.max

	local M = {}
	M.noCull = false -- tests set this to render every pixel of every shape, without tile culling

	export type Progress = ((number, number) -> ())?
	type Shape = {
		sd: (number, number) -> number, -- signed distance in design units, negative inside, 1-Lipschitz
		r: number,
		g: number,
		b: number,
		a: number,
		blur: number, -- 0 = hard anti-aliased edge; > 0 = soft edge of that half-width (design units)
	}

	----------------------------------------------------------------------------------------
	-- Exact pixel coverage of a straight edge
	----------------------------------------------------------------------------------------

	-- Exact area of the unit pixel square inside the half-plane whose boundary passes at signed
	-- distance d from the pixel centre with unit normal (nx, ny) (docs/COMPUTE.md, C4). The
	-- pixel's projection onto the normal is a trapezoid; integrating it gives these four cases.
	-- Exactly 0 for d >= (|nx| + |ny|) / 2 and exactly 1 for d <= -(|nx| + |ny|) / 2.
	local function halfPlane(d: number, nx: number, ny: number): number
		local a, b = abs(nx), abs(ny)
		if a < b then
			a, b = b, a
		end
		local u = (a + b) * 0.5 - d
		if u <= 0 then
			return 0
		end
		if u >= a + b then
			return 1
		end
		if u < b then
			return u * u / (2 * a * b)
		end
		if u <= a then
			return (2 * u - b) / (2 * a)
		end
		local v = a + b - u
		return 1 - v * v / (2 * a * b)
	end
	M.halfPlane = halfPlane

	local REACH = 0.7071067811865476 -- largest |d| with 0 < coverage < 1 for any edge angle

	----------------------------------------------------------------------------------------
	-- Signed distance constructors (design units)
	----------------------------------------------------------------------------------------

	local function circle(cx: number, cy: number, r: number): (number, number) -> number
		return function(x, y)
			local dx, dy = x - cx, y - cy
			return sqrt(dx * dx + dy * dy) - r
		end
	end

	local function ring(cx: number, cy: number, r0: number, r1: number): (number, number) -> number
		local mid, half = (r0 + r1) * 0.5, (r1 - r0) * 0.5
		return function(x, y)
			local dx, dy = x - cx, y - cy
			return abs(sqrt(dx * dx + dy * dy) - mid) - half
		end
	end

	-- Rounded box with half extents (hx, hy), corner radius rad, rotated by rot turns.
	local function roundBox(cx: number, cy: number, hx: number, hy: number, rad: number, rot: number): (number, number) -> number
		local c, s = dcosTurns(rot), dsinTurns(rot)
		return function(x, y)
			local px, py = x - cx, y - cy
			local qx0 = c * px + s * py
			local qy0 = -s * px + c * py
			local qx = abs(qx0) - hx + rad
			local qy = abs(qy0) - hy + rad
			local ox = if qx > 0 then qx else 0
			local oy = if qy > 0 then qy else 0
			local inner = min(max(qx, qy), 0)
			return sqrt(ox * ox + oy * oy) + inner - rad
		end
	end

	local function capsule(ax: number, ay: number, bx: number, by: number, r: number): (number, number) -> number
		return function(x, y)
			return MyMath.sdSegment(x, y, ax, ay, bx, by, r)
		end
	end

	local function polygon(pts: { number }): (number, number) -> number
		return function(x, y)
			return MyMath.sdPolygon(x, y, pts)
		end
	end

	local function starPoints(cx: number, cy: number, outer: number, inner: number, points: number, rot: number): { number }
		local pts = {}
		for i = 0, points * 2 - 1 do
			local ang = i / (points * 2) + rot
			local rad = if i % 2 == 0 then outer else inner
			table.insert(pts, cx + rad * dcosTurns(ang))
			table.insert(pts, cy + rad * dsinTurns(ang))
		end
		return pts
	end

	local function shape(sd: (number, number) -> number, r: number, g: number, b: number, a: number?, blur: number?): Shape
		return { sd = sd, r = r, g = g, b = b, a = a or 1, blur = blur or 0 }
	end

	----------------------------------------------------------------------------------------
	-- Vector renderer: tile culling by the Lipschitz bound, per-pixel work only at edges
	----------------------------------------------------------------------------------------

	local function fillRect(buf: buffer, width: number, x0: number, y0: number, w: number, h: number, color: number)
		local row = width * 4
		local first = y0 * row + x0 * 4
		for i = 0, w - 1 do
			buffer.writeu32(buf, first + i * 4, color)
		end
		for r = 1, h - 1 do
			buffer.copy(buf, first + r * row, buf, first, w * 4)
		end
	end

	-- Renders opaque shapes (drawn in list order) over a flat background into an w x h buffer.
	-- Shapes live in a design space of `design` units; the image scales it to w pixels.
	-- A tile of T x T pixels whose centre is farther from a shape's boundary than the tile's
	-- half-diagonal plus the edge reach lies entirely inside or outside that shape (a 1-Lipschitz
	-- distance cannot change faster), so tiles no edge crosses are filled with buffer.copy and
	-- only edge tiles run per-pixel math.
	local function renderShapes(
		buf: buffer,
		w: number,
		h: number,
		shapes: { Shape },
		bgR: number,
		bgG: number,
		bgB: number,
		design: number,
		progress: Progress
	): (number, number)
		local s = w / design
		local T = if w >= 256 then 16 else 8
		local n = #shapes
		local state = table.create(n, 0) -- 0 outside, 1 inside, 2 edge (per tile)
		local active = table.create(n, 0)
		local rho = T * REACH
		local edgeTiles, tiles = 0, 0
		local GH = 0.25 -- gradient step in design units
		for ty = 0, (h + T - 1) // T - 1 do
			local y0 = ty * T
			local th = min(T, h - y0)
			for tx = 0, (w + T - 1) // T - 1 do
				local x0 = tx * T
				local tw = min(T, w - x0)
				tiles += 1
				local cxd, cyd = (x0 + tw * 0.5) / s, (y0 + th * 0.5) / s
				local nActive, anyEdge = 0, false
				for i = 1, n do
					local sh = shapes[i]
					local dc = sh.sd(cxd, cyd) * s
					local reach = if sh.blur > 0 then sh.blur * s else REACH
					local st
					if M.noCull then
						st = 2
						anyEdge = true
					elseif dc - rho >= reach + 1e-6 then
						st = 0
					elseif dc + rho <= -reach - 1e-6 then
						st = 1
					else
						st = 2
						anyEdge = true
					end
					state[i] = st
					if st ~= 0 then
						nActive += 1
						active[nActive] = i
					end
				end
				if not anyEdge then
					local r, g, b = bgR, bgG, bgB
					for k = 1, nActive do
						local sh = shapes[active[k]]
						r += (sh.r - r) * sh.a
						g += (sh.g - g) * sh.a
						b += (sh.b - b) * sh.a
					end
					fillRect(buf, w, x0, y0, tw, th, pack((r + 0.5) // 1, (g + 0.5) // 1, (b + 0.5) // 1, 255))
				else
					edgeTiles += 1
					for py = y0, y0 + th - 1 do
						local yd = (py + 0.5) / s
						for px = x0, x0 + tw - 1 do
							local xd = (px + 0.5) / s
							local r, g, b = bgR, bgG, bgB
							for k = 1, nActive do
								local i = active[k]
								local sh = shapes[i]
								local cov = 1
								if state[i] == 2 then
									local d = sh.sd(xd, yd) * s
									if sh.blur > 0 then
										local bl = sh.blur * s
										local t = 0.5 - d / (2 * bl)
										t = if t < 0 then 0 elseif t > 1 then 1 else t
										cov = t * t * (3 - 2 * t)
									elseif d >= REACH then
										cov = 0
									elseif d <= -REACH then
										cov = 1
									else
										local gx = sh.sd(xd + GH, yd) - sh.sd(xd - GH, yd)
										local gy = sh.sd(xd, yd + GH) - sh.sd(xd, yd - GH)
										local len = sqrt(gx * gx + gy * gy)
										if len > 0 then
											cov = halfPlane(d, gx / len, gy / len)
										else
											cov = if d < -0.5 then 1 elseif d > 0.5 then 0 else 0.5 - d
										end
									end
								end
								if cov > 0 then
									cov *= sh.a
									r += (sh.r - r) * cov
									g += (sh.g - g) * cov
									b += (sh.b - b) * cov
								end
							end
							buffer.writeu32(buf, (py * w + px) * 4, pack((r + 0.5) // 1, (g + 0.5) // 1, (b + 0.5) // 1, 255))
						end
					end
				end
			end
			if progress then
				progress(y0, y0 + th)
			end
		end
		return edgeTiles, tiles
	end

	----------------------------------------------------------------------------------------
	-- Panel 1: the badge scene (also the LOD source at any resolution)
	----------------------------------------------------------------------------------------

	local badge: { Shape }? = nil
	local function badgeShapes(): { Shape }
		if badge then
			return badge
		end
		local star = starPoints(256, 256, 70, 29, 5, -0.25)
		local list: { Shape } = {
			shape(circle(256, 256, 252), 26, 34, 74),
			shape(circle(256, 284, 172), 0, 0, 0, 0.5, 26),
			shape(circle(256, 256, 172), 255, 198, 72),
			shape(ring(256, 256, 126, 142), 34, 44, 100),
			shape(roundBox(256, 256, 86, 86, 30, 0.125), 236, 84, 96),
			shape(roundBox(256, 256, 60, 60, 20, 0.125), 255, 128, 118),
			shape(polygon(star), 255, 246, 220),
			shape(circle(256 + 205 * dcosTurns(0.06), 256 + 205 * dsinTurns(0.06), 20), 64, 214, 196),
			shape(circle(256 + 205 * dcosTurns(0.4), 256 + 205 * dsinTurns(0.4), 14), 255, 140, 200),
			shape(circle(256 + 205 * dcosTurns(0.72), 256 + 205 * dsinTurns(0.72), 24), 250, 250, 255),
			shape(capsule(196, 456, 316, 456, 9), 255, 255, 255, 0.75),
			shape(ring(256, 256, 238, 244), 255, 255, 255, 0.85),
		}
		badge = list
		return list
	end

	-- Renders the badge at any size; coordinates scale, so every resolution is its own exact
	-- sample of the vector source and levels agree. Returns (edge tiles, tiles).
	function M.renderScene(buf: buffer, w: number, h: number, progress: Progress): (number, number)
		return renderShapes(buf, w, h, badgeShapes(), 10, 12, 28, 512, progress)
	end

	----------------------------------------------------------------------------------------
	-- Panel 2: animated plasma (table-driven, a few ops per pixel)
	----------------------------------------------------------------------------------------

	local SIN = table.create(1024, 0)
	for i = 0, 1023 do
		SIN[i + 1] = dsinTurns(i / 1024)
	end
	-- indigo to magenta to amber to cream, interpolated linearly between four stops
	local PLASMA_STOPS = { { 18, 10, 64 }, { 200, 36, 140 }, { 255, 150, 48 }, { 255, 238, 205 } }
	local PALETTE = table.create(256, 0)
	for i = 0, 255 do
		local f = i / 255 * 3
		local k = min(floor(f), 2)
		local u = f - k
		local c0, c1 = PLASMA_STOPS[k + 1], PLASMA_STOPS[k + 2]
		PALETTE[i + 1] = pack(
			(c0[1] + (c1[1] - c0[1]) * u + 0.5) // 1,
			(c0[2] + (c1[2] - c0[2]) * u + 0.5) // 1,
			(c0[3] + (c1[3] - c0[3]) * u + 0.5) // 1,
			255
		)
	end

	export type PlasmaState = { w: number, h: number, rad: buffer, col: { number }, row: { number } }

	function M.plasmaInit(w: number, h: number): PlasmaState
		local rad = buffer.create(w * h * 4)
		for y = 0, h - 1 do
			for x = 0, w - 1 do
				local dx, dy = (x + 0.5) / w - 0.5, (y + 0.5) / h - 0.5
				buffer.writef32(rad, (y * w + x) * 4, sqrt(dx * dx + dy * dy))
			end
		end
		return { w = w, h = h, rad = rad, col = table.create(w, 0), row = table.create(h, 0) }
	end

	-- Fills buf with the plasma at time t (seconds).
	function M.plasmaFrame(st: PlasmaState, buf: buffer, t: number)
		local w, h = st.w, st.h
		local col, row, rad = st.col, st.row, st.rad
		local ta, tb, tc, td = t * 0.13, t * -0.17, t * 0.11, t * 0.23
		for x = 0, w - 1 do
			col[x + 1] = SIN[floor((x / w * 3.0 + ta) * 1024) % 1024 + 1]
		end
		for y = 0, h - 1 do
			row[y + 1] = SIN[floor((y / h * 4.0 + tb) * 1024) % 1024 + 1]
		end
		local o = 0
		for y = 0, h - 1 do
			local ry = row[y + 1]
			local dy = y / h * 2.0 + tc
			for x = 0, w - 1 do
				local diag = SIN[floor((x / w * 2.0 + dy) * 1024) % 1024 + 1]
				local rr = SIN[floor((buffer.readf32(rad, o) * 9.0 + td) * 1024) % 1024 + 1]
				local v = col[x + 1] + ry + diag + rr
				buffer.writeu32(buf, o, PALETTE[floor((v + 4) * 31.99) + 1])
				o += 4
			end
		end
	end

	----------------------------------------------------------------------------------------
	-- Panel 3: marble from deterministic fractal noise
	----------------------------------------------------------------------------------------

	function M.renderMarble(buf: buffer, w: number, h: number, seed: number, progress: Progress)
		local BATCH = 4
		for y0 = 0, h - 1, BATCH do
			local y1 = min(y0 + BATCH, h)
			for y = y0, y1 - 1 do
				for x = 0, w - 1 do
					local f = (MyMath.fbm2(x * 0.011, y * 0.011, seed, 5))
					-- two families of veins cut through the same warped noise field
					local t = 1 - abs(dsinTurns(x * 0.0045 + y * 0.0021 + 1.25 * f))
					local t2 = t * t
					local t4 = t2 * t2
					local t8 = t4 * t4
					local u = 1 - abs(dsinTurns(x * 0.0031 - y * 0.0038 + 2.1 * f + 0.37))
					local u2 = u * u
					local u8 = u2 * u2 * u2 * u2
					local wv = t8 + 0.22 * t2 * t + 0.55 * u8
					wv = if wv > 1 then 1 else wv
					-- ivory stone to blue-grey veins, with cloudy tone drift from the noise
					local warm = (f - 0.5) * 46
					local r = 238 + warm - (238 - 40) * wv
					local g = 232 + warm * 0.8 - (232 - 52) * wv
					local b = 220 + warm * 0.5 - (220 - 66) * wv
					buffer.writeu32(buf, (y * w + x) * 4, pack((r + 0.5) // 1, (g + 0.5) // 1, (b + 0.5) // 1, 255))
				end
			end
			if progress then
				progress(y0, y1)
			end
		end
	end

	----------------------------------------------------------------------------------------
	-- Panel 4: one tile of a canvas larger than the 1024 EditableImage limit
	----------------------------------------------------------------------------------------

	local MANDEL_PALETTE = table.create(512, 0)
	for i = 0, 511 do
		local t = i / 512
		local function ch(phase: number): number
			local v = 0.5 + 0.5 * dcosTurns(t * 2.0 + phase)
			return (v * v * 255 * 0.7 + v * 255 * 0.3 + 0.5) // 1
		end
		MANDEL_PALETTE[i + 1] = pack(ch(0.0), ch(0.1), ch(0.25), 255)
	end

	-- Tile (tx, ty) of a grid x grid canvas of size x size tiles: a Mandelbrot set zoomed to
	-- the seahorse valley. This one is for looking at, not for the determinism hash: it uses
	-- math.log for smooth colouring.
	function M.renderMandelbrotTile(buf: buffer, size: number, tx: number, ty: number, grid: number, progress: Progress)
		local cx, cy, span = -0.7436438870371587, 0.13182590420531197, 0.0036
		local total = size * grid
		local maxIter = 300
		local ln2 = math.log(2)
		for py = 0, size - 1 do
			local ci = cy + ((ty * size + py + 0.5) / total - 0.5) * span
			for px = 0, size - 1 do
				local cr = cx + ((tx * size + px + 0.5) / total - 0.5) * span
				local zr, zi, zr2, zi2 = 0, 0, 0, 0
				local n = 0
				while n < maxIter and zr2 + zi2 <= 256 do
					zi = 2 * zr * zi + ci
					zr = zr2 - zi2 + cr
					zr2 = zr * zr
					zi2 = zi * zi
					n += 1
				end
				local color
				if n >= maxIter then
					color = 0xFF000000
				else
					local mu = n + 1 - math.log(math.log(zr2 + zi2) * 0.5 / ln2) / ln2
					color = MANDEL_PALETTE[floor(mu * 6) % 512 + 1]
				end
				buffer.writeu32(buf, (py * size + px) * 4, color)
			end
			if progress and (py % 4 == 3 or py == size - 1) then
				progress(py - (py % 4), py + 1)
			end
		end
	end

	----------------------------------------------------------------------------------------
	-- Panels 5 to 7: green screen, matte, cut-out
	----------------------------------------------------------------------------------------

	local KEY_R, KEY_G, KEY_B = 0, 177, 64

	local function greenScreenShapes(): { Shape }
		local hair = {}
		for i = 0, 13 do
			local ang = -0.5 + 0.5 * (i + 0.5) / 14 -- fan over the top of the head
			local x0, y0 = 128 + 44 * dcosTurns(ang), 100 + 44 * dsinTurns(ang)
			local len = 12 + (i * 7 % 5) * 3
			local x1, y1 = 128 + (44 + len) * dcosTurns(ang), 100 + (44 + len) * dsinTurns(ang)
			table.insert(hair, shape(capsule(x0, y0, x1, y1, 0.9), 70, 44, 30))
		end
		local list: { Shape } = {
			shape(capsule(62, 196, 38, 238, 15), 58, 96, 196),
			shape(capsule(194, 196, 218, 238, 15), 58, 96, 196),
			shape(roundBox(128, 222, 66, 56, 30, 0), 58, 96, 196),
			shape(capsule(128, 138, 128, 160, 13), 214, 168, 140),
			shape(circle(128, 80, 47), 70, 44, 30),
			shape(circle(128, 104, 41), 232, 190, 160),
			shape(capsule(98, 164, 158, 164, 11), 204, 44, 56),
			shape(circle(114, 98, 4), 40, 30, 28),
			shape(circle(142, 98, 4), 40, 30, 28),
			shape(circle(198, 86, 26), 190, 225, 255, 0.45),
			shape(circle(189, 76, 7), 255, 255, 255, 0.7),
		}
		for _, hs in hair do
			table.insert(list, hs)
		end
		return list
	end

	-- A green-screen portrait with fine hair strands, a semi-transparent glass bubble and a
	-- little deterministic sensor noise.
	function M.renderGreenScreen(buf: buffer, w: number, h: number, progress: Progress)
		renderShapes(buf, w, h, greenScreenShapes(), KEY_R, KEY_G, KEY_B, 256, nil)
		for y0 = 0, h - 1, 16 do
			local y1 = min(y0 + 16, h)
			for y = y0, y1 - 1 do
				for x = 0, w - 1 do
					local o = (y * w + x) * 4
					local p = buffer.readu32(buf, o)
					local nz = hash32(x + y * w + 977) % 9 - 4
					local r = p % 256 + nz
					local g = (p // 256) % 256 + nz
					local b = (p // 65536) % 256 + nz
					r = if r < 0 then 0 elseif r > 255 then 255 else r
					g = if g < 0 then 0 elseif g > 255 then 255 else g
					b = if b < 0 then 0 elseif b > 255 then 255 else b
					buffer.writeu32(buf, o, pack(r, g, b, 255))
				end
			end
			if progress then
				progress(y0, y1)
			end
		end
	end

	-- Chroma key with soft alpha and colour decontamination. For a pixel C that is the key K
	-- mixed with foreground F at coverage alpha, C = alpha F + (1 - alpha) K, so
	-- F = (C - (1 - alpha) K) / alpha removes the green fringe at soft edges.
	-- matteOut gets alpha as grey; cutOut gets the foreground over a sunset backdrop.
	function M.keyMatte(src: buffer, w: number, h: number, matteOut: buffer, cutOut: buffer, progress: Progress)
		local LO, HI = 18, 100
		for y0 = 0, h - 1, 16 do
			local y1 = min(y0 + 16, h)
			for y = y0, y1 - 1 do
				-- backdrop: vertical sunset gradient with a sun disc
				local ty = y / h
				local br = 255 - 150 * ty
				local bg = 150 - 90 * ty
				local bb = 90 + 80 * ty
				for x = 0, w - 1 do
					local o = (y * w + x) * 4
					local p = buffer.readu32(src, o)
					local r, g, b = p % 256, (p // 256) % 256, (p // 65536) % 256
					local gd = g - (if r > b then r else b) -- how much greener than the other channels
					local a = 1 - (gd - LO) / (HI - LO)
					a = if a < 0 then 0 elseif a > 1 then 1 else a
					a = a * a * (3 - 2 * a)
					local fr, fg, fb = r, g, b
					if a > 0.02 then
						local ia = 1 - a
						fr = (r - ia * KEY_R) / a
						fg = (g - ia * KEY_G) / a
						fb = (b - ia * KEY_B) / a
						fr = if fr < 0 then 0 elseif fr > 255 then 255 else fr
						fg = if fg < 0 then 0 elseif fg > 255 then 255 else fg
						fb = if fb < 0 then 0 elseif fb > 255 then 255 else fb
					end
					local gray = (a * 255 + 0.5) // 1
					buffer.writeu32(matteOut, o, pack(gray, gray, gray, 255))
					-- sun disc, centred behind the glass bubble so its transparency is visible
					local dx, dy = x / w - 0.77, y / h - 0.34
					local sun = if dx * dx + dy * dy < 0.0144 then 1 else 0
					local bgr = br + (255 - br) * sun
					local bgg = bg + (236 - bg) * sun
					local bgb = bb + (180 - bb) * sun
					buffer.writeu32(
						cutOut,
						o,
						pack((fr * a + bgr * (1 - a) + 0.5) // 1, (fg * a + bgg * (1 - a) + 0.5) // 1, (fb * a + bgb * (1 - a) + 0.5) // 1, 255)
					)
				end
			end
			if progress then
				progress(y0, y1)
			end
		end
	end

	----------------------------------------------------------------------------------------
	-- LOD: continuous level blending without pops
	----------------------------------------------------------------------------------------

	local LOD_LO, LOD_HI = 80, 150 -- displayed size band (pixels) over which levels hand over

	-- Blend parameter f in [0, 1] for a displayed size in pixels: 0 = coarse level only,
	-- 1 = fine level only. Smoothstep over log size, so f is C1 in the size.
	function M.lodBlend(size: number): number
		local u = (math.log(size) - math.log(LOD_LO)) / (math.log(LOD_HI) - math.log(LOD_LO))
		u = if u < 0 then 0 elseif u > 1 then 1 else u
		return u * u * (3 - 2 * u)
	end

	-- Two-phase fade (docs/DESIGN.md, Saturn). Returns the transparencies (0 = opaque) of the
	-- coarse layer (below) and the fine layer (on top). Phase 1: the fine layer fades in over
	-- a fully opaque coarse layer. Phase 2: the fine layer is opaque and the coarse layer
	-- fades out beneath it. Never both layers half transparent at once, so a pixel that is
	-- covered in both levels never dips.
	function M.twoPhase(f: number): (number, number)
		if f < 0.5 then
			return 0, 1 - f * 2
		end
		return (f - 0.5) * 2, 0
	end

	-- The naive alternative for comparison: switch levels at the midpoint.
	function M.hardSwitch(f: number): (number, number)
		if f < 0.5 then
			return 0, 1
		end
		return 1, 0
	end

	-- Displayed size in pixels at time t: a slow zoom in and out between 36 and 288.
	function M.zoomSize(t: number): number
		local u = 0.5 - 0.5 * dcosTurns(t / 10)
		return 36 * (288 / 36) ^ u
	end

	----------------------------------------------------------------------------------------
	-- Helpers
	----------------------------------------------------------------------------------------

	-- Order-sensitive hash of a whole buffer (32-bit words), for determinism checks.
	function M.hashBuffer(buf: buffer): number
		local hsh = 0x9E3779B9
		for o = 0, buffer.len(buf) - 4, 4 do
			hsh = hash32(bit32.bxor(hsh, buffer.readu32(buf, o)))
		end
		return hsh
	end

	return M
end
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="4">
      <Properties>
        <string name="Name">Universe</string>
      </Properties>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Liquid</string>
          <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: Liquid (ALLAN, the Alpha Liquid network renderer)
--
-- docs/LIQUID.md is the specification; this header is the single source of truth for the
-- binary layout and for the exact arithmetic every implementation (Luau, the Python and
-- Luau learning builders, future GPU backends) must follow.
--
-- BINARY LAYOUT, version 1. All multi-byte values little-endian.
--
--   offset  field        type             meaning
--   0       magic        3 bytes          "ALN" (0x41 0x4C 0x4E)
--   3       version      u8               1
--   4       N            u8               neurons, 1..32
--   5       I            u8               input bytes per leaf, 1..16
--   6       M            u8               output channels, 1..8
--   7       K            u8               gain exponents, 1..31 (k in [0, K))
--   8       beta[N]      f64              neuron target bias
--           B[N*I]       f64              B[i*I + t] = weight of leaf byte t for neuron i
--           kBase[N]     f64              integer valued, may be negative
--           Cf[M*N]      f64              forward readout, Cf[m*N + i]
--           Cb[M*N]      f64              backward readout, Cb[m*N + i]
--           d[M]         f64              readout bias
--   then the quadtree:
--           width        u16              1..65535 pixels
--           height       u16              1..65535 pixels
--           maxDepth     u8               0..P (P defined below)
--           flags        ceil(F/8) bytes  one bit per visited node of depth < maxDepth, in
--                                         preorder, packed least significant bit first;
--                                         1 = split, 0 = leaf. F is the number of such nodes.
--           leaves       I bytes per leaf leaf bytes in preorder
--
-- Quadtree geometry. The root is the square [0, S) x [0, S), S = 2^P, P the smallest integer
-- with 2^P >= max(width, height). A node of depth t has side S >> t. Every split node has
-- all four children, visited in this order: (x0, y0), (x0 + h, y0), (x0, y0 + h),
-- (x0 + h, y0 + h), h = half the side. Nodes of depth maxDepth are leaves and have no
-- flag bit. The bit stream is self-delimiting; leaf bytes start at the next byte. A node
-- with no pixel inside [0, width) x [0, height) is still stored (builders make it a leaf
-- with zero bytes); the renderer never shows it, except the endless mode (X3) which may.
-- (Same layout as src/LiquidLearn.luau and tools/liquid_train.py.)
--
-- THE MODEL, in exactly this arithmetic (any reference implementation reproduces its bits):
--   u_t      = byte_t / 255                                  (one division)
--   b_i      = beta_i;  for t = 0..I-1: b_i = b_i + B[i*I + t] * u_t
--   k_i      = clamp(kBase_i + log2(leafSide) + r, 0, K - 1), leafSide = S >> depth in
--              stored pixels and r >= 0 the log2 render scale (r = 0: native resolution;
--              r > 0 renders 2^r x larger, every leaf scaled, docs/LIQUID.md X4). This is
--              "depthShift": small leaves are fast. kBase <= -K - r gives an instant
--              neuron (k = 0, g = 1, h = b).
--   g_i      = 2^-k_i (exact),  a_i = 1 - g_i (exact)
--   step     h_i = h_i + (b_i - h_i) * g_i                     (one base pixel)
--   passes   forward over x = 0..W-1 and backward over x = W-1..0 (W = width << r rendered
--            pixels); each pass starts at rest, h = b of its first pixel; hf(x), hb(x) are
--            the states after stepping pixel x
--   output   z_m = d_m; for i: z_m = z_m + Cf[m*N+i] * hf_i; for i: z_m = z_m + Cb[m*N+i] * hb_i
--   byte     clamp(floor(z_m + 0.5), 0, 255)
--   pixel    channel m is byte m of the RGBA8 pixel for m < 4 (missing channels: alpha 255,
--            others 0); channels 4..7 go to a second RGBA8 target with the same rule.
-- Liquid.reference* implement this literally (step by step). The event renderer evaluates the
-- same model in closed form (T1) and differs from it by the bounds proved in docs/LIQUID.md
-- ("Renderer results"): every byte within epsilon + 0.5 of the reference value (T2).
--
-- Deterministic ops only (docs/RUNTIME_AUDIT.md 6.5): + - * / floor, comparisons, integer
-- // and %, bit32 and integer buffer ops. No exp, log, pow, lerp, noise or random. Floor of
-- fractional values uses math.floor, never // (MSVC fast-math caveat).

local MyMath = require("./MyMath")
local Pixels = require("./Pixels")

local Liquid = {}
Liquid.VERSION = 1

local floor = math.floor
local hash32 = MyMath.hash32
local hash2 = MyMath.hash2
local fillSpan = Pixels.fillSpan

local JMAX = 62 -- drop tables cover residual ratios up to 2^62
-- Powers of two built by exact doubling and halving (the ^ operator is libm pow, which the
-- deterministic op set excludes even though it is exact for powers of two on sane libms).
local POW2: { number } = table.create(1024, 1) -- POW2[e + 1] = 2^e, e = 0..1023
local POW2N: { number } = table.create(1075, 1) -- POW2N[e + 1] = 2^-e, e = 0..1074
do
	local p = 1
	for e = 1, 1023 do
		p *= 2
		POW2[e + 1] = p
	end
	p = 1
	for e = 1, 1074 do
		p *= 0.5
		POW2N[e + 1] = p
	end
end
local function pow2(e: number): number
	return if e >= 0 then POW2[e + 1] else POW2N[1 - e]
end

local ETA = 1 / 16777216 -- 2^-24: slack of the quantisation-margin skip, in output units
local SHRINK = 1 - 1 / 1099511627776 -- 1 - 2^-40: absorbs rounding of computed bounds
local NONE = -math.huge -- "no output pixel" (output pixels may be negative in the endless mode)

export type Model = {
	N: number,
	I: number,
	M: number,
	K: number,
	beta: { number },
	B: { number },
	kBase: { number },
	Cf: { number },
	Cb: { number },
	d: { number },
}

export type Tree = {
	width: number,
	height: number,
	maxDepth: number,
	P: number,
	S: number,
	I: number,
	nodeCount: number,
	leafCount: number,
	flagCount: number,
	nodes: buffer, -- u32 per node, preorder: leaf -> leafIndex * 2 + 1, internal -> subtreeSize * 2
	leafBytes: buffer, -- I bytes per leaf in preorder, plus 8 zero bytes of padding
	leafDepth: buffer, -- u8 per leaf
	leafKey: buffer, -- u32 per leaf: content id; equal bytes <=> equal id
	keyCount: number,
	keyLeaf: buffer, -- u32 per key: a leaf carrying that content
	virt: VirtualStats?, -- lazily built statistics for the endless mode (X3)
}

export type VirtualStats = {
	nodesAt: { number }, -- [t + 1] = nodes of depth t with a pixel inside the image
	splitsAt: { number }, -- [t + 1] = split ones among them
	leavesAt: { { number } }, -- [t + 1] = leaf indices of depth t inside the image
	all: { number }, -- every leaf inside the image
}

----------------------------------------------------------------------------------------
-- Model
----------------------------------------------------------------------------------------

local function checkArray(name: string, a: { number }, n: number)
	assert(#a == n, `{name} must have {n} entries, has {#a}`)
	for j = 1, n do
		local v = a[j]
		assert(v == v and v > -math.huge and v < math.huge, `{name}[{j}] is not finite`)
	end
end

-- Validates and copies a model table.
function Liquid.newModel(spec: Model): Model
	local N, I, M, K = spec.N, spec.I, spec.M, spec.K
	assert(N >= 1 and N <= 32 and N % 1 == 0, "N must be an integer in 1..32")
	assert(I >= 1 and I <= 16 and I % 1 == 0, "I must be an integer in 1..16")
	assert(M >= 1 and M <= 8 and M % 1 == 0, "M must be an integer in 1..8")
	assert(K >= 1 and K <= 31 and K % 1 == 0, "K must be an integer in 1..31")
	checkArray("beta", spec.beta, N)
	checkArray("B", spec.B, N * I)
	checkArray("kBase", spec.kBase, N)
	checkArray("Cf", spec.Cf, M * N)
	checkArray("Cb", spec.Cb, M * N)
	checkArray("d", spec.d, M)
	for j = 1, N do
		assert(spec.kBase[j] % 1 == 0, "kBase entries must be integers")
	end
	return {
		N = N,
		I = I,
		M = M,
		K = K,
		beta = table.clone(spec.beta),
		B = table.clone(spec.B),
		kBase = table.clone(spec.kBase),
		Cf = table.clone(spec.Cf),
		Cb = table.clone(spec.Cb),
		d = table.clone(spec.d),
	}
end

----------------------------------------------------------------------------------------
-- Tree: parsing from the flag bit stream, building, encoding
----------------------------------------------------------------------------------------

local function rootLog2(width: number, height: number): number
	local m = if width > height then width else height
	local p, s = 0, 1
	while s < m do
		s *= 2
		p += 1
	end
	return p
end

-- Parses a quadtree whose flag bits start at byte `fo` of `src` and whose leaf bytes follow.
-- Returns the tree and the offset just past the leaf bytes.
local function parseTree(
	src: buffer,
	fo: number,
	width: number,
	height: number,
	maxDepth: number,
	I: number
): (Tree, number)
	assert(width >= 1 and width <= 65535 and height >= 1 and height <= 65535, "bad tree size")
	local P = rootLog2(width, height)
	assert(maxDepth >= 0 and maxDepth <= P, "maxDepth must be in 0..P")
	local S = pow2(P)
	local srcLen = buffer.len(src)

	-- pass 1: count nodes, leaves and flags
	local flagPos = 0
	local nodeCount, leafCount = 0, 0
	local function readFlag(): number
		local byteAt = fo + flagPos // 8
		assert(byteAt < srcLen, "flag stream truncated")
		local bit = bit32.extract(buffer.readu8(src, byteAt), flagPos % 8)
		flagPos += 1
		return bit
	end
	local function count(depth: number)
		nodeCount += 1
		if depth < maxDepth and readFlag() == 1 then
			count(depth + 1)
			count(depth + 1)
			count(depth + 1)
			count(depth + 1)
		else
			leafCount += 1
		end
	end
	count(0)
	local flagCount = flagPos
	local leafAt = fo + (flagCount + 7) // 8
	local leafEnd = leafAt + leafCount * I
	assert(leafEnd <= srcLen, "leaf bytes truncated")

	-- pass 2: node records
	local nodes = buffer.create(nodeCount * 4)
	local leafDepth = buffer.create(leafCount)
	flagPos = 0
	local nextNode, nextLeaf = 0, 0
	local function fill(depth: number): number
		local idx = nextNode
		nextNode += 1
		if depth < maxDepth and readFlag() == 1 then
			local size = 1 + fill(depth + 1)
			size += fill(depth + 1)
			size += fill(depth + 1)
			size += fill(depth + 1)
			buffer.writeu32(nodes, idx * 4, size * 2)
			return size
		end
		buffer.writeu32(nodes, idx * 4, nextLeaf * 2 + 1)
		buffer.writeu8(leafDepth, nextLeaf, depth)
		nextLeaf += 1
		return 1
	end
	fill(0)

	local leafBytes = buffer.create(leafCount * I + 8)
	buffer.copy(leafBytes, 0, src, leafAt, leafCount * I)

	-- content keys: equal bytes <=> equal key (exact integer keys for I <= 6, strings otherwise)
	local leafKey = buffer.create(leafCount * 4)
	local keyOf: { [any]: number } = {}
	local keyLeafList: { number } = {}
	local keyCount = 0
	for l = 0, leafCount - 1 do
		local at = l * I
		local key: any
		if I <= 6 then
			local v = 0
			for t = I - 1, 0, -1 do
				v = v * 256 + buffer.readu8(leafBytes, at + t)
			end
			key = v
		else
			key = buffer.readstring(leafBytes, at, I)
		end
		local id = keyOf[key]
		if id == nil then
			id = keyCount
			keyOf[key] = id
			keyCount += 1
			keyLeafList[keyCount] = l
		end
		buffer.writeu32(leafKey, l * 4, id)
	end
	local keyLeaf = buffer.create(math.max(keyCount, 1) * 4)
	for j = 1, keyCount do
		buffer.writeu32(keyLeaf, (j - 1) * 4, keyLeafList[j])
	end

	local tree: Tree = {
		width = width,
		height = height,
		maxDepth = maxDepth,
		P = P,
		S = S,
		I = I,
		nodeCount = nodeCount,
		leafCount = leafCount,
		flagCount = flagCount,
		nodes = nodes,
		leafBytes = leafBytes,
		leafDepth = leafDepth,
		leafKey = leafKey,
		keyCount = keyCount,
		keyLeaf = keyLeaf,
		virt = nil,
	}
	return tree, leafEnd
end

-- Builds a tree from a preorder bit stream (flags) and leaf bytes, as stored in the binary.
function Liquid.newTree(width: number, height: number, maxDepth: number, I: number, flags: buffer, leaves: buffer): Tree
	local fbytes = buffer.len(flags)
	local tmp = buffer.create(fbytes + buffer.len(leaves))
	buffer.copy(tmp, 0, flags, 0, fbytes)
	-- the flag stream may be longer than needed; parseTree finds the true length, so place
	-- the leaves right after the bytes the flags actually use by parsing twice
	local probe = parseTree(tmp, 0, width, height, maxDepth, I)
	local used = (probe.flagCount + 7) // 8
	local src = buffer.create(used + buffer.len(leaves))
	buffer.copy(src, 0, flags, 0, used)
	buffer.copy(src, used, leaves, 0, buffer.len(leaves))
	local tree = parseTree(src, 0, width, height, maxDepth, I)
	return tree
end

-- Builds a tree by preorder traversal. split(x0, y0, side, depth) decides whether a present
-- node of depth < maxDepth splits; leaf(x0, y0, side, depth, out, at) writes the leaf's I
-- bytes into `out` at byte offset `at`.
function Liquid.buildTree(
	width: number,
	height: number,
	maxDepth: number,
	I: number,
	split: (number, number, number, number) -> boolean,
	leaf: (number, number, number, number, buffer, number) -> ()
): Tree
	local P = rootLog2(width, height)
	assert(maxDepth >= 0 and maxDepth <= P, "maxDepth must be in 0..P")
	local flags: { number } = {}
	local leafCap = 1024
	local leaves = buffer.create(leafCap * I)
	local leafCount = 0
	local function visit(depth: number, x0: number, y0: number, side: number)
		local s = false
		if depth < maxDepth then
			s = split(x0, y0, side, depth)
			table.insert(flags, if s then 1 else 0)
		end
		if s then
			local h = side // 2
			visit(depth + 1, x0, y0, h)
			visit(depth + 1, x0 + h, y0, h)
			visit(depth + 1, x0, y0 + h, h)
			visit(depth + 1, x0 + h, y0 + h, h)
		else
			if leafCount == leafCap then
				local bigger = buffer.create(leafCap * 2 * I)
				buffer.copy(bigger, 0, leaves, 0, leafCap * I)
				leaves = bigger
				leafCap *= 2
			end
			leaf(x0, y0, side, depth, leaves, leafCount * I)
			leafCount += 1
		end
	end
	visit(0, 0, 0, pow2(P))
	local fb = buffer.create((#flags + 7) // 8 + leafCount * I)
	for j = 1, #flags do
		if flags[j] == 1 then
			local p = j - 1
			local at = p // 8
			buffer.writeu8(fb, at, buffer.readu8(fb, at) + bit32.lshift(1, p % 8))
		end
	end
	local fo = (#flags + 7) // 8
	buffer.copy(fb, fo, leaves, 0, leafCount * I)
	local tree = parseTree(fb, 0, width, height, maxDepth, I)
	return tree
end

-- Reconstructs the preorder flag bits of a parsed tree (for encoding).
local function treeFlags(tree: Tree): buffer
	local out = buffer.create((tree.flagCount + 7) // 8)
	local pos = 0
	local nodes, D = tree.nodes, tree.maxDepth
	local function walk(n: number, depth: number): number
		local v = buffer.readu32(nodes, n * 4)
		local isLeaf = v % 2 == 1
		if depth < D then
			if not isLeaf then
				local at = pos // 8
				buffer.writeu8(out, at, buffer.readu8(out, at) + bit32.lshift(1, pos % 8))
			end
			pos += 1
		end
		if isLeaf then
			return 1
		end
		local c = n + 1
		local size = 1
		for _ = 1, 4 do
			local sz = walk(c, depth + 1)
			size += sz
			c += sz
		end
		return size
	end
	walk(0, 0)
	assert(pos == tree.flagCount, "flag count mismatch")
	return out
end

local function writeF64s(b: buffer, at: number, a: { number }): number
	for j = 1, #a do
		buffer.writef64(b, at, a[j])
		at += 8
	end
	return at
end

local function readF64s(b: buffer, at: number, n: number): ({ number }, number)
	local a = table.create(n, 0)
	for j = 1, n do
		a[j] = buffer.readf64(b, at)
		at += 8
	end
	return a, at
end

-- Serialises a model and a tree into one version-1 blob.
function Liquid.encode(model: Model, tree: Tree): buffer
	local N, I, M = model.N, model.I, model.M
	assert(tree.I == I, "tree and model disagree on I")
	local flags = treeFlags(tree)
	local floats = N + N * I + N + 2 * M * N + M
	local size = 8 + floats * 8 + 5 + buffer.len(flags) + tree.leafCount * I
	local b = buffer.create(size)
	buffer.writeu8(b, 0, 0x41)
	buffer.writeu8(b, 1, 0x4C)
	buffer.writeu8(b, 2, 0x4E)
	buffer.writeu8(b, 3, Liquid.VERSION)
	buffer.writeu8(b, 4, N)
	buffer.writeu8(b, 5, I)
	buffer.writeu8(b, 6, M)
	buffer.writeu8(b, 7, model.K)
	local at = 8
	at = writeF64s(b, at, model.beta)
	at = writeF64s(b, at, model.B)
	at = writeF64s(b, at, model.kBase)
	at = writeF64s(b, at, model.Cf)
	at = writeF64s(b, at, model.Cb)
	at = writeF64s(b, at, model.d)
	buffer.writeu16(b, at, tree.width)
	buffer.writeu16(b, at + 2, tree.height)
	buffer.writeu8(b, at + 4, tree.maxDepth)
	at += 5
	buffer.copy(b, at, flags, 0, buffer.len(flags))
	at += buffer.len(flags)
	buffer.copy(b, at, tree.leafBytes, 0, tree.leafCount * I)
	return b
end

-- Parses a version-1 blob. Returns the model, the tree and the offset after the blob.
function Liquid.decode(b: buffer, offset: number?): (Model, Tree, number)
	local at = offset or 0
	assert(buffer.len(b) >= at + 8, "blob too short")
	assert(
		buffer.readu8(b, at) == 0x41 and buffer.readu8(b, at + 1) == 0x4C and buffer.readu8(b, at + 2) == 0x4E,
		"not an ALLAN blob (magic)"
	)
	local version = buffer.readu8(b, at + 3)
	assert(version == 1, `unsupported ALLAN version {version}`)
	local N, I, M, K = buffer.readu8(b, at + 4), buffer.readu8(b, at + 5), buffer.readu8(b, at + 6), buffer.readu8(b, at + 7)
	at += 8
	local floats = N + N * I + N + 2 * M * N + M
	assert(buffer.len(b) >= at + floats * 8 + 5, "blob truncated in the model arrays")
	local beta, B, kBase, Cf, Cb, d
	beta, at = readF64s(b, at, N)
	B, at = readF64s(b, at, N * I)
	kBase, at = readF64s(b, at, N)
	Cf, at = readF64s(b, at, M * N)
	Cb, at = readF64s(b, at, M * N)
	d, at = readF64s(b, at, M)
	local model = Liquid.newModel({ N = N, I = I, M = M, K = K, beta = beta, B = B, kBase = kBase, Cf = Cf, Cb = Cb, d = d })
	local width, height, maxDepth = buffer.readu16(b, at), buffer.readu16(b, at + 2), buffer.readu8(b, at + 4)
	local tree, after = parseTree(b, at + 5, width, height, maxDepth, I)
	return model, tree, after
end

local function sizeOf(nodes: buffer, n: number): number
	local v = buffer.readu32(nodes, n * 4)
	return if v % 2 == 1 then 1 else v // 2
end

-- Leaf containing pixel (x, y) of the stored tree: leaf index and depth. It walks the tree
-- independently of the row traversal used by the event renderer; the reference uses it.
-- Returns -1, -1 outside the image.
function Liquid.leafAt(tree: Tree, x: number, y: number): (number, number)
	if x < 0 or y < 0 or x >= tree.width or y >= tree.height then
		return -1, -1
	end
	local nodes = tree.nodes
	local n, x0, y0, side, depth = 0, 0, 0, tree.S, 0
	while true do
		local v = buffer.readu32(nodes, n * 4)
		if v % 2 == 1 then
			return (v - 1) // 2, depth
		end
		local h = side // 2
		local c = n + 1
		local right = x >= x0 + h
		local bottom = y >= y0 + h
		if bottom then
			c += sizeOf(nodes, c) -- skip child 0
			c += sizeOf(nodes, c) -- skip child 1
		end
		if right then
			c += sizeOf(nodes, c) -- skip the left child of the chosen pair
		end
		n = c
		if right then
			x0 += h
		end
		if bottom then
			y0 += h
		end
		side = h
		depth += 1
	end
end

----------------------------------------------------------------------------------------
-- Plan: everything that depends only on the model and the root size, precomputed once.
-- Every table is filled by a fixed sequence of deterministic operations, so every client
-- holds bit-identical tables (part of the fixed evaluation schedule of T1 and T7).
----------------------------------------------------------------------------------------

export type Plan = {
	model: Model,
	N: number,
	I: number,
	M: number,
	K: number,
	P: number, -- log2 of the stored root side
	S: number, -- stored root side
	R: number, -- log2 render scale r (X4); rendered geometry is the stored one times 2^R
	Wr: number, -- rendered width = width * 2^R
	Hr: number, -- rendered height
	Sr: number, -- rendered root side
	T: number, -- longest segment the power tables cover (= Sr)
	TP1: number, -- T + 1
	U: { number }, -- U[byte + 1] = byte / 255
	gk: { number }, -- gk[k + 1] = 2^-k
	pw: { number }, -- pw[k * TP1 + n + 1] = a_k^n, n = 0..T
	S1: { number }, -- S1[k * TP1 + n + 1] = sum_{t < n} a_k^t
	NT: { number }, -- NT[k * (JMAX + 1) + j + 1] = smallest n <= T with a_k^n <= 2^-j, else T + 1
	Csum: { number }, -- Cf + Cb
	kOf: { number }, -- kOf[t * N + i] = gain exponent of neuron i (1-based) in a leaf of depth t
	pwOff: { number }, -- pwOff[t * N + i] = kOf * TP1 + 1
	nCls: { number }, -- nCls[t + 1] = number of distinct gains k >= 1 at depth t
	clsK: { number }, -- clsK[t * K + c] = gain of class c at depth t, ascending
	clsOf: { number }, -- clsOf[t * N + i] = class of neuron i at depth t, 0 when k = 0
	G: { number }, -- G[L * K + k + 1] = S1[k][2^L] / 2^L (T5 footprint factor)
	-- fast path (M <= 4): tracked neurons are those with k >= 1 at some depth; the others
	-- are instant everywhere (h = b exactly) and never enter a transient
	nt: number,
	trk: { number }, -- trk[j] = neuron index of tracked neuron j
	trkOff: { number }, -- trkOff[t * nt + j] = pw offset of tracked neuron j at depth t
	trkCls: { number }, -- trkCls[t * nt + j] = its class at depth t (0 when k = 0 there)
	CfT4: { number }, -- CfT4[(j - 1) * 4 + m] = Cf[m][trk[j]], zero for m > M
	CbT4: { number },
	-- tracked neurons with equal kBase share k at every depth: a group. The fast path
	-- tracks each group's readout-projected state sum_{i in g} Cf[m][i] h_i (and Cb), which
	-- jumps exactly like one neuron (linearity), so no per-segment projection is needed.
	NG: number,
	grpOf: { number }, -- grpOf[j] = group of tracked neuron j
	grpOff: { number }, -- grpOff[t * G + g] = pw offset of group g at depth t
	grpCls: { number }, -- grpCls[t * G + g] = class of group g at depth t (0 when k = 0)
	maxSeg: number,
	scratch: any,
}

-- renderScale: log2 of the render scale r (default 0). The plan depends on the tree only
-- through its root size, so trees of equal root size can share a plan.
function Liquid.prepare(model: Model, tree: Tree, renderScale: number?): Plan
	local N, I, M, K = model.N, model.I, model.M, model.K
	assert(tree.I == I, "tree and model disagree on I")
	local R = renderScale or 0
	assert(R >= 0 and R <= 8 and R % 1 == 0, "render scale must be an integer in 0..8")
	local P, S = tree.P, tree.S
	local sf = pow2(R)
	local T = S * sf
	assert(T <= 65536, "rendered root side above 65536")
	local TP1 = T + 1
	local U = table.create(256, 0)
	for v = 0, 255 do
		U[v + 1] = v / 255
	end
	local gk = table.create(K, 0)
	for k = 0, K - 1 do
		gk[k + 1] = POW2N[k + 1] -- 2^-k exactly
	end
	local pw = table.create(K * TP1, 0)
	local S1 = table.create(K * TP1, 0)
	local NT = table.create(K * (JMAX + 1), 0)
	for k = 0, K - 1 do
		local a = 1 - gk[k + 1]
		local base = k * TP1
		pw[base + 1] = 1
		if T >= 1 then
			pw[base + 2] = a
		end
		for n = 2, T do
			local h = n // 2
			pw[base + n + 1] = pw[base + h + 1] * pw[base + n - h + 1]
		end
		S1[base + 1] = 0
		for n = 1, T do
			S1[base + n + 1] = S1[base + n] + pw[base + n]
		end
		local j = 0
		local thr = 1
		local nb = k * (JMAX + 1)
		for n = 0, T do
			local p = pw[base + n + 1]
			while j <= JMAX and p <= thr do
				NT[nb + j + 1] = n
				j += 1
				thr *= 0.5
			end
		end
		while j <= JMAX do
			NT[nb + j + 1] = T + 1
			j += 1
		end
	end
	local Csum = table.create(M * N, 0)
	for j = 1, M * N do
		Csum[j] = model.Cf[j] + model.Cb[j]
	end
	local kOf = table.create((P + 1) * N, 0)
	local pwOff = table.create((P + 1) * N, 0)
	local nCls = table.create(P + 1, 0)
	local clsK = table.create((P + 1) * K, 0)
	local clsOf = table.create((P + 1) * N, 0)
	for t = 0, P do
		local present = table.create(K, false)
		for i = 1, N do
			local k = model.kBase[i] + (P - t) + R
			if k < 0 then
				k = 0
			elseif k > K - 1 then
				k = K - 1
			end
			kOf[t * N + i] = k
			pwOff[t * N + i] = k * TP1 + 1
			if k >= 1 then
				present[k + 1] = true
			end
		end
		local nc = 0
		local idx = table.create(K, 0)
		for k = 1, K - 1 do
			if present[k + 1] then
				nc += 1
				clsK[t * K + nc] = k
				idx[k + 1] = nc
			end
		end
		nCls[t + 1] = nc
		for i = 1, N do
			local k = kOf[t * N + i]
			clsOf[t * N + i] = if k >= 1 then idx[k + 1] else 0
		end
	end
	local G = table.create((P + R + 1) * K, 0)
	for L = 0, P + R do
		local F = pow2(L)
		for k = 0, K - 1 do
			G[L * K + k + 1] = S1[k * TP1 + F + 1] / F
		end
	end
	local trk: { number } = {}
	for i = 1, N do
		local tracked = false
		for t = 0, P do
			if kOf[t * N + i] >= 1 then
				tracked = true
			end
		end
		if tracked then
			table.insert(trk, i)
		end
	end
	local nt = #trk
	local trkOff = table.create((P + 1) * math.max(nt, 1), 0)
	local trkCls = table.create((P + 1) * math.max(nt, 1), 0)
	for t = 0, P do
		for j = 1, nt do
			trkOff[t * nt + j] = pwOff[t * N + trk[j]]
			trkCls[t * nt + j] = clsOf[t * N + trk[j]]
		end
	end
	local grpOf = table.create(math.max(nt, 1), 0)
	local grpBase: { number } = {}
	local grpRep: { number } = {}
	for j = 1, nt do
		local kb = model.kBase[trk[j]]
		local g = 0
		for q = 1, #grpBase do
			if grpBase[q] == kb then
				g = q
			end
		end
		if g == 0 then
			table.insert(grpBase, kb)
			table.insert(grpRep, trk[j])
			g = #grpBase
		end
		grpOf[j] = g
	end
	local NG = #grpBase
	local grpOff = table.create((P + 1) * math.max(NG, 1), 0)
	local grpCls = table.create((P + 1) * math.max(NG, 1), 0)
	for t = 0, P do
		for g = 1, NG do
			grpOff[t * NG + g] = pwOff[t * N + grpRep[g]]
			grpCls[t * NG + g] = clsOf[t * N + grpRep[g]]
		end
	end
	local CfT4 = table.create(math.max(nt, 1) * 4, 0)
	local CbT4 = table.create(math.max(nt, 1) * 4, 0)
	for j = 1, nt do
		for m = 1, math.min(M, 4) do
			CfT4[(j - 1) * 4 + m] = model.Cf[(m - 1) * N + trk[j]]
			CbT4[(j - 1) * 4 + m] = model.Cb[(m - 1) * N + trk[j]]
		end
	end
	local plan: Plan = {
		model = model,
		N = N,
		I = I,
		M = M,
		K = K,
		P = P,
		S = S,
		R = R,
		Wr = tree.width * sf,
		Hr = tree.height * sf,
		Sr = T,
		T = T,
		TP1 = TP1,
		U = U,
		gk = gk,
		pw = pw,
		S1 = S1,
		NT = NT,
		Csum = Csum,
		kOf = kOf,
		pwOff = pwOff,
		nCls = nCls,
		clsK = clsK,
		clsOf = clsOf,
		G = G,
		nt = nt,
		trk = trk,
		trkOff = trkOff,
		trkCls = trkCls,
		CfT4 = CfT4,
		CbT4 = CbT4,
		NG = NG,
		grpOf = grpOf,
		grpOff = grpOff,
		grpCls = grpCls,
		maxSeg = T + 2,
		scratch = nil,
	}
	return plan
end

-- Smallest j >= 0 with 2^j >= r, for r > 0, by exact binary exponent search (multiplying
-- by powers of two is exact): at most 10 comparisons, no logarithm. Proof in LIQUID.md T3.
local function ceilLog2(r: number): number
	if r <= 1 then
		return 0
	end
	local e = 0
	if r > POW2[512 + 1] then
		r *= POW2N[512 + 1]
		e += 512
	end
	if r > POW2[256 + 1] then
		r *= POW2N[256 + 1]
		e += 256
	end
	if r > POW2[128 + 1] then
		r *= POW2N[128 + 1]
		e += 128
	end
	if r > POW2[64 + 1] then
		r *= POW2N[64 + 1]
		e += 64
	end
	if r > POW2[32 + 1] then
		r *= POW2N[32 + 1]
		e += 32
	end
	if r > 65536 then
		r *= POW2N[16 + 1]
		e += 16
	end
	if r > 256 then
		r *= POW2N[8 + 1]
		e += 8
	end
	if r > 16 then
		r *= POW2N[4 + 1]
		e += 4
	end
	if r > 4 then
		r *= 0.25
		e += 2
	end
	if r > 2 then
		e += 1
	end
	return e + 1
end
Liquid.ceilLog2 = ceilLog2

-- Distance from z to the nearest point where clamp(floor(z + 0.5), 0, 255) changes.
local function margin(z: number): number
	if z < 0.5 then
		return 0.5 - z
	end
	if z >= 254.5 then
		return z - 254.5
	end
	local f = z + 0.5 - floor(z + 0.5)
	return if f < 0.5 then f else 1 - f
end
Liquid.margin = margin

----------------------------------------------------------------------------------------
-- Scratch space (per plan): segment arrays, traversal stack, per-segment work arrays
----------------------------------------------------------------------------------------

type Scratch = {
	cap: number,
	sx: { number }, -- segment start (base pixels, absolute)
	sl: { number }, -- segment length
	skey: { number }, -- leaf content key (equal key and depth <=> identical dynamics)
	sleaf: { number }, -- a leaf index carrying the content (for its bytes)
	sdep: { number }, -- leaf depth
	sb: { number }, -- targets b, N per segment
	seb: { number }, -- backward entering residuals, N per segment
	h: { number },
	ef: { number },
	stN: { number },
	stX: { number },
	stY: { number },
	stS: { number },
	stD: { number },
	stV: { number }, -- 1 if the stack entry is a virtual node (endless mode)
	zinf: { number },
	tau: { number },
	Qf: { number },
	Qb: { number },
	fOff: { number },
	fQ: { number },
	fDrop: { number },
	bOff: { number },
	bQ: { number },
	bDrop: { number },
	wf: { number },
	wb: { number },
	z: { number },
	pend: { number },
	acc: { number },
	sigv: { number }, -- per-segment signature values of the last segmented row (dedup)
	stats: Stats,
}

export type Stats = {
	rows: number, -- output rows produced
	rendered: number, -- row renders (band rows actually evaluated)
	copied: number, -- output rows produced by buffer.copy of an identical row
	deduped: number, -- band rows reused from an identical earlier band (cross-band dedup)
	multiBand: number, -- output rows needing the vertical box merge
	segments: number, -- segments rendered (events)
	evals: number, -- per-pixel closed-form evaluations (transients)
	pieces: number, -- partial footprint pieces
	fills: number, -- fill spans
	fillPixels: number, -- pixels written by fills
	searchProbes: number, -- bound evaluations made by the n0 search
	seam: number, -- endless mode: largest X3 certificate of the rendered block rows
	terms: number, -- transient pixels: terms looked at after trailing T4 trims (fast path)
}

local function newStats(): Stats
	return {
		rows = 0,
		rendered = 0,
		copied = 0,
		deduped = 0,
		multiBand = 0,
		segments = 0,
		evals = 0,
		pieces = 0,
		fills = 0,
		fillPixels = 0,
		searchProbes = 0,
		seam = 0,
		terms = 0,
	}
end
Liquid.newStats = newStats

local function getScratch(plan: Plan, minCap: number): Scratch
	local sc: Scratch? = plan.scratch
	if sc and sc.cap >= minCap then
		return sc
	end
	local cap = math.max(minCap, plan.maxSeg)
	local N, K = plan.N, plan.K
	local M = math.max(plan.M, 4)
	local depthCap = 4 * (plan.P + 40)
	local new: any = {
		slot = table.create(cap, 0),
		tmpB = table.create(N, 0),
		rowB = table.create(cap * math.max(plan.nt, 1), 0),
		rowPF = table.create(cap * math.max(plan.NG, 1) * 4, 0),
		rowPB = table.create(cap * math.max(plan.NG, 1) * 4, 0),
		hP = table.create(math.max(plan.NG, 1) * 4, 0),
		efP = table.create(math.max(plan.NG, 1) * 4, 0),
		sebP = table.create(cap * math.max(plan.NG, 1) * 4, 0),
		rowZ = table.create(cap * 4, 0),
		rowMg = table.create(cap * 4, 0),
		rowCol = table.create(cap, 0),
		cacheTree = nil,
		cacheOn = false,
		fW = table.create(K, 0),
		fThr = table.create(K, 0),
		bW = table.create(K, 0),
		bThr = table.create(K, 0),
		aOff = table.create(K, 0),
		aQ = table.create(K * 4, 0),
		aThr = table.create(K, 0),
		oOff = table.create(K, 0),
		oQ = table.create(K * 4, 0),
		certF = table.create(math.max(plan.nt, 1), 1),
		certB = table.create(math.max(plan.nt, 1), 1),
		rangeTree = nil,
		ranges = nil,
	}
	local base: Scratch = {
		cap = cap,
		sx = table.create(cap, 0),
		sl = table.create(cap, 0),
		skey = table.create(cap, 0),
		sleaf = table.create(cap, 0),
		sdep = table.create(cap, 0),
		sb = table.create(cap * N, 0),
		seb = table.create(cap * N, 0),
		h = table.create(N, 0),
		ef = table.create(N, 0),
		stN = table.create(depthCap, 0),
		stX = table.create(depthCap, 0),
		stY = table.create(depthCap, 0),
		stS = table.create(depthCap, 0),
		stD = table.create(depthCap, 0),
		stV = table.create(depthCap, 0),
		zinf = table.create(M, 0),
		tau = table.create(M, 0),
		Qf = table.create(K * M, 0),
		Qb = table.create(K * M, 0),
		fOff = table.create(K, 0),
		fQ = table.create(K * M, 0),
		fDrop = table.create(K, 0),
		bOff = table.create(K, 0),
		bQ = table.create(K * M, 0),
		bDrop = table.create(K, 0),
		wf = table.create(K, 0),
		wb = table.create(K, 0),
		z = table.create(M, 0),
		pend = table.create(M, 0),
		acc = {},
		sigv = table.create(cap, 0),
		stats = newStats(),
	}
	for k, v in base :: any do
		new[k] = v
	end
	plan.scratch = new
	return new
end

----------------------------------------------------------------------------------------
-- Row segmentation of the stored tree. Fills the scratch segment arrays with the leaves
-- crossed by row y inside [xa, xb), left to right, merging neighbours with identical
-- content and depth (identical dynamics). Returns the count and the band end: the smallest
-- bottom edge among the crossed leaves, so rows y .. bandEnd - 1 cross the same leaves.
----------------------------------------------------------------------------------------

-- Coordinates are rendered pixels (stored geometry times 2^R).
local function segmentStored(plan: Plan, tree: Tree, sc: Scratch, y: number, xa: number, xb: number, count: number): (number, number)
	local nodes = tree.nodes
	local leafKey, leafDepth = tree.leafKey, tree.leafDepth
	local W, H, T = plan.Wr, plan.Hr, plan.T
	local stN, stX, stY, stS, stD = sc.stN, sc.stX, sc.stY, sc.stS, sc.stD
	local sx, sl, skey, sleaf, sdep = sc.sx, sc.sl, sc.skey, sc.sleaf, sc.sdep
	local bandEnd = math.huge
	if y < 0 or y >= H then
		return count, bandEnd
	end
	if xb > W then
		xb = W
	end
	local sp = 1
	stN[1], stX[1], stY[1], stS[1], stD[1] = 0, 0, 0, plan.Sr, 0
	while sp > 0 do
		local n, x0, y0, side, dep = stN[sp], stX[sp], stY[sp], stS[sp], stD[sp]
		sp -= 1
		if x0 >= xb or x0 + side <= xa then
			continue
		end
		local v = buffer.readu32(nodes, n * 4)
		if v % 2 == 1 then
			local leaf = (v - 1) // 2
			local yEnd = y0 + side
			if yEnd < bandEnd then
				bandEnd = yEnd
			end
			local s0 = if x0 > xa then x0 else xa
			local e0 = x0 + side
			if e0 > xb then
				e0 = xb
			end
			local key = buffer.readu32(leafKey, leaf * 4)
			local ld = buffer.readu8(leafDepth, leaf)
			if count > 0 and skey[count] == key and sdep[count] == ld and e0 - sx[count] <= T then
				sl[count] = e0 - sx[count]
			else
				count += 1
				sx[count] = s0
				sl[count] = e0 - s0
				skey[count] = key
				sleaf[count] = leaf
				sdep[count] = ld
			end
		else
			local h = side // 2
			local c = n + 1
			local d1 = dep + 1
			local yy = y0
			if y >= y0 + h then
				c += sizeOf(nodes, c)
				c += sizeOf(nodes, c)
				yy = y0 + h
			end
			-- push the right child first so the left one is processed first
			sp += 1
			stN[sp], stX[sp], stY[sp], stS[sp], stD[sp] = c + sizeOf(nodes, c), x0 + h, yy, h, d1
			sp += 1
			stN[sp], stX[sp], stY[sp], stS[sp], stD[sp] = c, x0, yy, h, d1
		end
	end
	if bandEnd > H then
		bandEnd = H
	end
	return count, bandEnd
end

-- Targets b (N values) of leaf `leaf` into dst[at + 1 .. at + N], in the header's order.
local function leafTargets(plan: Plan, tree: Tree, leaf: number, dst: { number }, at: number)
	local model = plan.model
	local N, I = plan.N, plan.I
	local beta, B, U = model.beta, model.B, plan.U
	local lb = tree.leafBytes
	local o = leaf * I
	for i = 1, N do
		local b = beta[i]
		local bi = (i - 1) * I
		for t = 0, I - 1 do
			b = b + B[bi + t + 1] * U[buffer.readu8(lb, o + t) + 1]
		end
		dst[at + i] = b
	end
end

----------------------------------------------------------------------------------------
-- X3 endless textures. The plane is tiled by blocks of the rendered root side Sr; block
-- (0, 0) holds the stored tree. Every other block, and every stored node with no pixel
-- inside the image, is a virtual quadtree: a node of depth t at stored-pixel origin
-- (xs, ys) splits iff t < maxDepth and hash2(xs, ys, seedT) mod nodesAt[t] < splitsAt[t]
-- (the stored tree's split ratio at that depth), and a virtual leaf takes the content of
-- the stored leaf leavesAt[t][hash2(xs, ys, seedL) mod #leavesAt[t]] (any inside leaf when
-- the stored tree has none at that depth). Only stored contents ever appear, so the
-- trained readout sees inputs from its own distribution. Integers and bit32 only: every
-- client generates the same leaves.
----------------------------------------------------------------------------------------

local function virtualStats(tree: Tree): VirtualStats
	local v = tree.virt
	if v then
		return v
	end
	local D = tree.maxDepth
	local nodesAt, splitsAt = table.create(D + 1, 0), table.create(D + 1, 0)
	local leavesAt: { { number } } = {}
	for t = 1, D + 1 do
		leavesAt[t] = {}
	end
	local all: { number } = {}
	local nodes, W, H = tree.nodes, tree.width, tree.height
	local function walk(n: number, depth: number, x0: number, y0: number, side: number): number
		local val = buffer.readu32(nodes, n * 4)
		local inside = x0 < W and y0 < H
		if val % 2 == 1 then
			if inside then
				nodesAt[depth + 1] += 1
				table.insert(leavesAt[depth + 1], (val - 1) // 2)
				table.insert(all, (val - 1) // 2)
			end
			return 1
		end
		if inside then
			nodesAt[depth + 1] += 1
			splitsAt[depth + 1] += 1
		end
		local h = side // 2
		local c = n + 1
		c += walk(c, depth + 1, x0, y0, h)
		c += walk(c, depth + 1, x0 + h, y0, h)
		c += walk(c, depth + 1, x0, y0 + h, h)
		c += walk(c, depth + 1, x0 + h, y0 + h, h)
		return c - n
	end
	walk(0, 0, 0, 0, tree.S)
	local stats: VirtualStats = { nodesAt = nodesAt, splitsAt = splitsAt, leavesAt = leavesAt, all = all }
	tree.virt = stats
	return stats
end

export type Endless = {
	seed: number, -- any integer; selects the virtual canvas
	horizon: number?, -- largest warm-up, in blocks on each side of a block (default 2)
	tolerance: number?, -- certificate the warm-up must reach, output units (default 2^-24)
}

-- Leaf of the virtual canvas containing stored pixel (xs, ys): (stored leaf index whose
-- content it carries, depth). Independent of the row traversal; the endless reference uses it.
function Liquid.virtualLeafAt(tree: Tree, xs: number, ys: number, seed: number): (number, number)
	local V = virtualStats(tree)
	local S, D = tree.S, tree.maxDepth
	local W, H = tree.width, tree.height
	local bx, by = xs // S, ys // S
	local x0, y0, side, depth = bx * S, by * S, S, 0
	local n = if bx == 0 and by == 0 then 0 else -1
	local seedL = hash2(0, 0x1EAF, seed)
	while true do
		if n >= 0 and not (x0 < W and y0 < H) then
			n = -1 -- stored node outside the image: virtual from here on
		end
		if n >= 0 then
			local val = buffer.readu32(tree.nodes, n * 4)
			if val % 2 == 1 then
				return (val - 1) // 2, depth
			end
		else
			local cnt = V.nodesAt[depth + 1]
			local split = depth < D and cnt > 0 and hash2(x0, y0, hash2(depth, 0x5B1, seed)) % cnt < V.splitsAt[depth + 1]
			if not split then
				local list = V.leavesAt[depth + 1]
				if #list == 0 then
					list = V.all
				end
				return list[hash2(x0, y0, seedL) % #list + 1], depth
			end
		end
		local h = side // 2
		local right = xs >= x0 + h
		local bottom = ys >= y0 + h
		if n >= 0 then
			local c = n + 1
			if bottom then
				c += sizeOf(tree.nodes, c)
				c += sizeOf(tree.nodes, c)
			end
			if right then
				c += sizeOf(tree.nodes, c)
			end
			n = c
		end
		if right then
			x0 += h
		end
		if bottom then
			y0 += h
		end
		side = h
		depth += 1
	end
end

-- Endless counterpart of segmentStored: segments of rendered row y over [xa, xb) on the
-- virtual canvas (any integers), merged like the stored ones.
local function segmentEndless(plan: Plan, tree: Tree, sc: Scratch, y: number, xa: number, xb: number, seed: number): (number, number)
	local V = virtualStats(tree)
	local nodes = tree.nodes
	local leafKey = tree.leafKey
	local sf = pow2(plan.R)
	local Sr, T, D = plan.Sr, plan.T, tree.maxDepth
	local Wr, Hr = plan.Wr, plan.Hr
	local nodesAt, splitsAt, leavesAt, all = V.nodesAt, V.splitsAt, V.leavesAt, V.all
	local stN, stX, stY, stS, stD = sc.stN, sc.stX, sc.stY, sc.stS, sc.stD
	local sx, sl, skey, sleaf, sdep = sc.sx, sc.sl, sc.skey, sc.sleaf, sc.sdep
	local seedL = hash2(0, 0x1EAF, seed)
	local count = 0
	local bandEnd = math.huge
	local by = y // Sr
	for bx = xa // Sr, (xb - 1) // Sr do
		local sp = 1
		stN[1], stX[1], stY[1], stS[1], stD[1] = if bx == 0 and by == 0 then 0 else -1, bx * Sr, by * Sr, Sr, 0
		while sp > 0 do
			local n, x0, y0, side, dep = stN[sp], stX[sp], stY[sp], stS[sp], stD[sp]
			sp -= 1
			if x0 >= xb or x0 + side <= xa then
				continue
			end
			if n >= 0 and not (x0 < Wr and y0 < Hr) then
				n = -1
			end
			local leaf = -1
			if n >= 0 then
				local val = buffer.readu32(nodes, n * 4)
				if val % 2 == 1 then
					leaf = (val - 1) // 2
				end
			else
				local xs, ys = x0 // sf, y0 // sf
				local cnt = nodesAt[dep + 1]
				local split = dep < D and cnt > 0 and hash2(xs, ys, hash2(dep, 0x5B1, seed)) % cnt < splitsAt[dep + 1]
				if not split then
					local list = leavesAt[dep + 1]
					if #list == 0 then
						list = all
					end
					leaf = list[hash2(xs, ys, seedL) % #list + 1]
				end
			end
			if leaf >= 0 then
				local yEnd = y0 + side
				if yEnd < bandEnd then
					bandEnd = yEnd
				end
				local s0 = if x0 > xa then x0 else xa
				local e0 = x0 + side
				if e0 > xb then
					e0 = xb
				end
				local key = buffer.readu32(leafKey, leaf * 4)
				if count > 0 and skey[count] == key and sdep[count] == dep and e0 - sx[count] <= T then
					sl[count] = e0 - sx[count]
				else
					count += 1
					sx[count] = s0
					sl[count] = e0 - s0
					skey[count] = key
					sleaf[count] = leaf
					sdep[count] = dep
				end
			else
				local h = side // 2
				local yy = y0
				local c0, c1 = -1, -1
				if n >= 0 then
					local c = n + 1
					if y >= y0 + h then
						c += sizeOf(nodes, c)
						c += sizeOf(nodes, c)
					end
					c0, c1 = c, c + sizeOf(nodes, c)
				end
				if y >= y0 + h then
					yy = y0 + h
				end
				sp += 1
				stN[sp], stX[sp], stY[sp], stS[sp], stD[sp] = c1, x0 + h, yy, h, dep + 1
				sp += 1
				stN[sp], stX[sp], stY[sp], stS[sp], stD[sp] = c0, x0, yy, h, dep + 1
			end
		end
	end
	return count, bandEnd
end

-- Seam bound of the endless mode (output units, per channel): two block windows that
-- overlap at a pixel disagree there by at most this much, so neighbouring pixels of two
-- blocks differ from a seamless canvas by at most this. Proof in docs/LIQUID.md (X3).
function Liquid.seamBound(plan: Plan, tree: Tree, horizon: number): number
	local model = plan.model
	local N, M = plan.N, plan.M
	local tmp = table.create(N, 0)
	local lo, hi = table.create(N, math.huge), table.create(N, -math.huge)
	for key = 0, tree.keyCount - 1 do
		leafTargets(plan, tree, buffer.readu32(tree.keyLeaf, key * 4), tmp, 0)
		for i = 1, N do
			if tmp[i] < lo[i] then
				lo[i] = tmp[i]
			end
			if tmp[i] > hi[i] then
				hi[i] = tmp[i]
			end
		end
	end
	local worst = 0
	local dist = horizon * plan.Sr
	for m = 0, M - 1 do
		local sum = 0
		for i = 1, N do
			local kmax = 0
			for t = 0, plan.P do
				local k = plan.kOf[t * N + i]
				if k > kmax then
					kmax = k
				end
			end
			local a = 1 - plan.gk[kmax + 1]
			-- a^dist by squaring (an upper estimate is fine here: rounding is 1e-13 relative)
			local p, base, e = 1, a, dist
			while e > 0 do
				if e % 2 == 1 then
					p *= base
				end
				base *= base
				e //= 2
			end
			sum += (math.abs(model.Cf[m * N + i]) + math.abs(model.Cb[m * N + i])) * (hi[i] - lo[i]) * p
		end
		if sum > worst then
			worst = sum
		end
	end
	return worst * (1 + 1e-9)
end

-- Range (max - min) of each tracked neuron's target over the stored contents: every state
-- of either pass lies in that range, so it bounds any state difference (X3 certificates).
local function trackedRanges(plan: Plan, tree: Tree, sc: any): { number }
	if sc.rangeTree == tree then
		return sc.ranges
	end
	local N, nt, trk = plan.N, plan.nt, plan.trk
	local tmp = table.create(N, 0)
	local lo, hi = table.create(nt, math.huge), table.create(nt, -math.huge)
	for key = 0, tree.keyCount - 1 do
		leafTargets(plan, tree, buffer.readu32(tree.keyLeaf, key * 4), tmp, 0)
		for j = 1, nt do
			local b = tmp[trk[j]]
			if b < lo[j] then
				lo[j] = b
			end
			if b > hi[j] then
				hi[j] = b
			end
		end
	end
	local r = table.create(nt, 0)
	for j = 1, nt do
		r[j] = if hi[j] >= lo[j] then hi[j] - lo[j] else 0
	end
	sc.rangeTree = tree
	sc.ranges = r
	return r
end

-- A-posteriori X3 certificate for the segments 1..n in the scratch, which cover a window
-- [wa, wb) whose passes start at rest: every output of a pixel in [xl, xr) differs from the
-- infinite-row model (any history beyond the window) by at most the returned value, per
-- channel. It is the actual contraction of each neuron from wa to xl and from wb to xr,
-- times its state range and readout weights (proof in docs/LIQUID.md, X3).
local function windowCert(plan: Plan, tree: Tree, sc: any, n: number, xl: number, xr: number): number
	local nt = plan.nt
	if nt == 0 then
		return 0
	end
	local E = trackedRanges(plan, tree, sc)
	local pw, trkOff = plan.pw, plan.trkOff
	local sx, sl, sdep = sc.sx, sc.sl, sc.sdep
	local cf, cb = sc.certF, sc.certB
	for j = 1, nt do
		cf[j], cb[j] = 1, 1
	end
	for s = 1, n do
		local x0 = sx[s]
		local x1 = x0 + sl[s]
		local to = sdep[s] * nt
		local f1 = if x1 < xl then x1 else xl
		if f1 > x0 then
			for j = 1, nt do
				cf[j] *= pw[trkOff[to + j] + f1 - x0]
			end
		end
		local b0 = if x0 > xr then x0 else xr
		if x1 > b0 then
			for j = 1, nt do
				cb[j] *= pw[trkOff[to + j] + x1 - b0]
			end
		end
	end
	local CfT4, CbT4 = plan.CfT4, plan.CbT4
	local worst = 0
	for m = 1, math.min(plan.M, 4) do
		local sum = 0
		for j = 1, nt do
			local co = (j - 1) * 4 + m
			sum += (math.abs(CfT4[co]) * cf[j] + math.abs(CbT4[co]) * cb[j]) * E[j]
		end
		if sum > worst then
			worst = sum
		end
	end
	return worst * (1 + 1e-9) -- covers the rounding of the products (relative 1e-13)
end

-- Certificate of the window [wa, wb) of rendered row y on the endless canvas for pixels in
-- [xl, xr) (see windowCert). Exposed for tests and tools.
function Liquid.windowCertificate(plan: Plan, tree: Tree, y: number, wa: number, wb: number, xl: number, xr: number, seed: number): number
	local sc: any = getScratch(plan, wb - wa + 2)
	local n = segmentEndless(plan, tree, sc, y, wa, wb, seed)
	return windowCert(plan, tree, sc, n, xl, xr)
end

-- Public helper for tests: segments of row y as { {x, len, leaf, depth}, ... } plus band end.
function Liquid.rowSegments(plan: Plan, tree: Tree, y: number): ({ { number } }, number)
	local sc = getScratch(plan, plan.Wr + 2)
	local n, bandEnd = segmentStored(plan, tree, sc, y, 0, plan.Wr, 0)
	local out = {}
	for s = 1, n do
		out[s] = { sc.sx[s], sc.sl[s], sc.sleaf[s], sc.sdep[s] }
	end
	return out, bandEnd
end

----------------------------------------------------------------------------------------
-- Reference renderer: the model stepped pixel by pixel, literally as in the header.
----------------------------------------------------------------------------------------

-- Real-valued outputs of rendered row y over the window [xa, xb), both passes at rest at
-- the window ends: zOut[((x - xa) * M + m) + 1], m in [0, M). leafFn(x, y) -> (leaf,
-- depth) gives the leaf of each rendered pixel.
function Liquid.referenceSpan(plan: Plan, tree: Tree, y: number, xa: number, xb: number, zOut: { number }, leafFn: (number, number) -> (number, number))
	local model = plan.model
	local N, M = plan.N, plan.M
	local W = xb - xa
	local Cf, Cb, d = model.Cf, model.Cb, model.d
	local kOf, gk = plan.kOf, plan.gk
	local lookup = function(x: number, yy: number): (number, number)
		return leafFn(x + xa, yy)
	end
	-- per-pixel b and g
	local bs = table.create(W * N, 0)
	local gs = table.create(W * N, 0)
	local lastLeaf, lastDepth = -2, -2
	local tmp = table.create(N, 0)
	for x = 0, W - 1 do
		local leaf, depth = lookup(x, y)
		if leaf ~= lastLeaf or depth ~= lastDepth then
			leafTargets(plan, tree, leaf, tmp, 0)
			lastLeaf, lastDepth = leaf, depth
		end
		for i = 1, N do
			bs[x * N + i] = tmp[i]
			gs[x * N + i] = gk[kOf[depth * N + i] + 1]
		end
	end
	-- backward pass, at rest at its first pixel (x = W - 1)
	local hb = table.create(W * N, 0)
	local h = table.create(N, 0)
	for i = 1, N do
		h[i] = bs[(W - 1) * N + i]
	end
	for x = W - 1, 0, -1 do
		local o = x * N
		for i = 1, N do
			local hi = h[i]
			hi = hi + (bs[o + i] - hi) * gs[o + i]
			h[i] = hi
			hb[o + i] = hi
		end
	end
	-- forward pass and output
	for i = 1, N do
		h[i] = bs[i]
	end
	for x = 0, W - 1 do
		local o = x * N
		for i = 1, N do
			local hi = h[i]
			h[i] = hi + (bs[o + i] - hi) * gs[o + i]
		end
		for m = 0, M - 1 do
			local z = d[m + 1]
			local cm = m * N
			for i = 1, N do
				z = z + Cf[cm + i] * h[i]
			end
			for i = 1, N do
				z = z + Cb[cm + i] * hb[o + i]
			end
			zOut[x * M + m + 1] = z
		end
	end
end

-- Real-valued outputs of rendered row y: zOut[(x * M + m) + 1] for x in [0, Wr), m in
-- [0, M). leafFn(x, y) -> (leaf, depth) gives the leaf of each rendered pixel (default:
-- Liquid.leafAt on the stored pixel (x >> R, y >> R)).
function Liquid.referenceRow(plan: Plan, tree: Tree, y: number, zOut: { number }, leafFn: ((number, number) -> (number, number))?)
	local sf = pow2(plan.R)
	local lookup = leafFn or function(x: number, yy: number): (number, number)
		return Liquid.leafAt(tree, x // sf, yy // sf)
	end
	Liquid.referenceSpan(plan, tree, y, 0, plan.Wr, zOut, lookup)
end

-- Endless reference (X3): real values of the block column containing rendered pixel x,
-- stepped over that block's canonical window: zOut[((x - wa) * M + m) + 1] for x in the
-- window [wa, wb). Returns wa, wb.
function Liquid.referenceEndless(plan: Plan, tree: Tree, y: number, block: number, horizon: number, seed: number, zOut: { number }): (number, number)
	local Sr = plan.Sr
	local sf = pow2(plan.R)
	local wa, wb = (block - horizon) * Sr, (block + 1 + horizon) * Sr
	Liquid.referenceSpan(plan, tree, y, wa, wb, zOut, function(x: number, yy: number): (number, number)
		return Liquid.virtualLeafAt(tree, x // sf, yy // sf, seed)
	end)
	return wa, wb
end

local function quant(z: number): number
	local q = floor(z + 0.5)
	return if q < 0 then 0 elseif q > 255 then 255 else q
end
Liquid.quantize = quant

local function packZ(z: { number }, M: number, base: number): number
	-- channels base+1 .. base+4 of z (1-based) into RGBA8; missing alpha 255, others 0
	local n = M - base
	local r = if n >= 1 then quant(z[base + 1]) else 0
	local g = if n >= 2 then quant(z[base + 2]) else 0
	local b = if n >= 3 then quant(z[base + 3]) else 0
	local a = if n >= 4 then quant(z[base + 4]) else 255
	return r + g * 256 + b * 65536 + a * 16777216
end

----------------------------------------------------------------------------------------
-- Event renderer: one row.
--
-- Within a segment (constant b and a), with e = (state entering the segment) - b, the
-- state after n steps is b + e a^n (T1). Neurons of equal gain k at a depth form a class;
-- the readout collapses each class to one amplitude per channel, Qf[c][m] =
-- sum_{i in c} Cf[m][i] ef_i (Qb likewise), and k = 0 classes vanish after one step. For
-- an output pixel at level L (footprint F = 2^L rendered pixels, first forward step nf,
-- smallest backward step nb), the exact footprint average is (T5)
--     zinf_m + sum_c G[L][k_c] (Qf[c][m] a_c^nf + Qb[c][m] a_c^nb),
-- with zinf_m = d_m + sum_i (Cf + Cb)[m][i] b_i and G[L][k] = (1 - a^F) / (F g).
-- Fill rule (T2 with the quantisation margin): with tau_m = max(eps, margin(zinf_m) - ETA),
-- once sum_c |Qf'| a^nf <= tau_m / 2 (forward) and sum_c |Qb'| a^nb <= tau_m / 2
-- (backward), the pixel is the quantised zinf; it is within eps + 0.5 of the exact value,
-- and exactly the exact value's byte whenever tau_m exceeds eps. The fill region is found
-- by a galloping search capped by the logarithm-free T3 bound; transient pixels are
-- evaluated in closed form with the T4 decaying active set (dropped classes share eps).
----------------------------------------------------------------------------------------

-- Inserts class j (drop key `key`) keeping keys sorted descending (forward lists) or
-- ascending (backward lists); returns the new count.
local function insertSorted(off: { number }, q: { number }, drop: { number }, n: number, M: number, o: number, src: { number }, srcAt: number, key: number, descending: boolean): number
	local pos = n + 1
	while pos > 1 do
		local prev = drop[pos - 1]
		if (descending and prev >= key) or (not descending and prev <= key) then
			break
		end
		off[pos] = off[pos - 1]
		drop[pos] = prev
		local a, b = (pos - 1) * M, (pos - 2) * M
		for m = 1, M do
			q[a + m] = q[b + m]
		end
		pos -= 1
	end
	off[pos] = o
	drop[pos] = key
	local a = (pos - 1) * M
	for m = 1, M do
		q[a + m] = src[srcAt + m]
	end
	return n + 1
end

-- Renders output pixels X in [X0, X1) of one row at level L from the segments 1..nseg in
-- the scratch. mode 0 quantises and writes RGBA8 pixels at out[rowAt + (X - X0) * 4]
-- (channels 4..7 into out2 at the same offset); mode 1 adds wgt * z_m into
-- sc.acc[(X - X0) * M + m]. xEnd is the right edge (rendered pixels) used to clip the last
-- footprint.
local function eventRow(
	plan: Plan,
	tree: Tree,
	sc: Scratch,
	nseg: number,
	L: number,
	X0: number,
	X1: number,
	eps: number,
	mode: number,
	out: buffer,
	rowAt: number,
	out2: buffer?,
	wgt: number,
	xEnd: number
)
	local N, M, K = plan.N, plan.M, plan.K
	local model = plan.model
	local Cf, Cb, d = model.Cf, model.Cb, model.d
	local Csum, pw, S1, NT, G = plan.Csum, plan.pw, plan.S1, plan.NT, plan.G
	local pwOff, clsOf, clsK, nClsT = plan.pwOff, plan.clsOf, plan.clsK, plan.nCls
	local TP1, T = plan.TP1, plan.T
	local sx, sl, sleaf, sdep, sb, seb = sc.sx, sc.sl, sc.sleaf, sc.sdep, sc.sb, sc.seb
	local h, ef = sc.h, sc.ef
	local zinf, tau, Qf, Qb = sc.zinf, sc.tau, sc.Qf, sc.Qb
	local fOff, fQ, fDrop, bOff, bQ, bDrop = sc.fOff, sc.fQ, sc.fDrop, sc.bOff, sc.bQ, sc.bDrop
	local wfA, wbA = sc.wf, sc.wb
	local z, pend, acc = sc.z, sc.pend, sc.acc
	local stats = sc.stats
	local F = pow2(L)
	local GL = L * K
	local JW = JMAX + 1
	local hasEps = eps > 0
	local invEps = if hasEps then 1 / eps else 0

	-- emits one output pixel from z[1..M]
	local function emit(X: number)
		if mode == 0 then
			local at = rowAt + (X - X0) * 4
			buffer.writeu32(out, at, packZ(z, M, 0))
			if out2 and M > 4 then
				buffer.writeu32(out2, at, packZ(z, M, 4))
			end
		else
			local a = (X - X0) * M
			for m = 1, M do
				acc[a + m] += wgt * z[m]
			end
		end
	end

	-- 1. targets
	for s = 1, nseg do
		leafTargets(plan, tree, sleaf[s], sb, (s - 1) * N)
	end

	-- 2. backward sweep (closed-form jumps), at rest at the right end
	local last = (nseg - 1) * N
	for i = 1, N do
		h[i] = sb[last + i]
	end
	for s = nseg, 1, -1 do
		local base = (s - 1) * N
		local po = sdep[s] * N
		local len = sl[s]
		for i = 1, N do
			local b = sb[base + i]
			local e = h[i] - b
			seb[base + i] = e
			h[i] = b + e * pw[pwOff[po + i] + len]
		end
	end

	-- 3. forward sweep and output
	for i = 1, N do
		h[i] = sb[i]
	end
	local pendX, pendCnt = NONE, 0
	local xFirst, xLast = X0 * F, X1 * F
	for s = 1, nseg do
		local x0 = sx[s]
		if x0 >= xLast then
			break
		end
		local len = sl[s]
		local x1 = x0 + len
		local base = (s - 1) * N
		local dep = sdep[s]
		local po = dep * N
		for i = 1, N do
			ef[i] = h[i] - sb[base + i]
		end
		if x1 > xFirst then
			stats.segments += 1
			-- limit colour and class amplitudes
			for m = 0, M - 1 do
				local zz = d[m + 1]
				local cm = m * N
				for i = 1, N do
					zz = zz + Csum[cm + i] * sb[base + i]
				end
				zinf[m + 1] = zz
			end
			local nc = nClsT[dep + 1]
			local cK = dep * K
			for j = 1, nc * M do
				Qf[j] = 0
				Qb[j] = 0
			end
			for i = 1, N do
				local c = clsOf[po + i]
				if c > 0 then
					local e1, e2 = ef[i], seb[base + i]
					local qo = (c - 1) * M
					for m = 0, M - 1 do
						Qf[qo + m + 1] += Cf[m * N + i] * e1
						Qb[qo + m + 1] += Cb[m * N + i] * e2
					end
				end
			end

			local xe = if x1 < xEnd then x1 else xEnd
			local Xfirst = x0 // F
			local Xlast = (xe - 1) // F
			local Xfa = if x0 % F == 0 then Xfirst else Xfirst + 1
			local Xfb = if (Xlast + 1) * F <= xe then Xlast else Xlast - 1

			-- partial footprints: exact sums, accumulated across segments
			for pass = 1, 2 do
				local X: number, p0: number, p1: number = NONE, 0, 0
				if pass == 1 and Xfirst < Xfa then
					local e1 = (Xfirst + 1) * F
					X, p0, p1 = Xfirst, x0, if xe < e1 then xe else e1
				elseif pass == 2 and Xlast > Xfb and (Xlast ~= Xfirst or Xfirst >= Xfa) then
					local s2 = Xlast * F
					X, p0, p1 = Xlast, if x0 > s2 then x0 else s2, xe
				end
				if X >= X0 and X < X1 then
					stats.pieces += 1
					if pendX ~= X then
						if pendX ~= NONE then
							for m = 1, M do
								z[m] = pend[m] / pendCnt
							end
							emit(pendX)
						end
						pendX, pendCnt = X, 0
						for m = 1, M do
							pend[m] = 0
						end
					end
					local cnt = p1 - p0
					local nf1 = p0 - x0 + 1
					local nb1 = x1 - p1 + 1
					for m = 1, M do
						pend[m] += cnt * zinf[m]
					end
					for c = 1, nc do
						local off = clsK[cK + c] * TP1 + 1
						local sfac = S1[off + cnt]
						local pf = pw[off + nf1] * sfac
						local pb = pw[off + nb1] * sfac
						local qo = (c - 1) * M
						for m = 1, M do
							pend[m] += Qf[qo + m] * pf + Qb[qo + m] * pb
						end
					end
					pendCnt += cnt
					local full = (if (X + 1) * F < xEnd then (X + 1) * F else xEnd) - X * F
					if pendCnt == full then
						for m = 1, M do
							z[m] = pend[m] / pendCnt
						end
						emit(pendX)
						pendX = NONE
					end
				end
			end

			-- full footprints
			if Xfa <= Xfb and Xfb >= X0 and Xfa < X1 then
				local nf0 = Xfa * F - x0 + 1
				local nb0 = x1 - Xfa * F - F + 1
				-- thresholds (the quantisation margin only counts when the value is quantised
				-- right away, mode 0; accumulated values keep the plain eps bound)
				local noFill = false
				for m = 1, M do
					local t = if mode == 0 then margin(zinf[m]) - ETA else eps
					if t < eps then
						t = eps
					end
					if t <= 0 then
						noFill = true
						t = 1
					end
					tau[m] = 1 / t
				end
				-- scaled amplitudes and normalised weights
				local Wf, Wb = 0, 0
				local kmaxF, kmaxB = 0, 0
				for c = 1, nc do
					local k = clsK[cK + c]
					local gfac = G[GL + k + 1]
					local qo = (c - 1) * M
					local wf, wb = 0, 0
					for m = 1, M do
						local qf = Qf[qo + m] * gfac
						local qb = Qb[qo + m] * gfac
						Qf[qo + m] = qf
						Qb[qo + m] = qb
						local af = math.abs(qf) * tau[m]
						local ab = math.abs(qb) * tau[m]
						if af > wf then
							wf = af
						end
						if ab > wb then
							wb = ab
						end
					end
					wfA[c], wbA[c] = wf, wb
					if wf > 0 then
						Wf += wf
						kmaxF = k
					end
					if wb > 0 then
						Wb += wb
						kmaxB = k
					end
				end
				local hF = (if Wb == 0 then 1 else 0.5) * SHRINK
				local hB = (if Wf == 0 then 1 else 0.5) * SHRINK

				-- forward fill start: first X with sum_c wf_c a_c^nf(X) <= hF
				local X1f, X2b
				if noFill then
					X1f, X2b = Xfb + 1, Xfa - 1
				else
					if Wf == 0 then
						X1f = Xfa
					else
						local nHi = NT[kmaxF * JW + ceilLog2(Wf / hF) + 1]
						local hi = Xfb + 1
						if nHi <= T then
							local c = if nHi > nf0 then Xfa + (nHi - nf0 + F - 1) // F else Xfa
							if c < hi then
								hi = c
							end
						end
						local lo = Xfa - 1
						-- galloping: probe lo + 1, lo + 2, lo + 4, ...
						local step = 1
						while lo + step < hi do
							local X = lo + step
							local nfX = nf0 + (X - Xfa) * F
							local r = 0
							for c = 1, nc do
								r += wfA[c] * pw[clsK[cK + c] * TP1 + 1 + nfX]
							end
							stats.searchProbes += 1
							if r <= hF then
								hi = X
								break
							end
							lo = X
							step *= 2
						end
						while hi - lo > 1 do
							local X = (lo + hi) // 2
							local nfX = nf0 + (X - Xfa) * F
							local r = 0
							for c = 1, nc do
								r += wfA[c] * pw[clsK[cK + c] * TP1 + 1 + nfX]
							end
							stats.searchProbes += 1
							if r <= hF then
								hi = X
							else
								lo = X
							end
						end
						X1f = hi
					end
					-- backward fill end: last X with sum_c wb_c a_c^nb(X) <= hB
					if Wb == 0 then
						X2b = Xfb
					else
						local nHi = NT[kmaxB * JW + ceilLog2(Wb / hB) + 1]
						local lo = Xfa - 1
						if nHi <= T then
							if nHi <= nb0 then
								local c = Xfa + (nb0 - nHi) // F
								if c > lo then
									lo = c
								end
							end
						end
						if lo > Xfb then
							lo = Xfb
						end
						local hi = Xfb + 1
						local step = 1
						while hi - step > lo do
							local X = hi - step
							local nbX = nb0 - (X - Xfa) * F
							local r = 0
							for c = 1, nc do
								r += wbA[c] * pw[clsK[cK + c] * TP1 + 1 + nbX]
							end
							stats.searchProbes += 1
							if r <= hB then
								lo = X
								break
							end
							hi = X
							step *= 2
						end
						while hi - lo > 1 do
							local X = (lo + hi) // 2
							local nbX = nb0 - (X - Xfa) * F
							local r = 0
							for c = 1, nc do
								r += wbA[c] * pw[clsK[cK + c] * TP1 + 1 + nbX]
							end
							stats.searchProbes += 1
							if r <= hB then
								lo = X
							else
								hi = X
							end
						end
						X2b = lo
					end
				end

				-- fill
				local tEnd1, tStart2
				if X1f <= X2b then
					local fa = if X1f > X0 then X1f else X0
					local fb = if X2b < X1 - 1 then X2b else X1 - 1
					if fa <= fb then
						stats.fills += 1
						stats.fillPixels += fb - fa + 1
						if mode == 0 then
							for m = 1, M do
								z[m] = zinf[m]
							end
							local col = packZ(z, M, 0)
							fillSpan(out, rowAt + (fa - X0) * 4, fb - fa + 1, col)
							if out2 and M > 4 then
								fillSpan(out2, rowAt + (fa - X0) * 4, fb - fa + 1, packZ(z, M, 4))
							end
						else
							for X = fa, fb do
								local a = (X - X0) * M
								for m = 1, M do
									acc[a + m] += wgt * zinf[m]
								end
							end
						end
					end
					tEnd1, tStart2 = X1f - 1, X2b + 1
				else
					tEnd1, tStart2 = Xfb, Xfb + 1
				end

				-- transients: closed-form evaluation with the decaying active set (T4)
				local ta = if Xfa > X0 then Xfa else X0
				local tb = if Xfb < X1 - 1 then Xfb else X1 - 1
				if ta <= tb and (ta <= tEnd1 or tb >= tStart2) then
					local nF, nB = 0, 0
					local cntF0, cntB0 = 0, 0
					for c = 1, nc do
						if wfA[c] > 0 then
							cntF0 += 1
						end
						if wbA[c] > 0 then
							cntB0 += 1
						end
					end
					local shF = (if cntB0 == 0 then 1 else 0.5) * SHRINK / math.max(cntF0, 1)
					local shB = (if cntF0 == 0 then 1 else 0.5) * SHRINK / math.max(cntB0, 1)
					for c = 1, nc do
						local k = clsK[cK + c]
						local off = k * TP1 + 1
						local qo = (c - 1) * M
						if wfA[c] > 0 then
							local key = math.huge
							if hasEps then
								local om = 0
								for m = 1, M do
									local v = math.abs(Qf[qo + m])
									if v > om then
										om = v
									end
								end
								local nStar = NT[k * JW + ceilLog2(om * invEps / shF) + 1]
								if nStar <= T then
									key = if nStar > nf0 then Xfa + (nStar - nf0 + F - 1) // F else Xfa
								end
							end
							nF = insertSorted(fOff, fQ, fDrop, nF, M, off, Qf, qo, key, true)
						end
						if wbA[c] > 0 then
							local key = -math.huge
							if hasEps then
								local om = 0
								for m = 1, M do
									local v = math.abs(Qb[qo + m])
									if v > om then
										om = v
									end
								end
								local nStar = NT[k * JW + ceilLog2(om * invEps / shB) + 1]
								if nStar <= T then
									-- negligible while nb(X) >= nStar, i.e. X <= Xfa + (nb0 - nStar) // F
									key = if nStar <= nb0 then Xfa + (nb0 - nStar) // F else Xfa - 1
								end
							end
							nB = insertSorted(bOff, bQ, bDrop, nB, M, off, Qb, qo, key, false)
						end
					end
					local cntF, cntB = nF, 0
					local X = ta
					while X <= tb do
						if X > tEnd1 and X < tStart2 then
							X = tStart2
							if X > tb then
								break
							end
						end
						while cntF > 0 and fDrop[cntF] <= X do
							cntF -= 1
						end
						while cntB < nB and bDrop[cntB + 1] < X do
							cntB += 1
						end
						local nfX = nf0 + (X - Xfa) * F
						local nbX = nb0 - (X - Xfa) * F
						for m = 1, M do
							z[m] = zinf[m]
						end
						for j = 1, cntF do
							local p = pw[fOff[j] + nfX]
							local qo = (j - 1) * M
							for m = 1, M do
								z[m] += fQ[qo + m] * p
							end
						end
						for j = 1, cntB do
							local p = pw[bOff[j] + nbX]
							local qo = (j - 1) * M
							for m = 1, M do
								z[m] += bQ[qo + m] * p
							end
						end
						stats.evals += 1
						emit(X)
						X += 1
					end
				end
			end
		end
		for i = 1, N do
			h[i] = sb[base + i] + ef[i] * pw[pwOff[po + i] + len]
		end
	end
	if pendX ~= NONE then
		for m = 1, M do
			z[m] = pend[m] / pendCnt
		end
		emit(pendX)
	end
end

----------------------------------------------------------------------------------------
-- Fast path for M <= 4 (channels padded to four locals). Same mathematics and bounds as
-- eventRow above; differences: always-instant neurons are not tracked (their state is b
-- exactly), per-content constants come from a cache, and the hot loops are inlined.
----------------------------------------------------------------------------------------

local CACHE_MAX_KEYS = 32768
local SHORT_LEN = 4 -- segments up to this length (level 0) skip the class machinery
local RATIO_TOL = 1e-6 -- X2: relative agreement of two consecutive Aitken ratios

-- Per-(plan, tree) cache of what depends only on a leaf's content: tracked targets b,
-- limit colour zinf (4 channels), quantisation margins and the packed fill colour.
local function ensureCache(plan: Plan, tree: Tree, sc: any): boolean
	if sc.cacheTree == tree then
		return sc.cacheOn
	end
	sc.cacheTree = tree
	local on = tree.keyCount <= CACHE_MAX_KEYS
	sc.cacheOn = on
	local nk = if on then tree.keyCount else 0
	sc.keyB = table.create(0, 0)
	sc.keyPF = table.create(nk * math.max(plan.NG, 1) * 4, 0)
	sc.keyPB = table.create(nk * math.max(plan.NG, 1) * 4, 0)
	sc.keyZ = table.create(nk * 4, 0)
	sc.keyMg = table.create(nk * 4, 0)
	sc.keyCol = table.create(nk, 0)
	sc.keyOk = table.create(nk, false)
	return on
end

local function fillSlot(plan: Plan, tree: Tree, sc: any, leaf: number, slot: number, PFt: { number }, PBt: { number }, Zt: { number }, MGt: { number }, COLt: { number })
	local tmp = sc.tmpB
	leafTargets(plan, tree, leaf, tmp, 0)
	local nt, trk, grpOf, NG = plan.nt, plan.trk, plan.grpOf, plan.NG
	local CfT4, CbT4 = plan.CfT4, plan.CbT4
	local base = slot * NG * 4
	for q = 1, NG * 4 do
		PFt[base + q] = 0
		PBt[base + q] = 0
	end
	for j = 1, nt do
		local b = tmp[trk[j]]
		local go = base + (grpOf[j] - 1) * 4
		local co = (j - 1) * 4
		for m = 1, 4 do
			PFt[go + m] += CfT4[co + m] * b
			PBt[go + m] += CbT4[co + m] * b
		end
	end
	local M, N = plan.M, plan.N
	local Csum, d = plan.Csum, plan.model.d
	local q = { 0, 0, 0, 255 }
	for m = 1, 4 do
		if m <= M then
			local z = d[m]
			local cm = (m - 1) * N
			for i = 1, N do
				z = z + Csum[cm + i] * tmp[i]
			end
			Zt[slot * 4 + m] = z
			MGt[slot * 4 + m] = margin(z)
			q[m] = quant(z)
		else
			Zt[slot * 4 + m] = 0
			MGt[slot * 4 + m] = math.huge
		end
	end
	COLt[slot + 1] = q[1] + q[2] * 256 + q[3] * 65536 + q[4] * 16777216
end

local function eventRow4(
	plan: Plan,
	tree: Tree,
	sc: any,
	nseg: number,
	L: number,
	X0: number,
	X1: number,
	eps: number,
	mode: number,
	out: buffer,
	rowAt: number,
	wgt: number,
	xEnd: number
)
	local M, K = plan.M, plan.K
	local pw, S1, NT, G = plan.pw, plan.S1, plan.NT, plan.G
	local NG = plan.NG -- groups of tracked neurons (shared gain at every depth)
	local GW = NG * 4 -- projected state width: 4 channels per group
	local grpOff, grpCls = plan.grpOff, plan.grpCls
	local clsK, nClsT = plan.clsK, plan.nCls
	local TP1, T = plan.TP1, plan.T
	local sx, sl, sleaf, sdep, skey = sc.sx, sc.sl, sc.sleaf, sc.sdep, sc.skey
	local slotOf, h, ef, seb = sc.slot, sc.hP, sc.efP, sc.sebP
	local Qf, Qb = sc.Qf, sc.Qb
	local fOff, fQ, fW, fThr = sc.fOff, sc.fQ, sc.fW, sc.fThr
	local bOff, bQ, bW, bThr = sc.bOff, sc.bQ, sc.bW, sc.bThr
	local aOff, aQ, aThr = sc.aOff, sc.aQ, sc.aThr
	local oOff, oQ = sc.oOff, sc.oQ
	local acc = sc.acc
	local stats = sc.stats
	local hasA = M >= 4
	local F = pow2(L)
	local GL = L * K
	local JW = JMAX + 1
	local nEval, nFill, nFillPx, nProbe, nSeg, nPiece = 0, 0, 0, 0, 0, 0

	-- 0. per-content constants
	local cacheOn = ensureCache(plan, tree, sc)
	local PFt, PBt, Zt, MGt, COLt
	if cacheOn then
		PFt, PBt, Zt, MGt, COLt = sc.keyPF, sc.keyPB, sc.keyZ, sc.keyMg, sc.keyCol
		local ok = sc.keyOk
		for s = 1, nseg do
			local key = skey[s]
			if not ok[key + 1] then
				fillSlot(plan, tree, sc, sleaf[s], key, PFt, PBt, Zt, MGt, COLt)
				ok[key + 1] = true
			end
			slotOf[s] = key
		end
	else
		PFt, PBt, Zt, MGt, COLt = sc.rowPF, sc.rowPB, sc.rowZ, sc.rowMg, sc.rowCol
		for s = 1, nseg do
			fillSlot(plan, tree, sc, sleaf[s], s - 1, PFt, PBt, Zt, MGt, COLt)
			slotOf[s] = s - 1
		end
	end

	-- 1. backward sweep over the projected group states (closed-form jumps), at rest at the
	-- right end: h = projected target PB, e = h - PB, h = PB + e a^len
	do
		local bo = slotOf[nseg] * GW
		for q = 1, GW do
			h[q] = PBt[bo + q]
		end
	end
	for s = nseg, 1, -1 do
		local bo = slotOf[s] * GW
		local go = sdep[s] * NG
		local len = sl[s]
		local eo = (s - 1) * GW
		for g = 1, NG do
			local p = pw[grpOff[go + g] + len]
			local q0 = (g - 1) * 4
			local b1, b2, b3, b4 = PBt[bo + q0 + 1], PBt[bo + q0 + 2], PBt[bo + q0 + 3], PBt[bo + q0 + 4]
			local e1, e2, e3, e4 = h[q0 + 1] - b1, h[q0 + 2] - b2, h[q0 + 3] - b3, h[q0 + 4] - b4
			seb[eo + q0 + 1], seb[eo + q0 + 2], seb[eo + q0 + 3], seb[eo + q0 + 4] = e1, e2, e3, e4
			h[q0 + 1], h[q0 + 2], h[q0 + 3], h[q0 + 4] = b1 + e1 * p, b2 + e2 * p, b3 + e3 * p, b4 + e4 * p
		end
	end

	-- writes or accumulates one output pixel (pieces only; hot loops inline this)
	local function put(X: number, z0: number, z1: number, z2: number, z3: number)
		if mode == 0 then
			local q0 = floor(z0 + 0.5)
			if q0 < 0 then
				q0 = 0
			elseif q0 > 255 then
				q0 = 255
			end
			local q1 = floor(z1 + 0.5)
			if q1 < 0 then
				q1 = 0
			elseif q1 > 255 then
				q1 = 255
			end
			local q2 = floor(z2 + 0.5)
			if q2 < 0 then
				q2 = 0
			elseif q2 > 255 then
				q2 = 255
			end
			local q3 = 255
			if hasA then
				q3 = floor(z3 + 0.5)
				if q3 < 0 then
					q3 = 0
				elseif q3 > 255 then
					q3 = 255
				end
			end
			buffer.writeu32(out, rowAt + (X - X0) * 4, q0 + q1 * 256 + q2 * 65536 + q3 * 16777216)
		else
			local a = (X - X0) * 4
			acc[a + 1] += wgt * z0
			acc[a + 2] += wgt * z1
			acc[a + 3] += wgt * z2
			acc[a + 4] += wgt * z3
		end
	end

	-- one fill span [fa, fb] of the limit colour (mode 0) or the limit value (mode 1)
	local function fillRun(fa: number, fb: number, col: number, zi0: number, zi1: number, zi2: number, zi3: number)
		local cnt = fb - fa + 1
		if mode == 0 then
			local at = rowAt + (fa - X0) * 4
			buffer.writeu32(out, at, col)
			if cnt < 8 then
				for q = 1, cnt - 1 do
					buffer.writeu32(out, at + q * 4, col)
				end
			else
				local bytes = cnt * 4
				local filled = 4
				while filled < bytes do
					local n = if filled < bytes - filled then filled else bytes - filled
					buffer.copy(out, at + filled, out, at, n)
					filled += n
				end
			end
		else
			for X = fa, fb do
				local a = (X - X0) * 4
				acc[a + 1] += wgt * zi0
				acc[a + 2] += wgt * zi1
				acc[a + 3] += wgt * zi2
				acc[a + 4] += wgt * zi3
			end
		end
	end

	-- Walks cnt output pixels from Xs in steps of dX. The lazy list (aOff, aQ, aThr; na
	-- terms, slowest first) holds the direction whose powers shrink along the walk; a term
	-- whose power is at or below its threshold is skipped (T4). The decision depends only on
	-- the pixel, never on where the walk started, and the summation order is fixed, so a
	-- region render equals the same crop of a full render bit for bit. Trailing skipped
	-- terms are trimmed for good (powers only shrink along the walk). The other list (oOff,
	-- oQ; no terms) is fixed. nl and nOther are the two step indices at Xs; nl grows by F
	-- per pixel and nOther shrinks by F.
	local nTerms = 0 -- terms looked at by the walks (T4 statistics)
	local function walk(Xs: number, cnt: number, dX: number, na: number, nl: number, no: number, nOther: number, zi0: number, zi1: number, zi2: number, zi3: number)
		local X = Xs
		for _ = 1, cnt do
			while na > 0 and pw[aOff[na] + nl] <= aThr[na] do
				na -= 1
			end
			nTerms += na + no
			local z0, z1, z2, z3 = zi0, zi1, zi2, zi3
			for j = 1, na do
				local p = pw[aOff[j] + nl]
				if p > aThr[j] then
					local a = (j - 1) * 4
					z0 += aQ[a + 1] * p
					z1 += aQ[a + 2] * p
					z2 += aQ[a + 3] * p
					z3 += aQ[a + 4] * p
				end
			end
			for j2 = 1, no do
				local p = pw[oOff[j2] + nOther]
				local a = (j2 - 1) * 4
				z0 += oQ[a + 1] * p
				z1 += oQ[a + 2] * p
				z2 += oQ[a + 3] * p
				z3 += oQ[a + 4] * p
			end
			if mode == 0 then
				local q0 = floor(z0 + 0.5)
				if q0 < 0 then
					q0 = 0
				elseif q0 > 255 then
					q0 = 255
				end
				local q1 = floor(z1 + 0.5)
				if q1 < 0 then
					q1 = 0
				elseif q1 > 255 then
					q1 = 255
				end
				local q2 = floor(z2 + 0.5)
				if q2 < 0 then
					q2 = 0
				elseif q2 > 255 then
					q2 = 255
				end
				local q3 = 255
				if hasA then
					q3 = floor(z3 + 0.5)
					if q3 < 0 then
						q3 = 0
					elseif q3 > 255 then
						q3 = 255
					end
				end
				buffer.writeu32(out, rowAt + (X - X0) * 4, q0 + q1 * 256 + q2 * 65536 + q3 * 16777216)
			else
				local a = (X - X0) * 4
				acc[a + 1] += wgt * z0
				acc[a + 2] += wgt * z1
				acc[a + 3] += wgt * z2
				acc[a + 4] += wgt * z3
			end
			X += dX
			nl += F
			nOther -= F
		end
	end

	-- 2. forward sweep and output
	do
		local bo = slotOf[1] * GW
		for q = 1, GW do
			h[q] = PFt[bo + q]
		end
	end
	local pendX, pendCnt = NONE, 0
	local p0s, p1s, p2s, p3s = 0, 0, 0, 0
	local xFirst, xLast = X0 * F, X1 * F
	for s = 1, nseg do
		local x0 = sx[s]
		if x0 >= xLast then
			break
		end
		local len = sl[s]
		local x1 = x0 + len
		local slot = slotOf[s]
		local bo = slot * GW
		local dep = sdep[s]
		local go = dep * NG
		local eo = (s - 1) * GW
		for q = 1, GW do
			ef[q] = h[q] - PFt[bo + q]
		end
		if x1 > xFirst then
			nSeg += 1
			local zo = slot * 4
			local zi0, zi1, zi2, zi3 = Zt[zo + 1], Zt[zo + 2], Zt[zo + 3], Zt[zo + 4]
			if F == 1 and nClsT[dep + 1] == 0 then
				-- every neuron is instant in this leaf: the segment is exactly its limit colour
				local fa = if x0 > X0 then x0 else X0
				local fb = if x1 < X1 then x1 - 1 else X1 - 1
				if fa <= fb then
					nFill += 1
					nFillPx += fb - fa + 1
					fillRun(fa, fb, COLt[slot + 1], zi0, zi1, zi2, zi3)
				end
			elseif F == 1 and len <= SHORT_LEN then
				-- short segment at level 0: every pixel straight from the tracked states
				local xa = if x0 > X0 then x0 else X0
				local xb = if x1 < X1 then x1 - 1 else X1 - 1
				for X = xa, xb do
					local nf = X - x0 + 1
					local nb = x1 - X
					local z0, z1, z2, z3 = zi0, zi1, zi2, zi3
					for g = 1, NG do
						if grpCls[go + g] > 0 then
							local off = grpOff[go + g]
							local pf = pw[off + nf]
							local pb = pw[off + nb]
							local q0 = (g - 1) * 4
							z0 += ef[q0 + 1] * pf + seb[eo + q0 + 1] * pb
							z1 += ef[q0 + 2] * pf + seb[eo + q0 + 2] * pb
							z2 += ef[q0 + 3] * pf + seb[eo + q0 + 3] * pb
							z3 += ef[q0 + 4] * pf + seb[eo + q0 + 4] * pb
						end
					end
					if mode == 0 then
						local q0 = floor(z0 + 0.5)
						if q0 < 0 then
							q0 = 0
						elseif q0 > 255 then
							q0 = 255
						end
						local q1 = floor(z1 + 0.5)
						if q1 < 0 then
							q1 = 0
						elseif q1 > 255 then
							q1 = 255
						end
						local q2 = floor(z2 + 0.5)
						if q2 < 0 then
							q2 = 0
						elseif q2 > 255 then
							q2 = 255
						end
						local q3 = 255
						if hasA then
							q3 = floor(z3 + 0.5)
							if q3 < 0 then
								q3 = 0
							elseif q3 > 255 then
								q3 = 255
							end
						end
						buffer.writeu32(out, rowAt + (X - X0) * 4, q0 + q1 * 256 + q2 * 65536 + q3 * 16777216)
					else
						local a = (X - X0) * 4
						acc[a + 1] += wgt * z0
						acc[a + 2] += wgt * z1
						acc[a + 3] += wgt * z2
						acc[a + 4] += wgt * z3
					end
				end
				if xb >= xa then
					nEval += xb - xa + 1
				end
			else
				-- class amplitudes
				local nc = nClsT[dep + 1]
				local cK = dep * K
				for q = 1, nc * 4 do
					Qf[q] = 0
					Qb[q] = 0
				end
				for g = 1, NG do
					local c = grpCls[go + g]
					if c > 0 then
						local qo = (c - 1) * 4
						local q0 = (g - 1) * 4
						Qf[qo + 1] += ef[q0 + 1]
						Qf[qo + 2] += ef[q0 + 2]
						Qf[qo + 3] += ef[q0 + 3]
						Qf[qo + 4] += ef[q0 + 4]
						Qb[qo + 1] += seb[eo + q0 + 1]
						Qb[qo + 2] += seb[eo + q0 + 2]
						Qb[qo + 3] += seb[eo + q0 + 3]
						Qb[qo + 4] += seb[eo + q0 + 4]
					end
				end

				local xe = if x1 < xEnd then x1 else xEnd
				local Xfirst = x0 // F
				local Xlast = (xe - 1) // F
				local Xfa = if x0 % F == 0 then Xfirst else Xfirst + 1
				local Xfb = if (Xlast + 1) * F <= xe then Xlast else Xlast - 1

				-- partial footprints (F > 1): exact sums, accumulated across segments
				if F > 1 then
					for pass = 1, 2 do
						local X: number, pa: number, pb: number = NONE, 0, 0
						if pass == 1 and Xfirst < Xfa then
							local e1 = (Xfirst + 1) * F
							X, pa, pb = Xfirst, x0, if xe < e1 then xe else e1
						elseif pass == 2 and Xlast > Xfb and (Xlast ~= Xfirst or Xfirst >= Xfa) then
							local s2 = Xlast * F
							X, pa, pb = Xlast, if x0 > s2 then x0 else s2, xe
						end
						if X >= X0 and X < X1 then
							nPiece += 1
							if pendX ~= X then
								if pendX ~= NONE then
									put(pendX, p0s / pendCnt, p1s / pendCnt, p2s / pendCnt, p3s / pendCnt)
								end
								pendX, pendCnt = X, 0
								p0s, p1s, p2s, p3s = 0, 0, 0, 0
							end
							local cnt = pb - pa
							local nf1 = pa - x0 + 1
							local nb1 = x1 - pb + 1
							p0s += cnt * zi0
							p1s += cnt * zi1
							p2s += cnt * zi2
							p3s += cnt * zi3
							for c = 1, nc do
								local off = clsK[cK + c] * TP1 + 1
								local sfac = S1[off + cnt]
								local pf = pw[off + nf1] * sfac
								local pbk = pw[off + nb1] * sfac
								local qo = (c - 1) * 4
								p0s += Qf[qo + 1] * pf + Qb[qo + 1] * pbk
								p1s += Qf[qo + 2] * pf + Qb[qo + 2] * pbk
								p2s += Qf[qo + 3] * pf + Qb[qo + 3] * pbk
								p3s += Qf[qo + 4] * pf + Qb[qo + 4] * pbk
							end
							pendCnt += cnt
							local fe = (X + 1) * F
							local full = (if fe < xEnd then fe else xEnd) - X * F
							if pendCnt == full then
								put(pendX, p0s / pendCnt, p1s / pendCnt, p2s / pendCnt, p3s / pendCnt)
								pendX = NONE
							end
						end
					end
				end

				-- full footprints
				if Xfa <= Xfb and Xfb >= X0 and Xfa < X1 then
					local nf0 = Xfa * F - x0 + 1
					local nb0 = x1 - Xfa * F - F + 1
					-- fill thresholds: quantisation margin (mode 0) or eps
					local t0, t1, t2, t3
					if mode == 0 then
						t0, t1, t2, t3 = MGt[zo + 1] - ETA, MGt[zo + 2] - ETA, MGt[zo + 3] - ETA, MGt[zo + 4] - ETA
						if t0 < eps then
							t0 = eps
						end
						if t1 < eps then
							t1 = eps
						end
						if t2 < eps then
							t2 = eps
						end
						if t3 < eps then
							t3 = eps
						end
					else
						t0, t1, t2, t3 = eps, eps, eps, eps
					end
					local noFill = t0 <= 0 or t1 <= 0 or t2 <= 0 or t3 <= 0
					if noFill then
						t0, t1, t2, t3 = 1, 1, 1, 1
					end
					local i0, i1, i2, i3 = 1 / t0, 1 / t1, 1 / t2, 1 / t3
					-- compact term lists: weight normalised by tau (fill), max |Q| (drops)
					local nF, nB = 0, 0
					local Wf, Wb = 0, 0
					local kmaxF, kmaxB = 0, 0
					for c = 1, nc do
						local k = clsK[cK + c]
						local off = k * TP1 + 1
						local qo = (c - 1) * 4
						local q0, q1, q2, q3 = Qf[qo + 1], Qf[qo + 2], Qf[qo + 3], Qf[qo + 4]
						local r0, r1, r2, r3 = Qb[qo + 1], Qb[qo + 2], Qb[qo + 3], Qb[qo + 4]
						if L > 0 then
							local gfac = G[GL + k + 1]
							q0, q1, q2, q3 = q0 * gfac, q1 * gfac, q2 * gfac, q3 * gfac
							r0, r1, r2, r3 = r0 * gfac, r1 * gfac, r2 * gfac, r3 * gfac
						end
						local a0 = if q0 < 0 then -q0 else q0
						local a1 = if q1 < 0 then -q1 else q1
						local a2 = if q2 < 0 then -q2 else q2
						local a3 = if q3 < 0 then -q3 else q3
						local w = a0 * i0
						local v = a1 * i1
						if v > w then
							w = v
						end
						v = a2 * i2
						if v > w then
							w = v
						end
						v = a3 * i3
						if v > w then
							w = v
						end
						if w > 0 then
							nF += 1
							fOff[nF] = off
							fW[nF] = w
							local om = if a0 > a1 then a0 else a1
							if a2 > om then
								om = a2
							end
							if a3 > om then
								om = a3
							end
							fThr[nF] = om
							local a = (nF - 1) * 4
							fQ[a + 1], fQ[a + 2], fQ[a + 3], fQ[a + 4] = q0, q1, q2, q3
							Wf += w
							kmaxF = k
						end
						a0 = if r0 < 0 then -r0 else r0
						a1 = if r1 < 0 then -r1 else r1
						a2 = if r2 < 0 then -r2 else r2
						a3 = if r3 < 0 then -r3 else r3
						w = a0 * i0
						v = a1 * i1
						if v > w then
							w = v
						end
						v = a2 * i2
						if v > w then
							w = v
						end
						v = a3 * i3
						if v > w then
							w = v
						end
						if w > 0 then
							nB += 1
							bOff[nB] = off
							bW[nB] = w
							local om = if a0 > a1 then a0 else a1
							if a2 > om then
								om = a2
							end
							if a3 > om then
								om = a3
							end
							bThr[nB] = om
							local a = (nB - 1) * 4
							bQ[a + 1], bQ[a + 2], bQ[a + 3], bQ[a + 4] = r0, r1, r2, r3
							Wb += w
							kmaxB = k
						end
					end
					local hF = (if nB == 0 then 1 else 0.5) * SHRINK
					local hB = (if nF == 0 then 1 else 0.5) * SHRINK

					local X1f, X2b
					if noFill then
						X1f, X2b = Xfb + 1, Xfa - 1
					else
						-- forward fill start: probe Xfa, else T3 cap, galloping, bisection
						local r = 0
						for j = 1, nF do
							r += fW[j] * pw[fOff[j] + nf0]
						end
						if nF > 0 then
							nProbe += 1
						end
						if r <= hF then
							X1f = Xfa
						else
							local hi = Xfb + 1
							local nHi = NT[kmaxF * JW + ceilLog2(Wf / hF) + 1]
							if nHi <= T then
								local c = if nHi > nf0 then Xfa + (nHi - nf0 + F - 1) // F else Xfa
								if c < hi then
									hi = c
								end
							end
							local lo = Xfa
							local step = 1
							while lo + step < hi do
								local X = lo + step
								local nfX = nf0 + (X - Xfa) * F
								r = 0
								for j = 1, nF do
									r += fW[j] * pw[fOff[j] + nfX]
								end
								nProbe += 1
								if r <= hF then
									hi = X
									break
								end
								lo = X
								step *= 2
							end
							while hi - lo > 1 do
								local X = (lo + hi) // 2
								local nfX = nf0 + (X - Xfa) * F
								r = 0
								for j = 1, nF do
									r += fW[j] * pw[fOff[j] + nfX]
								end
								nProbe += 1
								if r <= hF then
									hi = X
								else
									lo = X
								end
							end
							X1f = hi
						end
						-- backward fill end: probe Xfb, else T3 cap, galloping, bisection
						local nbE = nb0 - (Xfb - Xfa) * F
						r = 0
						for j = 1, nB do
							r += bW[j] * pw[bOff[j] + nbE]
						end
						if nB > 0 then
							nProbe += 1
						end
						if r <= hB then
							X2b = Xfb
						else
							local lo = Xfa - 1
							local nHi = NT[kmaxB * JW + ceilLog2(Wb / hB) + 1]
							if nHi <= T and nHi <= nb0 then
								local c = Xfa + (nb0 - nHi) // F
								if c > lo then
									lo = c
								end
							end
							if lo > Xfb - 1 then
								lo = Xfb - 1
							end
							local hi = Xfb
							local step = 1
							while hi - step > lo do
								local X = hi - step
								local nbX = nb0 - (X - Xfa) * F
								r = 0
								for j = 1, nB do
									r += bW[j] * pw[bOff[j] + nbX]
								end
								nProbe += 1
								if r <= hB then
									lo = X
									break
								end
								hi = X
								step *= 2
							end
							while hi - lo > 1 do
								local X = (lo + hi) // 2
								local nbX = nb0 - (X - Xfa) * F
								r = 0
								for j = 1, nB do
									r += bW[j] * pw[bOff[j] + nbX]
								end
								nProbe += 1
								if r <= hB then
									lo = X
								else
									hi = X
								end
							end
							X2b = lo
						end
					end

					-- fill span (clipped to the output window): one writeu32, then buffer.copy
					-- doubling. Regions are defined on the unclipped footprint range.
					local la, lb, ra, rb
					if X1f <= X2b then
						local fa = if X1f > X0 then X1f else X0
						local fb = if X2b < X1 - 1 then X2b else X1 - 1
						if fa <= fb then
							nFill += 1
							nFillPx += fb - fa + 1
							fillRun(fa, fb, COLt[slot + 1], zi0, zi1, zi2, zi3)
						end
						la, lb, ra, rb = Xfa, X1f - 1, X2b + 1, Xfb
					else
						local mid = (Xfa + Xfb) // 2
						la, lb, ra, rb = Xfa, mid, mid + 1, Xfb
					end
					-- the parts inside the output window
					local wla = if la > X0 then la else X0
					local wlb = if lb < X1 - 1 then lb else X1 - 1
					local wra = if ra > X0 then ra else X0
					local wrb = if rb < X1 - 1 then rb else X1 - 1

					-- transients (T4: each skipped term stays below its share of eps)
					if wlb >= wla or wrb >= wra then
						local shF = eps * (if nB == 0 then 1 else 0.5) * SHRINK / (if nF > 0 then nF else 1)
						local shB = eps * (if nF == 0 then 1 else 0.5) * SHRINK / (if nB > 0 then nB else 1)
						for j = 1, nF do
							fThr[j] = shF / fThr[j] -- skip once a^n <= share / max|Q|
						end
						for j = 1, nB do
							bThr[j] = shB / bThr[j]
						end
						if wlb >= wla then
							-- left region, walked left to right: forward powers shrink
							for j = 1, nF do
								local d = nF + 1 - j -- slowest first, so fast terms trail
								aOff[d] = fOff[j]
								aThr[d] = fThr[j]
								local a, b = (d - 1) * 4, (j - 1) * 4
								aQ[a + 1], aQ[a + 2], aQ[a + 3], aQ[a + 4] = fQ[b + 1], fQ[b + 2], fQ[b + 3], fQ[b + 4]
							end
							local nbEnd = nb0 - (lb - Xfa) * F -- largest backward power in the region
							local no = 0
							for j = 1, nB do
								if pw[bOff[j] + nbEnd] > bThr[j] then
									no += 1
									oOff[no] = bOff[j]
									local a, b = (no - 1) * 4, (j - 1) * 4
									oQ[a + 1], oQ[a + 2], oQ[a + 3], oQ[a + 4] = bQ[b + 1], bQ[b + 2], bQ[b + 3], bQ[b + 4]
								end
							end
							walk(wla, wlb - wla + 1, 1, nF, nf0 + (wla - Xfa) * F, no, nb0 - (wla - Xfa) * F, zi0, zi1, zi2, zi3)
							nEval += wlb - wla + 1
						end
						if wrb >= wra then
							-- right region, walked right to left: backward powers shrink
							for j = 1, nB do
								local d = nB + 1 - j
								aOff[d] = bOff[j]
								aThr[d] = bThr[j]
								local a, b = (d - 1) * 4, (j - 1) * 4
								aQ[a + 1], aQ[a + 2], aQ[a + 3], aQ[a + 4] = bQ[b + 1], bQ[b + 2], bQ[b + 3], bQ[b + 4]
							end
							local nfStart = nf0 + (ra - Xfa) * F -- largest forward power in the region
							local no = 0
							for j = 1, nF do
								if pw[fOff[j] + nfStart] > fThr[j] then
									no += 1
									oOff[no] = fOff[j]
									local a, b = (no - 1) * 4, (j - 1) * 4
									oQ[a + 1], oQ[a + 2], oQ[a + 3], oQ[a + 4] = fQ[b + 1], fQ[b + 2], fQ[b + 3], fQ[b + 4]
								end
							end
							walk(wrb, wrb - wra + 1, -1, nB, nb0 - (wrb - Xfa) * F, no, nf0 + (wrb - Xfa) * F, zi0, zi1, zi2, zi3)
							nEval += wrb - wra + 1
						end
					end
				end
			end
		end
		for g = 1, NG do
			local p = pw[grpOff[go + g] + len]
			local q0 = (g - 1) * 4
			h[q0 + 1] = PFt[bo + q0 + 1] + ef[q0 + 1] * p
			h[q0 + 2] = PFt[bo + q0 + 2] + ef[q0 + 2] * p
			h[q0 + 3] = PFt[bo + q0 + 3] + ef[q0 + 3] * p
			h[q0 + 4] = PFt[bo + q0 + 4] + ef[q0 + 4] * p
		end
	end
	if pendX ~= NONE then
		put(pendX, p0s / pendCnt, p1s / pendCnt, p2s / pendCnt, p3s / pendCnt)
	end
	stats.segments += nSeg
	stats.evals += nEval
	stats.fills += nFill
	stats.fillPixels += nFillPx
	stats.searchProbes += nProbe
	stats.pieces += nPiece
	stats.terms += nTerms
end

----------------------------------------------------------------------------------------
-- Frame driver: bands, row deduplication, vertical strategies, targets
----------------------------------------------------------------------------------------

export type RenderOptions = {
	epsilon: number?, -- error budget per channel in output units (default 0.5); 0 = lossless
	level: number?, -- output level L >= 0: footprint 2^L rendered pixels (T5)
	x: number?, -- region in output pixels at this level (default: everything)
	y: number?,
	w: number?,
	h: number?,
	dx: number?, -- destination of the region's top-left pixel in `out` (default 0, 0)
	dy: number?,
	vertical: string?, -- "box" (default: exact 2D box filter), "point" (centre row), "rows"
	out2: buffer?, -- channels 4..7 when M > 4
	stats: Stats?,
	endless: Endless?, -- X3: render the endless virtual canvas (region may be anywhere)
	dedup: boolean?, -- reuse rows whose segment sequence repeats an earlier one (default true)
}

-- Output size at a level: width ceil(Wr / 2^L); height ceil(Hr / 2^L), or Hr for "rows".
function Liquid.outputSize(plan: Plan, level: number?, vertical: string?): (number, number)
	local F = pow2(level or 0)
	local w = (plan.Wr + F - 1) // F
	local h = if vertical == "rows" then plan.Hr else (plan.Hr + F - 1) // F
	return w, h
end

local function copyRow(out: buffer, out2: buffer?, M: number, dst: number, src: number, bytes: number)
	buffer.copy(out, dst, out, src, bytes)
	if out2 and M > 4 then
		buffer.copy(out2, dst, out2, src, bytes)
	end
end

-- Renders a region of the image at a level into an RGBA8 buffer whose rows are outWidth
-- pixels long. Returns the statistics (accumulated into opts.stats when given).
function Liquid.render(plan: Plan, tree: Tree, out: buffer, outWidth: number, opts: RenderOptions?): Stats
	local o: RenderOptions = opts or {}
	local eps = o.epsilon or 0.5
	assert(eps >= 0, "epsilon must be >= 0")
	local L = o.level or 0
	assert(L >= 0 and L % 1 == 0 and L <= plan.P + plan.R, "level out of range")
	local vertical = o.vertical or "box"
	assert(vertical == "box" or vertical == "point" or vertical == "rows", "vertical must be box, point or rows")
	local endless = o.endless
	local F = pow2(L)
	local Wl, Hl = Liquid.outputSize(plan, L, vertical)
	local rx, ry = o.x or 0, o.y or 0
	local rw, rh = o.w or (Wl - rx), o.h or (Hl - ry)
	if not endless then
		if rx < 0 then
			rw += rx
			rx = 0
		end
		if ry < 0 then
			rh += ry
			ry = 0
		end
		if rx + rw > Wl then
			rw = Wl - rx
		end
		if ry + rh > Hl then
			rh = Hl - ry
		end
	end
	local stats = o.stats or newStats()
	if rw <= 0 or rh <= 0 then
		return stats
	end
	local dx, dy = o.dx or 0, o.dy or 0
	local out2 = o.out2
	local M = plan.M
	local Wr, Hr = plan.Wr, plan.Hr
	local fast = M <= 4
	local AS = if fast then 4 else M -- accumulator stride
	local dedup = o.dedup ~= false
	local horizon = if endless then endless.horizon or 2 else 0
	assert(horizon >= 1 or not endless, "endless horizon must be >= 1")
	local sc = getScratch(plan, if endless then (2 * horizon + 1) * plan.Sr + 2 else Wr + 2)
	-- (the endless window is at most 2 * horizon + 1 blocks wide)
	sc.stats = stats
	assert(buffer.len(out) >= ((dy + rh - 1) * outWidth + dx + rw) * 4, "output buffer too small")

	-- Exact cross-band deduplication: rows whose segment sequences (length, content key,
	-- depth) are equal render identically. A rolling hash over exact integers finds
	-- candidates and the stored sequence is compared before a row is reused, so a hash
	-- collision can only cost a render, never change a pixel.
	local sigv = sc.sigv
	local function rowSignature(n: number): number
		local sl, skey, sdep = sc.sl, sc.skey, sc.sdep
		local hsh = n
		for s = 1, n do
			local v = (skey[s] * 32 + sdep[s]) * 131072 + sl[s] -- < 2^42, exact
			sigv[s] = v
			hsh = (hsh * 1000003 + v) % 2147483647 -- < 2^53 before the modulo: exact
		end
		return hsh
	end
	local function sameRow(entry: { number }, n: number): boolean
		if #entry ~= n then
			return false
		end
		for s = 1, n do
			if entry[s] ~= sigv[s] then
				return false
			end
		end
		return true
	end

	-- Renders output columns [cx0, cx1) of output rows [ry, ry + rh). seg(y) segments
	-- rendered row y and returns (count, band end); xEnd clips the last footprint; rows at
	-- or beyond yLimit do not exist.
	local function column(cx0: number, cx1: number, seg: (number) -> (number, number), xEnd: number, yLimit: number)
		local colBytes = (cx1 - cx0) * 4
		local cw = cx1 - cx0
		local function rowAt(Y: number): number
			return ((dy + Y - ry) * outWidth + dx + cx0 - rx) * 4
		end
		local seen: { [number]: { { number } } } = {} -- signature -> list of {Y, seq...}
		local seenRow: { [{ number }]: number } = {}
		-- returns the output row already holding this row's pixels, or nil (and records Y)
		local function lookup(n: number, Y: number): number?
			if not dedup then
				return nil
			end
			local sig = rowSignature(n)
			local bucket = seen[sig]
			if bucket then
				for _, entry in bucket do
					if sameRow(entry, n) then
						return seenRow[entry]
					end
				end
			else
				bucket = {}
				seen[sig] = bucket
			end
			local entry = table.create(n, 0)
			for s2 = 1, n do
				entry[s2] = sigv[s2]
			end
			table.insert(bucket, entry)
			seenRow[entry] = Y
			return nil
		end
		local function row(n: number, mode: number, at: number, wgt: number)
			if fast then
				eventRow4(plan, tree, sc, n, L, cx0, cx1, eps, mode, out, at, wgt, xEnd)
			else
				eventRow(plan, tree, sc, n, L, cx0, cx1, eps, mode, out, at, out2, wgt, xEnd)
			end
		end
		if vertical == "rows" or L == 0 then
			local y = ry
			local yEndAll = ry + rh
			while y < yEndAll do
				local n, bandEnd = seg(y)
				local yEnd = if bandEnd < yEndAll then bandEnd else yEndAll
				local prev = lookup(n, y)
				if prev then
					copyRow(out, out2, M, rowAt(y), rowAt(prev), colBytes)
					stats.deduped += 1
				else
					row(n, 0, rowAt(y), 1)
					stats.rendered += 1
				end
				stats.rows += 1
				local src = rowAt(y)
				for yy = y + 1, yEnd - 1 do
					copyRow(out, out2, M, rowAt(yy), src, colBytes)
					stats.copied += 1
					stats.rows += 1
				end
				y = yEnd
			end
		elseif vertical == "point" then
			local bandLo, bandHi = 0, -1
			for Y = ry, ry + rh - 1 do
				local ys = Y * F + F // 2
				if ys >= yLimit then
					ys = yLimit - 1
				end
				if Y > ry and ys >= bandLo and ys < bandHi then
					copyRow(out, out2, M, rowAt(Y), rowAt(Y - 1), colBytes)
					stats.copied += 1
				else
					local n, bandEnd = seg(ys)
					local prev = lookup(n, Y)
					if prev then
						copyRow(out, out2, M, rowAt(Y), rowAt(prev), colBytes)
						stats.deduped += 1
					else
						row(n, 0, rowAt(Y), 1)
						stats.rendered += 1
					end
					bandLo, bandHi = ys, bandEnd
				end
				stats.rows += 1
			end
		else
			local acc = sc.acc
			local z = sc.z
			local prevEnd = -math.huge
			for Y = ry, ry + rh - 1 do
				local ya = Y * F
				local yb = if ya + F < yLimit then ya + F else yLimit
				stats.rows += 1
				if Y > ry and prevEnd >= yb then
					copyRow(out, out2, M, rowAt(Y), rowAt(Y - 1), colBytes)
					stats.copied += 1
					continue
				end
				local n, bandEnd = seg(ya)
				if bandEnd >= yb then
					local prev = lookup(n, Y)
					if prev then
						copyRow(out, out2, M, rowAt(Y), rowAt(prev), colBytes)
						stats.deduped += 1
					else
						row(n, 0, rowAt(Y), 1)
						stats.rendered += 1
					end
					prevEnd = bandEnd
				else
					-- the footprint crosses band boundaries: exact weighted sum of the band rows
					prevEnd = -math.huge
					stats.multiBand += 1
					for j = 1, cw * AS do
						acc[j] = 0
					end
					local y = ya
					local inv = 1 / (yb - ya)
					while true do
						local e = if bandEnd < yb then bandEnd else yb
						row(n, 1, 0, (e - y) * inv)
						stats.rendered += 1
						y = e
						if y >= yb then
							break
						end
						n, bandEnd = seg(y)
					end
					local at = rowAt(Y)
					for X = 0, cw - 1 do
						local a = X * AS
						for m = 1, M do
							z[m] = acc[a + m]
						end
						buffer.writeu32(out, at + X * 4, packZ(z, M, 0))
						local o2 = out2
						if o2 and M > 4 then
							buffer.writeu32(o2, at + X * 4, packZ(z, M, 4))
						end
					end
				end
			end
		end
	end

	if endless then
		-- One column per block. Its passes start at rest at the ends of a canonical window:
		-- the block plus the first warm-up width w of the ladder Sr/16, Sr/4, Sr, 4 Sr, ...
		-- (capped at `horizon` blocks) whose a-posteriori certificate is <= tolerance. The
		-- choice depends only on the virtual content of the row, so a pixel never depends on
		-- the requested region, and the seam between blocks is <= twice the tolerance (X3).
		local seed = endless.seed
		local tol = endless.tolerance or pow2(-24)
		local Sr = plan.Sr
		local colW = Sr // F
		local rungs: { number } = {}
		local maxW = horizon * Sr
		local w = if Sr >= 16 then Sr // 16 else 1
		while w < maxW do
			table.insert(rungs, w)
			w *= 4
		end
		table.insert(rungs, maxW)
		for beta = rx // colW, (rx + rw - 1) // colW do
			local cx0 = if beta * colW > rx then beta * colW else rx
			local cx1 = if (beta + 1) * colW < rx + rw then (beta + 1) * colW else rx + rw
			local b0, b1 = beta * Sr, (beta + 1) * Sr
			column(cx0, cx1, function(y: number): (number, number)
				local n, bandEnd = 0, 0
				for ri = 1, #rungs do
					n, bandEnd = segmentEndless(plan, tree, sc, y, b0 - rungs[ri], b1 + rungs[ri], seed)
					local cert = if fast then windowCert(plan, tree, sc, n, b0, b1) else 0
					if cert <= tol or ri == #rungs or not fast then
						if cert > stats.seam then
							stats.seam = cert
						end
						break
					end
				end
				return n, bandEnd
			end, math.huge, math.huge)
		end
	else
		column(rx, rx + rw, function(y: number): (number, number)
			return segmentStored(plan, tree, sc, y, 0, Wr, 0)
		end, Wr, Hr)
	end
	return stats
end

-- Real values (no quantisation) of rendered row y at level L, horizontal footprints only:
-- dst[X * M + m + 1] for X in [0, ceil(Wr / 2^L)). Every value is within epsilon of the
-- exact model's footprint average (T2 and T4 without the rounding term).
function Liquid.renderRowValues(plan: Plan, tree: Tree, y: number, level: number, epsilon: number, dst: { number }, stats: Stats?): number
	local F = pow2(level)
	local Wl = (plan.Wr + F - 1) // F
	local sc = getScratch(plan, plan.Wr + 2)
	sc.stats = stats or newStats()
	local n = segmentStored(plan, tree, sc, y, 0, plan.Wr, 0)
	local acc = sc.acc
	local M = plan.M
	local AS = if M <= 4 then 4 else M
	for j = 1, Wl * AS do
		acc[j] = 0
	end
	if M <= 4 then
		eventRow4(plan, tree, sc, n, level, 0, Wl, epsilon, 1, buffer.create(0), 0, 1, plan.Wr)
	else
		eventRow(plan, tree, sc, n, level, 0, Wl, epsilon, 1, buffer.create(0), 0, nil, 1, plan.Wr)
	end
	for X = 0, Wl - 1 do
		for m = 1, M do
			dst[X * M + m] = acc[X * AS + m]
		end
	end
	return Wl
end

----------------------------------------------------------------------------------------
-- X2 Richardson LOD (horizontal, per row). The finer level L-1 is predicted from levels L
-- and L+1 as  z_{L-1} = z_L + c (z_L - z_{L+1}).  On a single exponential with ratio rho
-- per level-(L-1) pixel (T5: footprint averages of a geometric sequence are geometric),
-- the four children of a level-(L+1) pixel need c = +mu_a, -mu_a, -mu_b, +mu_b with
-- mu_a = 2 / (1 + rho)^2 and mu_b = 2 rho^2 / (1 + rho)^2 (forward decay; swapped for a
-- backward one), and rho^2 is Aitken's ratio of consecutive level-L differences. rho = 1
-- gives the affine coefficients c = +-1/2. Every child pair averages back to z_L exactly
-- (c sums to 0 over a pair), so swapping the prediction for the exact level later never
-- shifts the mean. Proofs and bounds in docs/LIQUID.md (X2).
----------------------------------------------------------------------------------------

-- One level-L pixel X of richardsonRow: writes its two predicted children at out[oa + m]
-- and out[oa + M + m] (1-based m) and returns its discrepancy max_m |zL - zU|.
local function richardsonPixel(zL: { number }, zU: { number }, nL: number, M: number, X: number, out: { number }, oa: number, geometric: boolean): number
	local tau = X % 2
	local up = (X // 2) * M
	local dmax = 0
	for m = 1, M do
		local a = zL[X * M + m]
		local e = a - zU[up + m]
		local muA, muB, forward = 0.5, 0.5, true
		if geometric and X > 0 and X < nL - 2 then
			local dm = a - zL[(X - 1) * M + m]
			local dp = zL[(X + 1) * M + m] - a
			local dq = zL[(X + 2) * M + m] - zL[(X + 1) * M + m]
			if dm ~= 0 and dp ~= 0 then
				local q = dp / dm
				local q2 = dq / dp
				-- a single exponential has equal consecutive ratios; anything else (a
				-- segment boundary, two classes of different speed) keeps the affine c
				local dq2 = q - q2
				if dq2 < 0 then
					dq2 = -dq2
				end
				if q >= 0 and q < math.huge and dq2 <= RATIO_TOL * (if q > q2 then q else q2) then
					local rho
					if q <= 1 then
						rho = math.sqrt(q)
					else
						rho = math.sqrt(1 / q)
						forward = false
					end
					local s1 = 1 + rho
					muA = 2 / (s1 * s1)
					muB = muA * rho * rho
				end
			end
		end
		local c0
		if tau == 0 then
			c0 = if forward then muA else muB
		else
			c0 = -(if forward then muB else muA)
		end
		out[oa + m] = a + c0 * e
		out[oa + M + m] = a - c0 * e
		local ae = if e < 0 then -e else e
		if ae > dmax then
			dmax = ae
		end
	end
	return dmax
end

-- zL: level-L values of one row (nL pixels times M channels, flat, 1-based); zU: the level
-- L+1 values of the same row. Writes the predicted level-(L-1) values (2 nL pixels) into
-- out and the discrepancy max_m |zL - zU| of each level-L pixel into disc[X + 1].
-- geometric = false uses the affine coefficients.
function Liquid.richardsonRow(zL: { number }, zU: { number }, nL: number, M: number, out: { number }, disc: { number }, geometric: boolean)
	for X = 0, nL - 1 do
		disc[X + 1] = richardsonPixel(zL, zU, nL, M, X, out, 2 * X * M, geometric)
	end
end

-- X2 for a whole frame in "rows" layout: renders levels L and L+1 (real values, eps) and
-- writes the predicted level L-1 into out (RGBA8, stride outWidth). Returns the rows
-- ordered by decreasing discrepancy (the refinement order) and each row's largest
-- discrepancy. Event-aware: where the discrepancy is 0 the children equal the coarse value
-- exactly (any c), so runs of such pixels with equal values become fill spans; rows of a
-- band are predicted once and copied.
function Liquid.predictFiner(plan: Plan, tree: Tree, level: number, eps: number, out: buffer, outWidth: number, geometric: boolean?): ({ number }, { number })
	assert(level >= 1 and level + 1 <= plan.P + plan.R, "predictFiner needs 1 <= level < P + R")
	local M = plan.M
	local geo = geometric ~= false
	local Fm = pow2(level - 1)
	local nFine = (plan.Wr + Fm - 1) // Fm
	local zL, zU = {}, {}
	local two = table.create(2 * M, 0)
	local rowDisc = table.create(plan.Hr, 0)
	local z = table.create(M, 0)
	local sc = getScratch(plan, plan.Wr + 2)
	local y = 0
	while y < plan.Hr do
		local _, bandEnd = segmentStored(plan, tree, sc, y, 0, plan.Wr, 0)
		local nL = Liquid.renderRowValues(plan, tree, y, level, eps, zL)
		Liquid.renderRowValues(plan, tree, y, level + 1, eps, zU)
		local at = y * outWidth * 4
		local dmax = 0
		local X = 0
		while X < nL do
			-- run of zero discrepancy and equal values
			local flat = true
			local up = (X // 2) * M
			for m = 1, M do
				if zL[X * M + m] ~= zU[up + m] then
					flat = false
					break
				end
			end
			if flat then
				local X2 = X + 1
				while X2 < nL do
					local same = true
					local u2 = (X2 // 2) * M
					for m = 1, M do
						local v = zL[X2 * M + m]
						if v ~= zL[X * M + m] or v ~= zU[u2 + m] then
							same = false
							break
						end
					end
					if not same then
						break
					end
					X2 += 1
				end
				for m = 1, M do
					z[m] = zL[X * M + m]
				end
				local lo = 2 * X
				local hi = 2 * X2
				if hi > nFine then
					hi = nFine
				end
				if hi > lo then
					fillSpan(out, at + lo * 4, hi - lo, packZ(z, M, 0))
				end
				X = X2
			else
				local d = richardsonPixel(zL, zU, nL, M, X, two, 0, geo)
				if d > dmax then
					dmax = d
				end
				for c = 0, 1 do
					local Xf = 2 * X + c
					if Xf < nFine then
						for m = 1, M do
							z[m] = two[c * M + m]
						end
						buffer.writeu32(out, at + Xf * 4, packZ(z, M, 0))
					end
				end
				X += 1
			end
		end
		for yy = y, bandEnd - 1 do
			rowDisc[yy + 1] = dmax
			if yy > y then
				buffer.copy(out, yy * outWidth * 4, out, at, nFine * 4)
			end
		end
		y = bandEnd
	end
	local order = table.create(plan.Hr, 0)
	for j = 1, plan.Hr do
		order[j] = j - 1
	end
	table.sort(order, function(a: number, b: number): boolean
		local da, db = rowDisc[a + 1], rowDisc[b + 1]
		if da ~= db then
			return da > db
		end
		return a < b
	end)
	return order, rowDisc
end

-- Renders rendered rows `rows` (a list) exactly at a level in "rows" layout: the refinement
-- step of X2 (and any partial re-render). Returns the statistics.
function Liquid.renderRows(plan: Plan, tree: Tree, rows: { number }, level: number, eps: number, out: buffer, outWidth: number, stats: Stats?): Stats
	local st = stats or newStats()
	for _, y in rows do
		Liquid.render(plan, tree, out, outWidth, { epsilon = eps, level = level, vertical = "rows", y = y, h = 1, dy = y, stats = st })
	end
	return st
end

-- T7 lockstep checksum: MyMath.hash32 folded over the buffer's u32 words (length must be a
-- multiple of 4). Equal model bytes, tree bytes and options give equal hashes on every
-- device and in both runtimes, so instances can compare frames by exchanging 4 bytes.
function Liquid.hashBuffer(b: buffer): number
	local h = 0x811C9DC5
	for i = 0, buffer.len(b) // 4 - 1 do
		h = hash32(bit32.bxor(h, buffer.readu32(b, i * 4)))
	end
	return h
end

-- Renders into a Canvas (src/Canvas.luau) and marks exactly the written rows dirty.
-- `canvas` needs fields buf and width and a markDirty(x, y, w, h) method.
function Liquid.renderCanvas(plan: Plan, tree: Tree, canvas: any, opts: RenderOptions?): Stats
	local o: RenderOptions = opts or {}
	local L = o.level or 0
	local vertical = o.vertical or "box"
	local Wl, Hl = Liquid.outputSize(plan, L, vertical)
	local rx, ry = o.x or 0, o.y or 0
	local rw, rh = o.w or (Wl - rx), o.h or (Hl - ry)
	local stats = Liquid.render(plan, tree, canvas.buf, canvas.width, o)
	local dx, dy = o.dx or 0, o.dy or 0
	if rx < 0 then
		dx -= rx
		rw += rx
		rx = 0
	end
	if ry < 0 then
		dy -= ry
		rh += ry
		ry = 0
	end
	rw = math.min(rw, Wl - rx)
	rh = math.min(rh, Hl - ry)
	if rw > 0 and rh > 0 then
		canvas:markDirty(dx, dy, rw, rh)
	end
	return stats
end

-- Reference frame at level 0: every pixel stepped (O(W * H * N)). Writes RGBA8 into `out`
-- (row stride outWidth pixels); channels 4..7 into out2 when M > 4. With fast = true the
-- leaf of each pixel comes from the row segments instead of a per-pixel tree walk (same
-- arithmetic, used by the benchmark as the honest per-pixel baseline).
-- With bands = true only the first row of every band is stepped and the others are copied
-- (rows of a band cross the same leaves, so they are identical): the per-pixel baseline
-- with the renderer's row deduplication, used to separate the two sources of speedup.
function Liquid.reference(plan: Plan, tree: Tree, out: buffer, outWidth: number, fast: boolean?, out2: buffer?, bands: boolean?)
	local W, H, M = plan.Wr, plan.Hr, plan.M
	local z = table.create(W * M, 0)
	local zp = table.create(M, 0)
	local leafFn: ((number, number) -> (number, number))? = nil
	local segLeaf = table.create(W, 0)
	local segDep = table.create(W, 0)
	if fast then
		leafFn = function(x: number, _y: number): (number, number)
			return segLeaf[x + 1], segDep[x + 1]
		end
	end
	local sc = getScratch(plan, W + 2)
	local y = 0
	while y < H do
		local bandEnd = y + 1
		if fast or bands then
			local n, be = segmentStored(plan, tree, sc, y, 0, W, 0)
			if bands then
				bandEnd = be
			end
			for s = 1, n do
				for x = sc.sx[s], sc.sx[s] + sc.sl[s] - 1 do
					segLeaf[x + 1] = sc.sleaf[s]
					segDep[x + 1] = sc.sdep[s]
				end
			end
		end
		Liquid.referenceRow(plan, tree, y, z, leafFn)
		local rowAt = y * outWidth * 4
		for x = 0, W - 1 do
			for m = 1, M do
				zp[m] = z[x * M + m]
			end
			buffer.writeu32(out, rowAt + x * 4, packZ(zp, M, 0))
			if out2 and M > 4 then
				buffer.writeu32(out2, rowAt + x * 4, packZ(zp, M, 4))
			end
		end
		for yy = y + 1, bandEnd - 1 do
			copyRow(out, out2, M, yy * outWidth * 4, rowAt, W * 4)
		end
		y = bandEnd
	end
end

return Liquid
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">MyMath</string>
          <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: MyMath
--
-- The project's numeric axioms, written as code. Every function here uses only
-- operations that round identically on every platform and in both Luau runtimes
-- (interpreter and native): + - * / and sqrt (IEEE 754 correctly rounded), floor,
-- abs, min, max, // and % on integers, and bit32. No libm transcendental functions,
-- no math.lerp (native code fuses it into an FMA), no math.noise or math.random.
-- See docs/RUNTIME_AUDIT.md section 6.5 and docs/DESIGN.md axioms M1 to M9.
--
-- Pixel axioms (docs/COMPUTE.md sections 1, 3.3 and "Flawless pipeline"):
--
--   F1  A pixel is a box filter. The coverage of a shape at a pixel is the EXACT
--       area of the pixel square inside the shape; a byte is flawless when
--       |byte - 255 A| <= 0.5 + 0.01 (the correctly rounded exact area). Exact
--       area, never supersampling, is the reference (n x n point samples err by up
--       to about 1/(2n) per edge crossing).
--   F2  A scene is a box filter of its source-over composite: each pixel is the sum
--       over visible regions of colour times area. Coverage used as alpha is exact
--       only where at most one shape's edge enters the pixel; elsewhere visibility
--       must be computed exactly (compute/Visibility.luau).
--   F3  Content bytes depend only on the deterministic ops listed above (plus the
--       deterministic arcsine Coverage.dasin); interpreter and native code agree.
--
--   C3  Linear ramp error. coverage(d, w) = clamp(1/2 - d/w) is exact only for
--       axis-aligned edges. On a straight 45 degree edge its worst error is
--       (sqrt(2)/2 - 1/2)^2 = 0.04289, i.e. 10.94/255 (closed form). Measured on
--       shapes: 11/255 on circles of any radius, 38/255 at sharp box corners, 26 to
--       57/255 at polygon corners. It is the PREVIEW ramp (Raster MODE_LINEAR).
--   C4  Half-plane exactness. For a straight edge with unit normal (nx, ny) and
--       signed distance d from the pixel centre, coverageHalfPlane is the exact
--       area: the pixel's projection on n has a trapezoid density with ramps of
--       width b = min(|nx|, |ny|) and a plateau of width a - b, a = max(|nx|, |ny|).
--       It is exactly 0 for d >= (a + b)/2 and exactly 1 for d <= -(a + b)/2.
--   C5  Curvature. A boundary of curvature k tangent to the half-plane line lies
--       k t^2 / 2 inside it at tangential offset t, so the half-plane overestimates
--       by at most k (sqrt(2)/2)^3 / 3 = 0.1179 k (30/R in 1/255 units).
--       coverageCurved subtracts the exact first-order term k (t1^3 - t0^3) / 6
--       over the chord [t0, t1] the tangent line cuts from the pixel. Where the
--       line leaves the pixel at a shallow angle, the pixel side cuts the sliver
--       between line and curve obliquely, so the residual is O(k), not O(k^2):
--       measured worst 0.36/255 at R = 8, 0.09 at R = 16, 0.036 at R = 48, 0.004
--       at R = 128, 0.002 at R = 300 (1/255 units, random placements). That is
--       far better than the ramp but NOT flawless (F1 needs < 0.01) below about
--       R = 300, so flawless rendering uses exact disc areas instead
--       (Coverage.discBoxArea, Coverage.discPolyArea).
--   Reach. The reach R_cov of a coverage function is the largest |d| at which it
--       can be strictly between 0 and 1: w/2 for the ramp, COVERAGE_REACH * w =
--       w sqrt(2)/2 for any exact area coverage (every point of a w x w pixel lies
--       within w sqrt(2)/2 of its centre). Culling must drop a shape only when
--       d - L rho >= R_cov (L the Lipschitz constant, rho the node radius) and
--       bounding boxes must grow by R_cov; culling at w/2 silently cuts real
--       coverage on diagonal edges.

local MyMath = {}

local TWO16 = 65536
local TWO32 = 4294967296

MyMath.TWO32 = TWO32

----------------------------------------------------------------------------------
-- M1. Exact 32-bit integer arithmetic inside doubles
----------------------------------------------------------------------------------

-- Low 32 bits of a * b for integers a, b in [0, 2^32).
-- Splitting b into 16-bit halves keeps every partial product below 2^48, so all
-- intermediate values are exact doubles and the result is bit-identical everywhere.
local function mul32(a: number, b: number): number
	local bl = b % TWO16
	local bh = (b - bl) / TWO16
	return (a * bl + (a * bh) % TWO16 * TWO16) % TWO32
end
MyMath.mul32 = mul32

-- Folds any integer-valued number (negative too) into [0, 2^32).
function MyMath.u32(x: number): number
	return (x // 1) % TWO32
end

----------------------------------------------------------------------------------
-- M2. Deterministic hashing and noise
----------------------------------------------------------------------------------

-- lowbias32 (Chris Wellons, public domain): a full-avalanche 32-bit integer hash.
local function hash32(x: number): number
	x = bit32.bxor(x, bit32.rshift(x, 16))
	x = mul32(x, 0x7FEB352D)
	x = bit32.bxor(x, bit32.rshift(x, 15))
	x = mul32(x, 0x846CA68B)
	return bit32.bxor(x, bit32.rshift(x, 16))
end
MyMath.hash32 = hash32

-- Hash of an integer lattice point and a seed. Inputs may be negative.
local function hash2(ix: number, iy: number, seed: number): number
	local h = hash32(bit32.bxor(seed % TWO32, mul32(ix % TWO32, 0x9E3779B1)))
	return hash32(bit32.bxor(h, mul32(iy % TWO32, 0x85EBCA77)))
end
MyMath.hash2 = hash2

-- Uniform number in [0, 1) from a lattice point.
function MyMath.rand2(ix: number, iy: number, seed: number): number
	return hash2(ix, iy, seed) / TWO32
end

-- Quintic fade 6t^5 - 15t^4 + 10t^3. Its derivative peaks at 1.875 (t = 0.5).
local function fade(t: number): number
	return t * t * t * (t * (t * 6 - 15) + 10)
end
MyMath.fade = fade

-- Value noise in [0, 1). Lipschitz constant <= 1.875 * sqrt(2) per unit of input.
MyMath.VALUE_NOISE_LIPSCHITZ = 2.6517

function MyMath.valueNoise2(x: number, y: number, seed: number): number
	local ix = x // 1
	local iy = y // 1
	local ux = fade(x - ix)
	local uy = fade(y - iy)
	local a = hash2(ix, iy, seed) / TWO32
	local b = hash2(ix + 1, iy, seed) / TWO32
	local c = hash2(ix, iy + 1, seed) / TWO32
	local d = hash2(ix + 1, iy + 1, seed) / TWO32
	local ab = a + (b - a) * ux
	local cd = c + (d - c) * ux
	return ab + (cd - ab) * uy
end

-- Fractal sum of value noise. Returns value in [0, 1) and its Lipschitz bound.
function MyMath.fbm2(x: number, y: number, seed: number, octaves: number): (number, number)
	local sum, amp, freq, norm, lip = 0, 1, 1, 0, 0
	for o = 1, octaves do
		sum += amp * MyMath.valueNoise2(x * freq, y * freq, seed + o * 1013)
		norm += amp
		lip += amp * freq * 2.6517
		amp *= 0.5
		freq *= 2
	end
	return sum / norm, lip / norm
end

----------------------------------------------------------------------------------
-- M3. Deterministic trigonometry (angles in turns: 1 turn = 360 degrees)
----------------------------------------------------------------------------------

local TAU = 6.283185307179586

-- sin(2 pi t) from an odd Taylor polynomial up to x^15 on [-pi/2, pi/2].
-- Truncation error is below 1e-10; only + and * are used, so it is bit-identical
-- on every platform (unlike math.sin).
local function dsinTurns(t: number): number
	t = t - t // 1 -- [0, 1)
	local s
	if t < 0.25 then
		s = t
	elseif t < 0.75 then
		s = 0.5 - t
	else
		s = t - 1
	end
	local x = s * TAU
	local x2 = x * x
	return x
		* (1 + x2 * (-1 / 6 + x2 * (1 / 120 + x2 * (-1 / 5040 + x2 * (1 / 362880 + x2 * (-1 / 39916800 + x2 * (1 / 6227020800 + x2 * (-1 / 1307674368000))))))))
end
MyMath.dsinTurns = dsinTurns

function MyMath.dcosTurns(t: number): number
	return dsinTurns(t + 0.25)
end

----------------------------------------------------------------------------------
-- M4. Shaping functions
----------------------------------------------------------------------------------

function MyMath.clamp01(x: number): number
	return if x < 0 then 0 elseif x > 1 then 1 else x
end

function MyMath.smoothstep(e0: number, e1: number, x: number): number
	local t = (x - e0) / (e1 - e0)
	t = if t < 0 then 0 elseif t > 1 then 1 else t
	return t * t * (3 - 2 * t)
end

-- Linear interpolation written out so native code never fuses it into an FMA.
function MyMath.mix(a: number, b: number, t: number): number
	return a + (b - a) * t
end

----------------------------------------------------------------------------------
-- M5. Signed distance primitives (negative inside). All are exact or bounded
-- distances with Lipschitz constant 1, which the rasterizer relies on.
----------------------------------------------------------------------------------

function MyMath.sdCircle(px: number, py: number, cx: number, cy: number, r: number): number
	local dx, dy = px - cx, py - cy
	return math.sqrt(dx * dx + dy * dy) - r
end

-- Box centred at (cx, cy) with half extents (hx, hy) and corner radius rad.
function MyMath.sdRoundBox(px: number, py: number, cx: number, cy: number, hx: number, hy: number, rad: number): number
	local qx = math.abs(px - cx) - hx + rad
	local qy = math.abs(py - cy) - hy + rad
	local ox = if qx > 0 then qx else 0
	local oy = if qy > 0 then qy else 0
	local inside = if qx > qy then qx else qy
	if inside > 0 then
		inside = 0
	end
	return math.sqrt(ox * ox + oy * oy) + inside - rad
end

-- Capsule: segment a-b thickened by radius r.
function MyMath.sdSegment(px: number, py: number, ax: number, ay: number, bx: number, by: number, r: number): number
	local pax, pay = px - ax, py - ay
	local bax, bay = bx - ax, by - ay
	local len2 = bax * bax + bay * bay
	local h = if len2 > 0 then (pax * bax + pay * bay) / len2 else 0
	h = if h < 0 then 0 elseif h > 1 then 1 else h
	local dx, dy = pax - bax * h, pay - bay * h
	return math.sqrt(dx * dx + dy * dy) - r
end

-- Polygon given as flat {x1, y1, x2, y2, ...}; exact signed distance with the
-- even-odd winding sign (Inigo Quilez's sdPolygon).
function MyMath.sdPolygon(px: number, py: number, pts: { number }): number
	local n = #pts // 2
	local d = math.huge
	local s = 1
	local jx, jy = pts[2 * n - 1], pts[2 * n]
	for i = 1, n do
		local vx, vy = pts[2 * i - 1], pts[2 * i]
		local ex, ey = jx - vx, jy - vy
		local wx, wy = px - vx, py - vy
		local ee = ex * ex + ey * ey
		local h = if ee > 0 then (wx * ex + wy * ey) / ee else 0
		h = if h < 0 then 0 elseif h > 1 then 1 else h
		local bx, by = wx - ex * h, wy - ey * h
		local dd = bx * bx + by * by
		if dd < d then
			d = dd
		end
		local c1 = py >= vy
		local c2 = py < jy
		local c3 = ex * wy > ey * wx
		if (c1 and c2 and c3) or (not c1 and not c2 and not c3) then
			s = -s
		end
		jx, jy = vx, vy
	end
	return s * math.sqrt(d)
end

-- Polynomial smooth minimum. Its partial derivatives are h and 1 - h, so it keeps
-- the Lipschitz bound of its inputs (proof in docs/DESIGN.md).
function MyMath.smin(a: number, b: number, k: number): number
	if k <= 0 then
		return if a < b then a else b
	end
	local h = 0.5 + 0.5 * (b - a) / k
	h = if h < 0 then 0 elseif h > 1 then 1 else h
	return b + (a - b) * h - k * h * (1 - h)
end

-- The LINEAR PREVIEW RAMP: clamp(0.5 - d / w, 0, 1) from the signed distance d in
-- pixels and an anti-aliasing width w (1 = one pixel). Exactly 0 when d >= w/2 and
-- exactly 1 when d <= -w/2 (its reach is w/2), which ramp-based culling relies on.
-- As an estimate of pixel area it is exact only for axis-aligned edges: up to
-- 10.94/255 on a straight 45 degree edge (C3, closed form), 11/255 on circles of
-- any radius, 38/255 at sharp box corners and 26 to 57/255 at polygon corners
-- (measured, docs/COMPUTE.md 3.3). Use it for previews (Raster MODE_LINEAR); use
-- coverageHalfPlane, coverageCurved or exact areas for content (F1).
function MyMath.coverage(d: number, w: number): number
	local a = 0.5 - d / w
	return if a < 0 then 0 elseif a > 1 then 1 else a
end

----------------------------------------------------------------------------------
-- M8. Exact-area coverage axioms (C4, C5; header). Moved verbatim from
-- compute/Coverage.luau (halfPlane, halfPlaneCurved), so results are bit-identical;
-- the optional w scales the box filter (a w x w pixel, default 1): d is divided by
-- w and the curvature k multiplied by w, which is exact when w is 1 or omitted.
----------------------------------------------------------------------------------

local abs = math.abs

-- sqrt(2)/2: the reach of every exact-area coverage function in pixel widths.
MyMath.COVERAGE_REACH = 0.70710678118654757

-- C4. Exact area of {q in pixel : d + n . (q - centre) <= 0} for |n| = 1, i.e. the
-- part of the pixel on the inner side of a straight edge at signed distance d
-- (negative inside) with unit normal (nx, ny). Only |nx| and |ny| matter.
local function coverageHalfPlane(d: number, nx: number, ny: number, w: number?): number
	if w then
		d = d / w
	end
	local a, b = abs(nx), abs(ny)
	if a < b then
		a, b = b, a
	end
	local u = (a + b) * 0.5 - d
	if u <= 0 then
		return 0
	end
	if u >= a + b then
		return 1
	end
	if u < b then
		return u * u / (2 * a * b)
	end
	if u <= a then
		return (2 * u - b) / (2 * a)
	end
	local v = a + b - u
	return 1 - v * v / (2 * a * b)
end
MyMath.coverageHalfPlane = coverageHalfPlane

-- C5. Half-plane area minus the first-order curvature term k (t1^3 - t0^3) / 6
-- over the chord the tangent line cuts from the pixel. k > 0 where the shape is
-- convex (1 / R for a disc of radius R), k < 0 where it is concave. Error O(k) at
-- shallow chord exits (header), so it is an estimator, not an exact area.
local function coverageCurved(d: number, nx: number, ny: number, k: number, w: number?): number
	if w then
		d = d / w
		k = k * w
	end
	local base = coverageHalfPlane(d, nx, ny)
	if k == 0 then
		return base
	end
	-- the line is {q : n . (q - c) = -d}; parametrise q = c - d n + t (-ny, nx)
	-- and clip t to the unit square |qx - cx| <= 1/2, |qy - cy| <= 1/2
	local t0, t1 = -1e300, 1e300
	local tx, ty = -ny, nx
	local ox, oy = -d * nx, -d * ny
	if tx ~= 0 then
		local a0 = (-0.5 - ox) / tx
		local a1 = (0.5 - ox) / tx
		if a0 > a1 then
			a0, a1 = a1, a0
		end
		if a0 > t0 then
			t0 = a0
		end
		if a1 < t1 then
			t1 = a1
		end
	elseif ox < -0.5 or ox > 0.5 then
		t1 = t0
	end
	if ty ~= 0 then
		local a0 = (-0.5 - oy) / ty
		local a1 = (0.5 - oy) / ty
		if a0 > a1 then
			a0, a1 = a1, a0
		end
		if a0 > t0 then
			t0 = a0
		end
		if a1 < t1 then
			t1 = a1
		end
	elseif oy < -0.5 or oy > 0.5 then
		t1 = t0
	end
	local c = base
	if t1 > t0 then
		c = base - k * (t1 * t1 * t1 - t0 * t0 * t0) / 6
	end
	return if c < 0 then 0 elseif c > 1 then 1 else c
end
MyMath.coverageCurved = coverageCurved

----------------------------------------------------------------------------------
-- M6. Exact 8-bit colour arithmetic
----------------------------------------------------------------------------------

-- round(t / 255) for integer t in [0, 65025], with no division. Verified for every
-- input by brute force. Each 16-bit lane of a SWAR word stays below 2^16.
function MyMath.div255(t: number): number
	local x = t + 128
	return (x + x // 256) // 256
end

function MyMath.pack(r: number, g: number, b: number, a: number): number
	return r + g * 256 + b * 65536 + a * 16777216
end

function MyMath.unpack(c: number): (number, number, number, number)
	return c % 256, (c // 256) % 256, (c // 65536) % 256, c // 16777216
end

-- Parses "#RRGGBB" or "#RRGGBBAA" into a packed straight-alpha RGBA8 value.
function MyMath.hex(s: string): number
	local h = string.gsub(s, "^#", "")
	local r = tonumber(string.sub(h, 1, 2), 16) or 0
	local g = tonumber(string.sub(h, 3, 4), 16) or 0
	local b = tonumber(string.sub(h, 5, 6), 16) or 0
	local a = if #h >= 8 then tonumber(string.sub(h, 7, 8), 16) or 255 else 255
	return r + g * 256 + b * 65536 + a * 16777216
end

-- sRGB to linear light in 16-bit fixed point, generated offline (tools/gen_vectors.py)
-- so every client uses the same integers. Strictly increasing.
local SRGB_TO_LINEAR16 = {
	0, 20, 40, 60, 80, 99, 119, 139, 159, 179, 199, 219, 241, 264, 288, 313,
	340, 367, 396, 427, 458, 491, 526, 562, 599, 637, 677, 718, 761, 805, 851, 898,
	947, 997, 1048, 1101, 1156, 1212, 1270, 1330, 1391, 1453, 1517, 1583, 1651, 1720, 1790, 1863,
	1937, 2013, 2090, 2170, 2250, 2333, 2418, 2504, 2592, 2681, 2773, 2866, 2961, 3058, 3157, 3258,
	3360, 3464, 3570, 3678, 3788, 3900, 4014, 4129, 4247, 4366, 4488, 4611, 4736, 4864, 4993, 5124,
	5257, 5392, 5530, 5669, 5810, 5953, 6099, 6246, 6395, 6547, 6700, 6856, 7014, 7174, 7335, 7500,
	7666, 7834, 8004, 8177, 8352, 8528, 8708, 8889, 9072, 9258, 9445, 9635, 9828, 10022, 10219, 10417,
	10619, 10822, 11028, 11235, 11446, 11658, 11873, 12090, 12309, 12530, 12754, 12980, 13209, 13440, 13673, 13909,
	14146, 14387, 14629, 14874, 15122, 15371, 15623, 15878, 16135, 16394, 16656, 16920, 17187, 17456, 17727, 18001,
	18277, 18556, 18837, 19121, 19407, 19696, 19987, 20281, 20577, 20876, 21177, 21481, 21787, 22096, 22407, 22721,
	23038, 23357, 23678, 24002, 24329, 24658, 24990, 25325, 25662, 26001, 26344, 26688, 27036, 27386, 27739, 28094,
	28452, 28813, 29176, 29542, 29911, 30282, 30656, 31033, 31412, 31794, 32179, 32567, 32957, 33350, 33745, 34143,
	34544, 34948, 35355, 35764, 36176, 36591, 37008, 37429, 37852, 38278, 38706, 39138, 39572, 40009, 40449, 40891,
	41337, 41785, 42236, 42690, 43147, 43606, 44069, 44534, 45002, 45473, 45947, 46423, 46903, 47385, 47871, 48359,
	48850, 49344, 49841, 50341, 50844, 51349, 51858, 52369, 52884, 53401, 53921, 54445, 54971, 55500, 56032, 56567,
	57105, 57646, 58190, 58737, 59287, 59840, 60396, 60955, 61517, 62082, 62650, 63221, 63795, 64372, 64952, 65535,
}
MyMath.SRGB_TO_LINEAR16 = SRGB_TO_LINEAR16

function MyMath.srgbToLinear16(c8: number): number
	return SRGB_TO_LINEAR16[c8 + 1]
end

-- Inverse by binary search: the sRGB byte whose linear value is nearest to v.
function MyMath.linear16ToSrgb(v: number): number
	local lo, hi = 0, 255
	while lo < hi do
		local mid = (lo + hi) // 2
		if SRGB_TO_LINEAR16[mid + 1] < v then
			lo = mid + 1
		else
			hi = mid
		end
	end
	if lo > 0 and v - SRGB_TO_LINEAR16[lo] <= SRGB_TO_LINEAR16[lo + 1] - v then
		return lo - 1
	end
	return lo
end

----------------------------------------------------------------------------------
-- M7. Resolution allocation under a pixel-area budget ("water filling")
----------------------------------------------------------------------------------

-- Chooses a square texture size for each surface so the total pixel area fits the
-- budget. A surface gains detail only up to the pixels it covers on screen, so the
-- benefit of each size step is min(area, demand) * weight and has diminishing
-- returns. Greedy by benefit per added pixel is optimal for the continuous
-- relaxation and within one size step of optimal here.
--
-- demands[i]: on-screen pixel area of surface i (its useful texel count)
-- weights[i]: importance multiplier, default 1
-- budget:     total texel area allowed
-- sizes:      ascending allowed edge lengths, e.g. {64, 128, 256, 512, 1024}
-- returns { edge length or 0 } per surface (0 = no editable image)
function MyMath.allocate(demands: { number }, weights: { number }?, budget: number, sizes: { number }): { number }
	local n = #demands
	local level = table.create(n, 0) -- index into sizes; 0 = none
	local result = table.create(n, 0)
	local remaining = budget
	local function area(l: number): number
		if l == 0 then
			return 0
		end
		local s = sizes[l]
		return s * s
	end
	while true do
		local best, bestRatio = 0, 0
		for i = 1, n do
			local l = level[i]
			if l < #sizes then
				local cur, nxt = area(l), area(l + 1)
				local cost = nxt - cur
				if cost <= remaining then
					local d = demands[i]
					local w = if weights then weights[i] or 1 else 1
					local gain = ((if nxt < d then nxt else d) - (if cur < d then cur else d)) * w
					local ratio = gain / cost
					if ratio > bestRatio then
						best, bestRatio = i, ratio
					end
				end
			end
		end
		if best == 0 then
			break
		end
		remaining -= area(level[best] + 1) - area(level[best])
		level[best] += 1
	end
	for i = 1, n do
		result[i] = if level[i] == 0 then 0 else sizes[level[i]]
	end
	return result
end

return MyMath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Pixels</string>
          <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: Pixels
--
-- Buffer-level pixel ops on row-major RGBA8 (the EditableImage layout: bytes R, G,
-- B, A, so a pixel read with readu32 is r + g*256 + b*65536 + a*16777216).
-- Every op here follows the measured economics in docs/RUNTIME_AUDIT.md 6.7:
-- spans go through buffer.copy, per-pixel loops pack with arithmetic, and no
-- non-builtin call happens per pixel.

local MyMath = require("./MyMath")

local Pixels = {}

local pack = MyMath.pack

-- Fills count pixels starting at byte offset `at` with one colour.
-- One writeu32, then buffer.copy doubling: log2(count) C calls instead of count
-- interpreted writes (about 50x faster for a 1024 px row).
local function fillSpan(buf: buffer, at: number, count: number, color: number)
	if count <= 0 then
		return
	end
	buffer.writeu32(buf, at, color)
	if count < 8 then
		for i = 1, count - 1 do
			buffer.writeu32(buf, at + i * 4, color)
		end
		return
	end
	local bytes = count * 4
	local filled = 4
	while filled < bytes do
		local n = if filled < bytes - filled then filled else bytes - filled
		buffer.copy(buf, at + filled, buf, at, n)
		filled += n
	end
end
Pixels.fillSpan = fillSpan

-- Fills a w x h rectangle at (x, y) of an image `width` pixels wide.
function Pixels.fillRect(buf: buffer, width: number, x: number, y: number, w: number, h: number, color: number)
	if w <= 0 or h <= 0 then
		return
	end
	local row = width * 4
	local first = (y * width + x) * 4
	fillSpan(buf, first, w, color)
	local bytes = w * 4
	for r = 1, h - 1 do
		buffer.copy(buf, first + r * row, buf, first, bytes)
	end
end

-- Fills the whole buffer with one colour.
function Pixels.fill(buf: buffer, color: number)
	fillSpan(buf, 0, buffer.len(buf) // 4, color)
end

-- Copies a w x h block between two row-major images (row blits; memmove semantics).
function Pixels.copyRect(
	dst: buffer,
	dstWidth: number,
	dx: number,
	dy: number,
	src: buffer,
	srcWidth: number,
	sx: number,
	sy: number,
	w: number,
	h: number
)
	local bytes = w * 4
	for r = 0, h - 1 do
		buffer.copy(dst, ((dy + r) * dstWidth + dx) * 4, src, ((sy + r) * srcWidth + sx) * 4, bytes)
	end
end

-- Extracts a rectangle into a new tightly packed buffer (the shape WritePixelsBuffer wants).
function Pixels.extract(src: buffer, srcWidth: number, x: number, y: number, w: number, h: number, into: buffer?): buffer
	local out = into or buffer.create(w * h * 4)
	Pixels.copyRect(out, w, 0, 0, src, srcWidth, x, y, w, h)
	return out
end

-- 2 x 2 box filter: (w, h) -> (w // 2, h // 2). Channels are averaged in pairs
-- inside 16-bit lanes (mask 0x00FF00FF): four bytes sum to at most 1020, so lanes
-- never carry into each other. Rounds half up. Measured 20 percent faster than a
-- per-channel version in the interpreter.
function Pixels.downsample2x(src: buffer, w: number, h: number, dst: buffer?): (buffer, number, number)
	local hw, hh = w // 2, h // 2
	local out = dst or buffer.create(math.max(hw * hh * 4, 4))
	local srcRow = w * 4
	local o = 0
	for y = 0, hh - 1 do
		local r0 = y * 2 * srcRow
		local r1 = r0 + srcRow
		for x = 0, hw - 1 do
			local a0 = r0 + x * 8
			local b0 = r1 + x * 8
			local p = buffer.readu32(src, a0)
			local q = buffer.readu32(src, a0 + 4)
			local s = buffer.readu32(src, b0)
			local t = buffer.readu32(src, b0 + 4)
			local rb = bit32.band(p, 0x00FF00FF)
				+ bit32.band(q, 0x00FF00FF)
				+ bit32.band(s, 0x00FF00FF)
				+ bit32.band(t, 0x00FF00FF)
				+ 0x00020002
			local ga = bit32.band(bit32.rshift(p, 8), 0x00FF00FF)
				+ bit32.band(bit32.rshift(q, 8), 0x00FF00FF)
				+ bit32.band(bit32.rshift(s, 8), 0x00FF00FF)
				+ bit32.band(bit32.rshift(t, 8), 0x00FF00FF)
				+ 0x00020002
			buffer.writeu32(
				out,
				o,
				bit32.band(bit32.rshift(rb, 2), 0x00FF00FF) + bit32.band(bit32.rshift(ga, 2), 0x00FF00FF) * 256
			)
			o += 4
		end
	end
	return out, hw, hh
end

-- Premultiplied-correct 2 x 2 box filter: averages colour weighted by alpha, so a
-- transparent neighbour never darkens or tints an edge. Slower than the SWAR one
-- (about 2x); use it for content with soft alpha edges.
function Pixels.downsample2xAlphaWeighted(src: buffer, w: number, h: number, dst: buffer?): (buffer, number, number)
	local hw, hh = w // 2, h // 2
	local out = dst or buffer.create(math.max(hw * hh * 4, 4))
	local srcRow = w * 4
	local o = 0
	for y = 0, hh - 1 do
		local r0 = y * 2 * srcRow
		local r1 = r0 + srcRow
		for x = 0, hw - 1 do
			local a0 = r0 + x * 8
			local b0 = r1 + x * 8
			local sr, sg, sb, sa = 0, 0, 0, 0
			for k = 1, 4 do
				local at = if k == 1 then a0 elseif k == 2 then a0 + 4 elseif k == 3 then b0 else b0 + 4
				local px = buffer.readu32(src, at)
				local a = px // 16777216
				sr += (px % 256) * a
				sg += ((px // 256) % 256) * a
				sb += ((px // 65536) % 256) * a
				sa += a
			end
			if sa > 0 then
				buffer.writeu32(out, o, pack((sr / sa + 0.5) // 1, (sg / sa + 0.5) // 1, (sb / sa + 0.5) // 1, (sa + 2) // 4))
			else
				-- fully transparent: keep the plain average colour so later mips still bleed
				local p = buffer.readu32(src, a0)
				buffer.writeu32(out, o, p % 16777216)
			end
			o += 4
		end
	end
	return out, hw, hh
end

-- Source-over for straight alpha, in place: dst = src over dst, `count` pixels.
-- The float form measured fastest in the interpreter (fewer builtin calls than SWAR).
function Pixels.blendOver(dst: buffer, dstAt: number, src: buffer, srcAt: number, count: number)
	for i = 0, count - 1 do
		local s = buffer.readu32(src, srcAt + i * 4)
		local sa = s // 16777216
		if sa == 0 then
			continue
		end
		local o = dstAt + i * 4
		if sa == 255 then
			buffer.writeu32(dst, o, s)
			continue
		end
		local d = buffer.readu32(dst, o)
		local da = d // 16777216
		local fs = sa / 255
		local fd = (da / 255) * (1 - fs)
		local oa = fs + fd
		local ws, wd = fs / oa, fd / oa
		local r = (s % 256) * ws + (d % 256) * wd
		local g = ((s // 256) % 256) * ws + ((d // 256) % 256) * wd
		local b = ((s // 65536) % 256) * ws + ((d // 65536) % 256) * wd
		buffer.writeu32(dst, o, pack((r + 0.5) // 1, (g + 0.5) // 1, (b + 0.5) // 1, (oa * 255 + 0.5) // 1))
	end
end

-- Alpha bleeding (colour dilation): every fully transparent pixel next to a visible
-- one takes that neighbour's RGB while keeping alpha 0, repeated `passes` times.
-- Bilinear filtering of straight-alpha textures then never pulls in a foreign
-- colour at the edge: if RGB is constant across an alpha edge, filtering straight
-- alpha equals filtering premultiplied alpha (docs/DESIGN.md, axiom A8).
function Pixels.bleed(buf: buffer, w: number, h: number, passes: number?)
	local n = w * h
	local known = buffer.create(n) -- 1 = pixel has a trusted colour
	for i = 0, n - 1 do
		if buffer.readu8(buf, i * 4 + 3) > 0 then
			buffer.writeu8(known, i, 1)
		end
	end
	local frontier = {}
	for _ = 1, passes or 4 do
		table.clear(frontier)
		for y = 0, h - 1 do
			for x = 0, w - 1 do
				local i = y * w + x
				if buffer.readu8(known, i) == 0 then
					local sr, sg, sb, c = 0, 0, 0, 0
					if x > 0 and buffer.readu8(known, i - 1) == 1 then
						local p = buffer.readu32(buf, (i - 1) * 4)
						sr += p % 256
						sg += (p // 256) % 256
						sb += (p // 65536) % 256
						c += 1
					end
					if x < w - 1 and buffer.readu8(known, i + 1) == 1 then
						local p = buffer.readu32(buf, (i + 1) * 4)
						sr += p % 256
						sg += (p // 256) % 256
						sb += (p // 65536) % 256
						c += 1
					end
					if y > 0 and buffer.readu8(known, i - w) == 1 then
						local p = buffer.readu32(buf, (i - w) * 4)
						sr += p % 256
						sg += (p // 256) % 256
						sb += (p // 65536) % 256
						c += 1
					end
					if y < h - 1 and buffer.readu8(known, i + w) == 1 then
						local p = buffer.readu32(buf, (i + w) * 4)
						sr += p % 256
						sg += (p // 256) % 256
						sb += (p // 65536) % 256
						c += 1
					end
					if c > 0 then
						table.insert(frontier, i)
						table.insert(frontier, pack((sr / c + 0.5) // 1, (sg / c + 0.5) // 1, (sb / c + 0.5) // 1, 0))
					end
				end
			end
		end
		if #frontier == 0 then
			break
		end
		for k = 1, #frontier, 2 do
			local i = frontier[k]
			buffer.writeu32(buf, i * 4, frontier[k + 1])
			buffer.writeu8(known, i, 1)
		end
	end
end

-- Expands an 8-bit indexed image through a 256-entry palette buffer of u32 colours.
function Pixels.expandIndexed(indices: buffer, palette: buffer, dst: buffer, count: number)
	local o = 0
	for i = 0, count - 1 do
		buffer.writeu32(dst, o, buffer.readu32(palette, buffer.readu8(indices, i) * 4))
		o += 4
	end
end

-- Counts pixels that differ between two equal-sized images; optional channel mask
-- (default all four bytes).
function Pixels.diff(a: buffer, b: buffer, count: number, ignoreRgbUnderZeroAlpha: boolean?): number
	local n = 0
	for i = 0, count - 1 do
		local p = buffer.readu32(a, i * 4)
		local q = buffer.readu32(b, i * 4)
		if p ~= q then
			if ignoreRgbUnderZeroAlpha and p // 16777216 == 0 and q // 16777216 == 0 then
				continue
			end
			n += 1
		end
	end
	return n
end

return Pixels
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="8">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="9">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="10">
        <Properties>
          <string name="Name">GalleryClient</string>
          <string name="Source"><![CDATA[--!strict
-- universe-at-home :: gallery/Gallery.client.luau  (LocalScript, StarterPlayerScripts)
--
-- A visual gallery of EditableImages, every one drawn in Luau on this machine:
--   * a vector badge rendered with exact-area edges and copy-filled tiles
--   * a live plasma rewritten every frame (compute and upload time shown)
--   * procedural marble from deterministic fractal noise
--   * a 1152 x 1152 canvas made of nine 384 x 384 tiles (larger than any one image may be)
--   * level-of-detail switching: a hard switch next to the two-phase fade
--   * a green-screen portrait, its matte, and the cut-out over a new backdrop
-- plus a spinning cube in the world that wears the same EditableImages as Decals.
--
-- Heavy panels are drawn by a frame-time scheduler (coroutines that yield when the frame's
-- budget is spent), so the gallery fills in over a few seconds without freezing the game.
-- Every stage runs under pcall: if one fails, the others still come up and the error is shown.
-- Press G to hide or show the panels.
--
-- Requires: Game Settings, Security, "Allow Mesh / Image APIs" turned ON.

local AssetService = game:GetService("AssetService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Stats = game:GetService("Stats")
local UserInputService = game:GetService("UserInputService")

-- wait for replication, then require by static path
ReplicatedStorage:WaitForChild("Universe"):WaitForChild("MyMath")
ReplicatedStorage:WaitForChild("Gallery"):WaitForChild("Panels")
local MyMath: any = require(ReplicatedStorage.Universe.MyMath)
local Panels: any = (require(ReplicatedStorage.Gallery.Panels) :: any)(MyMath)

-- ALLAN (the liquid network renderer) and its embedded models are optional for the gallery:
-- if they fail to load, only the two ALLAN cards say so.
local allanOk, allanErr = (pcall :: any)(function()
	ReplicatedStorage:WaitForChild("Universe"):WaitForChild("Liquid")
	ReplicatedStorage:WaitForChild("Gallery"):WaitForChild("AlnModels")
	return {
		Liquid = require(ReplicatedStorage.Universe.Liquid),
		Models = require(ReplicatedStorage.Gallery.AlnModels),
	}
end)
local Liquid: any = if allanOk then allanErr.Liquid else nil
local AlnModels: any = if allanOk then allanErr.Models else nil

local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui") :: PlayerGui

----------------------------------------------------------------------------------------
-- Error reporting and EditableImage helpers
----------------------------------------------------------------------------------------

-- pcall for functions that return nothing: typed as (boolean, any) so the error can be read
local function try(fn: () -> ()): (boolean, any)
	local ok, err = (pcall :: any)(fn)
	return ok, err
end

local errors: { string } = {}
local banner: TextLabel? = nil

local function reportError(where: string, message: string)
	local line = where .. ": " .. message
	table.insert(errors, line)
	warn("[Gallery] " .. line)
	if banner then
		banner.Visible = true
		banner.Text = "Something did not come up. " .. line
			.. "\nIf this says EditableImage is not enabled: Home > Game Settings > Security > Allow Mesh / Image APIs, then press Play again."
	end
end

local liveImages = 0
local livePixels = 0

local function createImage(w: number, h: number, where: string): EditableImage?
	local ok, result = pcall(function()
		return AssetService:CreateEditableImage({ Size = Vector2.new(w, h) })
	end)
	if ok and result then
		liveImages += 1
		livePixels += w * h
		return result :: EditableImage
	end
	reportError(where, if ok then "CreateEditableImage returned nil (out of editable memory budget)" else tostring(result))
	return nil
end

local scratch: { [number]: buffer } = {}

-- Uploads rows [y0, y1) of a row-major RGBA8 buffer.
local function uploadRows(img: EditableImage, buf: buffer, width: number, y0: number, y1: number)
	local rows = y1 - y0
	if rows <= 0 then
		return
	end
	local bytes = rows * width * 4
	if y0 == 0 and bytes == buffer.len(buf) then
		img:WritePixelsBuffer(Vector2.zero, Vector2.new(width, rows), buf)
		return
	end
	local tmp = scratch[bytes]
	if not tmp then
		tmp = buffer.create(bytes)
		scratch[bytes] = tmp
	end
	buffer.copy(tmp, 0, buf, y0 * width * 4, bytes)
	img:WritePixelsBuffer(Vector2.new(0, y0), Vector2.new(width, rows), tmp)
end

----------------------------------------------------------------------------------------
-- Frame-time scheduler: jobs are coroutines that yield when the frame's budget is spent
----------------------------------------------------------------------------------------

type Job = { co: thread, cpu: number, sliceStart: number, name: string }

local jobs: { Job } = {}
local deadline = 0

local function checkpoint()
	if os.clock() >= deadline then
		coroutine.yield()
	end
end

local function spawnJob(name: string, fn: (job: Job) -> ()): Job
	local job: Job = { co = coroutine.create(function() end), cpu = 0, sliceStart = 0, name = name }
	job.co = coroutine.create(function()
		fn(job)
	end)
	table.insert(jobs, job)
	return job
end

local function cpuMs(job: Job): number
	return (job.cpu + (os.clock() - job.sliceStart)) * 1000
end

local function runJobs(budget: number)
	if #jobs == 0 then
		return
	end
	deadline = os.clock() + budget
	local i = 1
	while i <= #jobs and os.clock() < deadline do
		local job = jobs[i]
		job.sliceStart = os.clock()
		local ok, err = coroutine.resume(job.co)
		job.cpu += os.clock() - job.sliceStart
		if not ok then
			reportError(job.name, tostring(err))
			table.remove(jobs, i)
		elseif coroutine.status(job.co) == "dead" then
			table.remove(jobs, i)
		else
			i += 1
		end
	end
end

----------------------------------------------------------------------------------------
-- UI
----------------------------------------------------------------------------------------

local FONT = Font.fromEnum(Enum.Font.GothamMedium)
local FONT_BOLD = Font.fromEnum(Enum.Font.GothamBold)

local function text(parent: Instance, content: string, size: number, pos: UDim2, dim: UDim2, bold: boolean?, color: Color3?): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.BorderSizePixel = 0
	l.FontFace = if bold then FONT_BOLD else FONT
	l.TextSize = size
	l.TextColor3 = color or Color3.fromRGB(226, 230, 245)
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextYAlignment = Enum.TextYAlignment.Top
	l.TextWrapped = true
	l.Text = content
	l.Position = pos
	l.Size = dim
	l.Parent = parent
	return l
end

local function round(inst: Instance, radius: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = inst
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "EditableImageGallery"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent = playerGui

local root = Instance.new("Frame")
root.Name = "Panels"
root.BackgroundColor3 = Color3.fromRGB(10, 12, 22)
root.BackgroundTransparency = 0.12
root.BorderSizePixel = 0
root.Position = UDim2.fromOffset(8, 8)
root.Size = UDim2.new(0, 650, 1, -16)
root.Parent = screenGui
round(root, 10)

text(root, "EditableImage Gallery", 24, UDim2.fromOffset(14, 8), UDim2.new(1, -28, 0, 30), true)
text(
	root,
	"Every picture here is an EditableImage drawn by Luau on this machine, no uploaded assets. Press G to hide.",
	13,
	UDim2.fromOffset(14, 38),
	UDim2.new(1, -28, 0, 30),
	false,
	Color3.fromRGB(150, 158, 190)
)

local scroller = Instance.new("ScrollingFrame")
scroller.BackgroundTransparency = 1
scroller.BorderSizePixel = 0
scroller.Position = UDim2.fromOffset(0, 72)
scroller.Size = UDim2.new(1, 0, 1, -72)
scroller.CanvasSize = UDim2.new()
scroller.AutomaticCanvasSize = Enum.AutomaticSize.Y
scroller.ScrollBarThickness = 8
scroller.Parent = root

local pad = Instance.new("UIPadding")
pad.PaddingLeft = UDim.new(0, 8)
pad.PaddingTop = UDim.new(0, 4)
pad.PaddingBottom = UDim.new(0, 12)
pad.Parent = scroller

local grid = Instance.new("UIGridLayout")
grid.CellSize = UDim2.fromOffset(300, 366)
grid.CellPadding = UDim2.fromOffset(10, 10)
grid.SortOrder = Enum.SortOrder.LayoutOrder
grid.Parent = scroller

local bannerLabel = text(
	screenGui,
	"",
	15,
	UDim2.new(0.5, -300, 0, 8),
	UDim2.fromOffset(600, 70),
	true,
	Color3.fromRGB(255, 200, 200)
)
bannerLabel.BackgroundTransparency = 0.1
bannerLabel.BackgroundColor3 = Color3.fromRGB(110, 20, 28)
bannerLabel.Visible = false
bannerLabel.ZIndex = 10
round(bannerLabel, 8)
banner = bannerLabel

local hud = text(screenGui, "", 13, UDim2.new(1, -348, 0, 8), UDim2.fromOffset(340, 112), false)
hud.BackgroundTransparency = 0.25
hud.BackgroundColor3 = Color3.fromRGB(8, 10, 18)
round(hud, 8)

UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
	if not processed and input.KeyCode == Enum.KeyCode.G then
		root.Visible = not root.Visible
	end
end)

type Card = { frame: Frame, body: Frame, info: TextLabel }

local function makeCard(order: number, title: string, subtitle: string): Card
	local frame = Instance.new("Frame")
	frame.Name = title
	frame.LayoutOrder = order
	frame.BackgroundColor3 = Color3.fromRGB(24, 28, 46)
	frame.BorderSizePixel = 0
	frame.Parent = scroller
	round(frame, 8)
	text(frame, title, 14, UDim2.fromOffset(8, 6), UDim2.new(1, -16, 0, 20), true)
	local body = Instance.new("Frame")
	body.BackgroundColor3 = Color3.fromRGB(12, 14, 24)
	body.BorderSizePixel = 0
	body.ClipsDescendants = true
	body.Position = UDim2.fromOffset(6, 28)
	body.Size = UDim2.fromOffset(288, 288)
	body.Parent = frame
	local sub = text(frame, subtitle, 11, UDim2.fromOffset(8, 319), UDim2.new(1, -16, 0, 24), false, Color3.fromRGB(150, 158, 190))
	sub.TextYAlignment = Enum.TextYAlignment.Top
	local info = text(frame, "queued...", 12, UDim2.fromOffset(8, 346), UDim2.new(1, -16, 0, 16), true, Color3.fromRGB(130, 220, 170))
	return { frame = frame, body = body, info = info }
end

local function imageLabel(parent: Instance, img: EditableImage?, size: UDim2, pos: UDim2?): ImageLabel
	local l = Instance.new("ImageLabel")
	l.BackgroundTransparency = 1
	l.BorderSizePixel = 0
	l.Size = size
	l.Position = pos or UDim2.new()
	if img then
		l.ImageContent = Content.fromObject(img)
	end
	l.Parent = parent
	return l
end

----------------------------------------------------------------------------------------
-- 3D: a cube that wears the same EditableImages as Decals
----------------------------------------------------------------------------------------

local cube = Instance.new("Part")
cube.Name = "GalleryCube"
cube.Size = Vector3.new(9, 9, 9)
cube.Anchored = true
cube.CanCollide = false
cube.Material = Enum.Material.SmoothPlastic
cube.Color = Color3.fromRGB(245, 245, 250)
cube.CFrame = CFrame.new(0, 9, -24)
cube.Parent = workspace

local function wear(face: Enum.NormalId, img: EditableImage?)
	if not img then
		return
	end
	local ok, err = try(function()
		local d = Instance.new("Decal")
		d.Face = face
		d.TextureContent = Content.fromObject(img)
		d.Parent = cube
	end)
	if not ok then
		reportError("cube decal " .. face.Name, tostring(err))
	end
end

----------------------------------------------------------------------------------------
-- Cards
----------------------------------------------------------------------------------------

local allanCard = makeCard(1, "ALLAN: a liquid network draws this", "A 15.9 KB model, not pixels: 16.5x smaller than raw RGBA. Against the original: 43.0 dB, worst error 12 of 255 (measured by the trainer). Decoded here, in Luau.")
local levelsCard = makeCard(2, "ALLAN: one model, any level", "Top: one 44.8 KB model at levels 0, 1, 2, no downsampling pass. Bottom right: a 3 KB model stored at 32 x 32, rendered at 64 x 64.")
local sceneCard = makeCard(3, "Vector badge  512 x 512", "Exact-area anti-aliased shapes. Tiles that no edge touches are copy-filled; only edge tiles run per-pixel math.")
local plasmaCard = makeCard(4, "Live plasma  192 x 192", "Rewritten every frame with WritePixelsBuffer: the compute and upload time below is measured here, live.")
local marbleCard = makeCard(5, "Procedural marble  256 x 256", "Deterministic fractal noise: every client computes the same bytes. Fills in as the scheduler allows.")
local mandelCard = makeCard(6, "Beyond 1024:  1152 x 1152 canvas", "Nine 384 x 384 tiles, each its own EditableImage. No single image may exceed 1024, the canvas does.")
local hardCard = makeCard(7, "LOD: hard switch", "Zooms in and out. At the midpoint it swaps the 64 px level for the 512 px level: watch the sharpness jump.")
local fadeCard = makeCard(8, "LOD: two-phase fade", "Same two images, same zoom. The fine level fades in over the coarse one, then the coarse one fades out beneath it.")
local greenCard = makeCard(9, "Green screen  256 x 256", "A portrait with 1 px hair strands and a glass bubble, plus sensor noise.")
local matteCard = makeCard(10, "Matte (alpha)  256 x 256", "Soft chroma key. The glass bubble comes out grey: partly transparent, not cut out.")
local cutCard = makeCard(11, "Cut-out on a new backdrop", "Foreground colour recovered by removing the green fringe, then composited over the sunset.")

----------------------------------------------------------------------------------------
-- Panel jobs
----------------------------------------------------------------------------------------

local sceneImg: EditableImage? = nil
local lowImg: EditableImage? = nil
local plasmaImg: EditableImage? = nil
local mandelImgs: { EditableImage } = {}

-- 1. badge, plus its 64 px level for the LOD cards
spawnJob("badge", function(job)
	local img = createImage(512, 512, "badge")
	if not img then
		sceneCard.info.Text = "could not create the image"
		return
	end
	sceneImg = img
	imageLabel(sceneCard.body, img, UDim2.fromOffset(288, 288))
	local buf = buffer.create(512 * 512 * 4)
	local edge, tiles = Panels.renderScene(buf, 512, 512, function(y0: number, y1: number)
		uploadRows(img, buf, 512, y0, y1)
		checkpoint()
	end)
	sceneCard.info.Text = string.format("rendered in %.0f ms CPU  |  %d of %d tiles needed math", cpuMs(job), edge, tiles)
	wear(Enum.NormalId.Front, img)

	local low = createImage(64, 64, "badge level 64")
	if low then
		lowImg = low
		local lbuf = buffer.create(64 * 64 * 4)
		Panels.renderScene(lbuf, 64, 64, nil)
		uploadRows(low, lbuf, 64, 0, 64)
		wear(Enum.NormalId.Bottom, low)
	end
end)

-- 2. plasma image (frames are drawn in the main loop)
do
	local img = createImage(192, 192, "plasma")
	if img then
		plasmaImg = img
		imageLabel(plasmaCard.body, img, UDim2.fromOffset(288, 288))
		wear(Enum.NormalId.Back, img)
	else
		plasmaCard.info.Text = "could not create the image"
	end
end

-- 3. marble
spawnJob("marble", function(job)
	local img = createImage(256, 256, "marble")
	if not img then
		marbleCard.info.Text = "could not create the image"
		return
	end
	imageLabel(marbleCard.body, img, UDim2.fromOffset(288, 288))
	local buf = buffer.create(256 * 256 * 4)
	Panels.renderMarble(buf, 256, 256, 1234, function(y0: number, y1: number)
		uploadRows(img, buf, 256, y0, y1)
		marbleCard.info.Text = string.format("%d%% drawn  |  %.0f ms CPU so far", y1 / 256 * 100, cpuMs(job))
		checkpoint()
	end)
	marbleCard.info.Text = string.format("rendered in %.0f ms CPU", cpuMs(job))
	wear(Enum.NormalId.Left, img)
end)

-- 7 to 9. green screen, matte, cut-out
spawnJob("green screen", function(job)
	local src = createImage(256, 256, "green screen")
	local matte = createImage(256, 256, "matte")
	local cut = createImage(256, 256, "cut-out")
	if not (src and matte and cut) then
		greenCard.info.Text = "could not create the images"
		return
	end
	imageLabel(greenCard.body, src, UDim2.fromOffset(288, 288))
	imageLabel(matteCard.body, matte, UDim2.fromOffset(288, 288))
	imageLabel(cutCard.body, cut, UDim2.fromOffset(288, 288))
	local gbuf = buffer.create(256 * 256 * 4)
	Panels.renderGreenScreen(gbuf, 256, 256, function(y0: number, y1: number)
		uploadRows(src, gbuf, 256, y0, y1)
		checkpoint()
	end)
	greenCard.info.Text = string.format("rendered in %.0f ms CPU", cpuMs(job))
	local mbuf = buffer.create(256 * 256 * 4)
	local cbuf = buffer.create(256 * 256 * 4)
	local before = cpuMs(job)
	Panels.keyMatte(gbuf, 256, 256, mbuf, cbuf, function(y0: number, y1: number)
		uploadRows(matte, mbuf, 256, y0, y1)
		uploadRows(cut, cbuf, 256, y0, y1)
		checkpoint()
	end)
	local took = string.format("matte + cut-out in %.0f ms CPU", cpuMs(job) - before)
	matteCard.info.Text = took
	cutCard.info.Text = took
	wear(Enum.NormalId.Top, cut)
end)

-- ALLAN: decode a model, render it in bands so the scheduler can spread the work over frames
local function allanFail(message: string)
	allanCard.info.Text = message
	levelsCard.info.Text = message
	reportError("ALLAN", message)
end

spawnJob("ALLAN", function(job)
	if not Liquid or not AlnModels then
		allanFail("ALLAN module did not load: " .. tostring(allanErr))
		return
	end
	-- renders one level of a model into an EditableImage, 32 output rows at a time
	local function render(plan: any, tree: any, level: number, img: EditableImage, w: number, h: number): any
		local out = buffer.create(w * h * 4)
		local stats = Liquid.newStats()
		for y0 = 0, h - 1, 32 do
			local rows = math.min(32, h - y0)
			Liquid.render(plan, tree, out, w, { level = level, x = 0, y = y0, w = w, h = rows, dy = y0, stats = stats })
			uploadRows(img, out, w, y0, y0 + rows)
			checkpoint()
		end
		return stats
	end
	local function load(name: string): (any, any, any)
		local model, tree = Liquid.decode(AlnModels.load(name))
		return model, tree, Liquid.prepare(model, tree, AlnModels.scale(name))
	end

	-- the logo, large
	local logoImg = createImage(256, 256, "ALLAN logo")
	if not logoImg then
		allanFail("could not create the image")
		return
	end
	imageLabel(allanCard.body, logoImg, UDim2.fromOffset(288, 288))
	local _, logoTree, logoPlan = load("sdf_logo_256")
	local before = cpuMs(job)
	local stats = render(logoPlan, logoTree, 0, logoImg, 256, 256)
	allanCard.info.Text = string.format(
		"%d B model vs %d B raw  |  %.0f ms CPU  |  %d events, %d rows",
		AlnModels.bytes("sdf_logo_256"),
		262144,
		cpuMs(job) - before,
		stats.segments,
		stats.rows
	)

	-- one UI model at levels 0, 1, 2, and the marble, in a 2 x 2 grid
	local cells = {
		{ name = "ui_flat_256", level = 0, size = 256, x = 0, y = 0, caption = "level 0  256 px" },
		{ name = "ui_flat_256", level = 1, size = 128, x = 144, y = 0, caption = "level 1  128 px" },
		{ name = "ui_flat_256", level = 2, size = 64, x = 0, y = 144, caption = "level 2  64 px" },
		{ name = "marble_64", level = 0, size = 64, x = 144, y = 144, caption = "marble  64 px" },
	}
	local total, done = 0, 0
	for _, cell in cells do
		local img = createImage(cell.size, cell.size, "ALLAN " .. cell.caption)
		if not img then
			levelsCard.info.Text = "out of editable memory at " .. cell.caption
			return
		end
		local l = imageLabel(levelsCard.body, img, UDim2.fromOffset(144, 144), UDim2.fromOffset(cell.x, cell.y))
		l.ZIndex = 1
		local cap = text(levelsCard.body, cell.caption, 11, UDim2.fromOffset(cell.x + 4, cell.y + 4), UDim2.fromOffset(136, 14), true, Color3.fromRGB(255, 255, 255))
		cap.BackgroundTransparency = 0.45
		cap.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		cap.AutomaticSize = Enum.AutomaticSize.X
		cap.Size = UDim2.fromOffset(0, 14)
		cap.ZIndex = 2
		local _, tree, plan = load(cell.name)
		local t0 = cpuMs(job)
		render(plan, tree, cell.level, img, cell.size, cell.size)
		total += cpuMs(job) - t0
		done += 1
		levelsCard.info.Text = string.format("%d of 4 images  |  %.0f ms CPU so far", done, total)
	end
	levelsCard.info.Text = string.format("4 images from 2 models (%d B + %d B)  |  %.0f ms CPU", AlnModels.bytes("ui_flat_256"), AlnModels.bytes("marble_64"), total)
end)

-- 4. nine tiles
local TILE, GRID = 384, 3
spawnJob("mandelbrot", function(job)
	local buf = buffer.create(TILE * TILE * 4)
	local labels: { ImageLabel } = {}
	for i = 0, GRID * GRID - 1 do
		local tx, ty = i % GRID, i // GRID
		local img = createImage(TILE, TILE, "mandelbrot tile " .. (i + 1))
		if not img then
			mandelCard.info.Text = string.format("tile %d: out of editable memory", i + 1)
			return
		end
		table.insert(mandelImgs, img)
		local shown = 288 // GRID
		labels[i + 1] = imageLabel(mandelCard.body, img, UDim2.fromOffset(shown, shown), UDim2.fromOffset(tx * shown, ty * shown))
		Panels.renderMandelbrotTile(buf, TILE, tx, ty, GRID, function(y0: number, y1: number)
			uploadRows(img, buf, TILE, y0, y1)
			mandelCard.info.Text = string.format("tile %d of %d  |  %.0f ms CPU so far", i + 1, GRID * GRID, cpuMs(job))
			checkpoint()
		end)
		if i == 4 then
			wear(Enum.NormalId.Right, img)
		end
	end
	mandelCard.info.Text = string.format("%d x %d px from %d images  |  %.0f ms CPU", TILE * GRID, TILE * GRID, GRID * GRID, cpuMs(job))
end)

----------------------------------------------------------------------------------------
-- LOD cards: two stacked labels per card, driven by the zoom size
----------------------------------------------------------------------------------------

local function lodStage(card: Card): (ImageLabel, ImageLabel)
	local coarse = imageLabel(card.body, nil, UDim2.fromOffset(36, 36))
	local fine = imageLabel(card.body, nil, UDim2.fromOffset(36, 36))
	for _, l in { coarse, fine } do
		l.AnchorPoint = Vector2.new(0.5, 0.5)
		l.Position = UDim2.fromScale(0.5, 0.5)
	end
	coarse.ZIndex = 1
	fine.ZIndex = 2
	return coarse, fine
end

local hardCoarse, hardFine = lodStage(hardCard)
local fadeCoarse, fadeFine = lodStage(fadeCard)
local lodBound = false

local function bindLod()
	if lodBound or not (sceneImg and lowImg) then
		return
	end
	lodBound = true
	for _, l in { hardCoarse, fadeCoarse } do
		l.ImageContent = Content.fromObject(lowImg :: EditableImage)
	end
	for _, l in { hardFine, fadeFine } do
		l.ImageContent = Content.fromObject(sceneImg :: EditableImage)
	end
end

local function updateLod(t: number)
	bindLod()
	local size = Panels.zoomSize(t)
	local f = Panels.lodBlend(size)
	local dim = UDim2.fromOffset(size, size)
	local hc, hf = Panels.hardSwitch(f)
	local fc, ff = Panels.twoPhase(f)
	hardCoarse.Size, hardFine.Size = dim, dim
	fadeCoarse.Size, fadeFine.Size = dim, dim
	hardCoarse.ImageTransparency, hardFine.ImageTransparency = hc, hf
	fadeCoarse.ImageTransparency, fadeFine.ImageTransparency = fc, ff
	hardCard.info.Text = string.format("shown at %3.0f px  |  %s level", size, if f < 0.5 then "64 px" else "512 px")
	fadeCard.info.Text = string.format("shown at %3.0f px  |  fine %2.0f%%  coarse %2.0f%%", size, (1 - ff) * 100, (1 - fc) * 100)
end

----------------------------------------------------------------------------------------
-- Main loop
----------------------------------------------------------------------------------------

local plasmaState = if plasmaImg then Panels.plasmaInit(192, 192) else nil
local plasmaBuf = buffer.create(192 * 192 * 4)
local plasmaFailed = false
local plasmaComputeMs, plasmaUploadMs = 0, 0
local fps, hudClock = 60, 0
local started = os.clock()

RunService.RenderStepped:Connect(function(dt: number)
	local now = os.clock()
	local t = now - started
	if dt > 0 then
		fps += (1 / dt - fps) * 0.08
	end

	-- live plasma: compute, then upload, each timed separately
	local pImg = plasmaImg
	if pImg and plasmaState and not plasmaFailed then
		local ok, err = try(function()
			local t0 = os.clock()
			Panels.plasmaFrame(plasmaState, plasmaBuf, t)
			local t1 = os.clock()
			pImg:WritePixelsBuffer(Vector2.zero, Vector2.new(192, 192), plasmaBuf)
			local t2 = os.clock()
			plasmaComputeMs += ((t1 - t0) * 1000 - plasmaComputeMs) * 0.1
			plasmaUploadMs += ((t2 - t1) * 1000 - plasmaUploadMs) * 0.1
		end)
		if not ok then
			plasmaFailed = true
			reportError("plasma frame", tostring(err))
		end
		plasmaCard.info.Text = string.format("compute %.2f ms  |  upload %.2f ms  per frame", plasmaComputeMs, plasmaUploadMs)
	end

	local okLod, errLod = try(function()
		updateLod(t)
	end)
	if not okLod then
		reportError("LOD", tostring(errLod))
	end

	cube.CFrame = CFrame.new(0, 9, -24) * CFrame.Angles(0.35, t * 0.6, 0.12)

	runJobs(0.008)

	hudClock += dt
	if hudClock > 0.25 then
		hudClock = 0
		local total, tex = 0, 0
		pcall(function()
			total = Stats:GetTotalMemoryUsageMb()
			tex = Stats:GetMemoryUsageMbForTag(Enum.DeveloperMemoryTag.GraphicsTexture)
		end)
		hud.Text = string.format(
			"FPS %.0f   frame %.1f ms\nEditableImages alive: %d  (%.2f Mpx, %.1f MB as RGBA)\nClient memory %.0f MB   GraphicsTexture %.0f MB\nPanels still drawing: %d   Errors: %d\nG: hide or show panels",
			fps,
			1000 / math.max(fps, 1),
			liveImages,
			livePixels / 1e6,
			livePixels * 4 / 1048576,
			total,
			tex,
			#jobs,
			#errors
		)
	end
end)
]]></string>
