        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Trace</string>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: compute/Trace
--
-- Sphere tracing a 3D signed distance field into 2D maps (docs/COMPUTE.md 3.10):
-- an orthographic view down -z gives, per pixel, the first hit, its normal (from
-- a 4-tap tetrahedral gradient) and its height. Outputs a tangent-space normal
-- map (RGB = 127.5 + 127.5 n, alpha 255 on hit, 0 on miss) and a u8 height map.
-- Impostors, bevels, embossed UI and procedural relief come from this; the
-- height map also feeds Filter.normalMap.
--
-- Determinism: + - * / sqrt abs only, a fixed step limit and epsilon, so every
-- client reproduces the same bytes. Cost: steps x SDF cost per pixel, so pixels
-- whose ray misses the object's bounding sphere are skipped in screen space
-- (one span fill per row), and the step loop stops at the bound's far side.

local Pixels = require("../Pixels")

local Trace = {}

export type Scene = {
	sdf: (number, number, number) -> number, -- Lipschitz <= 1
	cx: number, -- bounding sphere (pixels)
	cy: number,
	cz: number,
	br: number,
}

local sqrt, abs = math.sqrt, math.abs

local function smin(a: number, b: number, k: number): number
	local h = 0.5 + 0.5 * (b - a) / k
	h = if h < 0 then 0 elseif h > 1 then 1 else h
	return b + (a - b) * h - k * h * (1 - h)
end

-- Demo scene scaled to a size x size image: a sphere smoothly merged with a torus
-- lying in the image plane and a rounded slab. Units are pixels.
function Trace.demo(size: number): Scene
	local s = size / 256
	local cx, cy = size * 0.5, size * 0.5
	local R, tr, tt = 70 * s, 85 * s, 14 * s
	local function sdf(x: number, y: number, z: number): number
		local dx, dy, dz = x - cx, y - cy, z
		local sphere = sqrt(dx * dx + dy * dy + dz * dz) - R
		local q = sqrt(dx * dx + dy * dy) - tr
		local torus = sqrt(q * q + dz * dz) - tt
		-- rounded slab |x|, |y| <= 110 s, |z| <= 6 s, edge radius 4 s
		local bx = abs(dx) - 106 * s
		local by = abs(dy) - 106 * s
		local bz = abs(dz) - 2 * s
		local ox = if bx > 0 then bx else 0
		local oy = if by > 0 then by else 0
		local oz = if bz > 0 then bz else 0
		local m = if bx > by then bx else by
		if bz > m then
			m = bz
		end
		if m > 0 then
			m = 0
		end
		local slab = sqrt(ox * ox + oy * oy + oz * oz) + m - 4 * s
		return smin(smin(sphere, torus, 12 * s), slab, 8 * s)
	end
	return { sdf = sdf, cx = cx, cy = cy, cz = 0, br = 152 * s }
end

export type TraceStats = { rays: number, steps: number, hits: number }

-- Traces every pixel; writes the normal map into `normals` (RGBA8) and heights
-- (z of the hit, 0 at the bound's far side .. 255 at its near side) into `heights`
-- (u8). maxSteps bounds the work per ray; eps is the hit threshold in pixels.
function Trace.render(sc: Scene, size: number, normals: buffer, heights: buffer, maxSteps: number, eps: number): TraceStats
	local st: TraceStats = { rays = 0, steps = 0, hits = 0 }
	local f = sc.sdf
	local cx, cy, cz, br = sc.cx, sc.cy, sc.cz, sc.br
	local zBot = cz - br
	local hScale = 255 / (2 * br)
	local e = 0.5 -- gradient tap distance
	for y = 0, size - 1 do
		local py = y + 0.5
		local row = y * size
		local dy = py - cy
		local hw2 = br * br - dy * dy
		if hw2 <= 0 then
			Pixels.fillSpan(normals, row * 4, size, 0x00FF8080)
			buffer.fill(heights, row, 0, size)
			continue
		end
		local hw = sqrt(hw2)
		local xa = math.max(0, math.floor(cx - hw - 0.5))
		local xb = math.min(size - 1, math.ceil(cx + hw - 0.5))
		Pixels.fillSpan(normals, row * 4, xa, 0x00FF8080)
		Pixels.fillSpan(normals, (row + xb + 1) * 4, size - 1 - xb, 0x00FF8080)
		buffer.fill(heights, row, 0, size)
		for x = xa, xb do
			local px = x + 0.5
			st.rays += 1
			-- enter the bounding sphere at its near surface
			local dx = px - cx
			local inside = br * br - dx * dx - dy * dy
			local o = (row + x) * 4
			if inside <= 0 then
				buffer.writeu32(normals, o, 0x00FF8080)
				continue
			end
			local z = cz + sqrt(inside)
			local zEnd = cz - sqrt(inside)
			local hit = false
			for _ = 1, maxSteps do
				local d = f(px, py, z)
				st.steps += 1
				if d < eps then
					hit = true
					break
				end
				z -= d
				if z < zEnd then
					break
				end
			end
			if not hit then
				buffer.writeu32(normals, o, 0x00FF8080)
				continue
			end
			st.hits += 1
			-- tetrahedral gradient: k1 = (1,-1,-1), k2 = (-1,-1,1), k3 = (-1,1,-1), k4 = (1,1,1)
			local f1 = f(px + e, py - e, z - e)
			local f2 = f(px - e, py - e, z + e)
			local f3 = f(px - e, py + e, z - e)
			local f4 = f(px + e, py + e, z + e)
			local gx = f1 - f2 - f3 + f4
			local gy = -f1 - f2 + f3 + f4
			local gz = -f1 + f2 - f3 + f4
			local inv = 1 / sqrt(gx * gx + gy * gy + gz * gz)
			local nx, ny, nz = gx * inv, gy * inv, gz * inv
			buffer.writeu32(
				normals,
				o,
				((nx + 1) * 127.5 + 0.5) // 1 + (((ny + 1) * 127.5 + 0.5) // 1) * 256 + (((nz + 1) * 127.5 + 0.5) // 1) * 65536 + 0xFF000000
			)
			local hv = (z - zBot) * hScale
			hv = if hv < 0 then 0 elseif hv > 255 then 255 else hv
			buffer.writeu8(heights, row + x, (hv + 0.5) // 1)
		end
	end
	return st
end

-- Simple Lambert shading of a normal map (light direction l normalised by the
-- caller), for previews: rgb = albedo * max(0, n . l), alpha kept.
function Trace.shade(normals: buffer, count: number, lx: number, ly: number, lz: number, albedo: number, out: buffer)
	local ar, ag, ab = albedo % 256, (albedo // 256) % 256, (albedo // 65536) % 256
	for i = 0, count - 1 do
		local p = buffer.readu32(normals, i * 4)
		local a = p // 16777216
		if a == 0 then
			buffer.writeu32(out, i * 4, 0)
			continue
		end
		local nx = (p % 256) / 127.5 - 1
		local ny = ((p // 256) % 256) / 127.5 - 1
		local nz = ((p // 65536) % 256) / 127.5 - 1
		local l = nx * lx + ny * ly + nz * lz
		if l < 0 then
			l = 0
		end
		buffer.writeu32(out, i * 4, ((ar * l + 0.5) // 1) + ((ag * l + 0.5) // 1) * 256 + ((ab * l + 0.5) // 1) * 65536 + a * 16777216)
	end
end

return Trace
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">Visibility</string>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- universe-at-home :: compute/Visibility
--
-- Exact visibility for "conflict pixels": pixels where the edges of two or more
-- shapes enter (docs/COMPUTE.md F2 and C11). Elsewhere coverage-as-alpha is exact
-- (proof in the "Flawless pipeline" section of docs/COMPUTE.md); here it is not,
-- because the shapes' coverage regions inside the pixel are correlated (abutting
-- shapes are perfectly anti-correlated: two exact halves composite to 3/4, a
-- 64/255 seam). This module computes the exact box filter of the source-over
-- composite of a pixel's shape stack instead. (Raster and Scanline.renderScene
-- first try the cheaper exact formula for pairwise disjoint partial shapes, C19 in
-- docs/COMPUTE.md 12.2; this module handles everything else.)
--
-- Method (signed convex terms). In pixel-local coordinates (pixel = the square
-- [-1/2, 1/2]^2), every shape's indicator inside the pixel is written as a signed
-- sum of CONVEX PIECES, sum_j sigma_j 1[K_j], each piece = (convex polygon inside
-- the square) intersected with at most one disc. Disc complements and non-convex
-- polygons are expressed through the signs (ring = outer disc - inner disc,
-- polygon = signed fan of triangles of its clip to the pixel). The stack is
-- processed top-down while maintaining the transmittance
--     nu(q) = prod over shapes t above (1 - alpha_t I_t(q))
-- as a signed weighted sum of terms, sum_k w_k 1[R_k], with every region R_k an
-- intersection of pieces (convex polygon and a set of discs). Shape s contributes
--     alpha_s c_s * integral(I_s nu) = alpha_s c_s * sum_k sum_j w_k sigma_j |R_k ^ K_j|
-- and updates nu <- nu - alpha_s I_s nu, which appends the terms (R_k ^ K_j,
-- -alpha_s sigma_j w_k). A shape that covers the whole pixel (I_s = 1) contributes
-- alpha_s c_s integral(nu) and scales every weight by (1 - alpha_s). The base below
-- the stack contributes alpha_0 c_0 integral(nu). The result is the premultiplied
-- integral of the exact composite over the pixel; dividing by the alpha integral
-- gives straight alpha.
--
-- Exact areas: |R| for R = (convex polygon) ^ D_1 ^ ... ^ D_k. The polygon part is
-- a Sutherland-Hodgman clip (exact up to rounding). With k = 1 the area is
-- Coverage.discPolyArea; with k >= 2 the POWER-CELL LEMMA reduces it to k single
-- disc areas: with power functions p_i(q) = |q - c_i|^2 - r_i^2, on the cell where
-- p_i is the largest the intersection of all discs is {p_i <= 0} = D_i, and every
-- cell {p_i >= p_j for all j} is convex (p_i - p_j is affine), so
--     |P ^ D_1 ^ ... ^ D_k| = sum_i |P ^ cell_i ^ D_i|.
-- Identical discs (zero normal, zero offset) are tie-broken by index.
--
-- Abutting shapes: complementary pieces (a shared edge with opposite inner sides)
-- intersect in a zero-area sliver, so they never double count; no tolerance or
-- snapping is involved. Terms with zero area are pruned, so k mutually disjoint
-- shapes cost O(k^2) clips, while k mutually overlapping fractional shapes can
-- need up to 2^k terms: the term list is capped at MAX_TERMS (stats.capped counts
-- pixels where the cap bound; none in any measured scene).
--
-- Usage per pixel (allocation-free after warm-up; module-level scratch):
--   Visibility.reset()
--   for each shape from the TOP of the stack down to just above the base:
--     Visibility.full(r, g, b, a)                  -- covers the whole pixel
--     or Visibility.begin(r, g, b, a)               -- partly covers it, then pieces:
--          Visibility.square(sign) / rect(sign, x0, y0, x1, y1) / poly(sign, xs, ys, n)
--          Visibility.clip(nx, ny, c)               -- keep {nx x + ny y <= c}
--          Visibility.disc(cx, cy, r)               -- intersect with a disc
--          Visibility.piece()                       -- store the piece
--        Visibility.commit()
--   r, g, b, a = Visibility.finish(baseR, baseG, baseB, baseA)   -- straight alpha
-- Colours are 0..255 floats, alphas 0..1. Deterministic ops only (+ - * / sqrt,
-- comparisons, and Coverage.dasin through the disc areas).

local Coverage = require("./Coverage")

local Visibility = {}

local clipInto = Coverage.clipInto
local polyArea = Coverage.polyArea
local discPolyArea = Coverage.discPolyArea

local MAX_TERMS = 1024
Visibility.MAX_TERMS = MAX_TERMS

export type Stats = { pixels: number, terms: number, areas: number, capped: number }
local stats: Stats = { pixels = 0, terms = 0, areas = 0, capped = 0 }
Visibility.stats = stats

function Visibility.resetStats()
	stats.pixels, stats.terms, stats.areas, stats.capped = 0, 0, 0, 0
end

-- pieces of the current entry
local PS: { number } = table.create(32, 0) -- sign
local PV0: { number } = table.create(32, 0) -- first vertex in PX, PY
local PN: { number } = table.create(32, 0) -- vertex count
local PD: { number } = table.create(32, 0) -- 1: has a disc
local PDX: { number } = table.create(32, 0)
local PDY: { number } = table.create(32, 0)
local PDR: { number } = table.create(32, 0)
local PX: { number } = table.create(512, 0)
local PY: { number } = table.create(512, 0)
local nP, nPV = 0, 0

-- terms of nu
local TW: { number } = table.create(256, 0) -- weight
local TA: { number } = table.create(256, 0) -- area
local TV0: { number } = table.create(256, 0)
local TN: { number } = table.create(256, 0)
local TD0: { number } = table.create(256, 0)
local TND: { number } = table.create(256, 0)
local TX: { number } = table.create(2048, 0)
local TY: { number } = table.create(2048, 0)
local TDX: { number } = table.create(512, 0)
local TDY: { number } = table.create(512, 0)
local TDR: { number } = table.create(512, 0)
local nT, nTV, nTD = 0, 0, 0

local accR, accG, accB, accA = 0, 0, 0, 0
local eR, eG, eB, eA = 0, 0, 0, 0

-- piece under construction (ping-pong clip buffers)
local AX: { number } = table.create(64, 0)
local AY: { number } = table.create(64, 0)
local BX: { number } = table.create(64, 0)
local BY: { number } = table.create(64, 0)
local cur = 0 -- 0: current polygon in A, 1: in B
local wn = 0
local wSign, wDisc, wDX, wDY, wDR = 0, 0, 0, 0, 0

-- region measurement scratch
local VX: { number } = table.create(64, 0)
local VY: { number } = table.create(64, 0)
local UX: { number } = table.create(64, 0)
local UY: { number } = table.create(64, 0)
local CX: { number } = table.create(64, 0)
local CY: { number } = table.create(64, 0)
local DX2: { number } = table.create(64, 0)
local DY2: { number } = table.create(64, 0)
local KX: { number } = table.create(16, 0)
local KY: { number } = table.create(16, 0)
local KR: { number } = table.create(16, 0)

function Visibility.reset()
	stats.pixels += 1
	-- one term: the whole pixel, weight 1, area 1, no discs
	TX[1], TY[1] = -0.5, -0.5
	TX[2], TY[2] = 0.5, -0.5
	TX[3], TY[3] = 0.5, 0.5
	TX[4], TY[4] = -0.5, 0.5
	TW[1], TA[1], TV0[1], TN[1], TD0[1], TND[1] = 1, 1, 1, 4, 1, 0
	nT, nTV, nTD = 1, 4, 0
	accR, accG, accB, accA = 0, 0, 0, 0
end

-- A shape that covers the whole pixel with straight colour (r, g, b), alpha a < 1.
function Visibility.full(r: number, g: number, b: number, a: number)
	local W = 0
	for t = 1, nT do
		W += TW[t] * TA[t]
	end
	local k = a * W
	accR += r * k
	accG += g * k
	accB += b * k
	accA += k
	local f = 1 - a
	for t = 1, nT do
		TW[t] *= f
	end
end

-- Starts a shape that covers the pixel partly; its pieces follow. area (optional):
-- the shape's exact area in the pixel, already known to the caller (its F1
-- coverage); when the shape turns out to be one positive piece, that is its
-- intersection with the whole-pixel term and is not recomputed.
local eArea = -1
function Visibility.begin(r: number, g: number, b: number, a: number, area: number?)
	eR, eG, eB, eA = r, g, b, a
	nP, nPV = 0, 0
	eArea = area or -1
end

-- Piece construction ---------------------------------------------------------------

-- Starts a piece equal to the whole pixel square.
function Visibility.square(sign: number)
	AX[1], AY[1] = -0.5, -0.5
	AX[2], AY[2] = 0.5, -0.5
	AX[3], AY[3] = 0.5, 0.5
	AX[4], AY[4] = -0.5, 0.5
	cur, wn = 0, 4
	wSign, wDisc = sign, 0
end

-- Starts a piece equal to the rectangle [x0, x1] x [y0, y1] clipped to the pixel.
function Visibility.rect(sign: number, x0: number, y0: number, x1: number, y1: number)
	if x0 < -0.5 then
		x0 = -0.5
	end
	if y0 < -0.5 then
		y0 = -0.5
	end
	if x1 > 0.5 then
		x1 = 0.5
	end
	if y1 > 0.5 then
		y1 = 0.5
	end
	wSign, wDisc, cur = sign, 0, 0
	if x1 <= x0 or y1 <= y0 then
		wn = 0
		return
	end
	AX[1], AY[1] = x0, y0
	AX[2], AY[2] = x1, y0
	AX[3], AY[3] = x1, y1
	AX[4], AY[4] = x0, y1
	wn = 4
end

-- Starts a piece equal to the convex polygon xs, ys [1..n] (positive orientation:
-- every edge has the interior on its left), which must lie inside the pixel.
function Visibility.poly(sign: number, xs: { number }, ys: { number }, n: number)
	for i = 1, n do
		AX[i], AY[i] = xs[i], ys[i]
	end
	cur, wn = 0, n
	wSign, wDisc = sign, 0
end

-- Clips the piece under construction to {nx x + ny y <= c}.
function Visibility.clip(nx: number, ny: number, c: number)
	if wn < 3 then
		wn = 0
		return
	end
	if cur == 0 then
		wn = clipInto(AX, AY, wn, BX, BY, nx, ny, c)
		cur = 1
	else
		wn = clipInto(BX, BY, wn, AX, AY, nx, ny, c)
		cur = 0
	end
end

-- Intersects the piece under construction with the disc (cx, cy, r).
function Visibility.disc(cx: number, cy: number, r: number)
	wDisc, wDX, wDY, wDR = 1, cx, cy, r
end

-- Stores the piece under construction (dropped when its polygon is empty).
function Visibility.piece()
	if wn < 3 then
		return
	end
	local X, Y = AX, AY
	if cur == 1 then
		X, Y = BX, BY
	end
	if polyArea(X, Y, wn) <= 0 then
		return
	end
	nP += 1
	PS[nP] = wSign
	PV0[nP] = nPV + 1
	PN[nP] = wn
	for i = 1, wn do
		PX[nPV + i], PY[nPV + i] = X[i], Y[i]
	end
	nPV += wn
	PD[nP] = wDisc
	PDX[nP], PDY[nP], PDR[nP] = wDX, wDY, wDR
end

-- Pieces of one closed polygon contour (pixel-local coordinates, any size; it is
-- clipped to the pixel here) whose signed winding number, times sigma, is its
-- contribution to the shape's indicator (sigma = the shape's orientation, so a
-- simple polygon of either orientation, or a path whose holes wind the other way,
-- contributes exactly 1 inside). A convex clip becomes one piece; otherwise the
-- winding number of the clip is the sum of its fan triangles' signed indicators.
local GX: { number } = table.create(64, 0)
local GY: { number } = table.create(64, 0)
local HX: { number } = table.create(64, 0)
local HY: { number } = table.create(64, 0)
local TRX: { number } = table.create(3, 0)
local TRY: { number } = table.create(3, 0)

function Visibility.polygon(xs: { number }, ys: { number }, n: number, sigma: number)
	local m = clipInto(xs, ys, n, HX, HY, 1, 0, 0.5)
	m = clipInto(HX, HY, m, GX, GY, -1, 0, 0.5)
	m = clipInto(GX, GY, m, HX, HY, 0, 1, 0.5)
	m = clipInto(HX, HY, m, GX, GY, 0, -1, 0.5)
	if m < 3 then
		return
	end
	local A = polyArea(GX, GY, m)
	if A == 0 then
		return
	end
	local sg = sigma
	if A < 0 then
		-- reverse to positive orientation; the winding inside the clip is then +1
		sg = -sigma
		local i, j = 1, m
		while i < j do
			GX[i], GX[j] = GX[j], GX[i]
			GY[i], GY[j] = GY[j], GY[i]
			i += 1
			j -= 1
		end
	end
	local convex = true
	local ax, ay = GX[m - 1], GY[m - 1]
	local bx, by = GX[m], GY[m]
	for i = 1, m do
		local cx, cy = GX[i], GY[i]
		if (bx - ax) * (cy - by) - (by - ay) * (cx - bx) < -1e-12 then
			convex = false
			break
		end
		ax, ay, bx, by = bx, by, cx, cy
	end
	if convex then
		Visibility.poly(sg, GX, GY, m)
		Visibility.piece()
		return
	end
	-- winding number of the closed clip = sum of signed fan triangles
	local x0, y0 = GX[1], GY[1]
	for i = 2, m - 1 do
		local x1, y1, x2, y2 = GX[i], GY[i], GX[i + 1], GY[i + 1]
		local t = (x1 - x0) * (y2 - y0) - (y1 - y0) * (x2 - x0)
		if t > 0 then
			TRX[1], TRY[1], TRX[2], TRY[2], TRX[3], TRY[3] = x0, y0, x1, y1, x2, y2
			Visibility.poly(sg, TRX, TRY, 3)
			Visibility.piece()
		elseif t < 0 then
			TRX[1], TRY[1], TRX[2], TRY[2], TRX[3], TRY[3] = x0, y0, x2, y2, x1, y1
			Visibility.poly(-sg, TRX, TRY, 3)
			Visibility.piece()
		end
	end
end

-- Region areas ---------------------------------------------------------------------

-- Area of polygon (px, py)[1..m] intersected with discs K[1..k] (power cells), and
-- the number of discs kept in K[1..]. Discs that contain the (convex) polygon are
-- dropped first (they do not change the region) and a disc that misses its
-- bounding box makes the area 0, so most regions need one disc area or none.
local function regionArea(px: { number }, py: { number }, m: number, k: number): (number, number)
	stats.areas += 1
	if k > 0 then
		local x0, y0, x1, y1 = px[1], py[1], px[1], py[1]
		for v = 2, m do
			local x, y = px[v], py[v]
			if x < x0 then
				x0 = x
			elseif x > x1 then
				x1 = x
			end
			if y < y0 then
				y0 = y
			elseif y > y1 then
				y1 = y
			end
		end
		local k2 = 0
		for i = 1, k do
			local cx, cy, r = KX[i], KY[i], KR[i]
			if cx - r >= x1 or cx + r <= x0 or cy - r >= y1 or cy + r <= y0 then
				return 0, 0
			end
			local r2 = r * r
			local all = true
			for v = 1, m do
				local dx, dy = px[v] - cx, py[v] - cy
				if dx * dx + dy * dy > r2 then
					all = false
					break
				end
			end
			if not all then
				k2 += 1
				KX[k2], KY[k2], KR[k2] = cx, cy, r
			end
		end
		k = k2
	end
	if k == 0 then
		return polyArea(px, py, m), 0
	elseif k == 1 then
		if m == 4 and ((px[1] == px[4] and px[2] == px[3] and py[1] == py[2] and py[3] == py[4]) or (px[1] == px[2] and px[3] == px[4] and py[2] == py[3] and py[4] == py[1])) then
			-- an axis-aligned rectangle (the pixel, a box piece): quadrant integration
			local x0 = if px[1] < px[3] then px[1] else px[3]
			local x1 = if px[1] < px[3] then px[3] else px[1]
			local y0 = if py[1] < py[3] then py[1] else py[3]
			local y1 = if py[1] < py[3] then py[3] else py[1]
			return Coverage.discBoxArea(KX[1], KY[1], KR[1], x0, y0, x1, y1), 1
		end
		return discPolyArea(px, py, m, KX[1], KY[1], KR[1]), 1
	end
	local total = 0
	for i = 1, k do
		local xi, yi, ri = KX[i], KY[i], KR[i]
		local powi = xi * xi + yi * yi - ri * ri
		for v = 1, m do
			CX[v], CY[v] = px[v], py[v]
		end
		local n = m
		local inC = true -- current cell polygon is in CX/CY (else DX2/DY2)
		local empty = false
		for j = 1, k do
			if j ~= i then
				local xj, yj, rj = KX[j], KY[j], KR[j]
				-- p_i >= p_j  <=>  2 (c_i - c_j) . q <= (|c_i|^2 - r_i^2) - (|c_j|^2 - r_j^2)
				local nx, ny = 2 * (xi - xj), 2 * (yi - yj)
				local c = powi - (xj * xj + yj * yj - rj * rj)
				if nx == 0 and ny == 0 then
					if not (c > 0 or (c == 0 and j > i)) then
						empty = true
						break
					end
				else
					if inC then
						n = clipInto(CX, CY, n, DX2, DY2, nx, ny, c)
					else
						n = clipInto(DX2, DY2, n, CX, CY, nx, ny, c)
					end
					inC = not inC
					if n < 3 then
						empty = true
						break
					end
				end
			end
		end
		if not empty then
			if inC then
				total += discPolyArea(CX, CY, n, xi, yi, ri)
			else
				total += discPolyArea(DX2, DY2, n, xi, yi, ri)
			end
		end
	end
	return total, k
end

-- Processes the shape begun with Visibility.begin against every current term.
function Visibility.commit()
	local nOld = nT
	local contrib = 0
	for t = 1, nOld do
		local wt = TW[t]
		if wt == 0 then
			continue
		end
		for p = 1, nP do
			-- polygon of term t intersected with piece p (both convex)
			local X, Y = VX, VY
			local m
			local p0, pn = PV0[p], PN[p]
			if t == 1 then
				-- term 1 is the whole pixel; pieces already lie inside it
				for v = 1, pn do
					VX[v], VY[v] = PX[p0 + v - 1], PY[p0 + v - 1]
				end
				m = pn
			else
				local t0 = TV0[t]
				m = TN[t]
				for v = 1, m do
					VX[v], VY[v] = TX[t0 + v - 1], TY[t0 + v - 1]
				end
				local qx, qy = PX[p0 + pn - 1], PY[p0 + pn - 1]
				for v = 0, pn - 1 do
					local rx, ry = PX[p0 + v], PY[p0 + v]
					local ex, ey = rx - qx, ry - qy
					-- interior on the left: cross(e, q - P) >= 0  <=>  ey x - ex y <= ey Px - ex Py
					local c = ey * qx - ex * qy
					if X == VX then
						m = clipInto(VX, VY, m, UX, UY, ey, -ex, c)
						X, Y = UX, UY
					else
						m = clipInto(UX, UY, m, VX, VY, ey, -ex, c)
						X, Y = VX, VY
					end
					if m < 3 then
						break
					end
					qx, qy = rx, ry
				end
			end
			if m < 3 then
				continue
			end
			-- discs of the region: the term's and the piece's
			local k = 0
			local d0 = TD0[t]
			for i = d0, d0 + TND[t] - 1 do
				k += 1
				KX[k], KY[k], KR[k] = TDX[i], TDY[i], TDR[i]
			end
			if PD[p] == 1 then
				k += 1
				KX[k], KY[k], KR[k] = PDX[p], PDY[p], PDR[p]
			end
			local a
			if t == 1 and nP == 1 and PS[1] == 1 and eArea >= 0 then
				a = eArea
			else
				local kept
				a, kept = regionArea(X, Y, m, k)
				k = kept
			end
			if a <= 0 then
				continue
			end
			local sw = PS[p] * wt
			contrib += sw * a
			if nT >= MAX_TERMS then
				stats.capped += 1
				continue
			end
			nT += 1
			stats.terms += 1
			TW[nT] = -eA * sw
			TA[nT] = a
			TV0[nT] = nTV + 1
			TN[nT] = m
			for v = 1, m do
				TX[nTV + v], TY[nTV + v] = X[v], Y[v]
			end
			nTV += m
			TD0[nT] = nTD + 1
			TND[nT] = k
			for i = 1, k do
				TDX[nTD + i], TDY[nTD + i], TDR[nTD + i] = KX[i], KY[i], KR[i]
			end
			nTD += k
		end
	end
	local f = eA * contrib
	accR += eR * f
	accG += eG * f
	accB += eB * f
	accA += f
end

-- Adds the base below the stack (straight colour, alpha) and returns the exact
-- composite in straight alpha: r, g, b in 0..255, a in 0..1.
function Visibility.finish(r: number, g: number, b: number, a: number): (number, number, number, number)
	local W = 0
	for t = 1, nT do
		W += TW[t] * TA[t]
	end
	local k = a * W
	local R, G, B, A = accR + r * k, accG + g * k, accB + b * k, accA + k
	if A <= 0 then
		return r, g, b, 0
	end
	return R / A, G / A, B / A, if A > 1 then 1 else A
end

-- The premultiplied integrals accumulated so far (for tests): r, g, b, a.
function Visibility.accumulated(): (number, number, number, number)
	return accR, accG, accB, accA
end

return Visibility
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="47">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="48">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="49">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">CloudLayer</string>
            <string name="Source"><![CDATA[--!strict
-- Universe at Home: Planets :: CloudLayer
--
-- Terra's clouds as one rotating shell: a cube-sphere of six 16 x 16 grids at 14 studs
-- above sea level, textured from a 1024 x 512 atlas of six 256 px faces (Clouds.face, same
-- texel-centre rule as the surface atlas, so the faces meet without seams). The texture's
-- alpha is the cloud cover; the part is double-sided so the clouds are seen from below.
-- The shell rotates about the planet's axis; the impostor samples the same field rotated
-- by the same angle, so clouds match across the mesh/impostor crossfade.

local AssetService = game:GetService("AssetService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Planets = ReplicatedStorage:WaitForChild("Planets")
local Layout = require(Planets:WaitForChild("Layout")) :: any
local CubeSphere = require(Planets:WaitForChild("CubeSphere")) :: any
local Clouds = require(Planets:WaitForChild("Clouds")) :: any
local WorkerPool = require(Planets:WaitForChild("WorkerPool")) :: any
local MeshPool = require(script.Parent:WaitForChild("MeshPool"))
local Uploader = require(script.Parent:WaitForChild("Uploader"))

local CloudLayer = {}

export type Layer = {
	img: EditableImage,
	part: MeshPart?,
	radius: number,
	angle: number,
	pixels: number,
	note: string,
}

local SPIN = 0.0035 -- radians per second

function CloudLayer.new(U: Uploader.Uploader, workers: any, folder: Instance, body: any): (Layer?, string?)
	local W, H, T, span = Layout.CLOUD_ATLAS_W, Layout.CLOUD_ATLAS_H, Layout.CLOUD_TILE, Layout.CLOUD_SPAN
	local img, err = MeshPool.createImage(W, H)
	if not img then
		return nil, "cloud atlas: " .. tostring(err)
	end
	local entry = Uploader.register(U, "cloud atlas", img)
	for f = 1, 6 do
		local tx, ty = Clouds.tileOf(f)
		WorkerPool.submit(workers, "cloudFace", { face = f }, function(ok: boolean, buf: any)
			if ok then
				Uploader.queue(U, entry, tx * T, ty * T, T, T, buf)
			end
		end)
	end
	local layer: Layer = { img = img, part = nil, radius = body.radius + 14, angle = 0, pixels = W * H, note = "building" }
	-- the shell mesh
	local G = Layout.CLOUD_GRID
	local mesh = AssetService:CreateEditableMesh()
	if not mesh then
		layer.note = "CreateEditableMesh returned nil (editable memory budget)"
		return layer, nil
	end
	local positions: { Vector3 } = {}
	local uvs: { Vector2 } = {}
	local faces: { { number } } = {}
	local Rc = layer.radius
	for f = 1, 6 do
		local tx, ty = Clouds.tileOf(f)
		local base = #positions
		for vj = 0, G do
			for vi = 0, G do
				local a, b = vi / G, vj / G
				local x, y, z = CubeSphere.facePoint(f, a, b)
				table.insert(positions, Vector3.new(x, y, z) * Rc)
				table.insert(uvs, Vector2.new((tx * T + Layout.GUTTER + 0.5 + a * span) / W, (ty * T + Layout.GUTTER + 0.5 + b * span) / H))
			end
		end
		for vj = 0, G - 1 do
			for vi = 0, G - 1 do
				local p = base + vj * (G + 1) + vi + 1
				local q, r, s = p + 1, p + G + 2, p + G + 1
				table.insert(faces, { p, q, r })
				table.insert(faces, { p, r, s })
			end
		end
	end
	-- pins centre the bounding box on the planet (see MeshPool)
	local P = Rc + 30
	local pinBase = #positions
	for _, v in { Vector3.new(P, P, P), Vector3.new(P - 0.01, P, P), Vector3.new(P, P - 0.01, P), Vector3.new(-P, -P, -P), Vector3.new(-P + 0.01, -P, -P), Vector3.new(-P, -P + 0.01, -P) } do
		table.insert(positions, v)
		table.insert(uvs, Vector2.new(0, 0))
	end
	table.insert(faces, { pinBase + 1, pinBase + 2, pinBase + 3 })
	table.insert(faces, { pinBase + 4, pinBase + 5, pinBase + 6 })
	local ok, buildErr = pcall(function()
		local vIds = mesh:BatchAdd(Enum.MeshAttribute.Vertex, positions) :: { number }
		local uvIds = mesh:BatchAdd(Enum.MeshAttribute.UV, uvs) :: { number }
		local fl = table.create(#faces)
		local fu = table.create(#faces)
		for i, fc in faces do
			fl[i] = { vIds[fc[1]], vIds[fc[2]], vIds[fc[3]] }
			fu[i] = { uvIds[fc[1]], uvIds[fc[2]], uvIds[fc[3]] }
		end
		local fIds = mesh:BatchAdd(Enum.MeshAttribute.Face, fl) :: { number }
		mesh:BatchSetFaceAttributes(fIds, fu)
	end)
	if not ok then
		-- per-element fallback
		mesh:Destroy()
		local m2 = AssetService:CreateEditableMesh()
		if not m2 then
			layer.note = "cloud mesh: " .. tostring(buildErr)
			return layer, nil
		end
		mesh = m2
		local vIds, uvIds = {}, {}
		for i, p in positions do
			vIds[i] = m2:AddVertex(p)
			uvIds[i] = m2:AddUV(uvs[i])
		end
		for _, fc in faces do
			local id = m2:AddTriangle(vIds[fc[1]], vIds[fc[2]], vIds[fc[3]])
			m2:SetFaceUVs(id, { uvIds[fc[1]], uvIds[fc[2]], uvIds[fc[3]] })
		end
	end
	local partOk, part = pcall(function()
		return AssetService:CreateMeshPartAsync(Content.fromObject(mesh), {
			CollisionFidelity = Enum.CollisionFidelity.Box,
			RenderFidelity = Enum.RenderFidelity.Precise,
		})
	end)
	if not partOk or not part then
		layer.note = "cloud part: " .. tostring(part)
		return layer, nil
	end
	local mp = part :: MeshPart
	mp.Name = "Clouds"
	mp.Anchored = true
	mp.CanCollide = false
	mp.CanQuery = false
	mp.CanTouch = false
	mp.CastShadow = false
	mp.DoubleSided = true
	mp.Material = Enum.Material.SmoothPlastic
	mp.Color = Color3.new(1, 1, 1)
	mp.Transparency = 1
	mp.TextureContent = Content.fromObject(img)
	mp.CFrame = CFrame.new(body.px, body.py, body.pz)
	mp.Parent = folder
	layer.part = mp
	layer.note = "cloud shell at +14 studs, 1024 x 512 atlas"
	return layer, nil
end

-- Per frame: spin, and fade with the planet's mesh.
function CloudLayer.update(layer: Layer, body: any, dt: number, alpha: number, enabled: boolean)
	layer.angle = (layer.angle + SPIN * dt) % (2 * math.pi)
	local part = layer.part
	if part then
		part.CFrame = CFrame.new(body.px, body.py, body.pz) * CFrame.Angles(0, layer.angle, 0)
		part.Transparency = if enabled then 1 - alpha else 1
	end
end

return CloudLayer
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">Flight</string>
            <string name="Source"><![CDATA[--!strict
-- Universe at Home: Planets :: Flight
--
-- A free-flight camera for planetary scales.
--   mouse     hold the right button to look around
--   W A S D   move; E / Space up, Q / C down (relative to the view)
--   Shift     boost x5; mouse wheel changes the base speed
-- Speed scales with the altitude above the nearest body's actual terrain, so the same
-- keys cross an orbit in seconds and creep over a ridge. "Up" is the nearest body's
-- radial direction, so the horizon stays level anywhere on a sphere. The camera never
-- goes below 1.5 studs above the terrain under it (heights come from the same body
-- functions the patches use).

local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Planets = ReplicatedStorage:WaitForChild("Planets")
local Bodies = require(Planets:WaitForChild("Bodies")) :: any

local Flight = {}

export type Flight = {
	cam: Camera,
	pos: Vector3,
	look: Vector3,
	speedScale: number,
	looking: boolean,
	nearest: any,
	altitude: number, -- above the nearest body's terrain (studs)
	ground: number, -- terrain height there (studs above the reference sphere)
	connections: { RBXScriptConnection },
	keys: { [Enum.KeyCode]: boolean },
}

local function surfaceHeight(body: any, dir: Vector3): number
	if body.kind ~= "rocky" then
		return 0
	end
	local x, y, z = dir.X, dir.Y, dir.Z
	local c1 = Bodies.coarseAt(body, x, y, z)
	local h = body.height(body, x, y, z, 2e-5, c1)
	if body.sea and h < 0 then
		h = 0
	end
	return h
end
Flight.surfaceHeight = surfaceHeight

-- Nearest body by distance to its surface.
function Flight.nearestBody(pos: Vector3): (any, number)
	local best, bestAlt = nil, math.huge
	for _, b in Bodies.list do
		local c = Vector3.new(b.px, b.py, b.pz)
		local alt = (pos - c).Magnitude - b.radius
		if alt < bestAlt then
			best, bestAlt = b, alt
		end
	end
	return best, bestAlt
end

function Flight.new(cam: Camera): Flight
	cam.CameraType = Enum.CameraType.Scriptable
	cam.FieldOfView = 70
	local F: Flight = {
		cam = cam,
		pos = Vector3.new(0, 1600 * 0.4, 1600 * 3.4),
		look = Vector3.new(0, -0.12, -1).Unit,
		speedScale = 1,
		looking = false,
		nearest = Bodies.list[1],
		altitude = 1e4,
		ground = 0,
		connections = {},
		keys = {},
	}
	table.insert(
		F.connections,
		UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
			if input.UserInputType == Enum.UserInputType.MouseButton2 then
				F.looking = true
				UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
			elseif input.UserInputType == Enum.UserInputType.Keyboard and not processed then
				F.keys[input.KeyCode] = true
			end
		end)
	)
	table.insert(
		F.connections,
		UserInputService.InputEnded:Connect(function(input: InputObject)
			if input.UserInputType == Enum.UserInputType.MouseButton2 then
				F.looking = false
				UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			elseif input.UserInputType == Enum.UserInputType.Keyboard then
				F.keys[input.KeyCode] = nil
			end
		end)
	)
	table.insert(
		F.connections,
		UserInputService.InputChanged:Connect(function(input: InputObject, processed: boolean)
			if input.UserInputType == Enum.UserInputType.MouseMovement and F.looking then
				local d = input.Delta
				Flight.turn(F, -d.X * 0.0035, -d.Y * 0.0035)
			elseif input.UserInputType == Enum.UserInputType.MouseWheel and not processed then
				F.speedScale = math.clamp(F.speedScale * (if input.Position.Z > 0 then 1.25 else 0.8), 0.05, 40)
			end
		end)
	)
	return F
end

local function localUp(F: Flight): Vector3
	local b = F.nearest
	local c = Vector3.new(b.px, b.py, b.pz)
	local r = F.pos - c
	return if r.Magnitude > 1e-6 then r.Unit else Vector3.yAxis
end

-- Yaw about the local up, pitch about the view's right; the horizon stays level.
function Flight.turn(F: Flight, yaw: number, pitch: number)
	local up = localUp(F)
	local look = CFrame.fromAxisAngle(up, yaw):VectorToWorldSpace(F.look)
	local right = look:Cross(up)
	if right.Magnitude < 1e-4 then
		right = Vector3.xAxis
	end
	right = right.Unit
	local pitched = CFrame.fromAxisAngle(right, pitch):VectorToWorldSpace(look)
	-- keep away from straight up and straight down
	local d = pitched:Dot(up)
	if d < 0.985 and d > -0.985 then
		look = pitched
	end
	F.look = look.Unit
end

-- Places the camera at `pos` looking at `target`.
function Flight.teleport(F: Flight, pos: Vector3, target: Vector3)
	F.pos = pos
	F.look = (target - pos).Unit
	F.nearest = Flight.nearestBody(pos)
end

function Flight.update(F: Flight, dt: number)
	local body = Flight.nearestBody(F.pos)
	F.nearest = body
	local c = Vector3.new(body.px, body.py, body.pz)
	local rel = F.pos - c
	local dist = rel.Magnitude
	local dir = if dist > 1e-6 then rel / dist else Vector3.yAxis
	F.ground = surfaceHeight(body, dir)
	F.altitude = dist - body.radius - F.ground
	local up = localUp(F)
	local right = F.look:Cross(up)
	right = if right.Magnitude > 1e-4 then right.Unit else Vector3.xAxis
	local camUp = right:Cross(F.look).Unit
	local move = Vector3.zero
	local k = F.keys
	if k[Enum.KeyCode.W] then
		move += F.look
	end
	if k[Enum.KeyCode.S] then
		move -= F.look
	end
	if k[Enum.KeyCode.D] then
		move += right
	end
	if k[Enum.KeyCode.A] then
		move -= right
	end
	if k[Enum.KeyCode.E] or k[Enum.KeyCode.Space] then
		move += camUp
	end
	if k[Enum.KeyCode.Q] or k[Enum.KeyCode.C] then
		move -= camUp
	end
	if move.Magnitude > 0 then
		local speed = math.clamp(math.max(F.altitude, 0) * 0.6, 3, 6000) * F.speedScale
		if k[Enum.KeyCode.LeftShift] or k[Enum.KeyCode.RightShift] then
			speed *= 5
		end
		F.pos += move.Unit * speed * dt
	end
	-- stay above the terrain
	rel = F.pos - c
	dist = rel.Magnitude
	if dist > 1e-6 then
		dir = rel / dist
		local floor = body.radius + surfaceHeight(body, dir) + 1.5
		if dist < floor then
			F.pos = c + dir * floor
		end
	end
	F.cam.CFrame = CFrame.lookAt(F.pos, F.pos + F.look, localUp(F))
end

-- A coastline or mountain spot on Terra near a direction, found by sampling the surface.
local function findSpot(wantMountain: boolean): (Vector3, Vector3)
	local terra = Bodies.get("terra")
	local best, bestScore = Vector3.new(0, 0, 1), -math.huge
	for k = 0, 600 do
		local u = k / 600
		local ang = u * 40
		local x = math.cos(ang) * (0.2 + 0.6 * u)
		local y = math.sin(ang * 1.7) * 0.4
		local z = 1
		local d = Vector3.new(x, y, z).Unit
		local h = surfaceHeight(terra, d)
		local score
		if wantMountain then
			score = h
		else
			-- a coast: land just above sea level with sea close by
			local d2 = (d + Vector3.new(0.004, 0, 0)).Unit
			local h2 = surfaceHeight(terra, d2)
			score = if h > 0.3 and h < 3 and h2 <= 0 then 10 - h else -math.huge
		end
		if score > bestScore then
			best, bestScore = d, score
		end
	end
	local right = best:Cross(Vector3.yAxis).Unit
	return best, right
end

-- Presets: 1 orbit, 2 approach, 3 coast at 25 studs, 4 mountains, 5 Selene, 6 Saturnia.
function Flight.preset(F: Flight, i: number)
	local terra = Bodies.get("terra")
	local R = terra.radius
	if i == 1 then
		Flight.teleport(F, Vector3.new(0, R * 0.4, R * 3.4), Vector3.zero)
	elseif i == 2 then
		Flight.teleport(F, Vector3.new(R * 0.5, R * 0.35, R * 1.55), Vector3.new(0, 0, 0))
	elseif i == 3 or i == 4 then
		local d, right = findSpot(i == 4)
		local h = surfaceHeight(terra, d)
		local pos = d * (R + h + (if i == 4 then 60 else 25))
		Flight.teleport(F, pos, pos + right * 400 - d * 30)
	elseif i == 5 then
		local s = Bodies.get("selene")
		local c = Vector3.new(s.px, s.py, s.pz)
		Flight.teleport(F, c + Vector3.new(s.radius * 1.2, s.radius * 0.5, s.radius * 1.1), c)
	elseif i == 6 then
		local s = Bodies.get("saturnia")
		local c = Vector3.new(s.px, s.py, s.pz)
		Flight.teleport(F, c + Vector3.new(-s.radius * 3.2, s.radius * 1.1, s.radius * 3.6), c)
	end
	Flight.update(F, 0)
end

return Flight
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--!strict
-- Universe at Home: Planets :: Hud
--
-- On-screen stats for the stress test, the key legend, and a status list where every
-- stage reports ok / fallback / failed instead of erroring (each line is also printed to
-- Output as PLANETS|<stage>|<state>|<detail>).

local Players = game:GetService("Players")

local Hud = {}

-- Live references to the client's subsystems, for the CLI mock harness
-- (tools/planets_mock_run.py) and for inspection from the command bar.
Hud.debug = {} :: { [string]: any }

export type Hud = {
	gui: ScreenGui,
	stats: TextLabel,
	status: TextLabel,
	help: TextLabel,
	lines: { string },
	order: { string },
	entries: { [string]: string },
	visible: boolean,
}

local function label(parent: Instance, name: string, pos: UDim2, size: UDim2, anchor: Vector2, align: Enum.TextXAlignment): TextLabel
	local t = Instance.new("TextLabel")
	t.Name = name
	t.BackgroundColor3 = Color3.fromRGB(6, 8, 16)
	t.BackgroundTransparency = 0.35
	t.BorderSizePixel = 0
	t.Position = pos
	t.Size = size
	t.AnchorPoint = anchor
	t.AutomaticSize = Enum.AutomaticSize.XY
	t.Font = Enum.Font.Code
	t.TextSize = 14
	t.TextColor3 = Color3.fromRGB(225, 232, 255)
	t.TextXAlignment = align
	t.TextYAlignment = Enum.TextYAlignment.Top
	t.RichText = false
	t.Text = ""
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingBottom = UDim.new(0, 6)
	pad.Parent = t
	t.Parent = parent
	return t
end

local HELP = table.concat({
	"FLY  hold right mouse: look   W A S D: move   E/Space up   Q/C down   Shift x5   wheel: speed",
	"VIEW 1 orbit  2 approach  3 coast  4 mountains  5 Selene  6 Saturnia",
	"TEST F fades on/off   T tint by level   L freeze LOD   B stress (finer LOD)   G impostors only",
	"     N flip normal-map green   V flip UV origin   K sun cycle   M clouds   X probe memory budget   H hide",
}, "\n")

function Hud.new(): Hud
	local gui = Instance.new("ScreenGui")
	gui.Name = "PlanetsHud"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	local player = Players.LocalPlayer
	gui.Parent = player:WaitForChild("PlayerGui")
	local h: Hud = {
		gui = gui,
		stats = label(gui, "Stats", UDim2.fromOffset(12, 12), UDim2.fromOffset(0, 0), Vector2.zero, Enum.TextXAlignment.Left),
		status = label(gui, "Status", UDim2.new(1, -12, 0, 12), UDim2.fromOffset(0, 0), Vector2.new(1, 0), Enum.TextXAlignment.Left),
		help = label(gui, "Help", UDim2.new(0, 12, 1, -12), UDim2.fromOffset(0, 0), Vector2.new(0, 1), Enum.TextXAlignment.Left),
		lines = {},
		order = {},
		entries = {},
		visible = true,
	}
	h.help.Text = HELP
	h.status.TextSize = 13
	return h
end

-- Records a stage result: state is "ok", "fallback", "failed" or "info".
function Hud.set(h: Hud, stage: string, state: string, detail: string)
	if not h.entries[stage] then
		table.insert(h.order, stage)
	end
	local mark = if state == "ok" then "[ok]  " elseif state == "fallback" then "[fall]" elseif state == "failed" then "[FAIL]" else "[..]  "
	h.entries[stage] = mark .. " " .. stage .. ": " .. detail
	local out = {}
	for _, s in h.order do
		table.insert(out, h.entries[s])
	end
	h.status.Text = table.concat(out, "\n")
	print(string.format("PLANETS|%s|%s|%s", stage, state, (string.gsub(detail, "[\r\n|]", " "))))
end

function Hud.stats(h: Hud, text: string)
	h.stats.Text = text
end

function Hud.toggle(h: Hud)
	h.visible = not h.visible
	h.gui.Enabled = h.visible
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">Impostors</string>
            <string name="Source"><![CDATA[--!strict
-- Universe at Home: Planets :: Impostors
--
-- Every body is also a raytraced billboard (planets/shared/Impostor): the whole body when
-- it is far away, the atmosphere halo around the mesh when it is the focus.
--
-- PLACEMENT. Bodies lie tens of thousands of studs apart. A billboard is drawn at a
-- compressed distance along its true direction and scaled by the same factor, which keeps
-- its angular size and position on screen exactly (scaled space) while staying well
-- inside the renderer's depth range. Order against the focus planet's mesh, which is at
-- true scale: a body nearer than the planet's surface is drawn on top; a body behind it is
-- placed beyond the planet's horizon distance, where the planet hides it correctly.
--
-- RENDERING. The image is re-rendered on the worker Actors in bands of rows whenever the
-- view has changed by a fraction of a pixel (direction, distance, roll, sun, clouds),
-- into a back buffer, and the finished image replaces the old one in a single atlas-style
-- flush. Resolution follows the on-screen size (32 to 512 px, shown through
-- ImageRectSize), so a distant moon costs a few hundred pixels and a close planet a full
-- 512 x 512.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Planets = ReplicatedStorage:WaitForChild("Planets")
local Bodies = require(Planets:WaitForChild("Bodies")) :: any
local Impostor = require(Planets:WaitForChild("Impostor")) :: any
local SphereCache = require(Planets:WaitForChild("SphereCache")) :: any
local WorkerPool = require(Planets:WaitForChild("WorkerPool")) :: any
local MeshPool = require(script.Parent:WaitForChild("MeshPool"))
local Uploader = require(script.Parent:WaitForChild("Uploader"))

local Impostors = {}

local MAX_N: number = require(Planets:WaitForChild("Config")).impostorMax
local BAND = 32

export type Item = {
	def: any,
	img: EditableImage?,
	entry: Uploader.Entry?,
	anchor: Part,
	gui: BillboardGui,
	label: ImageLabel,
	n: number,
	shown: boolean,
	back: buffer?,
	bandsLeft: number,
	renderId: number,
	rendering: boolean,
	lastStart: number,
	last: any?,
	cacheReady: boolean,
	renders: number,
	ms: number,
	screenPx: number,
}

export type Manager = {
	items: { Item },
	byId: { [string]: Item },
	U: Uploader.Uploader,
	workers: any,
	cachesReady: number,
	stats: { renders: number, bands: number, failed: number, lastError: string? },
}

function Impostors.compress(D: number): number
	if D <= 1200 then
		return D
	end
	local e = D - 1200
	return 1200 + 2300 * e / (e + 2300)
end

local function extraFor(def: any): number
	if def.rings then
		return def.rings.outer * 1.02
	end
	if def.atmosphere then
		return 1 + def.atmosphere.thickness * 1.5
	end
	return 1.02
end

function Impostors.new(U: Uploader.Uploader, workers: any, folder: Instance): Manager
	local M: Manager = { items = {}, byId = {}, U = U, workers = workers, cachesReady = 0, stats = { renders = 0, bands = 0, failed = 0, lastError = nil } }
	for _, def in Bodies.list do
		local img = MeshPool.createImage(MAX_N, MAX_N)
		local anchor = Instance.new("Part")
		anchor.Name = "Impostor_" .. def.name
		anchor.Anchored = true
		anchor.CanCollide = false
		anchor.CanQuery = false
		anchor.CanTouch = false
		anchor.CastShadow = false
		anchor.Transparency = 1
		anchor.Size = Vector3.new(1, 1, 1)
		anchor.Parent = folder
		local gui = Instance.new("BillboardGui")
		gui.Name = "Billboard"
		gui.LightInfluence = 0
		gui.Brightness = 1
		gui.AlwaysOnTop = false
		gui.ClipsDescendants = false
		gui.Enabled = false
		gui.Size = UDim2.fromScale(1, 1)
		gui.Adornee = anchor
		gui.Parent = anchor
		local label = Instance.new("ImageLabel")
		label.Name = "Image"
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.ImageRectOffset = Vector2.zero
		label.ImageRectSize = Vector2.new(MAX_N, MAX_N)
		if img then
			label.ImageContent = Content.fromObject(img)
		end
		label.Parent = gui
		local item: Item = {
			def = def,
			img = img,
			entry = if img then Uploader.register(U, "impostor " .. def.name, img) else nil,
			anchor = anchor,
			gui = gui,
			label = label,
			n = 256,
			shown = false,
			back = nil,
			bandsLeft = 0,
			renderId = 0,
			rendering = false,
			lastStart = -1,
			last = nil,
			cacheReady = false,
			renders = 0,
			ms = 0,
			screenPx = 0,
		}
		table.insert(M.items, item)
		M.byId[def.id] = item
	end
	return M
end

-- Builds every body's sphere cache on the workers (six faces each) and hands each worker a
-- copy. Yields; run it in its own thread.
function Impostors.buildCaches(M: Manager)
	local n = SphereCache.N
	for _, item in M.items do
		local faces: { buffer } = {}
		local got = 0
		for f = 1, 6 do
			WorkerPool.submit(M.workers, "cacheFace", { body = item.def.id, face = f, n = n }, function(ok: boolean, result: any)
				if ok then
					faces[f] = result
				else
					M.stats.failed += 1
					M.stats.lastError = tostring(result)
				end
				got += 1
			end)
		end
		local t0 = os.clock()
		while got < 6 and os.clock() - t0 < 60 do
			task.wait(0.05)
		end
		if #faces == 6 then
			WorkerPool.broadcast(M.workers, "setCache", { body = item.def.id, n = n, faces = faces }, 20)
			item.cacheReady = true
			item.last = nil -- re-render with the cache
			M.cachesReady += 1
		end
	end
end

local function angleBetween(a: Vector3, b: Vector3): number
	local d = a:Dot(b)
	return if d >= 1 then 0 elseif d <= -1 then math.pi else math.acos(d)
end

local function sizeFor(px: number): number
	local n = 32
	while n < px * 1.1 and n < MAX_N do
		n *= 2
	end
	return n
end

-- Starts a render of `item` for the given view on the workers.
local function startRender(M: Manager, item: Item, params: any, now: number)
	local n = params.n
	item.renderId += 1
	local id = item.renderId
	item.rendering = true
	item.lastStart = now
	item.back = buffer.create(n * n * 4)
	item.bandsLeft = (n + BAND - 1) // BAND
	item.last = params
	local t0 = os.clock()
	for y0 = 0, n - 1, BAND do
		local y1 = math.min(n, y0 + BAND)
		WorkerPool.submit(M.workers, "impostor", { params = params, y0 = y0, y1 = y1 }, function(ok: boolean, res: any)
			if item.renderId ~= id then
				return
			end
			M.stats.bands += 1
			local back = item.back
			if ok and back then
				buffer.copy(back, res.y0 * n * 4, res.band, 0, (res.y1 - res.y0) * n * 4)
			elseif not ok then
				M.stats.failed += 1
				M.stats.lastError = tostring(res)
			end
			item.bandsLeft -= 1
			if item.bandsLeft == 0 then
				item.rendering = false
				item.ms = (os.clock() - t0) * 1000
				local entry = item.entry
				if entry and back then
					Uploader.queue(M.U, entry, 0, 0, n, n, back, function()
						-- switch the visible region together with the new pixels
						item.label.ImageRectOffset = Vector2.zero
						item.label.ImageRectSize = Vector2.new(n, n)
						item.n = n
						item.shown = true
					end)
				end
				item.renders += 1
				M.stats.renders += 1
			end
		end)
	end
end

-- Per frame: placement of every billboard, and re-renders where the view changed.
-- `focus` is the body whose mesh is active (or nil) and `focusAlpha` its opacity.
function Impostors.update(M: Manager, cam: Camera, sun: Vector3, focus: any?, focusAlpha: number, cloudAngle: number, now: number)
	local cf = cam.CFrame
	local camPos = cf.Position
	local right, up, look = cf.RightVector, cf.UpVector, cf.LookVector
	local viewport = cam.ViewportSize
	local focal = viewport.Y / (2 * math.tan(math.rad(cam.FieldOfView * 0.5)))
	local fD, fR = 0, 0
	if focus and focusAlpha > 0 then
		local fc = Vector3.new(focus.px, focus.py, focus.pz)
		fD = (fc - camPos).Magnitude
		fR = focus.radius
	end
	local tangent = if fD > fR then math.sqrt(fD * fD - fR * fR) else 0
	-- bodies behind the focus planet, nearest first, get increasing distances
	local rank = 0
	for _, item in M.items do
		local def = item.def
		local center = Vector3.new(def.px, def.py, def.pz)
		local toB = center - camPos
		local D = toB.Magnitude
		local dir = if D > 1e-6 then toB / D else look
		local extra = extraFor(def)
		local halfTrue = Impostor.halfSize(def.radius, extra, D, item.n)
		local insideAtmosphere = D <= def.radius * extra * 1.001
		item.screenPx = 2 * halfTrue / math.max(D, 1) * focal
		local isFocus = focus == def and focusAlpha > 0
		local place, onTop
		if isFocus then
			place, onTop = D, false
		elseif fD > 0 then
			if D + def.radius * extra < fD - fR then
				place, onTop = math.min(D, Impostors.compress(D)), true
			else
				rank += 1
				place, onTop = tangent + 250 + rank * 40, false
			end
		else
			place, onTop = Impostors.compress(D), false
		end
		local scale = place / math.max(D, 1e-6)
		item.anchor.CFrame = CFrame.new(camPos + dir * place)
		item.gui.AlwaysOnTop = onTop
		item.gui.Size = UDim2.fromScale(2 * halfTrue * scale, 2 * halfTrue * scale)
		-- inside the atmosphere the halo surrounds the camera: the engine's Atmosphere takes over
		local visible = item.shown and item.img ~= nil and not insideAtmosphere
		if isFocus and D < def.radius * 1.12 then
			visible = false
		end
		item.gui.Enabled = visible
		-- re-render when the view changed by a fraction of a pixel
		if item.img and not insideAtmosphere and not item.rendering and now - item.lastStart > 0.12 and item.screenPx >= 2 and look:Dot(dir) > -0.3 then
			local n = sizeFor(item.screenPx)
			local half = Impostor.halfSize(def.radius, extra, D, n)
			local pixelAngle = 2 * half / n / D
			local last = item.last
			local need = last == nil or last.n ~= n
			if not need then
				local lastDir = Vector3.new(-last.cx, -last.cy, -last.cz).Unit
				local lastD = math.sqrt(last.cx * last.cx + last.cy * last.cy + last.cz * last.cz)
				need = angleBetween(dir, lastDir) > pixelAngle * 0.35
					or math.abs(D - lastD) / D > 0.004
					or angleBetween(right, Vector3.new(last.rx, last.ry, last.rz)) > 0.01
					or angleBetween(up, Vector3.new(last.ux, last.uy, last.uz)) > 0.01
					or angleBetween(sun, Vector3.new(last.sx, last.sy, last.sz)) > 0.003
					or (def.id == "terra" and math.abs(cloudAngle - last.cloudAngle) > 0.004)
			end
			if need then
				local rel = camPos - center
				startRender(M, item, {
					body = def.id,
					n = n,
					cx = rel.X,
					cy = rel.Y,
					cz = rel.Z,
					rx = right.X,
					ry = right.Y,
					rz = right.Z,
					ux = up.X,
					uy = up.Y,
					uz = up.Z,
					half = half,
					sx = sun.X,
					sy = sun.Y,
					sz = sun.Z,
					cloudAngle = cloudAngle,
				}, now)
			end
		end
	end
end

-- Pixels held by the impostor images.
function Impostors.pixels(M: Manager): number
	local n = 0
	for _, item in M.items do
		if item.img then
			n += MAX_N * MAX_N
		end
	end
	return n
end

return Impostors
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="54">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Universe at Home: Planets :: client entry point (StarterPlayerScripts.Client.Main)
--
-- A stress test of EditableImages at planetary scale. Every surface pixel on screen is
-- generated at run time on worker Actors and streamed through EditableImages:
--   Terra and Selene   cube-sphere quadtree of up to 256 pooled patch meshes, each with
--                      colour, normal and roughness tiles in three shared atlases
--                      (SurfaceAppearance via CreateSurfaceAppearanceAsync)
--   every body         a raytraced impostor billboard (exact limb, atmosphere, rings)
--   Terra's clouds     a rotating shell from a 1024 x 512 atlas
--   space              six star faces and the sun sprite
-- All pixel writes go through one queue that refreshes one image per frame (the engine's
-- rule). Each stage reports to the HUD status list; none can take the others down.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local Stats = game:GetService("Stats")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local AssetService = game:GetService("AssetService")

local Hud = require(script.Parent:WaitForChild("Hud"))
local hud = Hud.new()
Hud.set(hud, "client", "info", "Universe at Home: Planets, starting")

local Planets = ReplicatedStorage:WaitForChild("Planets")
local Bodies = require(Planets:WaitForChild("Bodies")) :: any
local Uploader = require(script.Parent:WaitForChild("Uploader"))
local MeshPool = require(script.Parent:WaitForChild("MeshPool"))
local PlanetLod = require(script.Parent:WaitForChild("PlanetLod"))
local Impostors = require(script.Parent:WaitForChild("Impostors"))
local Sky = require(script.Parent:WaitForChild("Sky"))
local CloudLayer = require(script.Parent:WaitForChild("CloudLayer"))
local Flight = require(script.Parent:WaitForChild("Flight"))
local Workers = require(script.Parent:WaitForChild("Workers"))

local Config = require(Planets:WaitForChild("Config"))
local MESH_ON: number = Config.meshOn -- distance / radius below which a rocky body gets its mesh
local MESH_OFF: number = Config.meshOff -- and above which it goes back to the impostor (hysteresis)

local player = Players.LocalPlayer
local cam = Workspace.CurrentCamera
local folder = Instance.new("Folder")
folder.Name = "Planets"
folder.Parent = Workspace

local terra = Bodies.get("terra")
local U = Uploader.new()
local flight = Flight.new(cam)

-- state shared by the frame loop and the setup thread
local pool: MeshPool.Pool? = nil
local lod: PlanetLod.Lod? = nil
local imps: Impostors.Manager? = nil
local sky: Sky.SkyState? = nil
local clouds: CloudLayer.Layer? = nil
local cloudsOn = true
local impostorOnly = false
local sunCycle = false
local workersNote: string? = nil
local workers = Workers.start(Config.workers, function(note: string)
	workersNote = note
end)

local function stage(name: string, fn: () -> (string, string)): boolean
	local ok, state, detail = pcall(fn)
	if ok then
		Hud.set(hud, name, state, detail)
		return state ~= "failed"
	end
	Hud.set(hud, name, "failed", tostring(state))
	return false
end

-- setup: waits for the workers (so heavy jobs never run on the main thread at start), then
-- builds every stage
task.spawn(function()
	local t0 = os.clock()
	while workersNote == nil and os.clock() - t0 < 20 do
		task.wait(0.1)
	end
	Hud.set(hud, "workers", if workers.available then "ok" else "fallback", workersNote or "timed out; serial mode")
	stage("sky", function()
		local s = Sky.new(U, workers, folder)
		sky = s
		return "ok", s.note
	end)
	stage("atlases", function()
		local p, err = MeshPool.new(U, folder)
		if not p then
			return "failed", tostring(err)
		end
		pool = p
		lod = PlanetLod.new(p, U, workers)
		return if p.mode == "pbr" then "ok" else "fallback", p.note
	end)
	stage("impostors", function()
		local m = Impostors.new(U, workers, folder)
		imps = m
		task.spawn(function()
			Impostors.buildCaches(m)
			Hud.set(hud, "sphere caches", if m.cachesReady == #m.items then "ok" else "fallback", string.format("%d of %d bodies cached on the workers", m.cachesReady, #m.items))
		end)
		return "ok", string.format("%d raytraced billboards", #m.items)
	end)
	stage("clouds", function()
		local layer, err = CloudLayer.new(U, workers, folder, terra)
		if not layer then
			return "failed", tostring(err)
		end
		clouds = layer
		return if layer.part then "ok" else "fallback", layer.note
	end)
	Hud.set(hud, "client", "ok", "ready: fly with W A S D and the right mouse button")
	Hud.debug.lod = lod
	Hud.debug.pool = pool
	Hud.debug.imps = imps
	Hud.debug.sky = sky
	Hud.debug.clouds = clouds
	Hud.debug.ready = true
end)
Hud.debug.U = U
Hud.debug.flight = flight
Hud.debug.workers = workers

Flight.preset(flight, 1)

-- focus: the nearest rocky body close enough for its mesh
local function chooseFocus(current: any?): any?
	if impostorOnly then
		return nil
	end
	local camPos = cam.CFrame.Position
	local best, bestD = nil, math.huge
	for _, b in Bodies.list do
		if b.kind == "rocky" then
			local D = (camPos - Vector3.new(b.px, b.py, b.pz)).Magnitude / b.radius
			local limit = if b == current then MESH_OFF else MESH_ON
			if D < limit and D < bestD then
				best, bestD = b, D
			end
		end
	end
	return best
end

-- memory-budget probe: allocate 256 x 256 images until the engine refuses (or a cap)
local probing = false
local function probeBudget()
	if probing then
		return
	end
	probing = true
	Hud.set(hud, "budget probe", "info", "allocating 256 x 256 EditableImages ...")
	task.spawn(function()
		local made: { EditableImage } = {}
		local cap = 200
		local refused = false
		for _ = 1, cap do
			local ok, img = pcall(function()
				return AssetService:CreateEditableImage({ Size = Vector2.new(256, 256) })
			end)
			if not ok or not img then
				refused = true
				break
			end
			table.insert(made, img :: EditableImage)
			if #made % 20 == 0 then
				task.wait()
			end
		end
		local extra = #made * 65536
		for _, img in made do
			img:Destroy()
		end
		local own = (if pool then pool.stats.pixels else 0) + (if imps then Impostors.pixels(imps) else 0) + (if sky then sky.pixels else 0) + (if clouds then clouds.pixels else 0)
		local detail = string.format(
			"%s after %.1f Mpx more (%.0f MB) on top of the demo's %.1f Mpx: about %.1f Mpx (%.0f MB) usable here",
			if refused then "refused" else "no refusal (cap reached, likely Studio)",
			extra / 1e6,
			extra * 4 / 1048576,
			own / 1e6,
			(extra + own) / 1e6,
			(extra + own) * 4 / 1048576
		)
		Hud.set(hud, "budget probe", if refused then "ok" else "info", detail)
		probing = false
	end)
end

UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
	if processed or input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end
	local k = input.KeyCode
	local L = lod
	if k == Enum.KeyCode.H then
		Hud.toggle(hud)
	elseif k == Enum.KeyCode.One then
		Flight.preset(flight, 1)
	elseif k == Enum.KeyCode.Two then
		Flight.preset(flight, 2)
	elseif k == Enum.KeyCode.Three then
		Flight.preset(flight, 3)
	elseif k == Enum.KeyCode.Four then
		Flight.preset(flight, 4)
	elseif k == Enum.KeyCode.Five then
		Flight.preset(flight, 5)
	elseif k == Enum.KeyCode.Six then
		Flight.preset(flight, 6)
	elseif k == Enum.KeyCode.F and L then
		L.opts.fades = not L.opts.fades
	elseif k == Enum.KeyCode.T and L then
		L.opts.tint = not L.opts.tint
		PlanetLod.refreshTint(L)
	elseif k == Enum.KeyCode.L and L then
		L.opts.frozen = not L.opts.frozen
	elseif k == Enum.KeyCode.B and L then
		local stress = L.opts.splitPx > Config.stressSplitPx
		L.opts.splitPx = if stress then Config.stressSplitPx else Config.splitPx
		L.opts.capacity = math.min(if stress then Config.stressCapacity else Config.capacity, 256)
	elseif k == Enum.KeyCode.G then
		impostorOnly = not impostorOnly
	elseif k == Enum.KeyCode.N and L then
		L.opts.greenUp = not L.opts.greenUp
		PlanetLod.reset(L)
	elseif k == Enum.KeyCode.V and pool then
		MeshPool.setFlipV(pool :: MeshPool.Pool, not (pool :: MeshPool.Pool).flipV)
	elseif k == Enum.KeyCode.K then
		sunCycle = not sunCycle
	elseif k == Enum.KeyCode.M then
		cloudsOn = not cloudsOn
	elseif k == Enum.KeyCode.X then
		probeBudget()
	end
end)

-- frame loop
local frames, frameAcc, luauAcc = 0, 0, 0
local lastHud = 0
local lastGenerated, lastRateClock, tileRate = 0, os.clock(), 0
RunService.RenderStepped:Connect(function(dt: number)
	local t0 = os.clock()
	Flight.update(flight, dt)
	if sunCycle then
		Lighting.ClockTime = (Lighting.ClockTime + dt * 0.35) % 24
	end
	local sun = Lighting:GetSunDirection()
	local L = lod
	if L then
		local want = chooseFocus(L.body)
		if want ~= L.body then
			-- fade the old mesh out before switching
			if L.body == nil or L.alpha <= 0.001 then
				PlanetLod.setBody(L, want)
			else
				L.alphaTarget = 0
			end
		elseif L.body then
			L.alphaTarget = 1
		end
		PlanetLod.update(L, cam, dt, 0.004)
	end
	local cloudAngle = if clouds then clouds.angle else 0
	if imps then
		Impostors.update(imps, cam, sun, if L then L.body else nil, if L then L.alpha else 0, cloudAngle, os.clock())
	end
	if clouds then
		CloudLayer.update(clouds, terra, dt, if L and L.body == terra then L.alpha else 0, cloudsOn)
	end
	if sky then
		local alt = if flight.nearest == terra then flight.altitude else 1e9
		Sky.update(sky, cam, alt, terra.radius)
	end
	Uploader.step(U)
	-- stats
	frames += 1
	frameAcc += dt
	luauAcc += os.clock() - t0
	local now = os.clock()
	if now - lastHud > 0.25 then
		local fps = frames / math.max(frameAcc, 1e-6)
		local ms = frameAcc / math.max(frames, 1) * 1000
		local ours = luauAcc / math.max(frames, 1) * 1000
		frames, frameAcc, luauAcc = 0, 0, 0
		lastHud = now
		local lines = {}
		table.insert(lines, string.format("FPS %3.0f   frame %5.1f ms   our main-thread Luau %4.2f ms", fps, ms, ours))
		table.insert(lines, string.format("camera  %s, altitude %.0f studs, speed x%.2f", flight.nearest.name, flight.altitude, flight.speedScale))
		if L then
			local shown, cached, gen, up = PlanetLod.counts(L)
			if now - lastRateClock > 1 then
				tileRate = (L.stats.generated - lastGenerated) / (now - lastRateClock)
				lastGenerated = L.stats.generated
				lastRateClock = now
			end
			table.insert(
				lines,
				string.format(
					"mesh    %s %3.0f%%   patches shown %d  cached %d  generating %d  uploading %d   deepest L%d%s",
					if L.body then L.body.name else "none",
					L.alpha * 100,
					shown,
					cached,
					gen,
					up,
					L.stats.deepest,
					if L.stats.limited then " (atlas full)" else ""
				)
			)
			table.insert(
				lines,
				string.format(
					"tiles   %d generated (%.1f/s), %.0f ms mean on workers, %d swaps, %d evicted, %d failed%s",
					L.stats.generated,
					tileRate,
					L.stats.genMs / math.max(1, L.stats.generated),
					L.stats.swaps,
					L.stats.evicted,
					L.stats.failed,
					if L.stats.lastError then " (" .. string.sub(L.stats.lastError :: string, 1, 60) .. ")" else ""
				)
			)
			table.insert(lines, string.format("options fades %s   tint %s   frozen %s   stress %s   green %s   UV flip %s", if L.opts.fades then "on" else "off", if L.opts.tint then "on" else "off", if L.opts.frozen then "yes" else "no", if L.opts.splitPx < Config.splitPx then "on" else "off", if L.opts.greenUp then "up" else "down", if pool and pool.flipV then "on" else "off"))
		end
		local ws = workers.stats
		table.insert(lines, string.format("workers %s, %d ready, %d sent, %d done, %d inline, %d lost, %d in flight", workers.mode, workers.readyCount, ws.sent, ws.done, ws.inline, ws.lost, workers.inflight))
		local us = U.stats
		table.insert(lines, string.format("uploads %d flushes (one image per frame), %d rects, %.0f MB, backlog %d, last %s%s", us.flushes, us.rects, us.bytes / 1048576, Uploader.backlog(U), us.lastImage, if us.errors > 0 then string.format(", %d errors: %s", us.errors, tostring(us.lastError)) else ""))
		if imps then
			local parts = {}
			for _, item in imps.items do
				table.insert(parts, string.format("%s %dpx %.0fms", item.def.name, item.n, item.ms))
			end
			table.insert(lines, string.format("impost. %d renders, caches %d/%d   %s", imps.stats.renders, imps.cachesReady, #imps.items, table.concat(parts, "  ")))
		end
		local px = (if pool then pool.stats.pixels else 0) + (if imps then Impostors.pixels(imps) else 0) + (if sky then sky.pixels else 0) + (if clouds then clouds.pixels else 0)
		local tex = 0
		pcall(function()
			tex = Stats:GetMemoryUsageMbForTag(Enum.DeveloperMemoryTag.GraphicsTexture)
		end)
		table.insert(lines, string.format("images  %.2f Mpx live in EditableImages = %.1f MB RGBA   engine texture memory %.0f MB", px / 1e6, px * 4 / 1048576, tex))
		if pool then
			table.insert(lines, string.format("surface %s   mesh %s   slots %d of 256", pool.mode, pool.meshMode, #pool.slots))
		end
		Hud.stats(hud, table.concat(lines, "\n"))
	end
end)

player.CharacterAdded:Connect(function()
	-- no character is used; keep the scripted camera
	cam.CameraType = Enum.CameraType.Scriptable
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">MeshPool</string>
            <string name="Source"><![CDATA[--!strict
-- Universe at Home: Planets :: MeshPool
--
-- The GPU side of the patch system: three atlases and up to 256 pooled patch meshes.
--
-- ATLASES. Colour (1024 x 1024), normal (1024 x 1024) and roughness (512 x 512)
-- EditableImages; slot i owns tile i of each (Layout). One SurfaceAppearance per slot,
-- built by AssetService:CreateSurfaceAppearanceAsync from the three atlases: the only way a
-- game script gets normal and roughness maps on a mesh (their properties are plugin-only).
-- Its maps cannot be swapped, but the EditableImages behind them can be rewritten, which
-- is all the pool ever does. If the engine refuses, the pool falls back to
-- MeshPart.TextureContent (colour only; lighting from the sphere normals) and says so.
--
-- SLOTS. Each slot is an EditableMesh with the fixed patch topology (TileGen.triangles,
-- per-vertex UVs into its own tile, per-vertex normals) shown by a MeshPart. Assigning a
-- patch rewrites the vertex positions and normals; nothing is created or destroyed while
-- flying. All vertices are body-local and two zero-area triangles pin the bounding box to
-- +-PIN_EXTENT on every axis, so the box is centred on the body whichever origin rule the
-- engine uses and never changes size (no rescaling when vertices move): every part simply
-- sits at the body's centre.

local AssetService = game:GetService("AssetService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Planets = ReplicatedStorage:WaitForChild("Planets")
local Layout = require(Planets:WaitForChild("Layout")) :: any
local TileGen = require(Planets:WaitForChild("TileGen")) :: any
local Uploader = require(script.Parent:WaitForChild("Uploader"))

local MeshPool = {}

export type Slot = {
	index: number, -- 0-based, = atlas tile
	tx: number,
	ty: number,
	mesh: EditableMesh,
	part: MeshPart,
	sa: SurfaceAppearance?,
	vIds: { number },
	nIds: { number },
	uvIds: { number },
	key: number?, -- patch currently held
	state: string, -- "free" | "generating" | "uploading" | "ready" | "shown"
	lastUsed: number,
	ticket: number, -- increments on every (re)assignment; stale job results are dropped
}

export type Pool = {
	color: EditableImage,
	normal: EditableImage?,
	rough: EditableImage?,
	colorEntry: Uploader.Entry,
	normalEntry: Uploader.Entry?,
	roughEntry: Uploader.Entry?,
	mode: string, -- "pbr" | "texture"
	note: string,
	slots: { Slot },
	folder: Folder,
	flipV: boolean,
	template: SurfaceAppearance?,
	cloneWorks: boolean?,
	tris: { number },
	growing: boolean,
	failed: string?,
	meshMode: string,
	stats: { created: number, writes: number, meshMs: number, pixels: number },
}

local function createImage(w: number, h: number): (EditableImage?, string?)
	local ok, result = pcall(function()
		return AssetService:CreateEditableImage({ Size = Vector2.new(w, h) })
	end)
	if not ok then
		return nil, tostring(result)
	end
	if not result then
		return nil, "CreateEditableImage returned nil (editable memory budget)"
	end
	return result :: EditableImage, nil
end
MeshPool.createImage = createImage

-- Creates the atlases. Returns nil and a reason when even the colour atlas cannot exist.
function MeshPool.new(U: Uploader.Uploader, folder: Folder): (Pool?, string?)
	local color, err = createImage(Layout.ATLAS, Layout.ATLAS)
	if not color then
		return nil, "colour atlas: " .. tostring(err)
	end
	local normal = createImage(Layout.ATLAS, Layout.ATLAS)
	local rough = createImage(Layout.ROUGH_ATLAS, Layout.ROUGH_ATLAS)
	local pool: Pool = {
		color = color,
		normal = normal,
		rough = rough,
		colorEntry = Uploader.register(U, "colour atlas", color),
		normalEntry = if normal then Uploader.register(U, "normal atlas", normal) else nil,
		roughEntry = if rough then Uploader.register(U, "roughness atlas", rough) else nil,
		mode = "texture",
		note = "not decided yet",
		slots = {},
		folder = folder,
		flipV = false,
		template = nil,
		cloneWorks = nil,
		tris = TileGen.triangles(),
		growing = false,
		failed = nil,
		meshMode = "batch",
		stats = { created = 0, writes = 0, meshMs = 0, pixels = Layout.ATLAS * Layout.ATLAS + (if normal then Layout.ATLAS * Layout.ATLAS else 0) + (if rough then Layout.ROUGH_ATLAS * Layout.ROUGH_ATLAS else 0) },
	}
	-- decide the surface path once: PBR maps through CreateSurfaceAppearanceAsync, or colour only
	if normal and rough then
		local ok, sa = pcall(function()
			return AssetService:CreateSurfaceAppearanceAsync({
				ColorMap = Content.fromObject(color),
				NormalMap = Content.fromObject(normal),
				RoughnessMap = Content.fromObject(rough),
			})
		end)
		if ok and sa then
			pool.template = sa
			pool.mode = "pbr"
			pool.note = "colour + normal + roughness maps (CreateSurfaceAppearanceAsync)"
		else
			pool.note = "CreateSurfaceAppearanceAsync refused (" .. tostring(sa) .. "); colour only via TextureContent"
		end
	else
		pool.note = "normal/roughness atlases refused by the memory budget; colour only"
	end
	return pool, nil
end

-- One SurfaceAppearance per slot: a clone of the template when cloning keeps the maps,
-- else a fresh CreateSurfaceAppearanceAsync call.
local function surfaceFor(pool: Pool): SurfaceAppearance?
	local template = pool.template
	if not template then
		return nil
	end
	if pool.cloneWorks ~= false then
		local ok, clone = pcall(function()
			return template:Clone()
		end)
		if ok and clone then
			if pool.cloneWorks == nil then
				local same = pcall(function()
					assert(((clone :: SurfaceAppearance).ColorMapContent.Object :: any) == pool.color)
				end)
				pool.cloneWorks = same
			end
			if pool.cloneWorks then
				return clone :: SurfaceAppearance
			end
			(clone :: SurfaceAppearance):Destroy()
		else
			pool.cloneWorks = false
		end
	end
	local ok, sa = pcall(function()
		return AssetService:CreateSurfaceAppearanceAsync({
			ColorMap = Content.fromObject(pool.color),
			NormalMap = Content.fromObject(pool.normal :: EditableImage),
			RoughnessMap = Content.fromObject(pool.rough :: EditableImage),
		})
	end)
	return if ok then sa else nil
end

local function uvVector(pool: Pool, uvs: { number }, v: number): Vector2
	local u, w = uvs[v * 2 + 1], uvs[v * 2 + 2]
	return Vector2.new(u, if pool.flipV then 1 - w else w)
end

-- Builds one slot (yields: CreateMeshPartAsync). Returns nil and a reason on failure.
local function newSlot(pool: Pool, index: number): (Slot?, string?)
	local tx, ty = Layout.tileOf(index)
	local mesh = AssetService:CreateEditableMesh()
	if not mesh then
		return nil, "CreateEditableMesh returned nil (editable memory budget)"
	end
	local V = Layout.VERTS
	local G = Layout.GRID
	local P = Layout.PIN_EXTENT
	-- initial geometry: a small flat grid (no zero-area triangles except the pins)
	local positions = table.create(V, Vector3.zero)
	local normals = table.create(V, Vector3.yAxis)
	for v = 0, Layout.GRID_VERTS + Layout.SKIRT_VERTS - 1 do
		local g = if v < Layout.GRID_VERTS then v else v % (G + 1)
		positions[v + 1] = Vector3.new(g % (G + 1), (g // (G + 1)) * 0.5 + (if v < Layout.GRID_VERTS then 0 else -1), g // (G + 1))
	end
	local pins = { Vector3.new(P, P, P), Vector3.new(P - 0.01, P, P), Vector3.new(P, P - 0.01, P), Vector3.new(-P, -P, -P), Vector3.new(-P + 0.01, -P, -P), Vector3.new(-P, -P + 0.01, -P) }
	for k = 1, 6 do
		positions[V - 6 + k] = pins[k]
	end
	local uvs = TileGen.uvs(tx, ty)
	local uvList = table.create(V, Vector2.zero)
	for v = 0, V - 1 do
		uvList[v + 1] = uvVector(pool, uvs, v)
	end
	local tris = pool.tris
	local T = #tris // 3
	local vIds: { number } = {}
	local nIds: { number } = {}
	local uvIds: { number } = {}
	local ok, err = pcall(function()
		vIds = mesh:BatchAdd(Enum.MeshAttribute.Vertex, positions) :: { number }
		uvIds = mesh:BatchAdd(Enum.MeshAttribute.UV, uvList) :: { number }
		nIds = mesh:BatchAdd(Enum.MeshAttribute.Normal, normals) :: { number }
		local faces = table.create(T)
		local faceUV = table.create(T)
		local faceN = table.create(T)
		for t = 0, T - 1 do
			local a, b, c = tris[t * 3 + 1] + 1, tris[t * 3 + 2] + 1, tris[t * 3 + 3] + 1
			faces[t + 1] = { vIds[a], vIds[b], vIds[c] }
			faceUV[t + 1] = { uvIds[a], uvIds[b], uvIds[c] }
			faceN[t + 1] = { nIds[a], nIds[b], nIds[c] }
		end
		local fIds = mesh:BatchAdd(Enum.MeshAttribute.Face, faces) :: { number }
		mesh:BatchSetFaceAttributes(fIds, faceUV)
		mesh:BatchSetFaceAttributes(fIds, faceN)
	end)
	if not ok then
		-- per-element fallback on a fresh mesh
		pool.meshMode = "per-element (batch failed: " .. tostring(err) .. ")"
		mesh:Destroy()
		local m2 = AssetService:CreateEditableMesh()
		if not m2 then
			return nil, "CreateEditableMesh returned nil on retry"
		end
		mesh = m2
		vIds, nIds, uvIds = table.create(V), table.create(V), table.create(V)
		for v = 1, V do
			vIds[v] = m2:AddVertex(positions[v])
			uvIds[v] = m2:AddUV(uvList[v])
			nIds[v] = m2:AddNormal(normals[v])
		end
		for t = 0, T - 1 do
			local a, b, c = tris[t * 3 + 1] + 1, tris[t * 3 + 2] + 1, tris[t * 3 + 3] + 1
			local f = m2:AddTriangle(vIds[a], vIds[b], vIds[c])
			m2:SetFaceUVs(f, { uvIds[a], uvIds[b], uvIds[c] })
			m2:SetFaceNormals(f, { nIds[a], nIds[b], nIds[c] })
		end
	end
	local partOk, partOrErr = pcall(function()
		return AssetService:CreateMeshPartAsync(Content.fromObject(mesh), {
			CollisionFidelity = Enum.CollisionFidelity.Box,
			RenderFidelity = Enum.RenderFidelity.Precise,
		})
	end)
	if not partOk or not partOrErr then
		mesh:Destroy()
		return nil, "CreateMeshPartAsync: " .. tostring(partOrErr)
	end
	local part = partOrErr :: MeshPart
	part.Name = "Patch" .. index
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.SmoothPlastic
	part.Color = Color3.new(1, 1, 1)
	part.Transparency = 1
	part.Locked = true
	local sa: SurfaceAppearance? = nil
	if pool.mode == "pbr" then
		sa = surfaceFor(pool)
		if sa then
			sa.Parent = part
		end
	end
	if not sa then
		pcall(function()
			part.TextureContent = Content.fromObject(pool.color)
		end)
	end
	part.Parent = pool.folder
	pool.stats.created += 1
	return {
		index = index,
		tx = tx,
		ty = ty,
		mesh = mesh,
		part = part,
		sa = sa,
		vIds = vIds,
		nIds = nIds,
		uvIds = uvIds,
		key = nil,
		state = "free",
		lastUsed = 0,
		ticket = 0,
	},
		nil
end

-- Grows the pool by up to `count` slots (yields). Returns the number created.
function MeshPool.grow(pool: Pool, count: number): number
	local made = 0
	while made < count and #pool.slots < Layout.SLOTS do
		local slot, err = newSlot(pool, #pool.slots)
		if not slot then
			pool.failed = err
			break
		end
		table.insert(pool.slots, slot)
		made += 1
	end
	return made
end

-- Writes a generated patch into a slot: three tile uploads (queued) and the mesh (now).
-- `onReady` runs once every atlas holding the patch has been refreshed.
function MeshPool.assign(pool: Pool, U: Uploader.Uploader, slot: Slot, result: any, onReady: () -> ())
	local t0 = os.clock()
	slot.key = result.key
	slot.state = "uploading"
	local T, RT = Layout.TILE, Layout.ROUGH_TILE
	local waiting = 1
	local function done()
		waiting -= 1
		if waiting == 0 then
			onReady()
		end
	end
	if pool.mode == "pbr" and pool.normalEntry and pool.roughEntry then
		waiting = 3
		Uploader.queue(U, pool.normalEntry :: Uploader.Entry, slot.tx * T, slot.ty * T, T, T, result.normal, done)
		Uploader.queue(U, pool.roughEntry :: Uploader.Entry, slot.tx * RT, slot.ty * RT, RT, RT, result.rough, done)
	end
	Uploader.queue(U, pool.colorEntry, slot.tx * T, slot.ty * T, T, T, result.color, done)
	-- the mesh: positions and normals from the f32 buffers
	local V = Layout.VERTS
	local pb, nb = result.positions, result.normals
	local pos = table.create(V, Vector3.zero)
	local nrm = table.create(V, Vector3.yAxis)
	for v = 0, V - 1 do
		local o = v * 12
		pos[v + 1] = Vector3.new(buffer.readf32(pb, o), buffer.readf32(pb, o + 4), buffer.readf32(pb, o + 8))
		nrm[v + 1] = Vector3.new(buffer.readf32(nb, o), buffer.readf32(nb, o + 4), buffer.readf32(nb, o + 8))
	end
	local mesh = slot.mesh
	local ok = pcall(function()
		mesh:BatchSetValues(slot.vIds, pos)
	end)
	if not ok then
		for v = 1, V do
			mesh:SetPosition(slot.vIds[v], pos[v])
		end
	end
	ok = pcall(function()
		mesh:BatchSetValues(slot.nIds, nrm)
	end)
	if not ok then
		for v = 1, V do
			mesh:SetNormal(slot.nIds[v], nrm[v])
		end
	end
	pool.stats.writes += 1
	pool.stats.meshMs += (os.clock() - t0) * 1000
end

-- Flips the V coordinate of every slot's UVs (for an engine whose UV origin is the
-- bottom-left corner). Tile contents stay; only the mapping changes.
function MeshPool.setFlipV(pool: Pool, flip: boolean)
	if pool.flipV == flip then
		return
	end
	pool.flipV = flip
	for _, slot in pool.slots do
		local uvs = TileGen.uvs(slot.tx, slot.ty)
		local V = Layout.VERTS
		local list = table.create(V, Vector2.zero)
		for v = 0, V - 1 do
			list[v + 1] = uvVector(pool, uvs, v)
		end
		local ok = pcall(function()
			slot.mesh:BatchSetValues(slot.uvIds, list)
		end)
		if not ok then
			for v = 1, V do
				pcall(function()
					slot.mesh:SetUV(slot.uvIds[v], list[v])
				end)
			end
		end
	end
end

-- Debug tint of a slot's surface (SurfaceAppearance.Color multiplies the colour map).
function MeshPool.tint(slot: Slot, color: Color3)
	local sa = slot.sa
	if sa then
		pcall(function()
			sa.Color = color
		end)
	else
		slot.part.Color = color
	end
end

return MeshPool
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">PlanetLod</string>
            <string name="Source"><![CDATA[--!strict
-- Universe at Home: Planets :: PlanetLod
--
-- Drives the patch system for the one body the camera is close to (the focus): selects
-- the target cut (Quadtree.select), plans hole-free steps towards it (Quadtree.plan),
-- generates patches on the worker Actors, uploads them through the atlases, and swaps
-- them in with a two-phase fade.
--
--   bootstrap  the six face roots are generated and shown together (the plan needs a
--              displayed partition to start from)
--   generate   patches the plan asks for, most visible first, into free slots or slots
--              holding cached patches nobody needs (least recently used first)
--   results    applied on the main thread within a time budget (mesh writes), atlas
--              tiles queued on the Uploader; a patch is ready once its atlases flushed
--   swaps      phase 1: the new patches fade in over the old ones, pulled a hair towards
--              the camera so the depth test never lets the old surface win (no
--              z-fighting); phase 2: the old patches disappear behind them. With fades off
--              the swap is instant (the comparison the HUD toggle shows).
--   alpha      the whole mesh fades against the body's impostor when the focus changes

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Planets = ReplicatedStorage:WaitForChild("Planets")
local Quadtree = require(Planets:WaitForChild("Quadtree")) :: any
local CubeSphere = require(Planets:WaitForChild("CubeSphere")) :: any
local Layout = require(Planets:WaitForChild("Layout")) :: any
local WorkerPool = require(Planets:WaitForChild("WorkerPool")) :: any
local MeshPool = require(script.Parent:WaitForChild("MeshPool"))
local Uploader = require(script.Parent:WaitForChild("Uploader"))

local Config = require(Planets:WaitForChild("Config"))

local PlanetLod = {}

local FADE_SECONDS = 0.35
local LEVEL_TINTS = {
	Color3.fromRGB(255, 140, 140),
	Color3.fromRGB(255, 205, 128),
	Color3.fromRGB(255, 255, 128),
	Color3.fromRGB(153, 255, 128),
	Color3.fromRGB(128, 255, 230),
	Color3.fromRGB(128, 190, 255),
	Color3.fromRGB(190, 140, 255),
	Color3.fromRGB(255, 140, 230),
}

type Slot = MeshPool.Slot

type Fade = {
	show: { Slot },
	hide: { Slot },
	t: number,
}

export type Options = {
	fades: boolean,
	frozen: boolean,
	greenUp: boolean,
	tint: boolean,
	splitPx: number,
	capacity: number,
}

export type Lod = {
	pool: MeshPool.Pool,
	U: Uploader.Uploader,
	workers: any,
	body: any?,
	bodyPos: Vector3,
	displayed: { [number]: boolean },
	ready: { [number]: boolean },
	slotOf: { [number]: Slot },
	generating: { [number]: boolean },
	wanted: { [number]: boolean },
	inflight: number,
	results: { { slot: Slot, ticket: number, key: number, result: any } },
	heightLo: { [number]: number },
	heightHi: { [number]: number },
	split: { [number]: boolean }?,
	metric: { [number]: number },
	target: { number },
	fades: { Fade },
	opacity: { [Slot]: number },
	biased: { [Slot]: boolean },
	booted: boolean,
	alpha: number, -- whole-mesh opacity
	alphaTarget: number,
	frame: number,
	lastSelect: number,
	lastCam: Vector3,
	opts: Options,
	stats: {
		generated: number,
		failed: number,
		lastError: string?,
		genMs: number,
		swaps: number,
		evicted: number,
		rate: number, -- patches per second (smoothed)
		deepest: number,
		limited: boolean,
	},
}

function PlanetLod.new(pool: MeshPool.Pool, U: Uploader.Uploader, workers: any): Lod
	return {
		pool = pool,
		U = U,
		workers = workers,
		body = nil,
		bodyPos = Vector3.zero,
		displayed = {},
		ready = {},
		slotOf = {},
		generating = {},
		wanted = {},
		inflight = 0,
		results = {},
		heightLo = {},
		heightHi = {},
		split = nil,
		metric = {},
		target = {},
		fades = {},
		opacity = {},
		biased = {},
		booted = false,
		alpha = 0,
		alphaTarget = 0,
		frame = 0,
		lastSelect = -100,
		lastCam = Vector3.new(1e9, 0, 0),
		opts = { fades = true, frozen = false, greenUp = true, tint = false, splitPx = Config.splitPx, capacity = math.min(Config.capacity, Layout.SLOTS) },
		stats = { generated = 0, failed = 0, lastError = nil, genMs = 0, swaps = 0, evicted = 0, rate = 0, deepest = 0, limited = false },
	}
end

local function levelOf(key: number): number
	local _, L = CubeSphere.unkey(key)
	return L
end

local function applyVisual(L: Lod, slot: Slot)
	local o = L.opacity[slot] or 0
	slot.part.Transparency = 1 - o * L.alpha
end

local function release(L: Lod, slot: Slot)
	local key = slot.key
	if key then
		L.ready[key] = nil
		if L.slotOf[key] == slot then
			L.slotOf[key] = nil
		end
	end
	slot.key = nil
	slot.state = "free"
	slot.ticket += 1
	L.opacity[slot] = nil
	L.biased[slot] = nil
	slot.part.Transparency = 1
	slot.part.CFrame = CFrame.new(L.bodyPos)
end

-- Drops every patch (focus change, normal-convention change).
function PlanetLod.reset(L: Lod)
	for _, slot in L.pool.slots do
		release(L, slot)
	end
	L.displayed = {}
	L.ready = {}
	L.slotOf = {}
	L.generating = {}
	L.wanted = {}
	L.results = {}
	L.fades = {}
	L.opacity = {}
	L.biased = {}
	L.split = nil
	L.booted = false
	L.lastSelect = -100
	L.stats.deepest = 0
end

function PlanetLod.setBody(L: Lod, body: any?)
	if L.body == body then
		return
	end
	PlanetLod.reset(L)
	L.heightLo = {}
	L.heightHi = {}
	L.body = body
	L.alpha = 0
	if body then
		L.bodyPos = Vector3.new(body.px, body.py, body.pz)
	end
end

-- A slot for a new patch: a free one, else the least recently used cached patch that is
-- neither displayed nor wanted. Grows the pool in the background when everything is busy.
local function acquire(L: Lod): Slot?
	local free: Slot? = nil
	local nFree = 0
	local best: Slot? = nil
	for _, slot in L.pool.slots do
		if slot.state == "free" then
			nFree += 1
			if not free then
				free = slot
			end
		elseif slot.state == "ready" and slot.key and not L.displayed[slot.key :: number] and not L.wanted[slot.key :: number] then
			if best == nil or slot.lastUsed < (best :: Slot).lastUsed then
				best = slot
			end
		end
	end
	-- grow before free slots run out: cached patches are worth keeping
	local pool = L.pool
	if nFree <= 4 and not pool.growing and #pool.slots < Layout.SLOTS and not pool.failed then
		pool.growing = true
		task.spawn(function()
			MeshPool.grow(pool, 8)
			pool.growing = false
		end)
	end
	if free then
		return free
	end
	if best then
		L.stats.evicted += 1
		release(L, best)
		return best
	end
	return nil
end

local function submit(L: Lod, key: number): boolean
	local slot = acquire(L)
	if not slot then
		return false
	end
	local s = slot :: Slot
	local f, lev, i, j = CubeSphere.unkey(key)
	s.key = key
	s.state = "generating"
	s.ticket += 1
	local ticket = s.ticket
	L.slotOf[key] = s
	L.generating[key] = true
	L.inflight += 1
	local body = L.body
	WorkerPool.submit(L.workers, "tile", {
		body = body.id,
		face = f,
		level = lev,
		i = i,
		j = j,
		greenUp = L.opts.greenUp,
		tint = false,
	}, function(ok: boolean, result: any, ms: number)
		L.inflight -= 1
		L.generating[key] = nil
		if s.ticket ~= ticket or L.body ~= body then
			return -- reassigned or the focus moved on: drop the stale result
		end
		if not ok then
			L.stats.failed += 1
			L.stats.lastError = tostring(result)
			release(L, s)
			return
		end
		table.insert(L.results, { slot = s, ticket = ticket, key = key, result = result })
		L.stats.genMs += result.ms or ms
	end)
	return true
end

-- Applies finished jobs within `budget` seconds of main-thread time.
local function drainResults(L: Lod, budget: number)
	local t0 = os.clock()
	while #L.results > 0 and os.clock() - t0 < budget do
		local r = table.remove(L.results, 1) :: any
		local s: Slot = r.slot
		if s.ticket == r.ticket then
			local key = r.key
			L.heightLo[key] = r.result.hmin
			L.heightHi[key] = r.result.hmax
			MeshPool.assign(L.pool, L.U, s, r.result, function()
				if s.ticket == r.ticket then
					s.state = "ready"
					s.lastUsed = L.frame
					L.ready[key] = true
				end
			end)
			L.stats.generated += 1
			L.stats.rate = L.stats.rate * 0.97 + 0.03 * 60
		end
	end
end

local function showSlot(L: Lod, slot: Slot, opacity: number)
	slot.state = "shown"
	slot.lastUsed = L.frame
	slot.part.CFrame = CFrame.new(L.bodyPos) -- vertices are body-local
	L.opacity[slot] = opacity
	if L.opts.tint and slot.key then
		MeshPool.tint(slot, LEVEL_TINTS[(levelOf(slot.key :: number) % #LEVEL_TINTS) + 1])
	else
		MeshPool.tint(slot, Color3.new(1, 1, 1))
	end
	applyVisual(L, slot)
end

local function hideSlot(L: Lod, slot: Slot)
	if slot.state == "shown" then
		slot.state = "ready"
	end
	L.opacity[slot] = 0
	L.biased[slot] = nil
	slot.part.Transparency = 1
	slot.part.CFrame = CFrame.new(L.bodyPos)
end

local function startSwap(L: Lod, swap: any)
	local show: { Slot } = {}
	local hide: { Slot } = {}
	for _, k in swap.show do
		local s = L.slotOf[k]
		if s then
			table.insert(show, s)
		end
	end
	for _, k in swap.hide do
		local s = L.slotOf[k]
		if s then
			table.insert(hide, s)
		end
	end
	Quadtree.apply(L.displayed, swap)
	L.stats.swaps += 1
	if L.opts.fades and #hide > 0 and L.alpha > 0.99 then
		for _, s in show do
			showSlot(L, s, 0)
			L.biased[s] = true
		end
		table.insert(L.fades, { show = show, hide = hide, t = 0 })
	else
		for _, s in show do
			showSlot(L, s, 1)
		end
		for _, s in hide do
			hideSlot(L, s)
		end
	end
end

local function stepFades(L: Lod, dt: number)
	local i = 1
	while i <= #L.fades do
		local fd = L.fades[i]
		fd.t += dt / FADE_SECONDS
		local o = math.clamp(fd.t, 0, 1)
		o = o * o * (3 - 2 * o)
		for _, s in fd.show do
			if s.state == "shown" then
				L.opacity[s] = o
				applyVisual(L, s)
			end
		end
		if fd.t >= 1 then
			-- phase 2: the old patches are now fully covered; remove them, then drop the bias
			for _, s in fd.hide do
				if s.state == "shown" and not (s.key and L.displayed[s.key :: number]) then
					hideSlot(L, s)
				end
			end
			for _, s in fd.show do
				L.biased[s] = nil
				s.part.CFrame = CFrame.new(L.bodyPos)
			end
			table.remove(L.fades, i)
		else
			i += 1
		end
	end
end

-- Per frame. `cam` is the current camera; `budget` the main-thread seconds allowed.
function PlanetLod.update(L: Lod, cam: Camera, dt: number, budget: number)
	L.frame += 1
	local body = L.body
	-- whole-mesh opacity follows alphaTarget (impostor crossfade)
	local target = if body and L.booted then L.alphaTarget else 0
	if L.alpha ~= target then
		local step = dt / 0.6
		if L.alpha < target then
			L.alpha = math.min(target, L.alpha + step)
		else
			L.alpha = math.max(target, L.alpha - step)
		end
		for slot, _ in L.opacity do
			applyVisual(L, slot)
		end
	end
	if not body then
		return
	end
	drainResults(L, budget * 0.5)
	stepFades(L, dt)
	-- depth bias for patches fading in: a hair towards the camera
	local camPos = cam.CFrame.Position
	for slot, _ in L.biased do
		local key = slot.key
		if key then
			local f, lev, i, j = CubeSphere.unkey(key)
			local x, y, z = CubeSphere.patchPoint(f, lev, i, j, 0.5, 0.5)
			local centre = L.bodyPos + Vector3.new(x, y, z) * body.radius
			local toCam = camPos - centre
			local d = toCam.Magnitude
			if d > 1e-3 then
				slot.part.CFrame = CFrame.new(L.bodyPos + toCam.Unit * (d * 0.0015 + 0.02))
			end
		end
	end

	local pool = L.pool
	local inUse = 0
	for _, slot in pool.slots do
		if slot.state ~= "free" then
			inUse += 1
		end
	end
	if #pool.slots < 24 and not pool.growing and not pool.failed then
		pool.growing = true
		task.spawn(function()
			MeshPool.grow(pool, 24)
			pool.growing = false
		end)
	end
	local maxInflight = if L.workers.available then math.max(2, L.workers.readyCount * 2) else 1

	-- bootstrap: the six roots, shown together
	if not L.booted then
		local all = true
		local roots = {}
		for f = 1, 6 do
			local k = CubeSphere.key(f, 0, 0, 0)
			table.insert(roots, k)
			if not L.ready[k] then
				all = false
				if not L.generating[k] and not L.slotOf[k] and L.inflight < maxInflight then
					submit(L, k)
				end
			end
		end
		if all then
			for _, k in roots do
				L.displayed[k] = true
				showSlot(L, L.slotOf[k], 1)
			end
			L.booted = true
		end
		return
	end

	if L.opts.frozen then
		return
	end

	-- select (every few frames, or at once after a large move)
	local moved = (camPos - L.lastCam).Magnitude
	local rel = camPos - L.bodyPos
	if L.frame - L.lastSelect >= 4 or moved > rel.Magnitude * 0.02 then
		L.lastSelect = L.frame
		L.lastCam = camPos
		local viewport = cam.ViewportSize
		local look = cam.CFrame.LookVector
		local sel = Quadtree.select({
			x = rel.X,
			y = rel.Y,
			z = rel.Z,
			dx = look.X,
			dy = look.Y,
			dz = look.Z,
			tanHalfFov = math.tan(math.rad(cam.FieldOfView * 0.5)),
			aspect = viewport.X / math.max(1, viewport.Y),
			viewportH = viewport.Y,
		}, {
			radius = body.radius,
			maxHeight = body.maxHeight,
			heightLo = L.heightLo,
			heightHi = L.heightHi,
			capacity = L.opts.capacity,
			splitPx = L.opts.splitPx,
			hysteresis = 1.35,
			maxLevel = if body.id == "terra" then Config.maxLevelTerra else Config.maxLevelOther,
		}, L.split)
		L.split = sel.split
		L.target = sel.leaves
		L.metric = sel.metric
		L.stats.limited = sel.limited
	end

	local plan = Quadtree.plan(L.displayed, L.ready, L.target, L.metric, Layout.SLOTS - inUse < 32)
	L.wanted = plan.needed
	-- generation, most visible first
	local sent = 0
	for _, k in plan.generate do
		if L.inflight >= maxInflight or sent >= 8 then
			break
		end
		if not L.generating[k] and not L.ready[k] and not L.slotOf[k] then
			if not submit(L, k) then
				break
			end
			sent += 1
		end
	end
	-- swaps whose patches are all uploaded
	for _, swap in plan.swaps do
		startSwap(L, swap)
	end
	-- deepest displayed level, for the HUD
	local deepest = 0
	for k in L.displayed do
		local lev = levelOf(k)
		if lev > deepest then
			deepest = lev
		end
	end
	L.stats.deepest = deepest
end

-- Counts for the HUD.
function PlanetLod.counts(L: Lod): (number, number, number, number)
	local shown, ready, gen, uploading = 0, 0, 0, 0
	for _, s in L.pool.slots do
		if s.state == "shown" then
			shown += 1
		elseif s.state == "ready" then
			ready += 1
		elseif s.state == "generating" then
			gen += 1
		elseif s.state == "uploading" then
			uploading += 1
		end
	end
	return shown, ready, gen, uploading
end

-- Re-tints every shown patch (debug view of the levels).
function PlanetLod.refreshTint(L: Lod)
	for _, s in L.pool.slots do
		if s.state == "shown" and s.key then
			MeshPool.tint(s, if L.opts.tint then LEVEL_TINTS[(levelOf(s.key :: number) % #LEVEL_TINTS) + 1] else Color3.new(1, 1, 1))
		end
	end
end

return PlanetLod
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">Sky</string>
            <string name="Source"><![CDATA[--!strict
-- Universe at Home: Planets :: Sky
--
-- The backdrop: six star faces for the Sky (Sky.Skybox*Content takes EditableImages), the
-- sun as a glowing billboard along Lighting:GetSunDirection(), and the engine's Atmosphere
-- thickened as the camera descends towards Terra (the impostor's halo hands over to it
-- inside the atmosphere). Generation runs on the workers; pixels go through the Uploader.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Planets = ReplicatedStorage:WaitForChild("Planets")
local WorkerPool = require(Planets:WaitForChild("WorkerPool")) :: any
local MeshPool = require(script.Parent:WaitForChild("MeshPool"))
local Uploader = require(script.Parent:WaitForChild("Uploader"))

local Sky = {}

local FACE: number = require(Planets:WaitForChild("Config")).skyFace
local SUN: number = require(Planets:WaitForChild("Config")).sunSize
local SUN_DISTANCE = 3900

export type SkyState = {
	faces: { EditableImage },
	sunImg: EditableImage?,
	sunAnchor: Part,
	sunGui: BillboardGui,
	atmosphere: Atmosphere,
	pixels: number,
	note: string,
}

local PROPS = { "SkyboxRightContent", "SkyboxLeftContent", "SkyboxUpContent", "SkyboxDownContent", "SkyboxFrontContent", "SkyboxBackContent" }

function Sky.new(U: Uploader.Uploader, workers: any, folder: Instance): SkyState
	local sky: Instance? = Lighting:FindFirstChildOfClass("Sky")
	if not sky then
		local s = Instance.new("Sky")
		s.Parent = Lighting
		sky = s
	end
	pcall(function()
		(sky :: any).CelestialBodiesShown = false;
		(sky :: any).StarCount = 0
	end)
	local faces: { EditableImage } = {}
	local pixels = 0
	local note = "six star faces of " .. FACE .. " px"
	for f = 1, 6 do
		local img = MeshPool.createImage(FACE, FACE)
		if img then
			faces[f] = img
			pixels += FACE * FACE
			local entry = Uploader.register(U, "sky face " .. f, img)
			pcall(function()
				(sky :: any)[PROPS[f]] = Content.fromObject(img)
			end)
			WorkerPool.submit(workers, "skyFace", { face = f, n = FACE, seed = 5 }, function(ok: boolean, buf: any)
				if ok then
					Uploader.queue(U, entry, 0, 0, FACE, FACE, buf)
				end
			end)
		else
			note = "star faces refused by the memory budget (" .. (f - 1) .. " of 6)"
			break
		end
	end
	-- the sun
	local sunImg = MeshPool.createImage(SUN, SUN)
	local anchor = Instance.new("Part")
	anchor.Name = "Sun"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.CastShadow = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(1, 1, 1)
	anchor.Parent = folder
	local gui = Instance.new("BillboardGui")
	gui.LightInfluence = 0
	gui.Brightness = 4
	gui.AlwaysOnTop = false
	gui.Adornee = anchor
	local half = SUN_DISTANCE * math.tan(math.rad(3))
	gui.Size = UDim2.fromScale(2 * half, 2 * half)
	gui.Parent = anchor
	local label = Instance.new("ImageLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Parent = gui
	if sunImg then
		pixels += SUN * SUN
		label.ImageContent = Content.fromObject(sunImg)
		local entry = Uploader.register(U, "sun", sunImg)
		WorkerPool.submit(workers, "sun", { n = SUN, core = 0.2 }, function(ok: boolean, buf: any)
			if ok then
				Uploader.queue(U, entry, 0, 0, SUN, SUN, buf)
			end
		end)
	end
	-- the engine's atmosphere, used only near Terra's surface
	local atm = Lighting:FindFirstChildOfClass("Atmosphere")
	if not atm then
		local a = Instance.new("Atmosphere")
		a.Parent = Lighting
		atm = a
	end
	local a = atm :: Atmosphere
	a.Density = 0
	a.Offset = 0.05
	a.Color = Color3.fromRGB(150, 190, 255)
	a.Decay = Color3.fromRGB(110, 120, 160)
	a.Glare = 0.3
	a.Haze = 1.2
	return { faces = faces, sunImg = sunImg, sunAnchor = anchor, sunGui = gui, atmosphere = a, pixels = pixels, note = note }
end

-- Per frame: the sun billboard follows the engine's sun; the Atmosphere follows altitude.
function Sky.update(S: SkyState, cam: Camera, terraAltitude: number, terraRadius: number)
	local sun = Lighting:GetSunDirection()
	local camPos = cam.CFrame.Position
	S.sunAnchor.CFrame = CFrame.new(camPos + sun * SUN_DISTANCE)
	-- thick near the ground, gone above a tenth of the radius
	local k = math.clamp(1 - terraAltitude / (terraRadius * 0.1), 0, 1)
	S.atmosphere.Density = 0.38 * k * k
end

return Sky
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">Uploader</string>
            <string name="Source"><![CDATA[--!strict
-- Universe at Home: Planets :: Uploader
--
-- Roblox refreshes only one displayed EditableImage per frame (EditableImage reference,
-- "Update Limitations"; docs/RUNTIME_AUDIT.md). Writing several images in one frame does
-- not make them appear sooner; it only makes the order unpredictable. So every pixel write
-- in the planet system goes through this queue: rectangles pile up per image, and each
-- frame exactly one image (round robin among those with work, the oldest first) takes all
-- of its pending rectangles in one go. An atlas can therefore receive dozens of tiles in a
-- single refresh, and a patch counts as ready only once all of its atlases have flushed.

local Uploader = {}

type Rect = {
	x: number,
	y: number,
	w: number,
	h: number,
	buf: buffer,
	done: (() -> ())?,
}

export type Entry = {
	name: string,
	img: EditableImage,
	pending: { Rect },
	since: number, -- frame of the oldest pending rectangle
}

export type Uploader = {
	entries: { Entry },
	frame: number,
	stats: { flushes: number, rects: number, bytes: number, errors: number, lastError: string?, lastImage: string },
}

function Uploader.new(): Uploader
	return {
		entries = {},
		frame = 0,
		stats = { flushes = 0, rects = 0, bytes = 0, errors = 0, lastError = nil, lastImage = "" },
	}
end

function Uploader.register(U: Uploader, name: string, img: EditableImage): Entry
	local e: Entry = { name = name, img = img, pending = {}, since = math.huge }
	table.insert(U.entries, e)
	return e
end

function Uploader.unregister(U: Uploader, e: Entry)
	local i = table.find(U.entries, e)
	if i then
		table.remove(U.entries, i)
	end
end

-- Queues a w x h rectangle at (x, y). `done` runs right after the rectangle is written.
function Uploader.queue(U: Uploader, e: Entry, x: number, y: number, w: number, h: number, buf: buffer, done: (() -> ())?)
	if #e.pending == 0 then
		e.since = U.frame
	end
	table.insert(e.pending, { x = x, y = y, w = w, h = h, buf = buf, done = done })
end

-- Number of rectangles waiting.
function Uploader.backlog(U: Uploader): number
	local n = 0
	for _, e in U.entries do
		n += #e.pending
	end
	return n
end

-- Flushes the image that has waited longest. Call once per frame.
function Uploader.step(U: Uploader)
	U.frame += 1
	local best: Entry? = nil
	for _, e in U.entries do
		if #e.pending > 0 and (best == nil or e.since < (best :: Entry).since) then
			best = e
		end
	end
	if not best then
		return
	end
	local e = best :: Entry
	local list = e.pending
	e.pending = {}
	e.since = math.huge
	U.stats.flushes += 1
	U.stats.lastImage = e.name
	for _, r in list do
		local ok, err = pcall(function()
			e.img:WritePixelsBuffer(Vector2.new(r.x, r.y), Vector2.new(r.w, r.h), r.buf)
		end)
		if ok then
			U.stats.rects += 1
			U.stats.bytes += r.w * r.h * 4
		else
			U.stats.errors += 1
			U.stats.lastError = tostring(err)
		end
		local done = r.done
		if done then
			done()
		end
	end
end

return Uploader
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">Workers</string>
            <string name="Source"><![CDATA[--!strict
-- Universe at Home: Planets :: Workers
--
-- Spawns the client worker Actors that generate tiles, caches, impostor bands, sky and
-- cloud faces (WorkerPool protocol, demo/shared/WorkerPool.luau). Templates live disabled
-- in ReplicatedStorage.PlanetWorkers:
--   1. PlanetWorker (Script, RunContext Client) cloned into a client-side folder in
--      ReplicatedStorage, where RunContext Client scripts run;
--   2. if none answers, PlanetWorkerLocal (LocalScript) cloned into PlayerScripts;
--   3. if still nothing, serial mode: every job runs inline with the same code.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Planets = ReplicatedStorage:WaitForChild("Planets")
local WorkerPool = require(Planets:WaitForChild("WorkerPool")) :: any
local Jobs = require(Planets:WaitForChild("PlanetJobs")) :: any

local Workers = {}

-- Returns the pool (usable at once: jobs run inline until workers answer) and starts the
-- Actors in the background. `onReady(note)` runs once the pool settled.
function Workers.start(count: number, onReady: (string) -> ()): any
	local pool = WorkerPool.new("Planets", Jobs, 30)
	task.spawn(function()
		local templates = ReplicatedStorage:WaitForChild("PlanetWorkers", 10)
		if not templates then
			onReady("no ReplicatedStorage.PlanetWorkers; serial mode")
			return
		end
		local scriptTemplate = templates:FindFirstChild("PlanetWorker")
		if scriptTemplate then
			local folder = ReplicatedStorage:FindFirstChild("PlanetWorkerPools")
			if not folder then
				local f = Instance.new("Folder")
				f.Name = "PlanetWorkerPools"
				f.Parent = ReplicatedStorage
				folder = f
			end
			local ready = WorkerPool.spawn(pool, scriptTemplate, folder, count, 8)
			if ready > 0 then
				onReady(string.format("%d of %d Script (RunContext Client) Actors", ready, count))
				return
			end
			WorkerPool.destroy(pool)
		end
		local localTemplate = templates:FindFirstChild("PlanetWorkerLocal")
		local playerScripts = Players.LocalPlayer:FindFirstChildOfClass("PlayerScripts")
		if localTemplate and playerScripts then
			local ready = WorkerPool.spawn(pool, localTemplate, playerScripts, count, 8)
			if ready > 0 then
				onReady(string.format("%d of %d LocalScript Actors", ready, count))
				return
			end
			WorkerPool.destroy(pool)
		end
		onReady("no worker answered; serial mode (generation runs on the main thread)")
	end)
	return pool
end

return Workers
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="60">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="FallenPartsDestroyHeight">-50000</float>
      <float name="Gravity">0</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>