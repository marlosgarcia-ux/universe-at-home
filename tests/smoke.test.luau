local MyMath = require("../src/MyMath")
local Pixels = require("../src/Pixels")
local Canvas = require("../src/Canvas")
assert(MyMath.mul32(0xFFFFFFFF, 0xFFFFFFFF) == 1, "mul32 wrap")
assert(MyMath.div255(255 * 255) == 255 and MyMath.div255(0) == 0 and MyMath.div255(128 * 255) == 128)
local c = Canvas.new(64, 48, MyMath.pack(1, 2, 3, 255))
c:fillRect(10, 10, 5, 5, MyMath.pack(9, 9, 9, 255))
assert(c:get(12, 12) == MyMath.pack(9, 9, 9, 255))
local rects = c:planFlush()
print("rects", #rects, rects[1].x, rects[1].y, rects[1].w, rects[1].h)
local half = Pixels.downsample2x(c.buf, 64, 48)
assert(buffer.len(half) == 32 * 24 * 4)
print("smoke ok", MyMath.hash32(1), MyMath.valueNoise2(3.7, 1.2, 42))
